      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">Music</string>
          <string name="Source"><![CDATA[--!strict
-- Porch Light, an original instrumental loop written for Backyard Smokeout.
-- The audio file is audio/porch-light.ogg (see audio/ATTRIBUTION.md).
-- id stays 0 until that file is uploaded to Roblox. Zero is silence, not a stand-in sound.
-- Do not put a hit song, a meme audio, or an unowned library id here.
return {
	id = 0,
	name = "Porch Light",
	loop = true,
}
]]></string>
