	if def.staff and head and body then
		local hat = head.CFrame * E.CFrame.new(0, head.Size.Y * 0.46, 0)
		cyl(m, "ChefBand", 0.14 * s, math.max(0.6, head.Size.X * 0.9), hat * E.CFrame.Angles(0, 0, math.pi / 2), "#F7F4EF")
		sph(m, "ChefPuff", V(head.Size.X * 0.7, 0.48 * s, head.Size.X * 0.7), hat * E.CFrame.new(0, 0.26 * s, 0), "#FFFFFF")
		local apron = part(m, "Apron", V(math.max(0.7, body.Size.X * 0.7), math.max(0.6, body.Size.Y * 0.72), 0.07 * s), body.CFrame * E.CFrame.new(0, -body.Size.Y * 0.05, -math.max(0.4, body.Size.Z * 0.42)), "#FFF8F0", E.Enum.Material.Fabric)
		apron.CanCollide = false
		surfaceText(apron, E.Enum.NormalId.Front, "CREW", "#E85D04", nil)
	end

	for _, c in ipairs(m:GetChildren()) do
		if c:IsA("BasePart") then
			c.CanCollide = false
			c.CanQuery = c.Name == "Body"
		end
	end
	m.PrimaryPart = body
	return m, head, body
end

-- A placed Jimothy. `opts.sighting` adds the hunt prompt; `opts.line` adds his speech bubble.
local function placeJimothy(parent, name, cf, def, opts)
	opts = opts or {}
	local m, head, body = WorldBuilder.critter(E, parent, def, cf)
	m.Name = name
	m:SetAttribute("Jimothy", opts.sighting or name)
	if opts.sighting then
		local pp = prompt(body, "jimothy", "Spot Jimothy", opts.object or "Jimothy", 0, opts.dist or 8)
		pp:SetAttribute("Sighting", opts.sighting)
	end
	if opts.line and head then
		local bubble = billboard(head, "Speech", opts.line, 2.4, 22, "#FFE9A8", 220, 36, { 3.4, 0.7, 90, 16 })
		bubble:SetAttribute("Jimothy", true)
	end
	return m, head, body
end

function WorldBuilder.mosquito(env, parent, cf, queen)
	E = env
	local s = queen and 3 or 1
	local m = model(parent, queen and "QueenSkeeter" or "Mosquito")
	local body = part(m, "Body", V(0.8 * s, 0.8 * s, 2 * s), cf, "#3A3A3A", nil, { CanCollide = false })
	part(m, "Head", V(0.6 * s, 0.6 * s, 0.6 * s), cf * E.CFrame.new(0, 0, -1.2 * s), "#2A2A2A", nil, { CanCollide = false })
	part(m, "Nose", V(0.1 * s, 0.1 * s, 1.2 * s), cf * E.CFrame.new(0, -0.1 * s, -2 * s), "#111111", nil, { CanCollide = false })
	part(m, "WingL", V(1.8 * s, 0.05 * s, 0.8 * s), cf * E.CFrame.new(-1.1 * s, 0.4 * s, 0), "#CDEFFF", E.Enum.Material.Glass, { Transparency = 0.4, CanCollide = false })
	part(m, "WingR", V(1.8 * s, 0.05 * s, 0.8 * s), cf * E.CFrame.new(1.1 * s, 0.4 * s, 0), "#CDEFFF", E.Enum.Material.Glass, { Transparency = 0.4, CanCollide = false })
	ball(m, "EyeL", 0.3 * s, cf * E.CFrame.new(-0.25 * s, 0.15 * s, -1.4 * s), "#FF3B3B", E.Enum.Material.Neon, { CanCollide = false })
	ball(m, "EyeR", 0.3 * s, cf * E.CFrame.new(0.25 * s, 0.15 * s, -1.4 * s), "#FF3B3B", E.Enum.Material.Neon, { CanCollide = false })
	m.PrimaryPart = body
	return m, body
end

local function attachCuteFace(meatPart, meatId, burnt)
	local ok, CuteFace = pcall(function()
		return require(script.Parent.Logic.CuteFace)
	end)
	if not ok then
		ok, CuteFace = pcall(function()
			return require("./Logic/CuteFace")
		end)
	end
	if not ok or not CuteFace.kind(meatId) then
		return
	end
	local sz = { meatPart.Size.X, meatPart.Size.Y, meatPart.Size.Z }
	for _, s in ipairs(CuteFace.specs(meatId, sz, burnt == true)) do
		local piece = E.Instance.new("Part")
		piece.Name = s.name
		piece.Anchored = true
		piece.CanCollide = false
		piece.CanQuery = false
		piece.CanTouch = false
		piece.CastShadow = false
		piece.Size = V(s.size[1], s.size[2], s.size[3])
		piece.CFrame = meatPart.CFrame * E.CFrame.new(s.offset[1], s.offset[2], s.offset[3])
		piece.Color = hex(s.color)
		piece.Material = s.material == "neon" and E.Enum.Material.Neon or E.Enum.Material.SmoothPlastic
		piece.Shape = s.shape == "ball" and E.Enum.PartType.Ball or E.Enum.PartType.Block
		piece.Parent = meatPart
	end
end

-- Visual for meat sitting on a smoker / grill / pass window.
-- `burnt` builds the sad face and the black body together.
-- `fitScale` (the pass-window plates use 0.45) is applied before the face,
-- so the eyes shrink with the meat instead of being left full size.
function WorldBuilder.meat(env, parent, meatDef, rarityDef, cf, doneness, burnt, fitScale)
	E = env
	local sz = meatDef.size or { 2, 0.6, 1.2 }
	local scale = 1
	if rarityDef and rarityDef.id == "texas" then
		scale = 1.9
	end
	if type(fitScale) == "number" and fitScale > 0 then
		scale *= fitScale
	end
	local color = hex(meatDef.color)
	local raw = hex("#E8857A")
	local t = math.clamp(doneness or 1, 0, 1)
	local c = if burnt then hex("#141414") else raw:Lerp(color, t)
	local p = E.Instance.new("Part")
	p.Name = "Meat"
	p.Anchored = true
	p.CanCollide = false
	p.Size = V(sz[1] * scale, sz[2] * scale, sz[3] * scale)
	p.CFrame = cf * E.CFrame.new(0, p.Size.Y / 2, 0)
	p.Color = c
	p.Material = E.Enum.Material.SmoothPlastic
	if rarityDef then
		if rarityDef.id == "meteorite" then
			p.Color = hex("#141414")
			p.Material = E.Enum.Material.Basalt
			local glow = E.Instance.new("PointLight")
			glow.Color = hex("#9B5CFF")
			glow.Range = 10
			glow.Brightness = 2
			glow.Parent = p
			local sp = E.Instance.new("Sparkles")
			sp.SparkleColor = hex("#9B5CFF")
			sp.Parent = p
		elseif rarityDef.id == "smokering" then
			local ring = E.Instance.new("SelectionBox")
			ring.Adornee = p
			ring.Color3 = hex("#FFC83C")
			ring.LineThickness = 0.06
			ring.Parent = p
			local sp = E.Instance.new("Sparkles")
			sp.SparkleColor = hex("#FFC83C")
			sp.Parent = p
		elseif rarityDef.id == "juicy" then
			p.Material = E.Enum.Material.Glass
			p.Transparency = 0.05
		end
	end
	if burnt then
		p.Color = hex("#141414")
		p.Material = E.Enum.Material.SmoothPlastic
		p.Transparency = 0
	end
	p.Parent = parent
	local id = meatDef.id
	local function bit(name: string, size: { number }, offset: { number }, color: string, shape: string?)
		local q = E.Instance.new("Part")
		q.Name = name
		q.Anchored = true
		q.CanCollide = false
		q.CanQuery = false
		q.Size = V(size[1] * scale, size[2] * scale, size[3] * scale)
		q.CFrame = p.CFrame * E.CFrame.new(offset[1] * scale, offset[2] * scale, offset[3] * scale)
		q.Color = if burnt then hex("#141414") else hex(color)
		q.Material = E.Enum.Material.SmoothPlastic
		if shape == "ball" then
			q.Shape = E.Enum.PartType.Ball
		elseif shape == "cyl" then
			q.Shape = E.Enum.PartType.Cylinder
		end
		q.Parent = p
		return q
	end
	local faceOn = p
	if id == "burger" then
		bit("BunBottom", { sz[1] * 0.95, 0.28, sz[3] * 0.95 }, { 0, -0.22, 0 }, "#E6B15A", "ball")
		faceOn = bit("BunTop", { sz[1] * 0.9, 0.32, sz[3] * 0.9 }, { 0, 0.28, 0 }, "#F0C56A", "ball")
		bit("Lettuce", { sz[1] * 0.85, 0.06, sz[3] * 0.85 }, { 0, 0.08, 0 }, "#7CB342")
		bit("Sesame", { 0.12, 0.06, 0.1 }, { 0.2, 0.42, -0.15 }, "#F7F1D0")
		bit("Sesame", { 0.12, 0.06, 0.1 }, { -0.18, 0.4, 0.1 }, "#F7F1D0")
	elseif id == "hotlink" or id == "sausage" then
		bit("EndL", { 0.2, sz[2] * 0.7, sz[3] * 0.7 }, { -sz[1] / 2, 0, 0 }, "#8B3A3A", "ball")
		bit("EndR", { 0.2, sz[2] * 0.7, sz[3] * 0.7 }, { sz[1] / 2, 0, 0 }, "#8B3A3A", "ball")
	elseif id == "ribs" then
		for k = -1, 1 do
			bit("Bone", { 0.12, sz[2] * 1.4, 0.12 }, { k * 0.35, 0.05, 0 }, "#F3E6D0", "cyl")
		end
	elseif id == "tomahawk" then
		for k = -1, 1 do
			bit("Mark", { sz[1] * 0.7, 0.04, 0.08 }, { 0, sz[2] / 2, k * 0.22 }, "#3A2418")
		end
	end
	attachCuteFace(faceOn, meatDef.id, burnt == true)
	return p
end

local function tree(parent, pos, s)
	s = s or 1
	part(parent, "Trunk", V(2 * s, 10 * s, 2 * s), E.CFrame.new(pos + V(0, 5 * s, 0)), "#6B4226", E.Enum.Material.Wood)
	ball(parent, "Leaves", 11 * s, E.CFrame.new(pos + V(0, 12 * s, 0)), "#3E8E41", E.Enum.Material.Grass)
	ball(parent, "Leaves2", 8 * s, E.CFrame.new(pos + V(3 * s, 10 * s, 2 * s)), "#4CA64C", E.Enum.Material.Grass)
end

local function fence(parent, cf, length)
	local m = model(parent, "Fence")
	local posts = math.floor(length / 8)
	for i = 0, posts do
		local x = -length / 2 + i * (length / posts)
		part(m, "Post", V(0.6, 4, 0.6), cf * E.CFrame.new(x, 2, 0), "#8B5A2B", E.Enum.Material.Wood)
	end
	part(m, "RailTop", V(length, 0.4, 0.3), cf * E.CFrame.new(0, 3.3, 0), "#A0522D", E.Enum.Material.Wood)
	part(m, "RailLow", V(length, 0.4, 0.3), cf * E.CFrame.new(0, 1.6, 0), "#A0522D", E.Enum.Material.Wood)
	return m
end

local function picnicTable(parent, name, cf)
	local m = model(parent, name)
	part(m, "Top", V(6, 0.4, 3), cf * E.CFrame.new(0, 2.6, 0), "#B5651D", E.Enum.Material.Wood)
	part(m, "LegA", V(0.4, 2.4, 2.6), cf * E.CFrame.new(-2.4, 1.2, 0), "#8B4513", E.Enum.Material.Wood)
	part(m, "LegB", V(0.4, 2.4, 2.6), cf * E.CFrame.new(2.4, 1.2, 0), "#8B4513", E.Enum.Material.Wood)
	part(m, "BenchA", V(6, 0.3, 1), cf * E.CFrame.new(0, 1.5, -2.2), "#B5651D", E.Enum.Material.Wood)
	part(m, "BenchB", V(6, 0.3, 1), cf * E.CFrame.new(0, 1.5, 2.2), "#B5651D", E.Enum.Material.Wood)
	part(m, "Cloth", V(6.05, 0.05, 3.05), cf * E.CFrame.new(0, 2.83, 0), "#D9534F", E.Enum.Material.Fabric)
	local seat = part(m, "Seat", V(1, 0.2, 1), cf * E.CFrame.new(0, 0.1, -3.6), "#000000", nil, { Transparency = 1, CanCollide = false })
	return m, seat
end

local function smoker(parent, name, cf)
	local m = model(parent, name)
	part(m, "LegL", V(0.4, 2.5, 0.4), cf * E.CFrame.new(-2, 1.25, 0), "#222222", E.Enum.Material.Metal)
	part(m, "LegR", V(0.4, 2.5, 0.4), cf * E.CFrame.new(2, 1.25, 0), "#222222", E.Enum.Material.Metal)
	local barrel = cyl(m, "Barrel", 5, 3, cf * E.CFrame.new(0, 3.6, 0), "#6E4B3A", E.Enum.Material.Metal)
	part(m, "Firebox", V(1.8, 1.8, 1.8), cf * E.CFrame.new(-3.3, 3, 0), "#3A3A3A", E.Enum.Material.Metal)
	local chimney = cyl(m, "Chimney", 3, 0.7, cf * E.CFrame.new(2, 6.3, 0) * E.CFrame.Angles(0, 0, math.pi / 2), "#2A2A2A", E.Enum.Material.Metal)
	local smoke = E.Instance.new("Smoke")
	smoke.Name = "Smoke"
	smoke.Enabled = false
	smoke.Size = 2
	smoke.RiseVelocity = 4
	smoke.Opacity = 0.15
	smoke.Color = hex("#DDDDDD")
	smoke.Parent = chimney
	part(m, "Handle", V(2, 0.3, 0.3), cf * E.CFrame.new(0, 4, -1.7), "#C0C0C0", E.Enum.Material.Metal)
	part(m, "Door", V(1.6, 1.5, 0.12), cf * E.CFrame.new(0.4, 3.5, -1.55), "#5C3E30", E.Enum.Material.Metal)
	part(m, "DoorKnob", V(0.22, 0.22, 0.22), cf * E.CFrame.new(0.9, 3.5, -1.68), "#E8E8E8", E.Enum.Material.Metal)
	cyl(m, "ChimneyCap", 0.2, 1.15, cf * E.CFrame.new(2, 7.9, 0) * E.CFrame.Angles(0, 0, math.pi / 2), "#1A1A1A", E.Enum.Material.Metal)
	wedge(m, "Log", V(0.35, 0.35, 1.1), cf * E.CFrame.new(-3.3, 2.4, 0.2), "#6B4226", E.Enum.Material.Wood)
	local spot = part(m, "MeatSpot", V(1, 0.2, 1), cf * E.CFrame.new(0, 5.15, 0), "#000000", nil, { Transparency = 1, CanCollide = false })
	local gui = billboard(barrel, "SlotGui", "", 4.2, 70, "#FFFFFF", 180, 44, { 7.5, 2 })
	gui.Name = "SlotGui"
	-- padlock sign shown (by WorldService) while this slot is locked; parts remember their base
	-- color so the dark locked silhouette can be undone.
	local lock = part(m, "LockSign", V(3.2, 1.5, 0.2), cf * E.CFrame.new(0, 3.5, 1.85), "#FFC83C", E.Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CastShadow = false })
	for _, face in ipairs({ E.Enum.NormalId.Front, E.Enum.NormalId.Back }) do
		surfaceText(lock, face, "🔒 LOCKED", "#1C1A1F", nil).Parent.Enabled = false
	end
	for _, c in ipairs(m:GetChildren()) do
		if c:IsA("BasePart") and c.Name ~= "MeatSpot" and c.Name ~= "LockSign" then
			c:SetAttribute("BaseColor", "#" .. c.Color:ToHex())
		end
	end
	m:SetAttribute("Slot", name)
	return m, barrel, spot
end

local function stall(parent, name, cf, title, awningA, awningB, promptKind, promptText)
	local m = model(parent, name)
	part(m, "Counter", V(14, 3.5, 3), cf * E.CFrame.new(0, 1.75, 0), "#8B5A2B", E.Enum.Material.WoodPlanks)
	part(m, "Back", V(14, 9, 0.6), cf * E.CFrame.new(0, 4.5, 4), "#A0522D", E.Enum.Material.WoodPlanks)
	part(m, "PostL", V(0.6, 9, 0.6), cf * E.CFrame.new(-6.7, 4.5, -1.3), "#6B4226", E.Enum.Material.Wood)
	part(m, "PostR", V(0.6, 9, 0.6), cf * E.CFrame.new(6.7, 4.5, -1.3), "#6B4226", E.Enum.Material.Wood)
	for i = 0, 6 do
		part(m, "Awning" .. i, V(2, 0.4, 7), cf * E.CFrame.new(-6 + i * 2, 9.2, 1) * E.CFrame.Angles(math.rad(-12), 0, 0), i % 2 == 0 and awningA or awningB, E.Enum.Material.Fabric)
	end
	local roof = part(m, "Roof", V(14.5, 0.6, 8), cf * E.CFrame.new(0, 10.2, 1.5), "#5A3A1E", E.Enum.Material.WoodPlanks)
	local sign = part(m, "Sign", V(12, 2.2, 0.3), cf * E.CFrame.new(0, 7.25, -1.5), "#F4E1C1", E.Enum.Material.Wood)
	surfaceText(sign, E.Enum.NormalId.Front, title, "#5A2E1E", nil)
	-- bottles on the counter
	local colors = { "#D2462E", "#FF5A00", "#E8B923", "#FFA07A", "#5B3A1E" }
	for i, c in ipairs(colors) do
		cyl(m, "Bottle" .. i, 1.2, 0.6, cf * E.CFrame.new(-4 + i * 1.4, 4.1, 0) * E.CFrame.Angles(0, 0, math.pi / 2), c, E.Enum.Material.Glass)
	end
	prompt(m.Counter, promptKind, promptText, title, 0, 12)
	return m, roof
end

local function hidden(p, minTier, shown)
	p.Transparency = 1
	p.CanCollide = false
	p:SetAttribute("MinTier", minTier)
	p:SetAttribute("ShownTransparency", shown or 0)
end

-- Ranch tier pieces start invisible. The server shows the ones the owner has built.
-- They stay inside the pad so the extra ranches still don't overlap.
function WorldBuilder.ranchBuild(plot, cf)
	local root = model(plot, "RanchTiers")
	streamTag(root, "RanchTier")
	local stations = folder(plot, "CrewStations")
	streamTag(stations, "CrewStation")
	local spots = {
		{ "Pit", "pit", 8, 12 },
		{ "Grill", "grill", -8, 8 },
		{ "Serve", "server", 4, 2 },
		{ "Greet", "greeter", 0, -22 },
	}
	for _, spot in ipairs(spots) do
		local pad = part(stations, spot[1], V(3, 0.2, 3), cf * E.CFrame.new(spot[3], 1.15, spot[4]), "#E7D3A1", E.Enum.Material.WoodPlanks, { Transparency = 1, CanCollide = false })
		pad:SetAttribute("CrewStation", spot[2])
		streamTag(pad, "CrewStation")
	end

	local function piece(name, minTier)
		local m = model(root, name)
		m:SetAttribute("MinTier", minTier)
		streamTag(m, "RanchTier")
		return m
	end

	local shed = piece("Shed", 2)
	local shedBody = part(shed, "Body", V(6, 4.2, 5), cf * E.CFrame.new(20, 2.8, -16), "#8B5A2B", E.Enum.Material.WoodPlanks)
	shedBody:SetAttribute("Solid", true)
	hidden(shedBody, 2, 0)
	local shedRoof = wedge(shed, "Roof", V(6.4, 1.6, 2.6), cf * E.CFrame.new(20, 5.4, -16), "#A33B32", E.Enum.Material.Wood)
	hidden(shedRoof, 2, 0)
	local shedSign = part(shed, "Sign", V(2.4, 0.8, 0.15), cf * E.CFrame.new(20, 3.4, -18.4), "#F4E1C1", E.Enum.Material.Wood)
	hidden(shedSign, 2, 0)
	surfaceText(shedSign, E.Enum.NormalId.Front, "PIT", "#5A2E1E", nil)

	local lights = piece("Lights", 3)
	local wire = part(lights, "Wire", V(28, 0.08, 0.08), cf * E.CFrame.new(0, 6.2, 8), "#3A2A1E", nil)
	hidden(wire, 3, 0)
	for i = -4, 4 do
		local bulb = ball(lights, "Bulb", 0.45, cf * E.CFrame.new(i * 3, 5.9, 8), i % 2 == 0 and "#FFE9A8" or "#FFB347", E.Enum.Material.Neon)
		hidden(bulb, 3, 0.05)
	end

	local pond = piece("Pond", 4)
	local water = cyl(pond, "Water", 0.35, 8, cf * E.CFrame.new(-16, 1.05, -10) * E.CFrame.Angles(0, 0, math.pi / 2), "#3FA7D6", E.Enum.Material.Glass)
	hidden(water, 4, 0.15)
	local rim = cyl(pond, "Rim", 0.5, 9.2, cf * E.CFrame.new(-16, 0.95, -10) * E.CFrame.Angles(0, 0, math.pi / 2), "#7D8B5A", E.Enum.Material.Grass)
	hidden(rim, 4, 0.05)

	local barn = piece("Barn", 5)
	local barnBody = part(barn, "Body", V(8, 5, 6), cf * E.CFrame.new(18, 3.4, 8), "#A33B32", E.Enum.Material.WoodPlanks)
	barnBody:SetAttribute("Solid", true)
	hidden(barnBody, 5, 0)
	local barnDoor = part(barn, "Door", V(2.2, 3, 0.15), cf * E.CFrame.new(18, 2.6, 5.1), "#F4E1C1", E.Enum.Material.Wood)
	hidden(barnDoor, 5, 0)
	local barnRoof = wedge(barn, "Roof", V(8.4, 2.2, 3.2), cf * E.CFrame.new(18, 6.6, 8), "#6B4226", E.Enum.Material.Wood)
	hidden(barnRoof, 5, 0)

	local trailer = piece("Trailer", 6)
	local box = part(trailer, "Box", V(7, 3.2, 3.2), cf * E.CFrame.new(-18, 2.6, 14), "#F4E1C1", E.Enum.Material.Metal)
	box:SetAttribute("Solid", true)
	hidden(box, 6, 0)
	local stripe = part(trailer, "Stripe", V(7.05, 0.7, 3.25), cf * E.CFrame.new(-18, 3.3, 14), "#E07A3D", E.Enum.Material.Metal)
	hidden(stripe, 6, 0)
	surfaceText(box, E.Enum.NormalId.Front, "BBQ", "#5A2E1E", nil)
	for _, wx in ipairs({ -2.2, 2.2 }) do
		local wheel = cyl(trailer, "Wheel", 0.4, 1.3, cf * E.CFrame.new(-18 + wx, 1.3, 15.4) * E.CFrame.Angles(0, 0, math.pi / 2), "#2A2A2A", E.Enum.Material.Metal)
		hidden(wheel, 6, 0)
	end

	local stage = piece("Stage", 7)
	local deck = part(stage, "Deck", V(8, 0.6, 5), cf * E.CFrame.new(0, 1.5, 24), "#8B5A2B", E.Enum.Material.WoodPlanks)
	deck:SetAttribute("Solid", true)
	hidden(deck, 7, 0)
	local curtain = part(stage, "Curtain", V(8, 3.2, 0.2), cf * E.CFrame.new(0, 3.4, 26.2), "#A33B32", E.Enum.Material.Fabric)
	hidden(curtain, 7, 0)

	local sign = piece("Sign", 8)
	local neon = part(sign, "Neon", V(10, 2.4, 0.3), cf * E.CFrame.new(0, 8.2, 28), "#1A120E", E.Enum.Material.Neon)
	hidden(neon, 8, 0)
	local glow = surfaceText(neon, E.Enum.NormalId.Front, "ROCH'S PIT", "#FFC83C", nil)
	glow.TextTransparency = 1
	glow:SetAttribute("MinTier", 8)
	return root
end

-- Boardwalk on the path in from the welcome arch, south of Temp and Big Bertha.
-- That stretch is open sand between spawn and the sauce shacks, so the lineup
-- is the first thing a new player walks up to, and nobody stands in it.
function WorldBuilder.hiringLine(parent)
	local line = model(parent, "HiringLine")
	streamTag(line, "HiringLine")
	local origin = E.CFrame.new(0, 0, -26)
	local function here(x, y, z)
		return origin * E.CFrame.new(x, y, z)
	end
	local deck = part(line, "Boardwalk", V(40, 0.35, 7), here(0, 0.9, 0), "#E7C89A", E.Enum.Material.WoodPlanks)
	deck.CanCollide = true
	for i = -2, 2 do
		local plank = part(line, "Plank", V(0.35, 0.4, 7), here(i * 7, 1.12, 0), i % 2 == 0 and "#C9852A" or "#8B5A2B", E.Enum.Material.Wood)
		plank.CanCollide = false
	end
	for _, side in ipairs({ -1, 1 }) do
		part(line, "Rail", V(38, 0.25, 0.25), here(0, 2.3, side * 3.2), "#6B4226", E.Enum.Material.Wood).CanCollide = false
		for post = -2, 2 do
			part(line, "Post", V(0.35, 1.6, 0.35), here(post * 8, 1.7, side * 3.2), "#6B4226", E.Enum.Material.Wood).CanCollide = false
		end
	end
	local colors = { "#E7E2DA", "#5AD2FF", "#7DCE6A", "#C58BFF", "#FFC83C", "#FF6B6B" }
	for i, color in ipairs(colors) do
		wedge(line, "Pennant", V(0.08, 0.7, 0.9), here(-16 + i * 2.6, 3.5, 0), color, E.Enum.Material.Fabric).CanCollide = false
	end
	local hire = part(line, "NowHiring", V(0.4, 5.5, 6), here(-21.2, 3.6, 0), "#E07A3D", E.Enum.Material.WoodPlanks)
	surfaceText(hire, E.Enum.NormalId.Front, "NOW HIRING", "#FFF6E8", nil)
	surfaceText(hire, E.Enum.NormalId.Back, "NOW HIRING", "#FFF6E8", nil)
	prompt(hire, "ui:hire", "See the lineup", "Hiring Line", 0, 14)
	local board = part(line, "RestockBoard", V(0.35, 3.2, 5), here(21.2, 2.8, 0), "#F4E1C1", E.Enum.Material.Wood)
	local clock = surfaceText(board, E.Enum.NormalId.Front, "Next lineup", "#5A2E1E", nil)
	clock.Name = "Clock"
	surfaceText(board, E.Enum.NormalId.Back, "Coins only", "#5A2E1E", nil)
	local pads = folder(line, "Pads")
	for i = 1, 6 do
		local x = -15 + (i - 1) * 6
		local pad = part(pads, "Pad" .. i, V(2.6, 0.15, 2.6), here(x, 1.15, 0), "#F4E1C1", E.Enum.Material.Wood, { Transparency = 1, CanCollide = false })
		pad:SetAttribute("Applicant", i)
	end
	return line
end

local function buildPlot(root, i, cfg)
	local n = cfg.MAX_PLOTS
	local angle = (i - 1) / n * math.pi * 2
	local center = V(math.cos(angle) * WorldBuilder.PLOT_RADIUS, 0, math.sin(angle) * WorldBuilder.PLOT_RADIUS)
	local cf = lookAt(center, V(0, 0, 0))
	local S = WorldBuilder.PLOT_SIZE
	local m = model(root, "Plot" .. i)
	m:SetAttribute("PlotIndex", i)
	part(m, "Pad", V(S, 1, S), cf * E.CFrame.new(0, 0.1, 0), "#6FBF4B", E.Enum.Material.Grass)
	part(m, "Patio", V(56, 0.3, 16), cf * E.CFrame.new(0, 0.7, 18), "#C9B79C", E.Enum.Material.Slate)
	part(m, "Path", V(8, 0.25, 26), cf * E.CFrame.new(0, 0.68, -19), "#C2A878", E.Enum.Material.Sand)
	-- fences (front has a gap for the path)
	fence(m, cf * E.CFrame.new(0, 0.6, S / 2), S)
	fence(m, cf * E.CFrame.new(-S / 2, 0.6, 0) * E.CFrame.Angles(0, math.pi / 2, 0), S)
	fence(m, cf * E.CFrame.new(S / 2, 0.6, 0) * E.CFrame.Angles(0, math.pi / 2, 0), S)
	fence(m, cf * E.CFrame.new(-18, 0.6, -S / 2), 28)
	fence(m, cf * E.CFrame.new(18, 0.6, -S / 2), 28)

	-- sign
	local sign = model(m, "Sign")
	part(sign, "PostL", V(0.6, 9, 0.6), cf * E.CFrame.new(-6, 4.5, -S / 2 - 1), "#6B4226", E.Enum.Material.Wood)
	part(sign, "PostR", V(0.6, 9, 0.6), cf * E.CFrame.new(6, 4.5, -S / 2 - 1), "#6B4226", E.Enum.Material.Wood)
	-- The plot looks toward the hub, so the board's front (its LookVector) already
	-- points out the path. A 180 degree yaw used to turn that face into the yard.
	-- Raised well above head height and non-solid so players (and big avatars) can walk under it.
	local board = part(sign, "Board", V(12.5, 2.6, 0.4), cf * E.CFrame.new(0, 8.2, -S / 2 - 1), "#F4E1C1", E.Enum.Material.Wood, { CanCollide = false })
	surfaceText(board, E.Enum.NormalId.Front, "Open Ranch", "#5A2E1E", nil).Name = "OwnerText"
	surfaceText(board, E.Enum.NormalId.Back, "Open Ranch", "#5A2E1E", nil).Name = "OwnerText"

	-- smokers
	local smokers = folder(m, "Smokers")
	for si, x in ipairs(WorldBuilder.SMOKER_X) do
		smoker(smokers, "s" .. si, cf * E.CFrame.new(x, 0.6, 20) * E.CFrame.Angles(0, math.pi, 0))
	end
	-- grill (flat-top with 4 spots)
	local grill = model(m, "Grill")
	part(grill, "Base", V(20, 1.2, 3.2), cf * E.CFrame.new(-19.5, 2.4, 4), "#2E2E2E", E.Enum.Material.Metal)
	for _, gx in { -8.5, 8.5 } do
		for _, gz in { -1.2, 1.2 } do
			part(grill, "Leg", V(0.35, 2.2, 0.35), cf * E.CFrame.new(-19.5 + gx, 1.1, 4 + gz), "#1A1A1A", E.Enum.Material.Metal)
		end
	end
	wedge(grill, "Hood", V(20, 1.6, 2.2), cf * E.CFrame.new(-19.5, 4.5, 5.1) * E.CFrame.Angles(0, math.pi, 0), "#3A3A3A", E.Enum.Material.Metal)
	cyl(grill, "Handle", 16, 0.28, cf * E.CFrame.new(-19.5, 4.3, 2.3) * E.CFrame.Angles(0, math.pi / 2, 0), "#C0C0C0", E.Enum.Material.Metal)
	local top = part(grill, "Top", V(20, 0.28, 3.4), cf * E.CFrame.new(-19.5, 3.55, 4), "#555555", E.Enum.Material.DiamondPlate)
	for gi = -2, 2 do
		part(grill, "Grate", V(18, 0.08, 0.12), cf * E.CFrame.new(-19.5, 3.72, 4 + gi * 0.45), "#2A2A2A", E.Enum.Material.Metal)
	end
	local gsmoke = E.Instance.new("Smoke")
	gsmoke.Name = "Smoke"
	gsmoke.Enabled = false
	gsmoke.Size = 1.5
	gsmoke.Opacity = 0.1
	gsmoke.RiseVelocity = 3
	gsmoke.Parent = top
	for gi, x in ipairs(WorldBuilder.GRILL_X) do
		local spot = part(grill, "g" .. gi, V(4, 0.2, 3), cf * E.CFrame.new(x, 3.78, 4), "#333333", E.Enum.Material.Metal)
		spot:SetAttribute("Slot", "g" .. gi)
		billboard(spot, "SlotGui", "", 3, 60, "#FFFFFF", 150, 40, { 4.6, 1.5 })
	end
	-- customer tables
	local tables = folder(m, "Tables")
	for ti = 1, cfg.CUSTOMER_SPOTS do
		picnicTable(tables, "t" .. ti, cf * E.CFrame.new(6 + (ti - 1) * 9, 0.6, -4))
	end
	-- pass window (where other players can snag a plate while you're online)
	local pw = model(m, "PassWindow")
	local counter = part(pw, "Counter", V(8, 3.4, 2.5), cf * E.CFrame.new(10, 2.3, -22), "#8B5A2B", E.Enum.Material.WoodPlanks)
	part(pw, "Top", V(8.4, 0.3, 2.9), cf * E.CFrame.new(10, 4.1, -22), "#DEB887", E.Enum.Material.Wood)
	local pwSign = part(pw, "Sign", V(6, 1.2, 0.2), cf * E.CFrame.new(10, 5.8, -21.8), "#F4E1C1", E.Enum.Material.Wood)
	surfaceText(pwSign, E.Enum.NormalId.Front, "PASS WINDOW", "#5A2E1E", nil)
	surfaceText(pwSign, E.Enum.NormalId.Back, "PASS WINDOW", "#5A2E1E", nil)
	folder(pw, "Plates")
	prompt(counter, "snag", "Snag a plate", "Pass Window", 1.2, 9, { Enabled = false })
	billboard(counter, "LockGui", "", 5, 50, "#FFB3B3", 200, 30)

	local spawnPad = part(m, "SpawnPad", V(4, 0.2, 4), cf * E.CFrame.new(0, 1, -12), "#000000", nil, { Transparency = 1, CanCollide = false })
	spawnPad:SetAttribute("Facing", 0)
	-- smoke signal column (enabled on rare cuts)
	local sig = part(m, "SmokeSignal", V(2, 2, 2), cf * E.CFrame.new(0, 14, 20), "#000000", nil, { Transparency = 1, CanCollide = false })
	local ss = E.Instance.new("Smoke")
	ss.Name = "Signal"
	ss.Enabled = false
	ss.Size = 30
	ss.RiseVelocity = 25
	ss.Opacity = 0.6
	ss.Parent = sig
	local sigGui = billboard(sig, "SignalGui", "", 30, 1000, "#FFC83C", 420, 70)
	sigGui.Enabled = false
	sigGui.AlwaysOnTop = true
	-- VIP lights (hidden until VIP Patio pass)
	local vip = folder(m, "VIPLights")
	for li = 0, 12 do
		local x = -S / 2 + 2 + li * ((S - 4) / 12)
		ball(vip, "Bulb", 0.6, cf * E.CFrame.new(x, 7 + math.sin(li / 12 * math.pi) * -1.2, 27), li % 2 == 0 and "#FFE9A8" or "#FFB347", E.Enum.Material.Neon, { Transparency = 1, CanCollide = false })
	end
	part(vip, "Wire", V(S - 2, 0.1, 0.1), cf * E.CFrame.new(0, 7.2, 27), "#222222", nil, { Transparency = 1, CanCollide = false })
	local vipSign = part(vip, "VIPSign", V(6, 2, 0.2), cf * E.CFrame.new(-26, 5, 26.5), "#1A1A1A", nil, { Transparency = 1 })
	surfaceText(vipSign, E.Enum.NormalId.Front, "VIP PATIO", "#FFD700", nil).TextTransparency = 1
	surfaceText(vipSign, E.Enum.NormalId.Back, "VIP PATIO", "#FFD700", nil).TextTransparency = 1
	-- cooler (decor)
	part(m, "Cooler", V(4, 2.4, 2.4), cf * E.CFrame.new(-26, 1.8, 10), "#2E86C1", E.Enum.Material.SmoothPlastic)
	part(m, "CoolerLid", V(4.1, 0.4, 2.5), cf * E.CFrame.new(-26, 3.2, 10), "#FFFFFF", E.Enum.Material.SmoothPlastic)
	-- lawn chair (Unc energy)
	part(m, "ChairSeat", V(2.2, 0.3, 2), cf * E.CFrame.new(26, 1.6, 10), "#2E8B57", E.Enum.Material.Fabric)
	part(m, "ChairBack", V(2.2, 2.4, 0.3), cf * E.CFrame.new(26, 2.8, 11) * E.CFrame.Angles(math.rad(-15), 0, 0), "#2E8B57", E.Enum.Material.Fabric)
	tree(m, (cf * E.CFrame.new(-27, 0.6, 27)).Position, 0.8)
	tree(m, (cf * E.CFrame.new(27, 0.6, 27)).Position, 0.9)
	WorldBuilder.ranchBuild(m, cf)
	return m
end

local function buildHub(root, cfg, content)
	local hub = model(root, "Hub")
	local disc = cyl(hub, "Square", 0.4, 110, E.CFrame.new(0, 0.2, 0) * E.CFrame.Angles(0, 0, math.pi / 2), "#C2A878", E.Enum.Material.Sand)
	disc.CanCollide = true
	-- paths to each plot
	for i = 1, cfg.MAX_PLOTS do
		local a = (i - 1) / cfg.MAX_PLOTS * math.pi * 2
		local mid = V(math.cos(a) * 85, 0.25, math.sin(a) * 85)
		part(hub, "Road" .. i, V(8, 0.3, 66), lookAt(mid, V(0, 0.25, 0)), "#C2A878", E.Enum.Material.Sand)
	end
	WorldBuilder.hiringLine(hub)
	local spawn = E.Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = V(8, 0.4, 8)
	spawn.CFrame = E.CFrame.new(0, 0.5, -36)
	spawn.Color = hex("#C2A878")
	spawn.Material = E.Enum.Material.Sand
	spawn.Parent = hub

	-- Welcome arch
	local arch = model(hub, "WelcomeArch")
	part(arch, "PostL", V(1.5, 16, 1.5), E.CFrame.new(-12, 8, -50), "#6B4226", E.Enum.Material.Wood)
	part(arch, "PostR", V(1.5, 16, 1.5), E.CFrame.new(12, 8, -50), "#6B4226", E.Enum.Material.Wood)
	local beam = part(arch, "Beam", V(28, 4, 1), E.CFrame.new(0, 16, -50) * E.CFrame.Angles(0, math.pi, 0), "#8B4513", E.Enum.Material.WoodPlanks)
	surfaceText(beam, E.Enum.NormalId.Front, "🔥 " .. content.Signs.welcome .. " 🔥", "#FFE9A8", nil)
	local beamBack = part(arch, "BeamBack", V(28, 4, 0.1), E.CFrame.new(0, 16, -50.55), "#8B4513", E.Enum.Material.WoodPlanks)
	surfaceText(beamBack, E.Enum.NormalId.Front, content.Signs.hub, "#FFE9A8", nil)

	-- Sauce shack (coins) and Pitmaster Outfitters (Robux shop)
	local _, shackRoof = stall(hub, "SauceShack", E.CFrame.new(-30, 0.4, -18) * E.CFrame.Angles(0, math.rad(200), 0), content.Signs.shop, "#D9534F", "#FFFFFF", "ui:sauce", "Open Sauce Shack")
	stall(hub, "Outfitters", E.CFrame.new(30, 0.4, -18) * E.CFrame.Angles(0, math.rad(160), 0), "PITMASTER OUTFITTERS", "#2E86C1", "#FFFFFF", "ui:pitshop", "Open Pit Shop")
	-- secret on the shack roof (reach it with the trampoline)
	local roofSecret = part(hub, "RoofSecret", V(2, 0.6, 2), shackRoof.CFrame * E.CFrame.new(0, 0.6, 0), "#FFD700", E.Enum.Material.Neon, { Transparency = 0.2 })
	prompt(roofSecret, "egg:roof", "Sign the roof", "Roof Club", 0.5, 8)

	-- Cook-off stage
	local stage = model(hub, "CookOff")
	part(stage, "Stage", V(34, 1.6, 14), E.CFrame.new(0, 1, 34), "#8B5A2B", E.Enum.Material.WoodPlanks)
	local judges = part(stage, "JudgesTable", V(18, 3.2, 3), E.CFrame.new(0, 3.4, 37), "#FFFFFF", E.Enum.Material.Fabric)
	prompt(judges, "cookoff", "Enter the Cook-Off", "Judges' Table", 0.8, 14)
	local banner = part(stage, "Banner", V(30, 5, 0.4), E.CFrame.new(0, 12, 41) * E.CFrame.Angles(0, math.pi, 0), "#C0392B", E.Enum.Material.Fabric)
	surfaceText(banner, E.Enum.NormalId.Front, "🏆 " .. content.Signs.cookoff .. " 🏆", "#FFFFFF", nil).Name = "BannerText"
	part(stage, "BannerPoleL", V(0.6, 14, 0.6), E.CFrame.new(-15.5, 7, 41.2), "#6B4226", E.Enum.Material.Wood)
	part(stage, "BannerPoleR", V(0.6, 14, 0.6), E.CFrame.new(15.5, 7, 41.2), "#6B4226", E.Enum.Material.Wood)
	WorldBuilder.npc(stage, "Granny", E.CFrame.new(-4.5, 1.8, 39.2), { skin = "#C68642", shirt = "#9B59B6", pants = "#5B2C6F", shoes = "#5B2C6F", hat = "bun", hatColor = "#E4E4E4", glasses = true, pearls = true, brows = false, label = "Granny Pecan (Head Judge)", labelColor = "#F5B7B1" })
	WorldBuilder.npc(stage, "JudgeBob", E.CFrame.new(4.5, 1.8, 39.2), { skin = "#8D5524", shirt = "#27AE60", hat = "cap", hatColor = "#1E8449", beard = "#2A1E1A", belly = true, label = "Judge Big Earl" })
	local catDef = { id = "clapcat", body = "#151515", head = "#1E1E1E", scale = 0.9, ears = true }
	local cat = WorldBuilder.critter(E, stage, catDef, E.CFrame.new(0, 5, 37.3))
	cat.Name = "ClapCatJudge"
	-- leaderboard
	-- Faces the welcome arch from the open east edge of the square. It used to stand behind the
	-- King of the Pit (seen from spawn his name tag and the Dinner Bell label sat right on top of
	-- the standings), so it now has its own clear sight line, on two wooden posts.
	local lbCf = lookAt(V(37, 9.4, 10), V(2, 9.4, -20))
	local lb = part(stage, "Leaderboard", V(14, 16, 0.6), lbCf, "#1F2A1F", E.Enum.Material.SmoothPlastic)
	deco(stage, "LBFrame", V(15.2, 17.2, 0.5), lbCf * E.CFrame.new(0, 0, 0.45), "#6B4226", E.Enum.Material.Wood, true)
	local lbHead = deco(stage, "LBHeader", V(15.6, 1.8, 0.9), lbCf * E.CFrame.new(0, 9.0, 0), "#B22222", E.Enum.Material.SmoothPlastic, true)
	surfaceText(lbHead, E.Enum.NormalId.Front, "🏆 COOK-OFF LEADERBOARD", "#FFFFFF", nil)
	surfaceText(lb, E.Enum.NormalId.Front, "This week's Cook-Off\n(Saturday)\n\nNo entries yet", "#FFE9A8", nil).Name = "BoardText"
	-- the back faces the east road in from the ranches, so it points the way instead of being blank
	local lbBack = deco(stage, "LBBackSign", V(11, 4.6, 0.1), lbCf * E.CFrame.new(0, 4.2, 0.75), "#B22222", E.Enum.Material.SmoothPlastic)
	surfaceText(lbBack, E.Enum.NormalId.Back, "🏆 " .. content.Signs.cookoff .. "\nEnter at the stage", "#FFFFFF", nil)
	for i, sx in { -6.2, 6.2 } do
		part(stage, i == 1 and "LBLegL" or "LBLegR", V(0.8, 9.6, 0.8), lbCf * E.CFrame.new(sx, -4.4, 0.9), "#6B4226", E.Enum.Material.Wood)
	end

	-- Unc Hank: dad jokes
	local unc = WorldBuilder.npc(hub, "UncHank", lookAt(V(-18, 0.4, 10), V(-8, 0.4, -12)), { skin = "#D1A27A", shirt = "#F39C12", pants = "#2C3E50", hat = "cap", hatColor = "#2C3E50", label = "Unc Hank", apron = "#B22222", apronText = "UNC", mustache = "#6B4A2E", belly = true, sandals = true })
	prompt(unc.Torso, "npc:unc", "Hear today's joke", "Unc Hank", 0, 10)
	WorldBuilder.yardBoard(hub, content)
	-- Unc's kettle grill (the bowl keeps the UncGrill name; the scenery adds a smoke wisp to it)
	local kettle = E.CFrame.new(-22.5, 0.4, 13)
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		part(hub, "UncGrillLeg", V(0.25, 2.6, 0.25), kettle * E.CFrame.new(math.cos(a) * 0.9, 1.3, math.sin(a) * 0.9) * E.CFrame.Angles(math.sin(a) * 0.25, 0, -math.cos(a) * 0.25), "#2A2A2A", E.Enum.Material.Metal)
	end
	local bowl = sph(hub, "UncGrill", V(3.2, 2.0, 3.2), kettle * E.CFrame.new(0, 3.0, 0), "#1A1A1A", E.Enum.Material.Metal)
	bowl.CanCollide = true
	sph(hub, "UncGrillLid", V(3.1, 1.6, 3.1), kettle * E.CFrame.new(0.3, 3.9, 0.2) * E.CFrame.Angles(0, 0, math.rad(-18)), "#B22222", E.Enum.Material.Metal)
	ball(hub, "UncGrillKnob", 0.45, kettle * E.CFrame.new(0.55, 4.75, 0.2), "#C0C0C0", E.Enum.Material.Metal)

	-- The King of the Pit (cowboy hat pitmaster, hums original tunes)
	local king = WorldBuilder.npc(hub, "KingOfThePit", lookAt(V(18, 0.4, 10), V(8, 0.4, -12)), { skin = "#E0AC69", shirt = "#ECF0F1", pants = "#1F3A93", shoes = "#6B3A1E", hat = "cowboy", hatColor = "#F5F0E1", mustache = "#8A6A4A", buckle = "#F2C14E", scale = 1.05, label = "The King of the Pit", labelColor = "#F5D76E" })
	prompt(king.Torso, "npc:king", "Say howdy", "The King of the Pit", 0, 10)
	smoker(hub, "KingSmoker", E.CFrame.new(23, 0.4, 14) * E.CFrame.Angles(0, math.rad(230), 0))

	-- Temp the talking thermometer: a round red bulb with a face, a glass stem, chrome legs
	local temp = model(hub, "Temp")
	local tc = E.CFrame.new(0, 0.4, -6)
	local function tp(x, y, z, rz)
		return tc * E.CFrame.new(x, y, z) * E.CFrame.Angles(0, 0, math.rad(rz or 0))
	end
	for _, side in { -1, 1 } do
		cyl(temp, "Leg", 1.3, 0.3, tp(side * 0.6, 1.15, 0) * upright(), "#C9CED4", E.Enum.Material.Metal)
		sph(temp, "Shoe", V(0.9, 0.55, 1.3), tp(side * 0.62, 0.3, -0.25), "#D93636")
		sph(temp, "Arm", V(0.35, 1.5, 0.35), tp(side * 1.75, 2.7, -0.2, side * 38), "#C9CED4", E.Enum.Material.Metal)
		ball(temp, "Glove", 0.7, tp(side * 2.2, 2.05, -0.3), "#FFFFFF")
	end
	ball(temp, "Bulb", 3.2, tp(0, 2.7, 0), "#E74C3C")
	sph(temp, "BulbShine", V(0.4, 0.22, 0.1), tp(-0.72, 3.5, -1.3) * E.CFrame.Angles(math.rad(-30), math.rad(25), math.rad(35)), "#FF9C8C", E.Enum.Material.SmoothPlastic)
	for _, side in { -1, 1 } do
		sph(temp, "EyeWhite", V(0.75, 0.9, 0.3), tp(side * 0.55, 3.05, -1.4), "#FFFFFF")
		sph(temp, "Pupil", V(0.42, 0.55, 0.2), tp(side * 0.5, 3.0, -1.55), "#1E1614")
		sph(temp, "Shine", V(0.15, 0.15, 0.1), tp(side * 0.5 - 0.08, 3.15, -1.65), "#FFFFFF", E.Enum.Material.Neon)
		sph(temp, "Cheek", V(0.5, 0.28, 0.15), tp(side * 1.0, 2.45, -1.28), "#FF8FA3")
	end
	sph(temp, "Smile", V(1.0, 0.36, 0.2), tp(0, 2.2, -1.5), "#5A1F2E")
	sph(temp, "Tongue", V(0.4, 0.18, 0.12), tp(0.1, 2.1, -1.58), "#FF8FA3")
	local stem = cyl(temp, "Stem", 7, 1.4, tp(0, 7.5, 0) * upright(), "#ECF0F1", E.Enum.Material.Glass, { Transparency = 0.55 })
	cyl(temp, "Mercury", 5.4, 0.7, tp(0, 6.8, 0) * upright(), "#D7261E", E.Enum.Material.SmoothPlastic)
	for k = 0, 5 do
		part(temp, "Tick", V(k % 2 == 0 and 0.5 or 0.3, 0.08, 0.06), tp(0.25, 5.2 + k, -0.72), "#2A2A2A")
	end
	ball(temp, "Cap", 1.45, tp(0, 11.0, 0), "#C9CED4", E.Enum.Material.Metal)
	billboard(stem, "NameTag", "Temp", 4.6, 60, "#FFFFFF", 120, 30, { 2.4, 0.8, 48, 16 })
	prompt(stem, "npc:temp", "Talk to Temp", "Temp", 0, 10)

	-- Sunday potluck table with the tiny "Jesus loves you" figure (Mike's egg)
	local pot = model(hub, "Potluck")
	local potCf = E.CFrame.new(-38, 0.4, 24) * E.CFrame.Angles(0, math.rad(60), 0)
	part(pot, "Table", V(14, 0.5, 4), potCf * E.CFrame.new(0, 3, 0), "#F5F5DC", E.Enum.Material.Fabric)
	part(pot, "LegL", V(0.5, 3, 3.5), potCf * E.CFrame.new(-6, 1.5, 0), "#8B5A2B", E.Enum.Material.Wood)
	part(pot, "LegR", V(0.5, 3, 3.5), potCf * E.CFrame.new(6, 1.5, 0), "#8B5A2B", E.Enum.Material.Wood)
	local dishes = { "#F4D03F", "#E67E22", "#27AE60", "#C0392B", "#8E44AD" }
	for di, c in ipairs(dishes) do
		cyl(pot, "Dish" .. di, 0.4, 1.8, potCf * E.CFrame.new(-6 + di * 2, 3.45, -0.6) * E.CFrame.Angles(0, 0, math.pi / 2), c, E.Enum.Material.SmoothPlastic)
	end
	local psign = part(pot, "Sign", V(5, 1.2, 0.2), potCf * E.CFrame.new(-4, 4.4, 1.6), "#FFFFFF", E.Enum.Material.SmoothPlastic)
	surfaceText(psign, E.Enum.NormalId.Back, content.Signs.potluck, "#5A2E1E", nil)
	local fig = model(pot, "BlessedFigure")
	local figBase = potCf * E.CFrame.new(5.4, 3.25, 1.2)
	local figBody = part(fig, "Body", V(0.35, 0.45, 0.25), figBase * E.CFrame.new(0, 0.22, 0), "#FFFFFF", E.Enum.Material.SmoothPlastic)
	part(fig, "Sash", V(0.36, 0.45, 0.1), figBase * E.CFrame.new(0.05, 0.22, -0.1), "#C0392B", E.Enum.Material.Fabric)
	ball(fig, "Head", 0.38, figBase * E.CFrame.new(0, 0.62, 0), "#E0AC69", E.Enum.Material.SmoothPlastic)
	part(fig, "Hair", V(0.4, 0.15, 0.4), figBase * E.CFrame.new(0, 0.8, 0.02), "#6B4226", E.Enum.Material.SmoothPlastic)
	local rib = billboard(figBody, "Ribbon", "Jesus loves you ♥", 1.2, 14, "#FFD1DC", 140, 22)
	rib.Name = "Ribbon"
	prompt(figBody, "egg:blessed", "Look closer", "Tiny figure", 0.5, 6, { RequiresLineOfSight = false })

	-- Trampoline (super bounce up to the shack roof)
	local tramp = model(hub, "Trampoline")
	cyl(tramp, "Rim", 1, 12, E.CFrame.new(-44, 1.4, -2) * E.CFrame.Angles(0, 0, math.pi / 2), "#2E86C1", E.Enum.Material.SmoothPlastic)
	local mat = cyl(tramp, "Mat", 0.3, 10.5, E.CFrame.new(-44, 2, -2) * E.CFrame.Angles(0, 0, math.pi / 2), "#111111", E.Enum.Material.Fabric)
	mat.Name = "Bounce"
	mat:SetAttribute("Bounce", 140)

	-- Mosquito zone marker
	local mz = part(hub, "MosquitoZone", V(4, 4, 4), E.CFrame.new(0, 14, 0), "#000000", nil, { Transparency = 1, CanCollide = false })
	mz:SetAttribute("Radius", 40)

	-- lamp posts & trees
	for li = 0, 7 do
		local a = li / 8 * math.pi * 2 + math.pi / 8
		local p = V(math.cos(a) * 52, 0.4, math.sin(a) * 52)
		part(hub, "Lamp" .. li, V(0.6, 10, 0.6), E.CFrame.new(p + V(0, 5, 0)), "#2C3E50", E.Enum.Material.Metal)
		local bulb = ball(hub, "LampBulb" .. li, 1.4, E.CFrame.new(p + V(0, 10.4, 0)), "#FFE9A8", E.Enum.Material.Neon)
		local light = E.Instance.new("PointLight")
		light.Range = 22
		light.Brightness = 1.4
		light.Color = hex("#FFD9A0")
		light.Parent = bulb
	end
	return hub
end

local function buildCreek(root, content)
	-- Secret creek behind the map, through the hedge gap due north of the ranches.
	local creek = model(root, "Creek")
	local z = -260
	for i = -8, 8 do
		if i ~= 0 then
			part(creek, "Hedge" .. i, V(12, 8, 6), E.CFrame.new(i * 12, 4, z + 30), "#2E7D32", E.Enum.Material.Grass)
		end
	end
	part(creek, "Water", V(200, 1, 18), E.CFrame.new(0, -0.1, z), "#3FA7D6", E.Enum.Material.Glass, { Transparency = 0.35, CanCollide = false })
	part(creek, "Bed", V(200, 1, 18), E.CFrame.new(0, -1.2, z), "#6B5B45", E.Enum.Material.Sand)
	for i = 1, 9 do
		ball(creek, "Rock" .. i, 2 + (i % 3), E.CFrame.new(-40 + i * 9, 0.4, z + ((i % 2 == 0) and 9 or -9)), "#8C8C8C", E.Enum.Material.Slate)
	end
	local stone = part(creek, "WhisperStone", V(4, 3, 3), E.CFrame.new(6, 1.5, z + 12), "#7F8C8D", E.Enum.Material.Slate)
	prompt(stone, "egg:creek", "Listen closely", content.Slang.quietCreek, 1, 8)
	local sign = part(creek, "Sign", V(5, 2, 0.3), E.CFrame.new(0, 3, z + 26), "#F4E1C1", E.Enum.Material.Wood)
	surfaceText(sign, E.Enum.NormalId.Back, content.Signs.creek, "#5A2E1E", nil)
	-- the World's Okayest Unc apron hanging on a branch
	part(creek, "Branch", V(0.6, 7, 0.6), E.CFrame.new(-14, 3.5, z + 14), "#6B4226", E.Enum.Material.Wood)
	local apron = part(creek, "OkayestApron", V(1.8, 2.2, 0.15), E.CFrame.new(-14, 5, z + 13.5), "#4A6FA5", E.Enum.Material.Fabric)
	surfaceText(apron, E.Enum.NormalId.Front, "WORLD'S OKAYEST UNC", "#FFFFFF", nil)
	prompt(apron, "egg:apron", "Take the apron", "Mystery apron", 0.5, 8)
	tree(creek, V(20, 0, z + 16), 1.1)
	tree(creek, V(-30, 0, z + 16), 1)
	return creek
end

-- ===================================================================================
-- Scenery: purely decorative set dressing so the world feels lived-in and Texas-y.
-- Rules: everything is Anchored; decor has CanCollide/CanQuery/CanTouch off and small
-- pieces don't cast shadows; it is grouped into Models by area (Horizon, Neighborhood,
-- HubDecor, CreekDecor, per-plot Decor) so StreamingEnabled can stream it by area, with the
-- far skyline marked Persistent. Shapes are simple blocks/balls/cylinders (cheap on phones).
-- Gameplay paths (roads, plot paths, patios, tables, pass windows) are left clear.
-- ===================================================================================
local PAL = {
	grass = "#79C84F",
	grassFar = "#8CC35E",
	berm = { "#86C25A", "#7AB852", "#93CB66" },
	oak = { "#3F8F3A", "#4FA346", "#468F3E" },
	mesquite = { "#8DB85A", "#7EA84E", "#9CC466" },
	trunk = "#6B4226",
	bluebonnet = "#3D6FE0",
	bonnetTip = "#F4F7FF",
	paintbrush = "#FF5A3C",
	susan = "#FFC72C",
	susanEye = "#4A2B12",
	hay = "#E2BE62",
	mesa = { "#D9A07A", "#CF9470", "#E2B08A" },
	mesaCap = "#B97A58",
	wood = "#A86B3C",
	fenceWood = "#8B5A2B",
	barnRed = "#C8433A",
	cream = "#FFF2D9",
	roof = "#5A4A44",
	metal = "#C7D0D8",
	water = "#3FB6E8",
	bronze = "#B8793A",
	bronzeHi = "#E6B25A",
	bulbs = { "#FFE9A8", "#FFB347", "#FF8FB1", "#8FD3FF" },
}
WorldBuilder.PALETTE = PAL

local seed = 20261101
local function rnd()
	seed = (seed * 1103515245 + 12345) % 2147483648
	return seed / 2147483648
end
local function rr(a, b)
	return a + (b - a) * rnd()
end
local function pick(t)
	return t[1 + math.floor(rnd() * #t) % #t]
end

local function at(pos)
	return E.CFrame.new(pos)
end
local function yaw(r)
	return E.CFrame.Angles(0, r, 0)
end
local function polar(deg, r, y)
	local a = math.rad(deg)
	return V(math.cos(a) * r, y or 0, math.sin(a) * r)
end
local function streaming(m, mode)
	pcall(function()
		m.ModelStreamingMode = E.Enum.ModelStreamingMode[mode]
	end)
end

-- ---------- reusable props ----------
local function liveOak(parent, pos, s, opts)
	opts = opts or {}
	local m = model(parent, "LiveOak")
	local sh = opts.shadow == true
	deco(m, "Trunk", V(2.2 * s, 8 * s, 2.2 * s), at(pos + V(0, 4 * s, 0)), PAL.trunk, E.Enum.Material.Wood, sh)
	if not opts.far then
		deco(m, "Limb", V(8 * s, 1.1 * s, 1.1 * s), at(pos + V(2.5 * s, 7.6 * s, 0)) * E.CFrame.Angles(0, 0, math.rad(18)), PAL.trunk, E.Enum.Material.Wood, false)
	end
	local c = pick(PAL.oak)
	dball(m, "Canopy", 12 * s, at(pos + V(0, 11 * s, 0)), c, E.Enum.Material.Grass, sh)
	dball(m, "Canopy2", 9.5 * s, at(pos + V(6 * s, 9.6 * s, 1.2 * s)), pick(PAL.oak), E.Enum.Material.Grass, false)
	if not opts.far then
		dball(m, "Canopy3", 9 * s, at(pos + V(-5.5 * s, 9.4 * s, -1.5 * s)), pick(PAL.oak), E.Enum.Material.Grass, false)
	end
	return m
end

local function mesquite(parent, pos, s)
	local m = model(parent, "Mesquite")
	local lean = rr(-0.25, 0.25)
	deco(m, "Trunk", V(1 * s, 7 * s, 1 * s), at(pos + V(0, 3.4 * s, 0)) * E.CFrame.Angles(lean, 0, lean * 0.6), "#5A3A22", E.Enum.Material.Wood, false)
	dball(m, "Leaves", 6.5 * s, at(pos + V(lean * 3 * s, 7.6 * s, 0)), pick(PAL.mesquite), E.Enum.Material.Grass, false)
	dball(m, "Leaves2", 5 * s, at(pos + V(2.6 * s, 6.6 * s, 1.6 * s)), pick(PAL.mesquite), E.Enum.Material.Grass, false)
	return m
end

local function grassClump(parent, pos, s)
	s = s or 1
	for k = 1, 3 do
		local a = k * 2.1 + rr(0, 0.5)
		deco(parent, "Grass", V(0.25 * s, 2.6 * s, 0.7 * s), at(pos + V(math.cos(a) * 0.4, 1.2 * s, math.sin(a) * 0.4)) * yaw(a) * E.CFrame.Angles(0, 0, rr(-0.35, 0.35)), "#9CC25A", E.Enum.Material.Grass, false)
	end
end

-- kind: "bluebonnet" | "paintbrush" | "susan" | "mix"
local function flowerPatch(parent, pos, radius, n, kind)
	local m = model(parent, "Wildflowers")
	for k = 1, n do
		local a, r = rr(0, math.pi * 2), math.sqrt(rnd()) * radius
		local p = pos + V(math.cos(a) * r, 0, math.sin(a) * r)
		local kd = kind == "mix" and pick({ "bluebonnet", "bluebonnet", "paintbrush", "susan" }) or kind
		if kd == "bluebonnet" then
			deco(m, "Bonnet", V(0.5, 1.2, 0.5), at(p + V(0, 0.6, 0)), PAL.bluebonnet, E.Enum.Material.SmoothPlastic, false)
			if k % 2 == 0 then
				dball(m, "Tip", 0.4, at(p + V(0, 1.3, 0)), PAL.bonnetTip, E.Enum.Material.SmoothPlastic, false)
			end
		elseif kd == "paintbrush" then
			deco(m, "Brush", V(0.45, 1.1, 0.45), at(p + V(0, 0.55, 0)), PAL.paintbrush, E.Enum.Material.SmoothPlastic, false)
		else
			dball(m, "Susan", 0.8, at(p + V(0, 0.9, 0)), PAL.susan, E.Enum.Material.SmoothPlastic, false)
		end
	end
	return m
end

local function hayBale(parent, pos, rot)
	return dcyl(parent, "HayBale", 4, 4.4, at(pos + V(0, 2.2, 0)) * yaw(rot or 0), PAL.hay, E.Enum.Material.Grass, true)
end

local function cooler(parent, cf, color)
	deco(parent, "Cooler", V(3.4, 2, 2), cf * E.CFrame.new(0, 1, 0), color or "#2F7BD8", E.Enum.Material.SmoothPlastic, true)
	deco(parent, "CoolerLid", V(3.5, 0.35, 2.1), cf * E.CFrame.new(0, 2.15, 0), "#FFFFFF", E.Enum.Material.SmoothPlastic, false)
end

local function lawnChair(parent, cf, color)
	deco(parent, "ChairSeat", V(2.2, 0.3, 2), cf * E.CFrame.new(0, 1.1, 0), color, E.Enum.Material.Fabric, true)
	deco(parent, "ChairBack", V(2.2, 2.4, 0.3), cf * E.CFrame.new(0, 2.2, 1) * E.CFrame.Angles(math.rad(-15), 0, 0), color, E.Enum.Material.Fabric, false)
	deco(parent, "ChairFrame", V(2.4, 1, 0.2), cf * E.CFrame.new(0, 0.5, -0.9), "#C7D0D8", E.Enum.Material.Metal, false)
end

local function cornhole(parent, cf, color)
	deco(parent, "Cornhole", V(2.4, 0.25, 4.4), cf * E.CFrame.new(0, 0.75, 0) * E.CFrame.Angles(math.rad(12), 0, 0), color, E.Enum.Material.WoodPlanks, true)
	dcyl(parent, "Hole", 0.08, 0.9, cf * E.CFrame.new(0, 1.12, 1.2) * E.CFrame.Angles(math.rad(12), 0, 0) * upright(), "#1C1A1F", E.Enum.Material.SmoothPlastic, false)
	deco(parent, "Bag", V(0.7, 0.25, 0.7), cf * E.CFrame.new(0.5, 0.9, -0.6) * yaw(0.4), "#D93636", E.Enum.Material.Fabric, false)
end

local function kiddiePool(parent, cf)
	dcyl(parent, "Pool", 1.3, 8, cf * E.CFrame.new(0, 0.65, 0) * upright(), "#5AD2FF", E.Enum.Material.SmoothPlastic, false)
	dcyl(parent, "PoolWater", 0.1, 7.2, cf * E.CFrame.new(0, 1.2, 0) * upright(), "#BFF0FF", E.Enum.Material.Glass, false).Transparency = 0.15
	dball(parent, "Ducky", 0.9, cf * E.CFrame.new(1.4, 1.5, 0.6), "#FFD23C", E.Enum.Material.SmoothPlastic, false)
	dball(parent, "DuckyHead", 0.55, cf * E.CFrame.new(1.4, 2.05, 0.3), "#FFD23C", E.Enum.Material.SmoothPlastic, false)
	deco(parent, "DuckyBeak", V(0.25, 0.12, 0.3), cf * E.CFrame.new(1.4, 2.0, 0.0), "#FF8A1E", E.Enum.Material.SmoothPlastic, false)
end

local function picnicBlanket(parent, cf)
	deco(parent, "Blanket", V(6, 0.12, 6), cf * E.CFrame.new(0, 0.08, 0), "#D93636", E.Enum.Material.Fabric, false)
	for _, o in ipairs({ { -1.5, -1.5 }, { 1.5, 1.5 } }) do
		deco(parent, "Check", V(3, 0.13, 3), cf * E.CFrame.new(o[1], 0.09, o[2]), "#FFF6E6", E.Enum.Material.Fabric, false)
	end
	deco(parent, "Basket", V(1.8, 1.1, 1.2), cf * E.CFrame.new(1.4, 0.65, -1.4), "#C9954C", E.Enum.Material.WoodPlanks, false)
	dball(parent, "Watermelon", 1.4, cf * E.CFrame.new(-1.4, 0.75, 1.2), "#3E9B4F", E.Enum.Material.SmoothPlastic, false)
end

local function lantern(parent, cf)
	deco(parent, "LanternPost", V(0.4, 6, 0.4), cf * E.CFrame.new(0, 3, 0), "#2C2420", E.Enum.Material.Metal, false)
	deco(parent, "LanternArm", V(1.6, 0.25, 0.25), cf * E.CFrame.new(0.7, 6, 0), "#2C2420", E.Enum.Material.Metal, false)
	deco(parent, "Lantern", V(0.8, 1, 0.8), cf * E.CFrame.new(1.3, 5.3, 0), "#FFD38A", E.Enum.Material.Neon, false)
end

-- Sagging string of bulbs between two points (wire + bulbs, no lights: cheap).
local function stringLights(parent, a, b, n, sag)
	local m = model(parent, "StringLights")
	local mid = (a + b) / 2 - V(0, sag * 0.6, 0)
	local len = (b - a).Magnitude
	deco(m, "Wire", V(0.08, 0.08, len), lookAt(mid, b - V(0, sag * 0.6, 0)), "#2C2420", E.Enum.Material.SmoothPlastic, false)
	for k = 1, n do
		local t = k / (n + 1)
		local p = a:Lerp(b, t) - V(0, math.sin(t * math.pi) * sag, 0)
		dball(m, "Bulb", 0.55, at(p - V(0, 0.3, 0)), PAL.bulbs[(k % #PAL.bulbs) + 1], E.Enum.Material.Neon, false)
	end
	return m
end

local function railFence(parent, a, b, spacing)
	local m = model(parent, "RailFence")
	local len = (b - a).Magnitude
	local dir = (b - a).Unit
	local posts = math.max(1, math.floor(len / spacing))
	for k = 0, posts do
		local p = a + dir * (k * len / posts)
		deco(m, "Post", V(0.7, 4.2, 0.7), at(p + V(0, 2.1, 0)), PAL.fenceWood, E.Enum.Material.Wood, false)
	end
	local mid = (a + b) / 2
	for _, h in ipairs({ 1.6, 3.2 }) do
		deco(m, "Rail", V(0.3, 0.45, len), lookAt(mid + V(0, h, 0), b + V(0, h, 0)), "#9C6B3E", E.Enum.Material.Wood, false)
	end
	return m
end

local function pickupTruck(parent, cf, color)
	local m = model(parent, "PickupTruck")
	local function p(name, size, off, c, mat)
		return deco(m, name, size, cf * off, c, mat or E.Enum.Material.SmoothPlastic, name == "Body")
	end
	p("Body", V(6.4, 2.2, 15), E.CFrame.new(0, 2.5, 0), color, E.Enum.Material.Metal)
	p("Cab", V(6.2, 2.6, 5), E.CFrame.new(0, 4.9, -1.2), color, E.Enum.Material.Metal)
	p("Windshield", V(5.6, 2, 0.15), E.CFrame.new(0, 5, -3.75), "#9FD4F0", E.Enum.Material.Glass)
	p("RearWindow", V(5.4, 1.6, 0.15), E.CFrame.new(0, 5.2, 1.35), "#9FD4F0", E.Enum.Material.Glass)
	p("BedFloor", V(5.6, 0.2, 6.8), E.CFrame.new(0, 3.65, 4.6), "#3A3A3A", E.Enum.Material.DiamondPlate)
	p("Tailgate", V(6.2, 0.25, 2.2), E.CFrame.new(0, 3.1, 8.6), color, E.Enum.Material.Metal)
	p("Bumper", V(6.6, 0.7, 0.6), E.CFrame.new(0, 1.6, -7.6), "#C7D0D8", E.Enum.Material.Metal)
	p("Grille", V(4.4, 1.2, 0.2), E.CFrame.new(0, 2.6, -7.55), "#2C2420")
	p("LightL", V(0.9, 0.6, 0.15), E.CFrame.new(-2.5, 3, -7.55), "#FFF6E6", E.Enum.Material.Neon)
	p("LightR", V(0.9, 0.6, 0.15), E.CFrame.new(2.5, 3, -7.55), "#FFF6E6", E.Enum.Material.Neon)
	for _, w in ipairs({ { -3.2, -4.6 }, { 3.2, -4.6 }, { -3.2, 4.6 }, { 3.2, 4.6 } }) do
		dcyl(m, "Wheel", 1.1, 3, cf * E.CFrame.new(w[1], 1.5, w[2]), "#1C1A1F", E.Enum.Material.SmoothPlastic, false)
	end
	cooler(m, cf * E.CFrame.new(-1.2, 3.75, 5.2), "#D93636")
	return m
end

local function houseBack(parent, cf, wall, trim)
	-- cf faces the hub (back of the house toward the players)
	local m = model(parent, "HouseBack")
	local function p(name, size, off, c, mat, sh)
		return deco(m, name, size, cf * off, c, mat or E.Enum.Material.SmoothPlastic, sh)
	end
	p("Walls", V(34, 13, 20), E.CFrame.new(0, 6.5, 10), wall, E.Enum.Material.WoodPlanks, true)
	p("RoofL", V(36, 1.2, 12.6), E.CFrame.new(0, 15.4, 4.6) * E.CFrame.Angles(math.rad(-32), 0, 0), PAL.roof, E.Enum.Material.Slate, true)
	p("RoofR", V(36, 1.2, 12.6), E.CFrame.new(0, 15.4, 15.4) * E.CFrame.Angles(math.rad(32), 0, 0), PAL.roof, E.Enum.Material.Slate, false)
	p("Chimney", V(2.6, 6, 2.6), E.CFrame.new(10, 17, 12), "#A0523D", E.Enum.Material.Brick, false)
	p("BackDoor", V(4, 7, 0.3), E.CFrame.new(-6, 3.5, -0.1), trim)
	p("WindowL", V(5, 3.6, 0.3), E.CFrame.new(4, 7.5, -0.1), "#BFE6FF", E.Enum.Material.Glass)
	p("WindowR", V(5, 3.6, 0.3), E.CFrame.new(12, 7.5, -0.1), "#BFE6FF", E.Enum.Material.Glass)
	p("Porch", V(14, 0.6, 6), E.CFrame.new(-6, 0.3, -3), PAL.wood, E.Enum.Material.WoodPlanks)
	p("ACUnit", V(3, 3, 3), E.CFrame.new(14, 1.5, -2), "#C7D0D8", E.Enum.Material.Metal)
	-- privacy fence around the backyard
	local fy, fh = 3, 6
	p("FenceBack", V(44, fh, 0.5), E.CFrame.new(0, fy, -22), "#B07A48", E.Enum.Material.WoodPlanks)
	p("FenceL", V(0.5, fh, 22), E.CFrame.new(-22, fy, -11), "#B07A48", E.Enum.Material.WoodPlanks)
	p("FenceR", V(0.5, fh, 22), E.CFrame.new(22, fy, -11), "#B07A48", E.Enum.Material.WoodPlanks)
	return m
end

local function waterTower(parent, pos, label)
	local m = model(parent, "WaterTower")
	local legH, tankY = 34, 42
	for _, o in ipairs({ { -5, -5 }, { 5, -5 }, { -5, 5 }, { 5, 5 } }) do
		deco(m, "Leg", V(1, legH, 1), at(pos + V(o[1] * 0.8, legH / 2, o[2] * 0.8)) * E.CFrame.Angles(math.rad(o[2] * 0.6), 0, math.rad(-o[1] * 0.6)), PAL.metal, E.Enum.Material.Metal, true)
	end
	deco(m, "Brace", V(10, 0.5, 0.5), at(pos + V(0, 16, -4.4)), PAL.metal, E.Enum.Material.Metal, false)
	deco(m, "Brace2", V(0.5, 0.5, 10), at(pos + V(4.4, 16, 0)), PAL.metal, E.Enum.Material.Metal, false)
	deco(m, "Catwalk", V(15, 0.5, 15), at(pos + V(0, legH + 0.5, 0)), "#8E9AA6", E.Enum.Material.DiamondPlate, false)
	dcyl(m, "Tank", 14, 16, at(pos + V(0, tankY, 0)) * upright(), "#F2F5F7", E.Enum.Material.Metal, true)
	dball(m, "Cap", 16.4, at(pos + V(0, tankY + 4, 0)), "#E1E7EC", E.Enum.Material.Metal, false)
	deco(m, "Spire", V(0.6, 4, 0.6), at(pos + V(0, tankY + 13.6, 0)), PAL.barnRed, E.Enum.Material.Metal, false)
	-- the label sits on a band facing the hub, and again on the far side
	local face = lookAt(pos + V(0, tankY, 0), V(0, tankY, 0))
	local band = deco(m, "LabelBand", V(12, 5.5, 0.4), face * E.CFrame.new(0, 0, -7.9), "#F2F5F7", E.Enum.Material.Metal, false)
	surfaceText(band, E.Enum.NormalId.Front, label, PAL.barnRed, nil)
	local back = deco(m, "LabelBandBack", V(12, 5.5, 0.4), face * E.CFrame.new(0, 0, 7.9) * yaw(math.pi), "#F2F5F7", E.Enum.Material.Metal, false)
	surfaceText(back, E.Enum.NormalId.Front, label, PAL.barnRed, nil)
	return m
end

local function windmill(parent, pos, facing)
	local m = model(parent, "Windmill")
	for _, o in ipairs({ { -3, -3 }, { 3, -3 }, { -3, 3 }, { 3, 3 } }) do
		deco(m, "Leg", V(0.6, 32, 0.6), at(pos + V(o[1] * 0.55, 16, o[2] * 0.55)) * E.CFrame.Angles(math.rad(o[2] * 1.4), 0, math.rad(-o[1] * 1.4)), PAL.metal, E.Enum.Material.Metal, true)
	end
	local hubCf = at(pos + V(0, 32.5, 0)) * yaw(facing)
	deco(m, "Head", V(1.6, 1.6, 3.4), hubCf, "#8E9AA6", E.Enum.Material.Metal, false)
	deco(m, "TailBoom", V(0.4, 0.4, 7), hubCf * E.CFrame.new(0, 0, 4.5), "#8E9AA6", E.Enum.Material.Metal, false)
	local vane = deco(m, "TailVane", V(0.2, 4, 4.5), hubCf * E.CFrame.new(0, 0.5, 8.4), PAL.barnRed, E.Enum.Material.Metal, false)
	surfaceText(vane, E.Enum.NormalId.Right, "ROCH", "#FFF2D9", nil)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		deco(m, "Blade", V(0.15, 5.5, 1.1), hubCf * E.CFrame.new(0, 0, -1.9) * E.CFrame.Angles(0, 0, a) * E.CFrame.new(0, 3.6, 0) * E.CFrame.Angles(0, 0.35, 0), "#E1E7EC", E.Enum.Material.Metal, false)
	end
	dcyl(m, "Tank", 3, 9, at(pos + V(7, 1.5, 4)) * upright(), "#9AA5AE", E.Enum.Material.Metal, false)
	return m
end

local function mesa(parent, pos, w, h, d, rot)
	-- stepped butte: wide talus skirt, sloped shoulders, sheer body, darker caprock
	local m = model(parent, "Mesa")
	local cf = at(pos) * yaw(rot)
	local c = pick(PAL.mesa)
	deco(m, "Talus", V(w * 1.3, h * 0.3, d * 1.25), cf * E.CFrame.new(0, h * 0.15 - 4, 0), PAL.mesa[3], E.Enum.Material.Sandstone, false)
	deco(m, "ShoulderL", V(w * 0.35, h * 0.55, d * 1.05), cf * E.CFrame.new(-w * 0.5, h * 0.15, 0) * E.CFrame.Angles(0, 0, math.rad(-38)), c, E.Enum.Material.Sandstone, false)
	deco(m, "ShoulderR", V(w * 0.35, h * 0.55, d * 1.05), cf * E.CFrame.new(w * 0.5, h * 0.15, 0) * E.CFrame.Angles(0, 0, math.rad(38)), c, E.Enum.Material.Sandstone, false)
	deco(m, "Body", V(w, h, d), cf * E.CFrame.new(0, h / 2 - 4, 0), c, E.Enum.Material.Sandstone, false)
	deco(m, "Cap", V(w * 1.04, 5, d * 1.04), cf * E.CFrame.new(0, h - 4, 0), PAL.mesaCap, E.Enum.Material.Sandstone, false)
	return m
end

local function fireflies(parent, cf, size)
	local box = deco(parent, "FireflyZone", size, cf, "#000000", nil, false)
	box.Transparency = 1
	if E.NumberSequence and E.NumberRange and E.ColorSequence then
		local pe = E.Instance.new("ParticleEmitter")
		pe.Name = "Fireflies"
		pe.Enabled = false -- Ambient (client) turns these on at dusk
		pe.Rate = 5
		pe.Lifetime = E.NumberRange.new(4, 7)
		pe.Speed = E.NumberRange.new(0.3, 1.2)
		pe.SpreadAngle = E.Vector2 and E.Vector2.new(180, 180) or pe.SpreadAngle
		pe.LightEmission = 1
		pe.LightInfluence = 0
		pe.Size = E.NumberSequence.new(0.22)
		pe.Color = E.ColorSequence.new(hex("#FFF27A"))
		pe.Transparency = E.NumberSequence.new(0.1)
		pe.Parent = box
		pcall(function()
			pe.Shape = E.Enum.ParticleEmitterShape.Box
			pe.ShapeStyle = E.Enum.ParticleEmitterShapeStyle.Volume
		end)
	end
	return box
end

local function leaves(parentPart)
	if not (E.NumberSequence and E.NumberRange and E.ColorSequence) then
		return
	end
	local pe = E.Instance.new("ParticleEmitter")
	pe.Name = "DriftingLeaves"
	pe.Rate = 0.5
	pe.Lifetime = E.NumberRange.new(6, 9)
	pe.Speed = E.NumberRange.new(0.5, 1.5)
	pe.Acceleration = V(0.6, -1.2, 0.4)
	pe.RotSpeed = E.NumberRange.new(-90, 90)
	pe.Rotation = E.NumberRange.new(0, 360)
	pe.Size = E.NumberSequence.new(0.35)
	pe.Color = E.ColorSequence.new(hex("#D9A441"), hex("#7FB24A"))
	pe.LightInfluence = 1
	pe.Parent = parentPart
end

local function smokeWisp(parentPart)
	local s = E.Instance.new("Smoke")
	s.Name = "Wisp"
	s.Size = 1.2
	s.Opacity = 0.08
	s.RiseVelocity = 2.5
	s.Color = hex("#E8E2D8")
	s.Parent = parentPart
end

-- ---------- Big Bertha, the hub landmark ----------
-- The King of the Pit's 1,000-gallon trailer smoker: a huge riveted barrel with a glowing
-- firebox, a tall smokestack, and a ranch dinner bell on an A-frame. Ringing the bell is the
-- "landmark:bell" prompt (daily glaze plus the 3-player Dinner Bell pile-on). The "Say
-- Brisket!" photo spot stands in front. The front faces the spawn (-Z).
local function ell(parent, name, size, cf, color, material)
	local p = deco(parent, name, size, cf, color, material or E.Enum.Material.SmoothPlastic, false)
	local mesh = E.Instance.new("SpecialMesh")
	mesh.MeshType = E.Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end
WorldBuilder.ellipsoid = ell

-- Turkey Day Smokeout decor for the hub potluck table (built at runtime only during Thanksgiving
-- week, then destroyed). `pot` is the Potluck model; everything is placed off its Table part.
-- Adds a glazed smoked turkey (the "Share a dish" prompt), a pecan pie, pumpkins, a corn-stalk
-- arch with fall pennants, and a banner. Original art, no brands.
function WorldBuilder.turkeyDay(pot, content)
	local tablePart = pot:FindFirstChild("Table")
	if not tablePart then
		return nil
	end
	local old = pot:FindFirstChild("TurkeyDay")
	if old then
		old:Destroy()
	end
	local m = model(pot, "TurkeyDay")
	local base = tablePart.CFrame * E.CFrame.new(0, -3, 0) -- the potluck's own origin (ground)
	local function B(x, y, z, rx, ry, rz)
		return base * E.CFrame.new(x, y, z) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	local TOP = 3.25
	local TX = 1.3 -- turkey x on the table
	-- table runner in harvest orange
	deco(m, "Runner", V(13.6, 0.06, 1.6), B(0, TOP + 0.03, 0.6), "#C8641E", E.Enum.Material.Fabric)
	-- the smoked turkey on a platter
	dcyl(m, "Platter", 0.16, 3.4, B(TX, TOP + 0.1, 0.7) * upright(), "#F4F1EA", E.Enum.Material.SmoothPlastic)
	local body = ell(m, "TurkeyBody", V(2.8, 1.65, 2.1), B(TX, TOP + 0.9, 0.7), "#9C4A1A")
	ell(m, "TurkeyGlaze", V(2.4, 0.75, 1.75), B(TX, TOP + 1.45, 0.7), "#B8642A")
	for side = -1, 1, 2 do
		ell(m, "Drumstick", V(1.3, 0.75, 0.75), B(TX + side * 1.25, TOP + 0.75, 1.25, 0, side * 25, side * -20), "#8E4316")
		dball(m, "Frill", 0.42, B(TX + side * 1.9, TOP + 1.0, 1.55), "#FFFFFF", E.Enum.Material.SmoothPlastic)
		ell(m, "Wing", V(0.9, 0.6, 1.2), B(TX + side * 1.05, TOP + 0.95, 0.2), "#8E4316")
	end
	for k = -1, 1 do -- herb sprigs
		dball(m, "Herb", 0.32, B(TX + k * 0.9, TOP + 0.3, 2.15), "#4E8A3A", E.Enum.Material.SmoothPlastic)
	end
	prompt(body, "event:potluck", "Share a dish", "Turkey Day Potluck", 0.4, 10)
	-- pecan pie
	dcyl(m, "PieTin", 0.28, 1.9, B(-1.5, TOP + 0.17, 0.5) * upright(), "#E3B36A", E.Enum.Material.SmoothPlastic)
	dcyl(m, "PieFill", 0.06, 1.55, B(-1.5, TOP + 0.33, 0.5) * upright(), "#6B3416", E.Enum.Material.SmoothPlastic)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		ell(m, "Pecan", V(0.3, 0.1, 0.18), B(-1.5 + math.cos(a) * 0.45, TOP + 0.38, 0.5 + math.sin(a) * 0.45, 0, math.deg(a), 0), "#8B5A2B")
	end
	-- cornbread squares
	for k = 0, 2 do
		deco(m, "Cornbread", V(0.6, 0.35, 0.6), B(3.6 + k * 0.65, TOP + 0.2, 0.1), "#F2C14E", E.Enum.Material.SmoothPlastic)
	end
	-- pumpkins at the table ends
	local PUMP = { { -8.2, 0.8, 1.2, 2.0 }, { -7.4, 0.55, -0.9, 1.3 }, { 8.1, 0.7, 1.0, 1.7 } }
	for i, pk in ipairs(PUMP) do
		ell(m, "Pumpkin" .. i, V(pk[4] * 1.25, pk[4], pk[4] * 1.25), B(pk[1], pk[2] + pk[4] * 0.35, pk[3]), "#E8761E")
		deco(m, "Stem" .. i, V(0.22, 0.45, 0.22), B(pk[1], pk[2] + pk[4] * 0.85 + 0.2, pk[3]), "#4E6B2A", E.Enum.Material.Wood)
	end
	-- corn-stalk arch posts with a pennant line and banner
	for side = -1, 1, 2 do
		deco(m, "Post", V(0.4, 8.6, 0.4), B(side * 7.6, 4.3, -1.6), "#7A4E2A", E.Enum.Material.Wood, true)
		for k = 0, 3 do
			deco(m, "Stalk", V(0.18, 4.4, 0.6), B(side * (7.6 + 0.35), 2.2 + k * 0.2, -1.6 + (k - 1.5) * 0.35, 0, 0, side * (8 + k * 4)), k % 2 == 0 and "#C9A44C" or "#B08838", E.Enum.Material.Grass)
		end
	end
	local banner = part(m, "Banner", V(10.5, 1.5, 0.2), B(0, 8.05, -1.6), "#7A2E12", E.Enum.Material.Fabric, { CanCollide = false, CanQuery = false, CanTouch = false })
	local bt = surfaceText(banner, E.Enum.NormalId.Back, content and content.Signs and content.Signs.turkeyBanner or "TURKEY DAY COOKOUT", "#FFE3A0", nil)
	bt.Name = "BannerText"
	local PEN = { "#C8641E", "#E3A126", "#8E3B1E", "#6B8E23" }
	for k = 0, 12 do
		local x = -7.2 + k * 1.2
		local sag = -0.6 * (1 - ((x / 7.2) ^ 2))
		deco(m, "Pennant", V(0.75, 0.75, 0.06), B(x, 6.85 + sag, -1.6, 0, 0, 45), PEN[k % #PEN + 1], E.Enum.Material.Fabric)
	end
	return m
end

-- A few pumpkins and a corn bundle by the welcome arch, only while Turkey Day is on.
-- Built at runtime and removed with the potluck decor. No collision, so the path stays clear.
-- Original shapes only: pumpkins and a corn bundle, nothing borrowed.
function WorldBuilder.autumnRanch(hub)
	if not hub then
		return nil
	end
	local old = hub:FindFirstChild("AutumnRanch")
	if old then
		old:Destroy()
	end
	local m = model(hub, "AutumnRanch")
	local spots = {
		{ -16.2, 0.85, -46.5, 1.7 },
		{ -18.4, 0.55, -48.2, 1.15 },
		{ 16.4, 0.8, -47.2, 1.55 },
		{ 18.2, 0.5, -44.8, 1.05 },
	}
	for i, pk in ipairs(spots) do
		local p = deco(m, "Pumpkin" .. i, V(pk[4] * 1.2, pk[4], pk[4] * 1.2), E.CFrame.new(pk[1], pk[2], pk[3]), "#E8761E", E.Enum.Material.SmoothPlastic, true)
		local mesh = E.Instance.new("SpecialMesh")
		mesh.MeshType = E.Enum.MeshType.Sphere
		mesh.Parent = p
		deco(m, "Stem" .. i, V(0.18, 0.4, 0.18), E.CFrame.new(pk[1], pk[2] + pk[4] * 0.55, pk[3]), "#4E6B2A", E.Enum.Material.Wood, false)
	end
	for k = 0, 3 do
		deco(m, "Corn", V(0.16, 2.8, 0.42), E.CFrame.new(-14.4, 1.4, -47.2 + k * 0.28) * E.CFrame.Angles(0, 0, math.rad((k - 1.5) * 8)), k % 2 == 0 and "#C9A44C" or "#B08838", E.Enum.Material.Grass, false)
	end
	return m
end

-- Holiday Smokeout decor for the hub potluck table (built at runtime only Dec 19 - Jan 1, then
-- destroyed). Same layout rules as Turkey Day: everything hangs off the Potluck's Table part.
-- Adds a glazed holiday ham (the "Share a dish" prompt), a tray of tamales, sugar cookies, a little
-- Christmas tree with a star, wrapped presents, an evergreen garland with colored bulbs, and a
-- banner. Original art, no brands or characters.
function WorldBuilder.holidaySmokeout(pot, content)
	local tablePart = pot:FindFirstChild("Table")
	if not tablePart then
		return nil
	end
	local old = pot:FindFirstChild("HolidaySmokeout")
	if old then
		old:Destroy()
	end
	local m = model(pot, "HolidaySmokeout")
	local base = tablePart.CFrame * E.CFrame.new(0, -3, 0) -- the potluck's own origin (ground)
	local function B(x, y, z, rx, ry, rz)
		return base * E.CFrame.new(x, y, z) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	local TOP = 3.25
	local HX = 1.3 -- ham x on the table
	local BULBS = { "#FF3B3B", "#FFD54A", "#3BD16F", "#4FA3FF", "#FF7AD9" }
	-- red runner with a green stripe down the middle
	deco(m, "Runner", V(13.6, 0.06, 1.6), B(0, TOP + 0.03, 0.6), "#B3122E", E.Enum.Material.Fabric)
	deco(m, "RunnerStripe", V(13.6, 0.07, 0.35), B(0, TOP + 0.04, 0.6), "#1E6B3A", E.Enum.Material.Fabric)
	-- the glazed holiday ham on a platter, scored glaze and cloves
	dcyl(m, "Platter", 0.16, 3.4, B(HX, TOP + 0.1, 0.7) * upright(), "#F4F1EA", E.Enum.Material.SmoothPlastic)
	local body = ell(m, "HamBody", V(2.5, 1.8, 2.0), B(HX, TOP + 0.95, 0.7), "#C4664E")
	ell(m, "HamGlaze", V(2.1, 0.9, 1.7), B(HX, TOP + 1.5, 0.7), "#A8462A")
	for k = -1, 1 do
		deco(m, "Score", V(0.06, 0.05, 1.5), B(HX + k * 0.5, TOP + 1.93, 0.7, 0, 35, 0), "#8E3B1E", E.Enum.Material.SmoothPlastic)
		deco(m, "Score", V(0.06, 0.05, 1.5), B(HX + k * 0.5, TOP + 1.93, 0.7, 0, -35, 0), "#8E3B1E", E.Enum.Material.SmoothPlastic)
	end
	dcyl(m, "Bone", 0.7, 0.32, B(HX + 1.45, TOP + 1.0, 0.7), "#F3E9D2", E.Enum.Material.SmoothPlastic)
	for k = -1, 1, 2 do -- rosemary sprigs and cranberries on the platter
		dball(m, "Sprig", 0.3, B(HX + k * 1.2, TOP + 0.3, 1.9), "#3E7B3A", E.Enum.Material.SmoothPlastic)
		dball(m, "Berry", 0.22, B(HX + k * 1.35, TOP + 0.3, 1.75), "#B3122E", E.Enum.Material.SmoothPlastic)
	end
	prompt(body, "event:potluck", "Share a dish", "Christmas Potluck", 0.4, 10)
	-- a tray of tamales (a Texas Christmas tradition)
	deco(m, "TamaleTray", V(2.2, 0.16, 1.4), B(-1.7, TOP + 0.1, 0.5), "#C9CED6", E.Enum.Material.Metal)
	for r = 0, 1 do
		for k = 0, 3 do
			local t = ell(m, "Tamale", V(0.42, 0.32, 1.1), B(-2.4 + k * 0.48, TOP + 0.33, 0.2 + r * 0.6), "#E9D3A0")
			t.Material = E.Enum.Material.Fabric
		end
	end
	-- sugar cookies (stars and trees) on a plate
	dcyl(m, "CookiePlate", 0.1, 1.6, B(4.2, TOP + 0.07, 0.4) * upright(), "#FFFFFF", E.Enum.Material.SmoothPlastic)
	local COOK = { "#F4F1EA", "#3BD16F", "#FF3B3B", "#FFD54A" }
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2
		deco(m, "Cookie", V(0.45, 0.1, 0.45), B(4.2 + math.cos(a) * 0.4, TOP + 0.16, 0.4 + math.sin(a) * 0.4, 0, 45 + k * 20, 0), COOK[k + 1], E.Enum.Material.SmoothPlastic)
	end
	-- a little Christmas tree at the left end: stacked boughs, bulbs and a glowing star
	local TX, TZ = -8.4, 0.6
	deco(m, "TreeTrunk", V(0.6, 1.2, 0.6), B(TX, 0.6, TZ), "#5A3A22", E.Enum.Material.Wood)
	local tiers = { { 1.2, 3.6, 1.8 }, { 2.6, 2.8, 1.6 }, { 3.8, 2.0, 1.4 }, { 4.8, 1.2, 1.1 } }
	for i, t in ipairs(tiers) do
		local y, w, h = t[1], t[2], t[3]
		ell(m, "Bough" .. i, V(w, h, w), B(TX, y, TZ), i % 2 == 0 and "#2E7D46" or "#25693A")
		for k = 0, 4 do
			local a = (k / 5 + i * 0.13) * math.pi * 2
			dball(m, "TreeBulb", 0.3, B(TX + math.cos(a) * w * 0.47, y - h * 0.15, TZ + math.sin(a) * w * 0.47), BULBS[(k + i) % #BULBS + 1], E.Enum.Material.Neon)
		end
	end
	for k = 0, 1 do -- the star: two squares turned 45 degrees apart
		deco(m, "Star", V(0.75, 0.75, 0.12), B(TX, 5.75, TZ, 0, 0, 45 * k), "#FFD54A", E.Enum.Material.Neon)
	end
	-- wrapped presents under the tree and at the right end
	local GIFTS = { { -7.0, 1.0, 1.6, 1.0, "#B3122E", "#FFD54A" }, { -7.3, 0.7, -0.4, 0.8, "#1E6B3A", "#FFFFFF" }, { 7.9, 1.1, 1.0, 1.2, "#2E5BA8", "#FFD54A" }, { 8.5, 0.7, -0.6, 0.8, "#FFFFFF", "#B3122E" } }
	for i, g in ipairs(GIFTS) do
		local x, sz, z, h, box, ribbon = g[1], g[2], g[3], g[4], g[5], g[6]
		deco(m, "Gift" .. i, V(sz, h, sz), B(x, h / 2, z, 0, i * 17, 0), box, E.Enum.Material.SmoothPlastic, true)
		deco(m, "RibbonA" .. i, V(sz + 0.04, h + 0.04, 0.16), B(x, h / 2, z, 0, i * 17, 0), ribbon, E.Enum.Material.Fabric)
		deco(m, "RibbonB" .. i, V(0.16, h + 0.04, sz + 0.04), B(x, h / 2, z, 0, i * 17, 0), ribbon, E.Enum.Material.Fabric)
		dball(m, "Bow" .. i, 0.4, B(x, h + 0.12, z), ribbon, E.Enum.Material.Fabric)
	end
	-- garland posts wrapped red and white, an evergreen garland with bulbs, and the banner
	for side = -1, 1, 2 do
		deco(m, "Post", V(0.4, 8.6, 0.4), B(side * 7.6, 4.3, -1.6), "#F4F1EA", E.Enum.Material.SmoothPlastic, true)
		for k = 0, 7 do
			deco(m, "PostStripe", V(0.44, 0.35, 0.44), B(side * 7.6, 0.6 + k * 1.05, -1.6, 0, 0, side * 20), "#B3122E", E.Enum.Material.SmoothPlastic)
		end
		ell(m, "Wreath", V(1.4, 1.4, 0.4), B(side * 7.6, 5.3, -1.25), "#2E7D46")
		ell(m, "WreathHole", V(0.6, 0.6, 0.42), B(side * 7.6, 5.3, -1.22), "#F4F1EA")
		dball(m, "WreathBow", 0.4, B(side * 7.6, 4.7, -1.05), "#B3122E", E.Enum.Material.Fabric)
	end
	local banner = part(m, "Banner", V(10.5, 1.5, 0.2), B(0, 8.05, -1.6), "#1E6B3A", E.Enum.Material.Fabric, { CanCollide = false, CanQuery = false, CanTouch = false })
	local bt = surfaceText(banner, E.Enum.NormalId.Back, content and content.Signs and content.Signs.holidayBanner or "HOLIDAY COOKOUT", "#FFE9A8", nil)
	bt.Name = "BannerText"
	for k = 0, 12 do
		local x = -7.2 + k * 1.2
		local sag = -0.6 * (1 - ((x / 7.2) ^ 2))
		ell(m, "Garland", V(1.35, 0.45, 0.45), B(x, 6.85 + sag, -1.6), k % 2 == 0 and "#2E7D46" or "#25693A")
		dball(m, "GarlandBulb", 0.3, B(x + 0.3, 6.55 + sag, -1.75), BULBS[k % #BULBS + 1], E.Enum.Material.Neon)
	end
	return m
end

function WorldBuilder.bertha(parent, base, content)
	local m = model(parent, "BigBertha")
	local IRON, IRON_D, RUST, STEEL = "#3A3536", "#262223", "#7A3B22", "#B9BEC4"
	local function B(x, y, z, rx, ry, rz)
		return base * E.CFrame.new(x, y, z) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	-- brick pad
	cyl(m, "Pad", 1, 25, B(0, 0.5, 0) * upright(), "#B5654A", E.Enum.Material.Brick)
	cyl(m, "PadTrim", 0.4, 25.8, B(0, 1.05, 0) * upright(), "#D9CDB8", E.Enum.Material.Slate)
	local plaque = part(m, "Plaque", V(9, 1.6, 0.3), B(0, 0.8, -12.55), "#C9A04A", E.Enum.Material.Metal)
	surfaceText(plaque, E.Enum.NormalId.Front, content and content.Signs and content.Signs.bertha or "BIG BERTHA", "#3A2414", nil)

	-- trailer: frame, axle, two big wheels each side, tongue
	part(m, "Frame", V(20, 0.7, 6.4), B(-1, 3.4, 0), IRON_D, E.Enum.Material.Metal)
	part(m, "Tongue", V(4, 0.5, 0.6), B(10.5, 3.2, 0), IRON_D, E.Enum.Material.Metal)
	dball(m, "Hitch", 0.9, B(12.4, 3.2, 0), STEEL, E.Enum.Material.Metal, false)
	part(m, "Jack", V(0.4, 2.2, 0.4), B(11.8, 2.1, 0), STEEL, E.Enum.Material.Metal)
	for _, wx in { -4.8, -1.2 } do
		for _, wz in { -3.6, 3.6 } do
			dcyl(m, "Tire", 1.1, 3.6, B(wx, 2.8, wz, 0, 90, 0), "#1C1C1C", E.Enum.Material.SmoothPlastic, true)
			dcyl(m, "Hub", 1.2, 1.5, B(wx, 2.8, wz, 0, 90, 0), STEEL, E.Enum.Material.Metal, false)
		end
	end
	-- the barrel: 16 long, 7 across, with riveted bands and a lid seam
	local barrel = cyl(m, "Barrel", 16, 7, B(0, 7.4, 0), IRON, E.Enum.Material.Metal)
	for _, bx in { -7.3, -2.5, 2.5, 7.3 } do
		dcyl(m, "Band", 0.45, 7.25, B(bx, 7.4, 0), IRON_D, E.Enum.Material.Metal, false)
	end
	dcyl(m, "EndCapL", 0.3, 6.4, B(-8.05, 7.4, 0), RUST, E.Enum.Material.Metal, false)
	dcyl(m, "EndCapR", 0.3, 6.4, B(8.05, 7.4, 0), RUST, E.Enum.Material.Metal, false)
	deco(m, "LidSeam", V(15.2, 0.18, 0.2), B(0, 7.7, -3.55), IRON_D, E.Enum.Material.Metal, false)
	-- lid handle: a long steel bar on standoffs
	dcyl(m, "LidHandle", 10, 0.45, B(0, 7.0, -4.3), STEEL, E.Enum.Material.Metal, false)
	for _, hx in { -4.6, 4.6 } do
		deco(m, "HandlePost", V(0.3, 0.3, 0.9), B(hx, 7.0, -3.85), STEEL, E.Enum.Material.Metal, false)
	end
	-- name plate on the lid
	local nameplate = part(m, "NamePlate", V(7.4, 1.5, 0.2), B(0, 9.6, -2.82, 38, 0, 0), "#E8B04A", E.Enum.Material.Metal)
	surfaceText(nameplate, E.Enum.NormalId.Front, "BIG BERTHA", "#2A1A10", nil)
	-- dial thermometer on the lid
	dcyl(m, "Gauge", 0.35, 1.5, B(5.4, 9.6, -2.85, 38, 0, 0) * E.CFrame.Angles(0, math.rad(90), 0), "#F4F1EC", E.Enum.Material.SmoothPlastic, false)
	deco(m, "GaugeNeedle", V(0.1, 0.6, 0.08), B(5.4, 9.62, -3.04, 38, 0, 0) * E.CFrame.Angles(0, 0, math.rad(-35)), "#D93636", E.Enum.Material.SmoothPlastic, false)
	-- firebox with a glowing door
	part(m, "Firebox", V(5.2, 5.2, 5.2), B(-10.6, 6.4, 0), IRON, E.Enum.Material.Metal)
	local door = part(m, "FireDoor", V(3.2, 2.2, 0.2), B(-10.6, 5.8, -2.65), "#FF7A1A", E.Enum.Material.Neon)
	door.CanCollide = false
	for k = -1, 1 do
		deco(m, "DoorGrate", V(0.18, 2.2, 0.12), B(-10.6 + k * 0.9, 5.8, -2.78), IRON_D, E.Enum.Material.Metal, false)
	end
	dcyl(m, "Damper", 0.3, 1.6, B(-10.6, 7.9, -2.65, 0, 90, 0), STEEL, E.Enum.Material.Metal, false)
	local fire = E.Instance.new("PointLight")
	fire.Color = hex("#FF8A3D")
	fire.Range = 18
	fire.Brightness = 1.6
	fire.Parent = door
	-- logs stacked under the firebox end
	for k = 0, 2 do
		dcyl(m, "Log", 3.4, 1.0, B(-10.6, 1.6 + k * 0.85, -1.2 + (k % 2) * 1.1, 0, 90, 0), "#7A4A2A", E.Enum.Material.Wood, false)
	end
	-- smokestack with a cap and a steady plume
	local chimney = cyl(m, "Chimney", 10, 1.5, B(7.2, 15.0, 0) * upright(), IRON_D, E.Enum.Material.Metal)
	dcyl(m, "StackCap", 0.4, 2.6, B(7.2, 20.3, 0) * upright(), IRON_D, E.Enum.Material.Metal, false)
	local smoke = E.Instance.new("Smoke")
	smoke.Name = "Plume"
	smoke.Size = 5
	smoke.RiseVelocity = 6
	smoke.Opacity = 0.25
	smoke.Color = hex("#E8E8E8")
	smoke.Parent = chimney
	-- a giant brisket resting on the work shelf (it's always ready for a photo)
	part(m, "Shelf", V(5, 0.4, 2.6), B(3.5, 4.8, -4.4), "#8B5A2B", E.Enum.Material.WoodPlanks)
	ell(m, "ShowBrisket", V(3.8, 1.3, 2.0), B(3.5, 5.55, -4.4), "#4A2418", E.Enum.Material.SmoothPlastic)
	ell(m, "ShowBrisketFat", V(3.0, 0.5, 1.6), B(3.5, 6.05, -4.4), "#6E3A22", E.Enum.Material.SmoothPlastic)

	-- the dinner bell: a brass ranch bell on a wooden A-frame (the bell itself swings in Fx)
	local frameCf = B(9.5, 0, -7.5, 0, -25, 0)
	for _, sx in { -2.2, 2.2 } do
		part(m, "BellPost", V(0.8, 9.5, 0.8), frameCf * E.CFrame.new(sx, 5.5, 0), "#6B4226", E.Enum.Material.Wood)
	end
	part(m, "BellBeam", V(5.6, 0.8, 0.9), frameCf * E.CFrame.new(0, 10.4, 0), "#8B5A2B", E.Enum.Material.Wood)
	local bellModel = model(m, "DinnerBell")
	local yoke = part(bellModel, "Yoke", V(1.8, 0.5, 0.6), frameCf * E.CFrame.new(0, 9.75, 0), "#3A2414", E.Enum.Material.Wood)
	yoke.CanCollide = false
	local bell = ell(bellModel, "Bell", V(2.6, 3.0, 2.6), frameCf * E.CFrame.new(0, 8.3, 0), "#E0B040", E.Enum.Material.Foil)
	dcyl(bellModel, "BellLip", 0.45, 3.2, frameCf * E.CFrame.new(0, 7.05, 0) * upright(), "#C9962E", E.Enum.Material.Foil, false)
	dball(bellModel, "Clapper", 0.7, frameCf * E.CFrame.new(0, 6.6, 0), "#5A4520", E.Enum.Material.Metal, false)
	deco(bellModel, "Rope", V(0.15, 4.8, 0.15), frameCf * E.CFrame.new(0.9, 5.0, 0), "#D9C29A", E.Enum.Material.Fabric, false)
	bellModel.PrimaryPart = yoke
	billboard(bell, "Label", "🔔 Big Bertha's Dinner Bell", 3.4, 160, "#FFC83C", 300, 40, { 6, 0.8, 110, 18 })
	prompt(bell, "landmark:bell", "Ring the bell", "Big Bertha's Dinner Bell", 0, 14)

	-- "Say Brisket!" photo spot: a camera on a tripod aimed at Bertha (opens the share sheet)
	local cam = base * E.CFrame.new(-6, 0, -17) * E.CFrame.Angles(0, math.rad(200), 0)
	for i = 0, 2 do
		local a2 = i / 3 * math.pi * 2
		local foot = cam * E.CFrame.new(math.cos(a2) * 0.9, 0, math.sin(a2) * 0.9)
		local topP = cam * E.CFrame.new(0, 3.6, 0)
		local mid = foot.Position:Lerp(topP.Position, 0.5)
		local len = (topP.Position - foot.Position).Magnitude
		part(m, "TripodLeg", V(0.25, len, 0.25), E.CFrame.lookAt(mid, topP.Position) * E.CFrame.Angles(math.rad(90), 0, 0), "#3A2414", E.Enum.Material.Wood)
	end
	local body = part(m, "PhotoCamera", V(1.8, 1.2, 1.0), cam * E.CFrame.new(0, 4.2, 0), "#2A2B30", E.Enum.Material.SmoothPlastic)
	cyl(m, "Lens", 0.7, 0.8, cam * E.CFrame.new(0, 4.2, -0.75) * E.CFrame.Angles(0, math.rad(90), 0), "#111111", E.Enum.Material.Glass)
	local board = part(m, "PhotoSign", V(3.4, 1.2, 0.2), cam * E.CFrame.new(0, 2.2, 0.5), "#FFC83C", E.Enum.Material.SmoothPlastic)
	surfaceText(board, E.Enum.NormalId.Back, "📸 SAY BRISKET!", "#3A2414", nil)
	surfaceText(board, E.Enum.NormalId.Front, "📸 SAY BRISKET!", "#3A2414", nil)
	prompt(body, "ui:photo", "Snap & share", "Say Brisket! photo spot", 0, 10)
	-- bluebonnet bed around the pad
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + math.pi / 8
		if i == 5 or i == 6 then
			continue -- keep the plaque side clear
		end
		flowerPatch(m, (base * E.CFrame.new(math.cos(a) * 14.2, 0.4, math.sin(a) * 14.2)).Position, 1.4, 5, i % 2 == 0 and "bluebonnet" or "mix")
	end
	return m, barrel
end

-- ---------- per-plot dressing (outside every gameplay footprint) ----------
local function plotDecor(plotModel, cf, i)
	local m = model(plotModel, "Decor")
	streaming(m, "Atomic")
	local y = 0.6
	local function L(x, z)
		return cf * E.CFrame.new(x, y, z)
	end
	lantern(m, L(-30, 14))
	lantern(m, L(30, 14) * yaw(math.pi))
	local v = i % 3
	if v == 0 then
		kiddiePool(m, L(-18, -18))
	elseif v == 1 then
		cornhole(m, L(-18, -26), "#2F7BD8")
		cornhole(m, L(-18, -10) * yaw(math.pi), "#D93636")
	else
		picnicBlanket(m, L(-18, -17) * yaw(0.3))
	end
	flowerPatch(m, L(-26, -27).Position, 2.6, 9, i % 2 == 0 and "bluebonnet" or "mix")
	flowerPatch(m, L(25, -27).Position, 2.4, 8, "mix")
	hayBale(m, L(26, -17).Position - V(0, 0, 0), 0.4 + i)
	grassClump(m, L(29, -9).Position)
	grassClump(m, L(-29, -4).Position)
end
WorldBuilder.plotDecor = plotDecor

-- ---------- the big picture ----------
local function buildScenery(map, cfg, content)
	local scenery = model(map, "Scenery")
	local plots = map:FindFirstChild("Plots")
	for i = 1, cfg.MAX_PLOTS do
		local plot = plots and plots:FindFirstChild("Plot" .. i)
		if plot then
			local angle = (i - 1) / cfg.MAX_PLOTS * math.pi * 2
			local center = V(math.cos(angle) * WorldBuilder.PLOT_RADIUS, 0, math.sin(angle) * WorldBuilder.PLOT_RADIUS)
			plotDecor(plot, lookAt(center, V(0, 0, 0)), i)
		end
	end

	-- Horizon: a wide outer field, berms that hide the ground edge, a tree line beyond them
	-- and a mesa skyline. Persistent so the skyline never pops when streaming.
	local horizon = model(scenery, "Horizon")
	streaming(horizon, "Persistent")
	part(horizon, "OuterField", V(2600, 1, 2600), E.CFrame.new(0, -0.8, 0), PAL.grassFar, E.Enum.Material.Grass, { CastShadow = false })
	for side = 0, 3 do
		local rot = side * math.pi / 2
		local frame = yaw(rot)
		local t = -500
		while t <= 500 do
			local d = rr(105, 150)
			local p = frame * E.CFrame.new(t, -d * 0.33, -(455 + rr(0, 25)))
			part(horizon, "Berm", V(d, d, d), p, pick(PAL.berm), E.Enum.Material.Grass, { Shape = E.Enum.PartType.Ball, CastShadow = false })
			t += rr(50, 62)
		end
		-- tree line just past the berms
		t = -560
		while t <= 560 do
			local p = (frame * E.CFrame.new(t, 0, -(540 + rr(0, 70)))).Position
			if rnd() < 0.62 then
				liveOak(horizon, p, rr(1.7, 2.5), { far = true })
			else
				mesquite(horizon, p, rr(2.2, 3))
			end
			t += rr(36, 50)
		end
	end
	local mesas = { { 20, 1050 }, { 62, 1180 }, { 105, 980 }, { 150, 1120 }, { 196, 1040 }, { 238, 1200 }, { 300, 1000 }, { 335, 1150 } }
	for _, ms in ipairs(mesas) do
		mesa(horizon, polar(ms[1], ms[2]), rr(240, 360), rr(55, 90), rr(120, 170), math.rad(-ms[1] + 90))
	end

	-- Landmarks inside the map: ROCH water tower and a windmill, both visible from the hub.
	local landmarks = model(scenery, "Landmarks")
	streaming(landmarks, "Persistent")
	waterTower(landmarks, polar(122, 318), "ROCH")
	windmill(landmarks, polar(58, 300), math.rad(-30))

	-- Ranch fences around the property line (inside the berms)
	local fences = model(scenery, "PropertyFence")
	streaming(fences, "Atomic")
	local F = 405
	railFence(fences, V(-F, 0, F), V(F, 0, F), 30)
	railFence(fences, V(F, 0, -F), V(F, 0, F), 30)
	railFence(fences, V(-F, 0, -F), V(-F, 0, F), 30)
	railFence(fences, V(-F, 0, -F), V(-60, 0, -F), 30)
	railFence(fences, V(60, 0, -F), V(F, 0, -F), 30)

	-- Mid-ground trees between the plot ring and the edge
	local grove = model(scenery, "Grove")
	for k = 0, 17 do
		local a = k / 18 * 360 + 10
		if not (a > 250 and a < 290) then
			local p = polar(a, rr(262, 300))
			if k % 3 == 0 then
				mesquite(grove, p, rr(1.2, 1.6))
			else
				liveOak(grove, p, rr(1.1, 1.5))
			end
		end
	end
	for k = 0, 23 do
		local a = k / 24 * 360 + 7
		if not (a > 255 and a < 285) then
			local p = polar(a, rr(200, 340))
			flowerPatch(grove, p, rr(3, 6), 10, pick({ "bluebonnet", "bluebonnet", "mix", "susan" }))
			grassClump(grove, p + V(rr(-8, 8), 0, rr(-8, 8)), 1.3)
		end
	end

	-- Meadow: flat color patches (1 part each) break up the big lawn; some are bluebonnet
	-- carpets with a few flowers on top.
	local meadow = model(scenery, "Meadow")
	for k = 0, 39 do
		local a = rr(0, 360)
		local p = polar(a, rr(195, 430))
		local inCreek = p.Z < -215 and p.Z > -300 and math.abs(p.X) < 115
		if not inCreek and math.abs(p.X) < 440 and math.abs(p.Z) < 440 then
			if k % 4 == 0 then
				local d = rr(8, 14)
				dcyl(meadow, "BonnetCarpet", 0.1, d, at(p + V(0, 0.06, 0)) * upright(), "#5C7FE0", E.Enum.Material.Grass, false)
				flowerPatch(meadow, p, d * 0.4, 6, "bluebonnet")
			else
				dcyl(meadow, "MeadowPatch", 0.1, rr(18, 40), at(p + V(0, 0.05, 0)) * upright(), pick({ "#6DB843", "#8CCB55", "#A8C960", "#6DB843" }), E.Enum.Material.Grass, false)
				if k % 3 == 0 then
					grassClump(meadow, p + V(rr(-5, 5), 0, rr(-5, 5)), 1.4)
				end
			end
		end
	end

	-- Neighborhood: house backs with privacy fences beyond the tree ring, plus little scenes
	-- in the gaps between ranches.
	local hood = model(scenery, "Neighborhood")
	streaming(hood, "Atomic")
	local nPlots = cfg.MAX_PLOTS
	local function sceneAngle(legacy: number): number
		return WorldBuilder.nearestGap(nPlots, legacy)
	end
	local function nearAngle(a: number, b: number): boolean
		return math.abs((a - b + 180) % 360 - 180) < 0.05
	end
	local walls = { "#F2E6CF", "#D7E8F0", "#F6D7C3", "#E3EED2" }
	local houseAngles = { sceneAngle(22.5), sceneAngle(112.5), sceneAngle(202.5), sceneAngle(337.5) }
	for k, a in ipairs(houseAngles) do
		local pos = polar(a, 290)
		houseBack(hood, lookAt(pos, V(0, 0, 0)), walls[k], k % 2 == 0 and "#2F7BD8" or PAL.barnRed)
	end
	local function gap(a, r)
		local pos = polar(a, r)
		return lookAt(pos, V(0, 0, 0))
	end
	-- tailgate party, in the gap that used to be 67.5 degrees
	do
		local g = model(hood, "Tailgate")
		local cf = gap(sceneAngle(67.5), 176)
		pickupTruck(g, cf * yaw(math.rad(100)), "#C8433A")
		lawnChair(g, cf * E.CFrame.new(-6, 0, -6) * yaw(0.5), "#1E9E4A")
		lawnChair(g, cf * E.CFrame.new(-2, 0, -8) * yaw(-0.2), "#E8590C")
		cooler(g, cf * E.CFrame.new(-4, 0, -4.5), "#2F7BD8")
		cornhole(g, cf * E.CFrame.new(6, 0, -12), "#2F7BD8")
		cornhole(g, cf * E.CFrame.new(6, 0, 2) * yaw(math.pi), "#D93636")
	end
	-- the big oak with a tire swing and a picnic, in the gap that used to be 112.5 degrees
	do
		local g = model(hood, "TireSwingOak")
		local cf = gap(sceneAngle(112.5), 182)
		local oak = liveOak(g, cf.Position, 1.7, { shadow = true })
		leaves(oak:FindFirstChild("Canopy"))
		local branch = cf * E.CFrame.new(7, 0, 0)
		deco(g, "Rope", V(0.2, 7.5, 0.2), branch * E.CFrame.new(0, 9.6, 0), "#D9C4A8", E.Enum.Material.Fabric, false)
		dcyl(g, "Tire", 1.1, 3.6, branch * E.CFrame.new(0, 5, 0) * yaw(math.pi / 2), "#1C1A1F", E.Enum.Material.SmoothPlastic, false)
		picnicBlanket(g, cf * E.CFrame.new(-6, 0, -8) * yaw(-0.3))
	end
	-- haybales & wildflowers in the other gaps. The two that flank the north creek
	-- stay a single layer of hay so the walk out back stays open.
	local northA, northB = sceneAngle(247.5), sceneAngle(292.5)
	local firstPasture = sceneAngle(22.5)
	for _, legacy in ipairs({ 22.5, 157.5, 202.5, 247.5, 292.5, 337.5 }) do
		local a = sceneAngle(legacy)
		local g = model(hood, "Pasture")
		local cf = gap(a, 170)
		hayBale(g, (cf * E.CFrame.new(-4, 0, 3)).Position, a)
		hayBale(g, (cf * E.CFrame.new(1, 0, 6)).Position, a + 1)
		if not nearAngle(a, northA) and not nearAngle(a, northB) then
			hayBale(g, (cf * E.CFrame.new(-1.5, 4.4, 4.5)).Position, a + 2)
		end
		flowerPatch(g, (cf * E.CFrame.new(6, 0, -4)).Position, 4, 12, nearAngle(a, firstPasture) and "bluebonnet" or "mix")
		grassClump(g, (cf * E.CFrame.new(-8, 0, -6)).Position, 1.2)
		grassClump(g, (cf * E.CFrame.new(9, 0, 8)).Position, 1.1)
	end
	do -- backyard kiddie pool + lawn chairs by the house that used to sit at 337.5
		local cf = lookAt(polar(sceneAngle(337.5), 290), V(0, 0, 0))
		kiddiePool(hood, cf * E.CFrame.new(-10, 0, -12))
		lawnChair(hood, cf * E.CFrame.new(-2, 0, -12) * yaw(1.2), "#FFC83C")
		local cf2 = lookAt(polar(sceneAngle(112.5), 290), V(0, 0, 0))
		cooler(hood, cf2 * E.CFrame.new(8, 0, -10), "#1E9E4A")
		lawnChair(hood, cf2 * E.CFrame.new(4, 0, -12) * yaw(0.4), "#2F7BD8")
	end

	-- Hub dressing: string lights between the lamp posts, hay-bale seats by the stage,
	-- smoke wisps from the pits, fireflies at dusk.
	local hubDecor = model(scenery, "HubDecor")
	for li = 0, 7 do
		local a0 = li / 8 * math.pi * 2 + math.pi / 8
		local a1 = (li + 1) / 8 * math.pi * 2 + math.pi / 8
		local p0 = V(math.cos(a0) * 52, 10.1, math.sin(a0) * 52)
		local p1 = V(math.cos(a1) * 52, 10.1, math.sin(a1) * 52)
		stringLights(hubDecor, p0, p1, 7, 1.6)
	end
	for _, o in ipairs({ { -24, 30 }, { -28, 36 }, { 32, 27 } }) do
		hayBale(hubDecor, V(o[1], 0.4, o[2]), o[1] * 0.1)
	end
	local hubMap = map:FindFirstChild("Hub")
	if hubMap then
		local ks = hubMap:FindFirstChild("KingSmoker")
		local ch = ks and ks:FindFirstChild("Chimney")
		if ch then
			smokeWisp(ch)
		end
		local ug = hubMap:FindFirstChild("UncGrill")
		if ug then
			smokeWisp(ug)
		end
	end
	fireflies(hubDecor, E.CFrame.new(0, 5, 0), V(100, 8, 100))
	fireflies(hubDecor, E.CFrame.new(0, 4, -262), V(160, 6, 30))
	fireflies(hubDecor, E.CFrame.new(0, 5, 230), V(200, 8, 60))
	-- The landmark itself lives in the hub so it's on the spawn sightline.
	WorldBuilder.bertha(hubDecor, E.CFrame.new(0, 0.4, 14), content)

	-- Creek dressing: a footbridge, cattails, more rocks, lily pads.
	local creekDecor = model(scenery, "CreekDecor")
	streaming(creekDecor, "Atomic")
	local z = -260
	local bx = 42
	part(creekDecor, "BridgeDeck", V(9, 0.6, 26), E.CFrame.new(bx, 1.2, z), PAL.wood, E.Enum.Material.WoodPlanks)
	part(creekDecor, "BridgeRampN", V(9, 0.6, 6), E.CFrame.new(bx, 0.6, z + 15.5) * E.CFrame.Angles(math.rad(-10), 0, 0), PAL.wood, E.Enum.Material.WoodPlanks)
	part(creekDecor, "BridgeRampS", V(9, 0.6, 6), E.CFrame.new(bx, 0.6, z - 15.5) * E.CFrame.Angles(math.rad(10), 0, 0), PAL.wood, E.Enum.Material.WoodPlanks)
	for _, sx in ipairs({ -4.3, 4.3 }) do
		deco(creekDecor, "Rail", V(0.4, 0.4, 26), E.CFrame.new(bx + sx, 4.2, z), "#8B5A2B", E.Enum.Material.Wood, false)
		for _, pz in ipairs({ -12, 0, 12 }) do
			deco(creekDecor, "RailPost", V(0.5, 3, 0.5), E.CFrame.new(bx + sx, 2.8, z + pz), "#8B5A2B", E.Enum.Material.Wood, false)
		end
	end
	for k = 1, 16 do
		local x = -90 + k * 11 + rr(-3, 3)
		local zz = z + ((k % 2 == 0) and 9.8 or -9.8) + rr(-0.6, 0.6)
		if math.abs(x - bx) > 7 then
			deco(creekDecor, "CattailStem", V(0.2, 4.2, 0.2), E.CFrame.new(x, 2.1, zz) * E.CFrame.Angles(rr(-0.15, 0.15), 0, rr(-0.15, 0.15)), "#6E8F3A", E.Enum.Material.Grass, false)
			deco(creekDecor, "Cattail", V(0.5, 1.3, 0.5), E.CFrame.new(x, 3.9, zz), "#6B4226", E.Enum.Material.Fabric, false)
			deco(creekDecor, "CattailLeaf", V(0.15, 3.2, 0.5), E.CFrame.new(x + 0.4, 1.6, zz) * E.CFrame.Angles(0, 0.6, 0.3), "#7FA650", E.Enum.Material.Grass, false)
		end
	end
	for k = 1, 8 do
		dball(creekDecor, "Rock", rr(1.8, 3.6), E.CFrame.new(-95 + k * 23, 0.3, z + rr(-8, 8)), pick({ "#8C8C8C", "#9C9284", "#7F8C8D" }), E.Enum.Material.Slate, false)
	end
	for k = 1, 5 do
		dcyl(creekDecor, "LilyPad", 0.1, rr(1.6, 2.4), E.CFrame.new(-60 + k * 22, 0.45, z + rr(-5, 5)) * upright(), "#4FA346", E.Enum.Material.Grass, false)
	end
	mesquite(creekDecor, V(-62, 0, z - 16), 1.3)
	liveOak(creekDecor, V(70, 0, z - 18), 1.3)

	-- Ambient critters (moved around by the Ambient client script; purely cosmetic).
	local critters = folder(scenery, "Critters")
	local spots = {
		-- Just outside ranch 2, on its outward axis. 45 degrees was that axis when there were 8 ranches.
		{ "armadillo", polar((2 - 1) / cfg.MAX_PLOTS * 360, 186), 16, 3 },
		{ "roadrunner", polar(200, 192), 24, 9 },
		{ "hornedtoad", V(30, 0, -244), 10, 2 },
		{ "jimothy", polar(150, 200), 14, 3 },
		{ "armadillo", polar(318, 195), 14, 3 },
	}
	local defs = {}
	for _, d in ipairs(cfg.Critters or {}) do
		defs[d.id] = d
	end
	for _, sp in ipairs(spots) do
		local def = defs[sp[1]]
		if def then
			local cm = WorldBuilder.critter(E, critters, def, E.CFrame.new(sp[2] + V(0, 0.9 * (def.scale or 1), 0)))
			for _, d in ipairs(cm:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.CastShadow = false
				elseif d:IsA("ProximityPrompt") or d:IsA("BillboardGui") then
					d:Destroy()
				end
			end
			cm.Name = "Wild_" .. def.id
			cm:SetAttribute("Range", sp[3])
			cm:SetAttribute("Speed", sp[4])
		end
	end

	-- Clouds (Terrain child) when building inside a real place.
	pcall(function()
		local terrain = map.Parent and map.Parent:FindFirstChildOfClass("Terrain")
		if terrain and not terrain:FindFirstChildOfClass("Clouds") then
			local clouds = E.Instance.new("Clouds")
			clouds.Cover = 0.55
			clouds.Density = 0.55
			clouds.Color = hex("#FFF6EC")
			clouds.Parent = terrain
		end
	end)
	return scenery
end
WorldBuilder.buildScenery = buildScenery

-- Build everything under `parent` (Workspace). Returns the Map model.
local function jimothyDef(cfg, scale, waiter)
	for _, d in ipairs(cfg.Critters or {}) do
		if d.id == "jimothy" then
			local copy = table.clone(d)
			copy.scale = scale or d.scale or 1
			copy.waiter = waiter == true
			return copy
		end
	end
	return nil
end

-- Mascot dressing: a scurrying hub Jimothy, a poster, a statue, and 10 hidden sightings.
-- None of these sit on the spawn-to-leaderboard sight line, and the only billboard is the
-- wanderer's short-range speech bubble (west of that line).
local function buildJimothy(map, cfg)
	local hub = map:FindFirstChild("Hub")
	local base = jimothyDef(cfg, 1, false)
	if not hub or not base then
		return
	end
	local function sized(scale)
		local d = jimothyDef(cfg, scale, false)
		return d
	end

	-- West-plaza loop, inside the square and off the roads and the leaderboard view.
	local feet = {
		V(-28, 0.45, -18),
		V(-42, 0.45, -4),
		V(-40, 0.45, 16),
		V(-22, 0.45, 22),
		V(-24, 0.45, 6),
		V(-30, 0.45, -8),
	}
	local wander = placeJimothy(hub, "JimothyWander", E.CFrame.new(feet[1]), sized(1.05), { line = "Praise Jimothy!!" })
	local bodyPart = wander:FindFirstChild("Body")
	local lift = (bodyPart and bodyPart.CFrame.Position.Y or feet[1].Y) - feet[1].Y
	local path = folder(hub, "JimothyPath")
	for i, f in ipairs(feet) do
		part(path, "P" .. i, V(0.3, 0.3, 0.3), E.CFrame.new(f.X, f.Y + lift, f.Z), "#FF00FF", nil, {
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		})
	end

	-- Poster on the west side of the square, facing in. SurfaceGui only, so it isn't a
	-- floating label over the Cook-Off board.
	local posterCf = lookAt(V(-42, 3.5, -20), V(-12, 3.2, -6))
	local poster = model(hub, "PraiseJimothy")
	part(poster, "Post", V(0.45, 4.2, 0.45), posterCf * E.CFrame.new(0, -2.3, 0.2), "#6B4226", E.Enum.Material.Wood)
	local board = part(poster, "Board", V(6.4, 3.6, 0.28), posterCf, "#F6E2C4", E.Enum.Material.Wood)
	surfaceText(board, E.Enum.NormalId.Front, "PRAISE\nJIMOTHY!!", "#5A2E1E", nil)
	surfaceText(board, E.Enum.NormalId.Back, "PRAISE\nJIMOTHY!!", "#5A2E1E", nil)

	-- Town-square statue, west of the Cook-Off stage and clear of the center sight line.
	local st = E.CFrame.new(-22, 0.45, 20)
	cyl(hub, "JimothyPedestal", 1.55, 3.6, st * E.CFrame.new(0, 0.78, 0) * upright(), "#C9C2B8", E.Enum.Material.Slate)
	cyl(hub, "JimothyPedestalCap", 0.28, 4.3, st * E.CFrame.new(0, 1.66, 0) * upright(), "#E6E0D6", E.Enum.Material.Slate)
	local plaque = part(hub, "JimothyPlaque", V(3.4, 0.7, 0.16), st * E.CFrame.new(0, 0.7, -2.15), "#C9A04A", E.Enum.Material.Metal)
	surfaceText(plaque, E.Enum.NormalId.Front, "PRAISE JIMOTHY", "#3A2414", nil)
	placeJimothy(hub, "JimothyStatue", E.CFrame.new(-22, 2.25, 20), sized(1.45))

	local sightings = folder(hub, "JimothySightings")
	local shack = hub:FindFirstChild("SauceShack")
	local back = shack and shack:FindFirstChild("Back")
	local roof = shack and shack:FindFirstChild("Roof")
	if back and back:IsA("BasePart") then
		local behind = back.CFrame * E.CFrame.new(2.6, -back.Size.Y / 2, back.Size.Z / 2 + 1.7) * E.CFrame.Angles(0, math.pi, 0)
		placeJimothy(sightings, "Sighting_shack", behind, sized(0.62), { sighting = "shack" })
	end
	if roof and roof:IsA("BasePart") then
		local onRoof = roof.CFrame * E.CFrame.new(4.8, roof.Size.Y / 2, 2.2)
		placeJimothy(sightings, "Sighting_roof", onRoof, sized(0.5), { sighting = "roof", dist = 12 })
	end

	-- Trash can, lid ajar, southeast edge of the square (between the roads).
	local canCf = E.CFrame.new(48, 0.45, -24)
	local can = model(sightings, "TrashCan")
	cyl(can, "Can", 2.3, 2.15, canCf * E.CFrame.new(0, 1.15, 0) * upright(), "#3E4A3A", E.Enum.Material.Metal)
	cyl(can, "Lid", 0.16, 2.35, canCf * E.CFrame.new(0.15, 2.45, -0.15) * E.CFrame.Angles(math.rad(62), 0.4, 0), "#2C3328", E.Enum.Material.Metal)
	local canSign = part(can, "Sign", V(1.7, 0.45, 0.08), canCf * E.CFrame.new(0, 1.35, -1.12), "#F4E1C1", E.Enum.Material.Wood)
	surfaceText(canSign, E.Enum.NormalId.Front, "KING OF THE TRASH", "#3A2414", nil)
	placeJimothy(can, "Sighting_trash", canCf * E.CFrame.new(0, 1.15, 0), sized(0.4), { sighting = "trash", object = "King of the trash", dist = 9 })

	local stage = hub:FindFirstChild("CookOff")
	local lb = stage and stage:FindFirstChild("Leaderboard")
	if lb and lb:IsA("BasePart") then
		local beside = lb.CFrame * E.CFrame.new(lb.Size.X / 2 + 1.5, -lb.Size.Y / 2 - 0.85, lb.Size.Z / 2 + 1.4)
		placeJimothy(sightings, "Sighting_board", beside, sized(0.55), { sighting = "board" })
	end

	local arch = hub:FindFirstChild("WelcomeArch")
	local post = arch and arch:FindFirstChild("PostL")
	if post and post:IsA("BasePart") then
		local hide = post.CFrame * E.CFrame.new(-1.35, 0.5 - post.CFrame.Position.Y, -1.15)
		placeJimothy(sightings, "Sighting_spawn", hide, sized(0.46), { sighting = "spawn" })
	end

	-- Hay bales in the hub sit near (-28, 36). Tuck him on the far side.
	placeJimothy(sightings, "Sighting_hay", E.CFrame.new(-31.5, 0.5, 39), sized(0.52), { sighting = "hay" })

	local scenery = map:FindFirstChild("Scenery")
	local decor = scenery and scenery:FindFirstChild("HubDecor")
	local bertha = decor and decor:FindFirstChild("BigBertha")
	if bertha then
		placeJimothy(bertha, "Sighting_bertha", E.CFrame.new(5.5, 0.55, 22.5), sized(0.48), { sighting = "bertha" })
	end

	-- Outside the pads: angular midpoint of plot 1 and plot 2, past the outward edge.
	local gapPos = polar(WorldBuilder.nearestGap(cfg.MAX_PLOTS, 22.5), 188)
	local gapParent = scenery or map
	placeJimothy(gapParent, "Sighting_plots", E.CFrame.new(gapPos + V(0, 0.55, 0)), sized(0.58), { sighting = "plots" })

	local creek = map:FindFirstChild("Creek")
	placeJimothy(creek or map, "Sighting_creek", E.CFrame.new(-72, 0.55, -270), sized(0.5), { sighting = "creek" })

	local oakPos = polar(WorldBuilder.nearestGap(cfg.MAX_PLOTS, 112.5), 182)
	local oakParent = scenery or map
	placeJimothy(oakParent, "Sighting_oak", E.CFrame.new(oakPos + oakPos.Unit * 7 + V(0, 0.55, 0)), sized(0.55), { sighting = "oak" })
end

-- Brighter than a realistic dusk: grass reads, signs read, trait glow has something to sit on.
function WorldBuilder.lighting(lighting, storm: boolean?)
	lighting.Brightness = if storm then 2.1 else 2.7
	lighting.Ambient = Color3.fromRGB(186, 174, 156)
	lighting.OutdoorAmbient = Color3.fromRGB(176, 166, 148)
	lighting.EnvironmentDiffuseScale = 0.55
	lighting.EnvironmentSpecularScale = 0.35
	local function ensure(className: string, name: string)
		local inst = lighting:FindFirstChild(name)
		if not inst then
			inst = Instance.new(className)
			inst.Name = name
			inst.Parent = lighting
		end
		return inst
	end
	local air = ensure("Atmosphere", "RanchAir")
	air.Density = if storm then 0.45 else 0.26
	air.Offset = 0.12
	air.Color = if storm then Color3.fromRGB(255, 176, 96) else Color3.fromRGB(255, 226, 190)
	air.Decay = Color3.fromRGB(190, 150, 110)
	air.Glare = 0.12
	air.Haze = if storm then 1.4 else 0.35
	local grade = ensure("ColorCorrectionEffect", "RanchGrade")
	grade.Saturation = 0.05
	grade.Contrast = 0.05
	grade.Brightness = 0.03
	grade.TintColor = if storm then Color3.fromRGB(255, 214, 180) else Color3.fromRGB(255, 246, 232)
	local bloom = ensure("BloomEffect", "RanchBloom")
	bloom.Intensity = if storm then 0.55 else 0.35
	bloom.Size = 16
	bloom.Threshold = 1.05
end

function WorldBuilder.build(env, parent, cfg, content)
	E = env
	local map = model(parent, "Map")
	part(map, "Ground", V(900, 2, 900), E.CFrame.new(0, -1, 0), "#79C84F", E.Enum.Material.Grass)
	local plots = folder(map, "Plots")
	for i = 1, cfg.MAX_PLOTS do
		buildPlot(plots, i, cfg)
	end
	buildHub(map, cfg, content)
	buildCreek(map, content)
	-- scatter trees around the edge
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local r = 215 + (i % 3) * 12
		if not (a > math.rad(255) and a < math.rad(285)) then
			tree(map, V(math.cos(a) * r, 0, math.sin(a) * r), 1 + (i % 2) * 0.3)
		end
	end
	buildScenery(map, cfg, content)
	buildJimothy(map, cfg)
	return map
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="60">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="61">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">Boot</string>
          <string name="Source"><![CDATA[--!strict
-- Starts services so one failure cannot stop player loading.
-- Game.start is intentionally early: it is what connects Data.load and the action remote.
-- Later start() methods (chat, analytics, purchases, the map's heartbeat) are allowed to throw.
local Boot = {}

function Boot.step(label: string, fn: () -> ())
	-- Return a value so xpcall's type has a success flag and an error to unpack.
	local ok, err = xpcall(function(): string?
		fn()
		return nil
	end, debug.traceback)
	if not ok then
		warn("[Boot] " .. label .. " failed:\n" .. tostring(err))
	end
end

function Boot.run(ctx: any, initOrder: { string }, earlyStart: { string }, startOrder: { string })
	for _, name in ipairs(initOrder) do
		local svc = ctx[name]
		if type(svc) == "table" and type(svc.init) == "function" then
			Boot.step(name .. ".init", function()
				svc.init(ctx)
			end)
		end
	end
	local data = ctx.Data
	if type(data) == "table" and type(data.start) == "function" then
		Boot.step("Data.start", function()
			data.start()
		end)
	end
	local function startNamed(name: string)
		local svc = ctx[name]
		if type(svc) == "table" and type(svc.start) == "function" then
			Boot.step(name .. ".start", function()
				svc.start()
			end)
		end
	end
	for _, name in ipairs(earlyStart) do
		startNamed(name)
	end
	for _, name in ipairs(startOrder) do
		startNamed(name)
	end
end

return Boot
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="63">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point: builds remotes, wires every service together, starts them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Services = script.Parent:WaitForChild("Services")
local Boot = require(script.Parent:WaitForChild("Boot"))

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local action = Instance.new("RemoteFunction")
action.Name = "Action"
action.Parent = remotes
local push = Instance.new("RemoteEvent")
push.Name = "Push"
push.Parent = remotes
remotes.Parent = ReplicatedStorage

Players.CharacterAutoLoads = true

local ctx = {
	Data = require(Services.DataService),
	World = require(Services.WorldService),
	Game = require(Services.GameService),
	Social = require(Services.SocialService),
	Event = require(Services.EventService),
	Egg = require(Services.EggService),
	Cosmetics = require(Services.CosmeticService),
	Purchase = require(Services.PurchaseService),
	Season = require(Services.SeasonService),
	Membership = require(Services.MembershipService),
	Insights = require(Services.InsightsService),
	Crew = require(Services.CrewService),
	Weather = require(Services.WeatherService),
	Remotes = { Action = action, Push = push },
}

-- World first: it builds the map if it wasn't baked into the place file.
-- Every init runs before any start, so actions are registered and the map exists
-- before Game.start connects PlayerAdded. Game.start is first among starts:
-- a throw in chat, analytics, or a shop API must not leave joins unwired.
local initOrder = { "World", "Game", "Social", "Event", "Egg", "Cosmetics", "Purchase", "Season", "Membership", "Insights", "Crew", "Weather" }
local startOrder = { "World", "Crew", "Weather", "Social", "Event", "Egg", "Cosmetics", "Purchase", "Season", "Membership", "Insights" }
Boot.run(ctx, initOrder, { "Game" }, startOrder)
print("[Backyard Smokeout] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="64">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[--!strict
-- CosmeticService — puts hats, aprons, tools, bandanas, socks & sandals, trails and title tags on
-- characters. Everything is built from Parts (no uploaded meshes) and welded to the character.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)

local CosmeticService = {}
local ctx: any = nil

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

local function weldPart(parent: Instance, attachTo: BasePart, name: string, size: Vector3, offset: CFrame, color: string, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = hex(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CFrame = attachTo.CFrame * offset
	p.Parent = parent
	local w = Instance.new("WeldConstraint")
	w.Part0 = attachTo
	w.Part1 = p
	w.Parent = p
	return p
end

local function find(char: Model, ...: string): BasePart?
	for _, n in ipairs({ ... }) do
		local p = char:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return nil
end

local function buildHat(folder: Folder, head: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local top = head.Size.Y / 2
	if id == "hat_turkey" then
		weldPart(folder, head, "HatBody", Vector3.new(1.4, 0.9, 1.6), CFrame.new(0, top + 0.4, 0), def.color)
		weldPart(folder, head, "HatHead", Vector3.new(0.5, 0.6, 0.5), CFrame.new(0, top + 0.9, -0.7), "#C0392B")
		for k = -2, 2 do
			weldPart(folder, head, "Feather", Vector3.new(0.35, 1.2, 0.15), CFrame.new(k * 0.3, top + 1, 0.7) * CFrame.Angles(0, 0, math.rad(k * 14)), k % 2 == 0 and "#E67E22" or "#8B4513")
		end
		return
	end
	local brim = weldPart(folder, head, "HatBrim", Vector3.new(0.15, 2.6, 2.6), CFrame.new(0, top + 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2), def.color)
	brim.Shape = Enum.PartType.Cylinder
	weldPart(folder, head, "HatCrown", Vector3.new(1.3, 0.8, 1.4), CFrame.new(0, top + 0.55, 0), def.color)
	weldPart(folder, head, "HatBand", Vector3.new(1.32, 0.18, 1.42), CFrame.new(0, top + 0.25, 0), id == "hat_pitmaster" and "#C9A227" or "#7B3F00")
	if def.twinkle then
		-- a ring of little glowing bulbs around the band (Twinkle Lights Cowboy Hat)
		local BULBS = { "#FF3B3B", "#FFD54A", "#3BD16F", "#4FA3FF" }
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			local bulb = weldPart(folder, head, "Bulb", Vector3.new(0.2, 0.2, 0.2), CFrame.new(math.cos(a) * 0.72, top + 0.27, math.sin(a) * 0.76), BULBS[k % #BULBS + 1], Enum.Material.Neon)
			bulb.Shape = Enum.PartType.Ball
		end
	end
end

local function buildApron(folder: Folder, torso: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local front = -torso.Size.Z / 2 - 0.06
	local apron = weldPart(folder, torso, "Apron", Vector3.new(torso.Size.X * 0.8, torso.Size.Y * 1.05, 0.1), CFrame.new(0, -0.15, front), def.color, Enum.Material.Fabric)
	if def.text then
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.PixelsPerStud = 60
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.LightInfluence = 0.6
		sg.Parent = apron
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(0.9, 0.5)
		tl.Position = UDim2.fromScale(0.05, 0.15)
		tl.BackgroundTransparency = 1
		tl.TextScaled = true
		tl.Font = Enum.Font.FredokaOne
		tl.TextColor3 = Color3.new(1, 1, 1)
		tl.Text = def.text
		tl.Parent = sg
	end
	weldPart(folder, torso, "ApronPocket", Vector3.new(0.8, 0.4, 0.05), CFrame.new(0, -0.6, front - 0.06), "#FFFFFF", Enum.Material.Fabric).Transparency = 0.6
end

local function buildTool(folder: Folder, hand: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local mat = def.neon and Enum.Material.Neon or Enum.Material.Foil
	local handle = weldPart(folder, hand, "ToolHandle", Vector3.new(0.2, 0.2, 1.4), CFrame.new(0, -hand.Size.Y / 2 - 0.1, -0.6), def.color, mat)
	if id == "tool_goldtongs" then
		weldPart(folder, hand, "TongA", Vector3.new(0.12, 0.12, 1.2), CFrame.new(-0.12, -hand.Size.Y / 2 - 0.1, -1.6) * CFrame.Angles(0, math.rad(6), 0), def.color, mat)
		weldPart(folder, hand, "TongB", Vector3.new(0.12, 0.12, 1.2), CFrame.new(0.12, -hand.Size.Y / 2 - 0.1, -1.6) * CFrame.Angles(0, math.rad(-6), 0), def.color, mat)
	else
		weldPart(folder, hand, "SpatulaHead", Vector3.new(0.8, 0.06, 0.9), CFrame.new(0, -hand.Size.Y / 2 - 0.1, -1.7), def.color, mat)
	end
	local sp = Instance.new("Sparkles")
	sp.SparkleColor = hex(def.color)
	sp.Parent = handle
end

local function buildNeck(folder: Folder, torso: BasePart, id: string)
	local def = Config.Cosmetics[id]
	weldPart(folder, torso, "Bandana", Vector3.new(torso.Size.X * 0.7, 0.35, torso.Size.Z + 0.2), CFrame.new(0, torso.Size.Y / 2 - 0.1, 0), def.color, Enum.Material.Fabric)
	local tri = Instance.new("WedgePart")
	tri.Name = "BandanaTip"
	tri.Size = Vector3.new(0.1, 0.6, 0.6)
	tri.Color = hex(def.color)
	tri.Material = Enum.Material.Fabric
	tri.CanCollide = false
	tri.Massless = true
	tri.CFrame = torso.CFrame * CFrame.new(0, torso.Size.Y / 2 - 0.5, -torso.Size.Z / 2 - 0.1) * CFrame.Angles(0, math.pi / 2, math.pi)
	tri.Parent = folder
	local w = Instance.new("WeldConstraint")
	w.Part0 = torso
	w.Part1 = tri
	w.Parent = tri
end

local function buildFeet(folder: Folder, char: Model)
	for _, side in ipairs({ "Left", "Right" }) do
		local foot = find(char, side .. "Foot", side .. " Leg")
		if foot then
			local bottom = -foot.Size.Y / 2
			weldPart(folder, foot, side .. "Sock", Vector3.new(foot.Size.X + 0.06, 0.5, foot.Size.Z + 0.06), CFrame.new(0, bottom + 0.4, 0), "#FFFFFF", Enum.Material.Fabric)
			weldPart(folder, foot, side .. "Sandal", Vector3.new(foot.Size.X + 0.15, 0.12, foot.Size.Z + 0.3), CFrame.new(0, bottom + 0.02, -0.05), "#6B4226", Enum.Material.Leather)
			weldPart(folder, foot, side .. "Strap", Vector3.new(foot.Size.X + 0.12, 0.1, 0.2), CFrame.new(0, bottom + 0.25, -0.2), "#3B2A1A", Enum.Material.Leather)
		end
	end
end

local function buildTrail(folder: Folder, hrp: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA"
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailB"
	a1.Position = Vector3.new(0, -1.2, 0)
	a1.Parent = hrp
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.7
	tr.LightEmission = id == "trail_sauce" and 0 or 0.6
	tr.Color = ColorSequence.new(hex(def.color), def.color2 and hex(def.color2) or (id == "trail_firework" and hex("#FFD700") or hex(def.color)))
	tr.Transparency = NumberSequence.new(0.1, 1)
	tr.WidthScale = NumberSequence.new(1, 0.2)
	tr.Parent = folder
	-- attachments live on the HRP, tag them so we can clean up
	a0:SetAttribute("BSCosmetic", true)
	a1:SetAttribute("BSCosmetic", true)
end

local function buddyBall(folder: Folder, torso: BasePart, name: string, size: Vector3, offset: CFrame, color: string): Part
	local p = weldPart(folder, torso, name, size, offset, color)
	p.Shape = Enum.PartType.Ball
	return p
end

-- A tiny round Jimothy riding on the back. Free, from the sighting hunt. Never sold.
local function buildBuddy(folder: Folder, torso: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local back = torso.Size.Z / 2 + 0.2
	buddyBall(folder, torso, "BuddyBody", Vector3.new(1.15, 1.05, 1.1), CFrame.new(0.05, 0.1, back), def.color)
	buddyBall(folder, torso, "BuddyHead", Vector3.new(0.82, 0.68, 0.74), CFrame.new(0.05, 0.58, back + 0.02), "#C9BBA8")
	buddyBall(folder, torso, "BuddyMask", Vector3.new(0.7, 0.22, 0.18), CFrame.new(0.05, 0.62, back + 0.32), "#1A120E")
	buddyBall(folder, torso, "BuddyMuzzle", Vector3.new(0.32, 0.2, 0.2), CFrame.new(0.05, 0.46, back + 0.36), "#F4EDE4")
	buddyBall(folder, torso, "BuddyNose", Vector3.new(0.12, 0.1, 0.1), CFrame.new(0.05, 0.48, back + 0.46), "#2A1C16")
	buddyBall(folder, torso, "BuddyEyeL", Vector3.new(0.16, 0.16, 0.16), CFrame.new(-0.12, 0.66, back + 0.28), "#FFFFFF")
	buddyBall(folder, torso, "BuddyEyeR", Vector3.new(0.16, 0.16, 0.16), CFrame.new(0.22, 0.66, back + 0.28), "#FFFFFF")
	buddyBall(folder, torso, "BuddyPupilL", Vector3.new(0.08, 0.08, 0.08), CFrame.new(-0.12, 0.66, back + 0.36), "#1A120E")
	buddyBall(folder, torso, "BuddyPupilR", Vector3.new(0.08, 0.08, 0.08), CFrame.new(0.22, 0.66, back + 0.36), "#1A120E")
	local shineL = buddyBall(folder, torso, "BuddyShineL", Vector3.new(0.05, 0.05, 0.05), CFrame.new(-0.15, 0.7, back + 0.38), "#FFFFFF")
	shineL.Material = Enum.Material.Neon
	local shineR = buddyBall(folder, torso, "BuddyShineR", Vector3.new(0.05, 0.05, 0.05), CFrame.new(0.19, 0.7, back + 0.38), "#FFFFFF")
	shineR.Material = Enum.Material.Neon
	buddyBall(folder, torso, "BuddyEarL", Vector3.new(0.22, 0.2, 0.14), CFrame.new(-0.28, 0.9, back), def.color)
	buddyBall(folder, torso, "BuddyEarR", Vector3.new(0.22, 0.2, 0.14), CFrame.new(0.38, 0.9, back), def.color)
	local rings = { "#2A2420", "#E6D3B0", "#2A2420", "#E6D3B0" }
	for i, color in ipairs(rings) do
		local sz = 0.32 - i * 0.03
		buddyBall(folder, torso, "BuddyTail", Vector3.new(sz, sz, sz), CFrame.new(0.32 + i * 0.1, 0.02 + i * 0.06, back - 0.12 - i * 0.14), color)
	end
end

local function buildTag(folder: Folder, head: BasePart, player: Player, data: any, resting: boolean, vip: boolean)
	local bb = Instance.new("BillboardGui")
	bb.Name = "TitleTag"
	bb.Size = UDim2.new(0, 220, 0, 56)
	bb.StudsOffset = Vector3.new(0, 3.2, 0)
	bb.MaxDistance = 90
	bb.Adornee = head
	bb.LightInfluence = 0
	bb.Parent = folder
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 0.5)
	title.BackgroundTransparency = 1
	title.TextScaled = true
	title.Font = Enum.Font.FredokaOne
	title.TextStrokeTransparency = 0.4
	title.TextColor3 = vip and hex("#FFD700") or hex("#FFE9A8")
	local rankName = Config.Ranks[data.rank] and Config.Ranks[data.rank].name or ""
	local t = data.title ~= "" and data.title or rankName
	local prefix = vip and "✨ " or ""
	if ctx.Membership and ctx.Membership.isMember(player) then
		prefix = "🔧 " .. Config.Club.title .. " · "
		title.TextColor3 = hex("#7CD1C1")
	elseif ctx.Membership and ctx.Membership.isHost(player) then
		prefix = "🏠 "
	end
	title.Text = prefix .. t
	title.Parent = bb
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.Size = UDim2.fromScale(1, 0.45)
	sub.Position = UDim2.fromScale(0, 0.52)
	sub.BackgroundTransparency = 1
	sub.TextScaled = true
	sub.Font = Enum.Font.GothamMedium
	sub.TextStrokeTransparency = 0.5
	sub.TextColor3 = Color3.new(1, 1, 1)
	sub.Text = resting and Content.Slang.resting or ""
	sub.Parent = bb
end

function CosmeticService.apply(player: Player)
	local char = player.Character
	local data = ctx.Game.dataOf(player)
	if not char or not data then
		return
	end
	local old = char:FindFirstChild("BSCosmetics")
	if old then
		old:Destroy()
	end
	local hrp = find(char, "HumanoidRootPart")
	if hrp then
		for _, a in ipairs(hrp:GetChildren()) do
			if a:GetAttribute("BSCosmetic") then
				a:Destroy()
			end
		end
	end
	local head = find(char, "Head")
	local torso = find(char, "UpperTorso", "Torso")
	local hand = find(char, "RightHand", "Right Arm")
	if not head or not torso then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "BSCosmetics"
	local eq = data.equipped
	local r = ctx.Game.runtime[player]
	local ok, err = pcall(function()
		if eq.hat and data.owned[eq.hat] then
			buildHat(folder, head, eq.hat)
		end
		if eq.apron and data.owned[eq.apron] then
			buildApron(folder, torso, eq.apron)
		end
		if eq.tool and data.owned[eq.tool] and hand then
			buildTool(folder, hand, eq.tool)
		end
		if eq.neck and data.owned[eq.neck] then
			buildNeck(folder, torso, eq.neck)
		end
		if eq.feet and data.owned[eq.feet] then
			buildFeet(folder, char)
		end
		if eq.buddy and data.owned[eq.buddy] then
			buildBuddy(folder, torso, eq.buddy)
		end
		if eq.trail and data.owned[eq.trail] and hrp then
			buildTrail(folder, hrp, eq.trail)
		end
		buildTag(folder, head, player, data, r ~= nil and r.resting, ctx.Game.hasPass(player, "VIPPatio"))
	end)
	if not ok then
		warn("[CosmeticService] " .. tostring(err))
	end
	folder.Parent = char
end

function CosmeticService.init(c: any)
	ctx = c
end

function CosmeticService.start()
	-- Rainbow Sherbet smoke cycles colors on the owner's smokers.
	task.spawn(function()
		local hue = 0
		while true do
			task.wait(0.4)
			hue = (hue + 0.03) % 1
			for _, player in ipairs(Players:GetPlayers()) do
				local data = ctx.Game.dataOf(player)
				if data and data.equipped.smoke == "smoke_sherbet" then
					local plot = ctx.World.plotModel(player)
					if plot then
						for _, s in ipairs(plot.Smokers:GetChildren()) do
							local ch = s:FindFirstChild("Chimney")
							local sm = ch and ch:FindFirstChild("Smoke") :: Smoke?
							if sm then
								sm.Color = Color3.fromHSV(hue, 0.45, 1)
							end
						end
					end
				end
			end
		end
	end)
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">CrewService</string>
            <string name="Source"><![CDATA[--!strict
-- The Hiring Line and the ranch crew, in the world.
-- Applicants walk the boardwalk with their price showing. A hire walks home and works a station.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local WorldBuilder = require(Shared.WorldBuilder)
local HiringLine = require(Shared.Logic.HiringLine)
local Crew = require(Shared.Logic.Crew)
local CrewMotion = require(Shared.Logic.CrewMotion)
local Weather = require(Shared.Logic.Weather)
local Income = require(Shared.Logic.Income)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Onboard = require(Shared.Logic.Onboard)

local CrewService = {}
local ctx: any = nil

local ENV = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}

local lineState = {
	seed = 1,
	window = -1,
	tier = 1,
	applicants = {} :: { any },
	taken = {} :: { [number]: number },
}
local lineSig = ""
local crewSig: { [Player]: string } = {}
local tierSig: { [Player]: number } = {}
local starters: { [Player]: Model } = {}

local function mapModel(): any
	return workspace:FindFirstChild("Map")
end

function CrewService.line(): any
	return lineState
end

function CrewService.init(c: any)
	ctx = c
	WorldBuilder.setEnv(ENV)
end

local function hexColor(h: string): Color3
	local ok, color = pcall(function()
		return Color3.fromHex(h)
	end)
	if ok and typeof(color) == "Color3" then
		return color
	end
	return Color3.fromRGB(255, 220, 160)
end

local function offerText(applicant: any): string
	local trait = if applicant.trait ~= nil and applicant.trait ~= "none" then (" · " .. applicant.traitName) else ""
	return string.format("%s%s · %s · %d coins", applicant.rarityName, trait, Income.format(applicant.rate), applicant.price)
end

local function appearance(applicant: any, staff: boolean): any
	return {
		id = applicant.model,
		body = applicant.body,
		head = applicant.head,
		scale = applicant.scale or 0.92,
		style = applicant.style,
		staff = staff,
		rex = applicant.model == "rex" or applicant.secret == true,
	}
end

local function addProp(model: Model, role: string)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local cf = root.CFrame * CFrame.new(0.7, 0.2, -0.8)
	if role == "pit" then
		local handle = Instance.new("Part")
		handle.Name = "Mop"
		handle.Anchored = true
		handle.CanCollide = false
		handle.Size = Vector3.new(0.12, 1.4, 0.12)
		handle.CFrame = cf
		handle.Color = Color3.fromHex("#C9852A")
		handle.Parent = model
		local head = Instance.new("Part")
		head.Name = "MopHead"
		head.Anchored = true
		head.CanCollide = false
		head.Size = Vector3.new(0.45, 0.28, 0.45)
		head.CFrame = cf * CFrame.new(0, -0.7, 0)
		head.Color = Color3.fromHex("#F4E1C1")
		head.Parent = model
	elseif role == "grill" then
		local tongs = Instance.new("Part")
		tongs.Name = "Tongs"
		tongs.Anchored = true
		tongs.CanCollide = false
		tongs.Size = Vector3.new(0.12, 0.9, 0.28)
		tongs.CFrame = cf
		tongs.Color = Color3.fromHex("#C0C0C0")
		tongs.Material = Enum.Material.Metal
		tongs.Parent = model
	elseif role == "server" then
		local tray = Instance.new("Part")
		tray.Name = "Tray"
		tray.Anchored = true
		tray.CanCollide = false
		tray.Size = Vector3.new(0.9, 0.08, 0.6)
		tray.CFrame = cf * CFrame.new(0, 0.4, 0)
		tray.Color = Color3.fromHex("#F4E1C1")
		tray.Parent = model
	else
		local flag = Instance.new("Part")
		flag.Name = "Flag"
		flag.Anchored = true
		flag.CanCollide = false
		flag.Size = Vector3.new(0.08, 1.1, 0.08)
		flag.CFrame = cf
		flag.Color = Color3.fromHex("#6B4226")
		flag.Parent = model
		local cloth = Instance.new("Part")
		cloth.Name = "FlagCloth"
		cloth.Anchored = true
		cloth.CanCollide = false
		cloth.Size = Vector3.new(0.55, 0.35, 0.05)
		cloth.CFrame = cf * CFrame.new(0.3, 0.35, 0)
		cloth.Color = Color3.fromHex("#E07A3D")
		cloth.Parent = model
	end
end

local function addAura(model: Model, color: string)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local ring = Instance.new("Part")
	ring.Name = "Aura"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Size = Vector3.new(0.12, 2.4, 2.4)
	ring.CFrame = CFrame.new(root.Position - Vector3.new(0, root.Size.Y * 0.45, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = hexColor(color)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.35
	ring.Parent = model
end

local function quiet(model: Model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
end

-- Clients read these attributes and move the model themselves. The server leaves it put,
-- so a full ranch of critters does not replicate a new pose every frame.
local function tagAnim(model: Model, ground: { Vector3 }, kind: string, speed: number, phase: number)
	if #ground < 2 then
		return
	end
	local lift = model:GetPivot().Position.Y
	local bits = {}
	for _, p in ipairs(ground) do
		local at = p + Vector3.new(0, lift, 0)
		table.insert(bits, string.format("%.2f,%.2f,%.2f", at.X, at.Y, at.Z))
	end
	model:SetAttribute("CrewAnim", kind)
	model:SetAttribute("AnimSpeed", speed)
	model:SetAttribute("AnimPhase", phase)
	model:SetAttribute("AnimPoints", table.concat(bits, "|"))
	if kind == "once" then
		model:SetAttribute("AnimStart", workspace:GetServerTimeNow())
	end
	local first = ground[1] + Vector3.new(0, lift, 0)
	local nextPoint = ground[math.min(2, #ground)] + Vector3.new(0, lift, 0)
	if (nextPoint - first).Magnitude < 0.05 then
		nextPoint = first + Vector3.new(0, 0, -1)
	end
	model:PivotTo(CFrame.lookAt(first, nextPoint))
end

-- `points` are already where the client should draw the pivot, bob not included.
local function tagPath(model: Model, points: { Vector3 }, speed: number)
	if #points < 2 then
		return
	end
	local vecs = {}
	for _, p in ipairs(points) do
		table.insert(vecs, { p.X, p.Y, p.Z })
	end
	model:SetAttribute("CrewAnim", "once")
	model:SetAttribute("AnimSpeed", speed)
	model:SetAttribute("AnimPhase", 0)
	model:SetAttribute("AnimPoints", CrewMotion.encode(vecs))
	model:SetAttribute("AnimStart", workspace:GetServerTimeNow())
	local nextPoint = points[2]
	if (nextPoint - points[1]).Magnitude < 0.05 then
		nextPoint = points[1] + Vector3.new(0, 0, -1)
	end
	model:PivotTo(CFrame.lookAt(points[1], nextPoint))
end

local function toWorld(path: { { number } }): { Vector3 }
	local out = {}
	for _, p in ipairs(path) do
		table.insert(out, Vector3.new(p[1], p[2], p[3]))
	end
	return out
end

local function plotCenter(plot: any): Vector3
	local pad = plot and plot:FindFirstChild("Pad")
	if pad and pad:IsA("BasePart") then
		return pad.Position
	end
	return Vector3.zero
end

local function hiringFolder(): Folder?
	local map = mapModel()
	local hub = map and map:FindFirstChild("Hub")
	local line = hub and hub:FindFirstChild("HiringLine")
	if not line then
		return nil
	end
	local folder = line:FindFirstChild("Applicants")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Applicants"
		folder.Parent = line
	end
	return folder :: Folder
end

local function padPoints(): { Vector3 }
	local map = mapModel()
	local hub = map and map:FindFirstChild("Hub")
	local line = hub and hub:FindFirstChild("HiringLine")
	local pads = line and line:FindFirstChild("Pads")
	local points = {}
	if not pads then
		return points
	end
	for i = 1, Config.Hiring.count do
		local pad = pads:FindFirstChild("Pad" .. i)
		if pad and pad:IsA("BasePart") then
			table.insert(points, pad.Position + Vector3.new(0, 0.2, 0))
		end
	end
	return points
end

local function spawnApplicants()
	local folder = hiringFolder()
	if not folder then
		return
	end
	folder:ClearAllChildren()
	local points = padPoints()
	if #points < 2 then
		return
	end
	for _, applicant in ipairs(lineState.applicants) do
		if lineState.taken[applicant.index] == nil then
			local model = WorldBuilder.critter(ENV, folder, appearance(applicant, false), CFrame.new())
			model.Name = "Applicant" .. applicant.index
			model:SetAttribute("Applicant", applicant.index)
			quiet(model)
			addAura(model, applicant.color)
			local head = model:FindFirstChild("Head")
			local adornee = if head and head:IsA("BasePart") then head else model.PrimaryPart
			if adornee then
				WorldBuilder.billboard(adornee, "NameTag", applicant.name, 2.2, 90, "#FFF6E0", 180, 28, { 5.2, 0.7, 90, 16 })
				WorldBuilder.billboard(adornee, "Offer", offerText(applicant), 3.2, 90, applicant.color, 260, 36, { 7.5, 0.9, 120, 16 })
			end
			local body = model:FindFirstChild("Body")
			if body and body:IsA("BasePart") then
				local prompt = WorldBuilder.prompt(body, "hire", "Hire", applicant.name, 0, 12)
				prompt:SetAttribute("Applicant", applicant.index)
			end
			tagAnim(model, points, "loop", 5.5, applicant.index)
		end
	end
end

local function lineSignature(): string
	local parts = { tostring(lineState.window), tostring(lineState.tier) }
	for i = 1, Config.Hiring.count do
		table.insert(parts, tostring(lineState.taken[i] or 0))
	end
	return table.concat(parts, ":")
end

local function maxTier(): number
	local best = 1
	for _, player in ipairs(Players:GetPlayers()) do
		local data = ctx.Game.dataOf(player)
		if type(data) == "table" and type(data.ranch) == "table" and type(data.ranch.tier) == "number" then
			best = math.max(best, data.ranch.tier)
		end
	end
	return math.clamp(best, 1, #Config.RanchTiers)
end

local function restock()
	local now = os.time()
	local window = HiringLine.window(now, Config.Hiring.period)
	local tier = if lineState.window == window then lineState.tier else maxTier()
	if lineState.window ~= window then
		lineState.window = window
		lineState.tier = tier
		local show = Weather.smokeShow(os.time(), TimeUtil.centralOffset(os.time()))
		lineState.applicants = HiringLine.stock(lineState.seed, window, tier)
		if show then
			HiringLine.raiseFloor(lineState.applicants)
		end
		lineState.taken = {}
		if ctx.Game and ctx.Game.autoHire then
			for _, player in ipairs(Players:GetPlayers()) do
				ctx.Game.autoHire(player)
			end
		end
		for _, applicant in ipairs(lineState.applicants) do
			if applicant.rarity == "legendary" or applicant.rarity == "mythic" or applicant.rarity == "secret" then
				if ctx.Game and ctx.Game.announce then
					ctx.Game.announce(string.format("%s the %s is on the Hiring Line.", applicant.name, applicant.rarityName), applicant.color)
				end
				break
			end
		end
	end
	local sig = lineSignature()
	if sig ~= lineSig then
		lineSig = sig
		spawnApplicants()
	end
	local map = mapModel()
	local hub = map and map:FindFirstChild("Hub")
	local line = hub and hub:FindFirstChild("HiringLine")
	local board = line and line:FindFirstChild("RestockBoard")
	if board then
		for _, d in ipairs(board:GetDescendants()) do
			if d.Name == "Clock" and d:IsA("TextLabel") then
				d.Text = HiringLine.clockLabel(now, Config.Hiring.period, Config.TIMEZONE_OFFSET_HOURS)
			end
		end
	end
end

local function stationPoints(plot: any, role: string): { Vector3 }
	local points = {}
	local stations = plot:FindFirstChild("CrewStations")
	local name = if role == "pit" then "Pit" elseif role == "grill" then "Grill" elseif role == "server" then "Serve" else "Greet"
	local pad = stations and stations:FindFirstChild(name)
	if pad and pad:IsA("BasePart") then
		table.insert(points, pad.Position)
		local ahead = pad.CFrame.LookVector
		table.insert(points, pad.Position + Vector3.new(ahead.X, 0, ahead.Z).Unit * 3.5)
		return points
	end
	local spawn = plot:FindFirstChild("SpawnPad")
	if spawn and spawn:IsA("BasePart") then
		table.insert(points, spawn.Position)
		table.insert(points, spawn.Position + Vector3.new(3, 0, 0))
	end
	return points
end

local function traitFx(model: Model, traitId: string?)
	if traitId == nil or traitId == "" or traitId == "none" then
		return
	end
	local body = model:FindFirstChild("Body")
	if not body or not body:IsA("BasePart") then
		return
	end
	local p = Instance.new("ParticleEmitter")
	p.Name = "Trait"
	p.Rate = 4
	p.Lifetime = NumberRange.new(0.6, 1.1)
	p.Speed = NumberRange.new(0.3, 1)
	p.LightEmission = if traitId == "golden" or traitId == "glazed" then 0.7 else 0.25
	local color = if traitId == "smoky"
		then Color3.fromRGB(170, 170, 170)
		elseif traitId == "glazed" then Color3.fromRGB(255, 220, 150)
		elseif traitId == "golden" then Color3.fromRGB(255, 196, 60)
		else Color3.fromRGB(255, 96, 48)
	p.Color = ColorSequence.new(color)
	p.Parent = body
end

local function crewOutfit(model: Model, outfitId: string?)
	if type(outfitId) ~= "string" or outfitId == "" then
		return
	end
	local look = Config.Cosmetics[outfitId]
	if type(look) ~= "table" or type(look.color) ~= "string" then
		return
	end
	local body = model:FindFirstChild("Body")
	if not body or not body:IsA("BasePart") then
		return
	end
	local mark = Instance.new("Highlight")
	mark.Name = "Outfit"
	mark.FillColor = Color3.fromHex(look.color)
	mark.FillTransparency = 0.55
	mark.OutlineTransparency = 0.4
	mark.Parent = model
	mark.Adornee = body
end

local function showTiers(plot: any, tier: number)
	local root = plot:FindFirstChild("RanchTiers")
	if not root then
		return
	end
	for _, piece in ipairs(root:GetChildren()) do
		local minTier = piece:GetAttribute("MinTier")
		local need = if type(minTier) == "number" then minTier else 99
		local on = tier >= need
		for _, d in ipairs(piece:GetDescendants()) do
			if d:IsA("BasePart") then
				local shown = d:GetAttribute("ShownTransparency")
				local vis = if type(shown) == "number" then shown else 0
				d.Transparency = if on then vis else 1
				d.CanCollide = on and d:GetAttribute("Solid") == true
			elseif d:IsA("TextLabel") then
				d.TextTransparency = if on then 0 else 1
			end
		end
	end
end

-- Unclaimed yards show the finished ranch, faded, so the build-out is visible before anyone claims it.
local function showGhost(plot: any)
	showTiers(plot, #Config.RanchTiers)
	local root = plot:FindFirstChild("RanchTiers")
	if not root then
		return
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			d.Transparency = 0.72
			d.CanCollide = false
		end
	end
end

local function clearCrew(player: Player)
	local plot = ctx.World.plotModel(player)
	local folder = plot and plot:FindFirstChild("RanchCrew")
	if folder then
		folder:ClearAllChildren()
	end
	crewSig[player] = nil
end

local function refreshCrew(player: Player)
	local data = ctx.Game.dataOf(player)
	local plot = ctx.World.plotModel(player)
	if type(data) ~= "table" or not plot then
		return
	end
	Crew.ensure(data)
	local hostData = nil
	if ctx.Game.familyHost then
		local _, saved = ctx.Game.familyHost()
		hostData = saved
	end
	local tier = math.floor(if hostData then hostData.ranch.tier or 1 else data.ranch.tier or 1)
	if tierSig[player] ~= tier then
		showTiers(plot, tier)
		tierSig[player] = tier
	end
	local mults = ctx.Game.crewMults(player, data)
	local view = Crew.view(data, mults)
	if ctx.Game.crewSlots then
		view.slots = ctx.Game.crewSlots(data)
	end
	local parts = {}
	for i, member in ipairs(view.owned) do
		if i > view.slots then
			break
		end
		table.insert(parts, string.format("%d:%d:%s:%.2f", member.uid, member.level, member.trait, member.earn))
	end
	local sig = table.concat(parts, "|")
	local existing = plot:FindFirstChild("RanchCrew")
	if crewSig[player] == sig and existing and #existing:GetChildren() > 0 then
		return
	end
	clearCrew(player)
	crewSig[player] = sig
	local folder = plot:FindFirstChild("RanchCrew")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "RanchCrew"
		folder.Parent = plot
	else
		folder:ClearAllChildren()
	end
	local n = 0
	for i, member in ipairs(view.owned) do
		if i > view.slots then
			break
		end
		local species = Crew.byId(member.species)
		if species then
			n += 1
			local model = WorldBuilder.critter(ENV, folder, appearance(species, true), CFrame.new())
			model.Name = "Crew" .. member.uid
			model:SetAttribute("CrewUid", member.uid)
			quiet(model)
			addProp(model, member.role)
			addAura(model, member.color)
			if member.badge == "Founder" then
				local root = model.PrimaryPart
				if root then
					local ribbon = Instance.new("Part")
					ribbon.Name = "FounderRibbon"
					ribbon.Anchored = true
					ribbon.CanCollide = false
					ribbon.Size = Vector3.new(0.7, 0.16, 0.08)
					ribbon.Color = Color3.fromHex("#E07A3D")
					ribbon.CFrame = root.CFrame * CFrame.new(0, 0.2, -root.Size.Z * 0.4)
					ribbon.Parent = model
				end
			end
			local head = model:FindFirstChild("Head")
			local adornee = if head and head:IsA("BasePart") then head else model.PrimaryPart
			if adornee then
				local tag = member.name
				if member.badge == "Founder" then
					tag ..= " · Founder"
				end
				WorldBuilder.billboard(adornee, "NameTag", tag, 2.2, 70, "#FFF6E0", 180, 28, { 5, 0.7, 80, 14 })
				WorldBuilder.billboard(adornee, "Rate", Income.format(member.earn), 3.15, 70, "#7DCE6A", 140, 28, { 4.2, 0.7, 70, 16 })
			end
			local body = model:FindFirstChild("Body")
			if body and body:IsA("BasePart") then
				local cheer = WorldBuilder.prompt(body, "cheer", "Cheer", member.name, 0, 10)
				cheer:SetAttribute("OwnerUserId", player.UserId)
				cheer:SetAttribute("CrewUid", member.uid)
			end
			local points = stationPoints(plot, member.role)
			local side = ((n - 1) % 3 - 1) * 1.5
			local row = math.floor((n - 1) / 3) * 1.2
			for p = 1, #points do
				points[p] = points[p] + Vector3.new(side, 0, row)
			end
			tagAnim(model, points, "loop", 3.2, n)
			traitFx(model, member.trait)
			crewOutfit(model, if type(data.crew) == "table" then data.crew.outfit else nil)
		end
	end
	if (data.playSeconds or 0) < 20 and not Onboard.skip(data) and not plot:FindFirstChild("WelcomeBeam") then
		local pad = plot:FindFirstChild("Pad")
		if pad and pad:IsA("BasePart") then
			local beam = Instance.new("Part")
			beam.Name = "WelcomeBeam"
			beam.Anchored = true
			beam.CanCollide = false
			beam.Material = Enum.Material.Neon
			beam.Color = Color3.fromRGB(255, 200, 80)
			beam.Size = Vector3.new(1.2, 18, 1.2)
			beam.CFrame = pad.CFrame * CFrame.new(0, 10, 0)
			beam.Parent = plot
		end
	end
end

function CrewService.walkHome(player: Player, index: number)
	local folder = hiringFolder()
	local model: Model? = nil
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Model") and child:GetAttribute("Applicant") == index then
				model = child
				break
			end
		end
	end
	if not model then
		return
	end
	local plot = ctx.World.plotModel(player)
	local greet = plot and plot:FindFirstChild("CrewStations")
	local pad = greet and greet:FindFirstChild("Greet")
	if not pad or not pad:IsA("BasePart") then
		model:Destroy()
		return
	end
	local home = Instance.new("Folder")
	home.Name = "WalkingHome"
	home.Parent = mapModel() or workspace
	model.Parent = home
	local now = workspace:GetServerTimeNow()
	local saved = CrewMotion.decode(model:GetAttribute("AnimPoints"))
	local speedAttr = model:GetAttribute("AnimSpeed")
	local phaseAttr = model:GetAttribute("AnimPhase")
	local kindAttr = model:GetAttribute("CrewAnim")
	local startAttr = model:GetAttribute("AnimStart")
	local x, y, z = CrewMotion.pose(
		saved,
		now,
		if type(speedAttr) == "number" then speedAttr else 5.5,
		if type(phaseAttr) == "number" then phaseAttr else 0,
		if kindAttr == "once" then "once" else "loop",
		if type(startAttr) == "number" then startAttr else nil
	)
	local center = plotCenter(plot)
	local path = CrewMotion.homePath(x, y, z, center.X, center.Z, pad.Position.X, pad.Position.Z)
	local world = toWorld(path)
	tagPath(model, world, Config.Hiring.walkSpeed)
	local seconds = CrewMotion.walkSeconds(path, Config.Hiring.walkSpeed)
	task.delay(seconds + 1.5, function()
		if model then
			model:Destroy()
		end
	end)
end

function CrewService.cancelStarter(player: Player)
	local model = starters[player]
	if model then
		model:Destroy()
		starters[player] = nil
	end
end

function CrewService.walkStarter(player: Player): number?
	CrewService.cancelStarter(player)
	local folder = hiringFolder()
	local points = padPoints()
	if not folder or #points < 1 then
		return nil
	end
	local species = Crew.byId("armadillo")
	if not species then
		return nil
	end
	local model = WorldBuilder.critter(ENV, folder, appearance(species, true), CFrame.new())
	model.Name = "StarterPip"
	quiet(model)
	addProp(model, species.role)
	local head = model:FindFirstChild("Head")
	local adornee = if head and head:IsA("BasePart") then head else model.PrimaryPart
	if adornee then
		WorldBuilder.billboard(adornee, "NameTag", "Pip", 2.2, 90, "#FFF6E0", 160, 28, { 4.5, 0.7, 80, 16 })
		WorldBuilder.billboard(adornee, "Offer", "First hire's on the house!", 3.2, 90, "#7DCE6A", 260, 32, { 7, 0.8, 110, 16 })
	end
	local start = points[1]
	local plot = ctx.World.plotModel(player)
	local greet = plot and plot:FindFirstChild("CrewStations")
	local pad = greet and greet:FindFirstChild("Greet")
	local lift = model:GetPivot().Position.Y
	local center = plotCenter(plot)
	local greetPos = if pad and pad:IsA("BasePart") then pad.Position else center
	local path = CrewMotion.homePath(start.X, start.Y + lift, start.Z, center.X, center.Z, greetPos.X, greetPos.Z)
	local speed = Config.Hiring.walkSpeed
	local seconds = CrewMotion.walkSeconds(path, speed)
	-- The opening walk stays on the path, and Pip is on the pit by the time the tracker asks for a second hire.
	if seconds > Config.Onboarding.pipAt then
		speed = CrewMotion.length(path) / Config.Onboarding.pipAt
		seconds = Config.Onboarding.pipAt
	end
	tagPath(model, toWorld(path), speed)
	starters[player] = model
	task.delay(seconds + 1.5, function()
		if starters[player] == model then
			model:Destroy()
			starters[player] = nil
		end
	end)
	return seconds
end

function CrewService.onPlayerGone(player: Player)
	local plot = ctx.World and ctx.World.plotModel and ctx.World.plotModel(player)
	clearCrew(player)
	CrewService.cancelStarter(player)
	tierSig[player] = nil
	if plot then
		local beam = plot:FindFirstChild("WelcomeBeam")
		if beam then
			beam:Destroy()
		end
		showGhost(plot)
	end
end

function CrewService.start()
	lineState.seed = Random.new():NextInteger(1, 2000000000)
	local map = mapModel()
	local hub = map and map:FindFirstChild("Hub")
	if hub and not hub:FindFirstChild("HiringLine") then
		WorldBuilder.hiringLine(hub)
	end
	if map then
		local plots = map:FindFirstChild("Plots")
		if plots then
			for _, plot in ipairs(plots:GetChildren()) do
				if not plot:FindFirstChild("RanchTiers") then
					local pad = plot:FindFirstChild("Pad")
					if pad and pad:IsA("BasePart") then
						WorldBuilder.ranchBuild(plot, pad.CFrame)
					end
				end
				showGhost(plot)
			end
		end
	end
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if prompt:GetAttribute("Kind") ~= "hire" and prompt:GetAttribute("Kind") ~= "cheer" then
			return
		end
		if prompt:GetAttribute("Kind") == "cheer" then
			local ok, msg = ctx.Game.act(player, "Cheer", prompt:GetAttribute("OwnerUserId"), prompt:GetAttribute("CrewUid"))
			if not ok and type(msg) == "string" and msg ~= "" then
				ctx.Game.toast(player, msg, "warn")
			end
			return
		end
		local index = prompt:GetAttribute("Applicant")
		if type(index) ~= "number" then
			return
		end
		-- Same pipeline as the Hire panel: rate limit, guide update, and a save.
		local ok, msg = ctx.Game.act(player, "HireApplicant", index)
		if not ok and type(msg) == "string" and msg ~= "" then
			ctx.Game.toast(player, msg, "warn")
		end
	end)
	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				restock()
				for _, player in ipairs(Players:GetPlayers()) do
					if ctx.Game.runtime[player] then
						refreshCrew(player)
					end
				end
			end)
			if not ok then
				warn("[CrewService] " .. tostring(err))
			end
			task.wait(1)
		end
	end)
end

return CrewService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — DataStore persistence with session locking, retries and safe shutdown.

	Record format in the DataStore: { lock = { jobId, time }?, data = <player data> }
	  * Load: UpdateAsync acquires the lock. If another live server holds it (player hopped
	    servers and the old one is still saving), we wait and retry; a lock older than
	    STALE_LOCK seconds, or a lock with a missing / future timestamp from a previous
	    server version, is taken. Each request has a timeout. If Roblox never answers,
	    the ranch opens in memory so the player is not stuck on the loading screen.
	    Memory sessions are not written back.
	  * Autosave every Config.AUTOSAVE_SECONDS refreshes the lock.
	  * Leave / shutdown: final save releases the lock.
	  * If we ever lose the lock, we stop saving for that player (never overwrite newer data).
	  * In Studio without "Enable Studio Access to API Services", we run in memory-only mode.
]]
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DefaultData = require(Shared.DefaultData)
local SessionLock = require(Shared.Logic.SessionLock)
local Reconcile = require(Shared.Logic.Reconcile)
local Migrate = require(Shared.Logic.Migrate)
local Jimothy = require(Shared.Logic.Jimothy)
local Staff = require(Shared.Logic.Staff)
local Signal = require(Shared.Signal)

local STORE_NAME = "BackyardSmokeout_Players_v1"
local STALE_LOCK = 300 -- seconds
local LOAD_ATTEMPTS = 6
local LOCK_WAIT_BEFORE_STEAL = 3 -- fresh locks from a dead server are taken after this many tries
local ATTEMPT_TIMEOUT = 8 -- seconds; UpdateAsync must not yield forever
local SAVE_ATTEMPTS = 4

export type Profile = {
	player: Player,
	key: string,
	data: any,
	memoryOnly: boolean,
	lostLock: boolean,
	saving: boolean,
	released: boolean,
	loadedAt: number,
}

local DataService = {}
DataService.profiles = {} :: { [Player]: Profile }
-- Listeners must see the stored profile. A BindableEvent would deep-copy it, the
-- copy would fail GameService's identity check, and the ranch would never start.
DataService.onLoaded = Signal.new()

local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))
local store: DataStore? = nil
local _storeError: string? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		local why = tostring(result)
		_storeError = why
		warn("[DataService] DataStore unavailable: " .. why)
	end
end

local function keyFor(userId: number): string
	return "u_" .. tostring(userId)
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	local tries = 0
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and tries < 20 do
		tries += 1
		task.wait(0.5)
	end
end

local function isApiAccessError(err: string): boolean
	return string.find(err, "403", 1, true) ~= nil
		or string.find(string.lower(err), "studio", 1, true) ~= nil
		or string.find(string.lower(err), "api services", 1, true) ~= nil
end

local function freshData(): any
	return Reconcile.deepCopy(DefaultData)
end

-- UpdateAsync has no engine timeout. A request that never resumes used to sit on the
-- PlayerAdded thread forever, so profiles[player] stayed nil and every action said
-- "Still loading your ranch...". `fn` may yield. A late transform must cancel itself
-- via `alive` once the caller has moved on.
local function callWithTimeout(seconds: number, fn: () -> ()): (boolean, string?)
	local done = false
	local ok = true
	local err: any = nil
	task.spawn(function()
		ok, err = pcall(function(): nil
			fn()
			return nil
		end)
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < seconds do
		task.wait(0.05)
	end
	if not done then
		return false, "timeout"
	end
	if not ok then
		return false, tostring(err)
	end
	return true, nil
end

function DataService.get(player: Player): Profile?
	return DataService.profiles[player]
end

function DataService.waitFor(player: Player, timeout: number): Profile?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < timeout do
		local p = DataService.profiles[player]
		if p then
			return p
		end
		task.wait(0.2)
	end
	return DataService.profiles[player]
end

local function publish(player: Player, key: string, data: any, memoryOnly: boolean): Profile?
	if not player.Parent then
		return nil
	end
	local isNew = data == nil
	-- Reconcile keeps an existing schema and fills a missing one from the template.
	-- A save with no schema is still a v1 ranch, so remember that before the fill.
	local priorSchema = 2
	if not isNew then
		priorSchema = if type(data) == "table" and type(data.schema) == "number" then data.schema else 1
	end
	data = Reconcile.fill(data or freshData(), DefaultData)
	if priorSchema < 2 then
		data.schema = priorSchema
	end
	local migrated, migrateErr = pcall(function()
		Jimothy.migrate(data)
		Staff.normalize(data)
		Migrate.apply(data, os.time())
	end)
	if not migrated then
		warn("[DataService] Jimothy migrate failed for " .. player.Name .. ": " .. tostring(migrateErr))
	end
	local profile: Profile = {
		player = player,
		key = key,
		data = data,
		memoryOnly = memoryOnly,
		lostLock = false,
		saving = false,
		released = false,
		loadedAt = os.time(),
	}
	DataService.profiles[player] = profile
	DataService.onLoaded:Fire(player, profile, isNew)
	return profile
end

local function loadInner(player: Player): Profile?
	local key = keyFor(player.UserId)
	local memoryOnly = false
	local data = nil
	local got = false

	if store == nil then
		memoryOnly = true
	else
		local s = store :: DataStore
		local current: any = nil
		local lockedWaits = 0
		for attempt = 1, LOAD_ATTEMPTS do
			if not player.Parent then
				return nil
			end
			local status = "error"
			local loaded = nil
			local gen = {}
			current = gen
			local force = lockedWaits >= LOCK_WAIT_BEFORE_STEAL
			-- Budget check is inside the pcall. It used to sit outside, so a throw there
			-- killed the join thread with no profile and no fallback.
			local okCall, why = callWithTimeout(ATTEMPT_TIMEOUT, function()
				waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
				s:UpdateAsync(key, function(old)
					if gen ~= current then
						return nil
					end
					local rec, st = SessionLock.acquire(old, jobId, os.time(), STALE_LOCK, force)
					status = st
					if rec then
						loaded = rec.data
					end
					return rec
				end)
			end)
			if not okCall then
				current = nil
				local msg = why or "error"
				warn(string.format("[DataService] load attempt %d failed for %s: %s", attempt, player.Name, msg))
				if msg == "timeout" then
					-- A stuck request will not answer a second one queued behind it.
					break
				end
				if RunService:IsStudio() and isApiAccessError(msg) then
					memoryOnly = true
					break
				end
				task.wait(math.min(2 ^ attempt, 8))
			elseif status == "acquired" or status == "stale-taken" then
				data = loaded
				got = true
				break
			elseif status == "locked" then
				lockedWaits += 1
				if force then
					warn("[DataService] lock for " .. player.Name .. " was still held after the wait; steal failed")
				end
				task.wait(math.min(2 * attempt, 6))
			else
				warn(string.format("[DataService] load attempt %d for %s returned %s", attempt, player.Name, status))
				task.wait(math.min(2 ^ attempt, 8))
			end
		end
		if not got and not memoryOnly then
			-- Do not kick. Kicking (or hanging) is what left players on the loading screen.
			-- This session will not write, so it cannot overwrite the real save.
			warn("[DataService] opening " .. player.Name .. " in memory; Roblox save servers did not answer")
			memoryOnly = true
			data = nil
		end
	end

	if not player.Parent then
		-- Left while loading: release the lock we just took.
		if got and not memoryOnly and store then
			pcall(function()
				(store :: DataStore):UpdateAsync(key, function(old)
					if type(old) == "table" and old.lock and old.lock.jobId == jobId then
						old.lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return nil
	end

	return publish(player, key, data, memoryOnly)
end

function DataService.load(player: Player): Profile?
	local ok, result = xpcall(function()
		return loadInner(player)
	end, debug.traceback)
	if ok then
		return result
	end
	warn("[DataService] load crashed for " .. player.Name .. ":\n" .. tostring(result))
	if not player.Parent then
		return nil
	end
	if DataService.profiles[player] then
		return DataService.profiles[player]
	end
	return publish(player, keyFor(player.UserId), nil, true)
end

-- Returns true if the data is safely in the DataStore.
function DataService.save(profile: Profile, release: boolean): boolean
	if profile.memoryOnly then
		return true
	end
	if profile.lostLock or store == nil then
		return false
	end
	-- Don't run two saves for the same player at once.
	local waited = 0
	while profile.saving and waited < 30 do
		task.wait(0.25)
		waited += 0.25
	end
	if profile.released then
		-- The final save already ran and dropped our lock (e.g. an autosave that queued up behind
		-- the leave save). Writing now would re-lock the record and block the player's next join.
		return false
	end
	profile.saving = true
	profile.data.lastSeen = os.time()
	local s = store :: DataStore
	local saved = false
	for attempt = 1, SAVE_ATTEMPTS do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local status = "error"
		local ok, err = pcall(function()
			s:UpdateAsync(profile.key, function(old)
				local rec, st = SessionLock.save(old, jobId, os.time(), profile.data, release)
				status = st
				return rec
			end)
		end)
		if ok and status == "saved" then
			saved = true
			break
		elseif ok and status == "lost-lock" then
			warn("[DataService] lost session lock for " .. profile.key .. "; not overwriting newer data")
			profile.lostLock = true
			break
		else
			warn(string.format("[DataService] save attempt %d failed for %s: %s", attempt, profile.key, tostring(err)))
			task.wait(math.min(2 ^ attempt, 8))
		end
	end
	profile.saving = false
	if release and saved then
		profile.released = true
	end
	return saved
end

function DataService.release(player: Player)
	local profile = DataService.profiles[player]
	if not profile then
		return
	end
	DataService.save(profile, true)
	-- Whatever happened, this server is done with the profile: no more writes after this.
	profile.released = true
	if DataService.profiles[player] == profile then
		DataService.profiles[player] = nil
	end
end

function DataService.isStudioMemoryMode(player: Player): boolean
	local p = DataService.profiles[player]
	return p ~= nil and p.memoryOnly
end

function DataService.start()
	-- Autosave loop (also refreshes our session locks).
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, profile in pairs(DataService.profiles) do
				task.spawn(DataService.save, profile, false)
				task.wait(0.5) -- spread requests out
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and store == nil then
			return
		end
		local pending = 0
		for player, _ in pairs(DataService.profiles) do
			pending += 1
			task.spawn(function()
				DataService.release(player)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
end

-- NOTE: GameService handles PlayerRemoving (settles cooks first) and then calls DataService.release.

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">EggService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EggService — every ProximityPrompt the server handles, plus NPC dialogue and Easter eggs.
	Prompts carry a "Kind" attribute set by WorldBuilder. Kinds starting with "ui:" and
	"npc:unc" are handled by the client (they only open UI or call a normal Action).

	Easter eggs (all original):
	  blessed  - a tiny figure on the Sunday potluck table holding a "Jesus loves you" ribbon
	  roof     - bounce off the trampoline onto the Sauce Shack roof ("Roof Club")
	  creek    - the whisper stone past the hedge gap: "Shhh... quiet on the creek." (daily sauce)
	  apron    - the World's Okayest Unc apron hanging by the creek
	  king     - visit the King of the Pit after dark wearing a cowboy hat
	  temp     - Temp the thermometer has a thing to say if you keep poking him
	  rex      - Rex visits your ranch ("RAWR means I love you")
	  meteorite- cook a Meteorite cut
	  cooked   - get a "Cooked" rating from Granny Pecan
	  sixseven - serve a plate worth ...67 coins ("6-7!")
	  dinnerbell - be one of 3 players who ring Big Bertha's dinner bell together (server-wide tip bonus)

	Jimothy sightings are a separate free hunt (Logic/Jimothy): prompts with Kind "jimothy".
]]
local ProximityPromptService = game:GetService("ProximityPromptService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Hype = require(Shared.Logic.Hype)
local Economy = require(Shared.Logic.Economy)
local Rarity = require(Shared.Logic.Rarity)
local Holiday = require(Shared.Logic.Holiday)
local Howdy = require(Shared.Logic.Howdy)
local Jimothy = require(Shared.Logic.Jimothy)

local EggService = {}
local ctx: any = nil
local rng = Random.new()
local tempPokes: { [Player]: number } = {}
local lastHowdy: { [Player]: number } = {}

EggService.EGGS = { "blessed", "roof", "creek", "apron", "king", "temp", "rex", "meteorite", "cooked", "sixseven", "dinnerbell" }

local bellRings: { [number]: number } = {}
local lastRing: { [number]: number } = {} -- userId -> os.clock() of the last ring that counted
local lastDinner = -1e9
local potluckShares: { [number]: number } = {}
local lastPotluck = -1e9

local function today(): number
	return TimeUtil.dayNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

local function dialog(player: Player, npc: string, text: string, reward: number?)
	ctx.Remotes.Push:FireClient(player, "dialog", { npc = npc, text = text, reward = reward or 0 })
end

function EggService.found(player: Player, data: any, egg: string): boolean
	if data.eggs[egg] then
		return false
	end
	data.eggs[egg] = true
	local n = 0
	for _, e in ipairs(EggService.EGGS) do
		if data.eggs[e] then
			n += 1
		end
	end
	ctx.Game.toast(player, string.format("🥚 Secret found! (%d/%d)", n, #EggService.EGGS), "good")
	if n == #EggService.EGGS then
		data.titles["Egg Hunter"] = true
		ctx.Game.toast(player, "You found every secret! New title: Egg Hunter", "good")
	end
	ctx.Game.markDirty(player)
	return true
end

local function ownsPrompt(player: Player, prompt: ProximityPrompt): boolean
	return prompt:GetAttribute("OwnerUserId") == player.UserId
end

local function customerFor(player: Player, prompt: ProximityPrompt): any?
	if not ownsPrompt(player, prompt) then
		return nil
	end
	local id = prompt:GetAttribute("CustomerId")
	if typeof(id) ~= "number" then
		return nil
	end
	return ctx.World.findCustomer(player, id)
end

local handlers: { [string]: (Player, any, ProximityPrompt) -> () } = {}

handlers.serve = function(player, _data, prompt)
	local c = customerFor(player, prompt)
	if c then
		ctx.Game.advanceAll(player, ctx.Game.dataOf(player), workspace:GetServerTimeNow(), true)
		local ok, msg = ctx.Game.serveCustomer(player, c)
		if not ok and msg then
			ctx.Game.toast(player, msg, "info")
		end
	end
end

handlers.bellyrub = function(player, _data, prompt)
	local c = customerFor(player, prompt)
	if c then
		ctx.Game.bellyRub(player, c)
	end
end

handlers.wash = function(player, _data, prompt)
	local c = customerFor(player, prompt)
	if c then
		ctx.Game.washPup(player, c)
		prompt:Destroy()
	end
end

handlers.snag = function(player, _data, prompt)
	ctx.Social.trySnag(player, prompt)
end

handlers.catch = function(player, _data, prompt)
	ctx.Social.tryCatch(player, prompt)
end

handlers.jimothy = function(player, data, prompt)
	local id = prompt:GetAttribute("Sighting")
	if typeof(id) ~= "string" then
		return
	end
	local res = Jimothy.record(data, id, os.clock())
	if not res.ok then
		return
	end
	if res.duplicate then
		ctx.Game.toast(player, "You already spotted this Jimothy.", "info")
		return
	end
	ctx.Game.toast(player, string.format("Jimothy sighting %d/%d!", res.count, res.total), "good")
	if res.justCompleted then
		ctx.Game.grantCosmetic(player, data, Jimothy.COSMETIC)
		ctx.Game.toast(player, "You found every Jimothy! New title: Jimothy Spotter", "good")
	end
end

handlers.cookoff = function(player)
	ctx.Event.enterCookOff(player)
end

-- Saying howdy (the King's prompt, or the word in chat) always waves at the yard.
-- The sauce is only after dark, in a cowboy hat, once a day.
function EggService.greet(player: Player, data: any)
	local now = os.clock()
	if lastHowdy[player] and now - lastHowdy[player] < 1.5 then
		return
	end
	lastHowdy[player] = now
	local hat = data.equipped and data.equipped.hat
	local cowboy = hat == "hat_pitmaster" or hat == "hat_straw"
	local line = Content.KingLines[rng:NextInteger(1, #Content.KingLines)]
	local rewarded = false
	if Howdy.rewardDue(ctx.Event.isNight(), cowboy, data.daily.kingDone == true) then
		data.daily.kingDone = true
		ctx.Game.addSauce(data, "straitshootin")
		EggService.found(player, data, "king")
		rewarded = true
		line = "Well now, that's a fine hat, partner. A pitmaster after dark is a pitmaster for life.\nTake a bottle of my Strait-Shootin' Sauce. Don't tell Unc.\n\n(Strait-Shootin' Sauce: +30% cook speed for 3 cooks)"
	elseif not data.daily.kingDone then
		line = line .. "\n\n(He tips his hat.) Come see me after sundown in a proper cowboy hat, partner."
	end
	dialog(player, "The King of the Pit", line)
	ctx.Remotes.Push:FireAllClients("fx", { kind = "howdy", data = { userId = player.UserId, name = player.DisplayName, rewarded = rewarded } })
	ctx.Game.markDirty(player)
end

function EggService.onChat(player: Player, text: string)
	if not Howdy.isGreeting(text) then
		return
	end
	local data = ctx.Game.dataOf(player)
	if not data or not ctx.Game.runtime[player] then
		return
	end
	EggService.greet(player, data)
end

handlers["npc:king"] = function(player, data)
	EggService.greet(player, data)
end

handlers["npc:temp"] = function(player, data)
	local night = ctx.Event.isNight()
	local pool = night and Content.TempNight or Content.TempDay
	tempPokes[player] = (tempPokes[player] or 0) + 1
	if tempPokes[player] >= 7 and not data.eggs.temp then
		EggService.found(player, data, "temp")
		ctx.Game.addCoins(player, data, 300, true)
		dialog(player, "Temp", "Okay okay, you got me. I don't actually know what temperature it is. I'm a thermometer with stage fright.\nHere's 300 coins to keep it between us.", 300)
		return
	end
	dialog(player, "Temp", pool[rng:NextInteger(1, #pool)])
end

handlers["egg:blessed"] = function(player, data)
	local first = EggService.found(player, data, "blessed")
	local d = today()
	if first then
		data.titles["Blessed"] = true
		ctx.Game.addPlate(data, { m = "brisket", r = "smokering" })
		ctx.Game.awardBadge(player, "BlessedPlate")
		dialog(player, "Sunday Potluck", "A tiny figure holds a little ribbon: \"Jesus loves you ♥\"\n\nSomebody left you a Blessed Plate (a Smoke Ring Gold brisket) and a new title: Blessed.")
		data.eggs.potluckDay = d
	elseif ctx.Game.isSunday() and data.eggs.potluckDay ~= d then
		data.eggs.potluckDay = d
		ctx.Game.addPlate(data, { m = "ribs", r = "juicy" })
		dialog(player, "Sunday Potluck", "\"Jesus loves you ♥\"\n\nIt's Sunday, so there's a potluck plate for you: Juicy Roch & Roll Ribs. Come back next Sunday!")
	else
		dialog(player, "Sunday Potluck", "\"Jesus loves you ♥\"\n\n(There's a potluck plate here every Sunday.)")
	end
	ctx.World.refreshStations(player)
end

handlers["egg:roof"] = function(player, data)
	if EggService.found(player, data, "roof") then
		data.titles["Roof Club"] = true
		ctx.Game.addCoins(player, data, 500, true)
		dialog(player, "Roof Club", "You signed the Sauce Shack roof. Only real ones make it up here.\n+500 coins and a new title: Roof Club", 500)
	else
		dialog(player, "Roof Club", "Your name's already up here. Nice view, huh?")
	end
end

handlers["egg:creek"] = function(player, data)
	local d = today()
	local first = EggService.found(player, data, "creek")
	if first then
		data.titles["Creek Whisperer"] = true
		ctx.Game.awardBadge(player, "SecretCreek")
	end
	if data.daily.creekDay ~= d then
		data.daily.creekDay = d
		ctx.Game.addSauce(data, "secretcreek")
		dialog(player, "Whisper Stone", Content.Slang.quietCreek .. "\n\nYou found a bottle of Secret Creek Sauce wedged in the rocks. (+50% luck for 5 cooks.) The creek gives one a day.")
	else
		dialog(player, "Whisper Stone", Content.Slang.quietCreek .. "\n\n(The creek already gave you a bottle today. Come back tomorrow.)")
	end
end

handlers["egg:apron"] = function(player, data)
	local isNew = ctx.Game.grantCosmetic(player, data, "apron_okayestunc")
	EggService.found(player, data, "apron")
	if isNew then
		dialog(player, "Mystery Apron", "WORLD'S OKAYEST UNC.\nIt fits perfectly. Too perfectly. Equip it in Settings > Fits.")
	else
		dialog(player, "Mystery Apron", "You already have this one. It's still okay.")
	end
end

-- Big Bertha's dinner bell, by the King of the Pit's 1,000-gallon smoker in the hub square.
-- One ring a day pays a small tip buff; every ring after that is free noise.
local BELL_LINES = {
	"CLANG! Somewhere across the county, a brisket sits up a little straighter.",
	"The bell rings out over the square. Big Bertha answers with a big puff of smoke.",
	"The King of the Pit tips his hat without looking up. \"That's the sound of supper.\"",
	"You ring it. A roadrunner stops, listens, and starts walking toward the food.",
	"Big Bertha's firebox crackles. She heard you.",
}

-- Dinner Bell pile-on: enough different players ring inside the window -> free server-wide tips.
local function checkDinnerBell(player: Player)
	local B = Config.DinnerBell
	local now = workspace:GetServerTimeNow()
	bellRings[player.UserId] = now
	local n, go = Hype.pileOn(bellRings, now, B.window, B.need, lastDinner, B.cooldown)
	if go then
		lastDinner = now
		ctx.Game.dinnerUntil = now + B.minutes * 60
		ctx.Game.announce(string.format("🔔 DINNER'S ON! %d pitmasters rang Big Bertha's bell. Everyone gets +%d%% tips for %d min!", n, math.floor(B.tipBonus * 100 + 0.5), B.minutes), "#FFC83C")
		ctx.Remotes.Push:FireAllClients("fx", { kind = "dinnerbell", data = { n = n } })
		for id in pairs(bellRings) do
			local p = Players:GetPlayerByUserId(id)
			local pd = p and ctx.Game.dataOf(p)
			if p and pd then
				EggService.found(p, pd, "dinnerbell")
			end
		end
		table.clear(bellRings)
		for p in pairs(ctx.Game.runtime) do
			ctx.Game.markDirty(p)
		end
	elseif now - lastDinner >= B.cooldown then
		ctx.Game.toast(player, string.format("🔔 Dinner bell: %d/%d. Get %d more pitmasters to ring it within %ds and the whole server gets bonus tips!", n, B.need, B.need - n, B.window), "info")
	end
end

-- Potluck events (Turkey Day Smokeout, Holiday Smokeout): share the event's smoked cut at the potluck
-- table (once a day). When enough different pitmasters share inside the window, the table is full:
-- free server-wide tips.
local function checkPotluck(player: Player, EV: any, EC: any)
	local now = workspace:GetServerTimeNow()
	potluckShares[player.UserId] = now
	local n, go = Hype.pileOn(potluckShares, now, EV.window, EV.need, lastPotluck, EV.cooldown)
	if go then
		lastPotluck = now
		ctx.Game.potluckUntil = now + EV.minutes * 60
		ctx.Game.potluckBonus = EV.tipBonus
		ctx.Game.potluckHud = EC.hud
		ctx.Game.announce(string.format(EC.full, n, math.floor(EV.tipBonus * 100 + 0.5), EV.minutes), EV.id == "holiday" and "#3FA35B" or "#E8761E")
		table.clear(potluckShares)
		for p in pairs(ctx.Game.runtime) do
			ctx.Game.markDirty(p)
		end
	elseif now - lastPotluck >= EV.cooldown then
		-- Everyone hears it (not just the sharer), so the rest of the server knows the table is
		-- filling up. Each player can share once a day, so this can't be spammed.
		ctx.Game.announce(string.format(EC.progress, player.DisplayName, n, EV.need, EV.need - n), EV.id == "holiday" and "#3FA35B" or "#E8761E")
	end
	if ctx.Event and ctx.Event.refreshTable then
		ctx.Event.refreshTable()
	end
end

-- Dishes on the potluck table right now (for the banner's live count).
function EggService.potluckCount(now: number, window: number): number
	return Holiday.recentShares(potluckShares, now, window)
end

handlers["event:potluck"] = function(player, data)
	local EV, EC = ctx.Game.potluckEvent()
	local d = today()
	local sharedOn = -1
	if EV and type(data.daily[EV.dailyKey]) == "number" then
		sharedOn = data.daily[EV.dailyKey]
	end
	local outcome = Holiday.tryShare({
		active = EV ~= nil,
		day = d,
		sharedOn = sharedOn,
		cooler = data.cooler,
		meatId = if EV then EV.meat else "",
		ownsReward = if EV then data.owned[EV.reward] == true else false,
		price = if EV then Config.Meats[EV.meat].price else 0,
		shareMult = if EV then EV.shareMult else 0,
		rankMult = Economy.rankMult(data.rank, Config.RANK_STEP),
		rarityIndex = function(id: string): number
			return Rarity.indexOf(Config.Rarities, id)
		end,
	})
	if not EV or not EC or not outcome.ok or not outcome.index then
		if outcome.reason == "already" and EC then
			dialog(player, EC.host, EC.already)
		elseif outcome.reason == "need" and EC then
			dialog(player, EC.host, EC.needDish)
		else
			dialog(player, "Granny Pecan", Content.PotluckTable.closed)
		end
		return
	end
	local plate = table.remove(data.cooler, outcome.index)
	data.daily[EV.dailyKey] = d
	local meat = Config.Meats[plate.m]
	local coins = outcome.coins
	ctx.Game.addCoins(player, data, coins, true)
	local label = Rarity.get(Config.Rarities, plate.r).name .. " " .. meat.name
	local thanks = EC.thanks[rng:NextInteger(1, #EC.thanks)]
	if ctx.Game.grantCosmetic(player, data, EV.reward) then
		data.titles[EV.title] = true
		dialog(player, EC.dialog, string.format(EC.firstShare, label, coins) .. "\n\n" .. thanks, coins)
	else
		dialog(player, EC.dialog, string.format(EC.share, label, coins) .. "\n\n" .. thanks, coins)
	end
	checkPotluck(player, EV, EC)
	ctx.World.refreshStations(player)
end

handlers["landmark:bell"] = function(player, data)
	local d = today()
	ctx.Game.fx(player, "bell", {})
	-- Every ring is worth Season XP, so a ring only counts once per ringCooldown per player
	-- (otherwise mashing the prompt farms the whole Smokehouse Pass). Ringing itself stays free.
	if Hype.ringCounts(lastRing, player.UserId, os.clock(), Config.DinnerBell.ringCooldown) then
		data.stats.bells += 1
		ctx.Game.checkRookie(player, data)
		checkDinnerBell(player)
	end
	local line = BELL_LINES[rng:NextInteger(1, #BELL_LINES)]
	if data.daily.bellDay ~= d then
		data.daily.bellDay = d
		ctx.Game.addSauce(data, "burntend")
		if not data.titles["Dinner Bell Ringer"] then
			data.titles["Dinner Bell Ringer"] = true
			ctx.Game.toast(player, "New title: Dinner Bell Ringer", "good")
		end
		ctx.Game.markDirty(player)
		dialog(player, "Big Bertha", line .. "\n\nThe King of the Pit slides you a jar of Burnt-End Glaze. (+20% tips for 3 serves.) You get one jar a day.")
	else
		dialog(player, "Big Bertha", line .. "\n\n(You already got today's glaze. Ringing is still free.)")
	end
end

function EggService.init(c: any)
	ctx = c
end

function EggService.start()
	-- Prompts first. TextChatService setup must not be able to skip this connection:
	-- that was Unc Hank, the King, and every other server prompt going quiet.
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		local kind = prompt:GetAttribute("Kind")
		if typeof(kind) ~= "string" then
			return
		end
		local fn = handlers[kind]
		if not fn then
			return -- client-side kinds (ui:*, npc:unc)
		end
		local data = ctx.Game.dataOf(player)
		if not data or not ctx.Game.runtime[player] then
			return
		end
		ctx.Game.runtime[player].lastActive = os.clock()
		local ok, err = pcall(function(): any
			fn(player, data, prompt)
			return nil
		end)
		if not ok then
			warn("[EggService] " .. kind .. ": " .. tostring(err))
		end
		ctx.Game.markDirty(player)
	end)

	-- TextChatService is what live servers use. Player.Chatted still arrives in
	-- Studio and on older chat. The greet function ignores a second copy.
	-- Both are isolated: a chat API error must not unwind the prompt connection above.
	local function bindPlayer(plr: Player)
		local okChat, errChat = pcall(function(): nil
			plr.Chatted:Connect(function(message)
				EggService.onChat(plr, message)
			end)
			return nil
		end)
		if not okChat then
			warn("[EggService] Chatted: " .. tostring(errChat))
		end
	end
	Players.PlayerAdded:Connect(bindPlayer)
	for _, plr in ipairs(Players:GetPlayers()) do
		bindPlayer(plr)
	end
	task.spawn(function()
		local okChat, errChat = xpcall(function(): string?
			local TextChatService = game:GetService("TextChatService")
			local function bindChannel(channel: Instance)
				if not channel:IsA("TextChannel") or channel:GetAttribute("HowdyBound") then
					return
				end
				channel:SetAttribute("HowdyBound", true)
				channel.MessageReceived:Connect(function(message)
					local src = message.TextSource
					local speaker = src and Players:GetPlayerByUserId(src.UserId)
					if speaker then
						EggService.onChat(speaker, message.Text)
					end
				end)
			end
			local channels = TextChatService:FindFirstChild("TextChannels") or TextChatService:WaitForChild("TextChannels", 30)
			if not channels then
				return
			end
			for _, channel in ipairs(channels:GetChildren()) do
				bindChannel(channel)
			end
			channels.ChildAdded:Connect(bindChannel)
			return nil
		end, debug.traceback)
		if not okChat then
			warn("[EggService] TextChatService:\n" .. tostring(errChat))
		end
	end)

	-- Rex / meteorite / cooked eggs are detected from stats & state.
	task.spawn(function()
		while true do
			task.wait(3)
			for player in pairs(ctx.Game.runtime) do
				local data = ctx.Game.dataOf(player)
				if data then
					if (data.critters.rex or 0) > 0 then
						EggService.found(player, data, "rex")
					end
					for key in pairs(data.cutsIndex) do
						if string.find(key, ":meteorite", 1, true) then
							EggService.found(player, data, "meteorite")
							break
						end
					end
				end
			end
		end
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		tempPokes[p] = nil
		lastHowdy[p] = nil
		lastRing[p.UserId] = nil
	end)
end

return EggService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EventService — things that happen to the whole server:
	  * day/night cycle (a full day every 20 minutes),
	  * the co-op Mosquito Swarm at dusk with a Queen Skeeter boss,
	  * the Cook-Off (practice any day, 3x payouts + weekly leaderboard on Saturdays, Texas time),
	  * the monthly season theme on the Cook-Off banner,
	  * Suds Saturday & Sunday announcements,
	  * the Turkey Day Smokeout (Thanksgiving week) and Holiday Smokeout (Dec 19 - Jan 1): potluck
	    table decor + sign, login toast.
]]
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Rarity = require(Shared.Logic.Rarity)
local Economy = require(Shared.Logic.Economy)
local CookOff = require(Shared.Logic.CookOff)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Holiday = require(Shared.Logic.Holiday)
local Guide = require(Shared.Logic.Guide)
local WorldBuilder = require(Shared.WorldBuilder)

local EventService = {}
local ctx: any = nil
local rng = Random.new()

-- ===== Day / night =====
local DAY_SECONDS = Config.DAY_LENGTH_MINUTES * 60
local DUSK = 18.6

function EventService.isNight(): boolean
	local h = Lighting.ClockTime
	return h >= 19 or h < 6
end

local function dayNightLoop()
	local last = Lighting.ClockTime
	while true do
		local dt = task.wait(0.5)
		local h = (Lighting.ClockTime + dt * 24 / DAY_SECONDS) % 24
		Lighting.ClockTime = h
		if last < DUSK and h >= DUSK then
			task.spawn(EventService.startSwarm)
		end
		last = h
	end
end

-- ===== Mosquito swarm =====
local swarm: any = nil

local function rewardSwarm(won: boolean)
	if not swarm then
		return
	end
	for player, hits in pairs(swarm.hits) do
		local data = ctx.Game.dataOf(player)
		if data and player.Parent then
			data.stats.mosquitoes += swarm.kills[player] or 0
			if won and hits > 0 then
				local coins = Config.Mosquito.rewardPerPit * data.pitLevel * Economy.rankMult(data.rank, Config.RANK_STEP)
				ctx.Game.addCoins(player, data, coins, true)
				data.aura += Config.Mosquito.aura
				ctx.Game.toast(player, string.format("Swarm cleared! +%d coins, +%d aura. 🦟💥", math.floor(coins), Config.Mosquito.aura), "good")
			end
			ctx.Game.markDirty(player)
		end
	end
end

function EventService.startSwarm()
	if swarm or #Players:GetPlayers() == 0 then
		return
	end
	local map = ctx.World.map()
	local zone = map.Hub:FindFirstChild("MosquitoZone") :: BasePart
	local folder = Instance.new("Folder")
	folder.Name = "Swarm"
	folder.Parent = workspace
	local count = Config.Mosquito.baseCount + Config.Mosquito.perPlayer * #Players:GetPlayers()
	swarm = { folder = folder, bugs = {}, hits = {}, kills = {}, alive = 0, clicks = {} }
	ctx.Game.announce("🦟 Mosquito swarm at the hub! Swat 'em together (click / tap them)!", "#FF6B6B")
	local center = zone.Position
	local function addBug(queen: boolean)
		local angle = rng:NextNumber() * math.pi * 2
		local radius = queen and 18 or rng:NextNumber(10, 34)
		local height = queen and 16 or rng:NextNumber(6, 16)
		local m, body = WorldBuilder.mosquito(ctx.World.ENV, folder, CFrame.new(center), queen)
		local bug = { model = m, body = body, hp = queen and Config.Mosquito.queenHp + #Players:GetPlayers() * 5 or Config.Mosquito.hp, queen = queen, angle = angle, radius = radius, height = height, speed = (queen and 0.4 or 1) * rng:NextNumber(0.6, 1.2) }
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 80
		cd.Parent = body
		if queen then
			WorldBuilder.billboard(body, "HP", "👑 Queen Skeeter", 4, 200, "#FF6B6B", 220, 36)
		end
		cd.MouseClick:Connect(function(player)
			-- simple per-player click limiter (max ~8 swats/sec)
			local nowc = os.clock()
			local lastc = swarm and swarm.clicks[player] or 0
			if not swarm or nowc - lastc < 0.12 or bug.hp <= 0 then
				return
			end
			swarm.clicks[player] = nowc
			bug.hp -= 1
			swarm.hits[player] = (swarm.hits[player] or 0) + 1
			if queen then
				local hp = body:FindFirstChild("HP") :: BillboardGui?
				if hp then
					(hp:FindFirstChild("Text") :: TextLabel).Text = "👑 Queen Skeeter " .. string.rep("❤", math.max(0, math.ceil(bug.hp / 5)))
				end
			end
			if bug.hp <= 0 then
				swarm.kills[player] = (swarm.kills[player] or 0) + 1
				swarm.alive -= 1
				m:Destroy()
				ctx.Game.fx(player, "swat", { queen = queen })
				if queen then
					ctx.Game.announce(player.DisplayName .. " landed the final swat on the Queen Skeeter! 👑🦟", "#FF6B6B")
				end
				if swarm.alive <= 0 then
					EventService.endSwarm(true)
				end
			end
		end)
		table.insert(swarm.bugs, bug)
		swarm.alive += 1
	end
	for _ = 1, count do
		addBug(false)
	end
	addBug(true)
	local started = os.clock()
	local s = swarm
	task.spawn(function()
		while swarm == s and os.clock() - started < Config.Mosquito.duration do
			local dt = RunService.Heartbeat:Wait()
			for _, bug in ipairs(s.bugs) do
				if bug.model.Parent then
					bug.angle += dt * bug.speed
					local p = center + Vector3.new(math.cos(bug.angle) * bug.radius, bug.height + math.sin(os.clock() * 3 + bug.angle) * 1.5, math.sin(bug.angle) * bug.radius)
					local look = center + Vector3.new(math.cos(bug.angle + 0.2) * bug.radius, bug.height, math.sin(bug.angle + 0.2) * bug.radius)
					bug.model:PivotTo(CFrame.lookAt(p, look))
				end
			end
		end
		if swarm == s then
			EventService.endSwarm(false)
		end
	end)
end

function EventService.endSwarm(won: boolean)
	if not swarm then
		return
	end
	rewardSwarm(won)
	if not won then
		ctx.Game.announce("The mosquitoes flew off to bother the neighbors. They'll be back at dusk!", "#AAAAAA")
	end
	swarm.folder:Destroy()
	swarm = nil
end

-- ===== Cook-Off =====
local boardStore: any = nil
local nameCache: { [number]: string } = {}

local function weekKey(): string
	return "CookOff_W" .. TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

local function judgedPrice(meatId: string): number
	local meat = Config.Meats[meatId]
	if meat.premium or meatId == "firstbrisket" then
		return Config.Meats.brisket.price -- paid cuts never beat a regular brisket at the judges' table
	end
	return meat.price
end

local function bestEntry(data: any): (number?, number)
	local bestI, bestS = nil, -1
	for i, plate in ipairs(data.cooler) do
		local s = CookOff.score(Rarity.indexOf(Config.Rarities, plate.r), judgedPrice(plate.m), plate.f == "perfect")
		if s > bestS then
			bestI, bestS = i, s
		end
	end
	return bestI, bestS
end
EventService.bestEntry = bestEntry

function EventService.enterCookOff(player: Player)
	local data = ctx.Game.dataOf(player)
	local r = ctx.Game.runtime[player]
	if not data or not r then
		return
	end
	if os.clock() < r.cookoffReadyAt then
		ctx.Game.toast(player, string.format("The judges are still chewing. Try again in %ds.", math.ceil(r.cookoffReadyAt - os.clock())), "info")
		return
	end
	local i, score = bestEntry(data)
	if not i then
		ctx.Game.toast(player, "Bring a plate! Your best plate from the cooler gets judged.", "info")
		return
	end
	r.cookoffReadyAt = os.clock() + Config.CookOff.cooldown
	local plate = table.remove(data.cooler, i)
	local rating = CookOff.rating(Config.CookOff.ratings, score)
	local saturday = ctx.Game.isSaturday()
	local mult = (saturday and Config.CookOff.saturdayMult or 1) * Economy.rankMult(data.rank, Config.RANK_STEP)
	local coins = math.floor(rating.coins * mult)
	ctx.Game.addCoins(player, data, coins, true)
	data.aura += rating.aura
	data.stats.cookoffs += 1
	local lines = Content.GrannyLines[rating.id]
	local meat = Config.Meats[plate.m]
	ctx.Remotes.Push:FireClient(player, "dialog", {
		npc = "Granny Pecan",
		text = string.format("%s\n\nYour %s %s scored %d. Rating: %s!", lines[rng:NextInteger(1, #lines)], Rarity.get(Config.Rarities, plate.r).name, meat.name, score, rating.id),
		reward = coins,
		rating = rating.id,
	})
	if rating.id == "Cooked" then
		ctx.Game.awardBadge(player, "Cooked")
		ctx.Egg.found(player, data, "cooked")
		ctx.Game.announce(string.format("👏 %s COOKED at the Cook-Off! The cat is clapping.", player.DisplayName), "#FFC83C")
		EventService.clapCat()
	end
	if saturday then
		local wk = TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
		if data.cookoff.week ~= wk then
			data.cookoff.week = wk
			data.cookoff.best = 0
		end
		if score > data.cookoff.best then
			data.cookoff.best = score
			if boardStore then
				task.spawn(function()
					pcall(function()
						boardStore:SetAsync(tostring(player.UserId), score)
					end)
				end)
			end
		end
	end
	ctx.World.refreshStations(player)
	ctx.Game.markDirty(player)
end

function EventService.clapCat()
	local cat = ctx.World.map().Hub.CookOff:FindFirstChild("ClapCatJudge") :: Model?
	if not cat then
		return
	end
	local base = cat:GetPivot()
	task.spawn(function()
		for k = 1, 10 do
			cat:PivotTo(base * CFrame.new(0, (k % 2) * 0.5, 0))
			task.wait(0.15)
		end
		cat:PivotTo(base)
	end)
end

local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, n = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and n or ("Pitmaster " .. userId)
	return nameCache[userId]
end

-- Final results of a finished week (Sunday: this week, Monday-Friday: last week), cached per week:
-- a finished board never changes, so it's read once (and retried every few minutes if that failed).
local finalCache: { week: number, placings: { CookOff.Placing }?, at: number } = { week = -1, placings = nil, at = -math.huge }

local function readBoard(store: any, count: number): { CookOff.Placing }?
	if not store then
		return nil
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, count)
	end)
	if not ok or not pages then
		return nil
	end
	local okP, page = pcall(function()
		return pages:GetCurrentPage()
	end)
	return okP and CookOff.placings(page) or nil
end

local function finalPlacings(): ({ CookOff.Placing }?, number?)
	local offset = CookOff.finalWeekOffset(ctx.Game.weekday())
	if not offset then
		return nil, nil
	end
	local wk = TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS) + offset
	local stale = finalCache.week ~= wk or (finalCache.placings == nil and os.clock() - finalCache.at > 300)
	if stale then
		local store = nil
		local ok, st = pcall(function()
			return DataStoreService:GetOrderedDataStore("CookOff_W" .. wk)
		end)
		if ok then
			store = st
		end
		finalCache = { week = wk, placings = readBoard(store, 10), at = os.clock() }
	end
	return finalCache.placings, wk
end

-- Top 3 of a finished Cook-Off (ties included) earn the free Cook-Off Champ title. Told once per
-- week, when they join or are already in the server once the results are final.
function EventService.champCheck(player: Player)
	local data = ctx.Game.dataOf(player)
	if not data or not player.Parent then
		return
	end
	local placings, wk = finalPlacings()
	if not placings or not wk or data.cookoff.champWeek == wk then
		return
	end
	local place = CookOff.podiumPlace(placings, player.UserId)
	if not place then
		return
	end
	data.cookoff.champWeek = wk
	local B = Content.CookOffBoard
	local had = data.titles[B.title] == true
	data.titles[B.title] = true
	ctx.Game.toast(player, string.format(had and B.champAgain or B.champNote, CookOff.medal(place)), "good")
	ctx.Game.fx(player, "champ", { medal = CookOff.medal(place) })
	ctx.Game.markDirty(player)
end

local function refreshBoard()
	local map = ctx.World.map()
	local lb = map.Hub.CookOff:FindFirstChild("Leaderboard") :: BasePart
	local label = (lb:FindFirstChild("SignGui") :: SurfaceGui):FindFirstChild("BoardText") :: TextLabel
	local season = ctx.Game.currentSeason()
	local B = Content.CookOffBoard
	local mode = CookOff.boardMode(ctx.Game.weekday())
	local placings: { CookOff.Placing }
	if mode == "live" then
		placings = readBoard(boardStore, B.liveRows) or {}
	else
		placings = finalPlacings() or {}
	end
	local nextSat = CookOff.nextSaturday(TimeUtil.dayNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS))
	label.Text = CookOff.boardText(mode, season.name, placings, nameOf, Holiday.longLabel(nextSat), B)
	-- banner reskin by season
	local banner = map.Hub.CookOff:FindFirstChild("Banner") :: BasePart
	banner.Color = Color3.fromHex(season.color)
	local bt = (banner:FindFirstChild("SignGui") :: SurfaceGui):FindFirstChild("BannerText") :: TextLabel
	bt.Text = "🏆 " .. string.upper(season.name) .. (ctx.Game.isSaturday() and " - TODAY! 3x PRIZES" or " - SATURDAY") .. " 🏆"
	if mode ~= "live" then
		for _, player in ipairs(Players:GetPlayers()) do
			EventService.champCheck(player)
		end
	end
end

-- ===== Potluck events: Turkey Day Smokeout and Holiday Smokeout =====
-- The hub potluck table dresses up for whichever event is on (decor is built at runtime and
-- destroyed after), and the sign changes with it.
local potluckOn: string? = nil -- "turkeyday" | "holiday" | "" (none); nil = not set up yet

local function refreshTurkey()
	local EV = ctx.Game.potluckEvent()
	local id = EV and EV.id or ""
	local SOON, _, sw = ctx.Game.upcomingPotluck()
	local soonText: string? = nil
	if not EV and SOON and sw then
		local fmt = SOON.id == "turkeyday" and Content.Signs.turkeySoon or Content.Signs.holidaySoon
		local st = string.format(fmt, string.upper(Holiday.label(sw.startDay)))
		soonText = st
		id = "soon:" .. st
	end
	if id == potluckOn then
		return
	end
	local pot = ctx.World.map().Hub:FindFirstChild("Potluck")
	if not pot then
		return
	end
	potluckOn = id
	local sign = pot:FindFirstChild("Sign")
	local gui = sign and sign:FindFirstChild("SignGui")
	local label = gui and gui:FindFirstChild("Text") :: TextLabel?
	for _, name in ipairs({ "TurkeyDay", "HolidaySmokeout" }) do
		local decor = pot:FindFirstChild(name)
		if decor then
			decor:Destroy()
		end
	end
	local hub = pot.Parent
	local autumn = hub and hub:FindFirstChild("AutumnRanch")
	if autumn then
		autumn:Destroy()
	end
	local text = soonText or Content.Signs.potluck
	if id == "turkeyday" then
		WorldBuilder.turkeyDay(pot, Content)
		if hub then
			WorldBuilder.autumnRanch(hub)
		end
		text = Content.Signs.turkeyPotluck
	elseif id == "holiday" then
		WorldBuilder.holidaySmokeout(pot, Content)
		text = Content.Signs.holidayPotluck
	end
	if label then
		label.Text = text
	end
end
EventService.refreshTurkey = refreshTurkey

-- The banner's second line shows how full the table is, live, for the whole server:
-- "Bring a dish!" -> "Dishes on the table: 2/3" -> "Table's full! +25% tips for everyone".
local function refreshTable()
	local EV, EC = ctx.Game.potluckEvent()
	if not EV or not EC then
		return
	end
	local pot = ctx.World.map().Hub:FindFirstChild("Potluck")
	local decor = pot and pot:FindFirstChild(EV.id == "holiday" and "HolidaySmokeout" or "TurkeyDay")
	local banner = decor and decor:FindFirstChild("Banner")
	local gui = banner and banner:FindFirstChild("SignGui")
	local label = gui and gui:FindFirstChild("BannerText") :: TextLabel?
	if not label then
		return
	end
	local now = workspace:GetServerTimeNow()
	local n = ctx.Egg.potluckCount(now, EV.window)
	local line = Holiday.tableLine(n, EV.need, now < ctx.Game.potluckUntil, math.floor(EV.tipBonus * 100 + 0.5), {
		idle = EC.bannerIdle,
		count = Content.PotluckTable.count,
		full = Content.PotluckTable.full,
	})
	local text = EC.bannerTop .. "\n" .. line
	if label.Text ~= text then
		label.Text = text
	end
end
EventService.refreshTable = refreshTable

-- The event's one-line note: "It's Turkey Day Cookout week!" while it's on, or the calm
-- "Coming up: ... opens Mon, Nov 23" the week before. Sent when a player joins and again at
-- Texas midnight to players already in the server (so nobody misses the day it opens).
-- Returns false while the first-visit guide is on screen, so the note waits until that
-- card is done instead of covering it. Returns true once the note was shown, or when
-- there is nothing to say.
function EventService.eventNote(player: Player): boolean
	local data = ctx.Game.dataOf(player)
	if data and type(data.guide) == "table" and Guide.view(data.guide).active then
		return false
	end
	local _, EC = ctx.Game.potluckEvent()
	if EC then
		ctx.Game.toast(player, EC.login, "good")
		return true
	end
	local _, SC, sw = ctx.Game.upcomingPotluck()
	if SC and sw then
		ctx.Game.toast(player, string.format(SC.soon, Holiday.longLabel(sw.startDay)), "info")
	end
	return true
end

function EventService.init(c: any)
	ctx = c
end

function EventService.start()
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(weekKey())
	end)
	boardStore = ok and store or nil
	task.spawn(dayNightLoop)
	task.spawn(function()
		while true do
			local okT, errT = pcall(function(): any
				refreshTurkey()
				return nil
			end)
			if not okT then
				warn("[EventService] turkey day: " .. tostring(errT))
			end
			local okL, errL = pcall(function(): any
				refreshTable()
				return nil
			end)
			if not okL then
				warn("[EventService] potluck banner: " .. tostring(errL))
			end
			local okB, err = pcall(function(): any
				refreshBoard()
				return nil
			end)
			if not okB then
				warn("[EventService] board: " .. tostring(err))
			end
			task.wait(60)
			-- new week -> new board
			local ok2, st2 = pcall(function()
				return DataStoreService:GetOrderedDataStore(weekKey())
			end)
			if ok2 then
				boardStore = st2
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			pcall(refreshTable)
		end
	end)
	ctx.Data.onLoaded.Event:Connect(function(player: Player)
		task.delay(4, function()
			if not player.Parent then
				return
			end
			if ctx.Game.isSudsWeekend() then
				ctx.Game.toast(player, "🫧 Suds Saturday & Sunday! Muddy pups need a bath. Wash one for a free bandana.", "good")
			end
			if not EventService.eventNote(player) then
				local r = ctx.Game.runtime[player]
				if r then
					r.eventNoteDue = true
				end
			end
			task.spawn(EventService.champCheck, player)
			if ctx.Game.isSaturday() then
				ctx.Game.toast(player, "🏆 It's Cook-Off Saturday! Bring your best plate to Granny Pecan for 3x prizes.", "good")
			end
		end)
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GameService — the server-authoritative game loop.
	The client only ever *asks* ("start a cook in slot s2 with ribs"); every rule, timer,
	price, roll and reward is decided here. All requests come through one RemoteFunction,
	are rate-limited per player and per action, and are type-checked before use.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local BadgeService = game:GetService("BadgeService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Monetization = require(Shared.Monetization)
local CookLogic = require(Shared.Logic.CookLogic)
local Rarity = require(Shared.Logic.Rarity)
local Economy = require(Shared.Logic.Economy)
local Hype = require(Shared.Logic.Hype)
local Streak = require(Shared.Logic.Streak)
local PitmasterPath = require(Shared.Logic.PitmasterPath)
local Restock = require(Shared.Logic.Restock)
