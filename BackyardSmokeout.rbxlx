          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Config.luau — every piece of game balance and content lives here as plain data.
	Weekly updates should mostly be "add a row": a new meat, sauce, critter, cosmetic,
	Pitmaster Path step or season theme. No Roblox APIs are used in this file so the
	pure-logic unit tests (Lune) can load it too. Colors are hex strings.
]]

local Config = {}

Config.GAME_NAME = "Backyard Smokeout"
Config.TAGLINE = "Low and slow. Smoke it while you sleep."

-- Daily resets, streaks and the Saturday Cook-Off use Texas time (Central, fixed UTC-6).
Config.TIMEZONE_OFFSET_HOURS = -6

Config.MAX_PLOTS = 8 -- set the server size to 8 in Game Settings > Places
Config.START_COINS = 50
Config.COOLER_MAX = 40
Config.AUTOSAVE_SECONDS = 60
Config.RESTOCK_SECONDS = 300 -- sauce shop restocks every 5 minutes
Config.BURGER_BURN_GRACE = 15 -- seconds a finished burger can sit before it burns (only while you're online)
Config.PEEK_PENALTY_FRACTION = 0.10 -- "If you're lookin', you ain't cookin'"
Config.PEEK_PENALTY_MIN = 10
Config.PLAYTIME_NUDGE_MINUTES = 60
Config.CUSTOMER_SPOTS = 3
Config.CUSTOMER_SPAWN_SECONDS = 9
Config.CUSTOMER_PATIENCE = 120
Config.MATCH_ORDER_BONUS = 1.25
Config.NEW_REGULAR_REWARD = 50
Config.RESTING_IDLE_SECONDS = 120

-- Spatula flip (burgers): flip near the halfway mark. Fractions of total cook time.
Config.Flip = {
	target = 0.5,
	perfectWindow = 0.08, -- +-2.4s on a 30s burger
	goodWindow = 0.2,
	perfectMult = 1.5,
	goodMult = 1.15,
	missMult = 0.9,
	unflippedMult = 0.85,
	perfectAura = 1000, -- "+1000 Aura"
	comboStep = 0.1, -- each perfect in a row adds +10% tip (max +100%)
	comboMax = 10,
	lockedInAt = 3, -- "LOCKED IN" combo status
}

Config.Stations = { "grill", "smoker" }

export type Meat = {
	id: string,
	name: string,
	station: string,
	cookTime: number,
	cost: number,
	price: number,
	unlockPit: number,
	maxRarity: number,
	color: string,
	icon: string,
	premium: boolean?,
	season: string?,
	hidden: boolean?,
	size: { number },
}

Config.Meats = {
	burger = { id = "burger", name = "Backyard Burger", station = "grill", cookTime = 30, cost = 2, price = 12, unlockPit = 1, maxRarity = 3, color = "#8B4A2B", icon = "🍔", size = { 1.6, 0.5, 1.6 } },
	hotlink = { id = "hotlink", name = "Hot Link", station = "smoker", cookTime = 120, cost = 6, price = 30, unlockPit = 1, maxRarity = 5, color = "#9E2A2B", icon = "🌭", size = { 2.2, 0.5, 0.5 } },
	brisket = { id = "brisket", name = "Texas Brisket", station = "smoker", cookTime = 21600, cost = 300, price = 3600, unlockPit = 1, maxRarity = 5, color = "#3E2215", icon = "🥩", size = { 3, 1, 1.8 } },
	yardbird = { id = "yardbird", name = "Smoked Yardbird", station = "smoker", cookTime = 480, cost = 20, price = 110, unlockPit = 2, maxRarity = 5, color = "#C27C3A", icon = "🍗", size = { 1.6, 1, 1.4 } },
	ribs = { id = "ribs", name = "Roch & Roll Ribs", station = "smoker", cookTime = 1800, cost = 60, price = 420, unlockPit = 2, maxRarity = 5, color = "#7A2E1C", icon = "🍖", size = { 2.8, 0.5, 1.2 } },
	porkbutt = { id = "porkbutt", name = "Pork Butt", station = "smoker", cookTime = 7200, cost = 150, price = 1500, unlockPit = 3, maxRarity = 5, color = "#6B3A20", icon = "🐖", size = { 1.8, 1.4, 1.8 } },
	turkeyleg = { id = "turkeyleg", name = "Harvest Turkey Leg", station = "smoker", cookTime = 900, cost = 30, price = 260, unlockPit = 1, maxRarity = 5, color = "#A0522D", icon = "🦃", season = "harvest", size = { 1, 1, 2.2 } },
	wagyu = { id = "wagyu", name = "Wagyu Brisket", station = "smoker", cookTime = 14400, cost = 0, price = 7000, unlockPit = 1, maxRarity = 5, color = "#2B140B", icon = "🥩", premium = true, size = { 3.2, 1.1, 1.9 } },
	tomahawk = { id = "tomahawk", name = "Tomahawk Steak", station = "grill", cookTime = 300, cost = 0, price = 700, unlockPit = 1, maxRarity = 5, color = "#5A1E12", icon = "🪓", premium = true, size = { 3, 0.6, 1.4 } },
	firstbrisket = { id = "firstbrisket", name = "First Brisket", station = "smoker", cookTime = 75, cost = 0, price = 100, unlockPit = 1, maxRarity = 5, color = "#3E2215", icon = "🥩", hidden = true, size = { 3, 1, 1.8 } },
}

Config.MeatOrder = { "burger", "tomahawk", "hotlink", "yardbird", "turkeyleg", "ribs", "porkbutt", "brisket", "wagyu" }

-- Rarity of a finished cut. Rolled on the server when the cook starts. Odds are shown in the Index.
Config.Rarities = {
	{ id = "common", name = "Common", weight = 70, mult = 1, color = "#D6D0C6", flex = false },
	{ id = "juicy", name = "Juicy", weight = 22, mult = 1.5, color = "#5AD2FF", flex = false },
	{ id = "smokering", name = "Smoke Ring Gold", weight = 6, mult = 3, color = "#FFC83C", flex = true },
	{ id = "texas", name = "Texas-Size", weight = 1.8, mult = 6, color = "#FF5A36", flex = true },
	{ id = "meteorite", name = "Meteorite", weight = 0.2, mult = 12, color = "#9B5CFF", flex = true },
}

-- Pit levels upgrade every smoker and grill at once.
Config.PitLevels = {
	{ name = "Rusty Drum", speed = 1.0, luck = 1.0, cost = 0, color = "#6E4B3A" },
	{ name = "Rochin' the Smoker", speed = 1.25, luck = 1.1, cost = 500, color = "#3B3B3B" },
	{ name = "Big Pit", speed = 1.5, luck = 1.25, cost = 3000, color = "#2A2A2A" },
	{ name = "Pitmaster Rig", speed = 1.85, luck = 1.4, cost = 15000, color = "#1C2A3A" },
	{ name = "Golden Smokehouse", speed = 2.25, luck = 1.6, cost = 75000, color = "#D4A017" },
}

Config.Slots = {
	smoker = { base = 2, costs = { 400, 2500, 12000 }, passBonus = 2 },
	grill = { base = 2, costs = { 300, 2000 }, passBonus = 0 },
}
Config.MAX_SMOKERS = 7
Config.MAX_GRILLS = 4

-- Unc Status rebirths. `need` = coins earned this run to rebirth INTO this rank.
Config.Ranks = {
	{ name = "Lil Griller", need = 0 },
	{ name = "Big Bro", need = 100000 },
	{ name = "Unc", need = 400000, unlock = "feet_socksandals" },
	{ name = "Great Unc", need = 1500000 },
	{ name = "OG Pitmaster", need = 5000000 },
}
Config.RANK_STEP = 0.5 -- +50% income per rank, forever

-- Sauces: bought with coins (never Robux), each gives a few charges of an effect.
Config.Sauces = {
	sweetheat = { id = "sweetheat", name = "Sweet Heat", effect = "luck", amount = 0.15, charges = 3, price = 150, weight = 40, maxStock = 3, color = "#D2462E" },
	rochetfuel = { id = "rochetfuel", name = "Rochet Fuel Hot Sauce", effect = "speed", amount = 0.25, charges = 3, price = 200, weight = 30, maxStock = 3, color = "#FF5A00" },
	carolinagold = { id = "carolinagold", name = "Carolina Gold Mustard", effect = "tip", amount = 0.25, charges = 5, price = 120, weight = 30, maxStock = 3, color = "#E8B923" },
	peachfuzz = { id = "peachfuzz", name = "Peach Fuzz Glaze", effect = "tip", amount = 0.5, charges = 5, price = 600, weight = 10, maxStock = 2, color = "#FFA07A" },
	hillcountry = { id = "hillcountry", name = "Hill Country Mop", effect = "luck", amount = 0.35, charges = 3, price = 900, weight = 8, maxStock = 1, color = "#5B3A1E" },
	secretcreek = { id = "secretcreek", name = "Secret Creek Sauce", effect = "luck", amount = 0.5, charges = 5, price = 0, weight = 0, maxStock = 0, color = "#3FA7D6", hidden = true },
	burntend = { id = "burntend", name = "Burnt-End Glaze", effect = "tip", amount = 0.2, charges = 3, price = 0, weight = 0, maxStock = 0, color = "#E6B25A", hidden = true },
	straitshootin = { id = "straitshootin", name = "Strait-Shootin' Sauce", effect = "speed", amount = 0.3, charges = 3, price = 0, weight = 0, maxStock = 0, color = "#C19A6B", hidden = true },
}
Config.SauceOrder = { "sweetheat", "rochetfuel", "carolinagold", "peachfuzz", "hillcountry" }
Config.RESTOCK_SLOTS = 3

-- Daily login (7-day cycle). One free missed day per week; a longer break only drops you
-- back to the start of your current week, never to zero.
Config.DailyRewards = {
	{ coins = 100 },
	{ coins = 150 },
	{ coins = 200, sauce = "sweetheat" },
	{ coins = 300 },
	{ coins = 400, sauce = "rochetfuel" },
	{ coins = 600 },
	{ coins = 1000, sauce = "hillcountry", boostMinutes = 15 },
}

-- 28-day Pitmaster Path. Step N unlocks on your Nth play day; goals are lifetime stats.
Config.PathSteps = ({
	{ stat = "served", amount = 3, reward = { coins = 200 }, label = "Serve 3 plates" },
	{ stat = "perfectFlips", amount = 3, reward = { sauce = "sweetheat" }, label = "Land 3 perfect spatula flips" },
	{ stat = "smoked", amount = 3, reward = { cosmetic = "hat_straw" }, label = "Smoke 3 meats" },
	{ stat = "critters", amount = 3, reward = { coins = 500 }, label = "Meet 3 different regulars" },
	{ stat = "sauces", amount = 2, reward = { boostMinutes = 15 }, label = "Buy 2 sauces" },
	{ stat = "upgrades", amount = 1, reward = { coins = 800 }, label = "Upgrade your pit once" },
	{ stat = "rares", amount = 2, reward = { wagyu = 1, title = "Week 1 Pitmaster" }, label = "Cook 2 rare cuts" },
	{ stat = "served", amount = 60, reward = { coins = 1200 }, label = "Serve 60 plates" },
	{ stat = "cookoffs", amount = 1, reward = { sauce = "hillcountry" }, label = "Enter a Cook-Off" },
	{ stat = "critters", amount = 5, reward = { rex = true }, label = "Meet 5 regulars (someone special is coming...)" },
	{ stat = "perfectFlips", amount = 25, reward = { cosmetic = "trail_smokepuff" }, label = "Land 25 perfect flips" },
	{ stat = "smoked", amount = 25, reward = { coins = 2000 }, label = "Smoke 25 meats" },
	{ stat = "mosquitoes", amount = 10, reward = { boostMinutes = 30 }, label = "Swat 10 mosquitoes" },
	{ stat = "rares", amount = 6, reward = { cosmetic = "tool_goldtongs", title = "Two-Week Pitmaster" }, label = "Cook 6 rare cuts" },
	{ stat = "served", amount = 150, reward = { coins = 3000 }, label = "Serve 150 plates" },
	{ stat = "sauces", amount = 8, reward = { sauce = "peachfuzz" }, label = "Buy 8 sauces" },
	{ stat = "cookoffs", amount = 3, reward = { coins = 3500 }, label = "Enter 3 Cook-Offs" },
	{ stat = "critters", amount = 7, reward = { cosmetic = "smoke_hickory" }, label = "Meet 7 regulars" },
	{ stat = "upgrades", amount = 3, reward = { wagyu = 2 }, label = "Upgrade 3 times" },
	{ stat = "perfectFlips", amount = 60, reward = { coins = 4000 }, label = "Land 60 perfect flips" },
	{ stat = "rares", amount = 12, reward = { cosmetic = "smoke_sunset", title = "Three-Week Pitmaster" }, label = "Cook 12 rare cuts" },
	{ stat = "served", amount = 300, reward = { coins = 6000 }, label = "Serve 300 plates" },
	{ stat = "smoked", amount = 80, reward = { boostMinutes = 60 }, label = "Smoke 80 meats" },
	{ stat = "mosquitoes", amount = 40, reward = { coins = 7000 }, label = "Swat 40 mosquitoes" },
	{ stat = "cookoffs", amount = 6, reward = { cosmetic = "apron_pathfinder" }, label = "Enter 6 Cook-Offs" },
	{ stat = "critters", amount = 9, reward = { coins = 9000 }, label = "Meet 9 regulars" },
	{ stat = "rares", amount = 20, reward = { wagyu = 3 }, label = "Cook 20 rare cuts" },
	{ stat = "served", amount = 500, reward = { tomahawk = true, cosmetic = "skin_pathgold", title = "Pitmaster" }, label = "Serve 500 plates" },
} :: { any })

-- Critter customers = the Regulars Index. All original characters.
Config.Critters = {
	{ id = "armadillo", name = "Dilly the Armadillo", weight = 20, tip = 1.0, body = "#9C8A7A", head = "#8A7868", scale = 1.0, ears = false },
	{ id = "roadrunner", name = "Zoom the Roadrunner", weight = 18, tip = 1.0, body = "#6B5B4B", head = "#3A6EA5", scale = 0.9, ears = false },
	{ id = "raccoon", name = "Bandit the Raccoon", weight = 16, tip = 1.1, body = "#7D7D7D", head = "#505050", scale = 1.0, ears = true },
	{ id = "possum", name = "Possum Pete", weight = 14, tip = 1.1, body = "#BEBEBE", head = "#F0E6E6", scale = 0.95, ears = true },
	{ id = "hornedtoad", name = "Spike the Horned Lizard", weight = 10, tip = 1.2, body = "#C2A36B", head = "#B08F55", scale = 0.7, ears = false },
	{ id = "longhorn", name = "Lil Longhorn", weight = 8, tip = 1.3, body = "#C46A2F", head = "#E0B080", scale = 1.3, ears = true, horns = true },
	{ id = "hummingbird", name = "Buzz the Hummingbird", weight = 7, tip = 1.3, body = "#2E8B57", head = "#C2185B", scale = 0.6, ears = false },
	{ id = "bellyrubpup", name = "Belly Rub Pup", weight = 6, tip = 1.5, body = "#E8D3B9", head = "#E8D3B9", scale = 0.9, ears = true, bellyRub = true },
	{ id = "clapcat", name = "Clapping Cat", weight = 5, tip = 1.4, body = "#151515", head = "#1E1E1E", scale = 0.85, ears = true },
	{ id = "rex", name = "Rex", weight = 0.8, tip = 3.0, body = "#6CC24A", head = "#7BD35A", scale = 1.2, ears = false, rex = true, ribbon = "RAWR means I love you ♥" },
}

-- Cosmetics. `source`: "robux" (developer product), "path", "egg", "rank", "suds", "pass", "rotation" (limited-time Robux).
Config.Cosmetics = {
	hat_pitmaster = { name = "Pitmaster Cowboy Hat", slot = "hat", source = "robux", color = "#3B2A1A" },
	hat_straw = { name = "Straw Cowboy Hat", slot = "hat", source = "path", color = "#E3C77A" },
	hat_turkey = { name = "Gobble Hat", slot = "hat", source = "rotation", color = "#8B5A2B" },
	apron_grillmaster = { name = "Grill Master Apron", slot = "apron", source = "robux", color = "#B22222", text = "GRILL MASTER" },
	apron_okayestunc = { name = "World's Okayest Unc Apron", slot = "apron", source = "egg", color = "#4A6FA5", text = "WORLD'S OKAYEST UNC" },
	apron_pathfinder = { name = "Pit Path Apron", slot = "apron", source = "path", color = "#2F4F2F", text = "28 DAYS LOW & SLOW" },
	apron_harvest = { name = "Harvest Plaid Apron", slot = "apron", source = "rotation", color = "#A0522D", text = "GIVE THANKS" },
	tool_goldenspatula = { name = "Golden Spatula", slot = "tool", source = "robux", color = "#FFD700" },
	tool_goldtongs = { name = "Golden Tongs", slot = "tool", source = "path", color = "#E6BE8A" },
	skin_candyred = { name = "Candy Apple Smoker", slot = "skin", source = "robux", color = "#C1121F" },
	skin_galaxy = { name = "Galaxy Smoker", slot = "skin", source = "robux", color = "#3A0CA3", neon = true },
	skin_golden = { name = "Solid Gold Smoker", slot = "skin", source = "robux", color = "#FFD700", gold = true },
	skin_pathgold = { name = "Pitmaster Bronze Smoker", slot = "skin", source = "path", color = "#CD7F32" },
	skin_snowy = { name = "Snowy Smoker", slot = "skin", source = "rotation", color = "#E8F4FF" },
	smoke_grape = { name = "Grape Soda Smoke", slot = "smoke", source = "robux", color = "#8E44AD" },
	smoke_bluebonnet = { name = "Bluebonnet Smoke", slot = "smoke", source = "robux", color = "#3B6FD8" },
	smoke_sherbet = { name = "Rainbow Sherbet Smoke", slot = "smoke", source = "robux", color = "#FF8FAB", rainbow = true },
	smoke_hickory = { name = "Hickory Gold Smoke", slot = "smoke", source = "path", color = "#D4A35A" },
	smoke_sunset = { name = "Sunset Smoke", slot = "smoke", source = "path", color = "#FF7F50" },
	smoke_pumpkin = { name = "Pumpkin Patch Smoke", slot = "smoke", source = "rotation", color = "#FF7518" },
	trail_sparkler = { name = "Sparkler Trail", slot = "trail", source = "robux", color = "#FFF3B0" },
	trail_sauce = { name = "BBQ Sauce Drip Trail", slot = "trail", source = "robux", color = "#7B1E10" },
	trail_petals = { name = "Bluebonnet Petal Trail", slot = "trail", source = "robux", color = "#4169E1" },
	trail_smokepuff = { name = "Smoke Puff Trail", slot = "trail", source = "path", color = "#BBBBBB" },
	trail_firework = { name = "Firework Trail", slot = "trail", source = "rotation", color = "#FF2E63" },
	feet_socksandals = { name = "Socks & Sandals", slot = "feet", source = "rank", color = "#FFFFFF" },
	bandana_red = { name = "Red Bandana", slot = "neck", source = "suds", color = "#C0392B" },
	bandana_blue = { name = "Blue Bandana", slot = "neck", source = "suds", color = "#2E86C1" },
	bandana_paws = { name = "Paw Print Bandana", slot = "neck", source = "suds", color = "#F5B7B1" },
	bandana_gold = { name = "Golden Bandana", slot = "neck", source = "suds", color = "#F1C40F" },
	vip_lights = { name = "VIP Patio Lights", slot = "patio", source = "pass", color = "#FFE9A8" },
}
Config.CosmeticSlots = { "hat", "apron", "tool", "neck", "feet", "trail", "skin", "smoke", "patio" }

-- Suds Saturday & Sunday: wash a muddy pup for a free bandana. Odds shown in game.
Config.Bandanas = {
	{ id = "bandana_red", weight = 50 },
	{ id = "bandana_blue", weight = 30 },
	{ id = "bandana_paws", weight = 15 },
	{ id = "bandana_gold", weight = 5 },
}
Config.SUDS_PUP_CHANCE = 0.35

-- Limited-time cosmetics rotate weekly (2 at a time) and always come back in a later rotation.
Config.RotationPool = { "Rot_ApronHarvest", "Rot_SkinSnowy", "Rot_SmokePumpkin", "Rot_TrailFirework", "Rot_HatTurkey" }
Config.ROTATION_FEATURED = 2

-- Saturday Cook-Off. Judges rate W / Mid / L / Cooked (Cooked is the best: it's BBQ).
Config.CookOff = {
	ratings = {
		{ id = "L", min = 0, coins = 50, aura = 0, line = "Bless your heart, sugar." },
		{ id = "Mid", min = 35, coins = 150, aura = 100, line = "It's... food. Mid." },
		{ id = "W", min = 55, coins = 400, aura = 300, line = "Now THAT's a W plate!" },
		{ id = "Cooked", min = 75, coins = 1200, aura = 1000, line = "You COOKED. The cat is clapping." },
	},
	saturdayMult = 3, -- practice rounds on other days pay 1x; Saturdays pay 3x + leaderboard
	cooldown = 60,
}

-- Mosquito swarm at dusk (co-op).
Config.Mosquito = { baseCount = 6, perPlayer = 2, hp = 2, queenHp = 25, duration = 90, rewardPerPit = 120, aura = 250 }
Config.DAY_LENGTH_MINUTES = 20

-- Plate snagging ("you got taxed"). Only from ONLINE players, never rare cuts, with lock timers.
Config.Snag = {
	cooldown = 120, -- per snagger
	victimLock = 180, -- victim's pass window is locked after a snag
	newPlayerShield = 300, -- first 5 minutes of a session are protected
	insurance = 0.25, -- victim gets 25% of the plate value back right away
	catchWindow = 15, -- tag the snagger within 15s to get it back (+ bonus)
	catchDistance = 7,
	catchBonus = 50,
	maxRarityIndex = 2, -- only Common and Juicy plates can be snagged
}

Config.Crew = { perFriend = 0.10, maxFriends = 3 }

-- Fair Play: paid perks are capped so they never wall off free players.
--   * the tip pass is +50% (not x2) and never applies to the Cook-Off or snagging
--   * buying a speed boost gives everyone else in the server a free "Smoke Shower"
--   * snagging is opt-in: new players start in Peace Mode
Config.FairPlay = { passTipMult = 1.5, passTipCap = 1.5, showerMinutes = 5, showerMult = 1.25 }

-- Big Bertha's Dinner Bell: 3 different players ring the bell within 20 s, and the whole server
-- gets +25% tips for 5 minutes (free, with a 10 minute cooldown).
Config.DinnerBell = { window = 20, need = 3, cooldown = 600, minutes = 5, tipBonus = 0.25 }

-- Lunch Rush: every 150 s window, serve 4 plates for +50% of what those plates earned.
Config.Rush = { period = 150, need = 4, bonusFrac = 0.5 }

-- Season themes: the Cook-Off template reskins by month.
Config.Seasons = {
	{ months = { 10 }, id = "spooky", name = "Spooky Smoke-Off", color = "#FF7518" },
	{ months = { 11 }, id = "harvest", name = "Harvest Smoke-Off", color = "#C46A2F" },
	{ months = { 12, 1 }, id = "holiday", name = "Holiday Ham Jam", color = "#C0392B" },
	{ months = { 2, 3, 4, 5 }, id = "bluebonnet", name = "Bluebonnet Bash", color = "#3B6FD8" },
	{ months = { 6, 7, 8, 9 }, id = "summer", name = "Summer Sizzle", color = "#F4D03F" },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Content</string>
          <string name="Source"><![CDATA[--!strict
-- Content.luau — all jokes, NPC lines and swappable slang in one place.
-- Slang ages fast: swap words here without touching game code. All text is original.
local Content = {}

-- "Hi Hungry, I'm Unc" — one dad joke per day (index = day number % count).
Content.UncJokes = {
	"Why did the brisket go to school? To get a little more well-done.",
	"I told my smoker a joke. It didn't laugh, but it did get a little warmer.",
	"What do you call a sleeping cow? A bulldozer. Now go flip that burger.",
	"I'm reading a book about anti-gravity. Can't put it down. Kinda like this rib.",
	"Why don't eggs tell jokes at cookouts? They'd crack each other up.",
	"What did the hot sauce say to the burger? 'You're lookin' sharp, bun.'",
	"I used to hate facial hair. Then it grew on me. Like this smoke smell.",
	"What's a pitmaster's favorite music? Anything with a good brisket beat.",
	"How do you make a tissue dance? Put a little boogie in it. Not in the sauce.",
	"Why did the pickle go to the doctor? It was feeling kinda dill.",
	"What kind of shoes do hot dogs wear? Buns-lippers. ...I'll see myself out.",
	"I asked the smoker how it was doing. It said 'low and slow, unc.'",
	"Why was the corn so popular? Everyone was all ears.",
	"What do you call cheese that isn't yours? Nacho cheese. What do you call brisket that isn't yours? Getting taxed.",
	"Why did the cowboy adopt a dachshund? He wanted to get a long little doggie.",
	"What did the grill say to the steak? 'You're so hot right now.'",
	"Why don't skeletons fight at barbecues? They don't have the guts.",
	"How does a BBQ say goodbye? 'Brisket later!'",
	"I'm on a seafood diet. I see food, and I smoke it.",
	"What do you call a fake noodle? An impasta. Not on my pit.",
	"Why did the sauce bottle blush? It saw the salad dressing.",
	"Did you hear about the restaurant on the moon? Great food, no atmosphere.",
	"What did the ribs say after the joke? 'That's a rib-tickler.'",
	"Why did the burger join the gym? To work on its buns.",
	"What's brown and sticky? A stick. ...and also my sauce.",
	"Why did the scarecrow win an award? He was outstanding in his field. Like your pit.",
	"I only know 25 letters of the alphabet. I don't know Y. But I know BBQ.",
	"What do you call a pig that does karate? A pork chop.",
	"Why are spiders great at cookouts? They know their way around the web of sauce.",
	"Back in my day we didn't have smoke signals. We had... well, actually we had smoke signals.",
}

Content.UncYap = {
	"Now let me tell you about the summer of '98, the year the grill caught...",
	"Back in my day, a brisket took TWELVE hours and we liked it...",
	"You know what your problem is? You don't wait for the bark. The bark is everything...",
}

-- The King of the Pit hums ORIGINAL tunes (no real songs, lyrics, or likenesses).
Content.KingLines = {
	"♪ Hmm-hmm, low and slow, let that hickory go... ♪",
	"♪ Got a cooler full of brisket and a sky full of smoke... ♪",
	"♪ Dum-da-dum, the pit don't lie, the pit don't lie... ♪",
	"♪ Mesquite moon over the backyard tonight... ♪",
	"Howdy, partner. A pit's like a promise: you keep it lit.",
}

-- Temp the talking thermometer. A little too helpful. Creepier at night (still kid-friendly).
Content.TempDay = {
	"Hi! I'm Temp! I measure things! Your brisket is doing GREAT!",
	"Fun fact: I'm always watching the internal temperature. Always.",
	"Need help? I love helping! Helping is my favorite thing!",
}
Content.TempNight = {
	"I see your brisket... I always see your brisket.",
	"It's dark out. I'm still measuring. Don't worry about what.",
	"Why are you awake? ...Me? I don't sleep. I'm a thermometer.",
	"The mosquitoes told me things. Terrible things. About ketchup.",
}

-- Granny Pecan, head Cook-Off judge.
Content.GrannyLines = {
	L = { "Bless your heart, sugar.", "Well... you tried, and that's what counts. Bless your heart." },
	Mid = { "It's mid, baby. Fine, but mid.", "I've had worse. At a gas station." },
	W = { "Now THAT is a W plate!", "Mm-hmm! Granny approves!" },
	Cooked = { "Child, you COOKED. Somebody call the newspaper!", "You cooked so hard the cat's clapping!" },
}

Content.PitmasterScold = {
	"If you're lookin', you ain't cookin'!",
	"Close that lid! Every peek costs you time!",
	"The smoke ring can't form if you keep peekin'!",
}

-- Swappable slang (edit freely as memes age).
Content.Slang = {
	perfectFlip = "+1000 AURA",
	lockedIn = "LOCKED IN 🔒",
	burnt = "Skill issue... 🤿 (everybody's doing the scuba wave)",
	crine = "😭 crine",
	snagged = "You got taxed!",
	snagger = "TAXED! Run before they tag you!",
	resting = "💤 Unc is resting his eyes",
	unclocked = "Unc Status unlocked. Socks and sandals are now legal.",
	quietCreek = "Shhh... quiet on the creek.",
	skipYap = "Skip the yap",
	sixSeven = "6-7! 🤷 (that tip ended in 67)",
	rush = "🍽️ LUNCH RUSH CLEARED!",
	dinnerBell = "🔔 DINNER'S ON! 🔔",
}

Content.Signs = {
	hub = "ROCHIN' RANCH RD.",
	shop = "ROCH & ROLL SAUCE SHACK",
	cookoff = "SATURDAY COOK-OFF",
	potluck = "SUNDAY POTLUCK",
	creek = "(nothing to see here)",
	welcome = "BACKYARD SMOKEOUT",
	bertha = "BIG BERTHA\nThe King of the Pit's 1,000-gallon smoker · Ring the bell when supper's on",
}

return Content
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DefaultData</string>
          <string name="Source"><![CDATA[--!strict
-- The shape of a saved player. Add new fields here; old saves get them automatically (Reconcile).
local Config = require(script.Parent.Config)

return {
	schema = 1,
	coins = Config.START_COINS,
	runCoins = 0,
	lifetimeCoins = 0,
	aura = 0,
	rank = 1,
	pitLevel = 1,
	smokerSlotsBought = 0,
	grillSlotsBought = 0,
	stations = {}, -- "s1".."s7", "g1".."g4" -> Cook
	cooler = {}, -- { m = meatId, r = rarityId, f = flip? }
	sauces = {
		luck = { amount = 0, charges = 0 },
		speed = { amount = 0, charges = 0 },
		tip = { amount = 0, charges = 0 },
	},
	boost = { mult = 1, untilT = 0 },
	cuts = { wagyu = 0, tomahawk = 0 },
	unlocks = { tomahawk = false },
	owned = {},
	equipped = {},
	titles = {},
	title = "",
	critters = {},
	cutsIndex = {},
	eggs = {},
	stats = {
		served = 0,
		smoked = 0,
		cooks = 0,
		rares = 0,
		perfectFlips = 0,
		critters = 0,
		cookoffs = 0,
		upgrades = 0,
		mosquitoes = 0,
		sauces = 0,
		burnt = 0,
		snags = 0,
	},
	streak = { lastDay = -1, count = 0, best = 0, freeMissWeek = -1 },
	path = { claimed = 0, playDays = 0, lastPlayDay = -1 },
	daily = { jokeDay = -1, creekDay = -1, kingDone = false, bellDay = -1 },
	restock = { window = -1, bought = {} },
	cookoff = { week = -1, best = 0 },
	settings = { peace = true }, -- snagging is opt-in (Fair Play)
	tutorial = { firstBrisket = false, done = false },
	forceCritter = "",
	combo = 0,
	receipts = {},
	lastSeen = 0,
	playSeconds = 0,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">CookLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CookLogic — real-time cook timers with offline progress.
	A cook stores how many "cook-seconds" of progress it has and when it was last advanced.
	Advancing is piecewise: boosted time (until boostUntil) runs at baseRate * boostMult,
	the rest at baseRate. Because boosts are stored as an absolute expiry time, this works
	identically for online ticks and for a single big jump when a player returns after hours.
]]
local CookLogic = {}

export type Cook = {
	meat: string,
	rarity: string,
	progress: number,
	duration: number,
	last: number,
	startedAt: number,
	rateMult: number, -- from sauces applied at start (1 = none)
	peeks: number,
	revealed: boolean,
	doneAt: number?,
	flip: string?, -- nil | "perfect" | "good" | "miss"
	burnt: boolean?,
}

function CookLogic.new(meat: string, rarity: string, duration: number, now: number, rateMult: number?): Cook
	return {
		meat = meat,
		rarity = rarity,
		progress = 0,
		duration = math.max(1, duration),
		last = now,
		startedAt = now,
		rateMult = rateMult or 1,
		peeks = 0,
		revealed = false,
		doneAt = nil,
		flip = nil,
		burnt = nil,
	}
end

-- Effective rate (cook-seconds per real second) without boosts.
function CookLogic.rate(cook: Cook, pitSpeed: number): number
	return pitSpeed * (cook.rateMult or 1)
end

function CookLogic.advance(cook: Cook, now: number, rate: number, boostMult: number, boostUntil: number): Cook
	if now <= cook.last then
		return cook
	end
	local t0 = cook.last
	local boosted = 0
	if boostUntil > t0 and boostMult > 1 then
		boosted = math.min(now, boostUntil) - t0
	end
	local normal = (now - t0) - boosted
	local before = cook.progress
	cook.progress = math.min(cook.duration, cook.progress + boosted * rate * boostMult + normal * rate)
	cook.last = now
	if cook.progress >= cook.duration and before < cook.duration and cook.doneAt == nil then
		-- Find the exact real time it finished (for burn timers), walking the two segments.
		local need = cook.duration - before
		local boostedGain = boosted * rate * boostMult
		local finishAt
		if need <= boostedGain and boosted > 0 then
			finishAt = t0 + need / (rate * boostMult)
		else
			finishAt = t0 + boosted + (need - boostedGain) / rate
		end
		cook.doneAt = finishAt
	end
	return cook
end

function CookLogic.isDone(cook: Cook): boolean
	return cook.progress >= cook.duration - 1e-6
end

function CookLogic.fraction(cook: Cook): number
	return math.clamp(cook.progress / cook.duration, 0, 1)
end

-- Wall-clock seconds until done from `now` (assumes cook already advanced to now).
function CookLogic.remaining(cook: Cook, now: number, rate: number, boostMult: number, boostUntil: number): number
	local left = cook.duration - cook.progress
	if left <= 0 then
		return 0
	end
	if boostUntil > now and boostMult > 1 then
		local boostWindow = boostUntil - now
		local boostedCapacity = boostWindow * rate * boostMult
		if left <= boostedCapacity then
			return left / (rate * boostMult)
		end
		return boostWindow + (left - boostedCapacity) / rate
	end
	return left / rate
end

-- "If you're lookin', you ain't cookin'": peeking reveals the rarity but costs progress.
function CookLogic.peek(cook: Cook, penaltyFraction: number, minPenalty: number): number
	local penalty = math.max(minPenalty, cook.duration * penaltyFraction)
	penalty = math.min(penalty, cook.progress) -- never below zero
	cook.progress -= penalty
	cook.peeks += 1
	cook.revealed = true
	return penalty
end

function CookLogic.finishNow(cook: Cook, now: number)
	if cook.progress < cook.duration then
		cook.progress = cook.duration
		cook.doneAt = now
	end
	cook.last = now
end

-- Burgers burn if left too long after finishing. Only call while the owner is ONLINE,
-- so nobody ever loses food while away.
function CookLogic.shouldBurn(cook: Cook, now: number, grace: number): boolean
	return cook.doneAt ~= nil and not cook.burnt and (now - (cook.doneAt :: number)) > grace
end

-- Spatula flip judged on the server's clock against the cook fraction.
function CookLogic.judgeFlip(fraction: number, target: number, perfectWindow: number, goodWindow: number): string
	local d = math.abs(fraction - target)
	if d <= perfectWindow then
		return "perfect"
	elseif d <= goodWindow then
		return "good"
	end
	return "miss"
end

return CookLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">CookOff</string>
            <string name="Source"><![CDATA[--!strict
-- Cook-Off judging. Score 0..100 from rarity, cut value and a perfect flip. Paid perks don't count:
-- premium cuts are judged as if they were a regular brisket.
local CookOff = {}

function CookOff.score(rarityIndex: number, price: number, perfectFlip: boolean): number
	local valuePart = math.min(20, math.max(0, (math.log(math.max(price, 1)) / math.log(2)) * 2))
	local s = rarityIndex * 16 + valuePart + (perfectFlip and 5 or 0)
	return math.clamp(math.floor(s + 0.5), 0, 100)
end

function CookOff.rating(ratings: { any }, score: number): any
	local best = ratings[1]
	for _, r in ipairs(ratings) do
		if score >= r.min then
			best = r
		end
	end
	return best
end

function CookOff.isSaturday(weekday: number): boolean
	return weekday == 7
end

function CookOff.isSudsWeekend(weekday: number): boolean
	return weekday == 7 or weekday == 1
end

function CookOff.seasonFor(seasons: { any }, month: number): any
	for _, s in ipairs(seasons) do
		for _, m in ipairs(s.months) do
			if m == month then
				return s
			end
		end
	end
	return seasons[1]
end

-- Weekly limited-time rotation: which product keys are featured this week.
function CookOff.rotation(pool: { string }, featured: number, week: number): { string }
	local out = {}
	local n = #pool
	if n == 0 then
		return out
	end
	for i = 0, math.min(featured, n) - 1 do
		table.insert(out, pool[((week * featured + i) % n) + 1])
	end
	return out
end

return CookOff
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Economy math: plate values, upgrade costs, rebirth (Unc Status) rules. Pure functions.
local Economy = {}

function Economy.rankMult(rank: number, step: number): number
	return 1 + step * (math.max(1, rank) - 1)
end

function Economy.crewMult(friends: number, perFriend: number, maxFriends: number): number
	return 1 + perFriend * math.clamp(friends, 0, maxFriends)
end

export type ValueOpts = {
	rarityMult: number,
	rankMult: number?,
	crewMult: number?,
	tipMult: number?, -- critter tip
	sauceTip: number?, -- e.g. 0.25 for +25%
	flipMult: number?,
	comboMult: number?,
	doubleTips: boolean?,
	passTipMult: number?, -- Fair Play: the tip pass multiplier (default 1.5)
	orderBonus: number?,
}

function Economy.plateValue(price: number, o: ValueOpts): number
	local v = price
		* o.rarityMult
		* (o.rankMult or 1)
		* (o.crewMult or 1)
		* (o.tipMult or 1)
		* (1 + (o.sauceTip or 0))
		* (o.flipMult or 1)
		* (o.comboMult or 1)
		* (o.orderBonus or 1)
		* (o.doubleTips and (o.passTipMult or 1.5) or 1)
	return math.max(1, math.floor(v + 0.5))
end

-- Cost to reach pit level `level + 1`, or nil if maxed.
function Economy.nextPitCost(pitLevels: { any }, level: number): number?
	local nextDef = pitLevels[level + 1]
	return nextDef and nextDef.cost or nil
end

-- Slot purchases: `owned` = slots bought with coins so far (not counting base/pass).
function Economy.nextSlotCost(costs: { number }, owned: number): number?
	return costs[owned + 1]
end

function Economy.totalSlots(base: number, bought: number, passBonus: number, hasPass: boolean, cap: number): number
	return math.min(cap, base + bought + (hasPass and passBonus or 0))
end

function Economy.canRebirth(ranks: { any }, rank: number, runCoins: number): (boolean, number?)
	local nextRank = ranks[rank + 1]
	if not nextRank then
		return false, nil
	end
	return runCoins >= nextRank.need, nextRank.need
end

function Economy.rawCost(meat: any, rankMult: number): number
	-- Raw meat gets a bit pricier as you rank up so rebirths stay meaningful but not grindy.
	return math.floor(meat.cost * (1 + (rankMult - 1) * 0.5) + 0.5)
end

-- Rough coins-per-minute for a steady loop (used by balance tests and the README table).
function Economy.coinsPerMinute(meat: any, slots: number, speed: number, avgRarityMult: number, rankMult: number): number
	local cycleMinutes = (meat.cookTime / speed) / 60
	local profit = meat.price * avgRarityMult * rankMult - Economy.rawCost(meat, rankMult)
	return profit * slots / cycleMinutes
end

function Economy.averageRarityMult(rarities: { any }, luck: number, maxIndex: number?): number
	local total, acc = 0, 0
	for i, r in ipairs(rarities) do
		if maxIndex == nil or i <= maxIndex then
			local w = i == 1 and r.weight or r.weight * luck
			total += w
			acc += w * r.mult
		end
	end
	return acc / total
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Hype</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Hype.luau — pure logic for the social / clip moments (no Roblox APIs, unit-tested in Lune).

	  * pileOn:   Big Bertha's Dinner Bell. When `need` different players ring the bell within
	              `window` seconds, the whole server gets a short free tip bonus.
	  * rushStep: the Lunch Rush. Time is cut into fixed windows; serve `need` plates inside one
	              window for a bonus. Gives a 1-3 minute goal at every stage of the game.
	  * isSixSeven: a plate worth ...67 coins pops a "6-7!" (text only, no audio or likeness).
	  * passTip:  Fair Play cap for the tip pass.
]]
local Hype = {}

-- `rubs` maps userId -> last rub time. Returns how many distinct players rubbed inside the
-- window, and whether that reaches `need` (and the cooldown since `lastT` has passed).
function Hype.pileOn(rubs: { [number]: number }, now: number, window: number, need: number, lastT: number, cooldown: number): (number, boolean)
	local n = 0
	for id, t in pairs(rubs) do
		if now - t <= window then
			n += 1
		else
			rubs[id] = nil
		end
	end
	return n, n >= need and now - lastT >= cooldown
end

export type Rush = { w: number, n: number, sum: number, done: boolean }

function Hype.rushWindow(t: number, period: number): number
	return math.floor(t / period)
end

function Hype.rushEnds(w: number, period: number): number
	return (w + 1) * period
end

-- Record one served plate worth `value` at time `t`. Returns the (possibly new) rush state and
-- the bonus to pay right now (0 unless this plate cleared the rush).
function Hype.rushStep(state: Rush?, t: number, period: number, need: number, bonusFrac: number, value: number): (Rush, number)
	local w = Hype.rushWindow(t, period)
	local s: Rush = (state and state.w == w) and state or { w = w, n = 0, sum = 0, done = false }
	if s.done then
		return s, 0
	end
	s.n += 1
	s.sum += value
	if s.n >= need then
		s.done = true
		return s, math.max(1, math.floor(s.sum * bonusFrac + 0.5))
	end
	return s, 0
end

function Hype.isSixSeven(value: number): boolean
	return value >= 67 and value % 100 == 67
end

-- Fair Play: the tip pass is a flat multiplier, never more than `cap`.
function Hype.passTip(hasPass: boolean, mult: number, cap: number): number
	if not hasPass then
		return 1
	end
	return math.min(mult, cap)
end

return Hype
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">PitmasterPath</string>
            <string name="Source"><![CDATA[--!strict
-- 28-day Pitmaster Path: step N unlocks on your Nth distinct play day and is completed by a lifetime stat.
local PitmasterPath = {}

export type State = { claimed: number, playDays: number, lastPlayDay: number }

function PitmasterPath.new(): State
	return { claimed = 0, playDays = 0, lastPlayDay = -1 }
end

-- Call on login and on day rollover. Returns true if a new play day was counted.
function PitmasterPath.registerPlayDay(s: State, today: number): boolean
	if s.lastPlayDay == today then
		return false
	end
	s.lastPlayDay = today
	s.playDays += 1
	return true
end

export type Status = { step: number, done: boolean, unlocked: boolean, progress: number, amount: number, complete: boolean, finished: boolean }

function PitmasterPath.status(s: State, steps: { any }, stats: { [string]: number }): Status
	local step = s.claimed + 1
	local def = steps[step]
	if not def then
		return { step = step, done = false, unlocked = false, progress = 0, amount = 0, complete = false, finished = true }
	end
	local unlocked = s.playDays >= step
	local progress = stats[def.stat] or 0
	return {
		step = step,
		done = false,
		unlocked = unlocked,
		progress = math.min(progress, def.amount),
		amount = def.amount,
		complete = unlocked and progress >= def.amount,
		finished = false,
	}
end

function PitmasterPath.claim(s: State, steps: { any }, stats: { [string]: number }): (boolean, any?)
	local st = PitmasterPath.status(s, steps, stats)
	if not st.complete then
		return false, nil
	end
	s.claimed += 1
	return true, steps[st.step].reward
end

return PitmasterPath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Rarity</string>
            <string name="Source"><![CDATA[--!strict
-- Weighted rarity rolls. `luck` scales every non-common weight. `u` is a uniform [0,1) number
-- supplied by the caller (server uses Random.new(); tests pass fixed values).
local Rarity = {}

export type RarityDef = { id: string, name: string, weight: number, mult: number, color: string, flex: boolean }

function Rarity.weights(rarities: { RarityDef }, luck: number, maxIndex: number?): { number }
	local out = {}
	local cap = maxIndex or #rarities
	for i, r in ipairs(rarities) do
		if i > cap then
			out[i] = 0
		elseif i == 1 then
			out[i] = r.weight
		else
			out[i] = r.weight * math.max(0, luck)
		end
	end
	return out
end

function Rarity.odds(rarities: { RarityDef }, luck: number, maxIndex: number?): { { id: string, name: string, pct: number } }
	local w = Rarity.weights(rarities, luck, maxIndex)
	local total = 0
	for _, x in ipairs(w) do
		total += x
	end
	local out = {}
	for i, r in ipairs(rarities) do
		table.insert(out, { id = r.id, name = r.name, pct = total > 0 and (w[i] / total * 100) or 0 })
	end
	return out
end

function Rarity.roll(rarities: { RarityDef }, luck: number, maxIndex: number?, u: number): string
	local w = Rarity.weights(rarities, luck, maxIndex)
	local total = 0
	for _, x in ipairs(w) do
		total += x
	end
	local pick = math.clamp(u, 0, 0.999999999) * total
	local acc = 0
	for i, r in ipairs(rarities) do
		acc += w[i]
		if pick < acc then
			return r.id
		end
	end
	return rarities[1].id
end

function Rarity.indexOf(rarities: { RarityDef }, id: string): number
	for i, r in ipairs(rarities) do
		if r.id == id then
			return i
		end
	end
	return 1
end

function Rarity.get(rarities: { RarityDef }, id: string): RarityDef
	return rarities[Rarity.indexOf(rarities, id)]
end

-- Generic weighted pick over { {id, weight} } lists (critters, bandanas).
function Rarity.pickWeighted(list: { any }, u: number): any
	local total = 0
	for _, e in ipairs(list) do
		total += e.weight
	end
	local pick = math.clamp(u, 0, 0.999999999) * total
	local acc = 0
	for _, e in ipairs(list) do
		acc += e.weight
		if pick < acc then
			return e
		end
	end
	return list[#list]
end

function Rarity.weightedOdds(list: { any }): { [string]: number }
	local total = 0
	for _, e in ipairs(list) do
		total += e.weight
	end
	local out = {}
	for _, e in ipairs(list) do
		out[e.id] = total > 0 and e.weight / total * 100 or 0
	end
	return out
end

return Rarity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Token bucket per key. `now` is passed in (server uses os.clock()) so it's testable.
local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Limiter = typeof(setmetatable({} :: { capacity: number, refill: number, buckets: { [any]: { tokens: number, t: number } } }, RateLimiter))

function RateLimiter.new(capacity: number, refillPerSecond: number): Limiter
	return setmetatable({ capacity = capacity, refill = refillPerSecond, buckets = {} }, RateLimiter)
end

function RateLimiter.allow(self: Limiter, key: any, now: number, cost: number?): boolean
	local c = cost or 1
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.capacity, t = now }
		self.buckets[key] = b
	end
	b.tokens = math.min(self.capacity, b.tokens + (now - b.t) * self.refill)
	b.t = now
	if b.tokens >= c then
		b.tokens -= c
		return true
	end
	return false
end

function RateLimiter.forget(self: Limiter, key: any)
	self.buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ReceiptLedger</string>
            <string name="Source"><![CDATA[--!strict
-- Remembers recent PurchaseIds inside the player's saved data so ProcessReceipt is idempotent:
-- if Roblox calls us again for the same purchase, we don't grant twice.
local ReceiptLedger = {}

function ReceiptLedger.has(list: { string }, purchaseId: string): boolean
	for _, id in ipairs(list) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

function ReceiptLedger.add(list: { string }, purchaseId: string, max: number)
	if ReceiptLedger.has(list, purchaseId) then
		return
	end
	table.insert(list, purchaseId)
	while #list > max do
		table.remove(list, 1)
	end
end

return ReceiptLedger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Reconcile</string>
            <string name="Source"><![CDATA[--!strict
-- Deep-fills missing keys from a template so old saves gain new fields after an update.
local Reconcile = {}

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in pairs(v) do
		out[k] = deepCopy(x)
	end
	return out
end
Reconcile.deepCopy = deepCopy

function Reconcile.fill(target: any, template: any): any
	if type(target) ~= "table" then
		return deepCopy(template)
	end
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil then
			Reconcile.fill(target[k], v)
		end
	end
	return target
end

return Reconcile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Restock</string>
            <string name="Source"><![CDATA[--!strict
-- Sauce shop restocks every RESTOCK_SECONDS. Stock is a deterministic function of the window,
-- so every server shows the same shelf and it survives server restarts.
local Restock = {}

local M = 2147483647

local function prng(seed: number)
	local x = (seed % (M - 1)) + 1
	return function(): number
		x = (x * 48271) % M
		return x / M
	end
end

function Restock.window(now: number, period: number): number
	return math.floor(now / period)
end

function Restock.nextIn(now: number, period: number): number
	return period - (now % period)
end

export type Shelf = { { id: string, qty: number } }

function Restock.shelf(window: number, sauces: { [string]: any }, order: { string }, slots: number): Shelf
	local rnd = prng(window * 7919 + 17)
	local pool = {}
	for _, id in ipairs(order) do
		local s = sauces[id]
		if s and s.weight > 0 then
			table.insert(pool, { id = id, weight = s.weight, maxStock = s.maxStock })
		end
	end
	local shelf = {}
	for _ = 1, math.min(slots, #pool) do
		local total = 0
		for _, e in ipairs(pool) do
			total += e.weight
		end
		local pick = rnd() * total
		local acc = 0
		for i, e in ipairs(pool) do
			acc += e.weight
			if pick < acc or i == #pool then
				table.insert(shelf, { id = e.id, qty = 1 + math.floor(rnd() * e.maxStock) % e.maxStock })
				table.remove(pool, i)
				break
			end
		end
	end
	return shelf
end

-- Chance a sauce shows up in a given restock (for the "restock odds" panel), measured over
-- `samples` real restock windows (the exact same function the shop uses).
function Restock.appearOdds(sauces: { [string]: any }, order: { string }, slots: number, samples: number?): { [string]: number }
	local n = samples or 2000
	local counts: { [string]: number } = {}
	for w = 1, n do
		for _, e in ipairs(Restock.shelf(w, sauces, order, slots)) do
			counts[e.id] = (counts[e.id] or 0) + 1
		end
	end
	local out = {}
	for _, id in ipairs(order) do
		out[id] = (counts[id] or 0) / n * 100
	end
	return out
end

return Restock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Session locking for DataStore records shaped { lock = {jobId, time}?, data = {...} }.
	A server may only write a record it holds the lock for. Locks are refreshed on every autosave;
	a lock older than `staleAfter` seconds is treated as abandoned (crashed server) and can be taken.
	These are the pure transform helpers used inside DataStore:UpdateAsync.
]]
local SessionLock = {}

export type Record = { lock: { jobId: string, time: number }?, data: any? }

-- Returns (newRecord or nil to cancel, status)
function SessionLock.acquire(old: Record?, jobId: string, now: number, staleAfter: number): (Record?, string)
	local rec: Record = old or { data = nil }
	local lock = rec.lock
	if lock and lock.jobId ~= jobId and (now - lock.time) < staleAfter then
		return nil, "locked"
	end
	local stolen = lock ~= nil and lock.jobId ~= jobId
	rec.lock = { jobId = jobId, time = now }
	return rec, stolen and "stale-taken" or "acquired"
end

function SessionLock.canWrite(old: Record?, jobId: string): boolean
	if old == nil then
		return true
	end
	local lock = (old :: Record).lock
	return lock == nil or lock.jobId == jobId
end

-- Transform for saves. `release` clears the lock (player left / server closing).
function SessionLock.save(old: Record?, jobId: string, now: number, data: any, release: boolean): (Record?, string)
	if not SessionLock.canWrite(old, jobId) then
		return nil, "lost-lock"
	end
	local rec: Record = { data = data, lock = nil }
	if not release then
		rec.lock = { jobId = jobId, time = now }
	end
	return rec, "saved"
end

return SessionLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Streak</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Forgiving daily streak.
	  * Claim once per (Texas) day.
	  * Miss exactly one day? Your one free miss for the week covers it automatically.
	  * Miss more? You drop back to the first day of your current 7-day week, never to zero.
]]
local Streak = {}

export type State = { lastDay: number, count: number, best: number, freeMissWeek: number }

local function weekOf(day: number): number
	return math.floor((day + 3) / 7)
end

function Streak.new(): State
	return { lastDay = -1, count = 0, best = 0, freeMissWeek = -1 }
end

function Streak.canClaim(s: State, today: number): boolean
	return s.lastDay ~= today
end

export type Result = { ok: boolean, count: number, cycleDay: number, week: number, usedFreeMiss: boolean, softReset: boolean }

function Streak.claim(s: State, today: number): Result
	if s.lastDay == today then
		return { ok = false, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = false, softReset = false }
	end
	local usedFreeMiss, softReset = false, false
	local gap = today - s.lastDay
	if s.lastDay < 0 or s.count <= 0 then
		s.count = 1
	elseif gap == 1 then
		s.count += 1
	elseif gap == 2 and s.freeMissWeek ~= weekOf(today) then
		s.count += 1
		s.freeMissWeek = weekOf(today)
		usedFreeMiss = true
	elseif gap <= 0 then
		-- clock went backwards; treat as same streak, no reward abuse
		s.lastDay = today
		return { ok = false, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = false, softReset = false }
	else
		-- soft reset to the start of the current week of the streak
		s.count = s.count - ((s.count - 1) % 7)
		softReset = true
	end
	s.lastDay = today
	s.best = math.max(s.best, s.count)
	return { ok = true, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = usedFreeMiss, softReset = softReset }
end

-- Coins scale gently with how many weeks you've kept it going (caps at week 4).
function Streak.rewardScale(count: number): number
	local tier = math.clamp(math.ceil(math.max(1, count) / 7), 1, 4)
	return 1 + 0.5 * (tier - 1)
end

return Streak
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">TimeUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Pure time helpers (no Roblox APIs). `now` is unix seconds (os.time()).
local TimeUtil = {}

function TimeUtil.dayNumber(now: number, offsetHours: number): number
	return math.floor((now + offsetHours * 3600) / 86400)
end

-- 1 = Sunday ... 7 = Saturday. Day 0 (1970-01-01) was a Thursday.
function TimeUtil.weekday(now: number, offsetHours: number): number
	local day = TimeUtil.dayNumber(now, offsetHours)
	return ((day + 4) % 7) + 1
end

-- Monday-start week index for a day number.
function TimeUtil.weekOfDay(day: number): number
	return math.floor((day + 3) / 7)
end

function TimeUtil.weekNumber(now: number, offsetHours: number): number
	return TimeUtil.weekOfDay(TimeUtil.dayNumber(now, offsetHours))
end

-- Month 1..12 in the given offset (civil-from-days, Howard Hinnant's algorithm).
function TimeUtil.month(now: number, offsetHours: number): number
	local z = TimeUtil.dayNumber(now, offsetHours) + 719468
	local era = math.floor(z / 146097)
	local doe = z - era * 146097
	local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
	local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
	local mp = math.floor((5 * doy + 2) / 153)
	local m = mp < 10 and mp + 3 or mp - 9
	return m
end

function TimeUtil.formatDuration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

return TimeUtil
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Monetization.luau — THE ONE PLACE FOR ROBUX IDS.

	HOW TO FILL THIS IN (no coding needed, see PUBLISHING.md for screenshots-level steps):
	  1. Publish the game once (File > Publish to Roblox).
	  2. Go to https://create.roblox.com/dashboard/creations, click the game.
	  3. Monetization > Passes > "Create a Pass" for every entry in `Passes` below.
	     Use the name, description and price shown here. Copy its ID (the number in the
	     pass's URL or the "Copy Asset ID" menu) and paste it over the 0.
	  4. Monetization > Developer Products > "Create a Developer Product" for every entry
	     in `Products`. Same idea: paste each product ID over the 0.
	  5. Save this file, then File > Publish to Roblox again.

	Anything left at 0 is simply hidden from the shop in the live game (you can launch with
	just a few items). In Studio play-testing, 0-ID items show a "Studio test" button that
	grants the item for free so you can try it.

	Rules we follow (Roblox monetization + "promoting to younger audiences" guidance):
	  * No paid random items at all (no loot boxes); every purchase shows exactly what you get.
	  * Robux never buys coins, so free-play odds (rarities, restocks, bandanas) are never "paid random".
	  * Calm shop copy: "See item", "Buy for R$ X". No "LAST CHANCE", no countdowns on Robux items.
	  * Every advantage you can buy (speed, slots, premium cuts) can also be earned by playing.
	  * Paid perks never affect the Cook-Off leaderboard or plate snagging.
	  * Fair Play caps (Config.FairPlay): the tip pass is +50% (not x2), and buying a speed boost
	    gives everyone else in the server a free 5-minute Smoke Shower.
]]

export type Pass = { id: number, name: string, price: number, desc: string, icon: string }
export type Product = {
	id: number,
	name: string,
	price: number,
	desc: string,
	icon: string,
	kind: string, -- "boost" | "finish" | "cosmetic" | "bundle" | "cut"
	category: string, -- shop tab
	minutes: number?,
	mult: number?,
	grants: { string }?,
	cut: string?,
	count: number?,
	valueNote: string?,
	rotation: boolean?,
}

local Monetization = {}

-- GAME PASSES (bought once, kept forever)
Monetization.Passes = {
	ExtraSmokers = { id = 0, name = "Extra Smoker Slots", price = 249, icon = "🔥", desc = "+2 smoker slots on your ranch, forever." },
	AutoServe = { id = 0, name = "Possum Pete Waiter", price = 299, icon = "🦝", desc = "Possum Pete serves your waiting customers for you while you're in the game." },
	DoubleTips = { id = 0, name = "Big Tipper", price = 299, icon = "💰", desc = "Every plate you serve earns +50% coins, forever. Capped for Fair Play; does not affect the Cook-Off or snagging." },
	PremiumCuts = { id = 0, name = "Premium Cuts", price = 349, icon = "🥩", desc = "Cook Wagyu Brisket and Tomahawk Steaks any time. (Both can also be earned on the Pitmaster Path.)" },
	VIPPatio = { id = 0, name = "VIP Patio", price = 149, icon = "✨", desc = "String lights over your ranch, a VIP sign and a gold name tag. Looks only." },
} :: { [string]: Pass }

-- DEVELOPER PRODUCTS (can be bought more than once; cosmetics are saved forever once bought)
Monetization.Products = {
	-- Boosts (advantage)
	Boost30 = { id = 0, name = "Smoke Speed x2 (30 min)", price = 49, icon = "⏩", kind = "boost", category = "Boosts", minutes = 30, mult = 2, desc = "Everything on your smokers and grill cooks twice as fast for 30 minutes, even while you're offline." },
	Boost120 = { id = 0, name = "Smoke Speed x2 (2 hours)", price = 149, icon = "⏩", kind = "boost", category = "Boosts", minutes = 120, mult = 2, desc = "Twice as fast for 2 hours, online or offline." },
	FinishSmokers = { id = 0, name = "Finish All Smokers", price = 39, icon = "✅", kind = "finish", category = "Boosts", desc = "Everything currently cooking finishes instantly. The rarity is already set and doesn't change." },
	WagyuPack = { id = 0, name = "Wagyu Brisket x3", price = 79, icon = "🥩", kind = "cut", category = "Boosts", cut = "wagyu", count = 3, desc = "3 Wagyu Briskets to smoke. Each sells for about 2x a regular brisket and smokes in 4 hours instead of 6." },
	TomahawkPack = { id = 0, name = "Tomahawk Steak x3", price = 59, icon = "🪓", kind = "cut", category = "Boosts", cut = "tomahawk", count = 3, desc = "3 Tomahawk Steaks for the grill (5 minute cook)." },

	-- Cosmetics (looks only)
	ApronGrillMaster = { id = 0, name = "Grill Master Apron", price = 75, icon = "🦺", kind = "cosmetic", category = "Fits", grants = { "apron_grillmaster" }, desc = "The classic. Red apron, big GRILL MASTER letters." },
	GoldenSpatula = { id = 0, name = "Golden Spatula", price = 149, icon = "🥄", kind = "cosmetic", category = "Fits", grants = { "tool_goldenspatula" }, desc = "A solid-gold spatula that sparkles in your hand." },
	HatPitmaster = { id = 0, name = "Pitmaster Cowboy Hat", price = 99, icon = "🤠", kind = "cosmetic", category = "Fits", grants = { "hat_pitmaster" }, desc = "A wide-brim cowboy hat fit for the King of the Pit." },
	SkinCandyRed = { id = 0, name = "Candy Apple Smoker", price = 99, icon = "🍎", kind = "cosmetic", category = "Smokers", grants = { "skin_candyred" }, desc = "Glossy candy-apple red paint on all your smokers." },
	SkinGalaxy = { id = 0, name = "Galaxy Smoker", price = 149, icon = "🌌", kind = "cosmetic", category = "Smokers", grants = { "skin_galaxy" }, desc = "Glowing deep-space purple smokers." },
	SkinGolden = { id = 0, name = "Solid Gold Smoker", price = 249, icon = "🏆", kind = "cosmetic", category = "Smokers", grants = { "skin_golden" }, desc = "Shiny gold smokers. Pure flex, zero stats." },
	SmokeGrape = { id = 0, name = "Grape Soda Smoke", price = 49, icon = "🟣", kind = "cosmetic", category = "Smoke", grants = { "smoke_grape" }, desc = "Your smoke (and smoke signals) puff purple." },
	SmokeBluebonnet = { id = 0, name = "Bluebonnet Smoke", price = 49, icon = "🔵", kind = "cosmetic", category = "Smoke", grants = { "smoke_bluebonnet" }, desc = "Texas-bluebonnet blue smoke." },
	SmokeSherbet = { id = 0, name = "Rainbow Sherbet Smoke", price = 79, icon = "🌈", kind = "cosmetic", category = "Smoke", grants = { "smoke_sherbet" }, desc = "Smoke that cycles through sherbet colors." },
	TrailSparkler = { id = 0, name = "Sparkler Trail", price = 79, icon = "🎇", kind = "cosmetic", category = "Trails", grants = { "trail_sparkler" }, desc = "Leave a sparkler streak behind you." },
	TrailSauce = { id = 0, name = "BBQ Sauce Drip Trail", price = 79, icon = "🥫", kind = "cosmetic", category = "Trails", grants = { "trail_sauce" }, desc = "A saucy drip trail. Napkins not included." },
	TrailPetals = { id = 0, name = "Bluebonnet Petal Trail", price = 79, icon = "💠", kind = "cosmetic", category = "Trails", grants = { "trail_petals" }, desc = "Blue petals follow you around." },

	-- Bundles (prices shown honestly vs buying separately)
	BundleStarter = { id = 0, name = "Pitmaster Starter Bundle", price = 199, icon = "🎁", kind = "bundle", category = "Bundles", grants = { "apron_grillmaster", "hat_pitmaster" }, minutes = 30, mult = 2, valueNote = "Apron (75) + Hat (99) + 30 min Speed (49) = 223 separately", desc = "Grill Master Apron, Pitmaster Cowboy Hat and a 30-minute x2 speed boost." },
	BundleGoldRush = { id = 0, name = "Gold Rush Bundle", price = 349, icon = "💛", kind = "bundle", category = "Bundles", grants = { "tool_goldenspatula", "skin_golden" }, valueNote = "Spatula (149) + Gold Smoker (249) = 398 separately", desc = "Golden Spatula and Solid Gold Smoker skin." },

	-- Weekly rotation (limited-time looks; every one comes back in a later rotation)
	Rot_ApronHarvest = { id = 0, name = "Harvest Plaid Apron", price = 75, icon = "🍂", kind = "cosmetic", category = "This Week", grants = { "apron_harvest" }, rotation = true, desc = "Cozy plaid apron for the Harvest season." },
	Rot_SkinSnowy = { id = 0, name = "Snowy Smoker", price = 99, icon = "❄️", kind = "cosmetic", category = "This Week", grants = { "skin_snowy" }, rotation = true, desc = "Frosty white smokers." },
	Rot_SmokePumpkin = { id = 0, name = "Pumpkin Patch Smoke", price = 49, icon = "🎃", kind = "cosmetic", category = "This Week", grants = { "smoke_pumpkin" }, rotation = true, desc = "Pumpkin-orange smoke." },
	Rot_TrailFirework = { id = 0, name = "Firework Trail", price = 99, icon = "🎆", kind = "cosmetic", category = "This Week", grants = { "trail_firework" }, rotation = true, desc = "A celebratory firework streak." },
	Rot_HatTurkey = { id = 0, name = "Gobble Hat", price = 59, icon = "🦃", kind = "cosmetic", category = "This Week", grants = { "hat_turkey" }, rotation = true, desc = "A silly turkey hat. Gobble gobble." },
} :: { [string]: Product }

-- Optional badges (Creator Dashboard > Associated Items > Badges). 0 = skip.
Monetization.Badges = {
	BlessedPlate = 0, -- found the little "Jesus loves you" figure
	FirstRare = 0,
	MetRex = 0,
	SecretCreek = 0,
	Cooked = 0, -- got a "Cooked" rating at a Cook-Off
}

Monetization.ShopTabs = { "This Week", "Bundles", "Fits", "Smokers", "Smoke", "Trails", "Boosts", "Passes" }

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	WorldBuilder — builds the whole map out of plain Parts (no uploaded assets needed).
	It only uses Instance.new + datatypes passed in through `env`, so it runs both:
	  * in Roblox (server builds the map at startup if Workspace.Map is missing), and
	  * in Lune (scripts/bake-map.luau bakes the map into BackyardSmokeout.rbxlx so it
	    shows up in Studio's edit mode and in your thumbnails).
	Every interactive thing is a ProximityPrompt with a "Kind" attribute that the server or
	client dispatches on.
]]
local WorldBuilder = {}

WorldBuilder.PLOT_RADIUS = 150
WorldBuilder.PLOT_SIZE = 64
WorldBuilder.SMOKER_X = { -24, -16, -8, 0, 8, 16, 24 }
WorldBuilder.GRILL_X = { -27, -22, -17, -12 }

local E -- env (Roblox globals: Instance, Vector3, CFrame, Color3, Enum, UDim2)

function WorldBuilder.setEnv(env)
	E = env
end

local function hex(h)
	return E.Color3.fromHex(h)
end

local function part(parent, name, size, cf, color, material, props)
	local p = E.Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = hex(color)
	p.Material = material or E.Enum.Material.SmoothPlastic
	p.TopSurface = E.Enum.SurfaceType.Smooth
	p.BottomSurface = E.Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end
WorldBuilder.part = part

local function model(parent, name)
	local m = E.Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function folder(parent, name)
	local f = E.Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function V(x, y, z)
	return E.Vector3.new(x, y, z)
end

local function lookAt(a, b)
	if E.CFrame.lookAt then
		return E.CFrame.lookAt(a, b)
	end
	return E.CFrame.new(a, b)
end

local function cyl(parent, name, length, diameter, cf, color, material, props)
	-- Roblox cylinders run along X. `cf` is the center.
	local p = part(parent, name, V(length, diameter, diameter), cf, color, material, props)
	p.Shape = E.Enum.PartType.Cylinder
	return p
end

local function ball(parent, name, d, cf, color, material, props)
	local p = part(parent, name, V(d, d, d), cf, color, material, props)
	p.Shape = E.Enum.PartType.Ball
	return p
end

local function prompt(parent, kind, action, object, hold, dist, extra)
	local pp = E.Instance.new("ProximityPrompt")
	pp.Name = "Prompt"
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = dist or 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Kind", kind)
	if extra then
		for k, v in pairs(extra) do
			pp[k] = v
		end
	end
	pp.Parent = parent
	return pp
end
WorldBuilder.prompt = prompt

local function surfaceText(p, face, text, textColor, bg, font)
	local sg = E.Instance.new("SurfaceGui")
	sg.Name = "SignGui"
	sg.Face = face or E.Enum.NormalId.Front
	sg.SizingMode = E.Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.Parent = p
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = E.UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = bg and 0 or 1
	if bg then
		tl.BackgroundColor3 = hex(bg)
	end
	tl.TextColor3 = hex(textColor or "#FFFFFF")
	tl.Font = font or E.Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = text
	tl.Parent = sg
	return tl
end
WorldBuilder.surfaceText = surfaceText

-- `studs` (optional {w, h}) sizes the label in world studs instead of pixels, so labels on
-- closely spaced things (smoker row, grill spots, customer tables) shrink with distance
-- instead of piling on top of each other.
local function billboard(adornee, name, text, offsetY, maxDist, color, w, h, studs: { number }?)
	local b = E.Instance.new("BillboardGui")
	b.Name = name
	if studs then
		b.Size = E.UDim2.new(studs[1], 0, studs[2], 0)
	else
		b.Size = E.UDim2.new(0, w or 160, 0, h or 40)
	end
	b.StudsOffset = V(0, offsetY or 3, 0)
	b.AlwaysOnTop = false
	b.MaxDistance = maxDist or 80
	b.LightInfluence = 0
	b.Parent = adornee
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = E.UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = hex(color or "#FFFFFF")
	tl.TextStrokeTransparency = 0.3
	tl.Font = E.Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = text
	tl.Parent = b
	return b
end
WorldBuilder.billboard = billboard

-- Decorative parts: no collision, query or touch (shadow is opt-in).
local function deco(parent, name, size, cf, color, material, shadow)
	return part(parent, name, size, cf, color, material, { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = shadow == true })
end
local function dball(parent, name, d, cf, color, material, shadow)
	local p = deco(parent, name, V(d, d, d), cf, color, material, shadow)
	p.Shape = E.Enum.PartType.Ball
	return p
end
local function dcyl(parent, name, length, diameter, cf, color, material, shadow)
	local p = deco(parent, name, V(length, diameter, diameter), cf, color, material, shadow)
	p.Shape = E.Enum.PartType.Cylinder
	return p
end

local function upright()
	return E.CFrame.Angles(0, 0, math.pi / 2) -- turns an X-axis cylinder upright
end

-- Ellipsoid part (a Part with a Sphere SpecialMesh) for soft, round shapes.
local function sph(parent, name, size, cf, color, material, props)
	local p = part(parent, name, size, cf, color, material, props)
	local mesh = E.Instance.new("SpecialMesh")
	mesh.MeshType = E.Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- A round, chibi-proportioned NPC: a big head, a soft pear-shaped body, mitten hands, and
-- shiny eyes with rosy cheeks. Feet at `cf`, facing -Z. Part names Head and Torso are what
-- the game looks up (prompts and name tags hang off them).
-- Options: skin, shirt, pants, shoes, hair, hat ("cowboy" | "cap" | "bun"), hatColor, apron,
-- apronText, glasses, mustache, beard, belly, brows, label, labelColor, scale.
function WorldBuilder.npc(parent, name, cf, o)
	o = o or {}
	local m = model(parent, name)
	local skin = o.skin or "#E0AC69"
	local shirt = o.shirt or "#4A6FA5"
	local pants = o.pants or "#3B3B3B"
	local shoes = o.shoes or "#3A2A1E"
	local dark = "#2A1E1A"
	local s = o.scale or 1
	local function at(x, y, z, rx, ry, rz)
		return cf * E.CFrame.new(x * s, y * s, z * s) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	local function e(n, sx, sy, sz, c, x, y, z, rx, ry, rz, mat)
		return sph(m, n, V(sx * s, sy * s, sz * s), at(x, y, z, rx, ry, rz), c, mat)
	end
	-- legs and shoes
	local legL = cyl(m, "LeftLeg", 1.3 * s, 0.8 * s, at(-0.45, 1.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), pants)
	local legR = cyl(m, "RightLeg", 1.3 * s, 0.8 * s, at(0.45, 1.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), pants)
	if o.sandals then
		-- socks with sandals: white socks on a brown sole with a strap
		for _, side in { -1, 1 } do
			e("Sock", 0.85, 0.75, 1.2, "#F7F7F2", side * 0.47, 0.42, -0.12)
			e("Sole", 1.0, 0.22, 1.45, "#7A4A2A", side * 0.47, 0.1, -0.15)
			deco(m, "Strap", V(0.9 * s, 0.16 * s, 0.25 * s), at(side * 0.47, 0.55, -0.55), "#7A4A2A", E.Enum.Material.SmoothPlastic, false)
		end
	else
		e("ShoeL", 0.95, 0.6, 1.35, shoes, -0.47, 0.3, -0.15)
		e("ShoeR", 0.95, 0.6, 1.35, shoes, 0.47, 0.3, -0.15)
	end
	-- body: hips + a soft torso (rounder for a belly)
	e("Hips", 2.0, 1.1, 1.6, pants, 0, 1.75, 0)
	if o.buckle then
		e("Belt", 2.05, 0.3, 1.65, "#3A2414", 0, 2.05, 0)
		e("Buckle", 0.6, 0.42, 0.2, o.buckle, 0, 2.05, -0.82, 0, 0, 0, E.Enum.Material.Foil)
	end
	local bw, bd = o.belly and 2.6 or 2.2, o.belly and 2.3 or 1.75
	local torso = sph(m, "Torso", V(bw * s, 2.5 * s, bd * s), at(0, 2.75, 0), shirt)
	if o.apron then
		-- a soft bib that hugs the front of the torso, with a flat name patch on it
		e("ApronBib", bw * 0.78, 2.3, bd * 1.0, o.apron, 0, 2.6, -bd * 0.12, 0, 0, 0)
		local ap = part(m, "Apron", V(1.25 * s, 0.6 * s, 0.05 * s), at(0, 2.55, -bd * 0.62 - 0.01), o.apron, E.Enum.Material.Fabric)
		ap.CanCollide = false
		if o.apronText then
			surfaceText(ap, E.Enum.NormalId.Front, o.apronText, "#FFFFFF", nil)
		end
	end
	-- arms: sleeves angled out a little, mitten hands
	for _, side in { -1, 1 } do
		local ax = side * (bw / 2 + 0.2)
		e(side < 0 and "LeftArm" or "RightArm", 0.75, 1.7, 0.75, shirt, ax, 2.85, 0, 0, 0, side * 16)
		e(side < 0 and "HandL" or "HandR", 0.7, 0.7, 0.7, skin, ax + side * 0.25, 1.95, -0.05)
	end
	-- head: a big round face
	local head = sph(m, "Head", V(2.5 * s, 2.4 * s, 2.35 * s), at(0, 4.85, 0), skin)
	e("EarL", 0.38, 0.6, 0.35, skin, -1.24, 4.85, 0.05)
	e("EarR", 0.38, 0.6, 0.35, skin, 1.24, 4.85, 0.05)
	for _, side in { -1, 1 } do
		e(side < 0 and "EyeL" or "EyeR", 0.34, 0.5, 0.2, dark, side * 0.45, 5.0, -1.08)
		e(side < 0 and "ShineL" or "ShineR", 0.13, 0.13, 0.08, "#FFFFFF", side * 0.45 - 0.07, 5.12, -1.18, 0, 0, 0, E.Enum.Material.Neon)
		e(side < 0 and "CheekL" or "CheekR", 0.5, 0.3, 0.12, "#F28B82", side * 0.78, 4.6, -0.98)
		if o.brows ~= false then
			deco(m, "Brow", V(0.5 * s, 0.12 * s, 0.1 * s), at(side * 0.45, 5.42, -1.06, 0, 0, side * -8), o.hair or dark, E.Enum.Material.SmoothPlastic, false)
		end
	end
	e("Nose", 0.4, 0.34, 0.3, skin, 0, 4.68, -1.18)
	if o.mustache then
		e("Mustache", 1.25, 0.36, 0.4, o.mustache, 0, 4.42, -1.12)
		e("Smile", 0.5, 0.16, 0.12, "#7A2E2E", 0, 4.18, -1.13)
	else
		e("Smile", 0.66, 0.2, 0.12, "#7A2E2E", 0, 4.32, -1.14)
	end
	if o.beard then
		e("Beard", 1.7, 0.9, 1.0, o.beard, 0, 3.9, -0.75)
	end
	if o.glasses then
		for _, side in { -1, 1 } do
			local lens = cyl(m, "Glasses", 0.08 * s, 0.75 * s, at(side * 0.45, 5.0, -1.2) * E.CFrame.Angles(0, math.pi / 2, 0), "#BFE3FF", E.Enum.Material.Glass, { Transparency = 0.55 })
			lens.CanCollide = false
			deco(m, "GlassesRim", V(0.8 * s, 0.08 * s, 0.06 * s), at(side * 0.45, 5.38, -1.2), "#3A2A1E", E.Enum.Material.SmoothPlastic, false)
		end
		deco(m, "GlassesBridge", V(0.2 * s, 0.07 * s, 0.06 * s), at(0, 5.1, -1.22), "#3A2A1E", E.Enum.Material.SmoothPlastic, false)
	end
	-- hair and hats
	if o.hair and o.hat ~= "cowboy" then
		e("Hair", 2.6, 1.35, 2.5, o.hair, 0, 5.55, 0.12)
	end
	if o.hat == "cowboy" then
		local hc = o.hatColor or "#3B2A1A"
		cyl(m, "HatBrim", 0.18 * s, 4.3 * s, at(0, 5.75, 0) * E.CFrame.Angles(0, 0, math.pi / 2), hc)
		e("HatBrimCurlL", 0.9, 0.5, 3.6, hc, -1.85, 5.95, 0)
		e("HatBrimCurlR", 0.9, 0.5, 3.6, hc, 1.85, 5.95, 0)
		e("HatCrown", 2.3, 1.6, 2.1, hc, 0, 6.4, 0)
		cyl(m, "HatBand", 0.3 * s, 2.32 * s, at(0, 6.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), o.hatBand or "#8B5A2B")
	elseif o.hat == "cap" then
		local hc = o.hatColor or "#B22222"
		e("Cap", 2.6, 1.5, 2.5, hc, 0, 5.6, 0.05)
		e("Bill", 1.8, 0.2, 1.3, hc, 0, 5.4, -1.2)
		e("CapButton", 0.3, 0.2, 0.3, "#FFFFFF", 0, 6.33, 0.05)
	elseif o.hat == "bun" then
		e("Hair", 2.6, 1.35, 2.5, o.hatColor or "#DDDDDD", 0, 5.55, 0.12)
		e("Bun", 1.15, 1.05, 1.15, o.hatColor or "#DDDDDD", 0, 6.25, 0.45)
		if o.pearls then
			for k = -2, 2 do
				dball(m, "Pearl", 0.22 * s, at(k * 0.32, 3.95 - math.abs(k) * 0.05, -0.82 + math.abs(k) * 0.08), "#FFF8E7", E.Enum.Material.SmoothPlastic, false)
			end
		end
	end
	for _, c in ipairs(m:GetDescendants()) do
		if c:IsA("BasePart") then
			c.CanCollide = c == torso or c == legL or c == legR
		end
	end
	m.PrimaryPart = torso
	if o.label then
		billboard(head, "NameTag", o.label, 2.8, 60, o.labelColor or "#FFE9A8", 200, 36)
	end
	return m, head, torso
end

-- A critter customer: round, plush-toy shapes (ellipsoids) with big shiny eyes and rosy
-- cheeks. Built at `cf` (feet on the ground), facing -Z. The game looks up the parts named
-- Body and Head (prompts, order bubbles, mud spots).
local function lighten(c, t)
	return "#" .. hex(c):Lerp(E.Color3.new(1, 1, 1), t):ToHex()
end

function WorldBuilder.critter(env, parent, def, cf)
	E = env
	local m = model(parent, def.id)
	local s = def.scale or 1
	local id = def.id
	local function at(x, y, z, rx, ry, rz)
		return cf * E.CFrame.new(x * s, y * s, z * s) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	local function e(n, sx, sy, sz, c, x, y, z, rx, ry, rz, mat)
		return sph(m, n, V(sx * s, sy * s, sz * s), at(x, y, z, rx, ry, rz), c, mat)
	end
	local BC, HC = def.body, def.head
	local DARK, PINK = "#1E1614", "#F59BB0"
	local body, head
	-- eye placement (head-relative), filled in per body plan
	local eyeY, eyeZ, eyeX, eyeSize = 2.55, -2.0, 0.38, 1
	if def.rex then
		body = e("Body", 2.4, 2.6, 2.6, BC, 0, 2.2, 0.3)
		e("Belly", 1.7, 2.0, 1.2, "#E8F5C8", 0, 2.0, -0.55)
		head = e("Head", 2.2, 1.9, 2.4, HC, 0, 4.3, -0.7)
		e("Snout", 1.7, 1.1, 1.5, HC, 0, 3.95, -1.55)
		for k = -2, 2 do
			e("Tooth", 0.18, 0.22, 0.12, "#FFFFFF", k * 0.3, 3.45, -2.25)
		end
		e("NostrilL", 0.16, 0.1, 0.1, DARK, -0.3, 4.3, -2.28)
		e("NostrilR", 0.16, 0.1, 0.1, DARK, 0.3, 4.3, -2.28)
		e("ArmL", 0.4, 0.8, 0.4, BC, -0.95, 2.75, -0.9, 40, 0, 10)
		e("ArmR", 0.4, 0.8, 0.4, BC, 0.95, 2.75, -0.9, 40, 0, -10)
		e("Tail", 1.1, 1.0, 3.0, BC, 0, 1.5, 2.6, -15, 0, 0)
		e("LegL", 1.0, 1.4, 1.2, BC, -0.75, 0.6, 0.4)
		e("LegR", 1.0, 1.4, 1.2, BC, 0.75, 0.6, 0.4)
		e("FootL", 1.0, 0.45, 1.4, BC, -0.75, 0.2, 0.05)
		e("FootR", 1.0, 0.45, 1.4, BC, 0.75, 0.2, 0.05)
		for k = 0, 3 do
			e("Spike", 0.25, 0.55, 0.55, "#4E9E35", 0, 3.6 - k * 0.55 + (k == 0 and 1.6 or 0), 0.2 + k * 0.7 - (k == 0 and 1.2 or 0))
		end
		part(m, "Ribbon", V(1.9 * s, 0.3 * s, 0.25 * s), at(0, 3.45, -1.05), "#FF5C8A")
		e("BowL", 0.6, 0.45, 0.25, "#FF5C8A", -0.45, 3.45, -1.25, 0, 0, 20)
		e("BowR", 0.6, 0.45, 0.25, "#FF5C8A", 0.45, 3.45, -1.25, 0, 0, -20)
		billboard(head, "Ribbon", def.ribbon or "RAWR means I love you ♥", 2.6, 70, "#FF8FB1", 260, 34)
		eyeY, eyeZ, eyeX, eyeSize = 4.75, -1.62, 0.5, 1.3
	elseif id == "roadrunner" or id == "hummingbird" then
		local hb = id == "hummingbird"
		body = e("Body", 1.5, 1.5, 2.1, BC, 0, 1.7, 0, hb and -10 or -15, 0, 0)
		e("Chest", 1.1, 1.1, 1.0, lighten(BC, 0.45), 0, 1.6, -0.7)
		head = e("Head", 1.3, 1.3, 1.3, HC, 0, 2.85, -0.9)
		e("Beak", 0.28, 0.28, hb and 1.8 or 1.2, hb and "#2A2A2A" or "#5A4A3A", 0, 2.75, hb and -2.2 or -1.9)
		if hb then
			e("WingL", 0.15, 1.7, 1.0, lighten(BC, 0.2), -0.85, 2.3, 0.1, 0, 0, 30, E.Enum.Material.Glass)
			e("WingR", 0.15, 1.7, 1.0, lighten(BC, 0.2), 0.85, 2.3, 0.1, 0, 0, -30, E.Enum.Material.Glass)
			e("Tail", 0.6, 0.2, 1.0, BC, 0, 1.4, 1.3, 20, 0, 0)
		else
			e("Crest", 0.3, 1.0, 1.0, "#24456B", 0, 3.55, -0.6, -20, 0, 0)
			e("Tail", 0.5, 0.45, 2.4, BC, 0, 2.2, 1.6, -28, 0, 0)
			e("CheekPatch", 0.9, 0.3, 0.2, "#E2572E", 0, 2.85, -0.25)
		end
		for _, side in { -1, 1 } do
			cyl(m, "Leg", 1.0 * s, 0.2 * s, at(side * 0.35, 0.55, 0.1) * E.CFrame.Angles(0, 0, math.pi / 2), "#C9A060")
			e("Foot", 0.4, 0.15, 0.6, "#C9A060", side * 0.35, 0.08, -0.05)
		end
		eyeY, eyeZ, eyeX, eyeSize = 3.0, -1.45, 0.33, 0.85
	else
		local flat = id == "hornedtoad"
		local bodyH = flat and 1.0 or 1.6
		local by = flat and 0.75 or 1.25
		body = e("Body", flat and 2.4 or 2.0, bodyH, flat and 2.4 or 2.5, BC, 0, by, 0)
		e("BellyPatch", 1.4, bodyH * 0.6, 1.8, def.bellyRub and PINK or lighten(BC, 0.35), 0, by - bodyH * 0.28, -0.1)
		local hy = flat and 1.35 or 2.35
		head = e("Head", flat and 1.7 or 1.75, flat and 1.1 or 1.6, flat and 1.4 or 1.6, HC, 0, hy, flat and -1.45 or -1.3)
		-- muzzle and nose
		local muzzleColor = (id == "possum" or id == "clapcat") and HC or lighten(HC, 0.35)
		if id == "armadillo" then
			e("Muzzle", 0.75, 0.6, 1.2, lighten(HC, 0.2), 0, hy - 0.35, -2.25)
			e("Nose", 0.35, 0.3, 0.25, DARK, 0, hy - 0.3, -2.85)
		elseif id == "possum" then
			e("Muzzle", 0.8, 0.6, 1.0, HC, 0, hy - 0.3, -2.15)
			e("Nose", 0.32, 0.26, 0.24, "#F48FB1", 0, hy - 0.22, -2.65)
		elseif def.bellyRub then
			e("Muzzle", 1.15, 0.65, 0.45, lighten(HC, 0.15), 0, hy - 0.4, -2.0)
			e("Nose", 0.45, 0.3, 0.25, DARK, 0, hy - 0.15, -2.18)
			e("Tongue", 0.32, 0.4, 0.12, "#FF6F8E", 0.12, hy - 0.72, -2.15)
		elseif not flat then
			e("Muzzle", 0.95, 0.65, 0.7, muzzleColor, 0, hy - 0.3, -2.0)
			e("Nose", 0.32, 0.24, 0.2, id == "clapcat" and "#F48FB1" or DARK, 0, hy - 0.12, -2.33)
		else
			e("Smile", 0.7, 0.12, 0.1, DARK, 0, hy - 0.25, -2.12)
		end
		if not flat then
			e("CheekL", 0.32, 0.18, 0.1, "#F7A1A9", -0.62, hy - 0.2, -1.95)
			e("CheekR", 0.32, 0.18, 0.1, "#F7A1A9", 0.62, hy - 0.2, -1.95)
		end
		-- legs
		for _, lx in { -0.62, 0.62 } do
			for _, lz in { -0.75, 0.75 } do
				e("Leg", flat and 0.6 or 0.55, flat and 0.5 or 0.8, flat and 0.6 or 0.55, BC, lx * (flat and 1.25 or 1), flat and 0.25 or 0.4, lz)
			end
		end
		-- ears
		if def.ears then
			if id == "possum" then
				e("EarL", 0.7, 0.7, 0.18, "#F4B6C2", -0.62, hy + 0.7, -1.2)
				e("EarR", 0.7, 0.7, 0.18, "#F4B6C2", 0.62, hy + 0.7, -1.2)
			elseif def.bellyRub then
				e("EarL", 0.6, 1.0, 0.25, HC, -0.55, hy + 0.85, -1.2, 0, 0, 18)
				e("EarR", 0.6, 1.0, 0.25, HC, 0.55, hy + 0.85, -1.2, 0, 0, -18)
				e("EarInL", 0.35, 0.7, 0.1, PINK, -0.55, hy + 0.82, -1.33, 0, 0, 18)
				e("EarInR", 0.35, 0.7, 0.1, PINK, 0.55, hy + 0.82, -1.33, 0, 0, -18)
			elseif id == "clapcat" or id == "raccoon" then
				e("EarL", 0.5, 0.85, 0.25, HC, -0.5, hy + 0.75, -1.2, 0, 0, 14)
				e("EarR", 0.5, 0.85, 0.25, HC, 0.5, hy + 0.75, -1.2, 0, 0, -14)
				e("EarInL", 0.25, 0.5, 0.1, id == "clapcat" and "#F48FB1" or "#EDEDED", -0.5, hy + 0.7, -1.33, 0, 0, 14)
				e("EarInR", 0.25, 0.5, 0.1, id == "clapcat" and "#F48FB1" or "#EDEDED", 0.5, hy + 0.7, -1.33, 0, 0, -14)
			else
				e("EarL", 0.55, 0.4, 0.3, HC, -0.85, hy + 0.35, -1.2, 0, 0, 25)
				e("EarR", 0.55, 0.4, 0.3, HC, 0.85, hy + 0.35, -1.2, 0, 0, -25)
			end
		end
		-- tails
		if id == "raccoon" then
			for k = 0, 3 do
				e("Tail", 0.65, 0.65, 0.6, k % 2 == 0 and "#3A3A3A" or "#9A9A9A", 0, 1.35 + k * 0.18, 1.35 + k * 0.45)
			end
		elseif id == "possum" then
			e("Tail", 0.25, 0.25, 2.2, "#F4B6C2", 0, 0.9, 2.0, 15, 0, 0)
		elseif id == "clapcat" then
			e("Tail", 0.3, 2.0, 0.3, BC, 0, 2.2, 1.35, -15, 0, 0)
		elseif id == "armadillo" then
			e("Tail", 0.35, 0.35, 1.6, BC, 0, 0.8, 1.7, 12, 0, 0)
			for k = -1, 2 do
				e("ShellBand", 2.12, 1.5, 0.35, lighten(BC, 0.12), 0, 1.3, k * 0.5)
			end
		elseif not flat then
			e("Tail", 0.4, 0.4, 0.9, BC, 0, 1.65, 1.35, -35, 0, 0)
		else
			e("Tail", 0.5, 0.3, 1.4, BC, 0, 0.55, 1.6)
		end
		if def.horns then
			for _, side in { -1, 1 } do
				e("Horn", 1.7, 0.36, 0.36, "#F5F0E1", side * 1.35, hy + 0.55, -1.2, 0, 0, side * -22)
				e("HornTip", 0.5, 0.3, 0.3, "#3A2A1E", side * 2.1, hy + 0.9, -1.2, 0, 0, side * -40)
			end
		end
		if flat then
			for k = 0, 4 do
				local a = math.rad(-60 + k * 30)
				e("Horns", 0.22, 0.22, 0.6, "#F5F0E1", math.sin(a) * 0.65, hy + 0.45, -1.2 + math.cos(a) * 0.2, 35, 0, 0)
			end
			for k = 1, 6 do
				e("Spike", 0.22, 0.22, 0.22, lighten(BC, 0.3), (k % 3 - 1) * 0.6, by + 0.48, -0.6 + math.floor((k - 1) / 3) * 0.9)
			end
			eyeY, eyeZ, eyeX, eyeSize = hy + 0.15, -2.05, 0.45, 0.95
		else
			eyeY, eyeZ = hy + 0.2, -1.99
		end
		if id == "raccoon" then
			e("Mask", 1.6, 0.55, 0.3, "#1A1A1A", 0, eyeY, -1.88)
		end
		if id == "clapcat" then
			part(m, "PawL", V(0.45 * s, 0.45 * s, 0.45 * s), at(-0.32, 1.85, -2.05), BC).Shape = E.Enum.PartType.Ball
			part(m, "PawR", V(0.45 * s, 0.45 * s, 0.45 * s), at(0.32, 1.85, -2.05), BC).Shape = E.Enum.PartType.Ball
		end
	end
	-- big shiny eyes
	for _, side in { -1, 1 } do
		local eyeColor = id == "clapcat" and "#E8D44D" or DARK
		e(side < 0 and "EyeL" or "EyeR", 0.32 * eyeSize, 0.44 * eyeSize, 0.16, eyeColor, side * eyeX, eyeY, eyeZ)
		if id == "clapcat" then
			e("Pupil", 0.12, 0.34, 0.1, DARK, side * eyeX, eyeY, eyeZ - 0.06)
		end
		e(side < 0 and "ShineL" or "ShineR", 0.12 * eyeSize, 0.12 * eyeSize, 0.06, "#FFFFFF", side * eyeX - 0.06, eyeY + 0.1 * eyeSize, eyeZ - 0.08, 0, 0, 0, E.Enum.Material.Neon)
	end
	for _, c in ipairs(m:GetChildren()) do
		if c:IsA("BasePart") then
			c.CanCollide = false
			c.CanQuery = c.Name == "Body"
		end
	end
	m.PrimaryPart = body
	return m, head, body
end

function WorldBuilder.mosquito(env, parent, cf, queen)
	E = env
	local s = queen and 3 or 1
	local m = model(parent, queen and "QueenSkeeter" or "Mosquito")
	local body = part(m, "Body", V(0.8 * s, 0.8 * s, 2 * s), cf, "#3A3A3A", nil, { CanCollide = false })
	part(m, "Head", V(0.6 * s, 0.6 * s, 0.6 * s), cf * E.CFrame.new(0, 0, -1.2 * s), "#2A2A2A", nil, { CanCollide = false })
	part(m, "Nose", V(0.1 * s, 0.1 * s, 1.2 * s), cf * E.CFrame.new(0, -0.1 * s, -2 * s), "#111111", nil, { CanCollide = false })
	part(m, "WingL", V(1.8 * s, 0.05 * s, 0.8 * s), cf * E.CFrame.new(-1.1 * s, 0.4 * s, 0), "#CDEFFF", E.Enum.Material.Glass, { Transparency = 0.4, CanCollide = false })
	part(m, "WingR", V(1.8 * s, 0.05 * s, 0.8 * s), cf * E.CFrame.new(1.1 * s, 0.4 * s, 0), "#CDEFFF", E.Enum.Material.Glass, { Transparency = 0.4, CanCollide = false })
	ball(m, "EyeL", 0.3 * s, cf * E.CFrame.new(-0.25 * s, 0.15 * s, -1.4 * s), "#FF3B3B", E.Enum.Material.Neon, { CanCollide = false })
	ball(m, "EyeR", 0.3 * s, cf * E.CFrame.new(0.25 * s, 0.15 * s, -1.4 * s), "#FF3B3B", E.Enum.Material.Neon, { CanCollide = false })
	m.PrimaryPart = body
	return m, body
end

-- Visual for meat sitting on a smoker / grill / pass window.
function WorldBuilder.meat(env, parent, meatDef, rarityDef, cf, doneness)
	E = env
	local sz = meatDef.size or { 2, 0.6, 1.2 }
	local scale = 1
	if rarityDef and rarityDef.id == "texas" then
		scale = 1.9
	end
	local color = hex(meatDef.color)
	local raw = hex("#E8857A")
	local t = math.clamp(doneness or 1, 0, 1)
	local c = raw:Lerp(color, t)
	local p = E.Instance.new("Part")
	p.Name = "Meat"
	p.Anchored = true
	p.CanCollide = false
	p.Size = V(sz[1] * scale, sz[2] * scale, sz[3] * scale)
	p.CFrame = cf * E.CFrame.new(0, p.Size.Y / 2, 0)
	p.Color = c
	p.Material = E.Enum.Material.SmoothPlastic
	if rarityDef then
		if rarityDef.id == "meteorite" then
			p.Color = hex("#141414")
			p.Material = E.Enum.Material.Basalt
			local glow = E.Instance.new("PointLight")
			glow.Color = hex("#9B5CFF")
			glow.Range = 10
			glow.Brightness = 2
			glow.Parent = p
			local sp = E.Instance.new("Sparkles")
			sp.SparkleColor = hex("#9B5CFF")
			sp.Parent = p
		elseif rarityDef.id == "smokering" then
			local ring = E.Instance.new("SelectionBox")
			ring.Adornee = p
			ring.Color3 = hex("#FFC83C")
			ring.LineThickness = 0.06
			ring.Parent = p
			local sp = E.Instance.new("Sparkles")
			sp.SparkleColor = hex("#FFC83C")
			sp.Parent = p
		elseif rarityDef.id == "juicy" then
			p.Material = E.Enum.Material.Glass
			p.Transparency = 0.05
		end
	end
	p.Parent = parent
	return p
end

local function tree(parent, pos, s)
	s = s or 1
	part(parent, "Trunk", V(2 * s, 10 * s, 2 * s), E.CFrame.new(pos + V(0, 5 * s, 0)), "#6B4226", E.Enum.Material.Wood)
	ball(parent, "Leaves", 11 * s, E.CFrame.new(pos + V(0, 12 * s, 0)), "#3E8E41", E.Enum.Material.Grass)
	ball(parent, "Leaves2", 8 * s, E.CFrame.new(pos + V(3 * s, 10 * s, 2 * s)), "#4CA64C", E.Enum.Material.Grass)
end

local function fence(parent, cf, length)
	local m = model(parent, "Fence")
	local posts = math.floor(length / 8)
	for i = 0, posts do
		local x = -length / 2 + i * (length / posts)
		part(m, "Post", V(0.6, 4, 0.6), cf * E.CFrame.new(x, 2, 0), "#8B5A2B", E.Enum.Material.Wood)
	end
	part(m, "RailTop", V(length, 0.4, 0.3), cf * E.CFrame.new(0, 3.3, 0), "#A0522D", E.Enum.Material.Wood)
	part(m, "RailLow", V(length, 0.4, 0.3), cf * E.CFrame.new(0, 1.6, 0), "#A0522D", E.Enum.Material.Wood)
	return m
end

local function picnicTable(parent, name, cf)
	local m = model(parent, name)
	part(m, "Top", V(6, 0.4, 3), cf * E.CFrame.new(0, 2.6, 0), "#B5651D", E.Enum.Material.Wood)
	part(m, "LegA", V(0.4, 2.4, 2.6), cf * E.CFrame.new(-2.4, 1.2, 0), "#8B4513", E.Enum.Material.Wood)
	part(m, "LegB", V(0.4, 2.4, 2.6), cf * E.CFrame.new(2.4, 1.2, 0), "#8B4513", E.Enum.Material.Wood)
	part(m, "BenchA", V(6, 0.3, 1), cf * E.CFrame.new(0, 1.5, -2.2), "#B5651D", E.Enum.Material.Wood)
	part(m, "BenchB", V(6, 0.3, 1), cf * E.CFrame.new(0, 1.5, 2.2), "#B5651D", E.Enum.Material.Wood)
	part(m, "Cloth", V(6.05, 0.05, 3.05), cf * E.CFrame.new(0, 2.83, 0), "#D9534F", E.Enum.Material.Fabric)
	local seat = part(m, "Seat", V(1, 0.2, 1), cf * E.CFrame.new(0, 0.1, -3.6), "#000000", nil, { Transparency = 1, CanCollide = false })
	return m, seat
end

local function smoker(parent, name, cf)
	local m = model(parent, name)
	part(m, "LegL", V(0.4, 2.5, 0.4), cf * E.CFrame.new(-2, 1.25, 0), "#222222", E.Enum.Material.Metal)
	part(m, "LegR", V(0.4, 2.5, 0.4), cf * E.CFrame.new(2, 1.25, 0), "#222222", E.Enum.Material.Metal)
	local barrel = cyl(m, "Barrel", 5, 3, cf * E.CFrame.new(0, 3.6, 0), "#6E4B3A", E.Enum.Material.Metal)
	part(m, "Firebox", V(1.8, 1.8, 1.8), cf * E.CFrame.new(-3.3, 3, 0), "#3A3A3A", E.Enum.Material.Metal)
	local chimney = cyl(m, "Chimney", 3, 0.7, cf * E.CFrame.new(2, 6.3, 0) * E.CFrame.Angles(0, 0, math.pi / 2), "#2A2A2A", E.Enum.Material.Metal)
	local smoke = E.Instance.new("Smoke")
	smoke.Name = "Smoke"
	smoke.Enabled = false
	smoke.Size = 2
	smoke.RiseVelocity = 4
	smoke.Opacity = 0.15
	smoke.Color = hex("#DDDDDD")
	smoke.Parent = chimney
	part(m, "Handle", V(2, 0.3, 0.3), cf * E.CFrame.new(0, 4, -1.7), "#C0C0C0", E.Enum.Material.Metal)
	local spot = part(m, "MeatSpot", V(1, 0.2, 1), cf * E.CFrame.new(0, 5.15, 0), "#000000", nil, { Transparency = 1, CanCollide = false })
	local gui = billboard(barrel, "SlotGui", "", 4.2, 70, "#FFFFFF", 180, 44, { 7.5, 2 })
	gui.Name = "SlotGui"
	-- padlock sign shown (by WorldService) while this slot is locked; parts remember their base
	-- color so the dark locked silhouette can be undone.
	local lock = part(m, "LockSign", V(3.2, 1.5, 0.2), cf * E.CFrame.new(0, 3.5, 1.85), "#FFC83C", E.Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CastShadow = false })
	for _, face in ipairs({ E.Enum.NormalId.Front, E.Enum.NormalId.Back }) do
		surfaceText(lock, face, "🔒 LOCKED", "#1C1A1F", nil).Parent.Enabled = false
	end
	for _, c in ipairs(m:GetChildren()) do
		if c:IsA("BasePart") and c.Name ~= "MeatSpot" and c.Name ~= "LockSign" then
			c:SetAttribute("BaseColor", "#" .. c.Color:ToHex())
		end
	end
	m:SetAttribute("Slot", name)
	return m, barrel, spot
end

local function stall(parent, name, cf, title, awningA, awningB, promptKind, promptText)
	local m = model(parent, name)
	part(m, "Counter", V(14, 3.5, 3), cf * E.CFrame.new(0, 1.75, 0), "#8B5A2B", E.Enum.Material.WoodPlanks)
	part(m, "Back", V(14, 9, 0.6), cf * E.CFrame.new(0, 4.5, 4), "#A0522D", E.Enum.Material.WoodPlanks)
	part(m, "PostL", V(0.6, 9, 0.6), cf * E.CFrame.new(-6.7, 4.5, -1.3), "#6B4226", E.Enum.Material.Wood)
	part(m, "PostR", V(0.6, 9, 0.6), cf * E.CFrame.new(6.7, 4.5, -1.3), "#6B4226", E.Enum.Material.Wood)
	for i = 0, 6 do
		part(m, "Awning" .. i, V(2, 0.4, 7), cf * E.CFrame.new(-6 + i * 2, 9.2, 1) * E.CFrame.Angles(math.rad(-12), 0, 0), i % 2 == 0 and awningA or awningB, E.Enum.Material.Fabric)
	end
	local roof = part(m, "Roof", V(14.5, 0.6, 8), cf * E.CFrame.new(0, 10.2, 1.5), "#5A3A1E", E.Enum.Material.WoodPlanks)
	local sign = part(m, "Sign", V(12, 2.2, 0.3), cf * E.CFrame.new(0, 7.25, -1.5), "#F4E1C1", E.Enum.Material.Wood)
	surfaceText(sign, E.Enum.NormalId.Front, title, "#5A2E1E", nil)
	-- bottles on the counter
	local colors = { "#D2462E", "#FF5A00", "#E8B923", "#FFA07A", "#5B3A1E" }
	for i, c in ipairs(colors) do
		cyl(m, "Bottle" .. i, 1.2, 0.6, cf * E.CFrame.new(-4 + i * 1.4, 4.1, 0) * E.CFrame.Angles(0, 0, math.pi / 2), c, E.Enum.Material.Glass)
	end
	prompt(m.Counter, promptKind, promptText, title, 0, 12)
	return m, roof
end

local function buildPlot(root, i, cfg)
	local n = cfg.MAX_PLOTS
	local angle = (i - 1) / n * math.pi * 2
	local center = V(math.cos(angle) * WorldBuilder.PLOT_RADIUS, 0, math.sin(angle) * WorldBuilder.PLOT_RADIUS)
	local cf = lookAt(center, V(0, 0, 0))
	local S = WorldBuilder.PLOT_SIZE
	local m = model(root, "Plot" .. i)
	m:SetAttribute("PlotIndex", i)
	part(m, "Pad", V(S, 1, S), cf * E.CFrame.new(0, 0.1, 0), "#6FBF4B", E.Enum.Material.Grass)
	part(m, "Patio", V(56, 0.3, 16), cf * E.CFrame.new(0, 0.7, 18), "#C9B79C", E.Enum.Material.Slate)
	part(m, "Path", V(8, 0.25, 26), cf * E.CFrame.new(0, 0.68, -19), "#C2A878", E.Enum.Material.Sand)
	-- fences (front has a gap for the path)
	fence(m, cf * E.CFrame.new(0, 0.6, S / 2), S)
	fence(m, cf * E.CFrame.new(-S / 2, 0.6, 0) * E.CFrame.Angles(0, math.pi / 2, 0), S)
	fence(m, cf * E.CFrame.new(S / 2, 0.6, 0) * E.CFrame.Angles(0, math.pi / 2, 0), S)
	fence(m, cf * E.CFrame.new(-18, 0.6, -S / 2), 28)
	fence(m, cf * E.CFrame.new(18, 0.6, -S / 2), 28)

	-- sign
	local sign = model(m, "Sign")
	part(sign, "PostL", V(0.6, 7, 0.6), cf * E.CFrame.new(-6, 3.5, -S / 2 - 1), "#6B4226", E.Enum.Material.Wood)
	part(sign, "PostR", V(0.6, 7, 0.6), cf * E.CFrame.new(6, 3.5, -S / 2 - 1), "#6B4226", E.Enum.Material.Wood)
	local board = part(sign, "Board", V(12.5, 2.6, 0.4), cf * E.CFrame.new(0, 6.2, -S / 2 - 1) * E.CFrame.Angles(0, math.pi, 0), "#F4E1C1", E.Enum.Material.Wood)
	surfaceText(board, E.Enum.NormalId.Front, "Open Ranch", "#5A2E1E", nil).Name = "OwnerText"

	-- smokers
	local smokers = folder(m, "Smokers")
	for si, x in ipairs(WorldBuilder.SMOKER_X) do
		smoker(smokers, "s" .. si, cf * E.CFrame.new(x, 0.6, 20) * E.CFrame.Angles(0, math.pi, 0))
	end
	-- grill (flat-top with 4 spots)
	local grill = model(m, "Grill")
	part(grill, "Base", V(22, 3, 4), cf * E.CFrame.new(-19.5, 2.1, 4), "#2E2E2E", E.Enum.Material.Metal)
	local top = part(grill, "Top", V(22, 0.4, 4), cf * E.CFrame.new(-19.5, 3.8, 4), "#555555", E.Enum.Material.DiamondPlate)
	local gsmoke = E.Instance.new("Smoke")
	gsmoke.Name = "Smoke"
	gsmoke.Enabled = false
	gsmoke.Size = 1.5
	gsmoke.Opacity = 0.1
	gsmoke.RiseVelocity = 3
	gsmoke.Parent = top
	for gi, x in ipairs(WorldBuilder.GRILL_X) do
		local spot = part(grill, "g" .. gi, V(4, 0.2, 3), cf * E.CFrame.new(x, 4.05, 4), "#333333", E.Enum.Material.Metal)
		spot:SetAttribute("Slot", "g" .. gi)
		billboard(spot, "SlotGui", "", 3, 60, "#FFFFFF", 150, 40, { 4.6, 1.5 })
	end
	-- customer tables
	local tables = folder(m, "Tables")
	for ti = 1, cfg.CUSTOMER_SPOTS do
		picnicTable(tables, "t" .. ti, cf * E.CFrame.new(6 + (ti - 1) * 9, 0.6, -4))
	end
	-- pass window (where other players can snag a plate while you're online)
	local pw = model(m, "PassWindow")
	local counter = part(pw, "Counter", V(8, 3.4, 2.5), cf * E.CFrame.new(10, 2.3, -22), "#8B5A2B", E.Enum.Material.WoodPlanks)
	part(pw, "Top", V(8.4, 0.3, 2.9), cf * E.CFrame.new(10, 4.1, -22), "#DEB887", E.Enum.Material.Wood)
	local pwSign = part(pw, "Sign", V(6, 1.2, 0.2), cf * E.CFrame.new(10, 5.8, -21.8) * E.CFrame.Angles(0, math.pi, 0), "#F4E1C1", E.Enum.Material.Wood)
	surfaceText(pwSign, E.Enum.NormalId.Front, "PASS WINDOW", "#5A2E1E", nil)
	folder(pw, "Plates")
	prompt(counter, "snag", "Snag a plate", "Pass Window", 1.2, 9, { Enabled = false })
	billboard(counter, "LockGui", "", 5, 50, "#FFB3B3", 200, 30)

	local spawnPad = part(m, "SpawnPad", V(4, 0.2, 4), cf * E.CFrame.new(0, 1, -12), "#000000", nil, { Transparency = 1, CanCollide = false })
	spawnPad:SetAttribute("Facing", 0)
	-- smoke signal column (enabled on rare cuts)
	local sig = part(m, "SmokeSignal", V(2, 2, 2), cf * E.CFrame.new(0, 14, 20), "#000000", nil, { Transparency = 1, CanCollide = false })
	local ss = E.Instance.new("Smoke")
	ss.Name = "Signal"
	ss.Enabled = false
	ss.Size = 30
	ss.RiseVelocity = 25
	ss.Opacity = 0.6
	ss.Parent = sig
	local sigGui = billboard(sig, "SignalGui", "", 30, 1000, "#FFC83C", 420, 70)
	sigGui.Enabled = false
	sigGui.AlwaysOnTop = true
	-- VIP lights (hidden until VIP Patio pass)
	local vip = folder(m, "VIPLights")
	for li = 0, 12 do
		local x = -S / 2 + 2 + li * ((S - 4) / 12)
		ball(vip, "Bulb", 0.6, cf * E.CFrame.new(x, 7 + math.sin(li / 12 * math.pi) * -1.2, 27), li % 2 == 0 and "#FFE9A8" or "#FFB347", E.Enum.Material.Neon, { Transparency = 1, CanCollide = false })
	end
	part(vip, "Wire", V(S - 2, 0.1, 0.1), cf * E.CFrame.new(0, 7.2, 27), "#222222", nil, { Transparency = 1, CanCollide = false })
	local vipSign = part(vip, "VIPSign", V(6, 2, 0.2), cf * E.CFrame.new(-26, 5, 26.5) * E.CFrame.Angles(0, math.pi, 0), "#1A1A1A", nil, { Transparency = 1 })
	surfaceText(vipSign, E.Enum.NormalId.Front, "VIP PATIO", "#FFD700", nil).TextTransparency = 1
	-- cooler (decor)
	part(m, "Cooler", V(4, 2.4, 2.4), cf * E.CFrame.new(-26, 1.8, 10), "#2E86C1", E.Enum.Material.SmoothPlastic)
	part(m, "CoolerLid", V(4.1, 0.4, 2.5), cf * E.CFrame.new(-26, 3.2, 10), "#FFFFFF", E.Enum.Material.SmoothPlastic)
	-- lawn chair (Unc energy)
	part(m, "ChairSeat", V(2.2, 0.3, 2), cf * E.CFrame.new(26, 1.6, 10), "#2E8B57", E.Enum.Material.Fabric)
	part(m, "ChairBack", V(2.2, 2.4, 0.3), cf * E.CFrame.new(26, 2.8, 11) * E.CFrame.Angles(math.rad(-15), 0, 0), "#2E8B57", E.Enum.Material.Fabric)
	tree(m, (cf * E.CFrame.new(-27, 0.6, 27)).Position, 0.8)
	tree(m, (cf * E.CFrame.new(27, 0.6, 27)).Position, 0.9)
	return m
end

local function buildHub(root, cfg, content)
	local hub = model(root, "Hub")
	local disc = cyl(hub, "Square", 0.4, 110, E.CFrame.new(0, 0.2, 0) * E.CFrame.Angles(0, 0, math.pi / 2), "#C2A878", E.Enum.Material.Sand)
	disc.CanCollide = true
	-- paths to each plot
	for i = 1, cfg.MAX_PLOTS do
		local a = (i - 1) / cfg.MAX_PLOTS * math.pi * 2
		local mid = V(math.cos(a) * 85, 0.25, math.sin(a) * 85)
		part(hub, "Road" .. i, V(8, 0.3, 66), lookAt(mid, V(0, 0.25, 0)), "#C2A878", E.Enum.Material.Sand)
	end
	local spawn = E.Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = V(8, 0.4, 8)
	spawn.CFrame = E.CFrame.new(0, 0.5, -36)
	spawn.Color = hex("#C2A878")
	spawn.Material = E.Enum.Material.Sand
	spawn.Parent = hub

	-- Welcome arch
	local arch = model(hub, "WelcomeArch")
	part(arch, "PostL", V(1.5, 16, 1.5), E.CFrame.new(-12, 8, -50), "#6B4226", E.Enum.Material.Wood)
	part(arch, "PostR", V(1.5, 16, 1.5), E.CFrame.new(12, 8, -50), "#6B4226", E.Enum.Material.Wood)
	local beam = part(arch, "Beam", V(28, 4, 1), E.CFrame.new(0, 16, -50) * E.CFrame.Angles(0, math.pi, 0), "#8B4513", E.Enum.Material.WoodPlanks)
	surfaceText(beam, E.Enum.NormalId.Front, "🔥 " .. content.Signs.welcome .. " 🔥", "#FFE9A8", nil)
	local beamBack = part(arch, "BeamBack", V(28, 4, 0.1), E.CFrame.new(0, 16, -50.55), "#8B4513", E.Enum.Material.WoodPlanks)
	surfaceText(beamBack, E.Enum.NormalId.Front, content.Signs.hub, "#FFE9A8", nil)

	-- Sauce shack (coins) and Pitmaster Outfitters (Robux shop)
	local _, shackRoof = stall(hub, "SauceShack", E.CFrame.new(-30, 0.4, -18) * E.CFrame.Angles(0, math.rad(200), 0), content.Signs.shop, "#D9534F", "#FFFFFF", "ui:sauce", "Open Sauce Shack")
	stall(hub, "Outfitters", E.CFrame.new(30, 0.4, -18) * E.CFrame.Angles(0, math.rad(160), 0), "PITMASTER OUTFITTERS", "#2E86C1", "#FFFFFF", "ui:pitshop", "Open Pit Shop")
	-- secret on the shack roof (reach it with the trampoline)
	local roofSecret = part(hub, "RoofSecret", V(2, 0.6, 2), shackRoof.CFrame * E.CFrame.new(0, 0.6, 0), "#FFD700", E.Enum.Material.Neon, { Transparency = 0.2 })
	prompt(roofSecret, "egg:roof", "Sign the roof", "Roof Club", 0.5, 8)

	-- Cook-off stage
	local stage = model(hub, "CookOff")
	part(stage, "Stage", V(34, 1.6, 14), E.CFrame.new(0, 1, 34), "#8B5A2B", E.Enum.Material.WoodPlanks)
	local judges = part(stage, "JudgesTable", V(18, 3.2, 3), E.CFrame.new(0, 3.4, 37), "#FFFFFF", E.Enum.Material.Fabric)
	prompt(judges, "cookoff", "Enter the Cook-Off", "Judges' Table", 0.8, 14)
	local banner = part(stage, "Banner", V(30, 5, 0.4), E.CFrame.new(0, 12, 41) * E.CFrame.Angles(0, math.pi, 0), "#C0392B", E.Enum.Material.Fabric)
	surfaceText(banner, E.Enum.NormalId.Front, "🏆 " .. content.Signs.cookoff .. " 🏆", "#FFFFFF", nil).Name = "BannerText"
	part(stage, "BannerPoleL", V(0.6, 14, 0.6), E.CFrame.new(-15.5, 7, 41.2), "#6B4226", E.Enum.Material.Wood)
	part(stage, "BannerPoleR", V(0.6, 14, 0.6), E.CFrame.new(15.5, 7, 41.2), "#6B4226", E.Enum.Material.Wood)
	WorldBuilder.npc(stage, "Granny", E.CFrame.new(-4.5, 1.8, 39.2), { skin = "#C68642", shirt = "#9B59B6", pants = "#5B2C6F", shoes = "#5B2C6F", hat = "bun", hatColor = "#E4E4E4", glasses = true, pearls = true, brows = false, label = "Granny Pecan (Head Judge)", labelColor = "#F5B7B1" })
	WorldBuilder.npc(stage, "JudgeBob", E.CFrame.new(4.5, 1.8, 39.2), { skin = "#8D5524", shirt = "#27AE60", hat = "cap", hatColor = "#1E8449", beard = "#2A1E1A", belly = true, label = "Judge Big Earl" })
	local catDef = { id = "clapcat", body = "#151515", head = "#1E1E1E", scale = 0.9, ears = true }
	local cat = WorldBuilder.critter(E, stage, catDef, E.CFrame.new(0, 5, 37.3))
	cat.Name = "ClapCatJudge"
	-- leaderboard
	-- faces the square (it used to show its blank back to players), in a wood frame
	local lbCf = lookAt(V(26, 9, 36), V(4, 9, 8))
	local lb = part(stage, "Leaderboard", V(14, 16, 0.6), lbCf, "#1F2A1F", E.Enum.Material.SmoothPlastic)
	deco(stage, "LBFrame", V(15.2, 17.2, 0.5), lbCf * E.CFrame.new(0, 0, 0.45), "#6B4226", E.Enum.Material.Wood, true)
	local lbHead = deco(stage, "LBHeader", V(15.6, 1.8, 0.9), lbCf * E.CFrame.new(0, 9.0, 0), "#B22222", E.Enum.Material.SmoothPlastic, true)
	surfaceText(lbHead, E.Enum.NormalId.Front, "🏆 COOK-OFF LEADERBOARD", "#FFFFFF", nil)
	surfaceText(lb, E.Enum.NormalId.Front, "This week's Cook-Off\n(Saturday)\n\nNo entries yet", "#FFE9A8", nil).Name = "BoardText"
	part(stage, "LBLegL", V(0.6, 2, 0.6), E.CFrame.new(21, 1, 36.5), "#333333", E.Enum.Material.Metal)

	-- Unc Hank: dad jokes
	local unc = WorldBuilder.npc(hub, "UncHank", lookAt(V(-18, 0.4, 10), V(-8, 0.4, -12)), { skin = "#D1A27A", shirt = "#F39C12", pants = "#2C3E50", hat = "cap", hatColor = "#2C3E50", label = "Unc Hank", apron = "#B22222", apronText = "UNC", mustache = "#6B4A2E", belly = true, sandals = true })
	prompt(unc.Torso, "npc:unc", "Hear today's joke", "Unc Hank", 0, 10)
	-- Unc's kettle grill (the bowl keeps the UncGrill name; the scenery adds a smoke wisp to it)
	local kettle = E.CFrame.new(-22.5, 0.4, 13)
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		part(hub, "UncGrillLeg", V(0.25, 2.6, 0.25), kettle * E.CFrame.new(math.cos(a) * 0.9, 1.3, math.sin(a) * 0.9) * E.CFrame.Angles(math.sin(a) * 0.25, 0, -math.cos(a) * 0.25), "#2A2A2A", E.Enum.Material.Metal)
	end
	local bowl = sph(hub, "UncGrill", V(3.2, 2.0, 3.2), kettle * E.CFrame.new(0, 3.0, 0), "#1A1A1A", E.Enum.Material.Metal)
	bowl.CanCollide = true
	sph(hub, "UncGrillLid", V(3.1, 1.6, 3.1), kettle * E.CFrame.new(0.3, 3.9, 0.2) * E.CFrame.Angles(0, 0, math.rad(-18)), "#B22222", E.Enum.Material.Metal)
	ball(hub, "UncGrillKnob", 0.45, kettle * E.CFrame.new(0.55, 4.75, 0.2), "#C0C0C0", E.Enum.Material.Metal)

	-- The King of the Pit (cowboy hat pitmaster, hums original tunes)
	local king = WorldBuilder.npc(hub, "KingOfThePit", lookAt(V(18, 0.4, 10), V(8, 0.4, -12)), { skin = "#E0AC69", shirt = "#ECF0F1", pants = "#1F3A93", shoes = "#6B3A1E", hat = "cowboy", hatColor = "#F5F0E1", mustache = "#8A6A4A", buckle = "#F2C14E", scale = 1.05, label = "The King of the Pit", labelColor = "#F5D76E" })
	prompt(king.Torso, "npc:king", "Say howdy", "The King of the Pit", 0, 10)
	smoker(hub, "KingSmoker", E.CFrame.new(23, 0.4, 14) * E.CFrame.Angles(0, math.rad(230), 0))

	-- Temp the talking thermometer: a round red bulb with a face, a glass stem, chrome legs
	local temp = model(hub, "Temp")
	local tc = E.CFrame.new(0, 0.4, -6)
	local function tp(x, y, z, rz)
		return tc * E.CFrame.new(x, y, z) * E.CFrame.Angles(0, 0, math.rad(rz or 0))
	end
	for _, side in { -1, 1 } do
		cyl(temp, "Leg", 1.3, 0.3, tp(side * 0.6, 1.15, 0) * upright(), "#C9CED4", E.Enum.Material.Metal)
		sph(temp, "Shoe", V(0.9, 0.55, 1.3), tp(side * 0.62, 0.3, -0.25), "#D93636")
		sph(temp, "Arm", V(0.35, 1.5, 0.35), tp(side * 1.75, 2.7, -0.2, side * 38), "#C9CED4", E.Enum.Material.Metal)
		ball(temp, "Glove", 0.7, tp(side * 2.2, 2.05, -0.3), "#FFFFFF")
	end
	ball(temp, "Bulb", 3.2, tp(0, 2.7, 0), "#E74C3C")
	sph(temp, "BulbShine", V(0.4, 0.22, 0.1), tp(-0.72, 3.5, -1.3) * E.CFrame.Angles(math.rad(-30), math.rad(25), math.rad(35)), "#FF9C8C", E.Enum.Material.SmoothPlastic)
	for _, side in { -1, 1 } do
		sph(temp, "EyeWhite", V(0.75, 0.9, 0.3), tp(side * 0.55, 3.05, -1.4), "#FFFFFF")
		sph(temp, "Pupil", V(0.42, 0.55, 0.2), tp(side * 0.5, 3.0, -1.55), "#1E1614")
		sph(temp, "Shine", V(0.15, 0.15, 0.1), tp(side * 0.5 - 0.08, 3.15, -1.65), "#FFFFFF", E.Enum.Material.Neon)
		sph(temp, "Cheek", V(0.5, 0.28, 0.15), tp(side * 1.0, 2.45, -1.28), "#FF8FA3")
	end
	sph(temp, "Smile", V(1.0, 0.36, 0.2), tp(0, 2.2, -1.5), "#5A1F2E")
	sph(temp, "Tongue", V(0.4, 0.18, 0.12), tp(0.1, 2.1, -1.58), "#FF8FA3")
	local stem = cyl(temp, "Stem", 7, 1.4, tp(0, 7.5, 0) * upright(), "#ECF0F1", E.Enum.Material.Glass, { Transparency = 0.55 })
	cyl(temp, "Mercury", 5.4, 0.7, tp(0, 6.8, 0) * upright(), "#D7261E", E.Enum.Material.SmoothPlastic)
	for k = 0, 5 do
		part(temp, "Tick", V(k % 2 == 0 and 0.5 or 0.3, 0.08, 0.06), tp(0.25, 5.2 + k, -0.72), "#2A2A2A")
	end
	ball(temp, "Cap", 1.45, tp(0, 11.0, 0), "#C9CED4", E.Enum.Material.Metal)
	billboard(stem, "NameTag", "Temp", 4.6, 60, "#FFFFFF", 120, 30)
	prompt(stem, "npc:temp", "Talk to Temp", "Temp", 0, 10)

	-- Sunday potluck table with the tiny "Jesus loves you" figure (Mike's egg)
	local pot = model(hub, "Potluck")
	local potCf = E.CFrame.new(-38, 0.4, 24) * E.CFrame.Angles(0, math.rad(60), 0)
	part(pot, "Table", V(14, 0.5, 4), potCf * E.CFrame.new(0, 3, 0), "#F5F5DC", E.Enum.Material.Fabric)
	part(pot, "LegL", V(0.5, 3, 3.5), potCf * E.CFrame.new(-6, 1.5, 0), "#8B5A2B", E.Enum.Material.Wood)
	part(pot, "LegR", V(0.5, 3, 3.5), potCf * E.CFrame.new(6, 1.5, 0), "#8B5A2B", E.Enum.Material.Wood)
	local dishes = { "#F4D03F", "#E67E22", "#27AE60", "#C0392B", "#8E44AD" }
	for di, c in ipairs(dishes) do
		cyl(pot, "Dish" .. di, 0.4, 1.8, potCf * E.CFrame.new(-6 + di * 2, 3.45, -0.6) * E.CFrame.Angles(0, 0, math.pi / 2), c, E.Enum.Material.SmoothPlastic)
	end
	local psign = part(pot, "Sign", V(5, 1.2, 0.2), potCf * E.CFrame.new(-4, 4.4, 1.6), "#FFFFFF", E.Enum.Material.SmoothPlastic)
	surfaceText(psign, E.Enum.NormalId.Back, content.Signs.potluck, "#5A2E1E", nil)
	local fig = model(pot, "BlessedFigure")
	local figBase = potCf * E.CFrame.new(5.4, 3.25, 1.2)
	local figBody = part(fig, "Body", V(0.35, 0.45, 0.25), figBase * E.CFrame.new(0, 0.22, 0), "#FFFFFF", E.Enum.Material.SmoothPlastic)
	part(fig, "Sash", V(0.36, 0.45, 0.1), figBase * E.CFrame.new(0.05, 0.22, -0.1), "#C0392B", E.Enum.Material.Fabric)
	ball(fig, "Head", 0.38, figBase * E.CFrame.new(0, 0.62, 0), "#E0AC69", E.Enum.Material.SmoothPlastic)
	part(fig, "Hair", V(0.4, 0.15, 0.4), figBase * E.CFrame.new(0, 0.8, 0.02), "#6B4226", E.Enum.Material.SmoothPlastic)
	local rib = billboard(figBody, "Ribbon", "Jesus loves you ♥", 1.2, 14, "#FFD1DC", 140, 22)
	rib.Name = "Ribbon"
	prompt(figBody, "egg:blessed", "Look closer", "Tiny figure", 0.5, 6, { RequiresLineOfSight = false })

	-- Trampoline (super bounce up to the shack roof)
	local tramp = model(hub, "Trampoline")
	cyl(tramp, "Rim", 1, 12, E.CFrame.new(-44, 1.4, -2) * E.CFrame.Angles(0, 0, math.pi / 2), "#2E86C1", E.Enum.Material.SmoothPlastic)
	local mat = cyl(tramp, "Mat", 0.3, 10.5, E.CFrame.new(-44, 2, -2) * E.CFrame.Angles(0, 0, math.pi / 2), "#111111", E.Enum.Material.Fabric)
	mat.Name = "Bounce"
	mat:SetAttribute("Bounce", 140)

	-- Mosquito zone marker
	local mz = part(hub, "MosquitoZone", V(4, 4, 4), E.CFrame.new(0, 14, 0), "#000000", nil, { Transparency = 1, CanCollide = false })
	mz:SetAttribute("Radius", 40)

	-- lamp posts & trees
	for li = 0, 7 do
		local a = li / 8 * math.pi * 2 + math.pi / 8
		local p = V(math.cos(a) * 52, 0.4, math.sin(a) * 52)
		part(hub, "Lamp" .. li, V(0.6, 10, 0.6), E.CFrame.new(p + V(0, 5, 0)), "#2C3E50", E.Enum.Material.Metal)
		local bulb = ball(hub, "LampBulb" .. li, 1.4, E.CFrame.new(p + V(0, 10.4, 0)), "#FFE9A8", E.Enum.Material.Neon)
		local light = E.Instance.new("PointLight")
		light.Range = 22
		light.Brightness = 1.4
		light.Color = hex("#FFD9A0")
		light.Parent = bulb
	end
	return hub
end

local function buildCreek(root, content)
	-- Secret creek "behind" the map, through a gap in the hedge north of plot 7.
	local creek = model(root, "Creek")
	local z = -260
	for i = -8, 8 do
		if i ~= 0 then
			part(creek, "Hedge" .. i, V(12, 8, 6), E.CFrame.new(i * 12, 4, z + 30), "#2E7D32", E.Enum.Material.Grass)
		end
	end
	part(creek, "Water", V(200, 1, 18), E.CFrame.new(0, -0.1, z), "#3FA7D6", E.Enum.Material.Glass, { Transparency = 0.35, CanCollide = false })
	part(creek, "Bed", V(200, 1, 18), E.CFrame.new(0, -1.2, z), "#6B5B45", E.Enum.Material.Sand)
	for i = 1, 9 do
		ball(creek, "Rock" .. i, 2 + (i % 3), E.CFrame.new(-40 + i * 9, 0.4, z + ((i % 2 == 0) and 9 or -9)), "#8C8C8C", E.Enum.Material.Slate)
	end
	local stone = part(creek, "WhisperStone", V(4, 3, 3), E.CFrame.new(6, 1.5, z + 12), "#7F8C8D", E.Enum.Material.Slate)
	prompt(stone, "egg:creek", "Listen closely", content.Slang.quietCreek, 1, 8)
	local sign = part(creek, "Sign", V(5, 2, 0.3), E.CFrame.new(0, 3, z + 26), "#F4E1C1", E.Enum.Material.Wood)
	surfaceText(sign, E.Enum.NormalId.Back, content.Signs.creek, "#5A2E1E", nil)
	-- the World's Okayest Unc apron hanging on a branch
	part(creek, "Branch", V(0.6, 7, 0.6), E.CFrame.new(-14, 3.5, z + 14), "#6B4226", E.Enum.Material.Wood)
	local apron = part(creek, "OkayestApron", V(1.8, 2.2, 0.15), E.CFrame.new(-14, 5, z + 13.5), "#4A6FA5", E.Enum.Material.Fabric)
	surfaceText(apron, E.Enum.NormalId.Front, "WORLD'S OKAYEST UNC", "#FFFFFF", nil)
	prompt(apron, "egg:apron", "Take the apron", "Mystery apron", 0.5, 8)
	tree(creek, V(20, 0, z + 16), 1.1)
	tree(creek, V(-30, 0, z + 16), 1)
	return creek
end

-- ===================================================================================
-- Scenery: purely decorative set dressing so the world feels lived-in and Texas-y.
-- Rules: everything is Anchored; decor has CanCollide/CanQuery/CanTouch off and small
-- pieces don't cast shadows; it is grouped into Models by area (Horizon, Neighborhood,
-- HubDecor, CreekDecor, per-plot Decor) so StreamingEnabled can stream it by area, with the
-- far skyline marked Persistent. Shapes are simple blocks/balls/cylinders (cheap on phones).
-- Gameplay paths (roads, plot paths, patios, tables, pass windows) are left clear.
-- ===================================================================================
local PAL = {
	grass = "#79C84F",
	grassFar = "#8CC35E",
	berm = { "#86C25A", "#7AB852", "#93CB66" },
	oak = { "#3F8F3A", "#4FA346", "#468F3E" },
	mesquite = { "#8DB85A", "#7EA84E", "#9CC466" },
	trunk = "#6B4226",
	bluebonnet = "#3D6FE0",
	bonnetTip = "#F4F7FF",
	paintbrush = "#FF5A3C",
	susan = "#FFC72C",
	susanEye = "#4A2B12",
	hay = "#E2BE62",
	mesa = { "#D9A07A", "#CF9470", "#E2B08A" },
	mesaCap = "#B97A58",
	wood = "#A86B3C",
	fenceWood = "#8B5A2B",
	barnRed = "#C8433A",
	cream = "#FFF2D9",
	roof = "#5A4A44",
	metal = "#C7D0D8",
	water = "#3FB6E8",
	bronze = "#B8793A",
	bronzeHi = "#E6B25A",
	bulbs = { "#FFE9A8", "#FFB347", "#FF8FB1", "#8FD3FF" },
}
WorldBuilder.PALETTE = PAL

local seed = 20261101
local function rnd()
	seed = (seed * 1103515245 + 12345) % 2147483648
	return seed / 2147483648
end
local function rr(a, b)
	return a + (b - a) * rnd()
end
local function pick(t)
	return t[1 + math.floor(rnd() * #t) % #t]
end

local function at(pos)
	return E.CFrame.new(pos)
end
local function yaw(r)
	return E.CFrame.Angles(0, r, 0)
end
local function polar(deg, r, y)
	local a = math.rad(deg)
	return V(math.cos(a) * r, y or 0, math.sin(a) * r)
end
local function streaming(m, mode)
	pcall(function()
		m.ModelStreamingMode = E.Enum.ModelStreamingMode[mode]
	end)
end

-- ---------- reusable props ----------
local function liveOak(parent, pos, s, opts)
	opts = opts or {}
	local m = model(parent, "LiveOak")
	local sh = opts.shadow == true
	deco(m, "Trunk", V(2.2 * s, 8 * s, 2.2 * s), at(pos + V(0, 4 * s, 0)), PAL.trunk, E.Enum.Material.Wood, sh)
	if not opts.far then
		deco(m, "Limb", V(8 * s, 1.1 * s, 1.1 * s), at(pos + V(2.5 * s, 7.6 * s, 0)) * E.CFrame.Angles(0, 0, math.rad(18)), PAL.trunk, E.Enum.Material.Wood, false)
	end
	local c = pick(PAL.oak)
	dball(m, "Canopy", 12 * s, at(pos + V(0, 11 * s, 0)), c, E.Enum.Material.Grass, sh)
	dball(m, "Canopy2", 9.5 * s, at(pos + V(6 * s, 9.6 * s, 1.2 * s)), pick(PAL.oak), E.Enum.Material.Grass, false)
	if not opts.far then
		dball(m, "Canopy3", 9 * s, at(pos + V(-5.5 * s, 9.4 * s, -1.5 * s)), pick(PAL.oak), E.Enum.Material.Grass, false)
	end
	return m
end

local function mesquite(parent, pos, s)
	local m = model(parent, "Mesquite")
	local lean = rr(-0.25, 0.25)
	deco(m, "Trunk", V(1 * s, 7 * s, 1 * s), at(pos + V(0, 3.4 * s, 0)) * E.CFrame.Angles(lean, 0, lean * 0.6), "#5A3A22", E.Enum.Material.Wood, false)
	dball(m, "Leaves", 6.5 * s, at(pos + V(lean * 3 * s, 7.6 * s, 0)), pick(PAL.mesquite), E.Enum.Material.Grass, false)
	dball(m, "Leaves2", 5 * s, at(pos + V(2.6 * s, 6.6 * s, 1.6 * s)), pick(PAL.mesquite), E.Enum.Material.Grass, false)
	return m
end

local function grassClump(parent, pos, s)
	s = s or 1
	for k = 1, 3 do
		local a = k * 2.1 + rr(0, 0.5)
		deco(parent, "Grass", V(0.25 * s, 2.6 * s, 0.7 * s), at(pos + V(math.cos(a) * 0.4, 1.2 * s, math.sin(a) * 0.4)) * yaw(a) * E.CFrame.Angles(0, 0, rr(-0.35, 0.35)), "#9CC25A", E.Enum.Material.Grass, false)
	end
end

-- kind: "bluebonnet" | "paintbrush" | "susan" | "mix"
local function flowerPatch(parent, pos, radius, n, kind)
	local m = model(parent, "Wildflowers")
	for k = 1, n do
		local a, r = rr(0, math.pi * 2), math.sqrt(rnd()) * radius
		local p = pos + V(math.cos(a) * r, 0, math.sin(a) * r)
		local kd = kind == "mix" and pick({ "bluebonnet", "bluebonnet", "paintbrush", "susan" }) or kind
		if kd == "bluebonnet" then
			deco(m, "Bonnet", V(0.5, 1.2, 0.5), at(p + V(0, 0.6, 0)), PAL.bluebonnet, E.Enum.Material.SmoothPlastic, false)
			if k % 2 == 0 then
				dball(m, "Tip", 0.4, at(p + V(0, 1.3, 0)), PAL.bonnetTip, E.Enum.Material.SmoothPlastic, false)
			end
		elseif kd == "paintbrush" then
			deco(m, "Brush", V(0.45, 1.1, 0.45), at(p + V(0, 0.55, 0)), PAL.paintbrush, E.Enum.Material.SmoothPlastic, false)
		else
			dball(m, "Susan", 0.8, at(p + V(0, 0.9, 0)), PAL.susan, E.Enum.Material.SmoothPlastic, false)
		end
	end
	return m
end

local function hayBale(parent, pos, rot)
	return dcyl(parent, "HayBale", 4, 4.4, at(pos + V(0, 2.2, 0)) * yaw(rot or 0), PAL.hay, E.Enum.Material.Grass, true)
end

local function cooler(parent, cf, color)
	deco(parent, "Cooler", V(3.4, 2, 2), cf * E.CFrame.new(0, 1, 0), color or "#2F7BD8", E.Enum.Material.SmoothPlastic, true)
	deco(parent, "CoolerLid", V(3.5, 0.35, 2.1), cf * E.CFrame.new(0, 2.15, 0), "#FFFFFF", E.Enum.Material.SmoothPlastic, false)
end

local function lawnChair(parent, cf, color)
	deco(parent, "ChairSeat", V(2.2, 0.3, 2), cf * E.CFrame.new(0, 1.1, 0), color, E.Enum.Material.Fabric, true)
	deco(parent, "ChairBack", V(2.2, 2.4, 0.3), cf * E.CFrame.new(0, 2.2, 1) * E.CFrame.Angles(math.rad(-15), 0, 0), color, E.Enum.Material.Fabric, false)
	deco(parent, "ChairFrame", V(2.4, 1, 0.2), cf * E.CFrame.new(0, 0.5, -0.9), "#C7D0D8", E.Enum.Material.Metal, false)
end

local function cornhole(parent, cf, color)
	deco(parent, "Cornhole", V(2.4, 0.25, 4.4), cf * E.CFrame.new(0, 0.75, 0) * E.CFrame.Angles(math.rad(12), 0, 0), color, E.Enum.Material.WoodPlanks, true)
	dcyl(parent, "Hole", 0.08, 0.9, cf * E.CFrame.new(0, 1.12, 1.2) * E.CFrame.Angles(math.rad(12), 0, 0) * upright(), "#1C1A1F", E.Enum.Material.SmoothPlastic, false)
	deco(parent, "Bag", V(0.7, 0.25, 0.7), cf * E.CFrame.new(0.5, 0.9, -0.6) * yaw(0.4), "#D93636", E.Enum.Material.Fabric, false)
end

local function kiddiePool(parent, cf)
	dcyl(parent, "Pool", 1.3, 8, cf * E.CFrame.new(0, 0.65, 0) * upright(), "#5AD2FF", E.Enum.Material.SmoothPlastic, false)
	dcyl(parent, "PoolWater", 0.1, 7.2, cf * E.CFrame.new(0, 1.2, 0) * upright(), "#BFF0FF", E.Enum.Material.Glass, false).Transparency = 0.15
	dball(parent, "Ducky", 0.9, cf * E.CFrame.new(1.4, 1.5, 0.6), "#FFD23C", E.Enum.Material.SmoothPlastic, false)
	dball(parent, "DuckyHead", 0.55, cf * E.CFrame.new(1.4, 2.05, 0.3), "#FFD23C", E.Enum.Material.SmoothPlastic, false)
	deco(parent, "DuckyBeak", V(0.25, 0.12, 0.3), cf * E.CFrame.new(1.4, 2.0, 0.0), "#FF8A1E", E.Enum.Material.SmoothPlastic, false)
end

local function picnicBlanket(parent, cf)
	deco(parent, "Blanket", V(6, 0.12, 6), cf * E.CFrame.new(0, 0.08, 0), "#D93636", E.Enum.Material.Fabric, false)
	for _, o in ipairs({ { -1.5, -1.5 }, { 1.5, 1.5 } }) do
		deco(parent, "Check", V(3, 0.13, 3), cf * E.CFrame.new(o[1], 0.09, o[2]), "#FFF6E6", E.Enum.Material.Fabric, false)
	end
	deco(parent, "Basket", V(1.8, 1.1, 1.2), cf * E.CFrame.new(1.4, 0.65, -1.4), "#C9954C", E.Enum.Material.WoodPlanks, false)
	dball(parent, "Watermelon", 1.4, cf * E.CFrame.new(-1.4, 0.75, 1.2), "#3E9B4F", E.Enum.Material.SmoothPlastic, false)
end

local function lantern(parent, cf)
	deco(parent, "LanternPost", V(0.4, 6, 0.4), cf * E.CFrame.new(0, 3, 0), "#2C2420", E.Enum.Material.Metal, false)
	deco(parent, "LanternArm", V(1.6, 0.25, 0.25), cf * E.CFrame.new(0.7, 6, 0), "#2C2420", E.Enum.Material.Metal, false)
	deco(parent, "Lantern", V(0.8, 1, 0.8), cf * E.CFrame.new(1.3, 5.3, 0), "#FFD38A", E.Enum.Material.Neon, false)
end

-- Sagging string of bulbs between two points (wire + bulbs, no lights: cheap).
local function stringLights(parent, a, b, n, sag)
	local m = model(parent, "StringLights")
	local mid = (a + b) / 2 - V(0, sag * 0.6, 0)
	local len = (b - a).Magnitude
	deco(m, "Wire", V(0.08, 0.08, len), lookAt(mid, b - V(0, sag * 0.6, 0)), "#2C2420", E.Enum.Material.SmoothPlastic, false)
	for k = 1, n do
		local t = k / (n + 1)
		local p = a:Lerp(b, t) - V(0, math.sin(t * math.pi) * sag, 0)
		dball(m, "Bulb", 0.55, at(p - V(0, 0.3, 0)), PAL.bulbs[(k % #PAL.bulbs) + 1], E.Enum.Material.Neon, false)
	end
	return m
end

local function railFence(parent, a, b, spacing)
	local m = model(parent, "RailFence")
	local len = (b - a).Magnitude
	local dir = (b - a).Unit
	local posts = math.max(1, math.floor(len / spacing))
	for k = 0, posts do
		local p = a + dir * (k * len / posts)
		deco(m, "Post", V(0.7, 4.2, 0.7), at(p + V(0, 2.1, 0)), PAL.fenceWood, E.Enum.Material.Wood, false)
	end
	local mid = (a + b) / 2
	for _, h in ipairs({ 1.6, 3.2 }) do
		deco(m, "Rail", V(0.3, 0.45, len), lookAt(mid + V(0, h, 0), b + V(0, h, 0)), "#9C6B3E", E.Enum.Material.Wood, false)
	end
	return m
end

local function pickupTruck(parent, cf, color)
	local m = model(parent, "PickupTruck")
	local function p(name, size, off, c, mat)
		return deco(m, name, size, cf * off, c, mat or E.Enum.Material.SmoothPlastic, name == "Body")
	end
	p("Body", V(6.4, 2.2, 15), E.CFrame.new(0, 2.5, 0), color, E.Enum.Material.Metal)
	p("Cab", V(6.2, 2.6, 5), E.CFrame.new(0, 4.9, -1.2), color, E.Enum.Material.Metal)
	p("Windshield", V(5.6, 2, 0.15), E.CFrame.new(0, 5, -3.75), "#9FD4F0", E.Enum.Material.Glass)
	p("RearWindow", V(5.4, 1.6, 0.15), E.CFrame.new(0, 5.2, 1.35), "#9FD4F0", E.Enum.Material.Glass)
	p("BedFloor", V(5.6, 0.2, 6.8), E.CFrame.new(0, 3.65, 4.6), "#3A3A3A", E.Enum.Material.DiamondPlate)
	p("Tailgate", V(6.2, 0.25, 2.2), E.CFrame.new(0, 3.1, 8.6), color, E.Enum.Material.Metal)
	p("Bumper", V(6.6, 0.7, 0.6), E.CFrame.new(0, 1.6, -7.6), "#C7D0D8", E.Enum.Material.Metal)
	p("Grille", V(4.4, 1.2, 0.2), E.CFrame.new(0, 2.6, -7.55), "#2C2420")
	p("LightL", V(0.9, 0.6, 0.15), E.CFrame.new(-2.5, 3, -7.55), "#FFF6E6", E.Enum.Material.Neon)
	p("LightR", V(0.9, 0.6, 0.15), E.CFrame.new(2.5, 3, -7.55), "#FFF6E6", E.Enum.Material.Neon)
	for _, w in ipairs({ { -3.2, -4.6 }, { 3.2, -4.6 }, { -3.2, 4.6 }, { 3.2, 4.6 } }) do
		dcyl(m, "Wheel", 1.1, 3, cf * E.CFrame.new(w[1], 1.5, w[2]), "#1C1A1F", E.Enum.Material.SmoothPlastic, false)
	end
	cooler(m, cf * E.CFrame.new(-1.2, 3.75, 5.2), "#D93636")
	return m
end

local function houseBack(parent, cf, wall, trim)
	-- cf faces the hub (back of the house toward the players)
	local m = model(parent, "HouseBack")
	local function p(name, size, off, c, mat, sh)
		return deco(m, name, size, cf * off, c, mat or E.Enum.Material.SmoothPlastic, sh)
	end
	p("Walls", V(34, 13, 20), E.CFrame.new(0, 6.5, 10), wall, E.Enum.Material.WoodPlanks, true)
	p("RoofL", V(36, 1.2, 12.6), E.CFrame.new(0, 15.4, 4.6) * E.CFrame.Angles(math.rad(-32), 0, 0), PAL.roof, E.Enum.Material.Slate, true)
	p("RoofR", V(36, 1.2, 12.6), E.CFrame.new(0, 15.4, 15.4) * E.CFrame.Angles(math.rad(32), 0, 0), PAL.roof, E.Enum.Material.Slate, false)
	p("Chimney", V(2.6, 6, 2.6), E.CFrame.new(10, 17, 12), "#A0523D", E.Enum.Material.Brick, false)
	p("BackDoor", V(4, 7, 0.3), E.CFrame.new(-6, 3.5, -0.1), trim)
	p("WindowL", V(5, 3.6, 0.3), E.CFrame.new(4, 7.5, -0.1), "#BFE6FF", E.Enum.Material.Glass)
	p("WindowR", V(5, 3.6, 0.3), E.CFrame.new(12, 7.5, -0.1), "#BFE6FF", E.Enum.Material.Glass)
	p("Porch", V(14, 0.6, 6), E.CFrame.new(-6, 0.3, -3), PAL.wood, E.Enum.Material.WoodPlanks)
	p("ACUnit", V(3, 3, 3), E.CFrame.new(14, 1.5, -2), "#C7D0D8", E.Enum.Material.Metal)
	-- privacy fence around the backyard
	local fy, fh = 3, 6
	p("FenceBack", V(44, fh, 0.5), E.CFrame.new(0, fy, -22), "#B07A48", E.Enum.Material.WoodPlanks)
	p("FenceL", V(0.5, fh, 22), E.CFrame.new(-22, fy, -11), "#B07A48", E.Enum.Material.WoodPlanks)
	p("FenceR", V(0.5, fh, 22), E.CFrame.new(22, fy, -11), "#B07A48", E.Enum.Material.WoodPlanks)
	return m
end

local function waterTower(parent, pos, label)
	local m = model(parent, "WaterTower")
	local legH, tankY = 34, 42
	for _, o in ipairs({ { -5, -5 }, { 5, -5 }, { -5, 5 }, { 5, 5 } }) do
		deco(m, "Leg", V(1, legH, 1), at(pos + V(o[1] * 0.8, legH / 2, o[2] * 0.8)) * E.CFrame.Angles(math.rad(o[2] * 0.6), 0, math.rad(-o[1] * 0.6)), PAL.metal, E.Enum.Material.Metal, true)
	end
	deco(m, "Brace", V(10, 0.5, 0.5), at(pos + V(0, 16, -4.4)), PAL.metal, E.Enum.Material.Metal, false)
	deco(m, "Brace2", V(0.5, 0.5, 10), at(pos + V(4.4, 16, 0)), PAL.metal, E.Enum.Material.Metal, false)
	deco(m, "Catwalk", V(15, 0.5, 15), at(pos + V(0, legH + 0.5, 0)), "#8E9AA6", E.Enum.Material.DiamondPlate, false)
	dcyl(m, "Tank", 14, 16, at(pos + V(0, tankY, 0)) * upright(), "#F2F5F7", E.Enum.Material.Metal, true)
	dball(m, "Cap", 16.4, at(pos + V(0, tankY + 4, 0)), "#E1E7EC", E.Enum.Material.Metal, false)
	deco(m, "Spire", V(0.6, 4, 0.6), at(pos + V(0, tankY + 13.6, 0)), PAL.barnRed, E.Enum.Material.Metal, false)
	-- the label sits on a band facing the hub, and again on the far side
	local face = lookAt(pos + V(0, tankY, 0), V(0, tankY, 0))
	local band = deco(m, "LabelBand", V(12, 5.5, 0.4), face * E.CFrame.new(0, 0, -7.9), "#F2F5F7", E.Enum.Material.Metal, false)
	surfaceText(band, E.Enum.NormalId.Front, label, PAL.barnRed, nil)
	local back = deco(m, "LabelBandBack", V(12, 5.5, 0.4), face * E.CFrame.new(0, 0, 7.9) * yaw(math.pi), "#F2F5F7", E.Enum.Material.Metal, false)
	surfaceText(back, E.Enum.NormalId.Front, label, PAL.barnRed, nil)
	return m
end

local function windmill(parent, pos, facing)
	local m = model(parent, "Windmill")
	for _, o in ipairs({ { -3, -3 }, { 3, -3 }, { -3, 3 }, { 3, 3 } }) do
		deco(m, "Leg", V(0.6, 32, 0.6), at(pos + V(o[1] * 0.55, 16, o[2] * 0.55)) * E.CFrame.Angles(math.rad(o[2] * 1.4), 0, math.rad(-o[1] * 1.4)), PAL.metal, E.Enum.Material.Metal, true)
	end
	local hubCf = at(pos + V(0, 32.5, 0)) * yaw(facing)
	deco(m, "Head", V(1.6, 1.6, 3.4), hubCf, "#8E9AA6", E.Enum.Material.Metal, false)
	deco(m, "TailBoom", V(0.4, 0.4, 7), hubCf * E.CFrame.new(0, 0, 4.5), "#8E9AA6", E.Enum.Material.Metal, false)
	local vane = deco(m, "TailVane", V(0.2, 4, 4.5), hubCf * E.CFrame.new(0, 0.5, 8.4), PAL.barnRed, E.Enum.Material.Metal, false)
	surfaceText(vane, E.Enum.NormalId.Right, "ROCH", "#FFF2D9", nil)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		deco(m, "Blade", V(0.15, 5.5, 1.1), hubCf * E.CFrame.new(0, 0, -1.9) * E.CFrame.Angles(0, 0, a) * E.CFrame.new(0, 3.6, 0) * E.CFrame.Angles(0, 0.35, 0), "#E1E7EC", E.Enum.Material.Metal, false)
	end
	dcyl(m, "Tank", 3, 9, at(pos + V(7, 1.5, 4)) * upright(), "#9AA5AE", E.Enum.Material.Metal, false)
	return m
end

local function mesa(parent, pos, w, h, d, rot)
	-- stepped butte: wide talus skirt, sloped shoulders, sheer body, darker caprock
	local m = model(parent, "Mesa")
	local cf = at(pos) * yaw(rot)
	local c = pick(PAL.mesa)
	deco(m, "Talus", V(w * 1.3, h * 0.3, d * 1.25), cf * E.CFrame.new(0, h * 0.15 - 4, 0), PAL.mesa[3], E.Enum.Material.Sandstone, false)
	deco(m, "ShoulderL", V(w * 0.35, h * 0.55, d * 1.05), cf * E.CFrame.new(-w * 0.5, h * 0.15, 0) * E.CFrame.Angles(0, 0, math.rad(-38)), c, E.Enum.Material.Sandstone, false)
	deco(m, "ShoulderR", V(w * 0.35, h * 0.55, d * 1.05), cf * E.CFrame.new(w * 0.5, h * 0.15, 0) * E.CFrame.Angles(0, 0, math.rad(38)), c, E.Enum.Material.Sandstone, false)
	deco(m, "Body", V(w, h, d), cf * E.CFrame.new(0, h / 2 - 4, 0), c, E.Enum.Material.Sandstone, false)
	deco(m, "Cap", V(w * 1.04, 5, d * 1.04), cf * E.CFrame.new(0, h - 4, 0), PAL.mesaCap, E.Enum.Material.Sandstone, false)
	return m
end

local function fireflies(parent, cf, size)
	local box = deco(parent, "FireflyZone", size, cf, "#000000", nil, false)
	box.Transparency = 1
	if E.NumberSequence and E.NumberRange and E.ColorSequence then
		local pe = E.Instance.new("ParticleEmitter")
		pe.Name = "Fireflies"
		pe.Enabled = false -- Ambient (client) turns these on at dusk
		pe.Rate = 5
		pe.Lifetime = E.NumberRange.new(4, 7)
		pe.Speed = E.NumberRange.new(0.3, 1.2)
		pe.SpreadAngle = E.Vector2 and E.Vector2.new(180, 180) or pe.SpreadAngle
		pe.LightEmission = 1
		pe.LightInfluence = 0
		pe.Size = E.NumberSequence.new(0.22)
		pe.Color = E.ColorSequence.new(hex("#FFF27A"))
		pe.Transparency = E.NumberSequence.new(0.1)
		pe.Parent = box
		pcall(function()
			pe.Shape = E.Enum.ParticleEmitterShape.Box
			pe.ShapeStyle = E.Enum.ParticleEmitterShapeStyle.Volume
		end)
	end
	return box
end

local function leaves(parentPart)
	if not (E.NumberSequence and E.NumberRange and E.ColorSequence) then
		return
	end
	local pe = E.Instance.new("ParticleEmitter")
	pe.Name = "DriftingLeaves"
	pe.Rate = 0.5
	pe.Lifetime = E.NumberRange.new(6, 9)
	pe.Speed = E.NumberRange.new(0.5, 1.5)
	pe.Acceleration = V(0.6, -1.2, 0.4)
	pe.RotSpeed = E.NumberRange.new(-90, 90)
	pe.Rotation = E.NumberRange.new(0, 360)
	pe.Size = E.NumberSequence.new(0.35)
	pe.Color = E.ColorSequence.new(hex("#D9A441"), hex("#7FB24A"))
	pe.LightInfluence = 1
	pe.Parent = parentPart
end

local function smokeWisp(parentPart)
	local s = E.Instance.new("Smoke")
	s.Name = "Wisp"
	s.Size = 1.2
	s.Opacity = 0.08
	s.RiseVelocity = 2.5
	s.Color = hex("#E8E2D8")
	s.Parent = parentPart
end

-- ---------- Big Bertha, the hub landmark ----------
-- The King of the Pit's 1,000-gallon trailer smoker: a huge riveted barrel with a glowing
-- firebox, a tall smokestack, and a ranch dinner bell on an A-frame. Ringing the bell is the
-- "landmark:bell" prompt (daily glaze plus the 3-player Dinner Bell pile-on). The "Say
-- Brisket!" photo spot stands in front. The front faces the spawn (-Z).
local function ell(parent, name, size, cf, color, material)
	local p = deco(parent, name, size, cf, color, material or E.Enum.Material.SmoothPlastic, false)
	local mesh = E.Instance.new("SpecialMesh")
	mesh.MeshType = E.Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end
WorldBuilder.ellipsoid = ell

function WorldBuilder.bertha(parent, base, content)
	local m = model(parent, "BigBertha")
	local IRON, IRON_D, RUST, STEEL = "#3A3536", "#262223", "#7A3B22", "#B9BEC4"
	local function B(x, y, z, rx, ry, rz)
		return base * E.CFrame.new(x, y, z) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	-- brick pad
	cyl(m, "Pad", 1, 25, B(0, 0.5, 0) * upright(), "#B5654A", E.Enum.Material.Brick)
	cyl(m, "PadTrim", 0.4, 25.8, B(0, 1.05, 0) * upright(), "#D9CDB8", E.Enum.Material.Slate)
	local plaque = part(m, "Plaque", V(9, 1.6, 0.3), B(0, 0.8, -12.55), "#C9A04A", E.Enum.Material.Metal)
	surfaceText(plaque, E.Enum.NormalId.Front, content and content.Signs and content.Signs.bertha or "BIG BERTHA", "#3A2414", nil)

	-- trailer: frame, axle, two big wheels each side, tongue
	part(m, "Frame", V(20, 0.7, 6.4), B(-1, 3.4, 0), IRON_D, E.Enum.Material.Metal)
	part(m, "Tongue", V(4, 0.5, 0.6), B(10.5, 3.2, 0), IRON_D, E.Enum.Material.Metal)
	dball(m, "Hitch", 0.9, B(12.4, 3.2, 0), STEEL, E.Enum.Material.Metal, false)
	part(m, "Jack", V(0.4, 2.2, 0.4), B(11.8, 2.1, 0), STEEL, E.Enum.Material.Metal)
	for _, wx in { -4.8, -1.2 } do
		for _, wz in { -3.6, 3.6 } do
			dcyl(m, "Tire", 1.1, 3.6, B(wx, 2.8, wz, 0, 90, 0), "#1C1C1C", E.Enum.Material.SmoothPlastic, true)
			dcyl(m, "Hub", 1.2, 1.5, B(wx, 2.8, wz, 0, 90, 0), STEEL, E.Enum.Material.Metal, false)
		end
	end
	-- the barrel: 16 long, 7 across, with riveted bands and a lid seam
	local barrel = cyl(m, "Barrel", 16, 7, B(0, 7.4, 0), IRON, E.Enum.Material.Metal)
	for _, bx in { -7.3, -2.5, 2.5, 7.3 } do
		dcyl(m, "Band", 0.45, 7.25, B(bx, 7.4, 0), IRON_D, E.Enum.Material.Metal, false)
	end
	dcyl(m, "EndCapL", 0.3, 6.4, B(-8.05, 7.4, 0), RUST, E.Enum.Material.Metal, false)
	dcyl(m, "EndCapR", 0.3, 6.4, B(8.05, 7.4, 0), RUST, E.Enum.Material.Metal, false)
	deco(m, "LidSeam", V(15.2, 0.18, 0.2), B(0, 7.7, -3.55), IRON_D, E.Enum.Material.Metal, false)
	-- lid handle: a long steel bar on standoffs
	dcyl(m, "LidHandle", 10, 0.45, B(0, 7.0, -4.3), STEEL, E.Enum.Material.Metal, false)
	for _, hx in { -4.6, 4.6 } do
		deco(m, "HandlePost", V(0.3, 0.3, 0.9), B(hx, 7.0, -3.85), STEEL, E.Enum.Material.Metal, false)
	end
	-- name plate on the lid
	local nameplate = part(m, "NamePlate", V(7.4, 1.5, 0.2), B(0, 9.6, -2.82, 38, 0, 0), "#E8B04A", E.Enum.Material.Metal)
	surfaceText(nameplate, E.Enum.NormalId.Front, "BIG BERTHA", "#2A1A10", nil)
	-- dial thermometer on the lid
	dcyl(m, "Gauge", 0.35, 1.5, B(5.4, 9.6, -2.85, 38, 0, 0) * E.CFrame.Angles(0, math.rad(90), 0), "#F4F1EC", E.Enum.Material.SmoothPlastic, false)
	deco(m, "GaugeNeedle", V(0.1, 0.6, 0.08), B(5.4, 9.62, -3.04, 38, 0, 0) * E.CFrame.Angles(0, 0, math.rad(-35)), "#D93636", E.Enum.Material.SmoothPlastic, false)
	-- firebox with a glowing door
	part(m, "Firebox", V(5.2, 5.2, 5.2), B(-10.6, 6.4, 0), IRON, E.Enum.Material.Metal)
	local door = part(m, "FireDoor", V(3.2, 2.2, 0.2), B(-10.6, 5.8, -2.65), "#FF7A1A", E.Enum.Material.Neon)
	door.CanCollide = false
	for k = -1, 1 do
		deco(m, "DoorGrate", V(0.18, 2.2, 0.12), B(-10.6 + k * 0.9, 5.8, -2.78), IRON_D, E.Enum.Material.Metal, false)
	end
	dcyl(m, "Damper", 0.3, 1.6, B(-10.6, 7.9, -2.65, 0, 90, 0), STEEL, E.Enum.Material.Metal, false)
	local fire = E.Instance.new("PointLight")
	fire.Color = hex("#FF8A3D")
	fire.Range = 18
	fire.Brightness = 1.6
	fire.Parent = door
	-- logs stacked under the firebox end
	for k = 0, 2 do
		dcyl(m, "Log", 3.4, 1.0, B(-10.6, 1.6 + k * 0.85, -1.2 + (k % 2) * 1.1, 0, 90, 0), "#7A4A2A", E.Enum.Material.Wood, false)
	end
	-- smokestack with a cap and a steady plume
	local chimney = cyl(m, "Chimney", 10, 1.5, B(7.2, 15.0, 0) * upright(), IRON_D, E.Enum.Material.Metal)
	dcyl(m, "StackCap", 0.4, 2.6, B(7.2, 20.3, 0) * upright(), IRON_D, E.Enum.Material.Metal, false)
	local smoke = E.Instance.new("Smoke")
	smoke.Name = "Plume"
	smoke.Size = 5
	smoke.RiseVelocity = 6
	smoke.Opacity = 0.25
	smoke.Color = hex("#E8E8E8")
	smoke.Parent = chimney
	-- a giant brisket resting on the work shelf (it's always ready for a photo)
	part(m, "Shelf", V(5, 0.4, 2.6), B(3.5, 4.8, -4.4), "#8B5A2B", E.Enum.Material.WoodPlanks)
	ell(m, "ShowBrisket", V(3.8, 1.3, 2.0), B(3.5, 5.55, -4.4), "#4A2418", E.Enum.Material.SmoothPlastic)
	ell(m, "ShowBrisketFat", V(3.0, 0.5, 1.6), B(3.5, 6.05, -4.4), "#6E3A22", E.Enum.Material.SmoothPlastic)

	-- the dinner bell: a brass ranch bell on a wooden A-frame (the bell itself swings in Fx)
	local frameCf = B(9.5, 0, -7.5, 0, -25, 0)
	for _, sx in { -2.2, 2.2 } do
		part(m, "BellPost", V(0.8, 9.5, 0.8), frameCf * E.CFrame.new(sx, 5.5, 0), "#6B4226", E.Enum.Material.Wood)
	end
	part(m, "BellBeam", V(5.6, 0.8, 0.9), frameCf * E.CFrame.new(0, 10.4, 0), "#8B5A2B", E.Enum.Material.Wood)
	local bellModel = model(m, "DinnerBell")
	local yoke = part(bellModel, "Yoke", V(1.8, 0.5, 0.6), frameCf * E.CFrame.new(0, 9.75, 0), "#3A2414", E.Enum.Material.Wood)
	yoke.CanCollide = false
	local bell = ell(bellModel, "Bell", V(2.6, 3.0, 2.6), frameCf * E.CFrame.new(0, 8.3, 0), "#E0B040", E.Enum.Material.Foil)
	dcyl(bellModel, "BellLip", 0.45, 3.2, frameCf * E.CFrame.new(0, 7.05, 0) * upright(), "#C9962E", E.Enum.Material.Foil, false)
	dball(bellModel, "Clapper", 0.7, frameCf * E.CFrame.new(0, 6.6, 0), "#5A4520", E.Enum.Material.Metal, false)
	deco(bellModel, "Rope", V(0.15, 4.8, 0.15), frameCf * E.CFrame.new(0.9, 5.0, 0), "#D9C29A", E.Enum.Material.Fabric, false)
	bellModel.PrimaryPart = yoke
	billboard(bell, "Label", "🔔 Big Bertha's Dinner Bell", 4.2, 160, "#FFC83C", 300, 40)
	prompt(bell, "landmark:bell", "Ring the bell", "Big Bertha's Dinner Bell", 0, 14)

	-- "Say Brisket!" photo spot: a camera on a tripod aimed at Bertha (opens the share sheet)
	local cam = base * E.CFrame.new(-6, 0, -17) * E.CFrame.Angles(0, math.rad(200), 0)
	for i = 0, 2 do
		local a2 = i / 3 * math.pi * 2
		local foot = cam * E.CFrame.new(math.cos(a2) * 0.9, 0, math.sin(a2) * 0.9)
		local topP = cam * E.CFrame.new(0, 3.6, 0)
		local mid = foot.Position:Lerp(topP.Position, 0.5)
		local len = (topP.Position - foot.Position).Magnitude
		part(m, "TripodLeg", V(0.25, len, 0.25), E.CFrame.lookAt(mid, topP.Position) * E.CFrame.Angles(math.rad(90), 0, 0), "#3A2414", E.Enum.Material.Wood)
	end
	local body = part(m, "PhotoCamera", V(1.8, 1.2, 1.0), cam * E.CFrame.new(0, 4.2, 0), "#2A2B30", E.Enum.Material.SmoothPlastic)
	cyl(m, "Lens", 0.7, 0.8, cam * E.CFrame.new(0, 4.2, -0.75) * E.CFrame.Angles(0, math.rad(90), 0), "#111111", E.Enum.Material.Glass)
	local board = part(m, "PhotoSign", V(3.4, 1.2, 0.2), cam * E.CFrame.new(0, 2.2, 0.5), "#FFC83C", E.Enum.Material.SmoothPlastic)
	surfaceText(board, E.Enum.NormalId.Back, "📸 SAY BRISKET!", "#3A2414", nil)
	surfaceText(board, E.Enum.NormalId.Front, "📸 SAY BRISKET!", "#3A2414", nil)
	prompt(body, "ui:photo", "Snap & share", "Say Brisket! photo spot", 0, 10)
	-- bluebonnet bed around the pad
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + math.pi / 8
		if i == 5 or i == 6 then
			continue -- keep the plaque side clear
		end
		flowerPatch(m, (base * E.CFrame.new(math.cos(a) * 14.2, 0.4, math.sin(a) * 14.2)).Position, 1.4, 5, i % 2 == 0 and "bluebonnet" or "mix")
	end
	return m, barrel
end

-- ---------- per-plot dressing (outside every gameplay footprint) ----------
local function plotDecor(plotModel, cf, i)
	local m = model(plotModel, "Decor")
	streaming(m, "Atomic")
	local y = 0.6
	local function L(x, z)
		return cf * E.CFrame.new(x, y, z)
	end
	lantern(m, L(-30, 14))
	lantern(m, L(30, 14) * yaw(math.pi))
	local v = i % 3
	if v == 0 then
		kiddiePool(m, L(-18, -18))
	elseif v == 1 then
		cornhole(m, L(-18, -26), "#2F7BD8")
		cornhole(m, L(-18, -10) * yaw(math.pi), "#D93636")
	else
		picnicBlanket(m, L(-18, -17) * yaw(0.3))
	end
	flowerPatch(m, L(-26, -27).Position, 2.6, 9, i % 2 == 0 and "bluebonnet" or "mix")
	flowerPatch(m, L(25, -27).Position, 2.4, 8, "mix")
	hayBale(m, L(26, -17).Position - V(0, 0, 0), 0.4 + i)
	grassClump(m, L(29, -9).Position)
	grassClump(m, L(-29, -4).Position)
end
WorldBuilder.plotDecor = plotDecor

-- ---------- the big picture ----------
local function buildScenery(map, cfg, content)
	local scenery = model(map, "Scenery")
	local plots = map:FindFirstChild("Plots")
	for i = 1, cfg.MAX_PLOTS do
		local plot = plots and plots:FindFirstChild("Plot" .. i)
		if plot then
			local angle = (i - 1) / cfg.MAX_PLOTS * math.pi * 2
			local center = V(math.cos(angle) * WorldBuilder.PLOT_RADIUS, 0, math.sin(angle) * WorldBuilder.PLOT_RADIUS)
			plotDecor(plot, lookAt(center, V(0, 0, 0)), i)
		end
	end

	-- Horizon: a wide outer field, berms that hide the ground edge, a tree line beyond them
	-- and a mesa skyline. Persistent so the skyline never pops when streaming.
	local horizon = model(scenery, "Horizon")
	streaming(horizon, "Persistent")
	part(horizon, "OuterField", V(2600, 1, 2600), E.CFrame.new(0, -0.8, 0), PAL.grassFar, E.Enum.Material.Grass, { CastShadow = false })
	for side = 0, 3 do
		local rot = side * math.pi / 2
		local frame = yaw(rot)
		local t = -500
		while t <= 500 do
			local d = rr(105, 150)
			local p = frame * E.CFrame.new(t, -d * 0.33, -(455 + rr(0, 25)))
			part(horizon, "Berm", V(d, d, d), p, pick(PAL.berm), E.Enum.Material.Grass, { Shape = E.Enum.PartType.Ball, CastShadow = false })
			t += rr(50, 62)
		end
		-- tree line just past the berms
		t = -560
		while t <= 560 do
			local p = (frame * E.CFrame.new(t, 0, -(540 + rr(0, 70)))).Position
			if rnd() < 0.62 then
				liveOak(horizon, p, rr(1.7, 2.5), { far = true })
			else
				mesquite(horizon, p, rr(2.2, 3))
			end
			t += rr(36, 50)
		end
	end
	local mesas = { { 20, 1050 }, { 62, 1180 }, { 105, 980 }, { 150, 1120 }, { 196, 1040 }, { 238, 1200 }, { 300, 1000 }, { 335, 1150 } }
	for _, ms in ipairs(mesas) do
		mesa(horizon, polar(ms[1], ms[2]), rr(240, 360), rr(55, 90), rr(120, 170), math.rad(-ms[1] + 90))
	end

	-- Landmarks inside the map: ROCH water tower and a windmill, both visible from the hub.
	local landmarks = model(scenery, "Landmarks")
	streaming(landmarks, "Persistent")
	waterTower(landmarks, polar(122, 318), "ROCH")
	windmill(landmarks, polar(58, 300), math.rad(-30))

	-- Ranch fences around the property line (inside the berms)
	local fences = model(scenery, "PropertyFence")
	streaming(fences, "Atomic")
	local F = 405
	railFence(fences, V(-F, 0, F), V(F, 0, F), 30)
	railFence(fences, V(F, 0, -F), V(F, 0, F), 30)
	railFence(fences, V(-F, 0, -F), V(-F, 0, F), 30)
	railFence(fences, V(-F, 0, -F), V(-60, 0, -F), 30)
	railFence(fences, V(60, 0, -F), V(F, 0, -F), 30)

	-- Mid-ground trees between the plot ring and the edge
	local grove = model(scenery, "Grove")
	for k = 0, 17 do
		local a = k / 18 * 360 + 10
		if not (a > 250 and a < 290) then
			local p = polar(a, rr(262, 300))
			if k % 3 == 0 then
				mesquite(grove, p, rr(1.2, 1.6))
			else
				liveOak(grove, p, rr(1.1, 1.5))
			end
		end
	end
	for k = 0, 23 do
		local a = k / 24 * 360 + 7
		if not (a > 255 and a < 285) then
			local p = polar(a, rr(200, 340))
			flowerPatch(grove, p, rr(3, 6), 10, pick({ "bluebonnet", "bluebonnet", "mix", "susan" }))
			grassClump(grove, p + V(rr(-8, 8), 0, rr(-8, 8)), 1.3)
		end
	end

	-- Meadow: flat color patches (1 part each) break up the big lawn; some are bluebonnet
	-- carpets with a few flowers on top.
	local meadow = model(scenery, "Meadow")
	for k = 0, 39 do
		local a = rr(0, 360)
		local p = polar(a, rr(195, 430))
		local inCreek = p.Z < -215 and p.Z > -300 and math.abs(p.X) < 115
		if not inCreek and math.abs(p.X) < 440 and math.abs(p.Z) < 440 then
			if k % 4 == 0 then
				local d = rr(8, 14)
				dcyl(meadow, "BonnetCarpet", 0.1, d, at(p + V(0, 0.06, 0)) * upright(), "#5C7FE0", E.Enum.Material.Grass, false)
				flowerPatch(meadow, p, d * 0.4, 6, "bluebonnet")
			else
				dcyl(meadow, "MeadowPatch", 0.1, rr(18, 40), at(p + V(0, 0.05, 0)) * upright(), pick({ "#6DB843", "#8CCB55", "#A8C960", "#6DB843" }), E.Enum.Material.Grass, false)
				if k % 3 == 0 then
					grassClump(meadow, p + V(rr(-5, 5), 0, rr(-5, 5)), 1.4)
				end
			end
		end
	end

	-- Neighborhood: house backs with privacy fences beyond the tree ring, plus little scenes
	-- in the gaps between ranches.
	local hood = model(scenery, "Neighborhood")
	streaming(hood, "Atomic")
	local walls = { "#F2E6CF", "#D7E8F0", "#F6D7C3", "#E3EED2" }
	for k, a in ipairs({ 22.5, 112.5, 202.5, 337.5 }) do
		local pos = polar(a, 290)
		houseBack(hood, lookAt(pos, V(0, 0, 0)), walls[k], k % 2 == 0 and "#2F7BD8" or PAL.barnRed)
	end
	local function gap(a, r)
		local pos = polar(a, r)
		return lookAt(pos, V(0, 0, 0))
	end
	-- 67.5: tailgate party
	do
		local g = model(hood, "Tailgate")
		local cf = gap(67.5, 176)
		pickupTruck(g, cf * yaw(math.rad(100)), "#C8433A")
		lawnChair(g, cf * E.CFrame.new(-6, 0, -6) * yaw(0.5), "#1E9E4A")
		lawnChair(g, cf * E.CFrame.new(-2, 0, -8) * yaw(-0.2), "#E8590C")
		cooler(g, cf * E.CFrame.new(-4, 0, -4.5), "#2F7BD8")
		cornhole(g, cf * E.CFrame.new(6, 0, -12), "#2F7BD8")
		cornhole(g, cf * E.CFrame.new(6, 0, 2) * yaw(math.pi), "#D93636")
	end
	-- 112.5: the big oak with a tire swing and a picnic
	do
		local g = model(hood, "TireSwingOak")
		local cf = gap(112.5, 182)
		local oak = liveOak(g, cf.Position, 1.7, { shadow = true })
		leaves(oak:FindFirstChild("Canopy"))
		local branch = cf * E.CFrame.new(7, 0, 0)
		deco(g, "Rope", V(0.2, 7.5, 0.2), branch * E.CFrame.new(0, 9.6, 0), "#D9C4A8", E.Enum.Material.Fabric, false)
		dcyl(g, "Tire", 1.1, 3.6, branch * E.CFrame.new(0, 5, 0) * yaw(math.pi / 2), "#1C1A1F", E.Enum.Material.SmoothPlastic, false)
		picnicBlanket(g, cf * E.CFrame.new(-6, 0, -8) * yaw(-0.3))
	end
	-- haybales & wildflowers in the other gaps
	for _, a in ipairs({ 22.5, 157.5, 202.5, 247.5, 292.5, 337.5 }) do
		local g = model(hood, "Pasture")
		local cf = gap(a, 170)
		hayBale(g, (cf * E.CFrame.new(-4, 0, 3)).Position, a)
		hayBale(g, (cf * E.CFrame.new(1, 0, 6)).Position, a + 1)
		if a ~= 247.5 and a ~= 292.5 then
			hayBale(g, (cf * E.CFrame.new(-1.5, 4.4, 4.5)).Position, a + 2)
		end
		flowerPatch(g, (cf * E.CFrame.new(6, 0, -4)).Position, 4, 12, a % 45 == 22.5 and "bluebonnet" or "mix")
		grassClump(g, (cf * E.CFrame.new(-8, 0, -6)).Position, 1.2)
		grassClump(g, (cf * E.CFrame.new(9, 0, 8)).Position, 1.1)
	end
	do -- backyard kiddie pool + lawn chairs at 337.5 house
		local cf = lookAt(polar(337.5, 290), V(0, 0, 0))
		kiddiePool(hood, cf * E.CFrame.new(-10, 0, -12))
		lawnChair(hood, cf * E.CFrame.new(-2, 0, -12) * yaw(1.2), "#FFC83C")
		local cf2 = lookAt(polar(112.5, 290), V(0, 0, 0))
		cooler(hood, cf2 * E.CFrame.new(8, 0, -10), "#1E9E4A")
		lawnChair(hood, cf2 * E.CFrame.new(4, 0, -12) * yaw(0.4), "#2F7BD8")
	end

	-- Hub dressing: string lights between the lamp posts, hay-bale seats by the stage,
	-- smoke wisps from the pits, fireflies at dusk.
	local hubDecor = model(scenery, "HubDecor")
	for li = 0, 7 do
		local a0 = li / 8 * math.pi * 2 + math.pi / 8
		local a1 = (li + 1) / 8 * math.pi * 2 + math.pi / 8
		local p0 = V(math.cos(a0) * 52, 10.1, math.sin(a0) * 52)
		local p1 = V(math.cos(a1) * 52, 10.1, math.sin(a1) * 52)
		stringLights(hubDecor, p0, p1, 7, 1.6)
	end
	for _, o in ipairs({ { -24, 30 }, { -28, 36 }, { 32, 27 } }) do
		hayBale(hubDecor, V(o[1], 0.4, o[2]), o[1] * 0.1)
	end
	local hubMap = map:FindFirstChild("Hub")
	if hubMap then
		local ks = hubMap:FindFirstChild("KingSmoker")
		local ch = ks and ks:FindFirstChild("Chimney")
		if ch then
			smokeWisp(ch)
		end
		local ug = hubMap:FindFirstChild("UncGrill")
		if ug then
			smokeWisp(ug)
		end
	end
	fireflies(hubDecor, E.CFrame.new(0, 5, 0), V(100, 8, 100))
	fireflies(hubDecor, E.CFrame.new(0, 4, -262), V(160, 6, 30))
	fireflies(hubDecor, E.CFrame.new(0, 5, 230), V(200, 8, 60))
	-- The landmark itself lives in the hub so it's on the spawn sightline.
	WorldBuilder.bertha(hubDecor, E.CFrame.new(0, 0.4, 14), content)

	-- Creek dressing: a footbridge, cattails, more rocks, lily pads.
	local creekDecor = model(scenery, "CreekDecor")
	streaming(creekDecor, "Atomic")
	local z = -260
	local bx = 42
	part(creekDecor, "BridgeDeck", V(9, 0.6, 26), E.CFrame.new(bx, 1.2, z), PAL.wood, E.Enum.Material.WoodPlanks)
	part(creekDecor, "BridgeRampN", V(9, 0.6, 6), E.CFrame.new(bx, 0.6, z + 15.5) * E.CFrame.Angles(math.rad(-10), 0, 0), PAL.wood, E.Enum.Material.WoodPlanks)
	part(creekDecor, "BridgeRampS", V(9, 0.6, 6), E.CFrame.new(bx, 0.6, z - 15.5) * E.CFrame.Angles(math.rad(10), 0, 0), PAL.wood, E.Enum.Material.WoodPlanks)
	for _, sx in ipairs({ -4.3, 4.3 }) do
		deco(creekDecor, "Rail", V(0.4, 0.4, 26), E.CFrame.new(bx + sx, 4.2, z), "#8B5A2B", E.Enum.Material.Wood, false)
		for _, pz in ipairs({ -12, 0, 12 }) do
			deco(creekDecor, "RailPost", V(0.5, 3, 0.5), E.CFrame.new(bx + sx, 2.8, z + pz), "#8B5A2B", E.Enum.Material.Wood, false)
		end
	end
	for k = 1, 16 do
		local x = -90 + k * 11 + rr(-3, 3)
		local zz = z + ((k % 2 == 0) and 9.8 or -9.8) + rr(-0.6, 0.6)
		if math.abs(x - bx) > 7 then
			deco(creekDecor, "CattailStem", V(0.2, 4.2, 0.2), E.CFrame.new(x, 2.1, zz) * E.CFrame.Angles(rr(-0.15, 0.15), 0, rr(-0.15, 0.15)), "#6E8F3A", E.Enum.Material.Grass, false)
			deco(creekDecor, "Cattail", V(0.5, 1.3, 0.5), E.CFrame.new(x, 3.9, zz), "#6B4226", E.Enum.Material.Fabric, false)
			deco(creekDecor, "CattailLeaf", V(0.15, 3.2, 0.5), E.CFrame.new(x + 0.4, 1.6, zz) * E.CFrame.Angles(0, 0.6, 0.3), "#7FA650", E.Enum.Material.Grass, false)
		end
	end
	for k = 1, 8 do
		dball(creekDecor, "Rock", rr(1.8, 3.6), E.CFrame.new(-95 + k * 23, 0.3, z + rr(-8, 8)), pick({ "#8C8C8C", "#9C9284", "#7F8C8D" }), E.Enum.Material.Slate, false)
	end
	for k = 1, 5 do
		dcyl(creekDecor, "LilyPad", 0.1, rr(1.6, 2.4), E.CFrame.new(-60 + k * 22, 0.45, z + rr(-5, 5)) * upright(), "#4FA346", E.Enum.Material.Grass, false)
	end
	mesquite(creekDecor, V(-62, 0, z - 16), 1.3)
	liveOak(creekDecor, V(70, 0, z - 18), 1.3)

	-- Ambient critters (moved around by the Ambient client script; purely cosmetic).
	local critters = folder(scenery, "Critters")
	local spots = {
		{ "armadillo", polar(45, 186), 16, 3 },
		{ "roadrunner", polar(200, 192), 24, 9 },
		{ "hornedtoad", V(30, 0, -244), 10, 2 },
		{ "possum", polar(150, 200), 14, 3 },
		{ "armadillo", polar(318, 195), 14, 3 },
	}
	local defs = {}
	for _, d in ipairs(cfg.Critters or {}) do
		defs[d.id] = d
	end
	for _, sp in ipairs(spots) do
		local def = defs[sp[1]]
		if def then
			local cm = WorldBuilder.critter(E, critters, def, E.CFrame.new(sp[2] + V(0, 0.9 * (def.scale or 1), 0)))
			for _, d in ipairs(cm:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.CastShadow = false
				elseif d:IsA("ProximityPrompt") or d:IsA("BillboardGui") then
					d:Destroy()
				end
			end
			cm.Name = "Wild_" .. def.id
			cm:SetAttribute("Range", sp[3])
			cm:SetAttribute("Speed", sp[4])
		end
	end

	-- Clouds (Terrain child) when building inside a real place.
	pcall(function()
		local terrain = map.Parent and map.Parent:FindFirstChildOfClass("Terrain")
		if terrain and not terrain:FindFirstChildOfClass("Clouds") then
			local clouds = E.Instance.new("Clouds")
			clouds.Cover = 0.55
			clouds.Density = 0.55
			clouds.Color = hex("#FFF6EC")
			clouds.Parent = terrain
		end
	end)
	return scenery
end
WorldBuilder.buildScenery = buildScenery

-- Build everything under `parent` (Workspace). Returns the Map model.
function WorldBuilder.build(env, parent, cfg, content)
	E = env
	local map = model(parent, "Map")
	part(map, "Ground", V(900, 2, 900), E.CFrame.new(0, -1, 0), "#79C84F", E.Enum.Material.Grass)
	local plots = folder(map, "Plots")
	for i = 1, cfg.MAX_PLOTS do
		buildPlot(plots, i, cfg)
	end
	buildHub(map, cfg, content)
	buildCreek(map, content)
	-- scatter trees around the edge
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local r = 215 + (i % 3) * 12
		if not (a > math.rad(255) and a < math.rad(285)) then
			tree(map, V(math.cos(a) * r, 0, math.sin(a) * r), 1 + (i % 2) * 0.3)
		end
	end
	buildScenery(map, cfg, content)
	return map
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="26">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="27">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="28">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point: builds remotes, wires every service together, starts them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Services = script.Parent:WaitForChild("Services")

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local action = Instance.new("RemoteFunction")
action.Name = "Action"
action.Parent = remotes
local push = Instance.new("RemoteEvent")
push.Name = "Push"
push.Parent = remotes
remotes.Parent = ReplicatedStorage

Players.CharacterAutoLoads = true

local ctx = {
	Data = require(Services.DataService),
	World = require(Services.WorldService),
	Game = require(Services.GameService),
	Social = require(Services.SocialService),
	Event = require(Services.EventService),
	Egg = require(Services.EggService),
	Cosmetics = require(Services.CosmeticService),
	Purchase = require(Services.PurchaseService),
	Remotes = { Action = action, Push = push },
}

-- World first: it builds the map if it wasn't baked into the place file.
local order = { "World", "Game", "Social", "Event", "Egg", "Cosmetics", "Purchase" }
for _, name in ipairs(order) do
	local svc = (ctx :: any)[name]
	if svc.init then
		svc.init(ctx)
	end
end
ctx.Data.start()
for _, name in ipairs({ "World", "Social", "Event", "Egg", "Cosmetics", "Purchase", "Game" }) do
	local svc = (ctx :: any)[name]
	if svc.start then
		svc.start()
	end
end
print("[Backyard Smokeout] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[--!strict
-- CosmeticService — puts hats, aprons, tools, bandanas, socks & sandals, trails and title tags on
-- characters. Everything is built from Parts (no uploaded meshes) and welded to the character.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)

local CosmeticService = {}
local ctx: any = nil

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

local function weldPart(parent: Instance, attachTo: BasePart, name: string, size: Vector3, offset: CFrame, color: string, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = hex(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CFrame = attachTo.CFrame * offset
	p.Parent = parent
	local w = Instance.new("WeldConstraint")
	w.Part0 = attachTo
	w.Part1 = p
	w.Parent = p
	return p
end

local function find(char: Model, ...: string): BasePart?
	for _, n in ipairs({ ... }) do
		local p = char:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return nil
end

local function buildHat(folder: Folder, head: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local top = head.Size.Y / 2
	if id == "hat_turkey" then
		weldPart(folder, head, "HatBody", Vector3.new(1.4, 0.9, 1.6), CFrame.new(0, top + 0.4, 0), def.color)
		weldPart(folder, head, "HatHead", Vector3.new(0.5, 0.6, 0.5), CFrame.new(0, top + 0.9, -0.7), "#C0392B")
		for k = -2, 2 do
			weldPart(folder, head, "Feather", Vector3.new(0.35, 1.2, 0.15), CFrame.new(k * 0.3, top + 1, 0.7) * CFrame.Angles(0, 0, math.rad(k * 14)), k % 2 == 0 and "#E67E22" or "#8B4513")
		end
		return
	end
	local brim = weldPart(folder, head, "HatBrim", Vector3.new(0.15, 2.6, 2.6), CFrame.new(0, top + 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2), def.color)
	brim.Shape = Enum.PartType.Cylinder
	weldPart(folder, head, "HatCrown", Vector3.new(1.3, 0.8, 1.4), CFrame.new(0, top + 0.55, 0), def.color)
	weldPart(folder, head, "HatBand", Vector3.new(1.32, 0.18, 1.42), CFrame.new(0, top + 0.25, 0), id == "hat_pitmaster" and "#C9A227" or "#7B3F00")
end

local function buildApron(folder: Folder, torso: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local front = -torso.Size.Z / 2 - 0.06
	local apron = weldPart(folder, torso, "Apron", Vector3.new(torso.Size.X * 0.8, torso.Size.Y * 1.05, 0.1), CFrame.new(0, -0.15, front), def.color, Enum.Material.Fabric)
	if def.text then
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.PixelsPerStud = 60
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.LightInfluence = 0.6
		sg.Parent = apron
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(0.9, 0.5)
		tl.Position = UDim2.fromScale(0.05, 0.15)
		tl.BackgroundTransparency = 1
		tl.TextScaled = true
		tl.Font = Enum.Font.FredokaOne
		tl.TextColor3 = Color3.new(1, 1, 1)
		tl.Text = def.text
		tl.Parent = sg
	end
	weldPart(folder, torso, "ApronPocket", Vector3.new(0.8, 0.4, 0.05), CFrame.new(0, -0.6, front - 0.06), "#FFFFFF", Enum.Material.Fabric).Transparency = 0.6
end

local function buildTool(folder: Folder, hand: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local mat = Enum.Material.Foil
	local handle = weldPart(folder, hand, "ToolHandle", Vector3.new(0.2, 0.2, 1.4), CFrame.new(0, -hand.Size.Y / 2 - 0.1, -0.6), def.color, mat)
	if id == "tool_goldtongs" then
		weldPart(folder, hand, "TongA", Vector3.new(0.12, 0.12, 1.2), CFrame.new(-0.12, -hand.Size.Y / 2 - 0.1, -1.6) * CFrame.Angles(0, math.rad(6), 0), def.color, mat)
		weldPart(folder, hand, "TongB", Vector3.new(0.12, 0.12, 1.2), CFrame.new(0.12, -hand.Size.Y / 2 - 0.1, -1.6) * CFrame.Angles(0, math.rad(-6), 0), def.color, mat)
	else
		weldPart(folder, hand, "SpatulaHead", Vector3.new(0.8, 0.06, 0.9), CFrame.new(0, -hand.Size.Y / 2 - 0.1, -1.7), def.color, mat)
	end
	local sp = Instance.new("Sparkles")
	sp.SparkleColor = hex(def.color)
	sp.Parent = handle
end

local function buildNeck(folder: Folder, torso: BasePart, id: string)
	local def = Config.Cosmetics[id]
	weldPart(folder, torso, "Bandana", Vector3.new(torso.Size.X * 0.7, 0.35, torso.Size.Z + 0.2), CFrame.new(0, torso.Size.Y / 2 - 0.1, 0), def.color, Enum.Material.Fabric)
	local tri = Instance.new("WedgePart")
	tri.Name = "BandanaTip"
	tri.Size = Vector3.new(0.1, 0.6, 0.6)
	tri.Color = hex(def.color)
	tri.Material = Enum.Material.Fabric
	tri.CanCollide = false
	tri.Massless = true
	tri.CFrame = torso.CFrame * CFrame.new(0, torso.Size.Y / 2 - 0.5, -torso.Size.Z / 2 - 0.1) * CFrame.Angles(0, math.pi / 2, math.pi)
	tri.Parent = folder
	local w = Instance.new("WeldConstraint")
	w.Part0 = torso
	w.Part1 = tri
	w.Parent = tri
end

local function buildFeet(folder: Folder, char: Model)
	for _, side in ipairs({ "Left", "Right" }) do
		local foot = find(char, side .. "Foot", side .. " Leg")
		if foot then
			local bottom = -foot.Size.Y / 2
			weldPart(folder, foot, side .. "Sock", Vector3.new(foot.Size.X + 0.06, 0.5, foot.Size.Z + 0.06), CFrame.new(0, bottom + 0.4, 0), "#FFFFFF", Enum.Material.Fabric)
			weldPart(folder, foot, side .. "Sandal", Vector3.new(foot.Size.X + 0.15, 0.12, foot.Size.Z + 0.3), CFrame.new(0, bottom + 0.02, -0.05), "#6B4226", Enum.Material.Leather)
			weldPart(folder, foot, side .. "Strap", Vector3.new(foot.Size.X + 0.12, 0.1, 0.2), CFrame.new(0, bottom + 0.25, -0.2), "#3B2A1A", Enum.Material.Leather)
		end
	end
end

local function buildTrail(folder: Folder, hrp: BasePart, id: string)
	local def = Config.Cosmetics[id]
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA"
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailB"
	a1.Position = Vector3.new(0, -1.2, 0)
	a1.Parent = hrp
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.7
	tr.LightEmission = id == "trail_sauce" and 0 or 0.6
	tr.Color = ColorSequence.new(hex(def.color), id == "trail_firework" and hex("#FFD700") or hex(def.color))
	tr.Transparency = NumberSequence.new(0.1, 1)
	tr.WidthScale = NumberSequence.new(1, 0.2)
	tr.Parent = folder
	-- attachments live on the HRP, tag them so we can clean up
	a0:SetAttribute("BSCosmetic", true)
	a1:SetAttribute("BSCosmetic", true)
end

local function buildTag(folder: Folder, head: BasePart, player: Player, data: any, resting: boolean, vip: boolean)
	local bb = Instance.new("BillboardGui")
	bb.Name = "TitleTag"
	bb.Size = UDim2.new(0, 220, 0, 56)
	bb.StudsOffset = Vector3.new(0, 3.2, 0)
	bb.MaxDistance = 90
	bb.Adornee = head
	bb.LightInfluence = 0
	bb.Parent = folder
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 0.5)
	title.BackgroundTransparency = 1
	title.TextScaled = true
	title.Font = Enum.Font.FredokaOne
	title.TextStrokeTransparency = 0.4
	title.TextColor3 = vip and hex("#FFD700") or hex("#FFE9A8")
	local rankName = Config.Ranks[data.rank] and Config.Ranks[data.rank].name or ""
	local t = data.title ~= "" and data.title or rankName
	title.Text = (vip and "✨ " or "") .. t
	title.Parent = bb
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.Size = UDim2.fromScale(1, 0.45)
	sub.Position = UDim2.fromScale(0, 0.52)
	sub.BackgroundTransparency = 1
	sub.TextScaled = true
	sub.Font = Enum.Font.GothamMedium
	sub.TextStrokeTransparency = 0.5
	sub.TextColor3 = Color3.new(1, 1, 1)
	sub.Text = resting and Content.Slang.resting or ""
	sub.Parent = bb
	local _ = player
end

function CosmeticService.apply(player: Player)
	local char = player.Character
	local data = ctx.Game.dataOf(player)
	if not char or not data then
		return
	end
	local old = char:FindFirstChild("BSCosmetics")
	if old then
		old:Destroy()
	end
	local hrp = find(char, "HumanoidRootPart")
	if hrp then
		for _, a in ipairs(hrp:GetChildren()) do
			if a:GetAttribute("BSCosmetic") then
				a:Destroy()
			end
		end
	end
	local head = find(char, "Head")
	local torso = find(char, "UpperTorso", "Torso")
	local hand = find(char, "RightHand", "Right Arm")
	if not head or not torso then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "BSCosmetics"
	local eq = data.equipped
	local r = ctx.Game.runtime[player]
	local ok, err = pcall(function()
		if eq.hat and data.owned[eq.hat] then
			buildHat(folder, head, eq.hat)
		end
		if eq.apron and data.owned[eq.apron] then
			buildApron(folder, torso, eq.apron)
		end
		if eq.tool and data.owned[eq.tool] and hand then
			buildTool(folder, hand, eq.tool)
		end
		if eq.neck and data.owned[eq.neck] then
			buildNeck(folder, torso, eq.neck)
		end
		if eq.feet and data.owned[eq.feet] then
			buildFeet(folder, char)
		end
		if eq.trail and data.owned[eq.trail] and hrp then
			buildTrail(folder, hrp, eq.trail)
		end
		buildTag(folder, head, player, data, r ~= nil and r.resting, ctx.Game.hasPass(player, "VIPPatio"))
	end)
	if not ok then
		warn("[CosmeticService] " .. tostring(err))
	end
	folder.Parent = char
end

function CosmeticService.init(c: any)
	ctx = c
end

function CosmeticService.start()
	-- Rainbow Sherbet smoke cycles colors on the owner's smokers.
	task.spawn(function()
		local hue = 0
		while true do
			task.wait(0.4)
			hue = (hue + 0.03) % 1
			for _, player in ipairs(Players:GetPlayers()) do
				local data = ctx.Game.dataOf(player)
				if data and data.equipped.smoke == "smoke_sherbet" then
					local plot = ctx.World.plotModel(player)
					if plot then
						for _, s in ipairs(plot.Smokers:GetChildren()) do
							local ch = s:FindFirstChild("Chimney")
							local sm = ch and ch:FindFirstChild("Smoke") :: Smoke?
							if sm then
								sm.Color = Color3.fromHSV(hue, 0.45, 1)
							end
						end
					end
				end
			end
		end
	end)
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — DataStore persistence with session locking, retries and safe shutdown.

	Record format in the DataStore: { lock = { jobId, time }?, data = <player data> }
	  * Load: UpdateAsync acquires the lock. If another live server holds it (player hopped
	    servers and the old one is still saving), we wait and retry; a lock older than
	    STALE_LOCK seconds is treated as abandoned.
	  * Autosave every Config.AUTOSAVE_SECONDS refreshes the lock.
	  * Leave / shutdown: final save releases the lock.
	  * If we ever lose the lock, we stop saving for that player (never overwrite newer data).
	  * In Studio without "Enable Studio Access to API Services", we run in memory-only mode.
]]
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DefaultData = require(Shared.DefaultData)
local SessionLock = require(Shared.Logic.SessionLock)
local Reconcile = require(Shared.Logic.Reconcile)

local STORE_NAME = "BackyardSmokeout_Players_v1"
local STALE_LOCK = 300 -- seconds
local LOAD_ATTEMPTS = 8
local SAVE_ATTEMPTS = 4

export type Profile = {
	player: Player,
	key: string,
	data: any,
	memoryOnly: boolean,
	lostLock: boolean,
	saving: boolean,
	released: boolean,
	loadedAt: number,
}

local DataService = {}
DataService.profiles = {} :: { [Player]: Profile }
DataService.onLoaded = Instance.new("BindableEvent")

local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))
local store: DataStore? = nil
local _storeError: string? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		local why = tostring(result)
		_storeError = why
		warn("[DataService] DataStore unavailable: " .. why)
	end
end

local function keyFor(userId: number): string
	return "u_" .. tostring(userId)
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	local tries = 0
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and tries < 20 do
		tries += 1
		task.wait(0.5)
	end
end

local function isApiAccessError(err: string): boolean
	return string.find(err, "403", 1, true) ~= nil
		or string.find(string.lower(err), "studio", 1, true) ~= nil
		or string.find(string.lower(err), "api services", 1, true) ~= nil
end

local function freshData(): any
	return Reconcile.deepCopy(DefaultData)
end

function DataService.get(player: Player): Profile?
	return DataService.profiles[player]
end

function DataService.waitFor(player: Player, timeout: number): Profile?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < timeout do
		local p = DataService.profiles[player]
		if p then
			return p
		end
		task.wait(0.2)
	end
	return DataService.profiles[player]
end

function DataService.load(player: Player): Profile?
	local key = keyFor(player.UserId)
	local memoryOnly = false
	local data = nil

	if store == nil then
		memoryOnly = true
	else
		local s = store :: DataStore
		for attempt = 1, LOAD_ATTEMPTS do
			if not player.Parent then
				return nil
			end
			waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
			local status = "error"
			local loaded = nil
			local ok, err = pcall(function()
				s:UpdateAsync(key, function(old)
					local rec, st = SessionLock.acquire(old, jobId, os.time(), STALE_LOCK)
					status = st
					if rec then
						loaded = rec.data
					end
					return rec
				end)
			end)
			if ok and (status == "acquired" or status == "stale-taken") then
				data = loaded
				break
			elseif ok and status == "locked" then
				-- Another server is still finishing this player's save. Wait for it.
				task.wait(math.min(2 * attempt, 8))
			else
				local msg = tostring(err)
				warn(string.format("[DataService] load attempt %d failed for %s: %s", attempt, player.Name, msg))
				if RunService:IsStudio() and isApiAccessError(msg) then
					memoryOnly = true
					break
				end
				task.wait(math.min(2 ^ attempt, 16))
			end
			if attempt == LOAD_ATTEMPTS then
				player:Kick("We couldn't load your ranch safely (Roblox servers are busy). Please rejoin in a minute. Your progress is safe.")
				return nil
			end
		end
	end

	if not player.Parent then
		-- Left while loading: release the lock we just took.
		if not memoryOnly and store then
			pcall(function()
				(store :: DataStore):UpdateAsync(key, function(old)
					if old and old.lock and old.lock.jobId == jobId then
						old.lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return nil
	end

	local isNew = data == nil
	data = Reconcile.fill(data or freshData(), DefaultData)
	local profile: Profile = {
		player = player,
		key = key,
		data = data,
		memoryOnly = memoryOnly,
		lostLock = false,
		saving = false,
		released = false,
		loadedAt = os.time(),
	}
	DataService.profiles[player] = profile
	DataService.onLoaded:Fire(player, profile, isNew)
	return profile
end

-- Returns true if the data is safely in the DataStore.
function DataService.save(profile: Profile, release: boolean): boolean
	if profile.memoryOnly then
		return true
	end
	if profile.lostLock or store == nil then
		return false
	end
	-- Don't run two saves for the same player at once.
	local waited = 0
	while profile.saving and waited < 30 do
		task.wait(0.25)
		waited += 0.25
	end
	profile.saving = true
	profile.data.lastSeen = os.time()
	local s = store :: DataStore
	local saved = false
	for attempt = 1, SAVE_ATTEMPTS do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local status = "error"
		local ok, err = pcall(function()
			s:UpdateAsync(profile.key, function(old)
				local rec, st = SessionLock.save(old, jobId, os.time(), profile.data, release)
				status = st
				return rec
			end)
		end)
		if ok and status == "saved" then
			saved = true
			break
		elseif ok and status == "lost-lock" then
			warn("[DataService] lost session lock for " .. profile.key .. "; not overwriting newer data")
			profile.lostLock = true
			break
		else
			warn(string.format("[DataService] save attempt %d failed for %s: %s", attempt, profile.key, tostring(err)))
			task.wait(math.min(2 ^ attempt, 8))
		end
	end
	profile.saving = false
	if release and saved then
		profile.released = true
	end
	return saved
end

function DataService.release(player: Player)
	local profile = DataService.profiles[player]
	if not profile then
		return
	end
	DataService.save(profile, true)
	DataService.profiles[player] = nil
end

function DataService.isStudioMemoryMode(player: Player): boolean
	local p = DataService.profiles[player]
	return p ~= nil and p.memoryOnly
end

function DataService.start()
	-- Autosave loop (also refreshes our session locks).
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, profile in pairs(DataService.profiles) do
				task.spawn(DataService.save, profile, false)
				task.wait(0.5) -- spread requests out
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and store == nil then
			return
		end
		local pending = 0
		for player, _ in pairs(DataService.profiles) do
			pending += 1
			task.spawn(function()
				DataService.release(player)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
end

-- NOTE: GameService handles PlayerRemoving (settles cooks first) and then calls DataService.release.

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">EggService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EggService — every ProximityPrompt the server handles, plus NPC dialogue and Easter eggs.
	Prompts carry a "Kind" attribute set by WorldBuilder. Kinds starting with "ui:" and
	"npc:unc" are handled by the client (they only open UI or call a normal Action).

	Easter eggs (all original):
	  blessed  - a tiny figure on the Sunday potluck table holding a "Jesus loves you" ribbon
	  roof     - bounce off the trampoline onto the Sauce Shack roof ("Roof Club")
	  creek    - the whisper stone past the hedge gap: "Shhh... quiet on the creek." (daily sauce)
	  apron    - the World's Okayest Unc apron hanging by the creek
	  king     - visit the King of the Pit after dark wearing a cowboy hat
	  temp     - Temp the thermometer has a thing to say if you keep poking him
	  rex      - Rex visits your ranch ("RAWR means I love you")
	  meteorite- cook a Meteorite cut
	  cooked   - get a "Cooked" rating from Granny Pecan
	  sixseven - serve a plate worth ...67 coins ("6-7!")
	  dinnerbell - be one of 3 players who ring Big Bertha's dinner bell together (server-wide tip bonus)
]]
local ProximityPromptService = game:GetService("ProximityPromptService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Hype = require(Shared.Logic.Hype)

local EggService = {}
local ctx: any = nil
local rng = Random.new()
local tempPokes: { [Player]: number } = {}

EggService.EGGS = { "blessed", "roof", "creek", "apron", "king", "temp", "rex", "meteorite", "cooked", "sixseven", "dinnerbell" }

local bellRings: { [number]: number } = {}
local lastDinner = -1e9

local function today(): number
	return TimeUtil.dayNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

local function dialog(player: Player, npc: string, text: string, reward: number?)
	ctx.Remotes.Push:FireClient(player, "dialog", { npc = npc, text = text, reward = reward or 0 })
end

function EggService.found(player: Player, data: any, egg: string): boolean
	if data.eggs[egg] then
		return false
	end
	data.eggs[egg] = true
	local n = 0
	for _, e in ipairs(EggService.EGGS) do
		if data.eggs[e] then
			n += 1
		end
	end
	ctx.Game.toast(player, string.format("🥚 Secret found! (%d/%d)", n, #EggService.EGGS), "good")
	if n == #EggService.EGGS then
		data.titles["Egg Hunter"] = true
		ctx.Game.toast(player, "You found every secret! New title: Egg Hunter", "good")
	end
	ctx.Game.markDirty(player)
	return true
end

local function ownsPrompt(player: Player, prompt: ProximityPrompt): boolean
	return prompt:GetAttribute("OwnerUserId") == player.UserId
end

local function customerFor(player: Player, prompt: ProximityPrompt): any?
	if not ownsPrompt(player, prompt) then
		return nil
	end
	local id = prompt:GetAttribute("CustomerId")
	if typeof(id) ~= "number" then
		return nil
	end
	return ctx.World.findCustomer(player, id)
end

local handlers: { [string]: (Player, any, ProximityPrompt) -> () } = {}

handlers.serve = function(player, _data, prompt)
	local c = customerFor(player, prompt)
	if c then
		ctx.Game.advanceAll(player, ctx.Game.dataOf(player), workspace:GetServerTimeNow(), true)
		local ok, msg = ctx.Game.serveCustomer(player, c)
		if not ok and msg then
			ctx.Game.toast(player, msg, "info")
		end
	end
end

handlers.bellyrub = function(player, _data, prompt)
	local c = customerFor(player, prompt)
	if c then
		ctx.Game.bellyRub(player, c)
	end
end

handlers.wash = function(player, _data, prompt)
	local c = customerFor(player, prompt)
	if c then
		ctx.Game.washPup(player, c)
		prompt:Destroy()
	end
end

handlers.snag = function(player, _data, prompt)
	ctx.Social.trySnag(player, prompt)
end

handlers.catch = function(player, _data, prompt)
	ctx.Social.tryCatch(player, prompt)
end

handlers.cookoff = function(player)
	ctx.Event.enterCookOff(player)
end

handlers["npc:king"] = function(player, data)
	local line = Content.KingLines[rng:NextInteger(1, #Content.KingLines)]
	local hat = data.equipped.hat
	local cowboy = hat == "hat_pitmaster" or hat == "hat_straw"
	if ctx.Event.isNight() and cowboy and not data.daily.kingDone then
		data.daily.kingDone = true
		ctx.Game.addSauce(data, "straitshootin")
		EggService.found(player, data, "king")
		dialog(player, "The King of the Pit", "Well now, that's a fine hat, partner. A pitmaster after dark is a pitmaster for life.\nTake a bottle of my Strait-Shootin' Sauce. Don't tell Unc.\n\n(Strait-Shootin' Sauce: +30% cook speed for 3 cooks)")
	elseif not data.daily.kingDone then
		dialog(player, "The King of the Pit", line .. "\n\n(He tips his hat.) Come see me after sundown in a proper cowboy hat, partner.")
	else
		dialog(player, "The King of the Pit", line)
	end
end

handlers["npc:temp"] = function(player, data)
	local night = ctx.Event.isNight()
	local pool = night and Content.TempNight or Content.TempDay
	tempPokes[player] = (tempPokes[player] or 0) + 1
	if tempPokes[player] >= 7 and not data.eggs.temp then
		EggService.found(player, data, "temp")
		ctx.Game.addCoins(player, data, 300, true)
		dialog(player, "Temp", "Okay okay, you got me. I don't actually know what temperature it is. I'm a thermometer with stage fright.\nHere's 300 coins to keep it between us.", 300)
		return
	end
	dialog(player, "Temp", pool[rng:NextInteger(1, #pool)])
end

handlers["egg:blessed"] = function(player, data)
	local first = EggService.found(player, data, "blessed")
	local d = today()
	if first then
		data.titles["Blessed"] = true
		ctx.Game.addPlate(data, { m = "brisket", r = "smokering" })
		ctx.Game.awardBadge(player, "BlessedPlate")
		dialog(player, "Sunday Potluck", "A tiny figure holds a little ribbon: \"Jesus loves you ♥\"\n\nSomebody left you a Blessed Plate (a Smoke Ring Gold brisket) and a new title: Blessed.")
		data.eggs.potluckDay = d
	elseif ctx.Game.isSunday() and data.eggs.potluckDay ~= d then
		data.eggs.potluckDay = d
		ctx.Game.addPlate(data, { m = "ribs", r = "juicy" })
		dialog(player, "Sunday Potluck", "\"Jesus loves you ♥\"\n\nIt's Sunday, so there's a potluck plate for you: Juicy Roch & Roll Ribs. Come back next Sunday!")
	else
		dialog(player, "Sunday Potluck", "\"Jesus loves you ♥\"\n\n(There's a potluck plate here every Sunday.)")
	end
	ctx.World.refreshStations(player)
end

handlers["egg:roof"] = function(player, data)
	if EggService.found(player, data, "roof") then
		data.titles["Roof Club"] = true
		ctx.Game.addCoins(player, data, 500, true)
		dialog(player, "Roof Club", "You signed the Sauce Shack roof. Only real ones make it up here.\n+500 coins and a new title: Roof Club", 500)
	else
		dialog(player, "Roof Club", "Your name's already up here. Nice view, huh?")
	end
end

handlers["egg:creek"] = function(player, data)
	local d = today()
	local first = EggService.found(player, data, "creek")
	if first then
		data.titles["Creek Whisperer"] = true
		ctx.Game.awardBadge(player, "SecretCreek")
	end
	if data.daily.creekDay ~= d then
		data.daily.creekDay = d
		ctx.Game.addSauce(data, "secretcreek")
		dialog(player, "Whisper Stone", Content.Slang.quietCreek .. "\n\nYou found a bottle of Secret Creek Sauce wedged in the rocks. (+50% luck for 5 cooks.) The creek gives one a day.")
	else
		dialog(player, "Whisper Stone", Content.Slang.quietCreek .. "\n\n(The creek already gave you a bottle today. Come back tomorrow.)")
	end
end

handlers["egg:apron"] = function(player, data)
	local isNew = ctx.Game.grantCosmetic(player, data, "apron_okayestunc")
	EggService.found(player, data, "apron")
	if isNew then
		dialog(player, "Mystery Apron", "WORLD'S OKAYEST UNC.\nIt fits perfectly. Too perfectly. Equip it in Settings > Fits.")
	else
		dialog(player, "Mystery Apron", "You already have this one. It's still okay.")
	end
end

-- Big Bertha's dinner bell, by the King of the Pit's 1,000-gallon smoker in the hub square.
-- One ring a day pays a small tip buff; every ring after that is free noise.
local BELL_LINES = {
	"CLANG! Somewhere across the county, a brisket sits up a little straighter.",
	"The bell rings out over the square. Big Bertha answers with a big puff of smoke.",
	"The King of the Pit tips his hat without looking up. \"That's the sound of supper.\"",
	"You ring it. A roadrunner stops, listens, and starts walking toward the food.",
	"Big Bertha's firebox crackles. She heard you.",
}

-- Dinner Bell pile-on: enough different players ring inside the window -> free server-wide tips.
local function checkDinnerBell(player: Player)
	local B = Config.DinnerBell
	local now = workspace:GetServerTimeNow()
	bellRings[player.UserId] = now
	local n, go = Hype.pileOn(bellRings, now, B.window, B.need, lastDinner, B.cooldown)
	if go then
		lastDinner = now
		ctx.Game.dinnerUntil = now + B.minutes * 60
		ctx.Game.announce(string.format("🔔 DINNER'S ON! %d pitmasters rang Big Bertha's bell. Everyone gets +%d%% tips for %d min!", n, math.floor(B.tipBonus * 100 + 0.5), B.minutes), "#FFC83C")
		ctx.Remotes.Push:FireAllClients("fx", { kind = "dinnerbell", data = { n = n } })
		for id in pairs(bellRings) do
			local p = Players:GetPlayerByUserId(id)
			local pd = p and ctx.Game.dataOf(p)
			if p and pd then
				EggService.found(p, pd, "dinnerbell")
			end
		end
		table.clear(bellRings)
		for p in pairs(ctx.Game.runtime) do
			ctx.Game.markDirty(p)
		end
	elseif now - lastDinner >= B.cooldown then
		ctx.Game.toast(player, string.format("🔔 Dinner bell: %d/%d. Get %d more pitmasters to ring it within %ds and the whole server gets bonus tips!", n, B.need, B.need - n, B.window), "info")
	end
end

handlers["landmark:bell"] = function(player, data)
	local d = today()
	ctx.Game.fx(player, "bell", {})
	checkDinnerBell(player)
	local line = BELL_LINES[rng:NextInteger(1, #BELL_LINES)]
	if data.daily.bellDay ~= d then
		data.daily.bellDay = d
		ctx.Game.addSauce(data, "burntend")
		if not data.titles["Dinner Bell Ringer"] then
			data.titles["Dinner Bell Ringer"] = true
			ctx.Game.toast(player, "New title: Dinner Bell Ringer", "good")
		end
		ctx.Game.markDirty(player)
		dialog(player, "Big Bertha", line .. "\n\nThe King of the Pit slides you a jar of Burnt-End Glaze. (+20% tips for 3 serves.) You get one jar a day.")
	else
		dialog(player, "Big Bertha", line .. "\n\n(You already got today's glaze. Ringing is still free.)")
	end
end

function EggService.init(c: any)
	ctx = c
end

function EggService.start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		local kind = prompt:GetAttribute("Kind")
		if typeof(kind) ~= "string" then
			return
		end
		local fn = handlers[kind]
		if not fn then
			return -- client-side kinds (ui:*, npc:unc)
		end
		local data = ctx.Game.dataOf(player)
		if not data or not ctx.Game.runtime[player] then
			return
		end
		ctx.Game.runtime[player].lastActive = os.clock()
		local ok, err = pcall(function(): any
			fn(player, data, prompt)
			return nil
		end)
		if not ok then
			warn("[EggService] " .. kind .. ": " .. tostring(err))
		end
		ctx.Game.markDirty(player)
	end)
	-- Rex / meteorite / cooked eggs are detected from stats & state.
	task.spawn(function()
		while true do
			task.wait(3)
			for player in pairs(ctx.Game.runtime) do
				local data = ctx.Game.dataOf(player)
				if data then
					if (data.critters.rex or 0) > 0 then
						EggService.found(player, data, "rex")
					end
					for key in pairs(data.cutsIndex) do
						if string.find(key, ":meteorite", 1, true) then
							EggService.found(player, data, "meteorite")
							break
						end
					end
				end
			end
		end
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		tempPokes[p] = nil
	end)
end

return EggService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EventService — things that happen to the whole server:
	  * day/night cycle (a full day every 20 minutes),
	  * the co-op Mosquito Swarm at dusk with a Queen Skeeter boss,
	  * the Cook-Off (practice any day, 3x payouts + weekly leaderboard on Saturdays, Texas time),
	  * the monthly season theme on the Cook-Off banner,
	  * Suds Saturday & Sunday announcements.
]]
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Rarity = require(Shared.Logic.Rarity)
local Economy = require(Shared.Logic.Economy)
local CookOff = require(Shared.Logic.CookOff)
local TimeUtil = require(Shared.Logic.TimeUtil)
local WorldBuilder = require(Shared.WorldBuilder)

local EventService = {}
local ctx: any = nil
local rng = Random.new()

-- ===== Day / night =====
local DAY_SECONDS = Config.DAY_LENGTH_MINUTES * 60
local DUSK = 18.6

function EventService.isNight(): boolean
	local h = Lighting.ClockTime
	return h >= 19 or h < 6
end

local function dayNightLoop()
	local last = Lighting.ClockTime
	while true do
		local dt = task.wait(0.5)
		local h = (Lighting.ClockTime + dt * 24 / DAY_SECONDS) % 24
		Lighting.ClockTime = h
		if last < DUSK and h >= DUSK then
			task.spawn(EventService.startSwarm)
		end
		last = h
	end
end

-- ===== Mosquito swarm =====
local swarm: any = nil

local function rewardSwarm(won: boolean)
	if not swarm then
		return
	end
	for player, hits in pairs(swarm.hits) do
		local data = ctx.Game.dataOf(player)
		if data and player.Parent then
			data.stats.mosquitoes += swarm.kills[player] or 0
			if won and hits > 0 then
				local coins = Config.Mosquito.rewardPerPit * data.pitLevel * Economy.rankMult(data.rank, Config.RANK_STEP)
				ctx.Game.addCoins(player, data, coins, true)
				data.aura += Config.Mosquito.aura
				ctx.Game.toast(player, string.format("Swarm cleared! +%d coins, +%d aura. 🦟💥", math.floor(coins), Config.Mosquito.aura), "good")
			end
			ctx.Game.markDirty(player)
		end
	end
end

function EventService.startSwarm()
	if swarm or #Players:GetPlayers() == 0 then
		return
	end
	local map = ctx.World.map()
	local zone = map.Hub:FindFirstChild("MosquitoZone") :: BasePart
	local folder = Instance.new("Folder")
	folder.Name = "Swarm"
	folder.Parent = workspace
	local count = Config.Mosquito.baseCount + Config.Mosquito.perPlayer * #Players:GetPlayers()
	swarm = { folder = folder, bugs = {}, hits = {}, kills = {}, alive = 0, clicks = {} }
	ctx.Game.announce("🦟 Mosquito swarm at the hub! Swat 'em together (click / tap them)!", "#FF6B6B")
	local center = zone.Position
	local function addBug(queen: boolean)
		local angle = rng:NextNumber() * math.pi * 2
		local radius = queen and 18 or rng:NextNumber(10, 34)
		local height = queen and 16 or rng:NextNumber(6, 16)
		local m, body = WorldBuilder.mosquito(ctx.World.ENV, folder, CFrame.new(center), queen)
		local bug = { model = m, body = body, hp = queen and Config.Mosquito.queenHp + #Players:GetPlayers() * 5 or Config.Mosquito.hp, queen = queen, angle = angle, radius = radius, height = height, speed = (queen and 0.4 or 1) * rng:NextNumber(0.6, 1.2) }
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 80
		cd.Parent = body
		if queen then
			WorldBuilder.billboard(body, "HP", "👑 Queen Skeeter", 4, 200, "#FF6B6B", 220, 36)
		end
		cd.MouseClick:Connect(function(player)
			-- simple per-player click limiter (max ~8 swats/sec)
			local nowc = os.clock()
			local lastc = swarm and swarm.clicks[player] or 0
			if not swarm or nowc - lastc < 0.12 or bug.hp <= 0 then
				return
			end
			swarm.clicks[player] = nowc
			bug.hp -= 1
			swarm.hits[player] = (swarm.hits[player] or 0) + 1
			if queen then
				local hp = body:FindFirstChild("HP") :: BillboardGui?
				if hp then
					(hp:FindFirstChild("Text") :: TextLabel).Text = "👑 Queen Skeeter " .. string.rep("❤", math.max(0, math.ceil(bug.hp / 5)))
				end
			end
			if bug.hp <= 0 then
				swarm.kills[player] = (swarm.kills[player] or 0) + 1
				swarm.alive -= 1
				m:Destroy()
				ctx.Game.fx(player, "swat", { queen = queen })
				if queen then
					ctx.Game.announce(player.DisplayName .. " landed the final swat on the Queen Skeeter! 👑🦟", "#FF6B6B")
				end
				if swarm.alive <= 0 then
					EventService.endSwarm(true)
				end
			end
		end)
		table.insert(swarm.bugs, bug)
		swarm.alive += 1
	end
	for _ = 1, count do
		addBug(false)
	end
	addBug(true)
	local started = os.clock()
	local s = swarm
	task.spawn(function()
		while swarm == s and os.clock() - started < Config.Mosquito.duration do
			local dt = RunService.Heartbeat:Wait()
			for _, bug in ipairs(s.bugs) do
				if bug.model.Parent then
					bug.angle += dt * bug.speed
					local p = center + Vector3.new(math.cos(bug.angle) * bug.radius, bug.height + math.sin(os.clock() * 3 + bug.angle) * 1.5, math.sin(bug.angle) * bug.radius)
					local look = center + Vector3.new(math.cos(bug.angle + 0.2) * bug.radius, bug.height, math.sin(bug.angle + 0.2) * bug.radius)
					bug.model:PivotTo(CFrame.lookAt(p, look))
				end
			end
		end
		if swarm == s then
			EventService.endSwarm(false)
		end
	end)
end

function EventService.endSwarm(won: boolean)
	if not swarm then
		return
	end
	rewardSwarm(won)
	if not won then
		ctx.Game.announce("The mosquitoes flew off to bother the neighbors. They'll be back at dusk!", "#AAAAAA")
	end
	swarm.folder:Destroy()
	swarm = nil
end

-- ===== Cook-Off =====
local boardStore: any = nil
local nameCache: { [number]: string } = {}

local function weekKey(): string
	return "CookOff_W" .. TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

local function judgedPrice(meatId: string): number
	local meat = Config.Meats[meatId]
	if meat.premium or meatId == "firstbrisket" then
		return Config.Meats.brisket.price -- paid cuts never beat a regular brisket at the judges' table
	end
	return meat.price
end

local function bestEntry(data: any): (number?, number)
	local bestI, bestS = nil, -1
	for i, plate in ipairs(data.cooler) do
		local s = CookOff.score(Rarity.indexOf(Config.Rarities, plate.r), judgedPrice(plate.m), plate.f == "perfect")
		if s > bestS then
			bestI, bestS = i, s
		end
	end
	return bestI, bestS
end
EventService.bestEntry = bestEntry

function EventService.enterCookOff(player: Player)
	local data = ctx.Game.dataOf(player)
	local r = ctx.Game.runtime[player]
	if not data or not r then
		return
	end
	if os.clock() < r.cookoffReadyAt then
		ctx.Game.toast(player, string.format("The judges are still chewing. Try again in %ds.", math.ceil(r.cookoffReadyAt - os.clock())), "info")
		return
	end
	local i, score = bestEntry(data)
	if not i then
		ctx.Game.toast(player, "Bring a plate! Your best plate from the cooler gets judged.", "info")
		return
	end
	r.cookoffReadyAt = os.clock() + Config.CookOff.cooldown
	local plate = table.remove(data.cooler, i)
	local rating = CookOff.rating(Config.CookOff.ratings, score)
	local saturday = ctx.Game.isSaturday()
	local mult = (saturday and Config.CookOff.saturdayMult or 1) * Economy.rankMult(data.rank, Config.RANK_STEP)
	local coins = math.floor(rating.coins * mult)
	ctx.Game.addCoins(player, data, coins, true)
	data.aura += rating.aura
	data.stats.cookoffs += 1
	local lines = Content.GrannyLines[rating.id]
	local meat = Config.Meats[plate.m]
	ctx.Remotes.Push:FireClient(player, "dialog", {
		npc = "Granny Pecan",
		text = string.format("%s\n\nYour %s %s scored %d. Rating: %s!", lines[rng:NextInteger(1, #lines)], Rarity.get(Config.Rarities, plate.r).name, meat.name, score, rating.id),
		reward = coins,
		rating = rating.id,
	})
	if rating.id == "Cooked" then
		ctx.Game.awardBadge(player, "Cooked")
		ctx.Egg.found(player, data, "cooked")
		ctx.Game.announce(string.format("👏 %s COOKED at the Cook-Off! The cat is clapping.", player.DisplayName), "#FFC83C")
		EventService.clapCat()
	end
	if saturday then
		local wk = TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
		if data.cookoff.week ~= wk then
			data.cookoff.week = wk
			data.cookoff.best = 0
		end
		if score > data.cookoff.best then
			data.cookoff.best = score
			if boardStore then
				task.spawn(function()
					pcall(function()
						boardStore:SetAsync(tostring(player.UserId), score)
					end)
				end)
			end
		end
	end
	ctx.World.refreshStations(player)
	ctx.Game.markDirty(player)
end

function EventService.clapCat()
	local cat = ctx.World.map().Hub.CookOff:FindFirstChild("ClapCatJudge") :: Model?
	if not cat then
		return
	end
	local base = cat:GetPivot()
	task.spawn(function()
		for k = 1, 10 do
			cat:PivotTo(base * CFrame.new(0, (k % 2) * 0.5, 0))
			task.wait(0.15)
		end
		cat:PivotTo(base)
	end)
end

local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, n = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and n or ("Pitmaster " .. userId)
	return nameCache[userId]
end

local function refreshBoard()
	local map = ctx.World.map()
	local lb = map.Hub.CookOff:FindFirstChild("Leaderboard") :: BasePart
	local label = (lb:FindFirstChild("SignGui") :: SurfaceGui):FindFirstChild("BoardText") :: TextLabel
	local season = ctx.Game.currentSeason()
	local lines = { season.name .. " - this week", "(Saturdays, Texas time)", "" }
	if boardStore then
		local ok, pages = pcall(function()
			return boardStore:GetSortedAsync(false, 10)
		end)
		if ok and pages then
			local page = pages:GetCurrentPage()
			for rank, entry in ipairs(page) do
				table.insert(lines, string.format("%d. %s - %d", rank, nameOf(tonumber(entry.key) or 0), entry.value))
			end
		end
	end
	if #lines == 3 then
		table.insert(lines, ctx.Game.isSaturday() and "No entries yet. Be first!" or "Opens Saturday.\nPractice any day!")
	end
	label.Text = table.concat(lines, "\n")
	-- banner reskin by season
	local banner = map.Hub.CookOff:FindFirstChild("Banner") :: BasePart
	banner.Color = Color3.fromHex(season.color)
	local bt = (banner:FindFirstChild("SignGui") :: SurfaceGui):FindFirstChild("BannerText") :: TextLabel
	bt.Text = "🏆 " .. string.upper(season.name) .. (ctx.Game.isSaturday() and " - TODAY! 3x PRIZES" or " - SATURDAY") .. " 🏆"
end

function EventService.init(c: any)
	ctx = c
end

function EventService.start()
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(weekKey())
	end)
	boardStore = ok and store or nil
	task.spawn(dayNightLoop)
	task.spawn(function()
		while true do
			local okB, err = pcall(function(): any
				refreshBoard()
				return nil
			end)
			if not okB then
				warn("[EventService] board: " .. tostring(err))
			end
			task.wait(60)
			-- new week -> new board
			local ok2, st2 = pcall(function()
				return DataStoreService:GetOrderedDataStore(weekKey())
			end)
			if ok2 then
				boardStore = st2
			end
		end
	end)
	ctx.Data.onLoaded.Event:Connect(function(player: Player)
		task.delay(4, function()
			if not player.Parent then
				return
			end
			if ctx.Game.isSudsWeekend() then
				ctx.Game.toast(player, "🫧 Suds Saturday & Sunday! Muddy pups need a bath. Wash one for a free bandana.", "good")
			end
			if ctx.Game.isSaturday() then
				ctx.Game.toast(player, "🏆 It's Cook-Off Saturday! Bring your best plate to Granny Pecan for 3x prizes.", "good")
			end
		end)
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GameService — the server-authoritative game loop.
	The client only ever *asks* ("start a cook in slot s2 with ribs"); every rule, timer,
	price, roll and reward is decided here. All requests come through one RemoteFunction,
	are rate-limited per player and per action, and are type-checked before use.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local BadgeService = game:GetService("BadgeService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Monetization = require(Shared.Monetization)
local CookLogic = require(Shared.Logic.CookLogic)
local Rarity = require(Shared.Logic.Rarity)
local Economy = require(Shared.Logic.Economy)
local Hype = require(Shared.Logic.Hype)
local Streak = require(Shared.Logic.Streak)
local PitmasterPath = require(Shared.Logic.PitmasterPath)
local Restock = require(Shared.Logic.Restock)
local CookOff = require(Shared.Logic.CookOff)
local RateLimiter = require(Shared.Logic.RateLimiter)
local TimeUtil = require(Shared.Logic.TimeUtil)

local GameService = {}
local ctx: any = nil
local rng = Random.new()

type Runtime = {
	plot: number?,
	passes: { [string]: boolean },
	sessionStart: number,
	lastActive: number,
	nudged: boolean,
	dirty: boolean,
	today: number,
	crew: number,
	customers: { any },
	nextCustomerId: number,
	nextSpawn: number,
	lastAutoServe: number,
	snagLockUntil: number,
	snagCooldownUntil: number,
	peaceChangedAt: number,
	resting: boolean,
	cookoffReadyAt: number,
	announcedDone: { [string]: boolean },
	rush: any,
}

GameService.runtime = {} :: { [Player]: Runtime }

local globalLimiter = RateLimiter.new(25, 12) -- any action: burst 25, 12/sec sustained
local actionLimiter = RateLimiter.new(6, 3) -- per (player, action)

local function T(): number
	return workspace:GetServerTimeNow()
end

local function today(): number
	return TimeUtil.dayNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

local function weekday(): number
	return TimeUtil.weekday(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

function GameService.currentSeason(): any
	return CookOff.seasonFor(Config.Seasons, TimeUtil.month(os.time(), Config.TIMEZONE_OFFSET_HOURS))
end

function GameService.isSaturday(): boolean
	return CookOff.isSaturday(weekday())
end

function GameService.isSudsWeekend(): boolean
	return CookOff.isSudsWeekend(weekday())
end

function GameService.isSunday(): boolean
	return weekday() == 1
end

local function profileOf(player: Player): any?
	local p = ctx.Data.get(player)
	return p and p.data or nil
end
GameService.dataOf = profileOf

local function rt(player: Player): Runtime?
	return GameService.runtime[player]
end

function GameService.markDirty(player: Player)
	local r = rt(player)
	if r then
		r.dirty = true
	end
end

function GameService.toast(player: Player, text: string, kind: string?)
	ctx.Remotes.Push:FireClient(player, "toast", { text = text, kind = kind or "info" })
end

function GameService.fx(player: Player, kind: string, payload: any?)
	ctx.Remotes.Push:FireClient(player, "fx", { kind = kind, data = payload })
end

function GameService.announce(text: string, color: string?)
	ctx.Remotes.Push:FireAllClients("announce", { text = text, color = color or "#FFC83C" })
end

local function awardBadge(player: Player, key: string)
	local id = (Monetization.Badges :: any)[key]
	if type(id) == "number" and id ~= 0 then
		task.spawn(function()
			pcall(function()
				BadgeService:AwardBadge(player.UserId, id)
			end)
		end)
	end
end
GameService.awardBadge = awardBadge

-- Big Bertha's Dinner Bell: a free server-wide tip bonus (set by EggService).
GameService.dinnerUntil = 0
function GameService.dinnerBonus(): number
	return workspace:GetServerTimeNow() < GameService.dinnerUntil and Config.DinnerBell.tipBonus or 0
end

function GameService.hasPass(player: Player, key: string): boolean
	local r = rt(player)
	return r ~= nil and r.passes[key] == true
end

local function rankMult(data: any): number
	return Economy.rankMult(data.rank, Config.RANK_STEP)
end

local function pit(data: any): any
	return Config.PitLevels[math.clamp(data.pitLevel, 1, #Config.PitLevels)]
end

function GameService.slotCount(player: Player, data: any, kind: string): number
	if kind == "smoker" then
		return Economy.totalSlots(Config.Slots.smoker.base, data.smokerSlotsBought, Config.Slots.smoker.passBonus, GameService.hasPass(player, "ExtraSmokers"), Config.MAX_SMOKERS)
	end
	return Economy.totalSlots(Config.Slots.grill.base, data.grillSlotsBought, Config.Slots.grill.passBonus, false, Config.MAX_GRILLS)
end

local function kindOfKey(key: string): string?
	local c = string.sub(key, 1, 1)
	if c == "s" then
		return "smoker"
	elseif c == "g" then
		return "grill"
	end
	return nil
end

local function validKey(player: Player, data: any, key: any): string?
	if type(key) ~= "string" or #key > 3 or not string.match(key, "^[sg]%d$") then
		return nil
	end
	local kind = kindOfKey(key)
	local idx = tonumber(string.sub(key, 2))
	if not kind or not idx or idx < 1 or idx > GameService.slotCount(player, data, kind) then
		return nil
	end
	return kind
end

function GameService.addCoins(player: Player, data: any, amount: number, earned: boolean)
	amount = math.floor(amount)
	data.coins += amount
	if earned and amount > 0 then
		data.runCoins += amount
		data.lifetimeCoins += amount
	end
	GameService.markDirty(player)
end

local function useSauce(data: any, effect: string): number
	local s = data.sauces[effect]
	if s and s.charges > 0 then
		s.charges -= 1
		local amt = s.amount
		if s.charges <= 0 then
			s.amount = 0
			s.charges = 0
		end
		return amt
	end
	return 0
end

function GameService.addSauce(data: any, sauceId: string)
	local def = Config.Sauces[sauceId]
	if not def then
		return
	end
	local s = data.sauces[def.effect]
	s.amount = math.max(s.amount, def.amount)
	s.charges += def.charges
end

function GameService.grantCosmetic(player: Player, data: any, id: string): boolean
	if not Config.Cosmetics[id] then
		return false
	end
	local isNew = not data.owned[id]
	data.owned[id] = true
	if isNew then
		local def = Config.Cosmetics[id]
		if not data.equipped[def.slot] then
			data.equipped[def.slot] = id
			ctx.Cosmetics.apply(player)
		end
		GameService.markDirty(player)
	end
	return isNew
end

function GameService.addBoost(data: any, minutes: number, mult: number)
	local t = T()
	local b = data.boost
	if b.untilT > t then
		b.untilT += minutes * 60
		b.mult = math.max(b.mult, mult)
	else
		b.untilT = t + minutes * 60
		b.mult = mult
	end
end

-- Advance every cook to `t`. `online` enables burger burning (never happens offline).
local function advanceAll(player: Player, data: any, t: number, online: boolean)
	local speed = pit(data).speed
	local r = rt(player)
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" then
			local wasDone = CookLogic.isDone(cook)
			CookLogic.advance(cook, t, CookLogic.rate(cook, speed), data.boost.mult, data.boost.untilT)
			if online and r then
				if not wasDone and CookLogic.isDone(cook) and not r.announcedDone[key] then
					r.announcedDone[key] = true
					local meat = Config.Meats[cook.meat]
					GameService.toast(player, string.format("%s %s is ready! Collect it.", meat.icon, meat.name), "ready")
					GameService.markDirty(player)
				end
				if kindOfKey(key) == "grill" and cook.meat == "burger" and CookLogic.shouldBurn(cook, t, Config.BURGER_BURN_GRACE) then
					cook.burnt = true
					data.stats.burnt += 1
					data.combo = 0
					GameService.toast(player, Content.Slang.burnt, "bad")
					ctx.World.effect(player, "smell", key)
					GameService.markDirty(player)
				end
			end
		end
	end
end
GameService.advanceAll = advanceAll

local function plateValue(player: Player, data: any, plate: any, critter: any?, orderMatch: boolean, consumeTip: boolean): number
	local meat = Config.Meats[plate.m]
	local rar = Rarity.get(Config.Rarities, plate.r)
	local flipMult = 1
	if meat.station == "grill" and meat.id == "burger" then
		if plate.f == "perfect" then
			flipMult = Config.Flip.perfectMult
		elseif plate.f == "good" then
			flipMult = Config.Flip.goodMult
		elseif plate.f == "miss" then
			flipMult = Config.Flip.missMult
		else
			flipMult = Config.Flip.unflippedMult
		end
	end
	local combo = math.min(data.combo or 0, Config.Flip.comboMax)
	local r = rt(player)
	return Economy.plateValue(meat.price, {
		rarityMult = rar.mult,
		rankMult = rankMult(data),
		crewMult = Economy.crewMult(r and r.crew or 0, Config.Crew.perFriend, Config.Crew.maxFriends),
		tipMult = critter and critter.tip or 1,
		sauceTip = (consumeTip and useSauce(data, "tip") or 0) + GameService.dinnerBonus(),
		flipMult = flipMult,
		comboMult = 1 + combo * Config.Flip.comboStep,
		orderBonus = orderMatch and Config.MATCH_ORDER_BONUS or 1,
		doubleTips = GameService.hasPass(player, "DoubleTips"),
		passTipMult = Hype.passTip(true, Config.FairPlay.passTipMult, Config.FairPlay.passTipCap),
	})
end

local function addPlate(data: any, plate: any): boolean
	if #data.cooler >= Config.COOLER_MAX then
		return false
	end
	table.insert(data.cooler, plate)
	return true
end
GameService.addPlate = addPlate

-- ===== Actions =====
local Actions: { [string]: (Player, any, any, any) -> (boolean, string?) } = {}

local function meatAvailable(player: Player, data: any, meat: any): (boolean, string?)
	if meat.hidden then
		return false, "Not on the menu."
	end
	if meat.season and meat.season ~= GameService.currentSeason().id then
		return false, "That's a seasonal cut. It's back next season!"
	end
	if data.pitLevel < meat.unlockPit then
		return false, string.format("Upgrade to %s to smoke that.", Config.PitLevels[meat.unlockPit].name)
	end
	if meat.premium then
		local pass = GameService.hasPass(player, "PremiumCuts")
		local tokens = data.cuts[meat.id] or 0
		local unlocked = meat.id == "tomahawk" and data.unlocks.tomahawk
		if not (pass or tokens > 0 or unlocked) then
			return false, "Premium cut: get it on the Pitmaster Path or in the Pit Shop."
		end
	end
	return true, nil
end

Actions.StartCook = function(player, data, key, meatId)
	local kind = validKey(player, data, key)
	if not kind or type(meatId) ~= "string" then
		return false, "Bad request."
	end
	local meat = Config.Meats[meatId]
	if not meat or meat.station ~= kind then
		return false, "That doesn't go there."
	end
	if data.stations[key] then
		return false, "That spot's busy."
	end
	local ok, why = meatAvailable(player, data, meat)
	if not ok then
		return false, why
	end
	local rm = rankMult(data)
	local cost = Economy.rawCost(meat, rm)
	if data.coins < cost then
		return false, string.format("You need %d coins for that.", cost)
	end
	GameService.addCoins(player, data, -cost, false)
	if meat.premium and not GameService.hasPass(player, "PremiumCuts") and not (meat.id == "tomahawk" and data.unlocks.tomahawk) then
		data.cuts[meat.id] -= 1
	end
	local luck = pit(data).luck * (1 + useSauce(data, "luck"))
	local speedBonus = useSauce(data, "speed")
	local rarity = Rarity.roll(Config.Rarities, luck, meat.maxRarity, rng:NextNumber())
	local cook = CookLogic.new(meat.id, rarity, meat.cookTime, T(), 1 + speedBonus)
	data.stations[key] = cook
	data.stats.cooks += 1
	local r = rt(player)
	if r then
		r.announcedDone[key] = nil
	end
	ctx.World.refreshStations(player)
	return true, nil
end

-- One-button first cook: a 75-second brisket that always comes out Smoke Ring Gold.
Actions.FirstBrisket = function(player, data)
	if data.tutorial.firstBrisket then
		return false, "You already smoked your first brisket!"
	end
	for _, cook in pairs(data.stations) do
		if type(cook) == "table" and cook.meat == "firstbrisket" then
			return false, "It's already smoking!"
		end
	end
	local key = "s1"
	if data.stations[key] then
		return false, "Smoker 1 is busy."
	end
	data.stations[key] = CookLogic.new("firstbrisket", "smokering", Config.Meats.firstbrisket.cookTime, T(), 1)
	data.stats.cooks += 1
	ctx.World.refreshStations(player)
	return true, nil
end

local function collect(player: Player, data: any, key: string): (boolean, string?)
	local cook = data.stations[key]
	if type(cook) ~= "table" then
		return false, "Nothing there."
	end
	if not CookLogic.isDone(cook) then
		return false, "Not ready yet. Low and slow!"
	end
	if cook.burnt then
		data.stations[key] = nil
		ctx.World.refreshStations(player)
		GameService.toast(player, "Tossed the burnt patty. 🤿", "bad")
		return true, nil
	end
	if #data.cooler >= Config.COOLER_MAX then
		return false, "Your cooler's full! Serve some plates first."
	end
	local meatId = cook.meat == "firstbrisket" and "brisket" or cook.meat
	local plate = { m = cook.meat, r = cook.rarity, f = cook.flip }
	addPlate(data, plate)
	data.stations[key] = nil
	local meat = Config.Meats[cook.meat]
	if meat.station == "smoker" then
		data.stats.smoked += 1
	end
	local ri = Rarity.indexOf(Config.Rarities, cook.rarity)
	data.cutsIndex[meatId .. ":" .. cook.rarity] = true
	local rar = Config.Rarities[ri]
	if ri >= 3 then
		data.stats.rares += 1
		awardBadge(player, "FirstRare")
	end
	if rar.flex then
		local label = string.format("%s smoked a %s %s!", player.DisplayName, rar.name, Config.Meats[meatId].name)
		ctx.World.smokeSignal(player, rar.name, rar.color)
		GameService.announce("💨 " .. label, rar.color)
		GameService.fx(player, "reveal", { meat = meatId, rarity = cook.rarity, aura = ri >= 4 and 1000 or 0 })
		if ri >= 4 then
			data.aura += 1000
		end
	end
	if cook.meat == "firstbrisket" then
		data.tutorial.firstBrisket = true
		GameService.toast(player, "Your first brisket came out SMOKE RING GOLD! Serve it to a customer.", "good")
	end
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.Collect = function(player, data, key)
	if not validKey(player, data, key) then
		return false, "Bad request."
	end
	return collect(player, data, key)
end

Actions.CollectAll = function(player, data)
	local any = false
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" and CookLogic.isDone(cook) then
			local ok = collect(player, data, key)
			any = any or ok
		end
	end
	return any, if any then nil else "Nothing's ready yet."
end

Actions.Flip = function(player, data, key)
	local kind = validKey(player, data, key)
	local cook = kind == "grill" and data.stations[key] or nil
	if type(cook) ~= "table" or cook.meat ~= "burger" then
		return false, "No burger there."
	end
	if cook.flip then
		return false, "Already flipped."
	end
	if CookLogic.isDone(cook) then
		return false, "Too late to flip!"
	end
	local F = Config.Flip
	local result = CookLogic.judgeFlip(CookLogic.fraction(cook), F.target, F.perfectWindow, F.goodWindow)
	cook.flip = result
	if result == "perfect" then
		data.combo = math.min((data.combo or 0) + 1, F.comboMax)
		data.stats.perfectFlips += 1
		data.aura += F.perfectAura
		GameService.fx(player, "flip", { result = result, combo = data.combo, lockedIn = data.combo >= F.lockedInAt })
	else
		data.combo = 0
		GameService.fx(player, "flip", { result = result, combo = 0 })
	end
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.Peek = function(player, data, key)
	local kind = validKey(player, data, key)
	local cook = data.stations[key]
	if kind ~= "smoker" or type(cook) ~= "table" or CookLogic.isDone(cook) then
		return false, "Nothing to peek at."
	end
	if cook.revealed then
		return false, "You already peeked."
	end
	local penalty = CookLogic.peek(cook, Config.PEEK_PENALTY_FRACTION, Config.PEEK_PENALTY_MIN)
	local rar = Rarity.get(Config.Rarities, cook.rarity)
	GameService.toast(player, string.format("%s (+%s cook time) It's looking %s!", Content.PitmasterScold[rng:NextInteger(1, #Content.PitmasterScold)], TimeUtil.formatDuration(penalty), rar.name), "warn")
	return true, nil
end

-- Serving
local function bestPlateIndex(player: Player, data: any, order: string?): (number?, boolean)
	local bestI, bestV, matched = nil, -1, false
	for i, plate in ipairs(data.cooler) do
		local isMatch = order ~= nil and order ~= "any" and (plate.m == order or (order == "brisket" and plate.m == "firstbrisket"))
		local v = plateValue(player, data, plate, nil, isMatch, false)
		-- prefer matching orders, then highest value
		local score = v + (isMatch and 1e9 or 0)
		if score > bestV then
			bestV, bestI, matched = score, i, isMatch
		end
	end
	return bestI, matched
end

local function critterDef(id: string): any
	for _, c in ipairs(Config.Critters) do
		if c.id == id then
			return c
		end
	end
	return Config.Critters[1]
end
GameService.critterDef = critterDef

local function removeCustomer(player: Player, customer: any)
	local r = rt(player)
	if not r then
		return
	end
	for i, c in ipairs(r.customers) do
		if c.id == customer.id then
			table.remove(r.customers, i)
			break
		end
	end
	ctx.World.removeCustomer(player, customer)
	GameService.markDirty(player)
end

function GameService.serveCustomer(player: Player, customer: any): (boolean, string?)
	local data = profileOf(player)
	if not data then
		return false, "Loading..."
	end
	local i, matched = bestPlateIndex(player, data, customer.order)
	if not i then
		return false, "Your cooler's empty. Cook something first!"
	end
	local plate = table.remove(data.cooler, i)
	local critter = critterDef(customer.critter)
	local value = plateValue(player, data, plate, critter, matched, true)
	GameService.addCoins(player, data, value, true)
	data.stats.served += 1
	local isNew = (data.critters[critter.id] or 0) == 0
	data.critters[critter.id] = (data.critters[critter.id] or 0) + 1
	if isNew then
		local distinct = 0
		for _ in pairs(data.critters) do
			distinct += 1
		end
		data.stats.critters = distinct
		GameService.addCoins(player, data, Config.NEW_REGULAR_REWARD * rankMult(data), true)
		GameService.toast(player, string.format("New regular! %s joined your Regulars Index.", critter.name), "good")
	end
	if critter.rex then
		GameService.announce(string.format("🦖 Rex visited %s's ranch! RAWR means I love you ♥", player.DisplayName), "#6CC24A")
		ctx.World.smokeSignal(player, "RAWR!", "#6CC24A")
		awardBadge(player, "MetRex")
	end
	if critter.id == "clapcat" then
		ctx.World.effect(player, "clap", customer)
	end
	GameService.fx(player, "served", { value = value, matched = matched, critter = critter.id, aura = plate.f == "perfect" and Config.Flip.perfectAura or 0 })
	-- 6-7!
	if Hype.isSixSeven(value) then
		GameService.fx(player, "sixseven", { value = value })
		ctx.Egg.found(player, data, "sixseven")
	end
	-- Lunch Rush
	local r = rt(player)
	if r then
		local bonus
		r.rush, bonus = Hype.rushStep(r.rush, T(), Config.Rush.period, Config.Rush.need, Config.Rush.bonusFrac, value)
		if bonus > 0 then
			GameService.addCoins(player, data, bonus, true)
			GameService.fx(player, "rush", { bonus = bonus })
			GameService.toast(player, string.format("🍽️ Lunch Rush cleared! +%d coins", bonus), "good")
		end
	end
	if not data.tutorial.done then
		data.tutorial.done = true
	end
	removeCustomer(player, customer)
	return true, nil
end

Actions.Serve = function(player, _data, customerId)
	local r = rt(player)
	if not r or type(customerId) ~= "number" then
		return false, "Bad request."
	end
	for _, c in ipairs(r.customers) do
		if c.id == customerId then
			return GameService.serveCustomer(player, c)
		end
	end
	return false, "They already left."
end

Actions.ServeAll = function(player, data)
	local r = rt(player)
	if not r then
		return false, nil
	end
	if #r.customers == 0 then
		return false, "No customers yet. They'll show up soon!"
	end
	local served = 0
	local list = table.clone(r.customers)
	for _, c in ipairs(list) do
		if #data.cooler == 0 then
			break
		end
		local ok = GameService.serveCustomer(player, c)
		if ok then
			served += 1
		end
	end
	if served == 0 then
		return false, "Your cooler's empty. Cook something first!"
	end
	return true, nil
end

function GameService.bellyRub(player: Player, customer: any)
	local data = profileOf(player)
	if not data or customer.rubbed then
		return
	end
	customer.rubbed = true
	local tip = math.floor(25 * data.pitLevel * rankMult(data))
	GameService.addCoins(player, data, tip, true)
	data.aura += 50
	GameService.toast(player, string.format("The pup rolled over for belly rubs! +%d tip 🐶", tip), "good")
	ctx.World.effect(player, "bellyrub", customer)
end

function GameService.washPup(player: Player, customer: any)
	local data = profileOf(player)
	if not data or not customer.muddy then
		return
	end
	customer.muddy = false
	local pick = Rarity.pickWeighted(Config.Bandanas, rng:NextNumber())
	local isNew = GameService.grantCosmetic(player, data, pick.id)
	local name = Config.Cosmetics[pick.id].name
	GameService.toast(player, isNew and ("Squeaky clean! The pup gave you a " .. name .. "!") or ("Squeaky clean! (" .. name .. " again, +100 coins)"), "good")
	if not isNew then
		GameService.addCoins(player, data, 100, true)
	end
	ctx.World.effect(player, "wash", customer)
	GameService.markDirty(player)
end

Actions.BuySauce = function(player, data, sauceId)
	if type(sauceId) ~= "string" then
		return false, "Bad request."
	end
	local def = Config.Sauces[sauceId]
	if not def or def.hidden then
		return false, "Not for sale."
	end
	local window = Restock.window(os.time(), Config.RESTOCK_SECONDS)
	if data.restock.window ~= window then
		data.restock.window = window
		data.restock.bought = {}
	end
	local shelf = Restock.shelf(window, Config.Sauces, Config.SauceOrder, Config.RESTOCK_SLOTS)
	local qty = 0
	for _, e in ipairs(shelf) do
		if e.id == sauceId then
			qty = e.qty
		end
	end
	local bought = data.restock.bought[sauceId] or 0
	if bought >= qty then
		return false, "Sold out! New sauce in " .. TimeUtil.formatDuration(Restock.nextIn(os.time(), Config.RESTOCK_SECONDS)) .. "."
	end
	local price = math.floor(def.price * (1 + (rankMult(data) - 1) * 0.5))
	if data.coins < price then
		return false, string.format("You need %d coins.", price)
	end
	GameService.addCoins(player, data, -price, false)
	data.restock.bought[sauceId] = bought + 1
	GameService.addSauce(data, sauceId)
	data.stats.sauces += 1
	GameService.toast(player, string.format("Got %s! (%d charges)", def.name, def.charges), "good")
	return true, nil
end

Actions.UpgradePit = function(player, data)
	local cost = Economy.nextPitCost(Config.PitLevels, data.pitLevel)
	if not cost then
		return false, "Your pit is maxed out. Time for Unc Status?"
	end
	if data.coins < cost then
		return false, string.format("You need %d coins.", cost)
	end
	GameService.addCoins(player, data, -cost, false)
	data.pitLevel += 1
	data.stats.upgrades += 1
	GameService.toast(player, "Pit upgraded to " .. pit(data).name .. "!", "good")
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.BuySlot = function(player, data, kind)
	if kind ~= "smoker" and kind ~= "grill" then
		return false, "Bad request."
	end
	local def = Config.Slots[kind]
	local boughtKey = kind == "smoker" and "smokerSlotsBought" or "grillSlotsBought"
	local cap = kind == "smoker" and Config.MAX_SMOKERS or Config.MAX_GRILLS
	if GameService.slotCount(player, data, kind) >= cap then
		return false, "No more room!"
	end
	local cost = Economy.nextSlotCost(def.costs, data[boughtKey])
	if not cost then
		return false, "No more slots to buy."
	end
	if data.coins < cost then
		return false, string.format("You need %d coins.", cost)
	end
	GameService.addCoins(player, data, -cost, false)
	data[boughtKey] += 1
	data.stats.upgrades += 1
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.Rebirth = function(player, data)
	local ok, need = Economy.canRebirth(Config.Ranks, data.rank, data.runCoins)
	if not ok then
		return false, need and string.format("Earn %d coins this run to rebirth.", need) or "You're already OG."
	end
	-- Finished food goes to the cooler; unfinished cooks are refunded. Nothing is lost.
	local refund = 0
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" then
			if CookLogic.isDone(cook) and not cook.burnt then
				addPlate(data, { m = cook.meat, r = cook.rarity, f = cook.flip })
			elseif not CookLogic.isDone(cook) then
				local m = Config.Meats[cook.meat]
				if m.premium then
					data.cuts[m.id] = (data.cuts[m.id] or 0) + 1
				else
					refund += Economy.rawCost(m, rankMult(data))
				end
			end
		end
		data.stations[key] = nil
	end
	data.rank += 1
	data.coins = Config.START_COINS + refund
	data.runCoins = 0
	data.pitLevel = 1
	data.smokerSlotsBought = 0
	data.grillSlotsBought = 0
	local rank = Config.Ranks[data.rank]
	data.titles[rank.name] = true
	data.title = rank.name
	if rank.unlock then
		GameService.grantCosmetic(player, data, rank.unlock)
		GameService.toast(player, Content.Slang.unclocked, "good")
	end
	GameService.announce(string.format("👴 %s reached Unc Status: %s!", player.DisplayName, rank.name), "#FFC83C")
	ctx.World.refreshStations(player)
	ctx.Cosmetics.apply(player)
	return true, nil
end

function GameService.applyReward(player: Player, data: any, reward: any)
	if reward.coins then
		GameService.addCoins(player, data, reward.coins * rankMult(data), true)
	end
	if reward.sauce then
		GameService.addSauce(data, reward.sauce)
	end
	if reward.cosmetic then
		GameService.grantCosmetic(player, data, reward.cosmetic)
	end
	if reward.boostMinutes then
		GameService.addBoost(data, reward.boostMinutes, 2)
	end
	if reward.wagyu then
		data.cuts.wagyu = (data.cuts.wagyu or 0) + reward.wagyu
	end
	if reward.title then
		data.titles[reward.title] = true
	end
	if reward.rex then
		data.forceCritter = "rex"
	end
	if reward.tomahawk then
		data.unlocks.tomahawk = true
	end
	GameService.markDirty(player)
end

Actions.ClaimDaily = function(player, data)
	local d = today()
	if not Streak.canClaim(data.streak, d) then
		return false, "Already claimed today. See you tomorrow!"
	end
	local res = Streak.claim(data.streak, d)
	if not res.ok then
		return false, "Already claimed."
	end
	local reward = Config.DailyRewards[res.cycleDay]
	local scaled = table.clone(reward)
	scaled.coins = math.floor((reward.coins or 0) * Streak.rewardScale(res.count))
	GameService.applyReward(player, data, scaled)
	local note = ""
	if res.usedFreeMiss then
		note = " (Your free miss for the week saved your streak!)"
	elseif res.softReset then
		note = " (Welcome back! You kept your week.)"
	end
	GameService.toast(player, string.format("Day %d streak! +%d coins%s", res.count, math.floor(scaled.coins * rankMult(data)), note), "good")
	return true, nil
end

Actions.ClaimPath = function(player, data)
	local ok, reward = PitmasterPath.claim(data.path, Config.PathSteps, data.stats)
	if not ok then
		return false, "Not done yet!"
	end
	GameService.applyReward(player, data, reward)
	GameService.toast(player, "Pitmaster Path step " .. data.path.claimed .. " complete!", "good")
	return true, nil
end

Actions.HearJoke = function(player, data)
	local d = today()
	local joke = Content.UncJokes[(d % #Content.UncJokes) + 1]
	local first = data.daily.jokeDay ~= d
	if first then
		data.daily.jokeDay = d
		GameService.addCoins(player, data, 50 * rankMult(data), true)
	end
	ctx.Remotes.Push:FireClient(player, "dialog", { npc = "Unc Hank", text = "Hi Hungry, I'm Unc! " .. joke, yap = Content.UncYap[rng:NextInteger(1, #Content.UncYap)], reward = first and math.floor(50 * rankMult(data)) or 0 })
	return true, nil
end

Actions.Equip = function(player, data, slot, cosmeticId)
	if type(slot) ~= "string" or not table.find(Config.CosmeticSlots, slot) then
		return false, "Bad request."
	end
	if cosmeticId == "" or cosmeticId == nil then
		data.equipped[slot] = nil
	else
		if type(cosmeticId) ~= "string" or not data.owned[cosmeticId] then
			return false, "You don't own that."
		end
		local def = Config.Cosmetics[cosmeticId]
		if not def or def.slot ~= slot then
			return false, "Wrong slot."
		end
		data.equipped[slot] = cosmeticId
	end
	ctx.Cosmetics.apply(player)
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.SetTitle = function(player, data, title)
	if title == "" then
		data.title = ""
		ctx.Cosmetics.apply(player)
		return true, nil
	end
	if type(title) ~= "string" or not data.titles[title] then
		return false, "You haven't earned that title."
	end
	data.title = title
	ctx.Cosmetics.apply(player)
	return true, nil
end

Actions.SetPeace = function(player, data, on)
	local r = rt(player)
	if type(on) ~= "boolean" or not r then
		return false, "Bad request."
	end
	local t = os.clock()
	if t - r.peaceChangedAt < 60 then
		return false, "You can switch Peace Mode once a minute."
	end
	if t < r.snagCooldownUntil - Config.Snag.cooldown + Config.Snag.catchWindow then
		return false, "Not while you're on the run!"
	end
	r.peaceChangedAt = t
	data.settings.peace = on
	GameService.toast(player, on and "Peace Mode on: nobody can snag your plates (and you can't snag theirs)." or "Peace Mode off. Watch your plates!", "info")
	return true, nil
end

Actions.SetResting = function(player, _data, on)
	local r = rt(player)
	if type(on) ~= "boolean" or not r then
		return false, nil
	end
	r.resting = on
	ctx.Cosmetics.apply(player)
	return true, nil
end

Actions.Prompt = function(player, _data, kind, key)
	if (kind ~= "product" and kind ~= "pass") or type(key) ~= "string" then
		return false, "Bad request."
	end
	return ctx.Purchase.prompt(player, kind, key)
end

Actions.Hello = function(player, _data)
	GameService.markDirty(player)
	return true, nil
end

-- ===== Snapshot sent to the client =====
local function snapshot(player: Player, data: any): any
	local r = rt(player) :: Runtime
	local t = T()
	local stations = {}
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" then
			local done = CookLogic.isDone(cook)
			stations[key] = {
				meat = cook.meat,
				progress = cook.progress,
				duration = cook.duration,
				last = cook.last,
				rate = CookLogic.rate(cook, pit(data).speed),
				doneAt = cook.doneAt,
				flip = cook.flip,
				burnt = cook.burnt,
				rarity = (done or cook.revealed) and cook.rarity or nil,
			}
		end
	end
	local window = Restock.window(os.time(), Config.RESTOCK_SECONDS)
	local bought = data.restock.window == window and data.restock.bought or {}
	local customers = {}
	for _, c in ipairs(r.customers) do
		table.insert(customers, { id = c.id, critter = c.critter, order = c.order, muddy = c.muddy, leaveAt = c.leaveAt })
	end
	local week = TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
	return {
		t = t,
		coins = data.coins,
		runCoins = data.runCoins,
		aura = data.aura,
		rank = data.rank,
		pitLevel = data.pitLevel,
		slots = { smoker = GameService.slotCount(player, data, "smoker"), grill = GameService.slotCount(player, data, "grill") },
		bought = { smoker = data.smokerSlotsBought, grill = data.grillSlotsBought },
		stations = stations,
		cooler = data.cooler,
		sauces = data.sauces,
		boost = data.boost,
		cuts = data.cuts,
		unlocks = data.unlocks,
		owned = data.owned,
		equipped = data.equipped,
		titles = data.titles,
		title = data.title,
		critters = data.critters,
		cutsIndex = data.cutsIndex,
		eggs = data.eggs,
		stats = data.stats,
		streak = data.streak,
		canClaimDaily = Streak.canClaim(data.streak, today()),
		path = data.path,
		pathStatus = PitmasterPath.status(data.path, Config.PathSteps, data.stats),
		restock = { window = window, shelf = Restock.shelf(window, Config.Sauces, Config.SauceOrder, Config.RESTOCK_SLOTS), bought = bought, nextIn = Restock.nextIn(os.time(), Config.RESTOCK_SECONDS) },
		cookoff = data.cookoff,
		settings = data.settings,
		tutorial = data.tutorial,
		passes = r.passes,
		customers = customers,
		combo = data.combo,
		crew = r.crew,
		rush = (function()
			local w = Hype.rushWindow(T(), Config.Rush.period)
			local cur = (r.rush and r.rush.w == w) and r.rush or nil
			return { n = cur and cur.n or 0, need = Config.Rush.need, done = cur ~= nil and cur.done, ends = Hype.rushEnds(w, Config.Rush.period) }
		end)(),
		dinnerUntil = GameService.dinnerUntil,
		season = GameService.currentSeason(),
		saturday = GameService.isSaturday(),
		suds = GameService.isSudsWeekend(),
		rotation = CookOff.rotation(Config.RotationPool, Config.ROTATION_FEATURED, week),
		memoryOnly = ctx.Data.isStudioMemoryMode(player),
		studio = RunService:IsStudio(),
		productIds = ctx.Purchase.availability(),
		plot = r.plot,
	}
end

function GameService.push(player: Player)
	local data = profileOf(player)
	local r = rt(player)
	if not data or not r then
		return
	end
	r.dirty = false
	ctx.Remotes.Push:FireClient(player, "state", snapshot(player, data))
end

-- ===== Customers =====
local function spawnCustomer(player: Player, data: any, r: Runtime)
	local critter
	if data.forceCritter ~= "" then
		critter = critterDef(data.forceCritter)
		data.forceCritter = ""
	else
		critter = Rarity.pickWeighted(Config.Critters, rng:NextNumber())
	end
	local order = "any"
	if rng:NextNumber() < 0.4 then
		local options = {}
		for _, id in ipairs(Config.MeatOrder) do
			local m = Config.Meats[id]
			if not m.premium and (meatAvailable(player, data, m)) and m.cookTime <= 1800 then
				table.insert(options, id)
			end
		end
		if #options > 0 then
			order = options[rng:NextInteger(1, #options)]
		end
	end
	r.nextCustomerId += 1
	local customer = {
		id = r.nextCustomerId,
		critter = critter.id,
		order = order,
		muddy = critter.bellyRub and GameService.isSudsWeekend() and rng:NextNumber() < Config.SUDS_PUP_CHANCE or false,
		leaveAt = T() + Config.CUSTOMER_PATIENCE,
		spot = 0,
	}
	local used = {}
	for _, c in ipairs(r.customers) do
		used[c.spot] = true
	end
	for s = 1, Config.CUSTOMER_SPOTS do
		if not used[s] then
			customer.spot = s
			break
		end
	end
	table.insert(r.customers, customer)
	ctx.World.spawnCustomer(player, customer, critter)
	GameService.markDirty(player)
end

-- ===== Lifecycle =====
local function onLoaded(player: Player, profile: any, isNew: boolean)
	local data = profile.data
	local lastSeen = data.lastSeen or 0
	local r: Runtime = {
		plot = nil,
		passes = {},
		sessionStart = os.clock(),
		lastActive = os.clock(),
		nudged = false,
		dirty = true,
		today = today(),
		crew = 0,
		customers = {},
		nextCustomerId = 0,
		nextSpawn = T() + 3,
		lastAutoServe = 0,
		snagLockUntil = 0,
		snagCooldownUntil = 0,
		peaceChangedAt = -1e9,
		rush = nil,
		resting = false,
		cookoffReadyAt = 0,
		announcedDone = {},
	}
	GameService.runtime[player] = r
	r.passes = ctx.Purchase.loadPasses(player)

	-- Offline progress: one jump from the saved `last` of each cook to now.
	local readyBefore = 0
	for _, cook in pairs(data.stations) do
		if type(cook) == "table" and CookLogic.isDone(cook) then
			readyBefore += 1
		end
	end
	advanceAll(player, data, T(), false)
	local readyAfter = 0
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" and CookLogic.isDone(cook) then
			readyAfter += 1
			r.announcedDone[key] = true
		end
	end

	PitmasterPath.registerPlayDay(data.path, r.today)
	local rank = Config.Ranks[data.rank]
	if rank and rank.unlock then
		data.owned[rank.unlock] = true
	end

	r.plot = ctx.World.assignPlot(player)
	ctx.Social.onJoin(player)
	ctx.Cosmetics.apply(player)
	ctx.World.refreshStations(player)
	GameService.push(player)

	if isNew then
		ctx.Remotes.Push:FireClient(player, "welcome", { isNew = true })
	elseif readyAfter > readyBefore and lastSeen > 0 then
		local away = os.time() - lastSeen
		ctx.Remotes.Push:FireClient(player, "welcome", { isNew = false, away = away, ready = readyAfter - readyBefore })
	else
		ctx.Remotes.Push:FireClient(player, "welcome", { isNew = false })
	end
	if ctx.Data.isStudioMemoryMode(player) then
		GameService.toast(player, "Studio test mode: saving is off. Turn on 'Enable Studio Access to API Services' to test saving.", "warn")
	end
end

local function onRemoving(player: Player)
	local data = profileOf(player)
	if data then
		advanceAll(player, data, T(), false)
	end
	ctx.Social.onLeave(player)
	ctx.World.releasePlot(player)
	globalLimiter:forget(player)
	GameService.runtime[player] = nil
	ctx.Data.release(player)
end

local function handle(player: Player, action: any, a: any, b: any, c: any): (boolean, string?)
	if type(action) ~= "string" or #action > 24 then
		return false, "Bad request."
	end
	local fn = Actions[action]
	if not fn then
		return false, "Unknown action."
	end
	local now = os.clock()
	if not globalLimiter:allow(player, now) or not actionLimiter:allow(tostring(player.UserId) .. action, now) then
		return false, "Slow down, partner!"
	end
	local data = profileOf(player)
	local r = rt(player)
	if not data or not r then
		return false, "Still loading your ranch..."
	end
	r.lastActive = now
	advanceAll(player, data, T(), true)
	local ok, res, msg = pcall(function()
		return (fn :: any)(player, data, a, b, c)
	end)
	if not ok then
		warn("[GameService] action " .. action .. " errored: " .. tostring(res))
		return false, "Something went wrong."
	end
	GameService.markDirty(player)
	return res, msg
end

function GameService.init(c: any)
	ctx = c
end

function GameService.start()
	ctx.Remotes.Action.OnServerInvoke = function(player: Player, action: any, a: any, b: any, c: any)
		local ok, msg = handle(player, action, a, b, c)
		return { ok = ok, msg = msg }
	end

	ctx.Data.onLoaded.Event:Connect(onLoaded)
	Players.PlayerAdded:Connect(function(player)
		ctx.Data.load(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(ctx.Data.load, player)
	end
	Players.PlayerRemoving:Connect(onRemoving)

	-- 1-second simulation tick
	task.spawn(function()
		while true do
			task.wait(1)
			local t = T()
			for player, r in pairs(GameService.runtime) do
				local data = profileOf(player)
				if data then
					advanceAll(player, data, t, true)
					data.playSeconds += 1
					-- day rollover while playing
					local d = today()
					if d ~= r.today then
						r.today = d
						PitmasterPath.registerPlayDay(data.path, d)
						GameService.toast(player, "A new day at the ranch! Daily reward and a new Path step are ready.", "good")
						r.dirty = true
					end
					-- customers
					for i = #r.customers, 1, -1 do
						local cst = r.customers[i]
						if t > cst.leaveAt then
							removeCustomer(player, cst)
						end
					end
					if #r.customers < Config.CUSTOMER_SPOTS and t >= r.nextSpawn then
						r.nextSpawn = t + Config.CUSTOMER_SPAWN_SECONDS * (0.7 + rng:NextNumber() * 0.6)
						spawnCustomer(player, data, r)
					end
					-- Possum Pete auto-serve pass
					if GameService.hasPass(player, "AutoServe") and t - r.lastAutoServe >= 4 and #r.customers > 0 and #data.cooler > 0 then
						r.lastAutoServe = t
						GameService.serveCustomer(player, r.customers[1])
					end
					-- healthy-play nudge after an hour
					if not r.nudged and (os.clock() - r.sessionStart) > Config.PLAYTIME_NUDGE_MINUTES * 60 then
						r.nudged = true
						GameService.toast(player, "You've been smokin' for an hour! Take a stretch break. Your smokers keep cooking while you're away. 🌤️", "info")
					end
				end
			end
		end
	end)

	-- push loop (coalesces many changes into at most 4 snapshots/sec per player)
	task.spawn(function()
		while true do
			task.wait(0.25)
			for player, r in pairs(GameService.runtime) do
				if r.dirty then
					GameService.push(player)
				end
			end
		end
	end)

	-- refresh timers on clients every 5s even if nothing changed (restock countdown etc.)
	task.spawn(function()
		while true do
			task.wait(5)
			for player, _ in pairs(GameService.runtime) do
				GameService.markDirty(player)
			end
		end
	end)
end

return GameService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PurchaseService — Game Passes and Developer Products.
	  * ProcessReceipt is idempotent: each PurchaseId is recorded in the player's save
	    (ReceiptLedger) and the save must succeed before we tell Roblox "PurchaseGranted".
	    If Roblox calls again for the same PurchaseId we just say "granted" without re-granting.
	  * IDs live in ReplicatedStorage.Shared.Monetization. Items with id 0 are hidden in the
	    live game; in Studio they get a free "Studio test" grant so you can try everything.
	  * Nothing sold here is random. Robux never buys coins.
]]
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Monetization = require(Shared.Monetization)
local ReceiptLedger = require(Shared.Logic.ReceiptLedger)
local CookLogic = require(Shared.Logic.CookLogic)
local CookOff = require(Shared.Logic.CookOff)
local TimeUtil = require(Shared.Logic.TimeUtil)

local PurchaseService = {}
local ctx: any = nil
local RECEIPT_MEMORY = 50
local IS_STUDIO = RunService:IsStudio()

local productById: { [number]: string } = {}
local passById: { [number]: string } = {}
local policies: { [Player]: any } = {}

for key, p in pairs(Monetization.Products) do
	if p.id ~= 0 then
		productById[p.id] = key
	end
end
for key, p in pairs(Monetization.Passes) do
	if p.id ~= 0 then
		passById[p.id] = key
	end
end

local function featuredNow(): { [string]: boolean }
	local week = TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
	local set = {}
	for _, k in ipairs(CookOff.rotation(Config.RotationPool, Config.ROTATION_FEATURED, week)) do
		set[k] = true
	end
	return set
end

-- Which items can be bought here: real ID, or anything while play-testing in Studio.
function PurchaseService.availability(): any
	local out = { products = {}, passes = {}, studio = IS_STUDIO }
	for key, p in pairs(Monetization.Products) do
		out.products[key] = p.id ~= 0 or IS_STUDIO
	end
	for key, p in pairs(Monetization.Passes) do
		out.passes[key] = p.id ~= 0 or IS_STUDIO
	end
	return out
end

function PurchaseService.loadPasses(player: Player): { [string]: boolean }
	local owned = {}
	for key, p in pairs(Monetization.Passes) do
		if p.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.id)
			end)
			if ok and has then
				owned[key] = true
			end
		end
	end
	-- Studio test grants persist in the save under owned["pass:<key>"] (Studio only).
	local data = ctx.Game.dataOf(player)
	if IS_STUDIO and data then
		for key in pairs(Monetization.Passes) do
			if data.owned["pass:" .. key] then
				owned[key] = true
			end
		end
	end
	if owned.VIPPatio and data then
		data.owned.vip_lights = true
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		policies[player] = ok and info or nil
	end)
	return owned
end

-- Roblox policy for this player (paid random items are never sold here regardless).
function PurchaseService.policy(player: Player): any?
	return policies[player]
end

local function cosmeticsOwned(data: any, grants: { string }?): boolean
	if not grants or #grants == 0 then
		return false
	end
	for _, id in ipairs(grants) do
		if not data.owned[id] then
			return false
		end
	end
	return true
end

-- Apply a developer product to a player's data. Returns a toast message.
local function grantProduct(player: Player, data: any, key: string): string
	local p = Monetization.Products[key]
	if p.kind == "boost" then
		ctx.Game.addBoost(data, p.minutes or 30, p.mult or 2)
		-- Fair Play: everyone else in the server gets a free Smoke Shower.
		local now = workspace:GetServerTimeNow()
		for other in pairs(ctx.Game.runtime) do
			local od = other ~= player and ctx.Game.dataOf(other) or nil
			if od and od.boost.untilT <= now then
				ctx.Game.addBoost(od, Config.FairPlay.showerMinutes, Config.FairPlay.showerMult)
				ctx.Game.markDirty(other)
				ctx.Game.toast(other, string.format("💨 Smoke Shower from %s! Everyone gets x%.2g speed for %d min.", player.DisplayName, Config.FairPlay.showerMult, Config.FairPlay.showerMinutes), "good")
			end
		end
	elseif p.kind == "finish" then
		local t = workspace:GetServerTimeNow()
		ctx.Game.advanceAll(player, data, t, false)
		for _, cook in pairs(data.stations) do
			if type(cook) == "table" and not CookLogic.isDone(cook) then
				CookLogic.finishNow(cook, t)
			end
		end
	elseif p.kind == "cut" and p.cut then
		data.cuts[p.cut] = (data.cuts[p.cut] or 0) + (p.count or 1)
	elseif p.kind == "cosmetic" or p.kind == "bundle" then
		for _, id in ipairs(p.grants or {}) do
			ctx.Game.grantCosmetic(player, data, id)
		end
		if p.kind == "bundle" and p.minutes then
			ctx.Game.addBoost(data, p.minutes, p.mult or 2)
		end
	end
	ctx.Game.markDirty(player)
	return "Thanks! " .. p.icon .. " " .. p.name .. " is yours."
end

local function grantPass(player: Player, key: string)
	local r = ctx.Game.runtime[player]
	if not r then
		return
	end
	r.passes[key] = true
	local data = ctx.Game.dataOf(player)
	if key == "VIPPatio" and data then
		data.owned.vip_lights = true
		data.equipped.patio = "vip_lights"
	end
	ctx.Game.toast(player, "Thanks! " .. Monetization.Passes[key].icon .. " " .. Monetization.Passes[key].name .. " is active.", "good")
	ctx.World.refreshStations(player)
	ctx.Cosmetics.apply(player)
	ctx.Game.markDirty(player)
end

function PurchaseService.prompt(player: Player, kind: string, key: string): (boolean, string?)
	local data = ctx.Game.dataOf(player)
	if not data then
		return false, "Still loading..."
	end
	if kind == "pass" then
		local p = Monetization.Passes[key]
		if not p then
			return false, "Not found."
		end
		if ctx.Game.hasPass(player, key) then
			return false, "You already have this."
		end
		if p.id == 0 then
			if IS_STUDIO then
				data.owned["pass:" .. key] = true
				grantPass(player, key)
				return true, "Studio test: pass granted for free (only in Studio)."
			end
			return false, "Not on sale yet."
		end
		MarketplaceService:PromptGamePassPurchase(player, p.id)
		return true, nil
	end
	local p = Monetization.Products[key]
	if not p then
		return false, "Not found."
	end
	if p.rotation and not featuredNow()[key] then
		return false, "That one's not in this week's rotation. It'll be back!"
	end
	if (p.kind == "cosmetic" or p.kind == "bundle") and cosmeticsOwned(data, p.grants) then
		return false, "You already own everything in this."
	end
	if p.kind == "finish" then
		local any = false
		for _, cook in pairs(data.stations) do
			if type(cook) == "table" and not CookLogic.isDone(cook) then
				any = true
			end
		end
		if not any then
			return false, "Nothing is cooking right now."
		end
	end
	if p.id == 0 then
		if IS_STUDIO then
			local msg = grantProduct(player, data, key)
			ctx.World.refreshStations(player)
			return true, "Studio test (free): " .. msg
		end
		return false, "Not on sale yet."
	end
	MarketplaceService:PromptProductPurchase(player, p.id)
	return true, nil
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = ctx.Data.waitFor(player, 10)
	if not profile or not ctx.Game.runtime[player] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = profile.data
	local purchaseId = tostring(info.PurchaseId)
	if ReceiptLedger.has(data.receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productById[info.ProductId]
	if not key then
		warn("[PurchaseService] unknown product id " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, msg = pcall(grantProduct, player, data, key)
	if not ok then
		warn("[PurchaseService] grant failed: " .. tostring(msg))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	ReceiptLedger.add(data.receipts, purchaseId, RECEIPT_MEMORY)
	-- Only confirm once the grant + receipt id are safely saved.
	if not ctx.Data.save(profile, false) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	ctx.Game.toast(player, msg, "good")
	ctx.World.refreshStations(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function PurchaseService.init(c: any)
	ctx = c
end

function PurchaseService.start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local key = passById[passId]
		if purchased and key then
			grantPass(player, key)
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		policies[p] = nil
	end)
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">SocialService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SocialService — friendly multiplayer.
	  * Crew bonus: +10% coins for each friend in the server (max 3).
	  * Plate snagging ("you got taxed!"): grab ONE Common/Juicy plate from another player's
	    pass window. Rules that keep it fun instead of mean:
	      - only while the owner is online and in the game (never offline),
	      - never from someone in Peace Mode (and Peace Mode players can't snag),
	      - new arrivals are shielded for their first 5 minutes,
	      - after a snag the victim's window locks for 3 minutes,
	      - the victim instantly gets 25% of the plate's value back ("insurance"),
	      - the victim can tag the snagger within 15 seconds to get it back plus a bonus,
	      - paid perks never change any of this.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Rarity = require(Shared.Logic.Rarity)
local Economy = require(Shared.Logic.Economy)
local WorldBuilder = require(Shared.WorldBuilder)

local SocialService = {}
local ctx: any = nil
local S = Config.Snag

local friendCache: { [string]: boolean } = {}
local running: { [Player]: any } = {} -- snagger -> { victim, plate, untilT, prompt, gui }

local function pairKey(a: number, b: number): string
	if a < b then
		return a .. ":" .. b
	end
	return b .. ":" .. a
end

local function areFriends(a: Player, b: Player): boolean
	local k = pairKey(a.UserId, b.UserId)
	local cached = friendCache[k]
	if cached ~= nil then
		return cached
	end
	local ok, res = pcall(function()
		return a:IsFriendsWithAsync(b.UserId)
	end)
	if not ok then
		-- older engine builds only have the non-Async name
		ok, res = pcall(function()
			return (a :: any):IsFriendsWith(b.UserId)
		end)
	end
	local v = ok and res == true
	friendCache[k] = v
	return v
end

local function recountCrew()
	for player, r in pairs(ctx.Game.runtime) do
		local n = 0
		for other in pairs(ctx.Game.runtime) do
			if other ~= player and areFriends(player, other) then
				n += 1
			end
		end
		n = math.min(n, Config.Crew.maxFriends)
		if n ~= r.crew then
			if n > r.crew then
				ctx.Game.toast(player, string.format("Crew bonus! +%d%% coins with %d friend%s here. 🤝", math.floor(n * Config.Crew.perFriend * 100 + 0.5), n, n == 1 and "" or "s"), "good")
			end
			r.crew = n
			ctx.Game.markDirty(player)
		end
	end
end

function SocialService.onJoin(_player: Player)
	task.spawn(recountCrew)
end

function SocialService.onLeave(player: Player)
	local run = running[player]
	if run then
		-- snagger left mid-run: plate goes home
		SocialService.finishRun(player, true)
	end
	for snagger, rr in pairs(running) do
		if rr.victim == player then
			SocialService.finishRun(snagger, false)
		end
	end
	task.defer(recountCrew)
end

local function baseValue(plate: any): number
	-- Paid perks don't count: just price x rarity.
	local meat = Config.Meats[plate.m]
	local rar = Rarity.get(Config.Rarities, plate.r)
	return math.floor(meat.price * rar.mult)
end

local function snaggableIndex(data: any): number?
	local best, bestV = nil, math.huge
	for i, plate in ipairs(data.cooler) do
		local ri = Rarity.indexOf(Config.Rarities, plate.r)
		if ri <= S.maxRarityIndex and plate.m ~= "firstbrisket" then
			local v = baseValue(plate)
			if v < bestV then
				best, bestV = i, v
			end
		end
	end
	return best
end

-- Why can't `victim` be snagged right now? nil = they can.
local function victimBlock(victim: Player): string?
	local data = ctx.Game.dataOf(victim)
	local r = ctx.Game.runtime[victim]
	if not data or not r then
		return "loading"
	end
	if data.settings.peace then
		return "peace"
	end
	if os.clock() - r.sessionStart < S.newPlayerShield then
		return "shield"
	end
	if os.clock() < r.snagLockUntil then
		return "locked"
	end
	if r.resting then
		return "resting"
	end
	if not snaggableIndex(data) then
		return "empty"
	end
	for _, rr in pairs(running) do
		if rr.victim == victim then
			return "locked"
		end
	end
	return nil
end

function SocialService.refreshPassWindow(victim: Player)
	local plot = ctx.World.plotModel(victim)
	if not plot then
		return
	end
	local counter = plot.PassWindow.Counter :: BasePart
	local prompt = counter:FindFirstChild("Prompt") :: ProximityPrompt
	local gui = counter:FindFirstChild("LockGui") :: BillboardGui
	local label = gui:FindFirstChild("Text") :: TextLabel
	local why = victimBlock(victim)
	prompt.Enabled = why == nil
	prompt:SetAttribute("OwnerUserId", victim.UserId) -- the owner's client hides this prompt for themselves
	local r = ctx.Game.runtime[victim]
	if why == "peace" then
		label.Text = "🕊️ Peace Mode"
	elseif why == "shield" and r then
		label.Text = "🛡️ New arrival shield"
	elseif why == "locked" and r then
		local left = math.max(0, math.ceil(r.snagLockUntil - os.clock()))
		label.Text = left > 0 and ("🔒 Locked " .. left .. "s") or "🔒 Locked"
	elseif why == "resting" then
		label.Text = "💤 Resting"
	else
		label.Text = ""
	end
end

local function carryVisual(snagger: Player, plate: any): (ProximityPrompt?, BillboardGui?)
	local char = snagger.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	if not hrp or not head then
		return nil, nil
	end
	local meat = Config.Meats[plate.m]
	local gui = WorldBuilder.billboard(head, "TaxedGui", "🍽️ " .. meat.icon .. " TAXED!", 3, 120, "#FFC83C", 200, 40)
	gui.AlwaysOnTop = true
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "CatchPrompt"
	prompt.ActionText = "Tag back!"
	prompt.ObjectText = snagger.DisplayName .. " has your plate"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = S.catchDistance
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Kind", "catch")
	prompt:SetAttribute("SnaggerUserId", snagger.UserId)
	prompt.Parent = hrp
	return prompt, gui
end

function SocialService.finishRun(snagger: Player, returned: boolean)
	local run = running[snagger]
	if not run then
		return
	end
	running[snagger] = nil
	if run.prompt then
		run.prompt:Destroy()
	end
	if run.gui then
		run.gui:Destroy()
	end
	local victim: Player = run.victim
	local vdata = ctx.Game.dataOf(victim)
	local sdata = ctx.Game.dataOf(snagger)
	if returned then
		if vdata and victim.Parent then
			ctx.Game.addPlate(vdata, run.plate)
			ctx.World.refreshStations(victim)
			ctx.Game.markDirty(victim)
		end
	else
		if sdata and snagger.Parent then
			if not ctx.Game.addPlate(sdata, run.plate) then
				ctx.Game.addCoins(snagger, sdata, baseValue(run.plate), true)
			end
			sdata.stats.snags += 1
			ctx.Game.toast(snagger, "Clean getaway! The plate's in your cooler. 😎", "good")
			ctx.World.refreshStations(snagger)
			ctx.Game.markDirty(snagger)
		end
	end
end

function SocialService.trySnag(snagger: Player, prompt: ProximityPrompt)
	local node: Instance? = prompt.Parent
	while node and not node:GetAttribute("PlotIndex") do
		node = node.Parent
	end
	if not node then
		return
	end
	local victim = ctx.World.ownerOfPlot(node:GetAttribute("PlotIndex") :: number)
	if not victim or victim == snagger then
		return
	end
	local sdata = ctx.Game.dataOf(snagger)
	local sr = ctx.Game.runtime[snagger]
	if not sdata or not sr then
		return
	end
	if sdata.settings.peace then
		ctx.Game.toast(snagger, "You're in Peace Mode, so no snagging. (Turn it off in Settings.)", "info")
		return
	end
	if running[snagger] then
		return
	end
	if os.clock() < sr.snagCooldownUntil then
		ctx.Game.toast(snagger, string.format("Catch your breath! You can snag again in %ds.", math.ceil(sr.snagCooldownUntil - os.clock())), "info")
		return
	end
	if #sdata.cooler >= Config.COOLER_MAX then
		ctx.Game.toast(snagger, "Your cooler's full!", "info")
		return
	end
	if victimBlock(victim) then
		return
	end
	local vdata = ctx.Game.dataOf(victim)
	local vr = ctx.Game.runtime[victim]
	local idx = snaggableIndex(vdata)
	if not idx then
		return
	end
	local plate = table.remove(vdata.cooler, idx)
	sr.snagCooldownUntil = os.clock() + S.cooldown
	vr.snagLockUntil = os.clock() + S.victimLock
	local insurance = math.floor(baseValue(plate) * S.insurance)
	ctx.Game.addCoins(victim, vdata, insurance, true)
	local meat = Config.Meats[plate.m]
	ctx.Game.toast(victim, string.format("%s %s snagged your %s! You got %d coins back. Tag them within %ds to get it back!", Content.Slang.snagged, snagger.DisplayName, meat.name, insurance, S.catchWindow), "warn")
	ctx.Game.toast(snagger, Content.Slang.snagger, "good")
	local cp, gui = carryVisual(snagger, plate)
	if cp then
		cp:SetAttribute("OwnerUserId", victim.UserId) -- only the victim's client shows this prompt
	end
	running[snagger] = { victim = victim, plate = plate, untilT = os.clock() + S.catchWindow, prompt = cp, gui = gui }
	ctx.Remotes.Push:FireClient(victim, "fx", { kind = "snagged", data = { by = snagger.DisplayName, window = S.catchWindow } })
	ctx.World.refreshStations(victim)
	ctx.Game.markDirty(victim)
	ctx.Game.markDirty(snagger)
	task.delay(S.catchWindow, function()
		if running[snagger] and running[snagger].plate == plate then
			SocialService.finishRun(snagger, false)
		end
	end)
end

function SocialService.tryCatch(victim: Player, prompt: ProximityPrompt)
	local snaggerId = prompt:GetAttribute("SnaggerUserId")
	local snagger = typeof(snaggerId) == "number" and Players:GetPlayerByUserId(snaggerId) or nil
	if not snagger then
		return
	end
	local run = running[snagger]
	if not run or run.victim ~= victim or os.clock() > run.untilT then
		return
	end
	-- distance double-check on the server
	local a = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local b = snagger.Character and snagger.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not a or not b or (a.Position - b.Position).Magnitude > S.catchDistance + 4 then
		return
	end
	SocialService.finishRun(snagger, true)
	local vdata = ctx.Game.dataOf(victim)
	if vdata then
		local bonus = math.floor(S.catchBonus * Economy.rankMult(vdata.rank, Config.RANK_STEP))
		ctx.Game.addCoins(victim, vdata, bonus, true)
		ctx.Game.toast(victim, string.format("Caught 'em! Plate's back, +%d bonus. 💪", bonus), "good")
	end
	ctx.Game.toast(snagger, "Caught! " .. Content.Slang.crine, "bad")
end

function SocialService.init(c: any)
	ctx = c
end

function SocialService.start()
	task.spawn(function()
		while true do
			task.wait(1)
			for player in pairs(ctx.Game.runtime) do
				SocialService.refreshPassWindow(player)
			end
		end
	end)
end

return SocialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
-- WorldService — the physical ranch: plots, smokers, meat visuals, critter customers, smoke signals.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local WorldBuilder = require(Shared.WorldBuilder)
local CookLogic = require(Shared.Logic.CookLogic)
local Rarity = require(Shared.Logic.Rarity)

local WorldService = {}
local ctx: any = nil

local ENV = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}
WorldService.ENV = ENV

local plotOwner: { [number]: Player } = {}
local playerPlot: { [Player]: number } = {}
local customerModels: { [Player]: { [number]: Model } } = {}
local map: any = nil

function WorldService.map(): any
	return map
end

function WorldService.plotModel(player: Player): any
	local i = playerPlot[player]
	if not i then
		return nil
	end
	return map.Plots:FindFirstChild("Plot" .. i) :: Model?
end

function WorldService.ownerOfPlot(i: number): Player?
	return plotOwner[i]
end

function WorldService.plotIndexOf(player: Player): number?
	return playerPlot[player]
end

local function setOwnerSign(i: number, player: Player?)
	local plot = map.Plots:FindFirstChild("Plot" .. i)
	if not plot then
		return
	end
	local label = plot.Sign.Board:FindFirstChild("SignGui") and plot.Sign.Board.SignGui:FindFirstChild("OwnerText")
	if label then
		label.Text = player and (player.DisplayName .. "'s Ranch") or "Open Ranch"
	end
	plot:SetAttribute("OwnerUserId", player and player.UserId or 0)
end

local function teleportHome(player: Player)
	local plot = WorldService.plotModel(player)
	local char = player.Character
	if not plot or not char then
		return
	end
	local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pad = plot:FindFirstChild("SpawnPad") :: BasePart?
	if hrp and pad then
		char:PivotTo(pad.CFrame + Vector3.new(0, 4, 0))
	end
end
WorldService.teleportHome = teleportHome

function WorldService.assignPlot(player: Player): number?
	for i = 1, Config.MAX_PLOTS do
		if not plotOwner[i] then
			plotOwner[i] = player
			playerPlot[player] = i
			customerModels[player] = {}
			setOwnerSign(i, player)
			player:SetAttribute("Plot", i)
			player.CharacterAdded:Connect(function()
				task.wait(0.2)
				teleportHome(player)
				ctx.Cosmetics.apply(player)
			end)
			if player.Character then
				task.defer(teleportHome, player)
			end
			return i
		end
	end
	return nil
end

function WorldService.releasePlot(player: Player)
	local i = playerPlot[player]
	if not i then
		return
	end
	for _, m in pairs(customerModels[player] or {}) do
		m:Destroy()
	end
	customerModels[player] = nil
	plotOwner[i] = nil
	playerPlot[player] = nil
	setOwnerSign(i, nil)
	-- clear visuals
	local plot = map.Plots:FindFirstChild("Plot" .. i)
	if plot then
		for _, s in ipairs(plot.Smokers:GetChildren()) do
			local spot = s:FindFirstChild("MeatSpot")
			if spot then
				spot:ClearAllChildren()
			end
			s.Chimney.Smoke.Enabled = false
			s.Barrel.SlotGui.Text.Text = ""
		end
		for _, g in ipairs(plot.Grill:GetChildren()) do
			if g:GetAttribute("Slot") then
				for _, c in ipairs(g:GetChildren()) do
					if c.Name == "Meat" then
						c:Destroy()
					end
				end
				g.SlotGui.Text.Text = ""
			end
		end
		plot.PassWindow.Plates:ClearAllChildren()
		plot.PassWindow.Counter.Prompt.Enabled = false
		for _, b in ipairs(plot.VIPLights:GetChildren()) do
			if b:IsA("BasePart") then
				b.Transparency = 1
			end
		end
	end
end

local function colorOf(h: string): Color3
	return Color3.fromHex(h)
end
local LOCKED_COLOR = Color3.fromHex("#1C1A1F")

-- Repaint smokers & meat for one player's plot.
function WorldService.refreshStations(player: Player)
	local plot = WorldService.plotModel(player)
	local data = ctx.Game.dataOf(player)
	if not plot or not data then
		return
	end
	local t = workspace:GetServerTimeNow()
	local smokerCount = ctx.Game.slotCount(player, data, "smoker")
	local grillCount = ctx.Game.slotCount(player, data, "grill")
	local pitDef = Config.PitLevels[data.pitLevel]
	local skinId = data.equipped.skin
	local skin = skinId and Config.Cosmetics[skinId] or nil
	local smokeId = data.equipped.smoke
	local smokeDef = smokeId and Config.Cosmetics[smokeId] or nil
	local bodyColor = skin and colorOf(skin.color) or colorOf(pitDef.color)
	local material = (skin and skin.neon) and Enum.Material.Neon or ((skin and skin.gold) and Enum.Material.Foil or Enum.Material.Metal)

	for i = 1, #WorldBuilder.SMOKER_X do
		local key = "s" .. i
		local s = plot.Smokers:FindFirstChild(key) :: Model?
		if s then
			local unlocked = i <= smokerCount
			local barrel = s:FindFirstChild("Barrel") :: BasePart
			local spot = s:FindFirstChild("MeatSpot") :: BasePart
			local chimney = s:FindFirstChild("Chimney") :: BasePart
			local smoke = chimney:FindFirstChild("Smoke") :: Smoke
			local label = (barrel:FindFirstChild("SlotGui") :: BillboardGui):FindFirstChild("Text") :: TextLabel
			-- Locked smokers read as a dark silhouette with a padlock sign (no see-through ghosts).
			for _, p in ipairs(s:GetChildren()) do
				if p:IsA("BasePart") and p.Name ~= "MeatSpot" and p.Name ~= "LockSign" then
					p.Transparency = 0
					local base = p:GetAttribute("BaseColor")
					p.Color = unlocked and (typeof(base) == "string" and colorOf(base) or p.Color) or LOCKED_COLOR
				end
			end
			local lockSign = s:FindFirstChild("LockSign") :: BasePart?
			if lockSign then
				lockSign.Transparency = unlocked and 1 or 0
				for _, lg in ipairs(lockSign:GetChildren()) do
					if lg:IsA("SurfaceGui") then
						lg.Enabled = not unlocked
					end
				end
			end
			barrel.Color = unlocked and bodyColor or LOCKED_COLOR
			barrel.Material = unlocked and material or Enum.Material.SmoothPlastic
			spot:ClearAllChildren()
			local cook = data.stations[key]
			if unlocked and type(cook) == "table" then
				local meat = Config.Meats[cook.meat]
				local done = CookLogic.isDone(cook)
				local rar = done and Rarity.get(Config.Rarities, cook.rarity) or nil
				WorldBuilder.meat(ENV, spot, meat, rar, spot.CFrame, CookLogic.fraction(cook))
				smoke.Enabled = not done
				smoke.Color = smokeDef and colorOf(smokeDef.color) or Color3.fromRGB(221, 221, 221)
				label.Text = meat.icon .. " " .. meat.name .. (done and " ✅" or "")
			else
				smoke.Enabled = false
				label.Text = unlocked and "Empty smoker" or "🔒 Locked"
			end
			s:SetAttribute("Unlocked", unlocked)
		end
	end

	local grill = plot.Grill
	local anyGrill = false
	for i = 1, #WorldBuilder.GRILL_X do
		local key = "g" .. i
		local g = grill:FindFirstChild(key) :: BasePart?
		if g then
			local unlocked = i <= grillCount
			g.Transparency = 0
			g.Color = unlocked and colorOf("#333333") or LOCKED_COLOR
			for _, c in ipairs(g:GetChildren()) do
				if c.Name == "Meat" then
					c:Destroy()
				end
			end
			local cook = data.stations[key]
			local label = (g:FindFirstChild("SlotGui") :: BillboardGui):FindFirstChild("Text") :: TextLabel
			if unlocked and type(cook) == "table" then
				anyGrill = true
				local meat = Config.Meats[cook.meat]
				local mp = WorldBuilder.meat(ENV, g, meat, nil, g.CFrame * CFrame.new(0, 0.1, 0), CookLogic.fraction(cook))
				if cook.burnt then
					mp.Color = Color3.fromRGB(20, 20, 20)
				end
				label.Text = meat.icon .. (cook.burnt and " burnt" or (CookLogic.isDone(cook) and " ✅" or ""))
			else
				label.Text = unlocked and "" or "🔒"
			end
		end
	end
	local gs = (grill:FindFirstChild("Top") :: BasePart):FindFirstChild("Smoke") :: Smoke
	gs.Enabled = anyGrill

	-- pass window plates (shows up to 4)
	local plates = plot.PassWindow.Plates
	plates:ClearAllChildren()
	local counter = plot.PassWindow.Counter :: BasePart
	for pi = 1, math.min(4, #data.cooler) do
		local plate = Instance.new("Part")
		plate.Name = "Plate"
		plate.Shape = Enum.PartType.Cylinder
		plate.Size = Vector3.new(0.2, 1.6, 1.6)
		plate.Anchored = true
		plate.CanCollide = false
		plate.Color = Color3.fromRGB(245, 245, 245)
		plate.CFrame = counter.CFrame * CFrame.new(-3 + (pi - 1) * 2, 1.95, 0) * CFrame.Angles(0, 0, math.pi / 2)
		plate.Parent = plates
		local meat = Config.Meats[data.cooler[pi].m]
		if meat then
			local m = WorldBuilder.meat(ENV, plates, meat, nil, counter.CFrame * CFrame.new(-3 + (pi - 1) * 2, 2.05, 0), 1)
			m.Size = m.Size * 0.45
		end
	end

	-- VIP Patio
	local vip = ctx.Game.hasPass(player, "VIPPatio") or data.equipped.patio == "vip_lights"
	for _, b in ipairs(plot.VIPLights:GetChildren()) do
		if b:IsA("BasePart") then
			b.Transparency = vip and 0 or 1
			local sg = b:FindFirstChild("SignGui")
			if sg then
				(sg :: any).Text.TextTransparency = vip and 0 or 1
			end
		end
	end
	ctx.Social.refreshPassWindow(player)
	local _ = t
end

-- ===== critter customers =====
local function moveModel(m: Model, from: CFrame, to: CFrame, seconds: number)
	task.spawn(function()
		local t0 = os.clock()
		while m.Parent and os.clock() - t0 < seconds do
			local a = (os.clock() - t0) / seconds
			local cf = from:Lerp(to, a)
			m:PivotTo(cf * CFrame.new(0, math.abs(math.sin(a * math.pi * 6)) * 0.4, 0))
			RunService.Heartbeat:Wait()
		end
		if m.Parent then
			m:PivotTo(to)
		end
	end)
end

function WorldService.spawnCustomer(player: Player, customer: any, critter: any)
	local plot = WorldService.plotModel(player)
	if not plot then
		return
	end
	local tbl = plot.Tables:FindFirstChild("t" .. customer.spot)
	if not tbl then
		return
	end
	local seat = tbl.Seat :: BasePart
	local entrance = (plot.SpawnPad :: BasePart).CFrame * CFrame.new(0, -1, -14)
	local folder = plot:FindFirstChild("Customers") or Instance.new("Folder")
	folder.Name = "Customers"
	folder.Parent = plot
	local m, head, body = WorldBuilder.critter(ENV, folder, critter, CFrame.new())
	m.Name = "Customer" .. customer.id
	m:SetAttribute("CustomerId", customer.id)
	m:SetAttribute("OwnerUserId", player.UserId)
	local seatCf = CFrame.lookAt(seat.Position, seat.Position + (seat.CFrame.LookVector)) * CFrame.Angles(0, math.pi, 0)
	m:PivotTo(entrance)
	moveModel(m, entrance, seatCf, 2.2)

	local orderText
	if customer.order == "any" then
		orderText = critter.name .. ": Anything's fine!"
	else
		local meat = Config.Meats[customer.order]
		orderText = critter.name .. ": " .. meat.icon .. " " .. meat.name .. " please!"
	end
	WorldBuilder.billboard(head, "Order", orderText, 2.4, 70, "#FFFFFF", 260, 34, { 10, 1.5 })
	local serve = WorldBuilder.prompt(body, "serve", "Serve", critter.name, 0, 10)
	serve:SetAttribute("CustomerId", customer.id)
	serve:SetAttribute("OwnerUserId", player.UserId)
	if critter.bellyRub then
		local rub = WorldBuilder.prompt(head, "bellyrub", "Rub belly", "Belly Rub Pup", 0.6, 8)
		rub:SetAttribute("CustomerId", customer.id)
		rub:SetAttribute("OwnerUserId", player.UserId)
		rub.UIOffset = Vector2.new(0, 60)
	end
	if customer.muddy then
		for k = 1, 4 do
			local spotPart = Instance.new("Part")
			spotPart.Name = "Mud"
			spotPart.Anchored = true
			spotPart.CanCollide = false
			spotPart.Size = Vector3.new(0.6, 0.15, 0.6)
			spotPart.Color = Color3.fromRGB(92, 64, 40)
			spotPart.CFrame = body.CFrame * CFrame.new(-0.5 + (k % 2), 0.72, -0.8 + k * 0.4)
			spotPart.Parent = m
		end
		local wash = WorldBuilder.prompt(head, "wash", "Wash the pup", "Suds Saturday", 1, 8)
		wash:SetAttribute("CustomerId", customer.id)
		wash:SetAttribute("OwnerUserId", player.UserId)
		wash.UIOffset = Vector2.new(0, 120)
	end
	-- re-anchor parts after pivot (WorldBuilder parts are anchored already)
	customerModels[player][customer.id] = m
end

function WorldService.removeCustomer(player: Player, customer: any)
	local list = customerModels[player]
	local m = list and list[customer.id]
	if m then
		list[customer.id] = nil
		local plot = WorldService.plotModel(player)
		if plot then
			local from = m:GetPivot()
			local to = (plot.SpawnPad :: BasePart).CFrame * CFrame.new(0, -1, -16)
			moveModel(m, from, to, 1.6)
			task.delay(1.7, function()
				m:Destroy()
			end)
		else
			m:Destroy()
		end
	end
end

function WorldService.findCustomer(player: Player, id: number): any?
	local r = ctx.Game.runtime[player]
	if not r then
		return nil
	end
	for _, c in ipairs(r.customers) do
		if c.id == id then
			return c
		end
	end
	return nil
end

function WorldService.smokeSignal(player: Player, text: string, color: string)
	local plot = WorldService.plotModel(player)
	if not plot then
		return
	end
	local sig = plot.SmokeSignal :: BasePart
	local smoke = sig:FindFirstChild("Signal") :: Smoke
	local gui = sig:FindFirstChild("SignalGui") :: BillboardGui
	local data = ctx.Game.dataOf(player)
	local smokeDef = data and data.equipped.smoke and Config.Cosmetics[data.equipped.smoke]
	smoke.Color = smokeDef and colorOf(smokeDef.color) or colorOf(color)
	smoke.Enabled = true
	gui.Enabled = true
	local label = gui:FindFirstChild("Text") :: TextLabel
	-- Display names are already moderated by Roblox; everything else here is fixed game text.
	label.Text = "💨 " .. player.DisplayName .. ": " .. string.upper(text) .. "!"
	label.TextColor3 = colorOf(color)
	task.delay(10, function()
		if sig.Parent then
			smoke.Enabled = false
			gui.Enabled = false
		end
	end)
end

function WorldService.effect(player: Player, kind: string, payload: any)
	local plot = WorldService.plotModel(player)
	if not plot then
		return
	end
	if kind == "smell" then
		local top = plot.Grill.Top :: BasePart
		local puff = Instance.new("Smoke")
		puff.Color = Color3.fromRGB(40, 40, 40)
		puff.Size = 6
		puff.Opacity = 0.5
		puff.RiseVelocity = 6
		puff.Parent = top
		task.delay(4, function()
			puff:Destroy()
		end)
		-- every critter does the scuba wave
		for _, m in pairs(customerModels[player] or {}) do
			local head = m:FindFirstChild("Head")
			if head then
				local b = WorldBuilder.billboard(head, "Scuba", "🤿👋", 4.5, 60, "#FFFFFF", 80, 40)
				task.delay(3, function()
					b:Destroy()
				end)
			end
		end
	elseif kind == "bellyrub" or kind == "wash" or kind == "clap" then
		local m = customerModels[player] and customerModels[player][payload.id]
		if not m then
			return
		end
		local head = m:FindFirstChild("Head")
		if kind == "bellyrub" then
			local base = m:GetPivot()
			m:PivotTo(base * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.pi))
			task.delay(2, function()
				if m.Parent then
					m:PivotTo(base)
				end
			end)
		elseif kind == "wash" then
			for _, c in ipairs(m:GetChildren()) do
				if c.Name == "Mud" then
					c:Destroy()
				end
			end
			local body = m:FindFirstChild("Body")
			if body then
				local sp = Instance.new("Sparkles")
				sp.SparkleColor = Color3.fromRGB(180, 230, 255)
				sp.Parent = body
				task.delay(3, function()
					sp:Destroy()
				end)
			end
		end
		if head then
			local text = kind == "bellyrub" and "♥ ♥ ♥" or (kind == "wash" and "✨ squeaky clean ✨" or "👏👏👏")
			local b = WorldBuilder.billboard(head, "Fx", text, 5, 60, "#FF8FB1", 200, 40)
			task.delay(2.5, function()
				b:Destroy()
			end)
		end
	end
end

-- Slowly darken meat as it cooks (cheap: every 5 seconds).
local function doneLoop()
	while true do
		task.wait(5)
		for player in pairs(playerPlot) do
			WorldService.refreshStations(player)
		end
	end
end

function WorldService.init(c: any)
	ctx = c
	WorldBuilder.setEnv(ENV)
	local existing = workspace:FindFirstChild("Map")
	if existing then
		map = existing :: Model
	else
		map = WorldBuilder.build(ENV, workspace, Config, Content)
	end
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
end

function WorldService.start()
	task.spawn(doneLoop)
	Players.PlayerRemoving:Connect(function(player)
		customerModels[player] = customerModels[player]
	end)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
