          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[--!strict
-- Launch codes. Coins, sauce charges, or a look. Never a crew critter.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")

local Codes = {}

local function clean(raw: any): string
	if type(raw) ~= "string" then
		return ""
	end
	return string.upper((string.gsub(raw, "%s+", "")))
end

function Codes.find(raw: any): any
	local key = clean(raw)
	if key == "" then
		return nil
	end
	for _, row in ipairs(Config.Codes) do
		if row.code == key then
			return row
		end
	end
	return nil
end

export type Result = { ok: boolean, message: string }

function Codes.redeem(data: any, raw: any, now: number, likesLive: boolean): Result
	local row = Codes.find(raw)
	if not row then
		return { ok = false, message = "That code isn't one we know." }
	end
	if type(data.codes) ~= "table" then
		data.codes = {}
	end
	if data.codes[row.code] == true then
		return { ok = false, message = "You already used that code." }
	end
	if type(row.expires) == "number" and now >= row.expires then
		return { ok = false, message = "That code has expired." }
	end
	if row.likes == true and likesLive ~= true then
		return { ok = false, message = "That code isn't turned on yet." }
	end
	data.codes[row.code] = true
	if type(row.coins) == "number" and row.coins > 0 then
		data.coins = (data.coins or 0) + row.coins
	end
	if type(row.sauces) == "table" and type(data.sauces) == "table" then
		for id, n in pairs(row.sauces) do
			local jar = data.sauces[id]
			if type(jar) == "table" and type(n) == "number" then
				jar.charges = (jar.charges or 0) + n
			end
		end
	end
	if type(row.cosmetic) == "string" and row.cosmetic ~= "" then
		if type(data.owned) ~= "table" then
			data.owned = {}
		end
		data.owned[row.cosmetic] = true
	end
	local note = if type(row.note) == "string" then row.note else "Code redeemed."
	return { ok = true, message = note }
end

return Codes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">CookLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CookLogic — real-time cook timers with offline progress.
	A cook stores how many "cook-seconds" of progress it has and when it was last advanced.
	Advancing is piecewise: boosted time (until boostUntil) runs at baseRate * boostMult,
	the rest at baseRate. Because boosts are stored as an absolute expiry time, this works
	identically for online ticks and for a single big jump when a player returns after hours.
]]
local CookLogic = {}

export type Cook = {
	meat: string,
	rarity: string,
	progress: number,
	duration: number,
	last: number,
	startedAt: number,
	rateMult: number, -- from sauces applied at start (1 = none)
	peeks: number,
	revealed: boolean,
	doneAt: number?,
	flip: string?, -- nil | "perfect" | "good" | "miss"
	burnt: boolean?,
	spentToken: boolean?, -- true when this cook spent a premium token, so a rebirth can give it back
	hand: string?, -- set when a ranch hand started it; the plate is marked crew and can't be shared
}

function CookLogic.new(meat: string, rarity: string, duration: number, now: number, rateMult: number?): Cook
	return {
		meat = meat,
		rarity = rarity,
		progress = 0,
		duration = math.max(1, duration),
		last = now,
		startedAt = now,
		rateMult = rateMult or 1,
		peeks = 0,
		revealed = false,
		doneAt = nil,
		flip = nil,
		burnt = nil,
	}
end

-- Effective rate (cook-seconds per real second) without boosts.
function CookLogic.rate(cook: Cook, pitSpeed: number): number
	return pitSpeed * (cook.rateMult or 1)
end

function CookLogic.advance(cook: Cook, now: number, rate: number, boostMult: number, boostUntil: number): Cook
	if now <= cook.last then
		return cook
	end
	local t0 = cook.last
	local boosted = 0
	if boostUntil > t0 and boostMult > 1 then
		boosted = math.min(now, boostUntil) - t0
	end
	local normal = (now - t0) - boosted
	local before = cook.progress
	cook.progress = math.min(cook.duration, cook.progress + boosted * rate * boostMult + normal * rate)
	cook.last = now
	if cook.progress >= cook.duration and before < cook.duration and cook.doneAt == nil then
		-- Find the exact real time it finished (for burn timers), walking the two segments.
		local need = cook.duration - before
		local boostedGain = boosted * rate * boostMult
		local finishAt
		if need <= boostedGain and boosted > 0 then
			finishAt = t0 + need / (rate * boostMult)
		else
			finishAt = t0 + boosted + (need - boostedGain) / rate
		end
		cook.doneAt = finishAt
	end
	return cook
end

function CookLogic.isDone(cook: Cook): boolean
	return cook.progress >= cook.duration - 1e-6
end

function CookLogic.fraction(cook: Cook): number
	return math.clamp(cook.progress / cook.duration, 0, 1)
end

-- Wall-clock seconds until done from `now` (assumes cook already advanced to now).
function CookLogic.remaining(cook: Cook, now: number, rate: number, boostMult: number, boostUntil: number): number
	local left = cook.duration - cook.progress
	if left <= 0 then
		return 0
	end
	if boostUntil > now and boostMult > 1 then
		local boostWindow = boostUntil - now
		local boostedCapacity = boostWindow * rate * boostMult
		if left <= boostedCapacity then
			return left / (rate * boostMult)
		end
		return boostWindow + (left - boostedCapacity) / rate
	end
	return left / rate
end

-- "If you're lookin', you ain't cookin'": peeking reveals the rarity but costs progress.
function CookLogic.peek(cook: Cook, penaltyFraction: number, minPenalty: number): number
	local penalty = math.max(minPenalty, cook.duration * penaltyFraction)
	penalty = math.min(penalty, cook.progress) -- never below zero
	cook.progress -= penalty
	cook.peeks += 1
	cook.revealed = true
	return penalty
end

function CookLogic.finishNow(cook: Cook, now: number)
	if cook.progress < cook.duration then
		cook.progress = cook.duration
		cook.doneAt = now
	end
	cook.last = now
end

-- Burgers burn if left too long after finishing. Only call while the owner is ONLINE,
-- so nobody ever loses food while away.
function CookLogic.shouldBurn(cook: Cook, now: number, grace: number): boolean
	return cook.doneAt ~= nil and not cook.burnt and (now - (cook.doneAt :: number)) > grace
end

-- Spatula flip judged on the server's clock against the cook fraction.
function CookLogic.judgeFlip(fraction: number, target: number, perfectWindow: number, goodWindow: number): string
	local d = math.abs(fraction - target)
	if d <= perfectWindow then
		return "perfect"
	elseif d <= goodWindow then
		return "good"
	end
	return "miss"
end

return CookLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CookOff</string>
            <string name="Source"><![CDATA[--!strict
-- Cook-Off judging. Score 0..100 from rarity, cut value and a perfect flip. Paid perks don't count:
-- premium cuts are judged as if they were a regular brisket.
local CookOff = {}

function CookOff.score(rarityIndex: number, price: number, perfectFlip: boolean): number
	local valuePart = math.min(20, math.max(0, (math.log(math.max(price, 1)) / math.log(2)) * 2))
	local s = rarityIndex * 16 + valuePart + (perfectFlip and 5 or 0)
	return math.clamp(math.floor(s + 0.5), 0, 100)
end

function CookOff.rating(ratings: { any }, score: number): any
	local best = ratings[1]
	for _, r in ipairs(ratings) do
		if score >= r.min then
			best = r
		end
	end
	return best
end

function CookOff.isSaturday(weekday: number): boolean
	return weekday == 7
end

function CookOff.isSudsWeekend(weekday: number): boolean
	return weekday == 7 or weekday == 1
end

function CookOff.seasonFor(seasons: { any }, month: number): any
	for _, s in ipairs(seasons) do
		for _, m in ipairs(s.months) do
			if m == month then
				return s
			end
		end
	end
	return seasons[1]
end

-- Weekly limited-time rotation: which product keys are featured this week.
function CookOff.rotation(pool: { string }, featured: number, week: number): { string }
	local out = {}
	local n = #pool
	if n == 0 then
		return out
	end
	for i = 0, math.min(featured, n) - 1 do
		table.insert(out, pool[((week * featured + i) % n) + 1])
	end
	return out
end

-- ===== The weekly board (pure, so the hub leaderboard text is unit-tested) =====
-- Entries come only on Saturdays (Texas time) and weeks start on Monday, so a week's board is
-- final from Sunday on. What the hub board shows: Saturday = today's live standings, Sunday =
-- yesterday's results, Monday-Friday = last Saturday's champs (the previous week's store) plus the
-- next Cook-Off date. It used to say "Opens Saturday" five days out of seven.
function CookOff.boardMode(weekday: number): string
	if weekday == 7 then
		return "live"
	elseif weekday == 1 then
		return "results"
	end
	return "last"
end

-- Week offset of the final (finished) results for `weekday`: 0 = this week (Sunday), -1 = last
-- week (Monday-Friday), nil on Saturday while the Cook-Off is still running.
function CookOff.finalWeekOffset(weekday: number): number?
	local mode = CookOff.boardMode(weekday)
	if mode == "live" then
		return nil
	end
	return mode == "results" and 0 or -1
end

-- Day number of the next Cook-Off Saturday (today if it's Saturday). Day 0 was a Thursday.
function CookOff.nextSaturday(day: number): number
	local wd = ((day + 4) % 7) + 1 -- 1 = Sunday ... 7 = Saturday
	return day + ((7 - wd) % 7)
end

export type Placing = { userId: number, score: number, place: number }

-- Places from sorted board entries ({ key = "userId", value = score }, highest first). Ties share
-- a place (100, 100, 97 -> 1st, 1st, 3rd), so nobody loses a medal to a coin-flip sort order.
function CookOff.placings(entries: { any }): { Placing }
	local out: { Placing } = {}
	local lastScore, lastPlace = nil, 0
	for i, e in ipairs(entries) do
		local uid = tonumber(e.key)
		local score = tonumber(e.value)
		if uid and score then
			local place = (score == lastScore) and lastPlace or i
			table.insert(out, { userId = uid, score = score, place = place })
			lastScore, lastPlace = score, place
		end
	end
	return out
end

-- The place `userId` earned if it's a podium finish (1-3, ties included), else nil.
function CookOff.podiumPlace(placings: { Placing }, userId: number): number?
	for _, p in ipairs(placings) do
		if p.userId == userId and p.place <= 3 then
			return p.place
		end
	end
	return nil
end

local MEDALS = { "🥇", "🥈", "🥉" }
function CookOff.medal(place: number): string
	return MEDALS[place] or (tostring(place) .. ".")
end

-- Board names stay short enough to read from the spawn point.
function CookOff.shortName(name: string, max: number): string
	if utf8.len(name) and (utf8.len(name) :: number) > max then
		local cut = utf8.offset(name, max) :: number
		return string.sub(name, 1, cut - 1) .. "…"
	end
	return name
end

-- The hub board's text. `L` holds the copy (Content.CookOffBoard), `nameOf(userId)` a name and
-- `nextLabel` the next Saturday ("Sat, Nov 21"); dates only, never a countdown.
function CookOff.boardText(mode: string, season: string, placings: { Placing }, nameOf: (number) -> string, nextLabel: string, L: { [string]: any }): string
	local limit = mode == "live" and L.liveRows or L.finalRows
	local lines = { season, mode == "live" and L.liveHead or (mode == "results" and L.resultsHead or L.lastHead), "" }
	for i, p in ipairs(placings) do
		if i > limit then
			break
		end
		table.insert(lines, string.format("%s %s  %d", CookOff.medal(p.place), CookOff.shortName(nameOf(p.userId), L.nameMax), p.score))
	end
	if #placings == 0 then
		table.insert(lines, mode == "live" and L.liveEmpty or L.finalEmpty)
	end
	if mode ~= "live" then
		table.insert(lines, "")
		table.insert(lines, string.format(L.next, nextLabel))
		table.insert(lines, L.practice)
	end
	return table.concat(lines, "\n")
end

return CookOff
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Crew</string>
            <string name="Source"><![CDATA[--!strict
-- Hired critters: slots, levels, merges, and coins per second.
-- Prices and rates come from Config. A trait multiplies both, and you see it before you pay.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")
local Economy = if script ~= nil and script.Parent ~= nil then require(script.Parent.Economy) else require("./Economy")

local Crew = {}

export type Member = {
	uid: number,
	species: string,
	name: string,
	level: number,
	trait: string,
	badge: string?,
	role: string,
}

export type Mults = {
	rank: number?,
	friends: number?,
	tipPass: boolean?,
	index: number?,
	cheers: { [number]: boolean }?,
	income: boolean?,
}

local function finite(n: any): number?
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
		return nil
	end
	return n
end

local function rules(): any
	return Config.Hiring
end

function Crew.byId(speciesId: string, list: { any }?): any?
	local rows = list or Config.CrewSpecies
	for _, row in ipairs(rows) do
		if row.id == speciesId then
			return row
		end
	end
	return nil
end

function Crew.traitDef(traitId: string?): any
	local id = if type(traitId) == "string" and traitId ~= "" then traitId else "none"
	for _, row in ipairs(Config.CrewTraits) do
		if row.id == id then
			return row
		end
	end
	return Config.CrewTraits[1]
end

function Crew.rarityDef(rarityId: string): any?
	for _, row in ipairs(Config.CrewRarities) do
		if row.id == rarityId then
			return row
		end
	end
	return nil
end

-- Tier 1 starts at 3. Each tier adds 2. Old smoker and grill purchases add at most one slot each.
-- The Bunkhouse pass adds 4 more. The cap is tier 8 plus those.
function Crew.slotCount(tier: any, extra: any, bunkhouse: boolean?): number
	local hiring = rules()
	local t = math.clamp(math.floor(finite(tier) or 1), 1, #Config.RanchTiers)
	local e = math.clamp(math.floor(finite(extra) or 0), 0, 2)
	local b = if bunkhouse == true then hiring.bunkhouseSlots else 0
	local n = hiring.startSlots + (t - 1) * hiring.slotsPerTier + e + b
	return math.min(hiring.maxSlots, n)
end

function Crew.levelMult(level: any): number
	local hiring = rules()
	local lv = math.clamp(math.floor(finite(level) or 1), 1, hiring.maxLevel)
	return 1 + hiring.levelBonus * (lv - 1)
end

-- Rounded average of the old speed / carry / quality levels, capped at 10.
function Crew.founderLevel(speed: any, carry: any, quality: any): number
	local a = finite(speed) or 1
	local b = finite(carry) or 1
	local c = finite(quality) or 1
	local avg = (a + b + c) / 3
	return math.clamp(math.floor(avg + 0.5), 1, rules().maxLevel)
end

function Crew.tipMult(tipPass: boolean?): number
	if not tipPass then
		return 1
	end
	local asked = Config.FairPlay.passTipMult
	local cap = Config.FairPlay.passTipCap
	return math.min(asked, cap)
end

function Crew.friendMult(friends: any): number
	local n = finite(friends) or 0
	return Economy.crewMult(n, Config.Crew.perFriend, Config.Crew.maxFriends)
end

function Crew.rankMult(rank: any): number
	return Economy.rankMult(finite(rank) or 1, Config.RANK_STEP)
end

-- Coins per second for one critter. `board` skips rank, friends and the tip pass so the
-- Hiring Line shows the same number to everybody.
function Crew.rate(baseRate: number, level: any, traitId: string?, mults: Mults?, board: boolean?): number
	local trait = Crew.traitDef(traitId)
	local per = baseRate * Crew.levelMult(level) * trait.mult
	if board then
		return per
	end
	local m = mults or {}
	per *= Crew.rankMult(m.rank)
	per *= Crew.friendMult(m.friends)
	per *= Crew.tipMult(m.tipPass)
	per *= if type(m.index) == "number" and m.index > 0 then m.index else 1
	return per
end

function Crew.memberRate(member: any, mults: Mults?): number
	local species = Crew.byId(member.species)
	if not species then
		return 0
	end
	local per = Crew.rate(species.baseRate, member.level, member.trait, mults, false)
	local cheers = mults and mults.cheers
	if cheers and cheers[member.uid] then
		per *= Config.Partners.cheerMult
	end
	if mults and mults.income == true then
		per *= Config.CrewBoost.mult
	end
	return per
end

-- The first `slots` owned critters are the ones on station. The rest wait for a ranch tier.
function Crew.working(owned: { any }, slots: number): { any }
	local out = {}
	local n = math.max(0, math.floor(slots))
	for i, member in ipairs(owned) do
		if i > n then
			break
		end
		table.insert(out, member)
	end
	return out
end

function Crew.totalRate(owned: { any }, slots: number, mults: Mults?): number
	local sum = 0
	for _, member in ipairs(Crew.working(owned, slots)) do
		sum += Crew.memberRate(member, mults)
	end
	return sum
end

-- One second of pay. The leftover fraction carries so 1.5/s pays 1, then 2, then 1.
function Crew.tickPay(rate: number, bank: number): (number, number)
	if type(rate) ~= "number" or rate ~= rate or rate <= 0 or rate == math.huge then
		return 0, if type(bank) == "number" and bank == bank then bank else 0
	end
	local held = if type(bank) == "number" and bank == bank and bank > 0 and bank < 1 then bank else 0
	local sum = held + rate
	local coins = math.floor(sum + 1e-9)
	local left = sum - coins
	if left < 1e-9 or left ~= left then
		left = 0
	end
	return coins, left
end

function Crew.levelCost(price: number, level: any): number?
	local hiring = rules()
	local lv = math.floor(finite(level) or 1)
	if lv < 1 or lv >= hiring.maxLevel or price <= 0 then
		return nil
	end
	return math.max(1, math.floor(price * 0.35 * lv))
end

function Crew.greeterCount(owned: { any }, slots: number): number
	local n = 0
	for _, member in ipairs(Crew.working(owned, slots)) do
		if member.role == "greeter" then
			n += 1
		end
	end
	return n
end

-- Each working greeter shortens the wait for the next guest a little. It never goes under 60%.
function Crew.greeterDelay(greeters: number): number
	local n = math.max(0, math.floor(finite(greeters) or 0))
	return math.max(0.6, 1 - 0.08 * n)
end

local function takeCoins(coins: any, cost: number): number?
	local have = finite(coins)
	if not have or cost <= 0 or have < cost then
		return nil
	end
	local left = have - cost
	if left ~= left or left < 0 then
		return nil
	end
	return left
end

function Crew.ensure(data: any): any
	if type(data.crew) ~= "table" then
		data.crew = { owned = {}, slots = 3, nextUid = 1, extra = 0 }
	end
	local crew = data.crew
	if type(crew.owned) ~= "table" then
		crew.owned = {}
	end
	if type(crew.nextUid) ~= "number" or crew.nextUid < 1 then
		crew.nextUid = 1
	end
	if type(crew.extra) ~= "number" then
		crew.extra = 0
	end
	if type(data.ranch) ~= "table" then
		data.ranch = { tier = 1 }
	end
	if type(data.ranch.tier) ~= "number" then
		data.ranch.tier = 1
	end
	crew.slots = Crew.slotCount(data.ranch.tier, crew.extra, crew.bunkhouse == true)
	if type(data.offline) ~= "table" then
		data.offline = { lastTick = 0 }
	end
	return crew
end

function Crew.findSpecies(owned: { any }, speciesId: string): Member?
	for _, member in ipairs(owned) do
		if member.species == speciesId and (member.level or 1) < rules().maxLevel then
			return member
		end
	end
	return nil
end

function Crew.findUid(owned: { any }, uid: number): Member?
	for _, member in ipairs(owned) do
		if member.uid == uid then
			return member
		end
	end
	return nil
end

export type HireOutcome = {
	ok: boolean,
	reason: string,
	cost: number?,
	coins: number,
	mergeUid: number?,
	member: Member?,
}

function Crew.hireMessage(reason: string, cost: number?): string
	if reason == "coins" and cost then
		return string.format("You need %d coins.", cost)
	elseif reason == "slots" then
		return "The ranch is full. A ranch tier adds crew slots."
	elseif reason == "bad" then
		return "That critter isn't on the line."
	end
	return "You can't hire right now."
end

-- Does not mutate the save. The caller writes coins and the roster after this returns ok.
function Crew.tryHire(data: any, applicant: any): HireOutcome
	local crew = Crew.ensure(data)
	local balance = if finite(data.coins) then data.coins else 0
	if type(applicant) ~= "table" or type(applicant.species) ~= "string" then
		return { ok = false, reason = "bad", coins = balance }
	end
	local species = Crew.byId(applicant.species)
	if not species then
		return { ok = false, reason = "bad", coins = balance }
	end
	local trait = Crew.traitDef(applicant.trait)
	local cost = math.max(1, math.floor((species.price * trait.mult) + 0.5))
	if type(applicant.price) == "number" and applicant.price > 0 then
		cost = math.floor(applicant.price)
	end
	local left = takeCoins(data.coins, cost)
	if not left then
		return { ok = false, reason = "coins", cost = cost, coins = balance }
	end
	local merge = Crew.findSpecies(crew.owned, species.id)
	if merge then
		return { ok = true, reason = "ok", cost = cost, coins = left, mergeUid = merge.uid }
	end
	if #crew.owned >= crew.slots then
		return { ok = false, reason = "slots", cost = cost, coins = balance }
	end
	local member: Member = {
		uid = crew.nextUid,
		species = species.id,
		name = species.name,
		level = 1,
		trait = trait.id,
		badge = nil,
		role = species.role,
	}
	return { ok = true, reason = "ok", cost = cost, coins = left, member = member }
end

function Crew.applyHire(data: any, outcome: HireOutcome): Member?
	if not outcome.ok then
		return nil
	end
	local crew = Crew.ensure(data)
	data.coins = outcome.coins
	if outcome.mergeUid then
		local member = Crew.findUid(crew.owned, outcome.mergeUid)
		if member then
			member.level = math.min(rules().maxLevel, (member.level or 1) + 1)
			return member
		end
	end
	local member = outcome.member
	if not member then
		return nil
	end
	table.insert(crew.owned, member)
	crew.nextUid = member.uid + 1
	return member
end

export type LevelOutcome = {
	ok: boolean,
	reason: string,
	cost: number?,
	coins: number,
	uid: number?,
	level: number?,
}

function Crew.tryLevel(data: any, uid: any): LevelOutcome
	local crew = Crew.ensure(data)
	local balance = if finite(data.coins) then data.coins else 0
	local id = finite(uid)
	if not id then
		return { ok = false, reason = "bad", coins = balance }
	end
	local member = Crew.findUid(crew.owned, id)
	if not member then
		return { ok = false, reason = "missing", coins = balance }
	end
	local species = Crew.byId(member.species)
	if not species then
		return { ok = false, reason = "bad", coins = balance }
	end
	local cost = Crew.levelCost(species.price, member.level)
	if not cost then
		return { ok = false, reason = "max", coins = balance }
	end
	local left = takeCoins(data.coins, cost)
	if not left then
		return { ok = false, reason = "coins", cost = cost, coins = balance }
	end
	return { ok = true, reason = "ok", cost = cost, coins = left, uid = member.uid, level = member.level + 1 }
end

function Crew.levelMessage(reason: string, cost: number?): string
	if reason == "coins" and cost then
		return string.format("You need %d coins.", cost)
	elseif reason == "max" then
		return "That's as high as it goes."
	elseif reason == "missing" then
		return "That critter isn't on the ranch."
	end
	return "You can't level them right now."
end

function Crew.applyLevel(data: any, outcome: LevelOutcome): boolean
	if not outcome.ok or not outcome.uid or not outcome.level then
		return false
	end
	local member = Crew.findUid(data.crew.owned, outcome.uid)
	if not member or member.level ~= outcome.level - 1 then
		return false
	end
	data.coins = outcome.coins
	member.level = outcome.level
	return true
end

function Crew.nextTier(tier: number): any?
	for _, row in ipairs(Config.RanchTiers) do
		if row.tier == tier + 1 then
			return row
		end
	end
	return nil
end

export type TierOutcome = {
	ok: boolean,
	reason: string,
	cost: number?,
	coins: number,
	tier: number?,
	name: string?,
}

function Crew.tryTier(data: any, price: number?): TierOutcome
	Crew.ensure(data)
	local balance = if finite(data.coins) then data.coins else 0
	local nxt = Crew.nextTier(math.floor(data.ranch.tier))
	if not nxt or not nxt.cost or nxt.cost <= 0 then
		return { ok = false, reason = "max", coins = balance }
	end
	local cost = if type(price) == "number" and price > 0 then price else nxt.cost
	local left = takeCoins(data.coins, cost)
	if not left then
		return { ok = false, reason = "coins", cost = cost, coins = balance }
	end
	return { ok = true, reason = "ok", cost = cost, coins = left, tier = nxt.tier, name = nxt.name }
end

function Crew.tierMessage(reason: string, cost: number?): string
	if reason == "coins" and cost then
		return string.format("You need %d coins.", cost)
	elseif reason == "max" then
		return "The ranch is built out."
	end
	return "You can't build that right now."
end

function Crew.applyTier(data: any, outcome: TierOutcome): boolean
	if not outcome.ok or not outcome.tier then
		return false
	end
	local crew = Crew.ensure(data)
	if data.ranch.tier ~= outcome.tier - 1 then
		return false
	end
	data.coins = outcome.coins
	data.ranch.tier = outcome.tier
	crew.slots = Crew.slotCount(data.ranch.tier, crew.extra, crew.bunkhouse == true)
	return true
end

-- What a working critter does on the ranch. Pit and grill hands cook. Servers carry plates.
function Crew.job(role: string): string
	if role == "pit" then
		return "smoke"
	elseif role == "grill" then
		return "grill"
	elseif role == "server" then
		return "serve"
	end
	return "greet"
end

-- A brand-new ranch with nobody hired yet. Veterans (onboarding finished, or they already
-- cooked and served) do not get a second free Pip.
function Crew.needsStarter(data: any): boolean
	local crew = Crew.ensure(data)
	if crew.starterGranted == true or #crew.owned > 0 then
		return false
	end
	if type(data.onboard) == "table" and data.onboard.done == true then
		return false
	end
	if type(data.tutorial) == "table" and data.tutorial.done == true then
		return false
	end
	if type(data.guide) == "table" and (data.guide.done == true or data.guide.skipped == true) then
		return false
	end
	local served = data.stats and data.stats.served or 0
	if type(served) == "number" and served > 0 then
		return false
	end
	local played = data.playSeconds or 0
	if type(played) == "number" and played > 90 then
		return false
	end
	return true
end

-- Free Pip. Does not spend coins and does not take a Hiring Line applicant.
function Crew.grantStarter(data: any): Member?
	if not Crew.needsStarter(data) then
		return nil
	end
	local species = Crew.byId("armadillo")
	if not species then
		return nil
	end
	local crew = data.crew
	local member: Member = {
		uid = crew.nextUid,
		species = species.id,
		name = "Pip",
		level = 1,
		trait = "none",
		badge = nil,
		role = species.role,
	}
	table.insert(crew.owned, member)
	crew.nextUid = member.uid + 1
	crew.starterGranted = true
	return member
end

function Crew.view(data: any, mults: Mults?): any
	local crew = Crew.ensure(data)
	local owned = {}
	for _, member in ipairs(crew.owned) do
		local species = Crew.byId(member.species)
		local rarity = species and Crew.rarityDef(species.rarity) or nil
		local trait = Crew.traitDef(member.trait)
		table.insert(owned, {
			uid = member.uid,
			species = member.species,
			name = member.name,
			level = member.level,
			trait = trait.id,
			traitName = trait.name,
			badge = member.badge,
			role = member.role,
			roleName = (Config.CrewRoles[member.role] and Config.CrewRoles[member.role].name) or member.role,
			rarity = species and species.rarity or "common",
			rarityName = rarity and rarity.name or "Common",
			color = rarity and rarity.color or "#E7E2DA",
			line = species and species.line or "",
			earn = Crew.memberRate(member, mults),
			levelCost = species and Crew.levelCost(species.price, member.level) or nil,
		})
	end
	local nxt = Crew.nextTier(math.floor(data.ranch.tier))
	local tierRow = Config.RanchTiers[math.clamp(math.floor(data.ranch.tier), 1, #Config.RanchTiers)]
	return {
		owned = owned,
		slots = crew.slots,
		extra = crew.extra,
		used = math.min(#crew.owned, crew.slots),
		tier = data.ranch.tier,
		tierName = tierRow and tierRow.name or "Open yard",
		nextCost = nxt and nxt.cost or nil,
		nextName = nxt and nxt.name or nil,
		nextBlurb = nxt and nxt.blurb or nil,
		rate = Crew.totalRate(crew.owned, crew.slots, mults),
	}
end

return Crew
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">CrewMotion</string>
            <string name="Source"><![CDATA[--!strict
-- Shared walk math. The server and every client use the same clock and the same points,
-- so a hire can leave from the pose players already see.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")

local CrewMotion = {}

export type Vec = { number }

local function v(x: number, y: number, z: number): Vec
	return { x, y, z }
end

function CrewMotion.decode(text: any): { Vec }
	local points = {}
	if type(text) ~= "string" then
		return points
	end
	for chunk in string.gmatch(text, "[^|]+") do
		local xs, ys, zs = string.match(chunk, "([^,]+),([^,]+),([^,]+)")
		local x, y, z = tonumber(xs), tonumber(ys), tonumber(zs)
		if x and y and z then
			table.insert(points, v(x, y, z))
		end
	end
	return points
end

function CrewMotion.encode(points: { Vec }): string
	local bits = {}
	for _, p in ipairs(points) do
		table.insert(bits, string.format("%.2f,%.2f,%.2f", p[1], p[2], p[3]))
	end
	return table.concat(bits, "|")
end

function CrewMotion.length(points: { Vec }): number
	local total = 0
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		total += math.sqrt(dx * dx + dy * dy + dz * dz)
	end
	return total
end

local function along(points: { Vec }, distance: number): (Vec, Vec)
	local remain = distance
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local span = math.sqrt(dx * dx + dy * dy + dz * dz)
		if remain <= span or i == #points - 1 then
			local alpha = if span > 0.05 then math.clamp(remain / span, 0, 1) else 0
			return v(a[1] + dx * alpha, a[2] + dy * alpha, a[3] + dz * alpha), v(dx, dy, dz)
		end
		remain -= span
	end
	local last = points[#points]
	return v(last[1], last[2], last[3]), v(0, 0, -1)
end

-- Where the client is drawing this critter at `now` (server time), bob included.
function CrewMotion.pose(points: { Vec }, now: number, speed: number, phase: number, kind: string, startAt: number?): (number, number, number)
	if #points < 2 then
		local p = points[1] or v(0, 0, 0)
		return p[1], p[2], p[3]
	end
	local pace = if speed > 0 then speed else 4
	local span = math.max(CrewMotion.length(points), 0.05)
	local distance
	if kind == "once" then
		local began = startAt or now
		distance = math.clamp((now - began) * pace, 0, span)
	else
		distance = (now * pace + phase * 1.7) % span
	end
	local pos = along(points, distance)
	local bob = math.abs(math.sin(now * 8 + phase)) * 0.22
	return pos[1], pos[2] + bob, pos[3]
end

-- full, cheap (a few times a second, no bob), or freeze.
function CrewMotion.detail(distance: number, near: number?, far: number?): string
	local close = near or Config.CrewLod.near
	local away = far or Config.CrewLod.far
	if distance >= away then
		return "freeze"
	elseif distance >= close then
		return "cheap"
	end
	return "full"
end

local function flatDist(ax: number, az: number, bx: number, bz: number): number
	local dx, dz = bx - ax, bz - az
	return math.sqrt(dx * dx + dz * dz)
end

-- From the line to a ranch: skirt the middle of the square (Big Bertha sits there),
-- then follow the road out, then the gate. Speed stays a walk.
function CrewMotion.homePath(fromX: number, fromY: number, fromZ: number, plotX: number, plotZ: number, greetX: number, greetZ: number): { Vec }
	local dx, dz = plotX, plotZ
	local mag = math.sqrt(dx * dx + dz * dz)
	if mag < 1 then
		dx, dz, mag = 0, -1, 1
	end
	local ux, uz = dx / mag, dz / mag
	-- Perpendicular, picked so the skirt stays off the smoker in the middle.
	local sx, sz = -uz, ux
	if sx * fromX + sz * fromZ < 0 then
		sx, sz = -sx, -sz
	end
	local skirt = v(sx * 36, fromY, sz * 36 - 8)
	local road = v(ux * 78, fromY, uz * 78)
	local gate = v(greetX, fromY, greetZ)
	local start = v(fromX, fromY, fromZ)
	-- Drop a point that would sit on top of the previous one.
	local path = { start }
	for _, p in ipairs({ skirt, road, gate }) do
		local prev = path[#path]
		if flatDist(prev[1], prev[3], p[1], p[3]) > 6 then
			table.insert(path, p)
		end
	end
	if #path < 2 then
		table.insert(path, gate)
	end
	return path
end

function CrewMotion.walkSeconds(points: { Vec }, speed: number?): number
	local pace = if speed and speed > 0 then speed else Config.Hiring.walkSpeed
	return CrewMotion.length(points) / pace
end

return CrewMotion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">CuteFace</string>
            <string name="Source"><![CDATA[--!strict
-- Original faces for the grill burger and the tomahawk steak.
-- Every offset is in the meat part's local space (Y up, -Z toward the yard path).
-- Features sit on the top surface and stay small, so the patty or steak color
-- (raw pink through cooked brown, or black when burnt) stays the doneness cue.
local CuteFace = {}

CuteFace.MAX_PARTS = 12

export type Spec = {
	name: string,
	size: { number },
	offset: { number },
	color: string,
	shape: string, -- "ball" | "block"
	material: string, -- "smooth" | "neon"
}

local KINDS: { [string]: string } = {
	burger = "patty",
	tomahawk = "steak",
}

function CuteFace.kind(meatId: string): string?
	return KINDS[meatId]
end

local function spec(list: { Spec }, name: string, sx: number, sy: number, sz: number, x: number, y: number, z: number, color: string, shape: string, material: string?)
	table.insert(list, {
		name = name,
		size = { sx, sy, sz },
		offset = { x, y, z },
		color = color,
		shape = shape,
		material = material or "smooth",
	})
end

local function eyeSize(span: number): number
	return math.clamp(span * 0.26, span * 0.2, 0.42)
end

-- Happy patty: matching sparkly eyes, rosy cheeks, a three-part smile.
-- Burnt patty: closed eyes, ashy cheeks, a frown. No sparkle.
local function patty(size: { number }, burnt: boolean): { Spec }
	local out: { Spec } = {}
	local span = math.min(size[1], size[3])
	local eye = eyeSize(span)
	local top = size[2] / 2
	local ex = math.min(size[1] * 0.2, size[1] / 2 - eye / 2 - span * 0.04)
	local ez = -size[3] * 0.02
	local eyeY = top + eye * 0.34
	local white = if burnt then "#D9D3CC" else "#FFF8F0"
	local pupil = if burnt then "#F2EBE3" else "#2A140C"
	local cheek = if burnt then "#A89890" else "#F4A0B0"
	for _, side in ipairs({ -1, 1 }) do
		local x = side * ex
		if burnt then
			spec(out, side < 0 and "EyeL" or "EyeR", eye * 0.92, eye * 0.22, eye * 0.28, x, top + eye * 0.12, ez, pupil, "block")
		else
			spec(out, side < 0 and "EyeL" or "EyeR", eye, eye * 0.92, eye * 0.72, x, eyeY, ez, white, "ball")
			spec(out, side < 0 and "PupilL" or "PupilR", eye * 0.4, eye * 0.46, eye * 0.28, x, eyeY + eye * 0.04, ez - eye * 0.22, pupil, "ball")
			spec(out, side < 0 and "ShineL" or "ShineR", eye * 0.2, eye * 0.2, eye * 0.12, x - side * eye * 0.12, eyeY + eye * 0.16, ez - eye * 0.26, "#FFFFFF", "ball", "neon")
		end
		spec(out, side < 0 and "CheekL" or "CheekR", eye * 0.42, eye * 0.2, eye * 0.32, side * (ex + eye * 0.42), top + eye * 0.08, ez - eye * 0.28, cheek, "ball")
	end
	local mouth = if burnt then "#E4DCD4" else "#5C2E2A"
	local mz = ez - eye * 0.95
	if burnt then
		spec(out, "FrownCenter", eye * 0.7, eye * 0.16, eye * 0.16, 0, top + eye * 0.2, mz, mouth, "block")
		spec(out, "FrownL", eye * 0.22, eye * 0.16, eye * 0.14, -eye * 0.42, top + eye * 0.08, mz + eye * 0.12, mouth, "ball")
		spec(out, "FrownR", eye * 0.22, eye * 0.16, eye * 0.14, eye * 0.42, top + eye * 0.08, mz + eye * 0.12, mouth, "ball")
	else
		spec(out, "SmileCenter", eye * 0.62, eye * 0.2, eye * 0.2, 0, top + eye * 0.08, mz, mouth, "ball")
		spec(out, "SmileL", eye * 0.24, eye * 0.18, eye * 0.16, -eye * 0.46, top + eye * 0.16, mz + eye * 0.16, mouth, "ball")
		spec(out, "SmileR", eye * 0.24, eye * 0.18, eye * 0.16, eye * 0.46, top + eye * 0.16, mz + eye * 0.16, mouth, "ball")
	end
	return out
end

-- Steak: one wide sparkly eye, one happy squint, a little "o" mouth, rosy cheeks,
-- and a pale bone nub on the far end so it reads as a tomahawk without covering the face.
local function steak(size: { number }, burnt: boolean): { Spec }
	local out: { Spec } = {}
	local span = math.min(size[1], size[3])
	-- The steak is a wide slab, so the eyes are a little bigger than the patty's
	-- or they disappear into the meat at grill distance.
	local eye = math.clamp(span * 0.36, span * 0.28, 0.55)
	local top = size[2] / 2
	local faceX = -size[1] * 0.06
	local ez = -size[3] * 0.04
	local white = if burnt then "#D9D3CC" else "#FFF8F0"
	local pupil = if burnt then "#F2EBE3" else "#2A140C"
	local cheek = if burnt then "#A89890" else "#F4A0B0"
	local lx = faceX - eye * 0.7
	local rx = faceX + eye * 0.72
	local eyeY = top + eye * 0.32
	if burnt then
		spec(out, "EyeL", eye * 0.9, eye * 0.2, eye * 0.26, lx, top + eye * 0.1, ez, pupil, "block")
		spec(out, "EyeR", eye * 0.7, eye * 0.18, eye * 0.22, rx, top + eye * 0.1, ez, pupil, "block")
	else
		spec(out, "EyeL", eye, eye * 0.9, eye * 0.7, lx, eyeY, ez, white, "ball")
		spec(out, "PupilL", eye * 0.38, eye * 0.44, eye * 0.26, lx, eyeY + eye * 0.02, ez - eye * 0.2, pupil, "ball")
		spec(out, "ShineL", eye * 0.18, eye * 0.18, eye * 0.1, lx - eye * 0.12, eyeY + eye * 0.16, ez - eye * 0.24, "#FFFFFF", "ball", "neon")
		-- squint: short and wide, still a smile in the eye, not a scowl
		spec(out, "Wink", eye * 0.78, eye * 0.28, eye * 0.32, rx, top + eye * 0.2, ez, white, "ball")
		spec(out, "WinkPupil", eye * 0.16, eye * 0.12, eye * 0.1, rx, top + eye * 0.22, ez - eye * 0.12, pupil, "ball")
	end
	spec(out, "CheekL", eye * 0.36, eye * 0.16, eye * 0.26, lx - eye * 0.55, top + eye * 0.06, ez - eye * 0.2, cheek, "ball")
	spec(out, "CheekR", eye * 0.32, eye * 0.14, eye * 0.22, rx + eye * 0.48, top + eye * 0.06, ez - eye * 0.16, cheek, "ball")
	local mouth = if burnt then "#E4DCD4" else "#5C2E2A"
	local mz = ez - eye * 0.85
	if burnt then
		spec(out, "FrownCenter", eye * 0.5, eye * 0.14, eye * 0.14, faceX, top + eye * 0.16, mz, mouth, "block")
	else
		spec(out, "Delight", eye * 0.28, eye * 0.26, eye * 0.22, faceX, top + eye * 0.1, mz, mouth, "ball")
	end
	local boneColor = if burnt then "#8A8078" else "#F3E6D0"
	spec(out, "Bone", size[1] * 0.16, size[2] * 0.7, size[3] * 0.22, size[1] * 0.34, 0, size[3] * 0.08, boneColor, "block")
	return out
end

function CuteFace.specs(meatId: string, size: { number }, burnt: boolean?): { Spec }
	local kind = KINDS[meatId]
	if not kind or type(size) ~= "table" then
		return {}
	end
	local sx = size[1]
	local sy = size[2]
	local sz = size[3]
	if type(sx) ~= "number" or type(sy) ~= "number" or type(sz) ~= "number" then
		return {}
	end
	if sx <= 0 or sy <= 0 or sz <= 0 then
		return {}
	end
	if kind == "patty" then
		return patty({ sx, sy, sz }, burnt == true)
	end
	return steak({ sx, sy, sz }, burnt == true)
end

-- Share of the top face covered by features that sit on it. The bone is excluded;
-- it lives on the end, not on the browning surface.
function CuteFace.topCoverage(specs: { Spec }, size: { number }): number
	local area = 0
	local top = size[2] / 2
	for _, s in ipairs(specs) do
		if s.name ~= "Bone" and s.offset[2] >= top - 0.02 then
			area += s.size[1] * s.size[3]
		end
	end
	return area / (size[1] * size[3])
end

return CuteFace
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Economy math: plate values, upgrade costs, rebirth (Unc Status) rules. Pure functions.
local Economy = {}

function Economy.rankMult(rank: number, step: number): number
	return 1 + step * (math.max(1, rank) - 1)
end

function Economy.crewMult(friends: number, perFriend: number, maxFriends: number): number
	return 1 + perFriend * math.clamp(friends, 0, maxFriends)
end

export type ValueOpts = {
	rarityMult: number,
	rankMult: number?,
	crewMult: number?,
	tipMult: number?, -- critter tip
	sauceTip: number?, -- e.g. 0.25 for +25%
	flipMult: number?,
	comboMult: number?,
	doubleTips: boolean?,
	passTipMult: number?, -- Fair Play: the tip pass multiplier (default 1.5)
	orderBonus: number?,
}

function Economy.plateValue(price: number, o: ValueOpts): number
	local v = price
		* o.rarityMult
		* (o.rankMult or 1)
		* (o.crewMult or 1)
		* (o.tipMult or 1)
		* (1 + (o.sauceTip or 0))
		* (o.flipMult or 1)
		* (o.comboMult or 1)
		* (o.orderBonus or 1)
		* (o.doubleTips and (o.passTipMult or 1.5) or 1)
	return math.max(1, math.floor(v + 0.5))
end

-- Cost to reach pit level `level + 1`, or nil if maxed.
function Economy.nextPitCost(pitLevels: { any }, level: number): number?
	local nextDef = pitLevels[level + 1]
	return nextDef and nextDef.cost or nil
end

-- Slot purchases: `owned` = slots bought with coins so far (not counting base/pass).
function Economy.nextSlotCost(costs: { number }, owned: number): number?
	return costs[owned + 1]
end

function Economy.totalSlots(base: number, bought: number, passBonus: number, hasPass: boolean, cap: number): number
	return math.min(cap, base + bought + (hasPass and passBonus or 0))
end

function Economy.canRebirth(ranks: { any }, rank: number, runCoins: number): (boolean, number?)
	local nextRank = ranks[rank + 1]
	if not nextRank then
		return false, nil
	end
	return runCoins >= nextRank.need, nextRank.need
end

-- Burgers can still be flipped for a bonus. When the flip is not required, an unflipped
-- burger pays full price. A perfect, good, or missed flip still uses its own multiplier.
function Economy.flipFactor(flip: string?, required: boolean, perfect: number, good: number, miss: number, unflipped: number): number
	if flip == "perfect" then
		return perfect
	elseif flip == "good" then
		return good
	elseif flip == "miss" then
		return miss
	elseif not required then
		return 1
	end
	return unflipped
end

function Economy.rawCost(meat: any, rankMult: number): number
	-- Raw meat gets a bit pricier as you rank up so rebirths stay meaningful but not grindy.
	return math.floor(meat.cost * (1 + (rankMult - 1) * 0.5) + 0.5)
end

export type CookAccess = { pass: boolean, tokens: number, unlocked: boolean }
export type CookBill = { allowed: boolean, coins: number, usesToken: boolean }

-- A Premium Cuts pass, or spending a Wagyu/Tomahawk token, is a paid cook.
-- The earned Tomahawk unlock does not spend a token, so it is not a paid path.
function Economy.paidCut(meat: any, access: CookAccess, usesToken: boolean): boolean
	return meat.premium == true and (access.pass == true or usesToken == true)
end

-- Paid cooks are Smoke Ring Gold. Anything else keeps the rarity already rolled.
function Economy.cookRarity(meat: any, access: CookAccess, usesToken: boolean, rolled: string): string
	if Economy.paidCut(meat, access, usesToken) then
		return "smokering"
	end
	return rolled
end

-- Premium cuts always have a coin cost. The pass (or a token, or the Tomahawk
-- path unlock) is access, not a free cook. A token is spent only when that is
-- the thing granting access.
function Economy.cookBill(meat: any, rank: number, rankStep: number, access: CookAccess): CookBill
	local coins = Economy.rawCost(meat, Economy.rankMult(rank, rankStep))
	if meat.premium then
		local pass = access.pass == true
		local unlocked = access.unlocked == true
		local tokens = math.max(0, math.floor(access.tokens or 0))
		local allowed = pass or unlocked or tokens > 0
		return {
			allowed = allowed,
			coins = coins,
			usesToken = allowed and not pass and not unlocked,
		}
	end
	return { allowed = true, coins = coins, usesToken = false }
end

function Economy.comboMult(combo: number, step: number, maxCombo: number): number
	local n = math.clamp(math.floor(combo or 0), 0, maxCombo)
	return 1 + n * step
end

-- Rough coins-per-minute for a steady loop (used by balance tests and the README table).
function Economy.coinsPerMinute(meat: any, slots: number, speed: number, avgRarityMult: number, rankMult: number): number
	local cycleMinutes = (meat.cookTime / speed) / 60
	local profit = meat.price * avgRarityMult * rankMult - Economy.rawCost(meat, rankMult)
	return profit * slots / cycleMinutes
end

function Economy.averageRarityMult(rarities: { any }, luck: number, maxIndex: number?): number
	local total, acc = 0, 0
	for i, r in ipairs(rarities) do
		if maxIndex == nil or i <= maxIndex then
			local w = i == 1 and r.weight or r.weight * luck
			total += w
			acc += w * r.mult
		end
	end
	return acc / total
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">FreeGift</string>
            <string name="Source"><![CDATA[--!strict
-- A small timed gift while you play. Separate from the daily login streak.
-- The base is tiny on purpose: it is a reason to check back, not a second economy.
local FreeGift = {}

FreeGift.PERIOD = 15 * 60
FreeGift.BASE = 35

export type State = { nextAt: number }

function FreeGift.new(): State
	return { nextAt = 0 }
end

local function finite(n: any): number?
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
		return nil
	end
	return n
end

-- A non-finite or negative stamp is treated as ready (0). A stamp more than one
-- period ahead of `now` is pulled back so a bad clock can't lock the gift away.
-- `now` is the server's os.time(). The client never supplies it.
function FreeGift.normalize(state: any, now: number?): { nextAt: number }
	if type(state) ~= "table" then
		state = { nextAt = 0 }
	end
	local at = finite(state.nextAt)
	if not at or at < 0 then
		state.nextAt = 0
	else
		state.nextAt = at
	end
	local clock = finite(now)
	if clock and state.nextAt > clock + FreeGift.PERIOD then
		state.nextAt = clock + FreeGift.PERIOD
	end
	return state
end

function FreeGift.ready(nextAt: number, now: number): boolean
	local clock = finite(now)
	if not clock then
		return false
	end
	local at = finite(nextAt)
	local stamp = if at ~= nil and at >= 0 then at else 0
	return clock >= stamp
end

function FreeGift.remaining(nextAt: number, now: number): number
	return math.max(0, (nextAt or 0) - now)
end

-- Moves the timer forward. Returns false when it is not time yet.
function FreeGift.claim(state: State, now: number): boolean
	local clock = finite(now)
	if not clock or not FreeGift.ready(state.nextAt, clock) then
		return false
	end
	state.nextAt = clock + FreeGift.PERIOD
	return true
end

function FreeGift.payout(rankMult: number): number
	return math.max(1, math.floor(FreeGift.BASE * math.max(0, rankMult) + 0.5))
end

return FreeGift
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Funnels</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Funnels.luau — step lists for Roblox Analytics funnels (pure, unit-tested).
	The server (InsightsService) logs each onboarding step once per account and the Pit Shop
	steps once per shop visit, so the Creator Dashboard shows where new players drop off and
	which shop tabs lead to purchases. No personal data, nothing shown to players.
]]
local Funnels = {}

-- Onboarding: join -> first brisket -> first plate served -> tutorial done -> each Rookie goal.
function Funnels.onboardingSteps(rookieSteps: { any }): { string }
	local out = { "Joined", "Started first brisket", "Served first plate", "Finished tutorial" }
	for _, r in ipairs(rookieSteps) do
		table.insert(out, "Rookie: " .. r.id)
	end
	return out
end

-- How far along onboarding this save is (1-based index into onboardingSteps).
function Funnels.onboardingReached(data: any, rookieSteps: { any }): number
	local n = 1
	if data.tutorial.firstBrisket then
		n = 2
		if (data.stats.served or 0) >= 1 then
			n = 3
			if data.tutorial.done then
				n = 4
				if not data.rookie.skipped then
					n += math.min(data.rookie.claimed or 0, #rookieSteps)
				end
			end
		end
	end
	return n
end

-- Steps to log now: everything after `logged` up to `reached`.
function Funnels.newSteps(logged: number, reached: number): { number }
	local out = {}
	for i = logged + 1, reached do
		table.insert(out, i)
	end
	return out
end

Funnels.SHOP = { "Opened shop", "Opened a tab", "Tapped buy", "Bought" }

-- Coin flows get added up and sent once a minute instead of on every plate.
export type Bucket = { [string]: { flow: string, tx: string, sku: string, amount: number } }

function Funnels.addCoins(bucket: Bucket, amount: number, tx: string, sku: string)
	if amount == 0 then
		return
	end
	local flow = amount > 0 and "Source" or "Sink"
	local k = flow .. "|" .. tx .. "|" .. sku
	local b = bucket[k]
	if not b then
		b = { flow = flow, tx = tx, sku = sku, amount = 0 }
		bucket[k] = b
	end
	b.amount += math.abs(amount)
end

return Funnels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Gifting</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Gifting.luau — buy a look for someone else in your server.
	Pure logic (no Roblox services) so it can be unit-tested with Lune.

	How it works:
	  1. The giver taps "Gift" on a looks-only shop item and picks a player in the server.
	  2. The server checks it (Gifting.check) and remembers the intent for a short time
	     (Gifting.remember), then prompts the normal developer product.
	  3. When the receipt arrives, Gifting.claim hands back the recipient, once.
	  4. If the recipient left in the meantime, the gift is "held" on the giver's save and can
	     be sent to anyone later for free (Gifting.hold / Gifting.takeHeld). Robux is never lost.

	Rules: only looks (cosmetics and looks bundles) can be gifted. Nothing random, nothing
	that gives an advantage, no pressure copy. Boost time inside a bundle goes to the recipient.
]]
local Gifting = {}

export type Pending = { to: number, key: string, at: number }

-- Can this shop product be gifted? Looks only.
function Gifting.giftable(product: any): boolean
	if type(product) ~= "table" then
		return false
	end
	if product.kind ~= "cosmetic" and product.kind ~= "bundle" then
		return false
	end
	return type(product.grants) == "table" and #product.grants > 0
end

-- Validate a gift request. `recipient` is nil when that player isn't in the server.
function Gifting.check(senderId: number, recipientId: number?, product: any, recipientOwnsAll: boolean): (boolean, string?)
	if not Gifting.giftable(product) then
		return false, "Only looks can be gifted."
	end
	if recipientId == nil then
		return false, "That player isn't in this server anymore."
	end
	if recipientId == senderId then
		return false, "Pick someone else to gift. Buy it from the shop for yourself!"
	end
	if recipientOwnsAll then
		return false, "They already have this one."
	end
	return true, nil
end

-- Remember who the giver meant this purchase for. One pending gift per (giver, item).
function Gifting.remember(pending: { [string]: Pending }, key: string, recipientId: number, now: number)
	pending[key] = { to = recipientId, key = key, at = now }
end

-- Consume the pending gift for this item if it's still fresh. Returns the recipient's UserId.
function Gifting.claim(pending: { [string]: Pending }, key: string, now: number, ttl: number): number?
	local p = pending[key]
	pending[key] = nil
	if not p or now - p.at > ttl then
		return nil
	end
	return p.to
end

-- When a gift receipt arrives: hand it over, or hold it on the giver's save so the Robux isn't
-- wasted ("hold-left": the recipient left; "hold-owned": they got every look in it meanwhile).
function Gifting.landing(recipientPresent: boolean, recipientOwnsAll: boolean): string
	if not recipientPresent then
		return "hold-left"
	end
	if recipientOwnsAll then
		return "hold-owned"
	end
	return "deliver"
end

-- Held gifts live on the giver's save: { [productKey] = count }.
function Gifting.hold(held: { [string]: number }, key: string)
	held[key] = (held[key] or 0) + 1
end

function Gifting.takeHeld(held: { [string]: number }, key: string): boolean
	local n = held[key] or 0
	if n <= 0 then
		return false
	end
	if n == 1 then
		held[key] = nil
	else
		held[key] = n - 1
	end
	return true
end

return Gifting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Goals</string>
            <string name="Source"><![CDATA[--!strict
-- The one next-step the HUD keeps on screen after the Rookie List is done.
local Numbers = if script ~= nil and script.Parent ~= nil then require(script.Parent.Numbers) else require("./Numbers")

local Goals = {}

export type Input = {
	rookieActive: boolean,
	giftReady: boolean,
	coins: number,
	hireCost: number?,
	hireName: string?,
	pitCost: number?,
	pitName: string?,
	crew: number,
	crewSlots: number,
}

export type Goal = {
	id: string,
	title: string,
	detail: string,
	current: number,
	goal: number,
	action: string,
}

function Goals.next(inp: Input): Goal?
	if inp.giftReady then
		return {
			id = "gift",
			title = "Free gift ready",
			detail = "Tap to claim",
			current = 1,
			goal = 1,
			action = "gift",
		}
	end
	if inp.rookieActive then
		return nil
	end
	if inp.hireCost and inp.hireName and inp.hireCost > 0 then
		local cost = inp.hireCost
		return {
			id = "hire",
			title = "Next: hire " .. inp.hireName,
			detail = Numbers.abbrev(math.max(0, inp.coins)) .. " / " .. Numbers.abbrev(cost),
			current = math.clamp(inp.coins, 0, cost),
			goal = cost,
			action = "crew",
		}
	end
	if inp.pitCost and inp.pitName and inp.pitCost > 0 then
		local cost = inp.pitCost
		return {
			id = "pit",
			title = "Next upgrade: " .. inp.pitName,
			detail = Numbers.abbrev(math.max(0, inp.coins)) .. " / " .. Numbers.abbrev(cost),
			current = math.clamp(inp.coins, 0, cost),
			goal = cost,
			action = "upgrades",
		}
	end
	local slots = math.max(1, inp.crewSlots)
	return {
		id = "crew",
		title = "Crew is on the ranch",
		detail = string.format("%d / %d hands working", math.min(inp.crew, slots), slots),
		current = math.min(inp.crew, slots),
		goal = slots,
		action = "crew",
	}
end

return Goals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Guide</string>
            <string name="Source"><![CDATA[--!strict
-- First-visit hints. Shown once, saved on the profile, and skippable.
-- Copy stays on the porch: no shop pressure and no paid randomness.
local Guide = {}

export type State = {
	step: number,
	done: boolean,
	skipped: boolean,
	introduced: boolean,
}

export type Step = {
	id: string,
	target: string,
	title: string,
	body: string,
}

export type Life = {
	served: number?,
	firstBrisket: boolean?,
	tutorialDone: boolean?,
	playSeconds: number?,
	crew: number?,
}

Guide.STEPS = {
	{
		id = "ranch",
		target = "ranch",
		title = "Claim your ranch",
		body = "This yard is yours. Tap the orange button to start your first brisket.",
	},
	{
		id = "serve",
		target = "serve",
		title = "Serve your first critter",
		body = "A hungry critter is waiting. Serve them a plate and they pay you in coins.",
	},
	{
		id = "crew",
		target = "crew",
		title = "Hire Pip",
		body = "Open the Crew tab and hire Pip the raccoon. Pip helps cook burgers. It costs coins you earn in the yard.",
	},
	{
		id = "gift",
		target = "gift",
		title = "Claim your free gift",
		body = "A free gift is ready. Tap Gift to claim it. Another one shows up later, on the house.",
	},
} :: { Step }

function Guide.new(): State
	return { step = 1, done = false, skipped = false, introduced = false }
end

-- Ranchers from before the hints existed skip them quietly. A player we already
-- introduced keeps going, even after they serve someone.
function Guide.prepare(g: State, life: Life): boolean
	if g.done or g.skipped then
		g.introduced = true
		return false
	end
	if type(g.step) ~= "number" or g.step ~= g.step or g.step < 1 then
		g.step = 1
	end
	g.step = math.floor(g.step)
	if not g.introduced then
		g.introduced = true
		local played = (life.served or 0) > 0
			or life.firstBrisket == true
			or life.tutorialDone == true
			or (life.playSeconds or 0) >= 120
			or (life.crew or 0) > 0
		if played then
			g.skipped = true
			g.done = true
			return true
		end
	end
	return false
end

export type Signals = {
	ranch: boolean,
	serve: boolean,
	crew: boolean,
	gift: boolean,
}

function Guide.signals(data: any): Signals
	local ranch = data.tutorial ~= nil and data.tutorial.firstBrisket == true
	if not ranch and type(data.stations) == "table" then
		for _, cook in pairs(data.stations) do
			if type(cook) == "table" and cook.meat == "firstbrisket" then
				ranch = true
				break
			end
		end
	end
	local crew = false
	local roster = data.staff and data.staff.roster
	if type(roster) == "table" then
		for _, e in ipairs(roster) do
			if type(e) == "table" and e.id == "pip" then
				crew = true
				break
			end
		end
	end
	local owned = data.crew and data.crew.owned
	if not crew and type(owned) == "table" and #owned > 0 then
		crew = true
	end
	local nextAt = data.freeGift and data.freeGift.nextAt
	local gift = type(nextAt) == "number" and nextAt == nextAt and nextAt > 0
	local served = data.stats and data.stats.served or 0
	return {
		ranch = ranch,
		serve = type(served) == "number" and served >= 1,
		crew = crew,
		gift = gift,
	}
end

-- Moves past steps the ranch has already finished. Returns true when the saved step changes.
function Guide.sync(g: State, signals: Signals): boolean
	if g.done or g.skipped then
		return false
	end
	local before = g.step
	if type(g.step) ~= "number" or g.step ~= g.step then
		g.step = 1
	end
	g.step = math.max(1, math.floor(g.step))
	while g.step >= 1 and g.step <= #Guide.STEPS do
		local def = Guide.STEPS[g.step]
		if (signals :: any)[def.id] ~= true then
			break
		end
		g.step += 1
	end
	if g.step > #Guide.STEPS then
		g.done = true
	end
	return g.step ~= before or g.done
end

function Guide.skip(g: State): boolean
	if g.done or g.skipped then
		return false
	end
	g.skipped = true
	g.done = true
	return true
end

export type View = {
	active: boolean,
	step: number?,
	total: number?,
	id: string?,
	title: string?,
	body: string?,
	target: string?,
}

function Guide.view(g: State?): View
	if not g or g.done or g.skipped then
		return { active = false }
	end
	local def = Guide.STEPS[g.step]
	if not def then
		return { active = false }
	end
	return {
		active = true,
		step = g.step,
		total = #Guide.STEPS,
		id = def.id,
		title = def.title,
		body = def.body,
		target = def.target,
	}
end

return Guide
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">HiringLine</string>
            <string name="Source"><![CDATA[--!strict
-- The Hiring Line. One seeded lineup per 5-minute window, shared by the server.
-- You buy the critter you can see. The price is coins, and the same seed always restocks the same six.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")
local TimeUtil = if script ~= nil and script.Parent ~= nil then require(script.Parent.TimeUtil) else require("./TimeUtil")

local HiringLine = {}

local RARITY_ORDER = { "common", "uncommon", "rare", "epic", "legendary", "mythic" }
-- Higher ranch tiers add weight to rarer applicants. Commons stay put, so a new ranch still sees them.
local RARITY_WEIGHT = {
	common = 62,
	uncommon = 24,
	rare = 9,
	epic = 3.5,
	legendary = 1.2,
	mythic = 0.3,
}
local RARITY_BONUS = {
	common = 0,
	uncommon = 1.5,
	rare = 2.2,
	epic = 1.4,
	legendary = 0.7,
	mythic = 0.35,
}

export type Applicant = {
	index: number,
	species: string,
	name: string,
	rarity: string,
	rarityName: string,
	color: string,
	role: string,
	roleName: string,
	trait: string,
	traitName: string,
	baseRate: number,
	rate: number,
	price: number,
	model: string,
	style: string?,
	body: string,
	head: string,
	scale: number?,
	line: string,
	secret: boolean?,
}

function HiringLine.window(now: number, period: number): number
	if period <= 0 then
		return 0
	end
	return math.floor(now / period)
end

function HiringLine.nextAt(now: number, period: number): number
	return (HiringLine.window(now, period) + 1) * period
end

-- "3:45 PM CT". The board shows when the next lineup walks in, not how many seconds are left.
function HiringLine.clockLabel(now: number, period: number, offsetHours: number): string
	local at = HiringLine.nextAt(now, period)
	return "Next lineup: " .. TimeUtil.clock(at, offsetHours) .. " CT"
end

local function mix(seed: number, window: number): number
	local x = (math.floor(seed) * 1000003 + math.floor(window) * 9176 + 17) % 2147483647
	if x <= 0 then
		x += 2147483646
	end
	return x
end

local function lcg(state: number): () -> number
	return function(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

local function weightOf(rarity: string, tier: number): number
	local base = RARITY_WEIGHT[rarity] or 0
	local bonus = RARITY_BONUS[rarity] or 0
	return base + math.max(0, tier - 1) * bonus
end

local function pickKey(rnd: () -> number, keys: { string }, weightFor: (string) -> number): string
	local total = 0
	for _, key in ipairs(keys) do
		total += weightFor(key)
	end
	if total <= 0 then
		return keys[1]
	end
	local x = rnd() * total
	local acc = 0
	for _, key in ipairs(keys) do
		acc += weightFor(key)
		if x < acc then
			return key
		end
	end
	return keys[#keys]
end

local function groups(list: { any }): { [string]: { any } }
	local out: { [string]: { any } } = {}
	for _, row in ipairs(list) do
		if row.secret ~= true then
			local bucket = out[row.rarity]
			if not bucket then
				bucket = {}
				out[row.rarity] = bucket
			end
			table.insert(bucket, row)
		end
	end
	return out
end

local function rarityName(id: string): (string, string)
	for _, row in ipairs(Config.CrewRarities) do
		if row.id == id then
			return row.name, row.color
		end
	end
	return id, "#E7E2DA"
end

local function traitOf(id: string): any
	for _, row in ipairs(Config.CrewTraits) do
		if row.id == id then
			return row
		end
	end
	return Config.CrewTraits[1]
end

local function roleName(id: string): string
	local row = Config.CrewRoles[id]
	return if row then row.name else id
end

local function toApplicant(index: number, species: any, traitId: string): Applicant
	local trait = traitOf(traitId)
	local name, color = rarityName(species.rarity)
	local rate = species.baseRate * trait.mult
	local price = math.max(1, math.floor(species.price * trait.mult + 0.5))
	return {
		index = index,
		species = species.id,
		name = species.name,
		rarity = species.rarity,
		rarityName = name,
		color = color,
		role = species.role,
		roleName = roleName(species.role),
		trait = trait.id,
		traitName = trait.name,
		baseRate = species.baseRate,
		rate = rate,
		price = price,
		model = species.model,
		style = species.style,
		body = species.body,
		head = species.head,
		scale = species.scale,
		line = species.line,
		secret = species.secret == true,
	}
end

-- `tier` is the ranch tier the lineup was weighted for. The same seed, window and tier
-- always return the same six applicants, in the same order, with the same prices.
function HiringLine.stock(seed: number, window: number, tier: number, list: { any }?): { Applicant }
	local species = list or Config.CrewSpecies
	local byRarity = groups(species)
	local rex = nil
	for _, row in ipairs(species) do
		if row.secret == true then
			rex = row
			break
		end
	end
	local rnd = lcg(mix(seed, window))
	local showRex = rex ~= nil and rnd() < Config.Hiring.rexChance
	local tierN = math.clamp(math.floor(tier), 1, #Config.RanchTiers)
	local traitKeys = {}
	for _, row in ipairs(Config.CrewTraits) do
		table.insert(traitKeys, row.id)
	end
	local function traitWeight(id: string): number
		return traitOf(id).weight or 0
	end
	local out: { Applicant } = {}
	for i = 1, Config.Hiring.count do
		local rarity = pickKey(rnd, RARITY_ORDER, function(id: string): number
			return weightOf(id, tierN)
		end)
		local bucket = byRarity[rarity]
		local picked = species[1]
		if bucket and #bucket > 0 then
			local at = math.floor(rnd() * #bucket) + 1
			if at > #bucket then
				at = #bucket
			end
			picked = bucket[at]
		end
		local traitId = pickKey(rnd, traitKeys, traitWeight)
		table.insert(out, toApplicant(i, picked, traitId))
	end
	if showRex and rex then
		local traitId = pickKey(rnd, traitKeys, traitWeight)
		out[Config.Hiring.count] = toApplicant(Config.Hiring.count, rex, traitId)
	end
	-- A brand-new purse is 50 coins. At least two applicants stay at or under that,
	-- so a lineup is never only critters the new player cannot buy.
	local cheap = {}
	for _, row in ipairs(species) do
		if row.secret ~= true and row.price <= Config.Hiring.cheapPrice then
			table.insert(cheap, row)
		end
	end
	table.sort(cheap, function(p, q)
		if p.price ~= q.price then
			return p.price < q.price
		end
		return p.id < q.id
	end)
	local function affordable(): number
		local n = 0
		for _, applicant in ipairs(out) do
			if applicant.secret ~= true and applicant.price <= Config.Hiring.cheapPrice then
				n += 1
			end
		end
		return n
	end
	local pick = 1
	local guard = 0
	while affordable() < Config.Hiring.cheapCount and #cheap > 0 and guard < 8 do
		guard += 1
		local worst = 1
		local worstPrice = -1
		for i, applicant in ipairs(out) do
			if applicant.secret ~= true and applicant.price > Config.Hiring.cheapPrice and applicant.price > worstPrice then
				worst = i
				worstPrice = applicant.price
			end
		end
		if worstPrice < 0 then
			break
		end
		local speciesPick = cheap[((pick - 1) % #cheap) + 1]
		pick += 1
		out[worst] = toApplicant(worst, speciesPick, "none")
	end
	return out
end

-- Saturday Smoke Show: commons and uncommons step up to a Rare or better species. Still deterministic.
function HiringLine.raiseFloor(stock: { Applicant }, list: { any }?)
	local species = list or Config.CrewSpecies
	local pool = {}
	for _, row in ipairs(species) do
		if row.secret ~= true and (row.rarity == "rare" or row.rarity == "epic" or row.rarity == "legendary" or row.rarity == "mythic") then
			table.insert(pool, row)
		end
	end
	if #pool == 0 then
		return
	end
	local n = 1
	for i, applicant in ipairs(stock) do
		-- The two applicants a new purse can afford stay put. The rest of the line steps up.
		if (applicant.rarity == "common" or applicant.rarity == "uncommon") and applicant.price > Config.Hiring.cheapPrice then
			local chosen = pool[((n - 1) % #pool) + 1]
			n += 1
			stock[i] = toApplicant(i, chosen, "none")
		end
	end
end

-- First valid claim wins. A failed claim (not enough coins, no slot) must not call this.
function HiringLine.tryTake(taken: { [number]: number }, index: any, userId: number): boolean
	if type(index) ~= "number" or index ~= math.floor(index) or index < 1 or index > Config.Hiring.count then
		return false
	end
	if type(userId) ~= "number" then
		return false
	end
	if taken[index] ~= nil then
		return false
	end
	taken[index] = userId
	return true
end

return HiringLine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Holiday</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Holiday.luau — pure date logic for date-gated events (no Roblox APIs, unit-tested in Lune).

	Days are "day numbers" (days since 1970-01-01 in the game's timezone), the same numbers
	TimeUtil.dayNumber returns. Weekdays use TimeUtil's convention: 1 = Sunday ... 7 = Saturday.

	  * daysFromCivil / civilFromDays: calendar date <-> day number (Howard Hinnant's algorithms)
	  * nthWeekday: e.g. the 4th Thursday of November
	  * thanksgiving: US Thanksgiving (4th Thursday of November) for a year
	  * turkeyWeek: is `day` inside the Turkey Day Smokeout window around Thanksgiving?
	  * dateWindow: is `day` inside a fixed-date window (it may wrap into the next year, like the
	    Holiday Smokeout's Dec 19 - Jan 1)?
]]
local Holiday = {}

function Holiday.daysFromCivil(y: number, m: number, d: number): number
	if m <= 2 then
		y -= 1
	end
	local era = math.floor(y / 400)
	local yoe = y - era * 400
	local mp = m > 2 and m - 3 or m + 9
	local doy = math.floor((153 * mp + 2) / 5) + d - 1
	local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
	return era * 146097 + doe - 719468
end

function Holiday.civilFromDays(day: number): (number, number, number)
	local z = day + 719468
	local era = math.floor(z / 146097)
	local doe = z - era * 146097
	local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
	local y = yoe + era * 400
	local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
	local mp = math.floor((5 * doy + 2) / 153)
	local d = doy - math.floor((153 * mp + 2) / 5) + 1
	local m = mp < 10 and mp + 3 or mp - 9
	if m <= 2 then
		y += 1
	end
	return y, m, d
end

-- 1 = Sunday ... 7 = Saturday (day 0, 1970-01-01, was a Thursday).
function Holiday.weekdayOf(day: number): number
	return ((day + 4) % 7) + 1
end

-- Day number of the `n`th `weekday` (1 = Sunday ... 7 = Saturday) of a month.
function Holiday.nthWeekday(year: number, month: number, weekday: number, n: number): number
	local first = Holiday.daysFromCivil(year, month, 1)
	local offset = (weekday - Holiday.weekdayOf(first)) % 7
	return first + offset + (n - 1) * 7
end

function Holiday.thanksgiving(year: number): number
	return Holiday.nthWeekday(year, 11, 5, 4)
end

export type Week = { active: boolean, isDay: boolean, day: number, startDay: number, endDay: number }

-- The Turkey Day Smokeout runs from `before` days before Thanksgiving through `after` days after.
function Holiday.turkeyWeek(day: number, before: number, after: number): Week
	local year = Holiday.civilFromDays(day)
	local t = Holiday.thanksgiving(year)
	local startDay, endDay = t - before, t + after
	return { active = day >= startDay and day <= endDay, isDay = day == t, day = t, startDay = startDay, endDay = endDay }
end

-- A fixed-date window, `start`/`finish`/`peak` as { month, day }. If finish is earlier in the year
-- than start, the window wraps into the next year (Dec 19 - Jan 1), and a January day belongs to the
-- window that started the December before. `isDay` is the `peak` day (Christmas for the Holiday Smokeout).
function Holiday.dateWindow(day: number, start: { number }, finish: { number }, peak: { number }?): Week
	local y, m = Holiday.civilFromDays(day)
	local wraps = finish[1] < start[1] or (finish[1] == start[1] and finish[2] < start[2])
	local sy = y
	if wraps and (m < start[1] or (m == start[1] and day < Holiday.daysFromCivil(y, start[1], start[2]))) then
		-- before this year's start: we're either in last year's window (January) or before this year's
		sy = y - 1
		if Holiday.daysFromCivil(sy + 1, finish[1], finish[2]) < day then
			sy = y -- past last year's end: the next window is this year's
		end
	end
	local startDay = Holiday.daysFromCivil(sy, start[1], start[2])
	local endDay = Holiday.daysFromCivil(wraps and sy + 1 or sy, finish[1], finish[2])
	local pk = peak or start
	local py = (wraps and pk[1] < start[1]) and sy + 1 or sy
	local peakDay = Holiday.daysFromCivil(py, pk[1], pk[2])
	return { active = day >= startDay and day <= endDay, isDay = day == peakDay, day = peakDay, startDay = startDay, endDay = endDay }
end

-- Seasonal cuts cook only in their season, except the event's own cut stays open for the whole
-- event window (so Thanksgiving weeks that run into December still have turkey legs).
function Holiday.meatInSeason(meat: any, seasonId: string, eventActive: boolean, eventMeatId: string): boolean
	if not meat.season or meat.season == seasonId then
		return true
	end
	return eventActive and meat.id == eventMeatId
end

-- Same idea with several events at once: `eventMeats[meatId] = true` while that cut's event is on.
function Holiday.meatOpen(meat: any, seasonId: string, eventMeats: { [string]: boolean }): boolean
	if not meat.season or meat.season == seasonId then
		return true
	end
	return eventMeats[meat.id] == true
end

-- A plate a ranch hand cooked. It can be sold like any other plate, but it is not the
-- player's dish: the potluck won't take it, and it can't cash the once-a-day share.
function Holiday.isCrewPlate(plate: any): boolean
	return type(plate) == "table" and plate.by == "crew"
end

-- Which cooler plate to share at the potluck: the plainest one of `meatId` the player cooked
-- (lowest rarity index, earliest on ties), so nobody hands over a rare cut by accident.
-- Crew-cooked plates are skipped. nil if there isn't a player-cooked one.
function Holiday.pickPlate(cooler: { any }, meatId: string, rarityIndex: (string) -> number): number?
	local bestI, bestR = nil, math.huge
	for i, plate in ipairs(cooler) do
		if plate.m == meatId and not Holiday.isCrewPlate(plate) then
			local ri = rarityIndex(plate.r)
			if ri < bestR then
				bestI, bestR = i, ri
			end
		end
	end
	return bestI
end

-- The one plate automatic servers (crew, Jimothy) must leave in the cooler until today's
-- share is done. nil once they've shared, or when they have no player-cooked dish.
function Holiday.holdPlate(cooler: { any }, meatId: string, sharedToday: boolean, rarityIndex: (string) -> number): number?
	if sharedToday then
		return nil
	end
	return Holiday.pickPlate(cooler, meatId, rarityIndex)
end

-- How many plates an automatic server may take. One is held back for the potluck when `holding`.
function Holiday.servable(coolerCount: number, holding: boolean): number
	local n = math.max(0, math.floor(coolerCount))
	if holding then
		return math.max(0, n - 1)
	end
	return n
end

-- Highest-scoring plate an automatic server may take. `held` (the table itself, not an index)
-- is left for the player. nil when every remaining plate is the held one.
function Holiday.autoPlate(cooler: { any }, held: any?, scoreOf: (any) -> number): number?
	local bestI: number? = nil
	local bestS = 0
	for i, plate in ipairs(cooler) do
		if plate ~= held then
			local s = scoreOf(plate)
			if bestI == nil or s > bestS then
				bestI = i
				bestS = s
			end
		end
	end
	return bestI
end

export type ShareRequest = {
	active: boolean,
	day: number,
	sharedOn: number,
	cooler: { any },
	meatId: string,
	ownsReward: boolean,
	price: number,
	shareMult: number,
	rankMult: number,
	rarityIndex: (string) -> number,
}

export type ShareOutcome = {
	ok: boolean,
	reason: string, -- "closed" | "already" | "need" | "shared"
	index: number?,
	coins: number,
	first: boolean,
}

-- One potluck share. Does not mutate the cooler. Crew plates never count, so a hand
-- can't walk a dish up and farm the daily coins or the apron.
function Holiday.tryShare(req: ShareRequest): ShareOutcome
	if not req.active then
		return { ok = false, reason = "closed", coins = 0, first = false }
	end
	if req.sharedOn == req.day then
		return { ok = false, reason = "already", coins = 0, first = false }
	end
	local index = Holiday.pickPlate(req.cooler, req.meatId, req.rarityIndex)
	if not index then
		return { ok = false, reason = "need", coins = 0, first = false }
	end
	local coins = math.floor(req.price * req.shareMult * req.rankMult)
	return { ok = true, reason = "shared", index = index, coins = coins, first = not req.ownsReward }
end

-- Days until a window opens, if it opens within the next `lookahead` days (1..lookahead), else nil.
-- Used for the calm "coming up" sign and login note the week before an event; never a timer.
function Holiday.soon(day: number, w: Week, lookahead: number): number?
	if w.active then
		return nil
	end
	local d = w.startDay - day
	if d >= 1 and d <= lookahead then
		return d
	end
	return nil
end

-- How many different pitmasters shared at the potluck table inside the last `window` seconds
-- (`shares` maps userId -> share time). Read-only: it doesn't prune the table.
function Holiday.recentShares(shares: { [number]: number }, now: number, window: number): number
	local n = 0
	for _, t in pairs(shares) do
		if now - t <= window then
			n += 1
		end
	end
	return n
end

-- The potluck banner's second line: the event's idle line, the live dish count, or the "full"
-- line while the server tip bonus from a full table is on. `L` = { idle, count, full }.
function Holiday.tableLine(n: number, need: number, full: boolean, bonusPct: number, L: { [string]: string }): string
	if full then
		return string.format(L.full, bonusPct)
	end
	if n <= 0 then
		return L.idle
	end
	return string.format(L.count, math.min(n, need), need)
end

-- "Nov 23" style label for a day number.
local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }
function Holiday.label(day: number): string
	local _, m, d = Holiday.civilFromDays(day)
	return MONTHS[m] .. " " .. d
end

-- "Mon, Nov 23" style label for a day number.
local WEEKDAYS = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }
function Holiday.longLabel(day: number): string
	return WEEKDAYS[Holiday.weekdayOf(day)] .. ", " .. Holiday.label(day)
end

return Holiday
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Howdy</string>
            <string name="Source"><![CDATA[--!strict
-- "Say howdy" is a greeting, not a private menu. Typing it in chat (TextChatService
-- or the older chat) and the King's proximity prompt both count. The word has to
-- stand on its own so "showdown" does not greet the yard.
local Howdy = {}

function Howdy.isGreeting(text: any): boolean
	if type(text) ~= "string" then
		return false
	end
	local cleaned = string.lower(text)
	cleaned = string.gsub(cleaned, "[^%a']", " ")
	for word in string.gmatch(cleaned, "%S+") do
		if word == "howdy" then
			return true
		end
	end
	return false
end

-- The King's bottle is the only reward, and only after dark in a cowboy hat,
-- once a day. A daytime howdy still waves. It just doesn't pay.
function Howdy.rewardDue(night: boolean, cowboy: boolean, already: boolean): boolean
	return night and cowboy and not already
end

return Howdy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">HudLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Pixel boxes for the always-on HUD. The client turns these into scale coordinates
-- inside the safe area (notch, home indicator, top bar). Boxes never overlap.
local HudLayout = {}

export type Insets = { left: number, top: number, right: number, bottom: number }
export type Box = { x: number, y: number, w: number, h: number }
export type Options = {
	guide: boolean?,
	rookie: boolean?,
	goals: boolean?,
	hint: boolean?,
	first: boolean?,
}

export type Layout = {
	compact: boolean,
	horizontalMenu: boolean,
	safe: Box,
	currencies: Box,
	menu: Box,
	goals: Box,
	guide: Box,
	actions: Box,
	stations: Box,
	right: Box,
	status: Box,
	first: Box,
	hint: Box,
	rookie: Box,
	stationCard: { w: number, h: number },
	menuButton: { w: number, h: number },
}

function HudLayout.compact(width: number, height: number): boolean
	return width < 1000 or height < 620
end

function HudLayout.overlaps(a: Box, b: Box): boolean
	if a.w <= 0 or a.h <= 0 or b.w <= 0 or b.h <= 0 then
		return false
	end
	return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end

function HudLayout.inside(a: Box, bounds: Box): boolean
	if a.w <= 0 or a.h <= 0 then
		return true
	end
	local eps = 0.51
	return a.x >= bounds.x - eps and a.y >= bounds.y - eps and a.x + a.w <= bounds.x + bounds.w + eps and a.y + a.h <= bounds.y + bounds.h + eps
end

local function box(x: number, y: number, w: number, h: number): Box
	return { x = math.floor(x + 0.5), y = math.floor(y + 0.5), w = math.max(0, math.floor(w + 0.5)), h = math.max(0, math.floor(h + 0.5)) }
end

local function empty(): Box
	return box(0, 0, 0, 0)
end

local function insetsOf(insets: Insets?): Insets
	local src = insets or { left = 0, top = 0, right = 0, bottom = 0 }
	return {
		left = math.max(0, src.left or 0),
		top = math.max(0, src.top or 0),
		right = math.max(0, src.right or 0),
		bottom = math.max(0, src.bottom or 0),
	}
end

local function cardSize(stationW: number, stationH: number, compact: boolean): { w: number, h: number }
	local w = if compact then math.clamp(stationW * 0.42, 132, 168) else 176
	local ratio = if compact then (158 / 112) else (176 / 168)
	local h = math.floor(w / ratio + 0.5)
	if h > stationH - 8 then
		h = math.max(72, stationH - 8)
		w = math.floor(h * ratio + 0.5)
	end
	return { w = w, h = h }
end

local function phone(width: number, height: number, inset: Insets, opts: Options): Layout
	local gap = 4
	local x0 = inset.left
	local y0 = inset.top
	local availW = math.max(0, width - inset.left - inset.right)
	local availH = math.max(0, height - inset.top - inset.bottom)
	local safe = box(x0, y0, availW, availH)

	local topH = 48
	local menuH = 56
	local bannerH = if (opts.goals or opts.guide) then 40 else 0
	local actionH = 48
	local stationH = math.clamp(math.floor(availH * 0.28), 96, 132)
	local firstH = if opts.first then 52 else 0
	local hintH = if opts.hint then 32 else 0
	local rookieH = if opts.rookie then 88 else 0

	local function used(): number
		return topH + menuH + bannerH + rookieH + hintH + firstH + actionH + stationH + gap * 6
	end

	-- Drop the least important row first. The guide/goals banner and the core
	-- buttons stay until the screen is genuinely too short to hold them.
	local stationFloor = 80
	local guard = 0
	while used() > availH and guard < 100 do
		guard += 1
		if hintH > 0 then
			hintH = 0
		elseif rookieH > 0 then
			rookieH -= 4
		elseif stationH > stationFloor then
			stationH -= 4
		elseif firstH > 44 then
			firstH -= 4
		elseif menuH > 48 then
			menuH -= 4
		elseif topH > 40 then
			topH -= 4
		elseif firstH > 0 then
			firstH = 0
		elseif bannerH > 36 then
			bannerH -= 4
		elseif stationFloor > 64 then
			stationFloor = 64
		else
			break
		end
	end

	local y = y0
	local currencies = box(x0, y, availW, topH)
	y += topH + gap
	local menu = box(x0, y, availW, menuH)
	y += menuH + gap
	local showGuide = opts.guide == true and bannerH > 0
	local showGoals = opts.goals == true and not showGuide and bannerH > 0
	local goals = if showGoals then box(x0, y, availW, bannerH) else empty()
	local guide = if showGuide then box(x0, y, availW, bannerH) else empty()
	if bannerH > 0 then
		y += bannerH + gap
	end

	local bottom = y0 + availH
	local stations = box(x0, bottom - stationH, availW, stationH)
	local actions = box(x0, stations.y - gap - actionH, availW, actionH)
	local cursor = actions.y - gap
	local first = if firstH > 0 then box(x0 + 8, cursor - firstH, math.max(0, availW - 16), firstH) else empty()
	if firstH > 0 then
		cursor = first.y - gap
	end
	local hint = if hintH > 0 then box(x0 + 8, cursor - hintH, math.max(0, availW - 16), hintH) else empty()
	if hintH > 0 then
		cursor = hint.y - gap
	end
	local room = math.max(0, cursor - y)
	local rookH = math.min(rookieH, room)
	local rookie = if rookH > 0 then box(x0, y, availW, rookH) else empty()

	local buttons = math.max(44, math.min(menuH - 4, 56))
	return {
		compact = true,
		horizontalMenu = true,
		safe = safe,
		currencies = currencies,
		menu = menu,
		goals = goals,
		guide = guide,
		actions = actions,
		stations = stations,
		right = empty(),
		status = empty(),
		first = first,
		hint = hint,
		rookie = rookie,
		stationCard = cardSize(availW, stationH, true),
		menuButton = { w = 96, h = buttons },
	}
end

local function desktop(width: number, height: number, inset: Insets, opts: Options): Layout
	local x0 = inset.left
	local y0 = inset.top
	local availW = math.max(0, width - inset.left - inset.right)
	local availH = math.max(0, height - inset.top - inset.bottom)
	local safe = box(x0, y0, availW, availH)
	local menuW = 108
	local rightW = 188
	local gap = 8
	local topH = 52
	local stationH = math.clamp(math.floor(availH * 0.26), 156, 184)
	local topY = y0 + gap
	local midX = x0 + menuW + 12
	local midRight = x0 + availW - 12 - rightW
	local midW = math.max(0, midRight - gap - midX)
	local currencies = box(midX, topY, midW, topH)
	local row2 = topY + topH + gap
	local bannerH = if (opts.guide or opts.goals) then 44 else 0
	local rookieW = if opts.rookie then math.min(360, math.max(220, math.floor(availW * 0.28))) else 0
	local rookieX = x0 + availW - 16 - rookieW
	local goalLimit = if rookieW > 0 then math.max(0, rookieX - gap - midX) else midW
	local bannerW = math.min(520, goalLimit, midW)
	local showGuide = opts.guide == true and bannerH > 0 and bannerW > 0
	local showGoals = opts.goals == true and not showGuide and bannerH > 0 and bannerW > 0
	local goals = if showGoals then box(midX, row2, bannerW, bannerH) else empty()
	local guide = if showGuide then box(midX, row2, bannerW, bannerH) else empty()
	local rookie = if rookieW > 0 then box(rookieX, row2, rookieW, math.min(188, availH - (row2 - y0) - stationH - 24)) else empty()
	local menuY = row2 + (if bannerH > 0 then bannerH + gap else 0)
	local stations = box(midX, y0 + availH - gap - stationH, math.max(0, midW), stationH)
	local menu = box(x0 + 8, menuY, menuW, math.max(0, stations.y - gap - menuY))
	local rightH = 156
	local right = box(midRight, stations.y - gap - rightH, rightW, rightH)
	local statusW = math.min(300, math.max(0, right.x - gap - (midX + 200)))
	local status = if statusW >= 140 then box(right.x - gap - statusW, right.y, statusW, 96) else empty()
	local firstW = math.min(460, math.max(0, (if status.w > 0 then status.x else right.x) - gap - stations.x))
	local first = if opts.first and firstW >= 200 then box(stations.x, stations.y - gap - 64, firstW, 64) else empty()
	local hint = if opts.hint and first.w > 0 then box(stations.x, first.y - gap - 40, firstW, 40) else empty()
	if hint.y < menuY then
		hint = empty()
	end
	return {
		compact = false,
		horizontalMenu = false,
		safe = safe,
		currencies = currencies,
		menu = menu,
		goals = goals,
		guide = guide,
		actions = empty(),
		stations = stations,
		right = right,
		status = status,
		first = first,
		hint = hint,
		rookie = rookie,
		stationCard = cardSize(stations.w, stationH, false),
		menuButton = { w = 96, h = 72 },
	}
end

function HudLayout.compute(width: number, height: number, insets: Insets?, opts: Options?): Layout
	local inset = insetsOf(insets)
	local flags = opts or {}
	if HudLayout.compact(width, height) then
		return phone(width, height, inset, flags)
	end
	return desktop(width, height, inset, flags)
end

export type Notices = { toast: Box, announce: Box }

-- Where login toasts and the potluck announcement sit. They stay under the currency
-- row, the menu, the goals bar and the guide, and off the action buttons. On a short
-- phone where that gap is only a few pixels, they rest on the station row instead of
-- covering the guide.
function HudLayout.notices(width: number, height: number, insets: Insets?, opts: Options?): Notices
	local lay = HudLayout.compute(width, height, insets, opts)
	local function horiz(a: Box, b: Box): boolean
		return a.w > 0 and b.w > 0 and a.x < b.x + b.w and b.x < a.x + a.w
	end
	local function nextTop(names: { string }, x: number, w: number, y: number): number
		local probe = box(x, y, w, 1)
		local lim = lay.safe.y + lay.safe.h
		for _, name in ipairs(names) do
			local b = (lay :: any)[name] :: Box
			if b and b.h > 0 and b.y >= y - 0.5 and horiz(probe, b) then
				lim = math.min(lim, b.y)
			end
		end
		return lim
	end
	local y0 = lay.safe.y
	for _, name in ipairs({ "currencies", "menu", "goals", "guide" }) do
		local b = (lay :: any)[name] :: Box
		if b and b.h > 0 then
			y0 = math.max(y0, b.y + b.h)
		end
	end
	y0 += 8
	local maxW = math.max(0, lay.safe.w - 16)
	local annW = math.min(520, maxW)
	local toastW = math.min(420, maxW)
	local xA = lay.safe.x + math.floor((lay.safe.w - annW) / 2)
	local xT = lay.safe.x + math.floor((lay.safe.w - toastW) / 2)
	local spanX = math.min(xA, xT)
	local spanW = math.max(xA + annW, xT + toastW) - spanX
	local hard = { "currencies", "menu", "goals", "guide", "actions", "first", "hint" }
	local room = nextTop(hard, spanX, spanW, y0) - y0
	local annH = 34
	local toastH = 72
	if room >= annH + 6 + 40 then
		toastH = math.min(120, room - annH - 6)
		return {
			announce = box(xA, y0, annW, annH),
			toast = box(xT, y0 + annH + 6, toastW, toastH),
		}
	end
	local st = lay.stations
	if st.h >= 36 and st.w > 0 then
		local y = st.y + 4
		local aw = math.min(annW, st.w)
		local tw = math.min(toastW, st.w)
		local ax = math.max(lay.safe.x, math.min(xA, st.x + st.w - aw))
		local tx = math.max(lay.safe.x, math.min(xT, st.x + st.w - tw))
		local th = math.max(28, math.min(64, st.h - 40))
		if y + 36 + th > lay.safe.y + lay.safe.h then
			th = math.max(0, lay.safe.y + lay.safe.h - (y + 36))
		end
		return { announce = box(ax, y, aw, 32), toast = box(tx, y + 36, tw, th) }
	end
	return { announce = box(xA, y0, annW, 0), toast = box(xT, y0, toastW, 0) }
end

return HudLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">HudMenu</string>
            <string name="Source"><![CDATA[--!strict
-- Left-side HUD menu: which button opens which window, and how one click
-- is allowed to count once.
--
-- The menu sits in a ScrollingFrame. Roblox can deliver two Activated events
-- for a single press there (the button, then the frame's scroll-release).
-- Panel buttons toggle, so the second event used to open the window and
-- close it again before it ever painted. Invite does not toggle a window,
-- which is why it was the only button that still looked alive.
local HudMenu = {}

export type Entry = {
	id: string,
	icon: string,
	label: string,
	panel: string,
	order: number,
}

-- Invite is the only entry that does not open a Panels window.
HudMenu.entries = {
	{ id = "shop", icon = "🛒", label = "Pit Shop", panel = "shop", order = 1 },
	{ id = "season", icon = "🎟️", label = "Season", panel = "season", order = 2 },
	{ id = "sauce", icon = "🥫", label = "Sauce", panel = "sauce", order = 3 },
	{ id = "index", icon = "📖", label = "Index", panel = "index", order = 4 },
	{ id = "path", icon = "🗺️", label = "Path", panel = "path", order = 5 },
	{ id = "upgrades", icon = "⬆️", label = "Upgrade", panel = "upgrades", order = 6 },
	{ id = "crew", icon = "🍳", label = "Crew", panel = "crew", order = 7 },
	{ id = "hire", icon = "🐾", label = "Hire", panel = "hire", order = 11 },
	{ id = "ranch", icon = "🏡", label = "Ranch", panel = "crew", order = 12 },
	{ id = "daily", icon = "🎁", label = "Daily", panel = "daily", order = 8 },
	{ id = "settings", icon = "⚙️", label = "Settings", panel = "settings", order = 9 },
	{ id = "invite", icon = "👋", label = "Invite", panel = "invite", order = 10 },
} :: { Entry }

-- Scroller stays under the buttons. The hit target stays above the icon and caption.
HudMenu.SCROLL_Z = 1
HudMenu.HIT_Z = 6

export type Guard = {
	allow: (self: Guard) -> boolean,
	release: (self: Guard) -> (),
}

-- True for the first activation of a click. Stays closed until release, which
-- the button schedules with task.defer so a second event in the same press
-- cannot run the handler again.
function HudMenu.guard(): Guard
	local held = false
	local gate: Guard = {
		allow = function(_self: Guard): boolean
			if held then
				return false
			end
			held = true
			return true
		end,
		release = function(_self: Guard)
			held = false
		end,
	}
	return gate
end

-- Returns the panel that should be open afterwards, and whether to run the
-- invite flow. Invite never opens or closes a window.
function HudMenu.press(current: string?, panel: string): (string?, boolean)
	if panel == "invite" then
		return current, true
	end
	if current == panel then
		return nil, false
	end
	return panel, false
end

-- Icon, caption and the notification dot are drawn on the button. They must
-- not take the click. The hit button itself is a GuiButton and is left alone.
function HudMenu.releaseDecorations(root: Instance)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiObject") and not d:IsA("GuiButton") then
			local g = d :: GuiObject
			g.Active = false
			g.Interactable = false
			pcall(function()
				(g :: any).InputSink = Enum.InputSink.None
			end)
		end
	end
end

return HudMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Hype</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Hype.luau — pure logic for the social / clip moments (no Roblox APIs, unit-tested in Lune).

	  * pileOn:   Big Bertha's Dinner Bell. When `need` different players ring the bell within
	              `window` seconds, the whole server gets a short free tip bonus.
	  * rushStep: the Lunch Rush. Time is cut into fixed windows; serve `need` plates inside one
	              window for a bonus. Gives a 1-3 minute goal at every stage of the game.
	  * isSixSeven: a plate worth ...67 coins pops a "6-7!" (text only, no audio or likeness).
	  * passTip:  Fair Play cap for the tip pass.
]]
local Hype = {}

-- `rubs` maps userId -> last rub time. Returns how many distinct players rubbed inside the
-- window, and whether that reaches `need` (and the cooldown since `lastT` has passed).
function Hype.pileOn(rubs: { [number]: number }, now: number, window: number, need: number, lastT: number, cooldown: number): (number, boolean)
	local n = 0
	for id, t in pairs(rubs) do
		if now - t <= window then
			n += 1
		else
			rubs[id] = nil
		end
	end
	return n, n >= need and now - lastT >= cooldown
end

-- Does this bell ring count (stats / Season XP / pile-on)? At most one per `cooldown` seconds
-- per player; records the time when it does.
function Hype.ringCounts(last: { [number]: number }, id: number, now: number, cooldown: number): boolean
	local t = last[id]
	if t ~= nil and now - t < cooldown then
		return false
	end
	last[id] = now
	return true
end

export type Rush = { w: number, n: number, sum: number, done: boolean }

function Hype.rushWindow(t: number, period: number): number
	return math.floor(t / period)
end

function Hype.rushEnds(w: number, period: number): number
	return (w + 1) * period
end

-- Record one served plate worth `value` at time `t`. Returns the (possibly new) rush state and
-- the bonus to pay right now (0 unless this plate cleared the rush).
function Hype.rushStep(state: Rush?, t: number, period: number, need: number, bonusFrac: number, value: number): (Rush, number)
	local w = Hype.rushWindow(t, period)
	local s: Rush = (state and state.w == w) and state or { w = w, n = 0, sum = 0, done = false }
	if s.done then
		return s, 0
	end
	s.n += 1
	s.sum += value
	if s.n >= need then
		s.done = true
		return s, math.max(1, math.floor(s.sum * bonusFrac + 0.5))
	end
	return s, 0
end

function Hype.isSixSeven(value: number): boolean
	return value >= 67 and value % 100 == 67
end

-- Fair Play: the tip pass is a flat multiplier, never more than `cap`.
function Hype.passTip(hasPass: boolean, mult: number, cap: number): number
	if not hasPass then
		return 1
	end
	return math.min(mult, cap)
end

return Hype
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Income</string>
            <string name="Source"><![CDATA[--!strict
-- Trailing coins-per-second from real earn events. Nothing here is a scripted rate.
local Numbers = if script ~= nil and script.Parent ~= nil then require(script.Parent.Numbers) else require("./Numbers")

local Income = {}

Income.WINDOW = 30

local function trimDecimal(text: string): string
	return (text:gsub("%.0$", ""))
end

export type Event = { t: number, n: number }

function Income.record(events: { Event }, now: number, amount: number, window: number?)
	if type(amount) ~= "number" or amount <= 0 or amount ~= amount or amount == math.huge then
		return
	end
	local span = window or Income.WINDOW
	table.insert(events, { t = now, n = math.floor(amount) })
	local cutoff = now - span
	local keep: { Event } = {}
	for _, e in ipairs(events) do
		if e.t >= cutoff then
			table.insert(keep, e)
		end
	end
	while #keep > 80 do
		table.remove(keep, 1)
	end
	table.clear(events)
	for _, e in ipairs(keep) do
		table.insert(events, e)
	end
end

function Income.perSecond(events: { Event }, now: number, window: number?): number
	local span = window or Income.WINDOW
	if span <= 0 then
		return 0
	end
	local cutoff = now - span
	local sum = 0
	for _, e in ipairs(events) do
		if e.t > cutoff and e.t <= now then
			sum += e.n
		end
	end
	return sum / span
end

function Income.format(perSecond: number): string
	if type(perSecond) ~= "number" or perSecond ~= perSecond or perSecond <= 0 then
		return "+0/s"
	end
	if perSecond < 10 then
		local rounded = math.floor(perSecond * 10 + 0.5) / 10
		local text = string.format("%.1f", rounded)
		text = trimDecimal(text)
		return "+" .. text .. "/s"
	end
	return "+" .. Numbers.abbrev(math.floor(perSecond + 0.5)) .. "/s"
end

return Income
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Index</string>
            <string name="Source"><![CDATA[--!strict
-- Crew Index. A species row is that critter with all 4 traits. A finished row is +2% income, forever.
-- Finishing every species of a rarity grants a free title.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")

local Index = {}

local TRAITS = { "smoky", "glazed", "golden", "meteorite" }

function Index.traits(): { string }
	return TRAITS
end

function Index.ensure(data: any): any
	if type(data.index) ~= "table" then
		data.index = { traits = {} }
	end
	if type(data.index.traits) ~= "table" then
		data.index.traits = {}
	end
	if type(data.titles) ~= "table" then
		data.titles = {}
	end
	return data.index
end

function Index.has(data: any, speciesId: string, traitId: string): boolean
	local index = Index.ensure(data)
	local row = index.traits[speciesId]
	return type(row) == "table" and row[traitId] == true
end

function Index.rowComplete(data: any, speciesId: string): boolean
	for _, traitId in ipairs(TRAITS) do
		if not Index.has(data, speciesId, traitId) then
			return false
		end
	end
	return true
end

function Index.completedRows(data: any, speciesList: { any }?): number
	local list = speciesList or Config.CrewSpecies
	local n = 0
	for _, species in ipairs(list) do
		if species.secret ~= true and Index.rowComplete(data, species.id) then
			n += 1
		end
	end
	return n
end

function Index.incomeMult(data: any): number
	return 1 + Config.IndexBonus * Index.completedRows(data)
end

function Index.rarityComplete(data: any, rarity: string, speciesList: { any }?): boolean
	local list = speciesList or Config.CrewSpecies
	local any = false
	for _, species in ipairs(list) do
		if species.rarity == rarity and species.secret ~= true then
			any = true
			if not Index.rowComplete(data, species.id) then
				return false
			end
		end
	end
	return any
end

export type Note = { newTrait: boolean, rowDone: boolean, title: string? }

-- Records a caught trait. Does not downgrade anything; the caller already upgraded the critter.
function Index.note(data: any, speciesId: string, traitId: string): Note
	local index = Index.ensure(data)
	if traitId == "none" or traitId == "" then
		return { newTrait = false, rowDone = false, title = nil }
	end
	local row = index.traits[speciesId]
	if type(row) ~= "table" then
		row = {}
		index.traits[speciesId] = row
	end
	local wasRow = Index.rowComplete(data, speciesId)
	local fresh = row[traitId] ~= true
	row[traitId] = true
	local rowDone = fresh and not wasRow and Index.rowComplete(data, speciesId)
	local title = nil
	local species = nil
	for _, rowSpecies in ipairs(Config.CrewSpecies) do
		if rowSpecies.id == speciesId then
			species = rowSpecies
			break
		end
	end
	if species and Index.rarityComplete(data, species.rarity) then
		local name = Config.IndexTitles[species.rarity]
		if name and data.titles[name] ~= true then
			data.titles[name] = true
			title = name
		end
	end
	return { newTrait = fresh, rowDone = rowDone, title = title }
end

return Index
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Jimothy</string>
            <string name="Source"><![CDATA[--!strict
-- Jimothy the Raccoon.
-- Old Regulars Index saves stored serves under the id "possum" (Possum Pete). Those counts
-- move onto "jimothy" so nobody loses a regular. The sighting hunt is server-side: each id
-- counts once, attempts are rate-limited, and the title plus free buddy are granted once.
local Jimothy = {}

Jimothy.LEGACY_ID = "possum"
Jimothy.ID = "jimothy"
Jimothy.TITLE = "Jimothy Spotter"
Jimothy.COSMETIC = "buddy_jimothy"
Jimothy.COOLDOWN = 0.75

Jimothy.LINES = {
	"Praise Jimothy!!",
	"No neck, no problem.",
	"Is that brisket?",
	"Built different.",
}

export type Spot = { id: string, place: string }

Jimothy.SIGHTINGS = {
	{ id = "shack", place = "Behind the Sauce Shack, against the back wall" },
	{ id = "roof", place = "On the Sauce Shack roof, beside the Roof Club pad" },
	{ id = "trash", place = "In a trash can on the southeast edge of the town square (King of the trash)" },
	{ id = "board", place = "Beside the Cook-Off leaderboard, on the back side at ground level" },
	{ id = "spawn", place = "Behind the left post of the welcome arch, just past spawn" },
	{ id = "plots", place = "In the grass outside the ranches, in the gap between plot 1 and plot 2" },
	{ id = "creek", place = "In the cattails by the creek, away from the whisper stone" },
	{ id = "oak", place = "Behind the tire-swing oak, on the far side of the trunk" },
	{ id = "hay", place = "Behind the hay bales west of the Cook-Off stage" },
	{ id = "bertha", place = "Behind Big Bertha, by the back wheel" },
} :: { Spot }

export type Record = {
	ok: boolean,
	duplicate: boolean,
	limited: boolean,
	count: number,
	total: number,
	justCompleted: boolean,
	title: string?,
	cosmetic: string?,
}

function Jimothy.total(): number
	return #Jimothy.SIGHTINGS
end

function Jimothy.isSpot(id: string): boolean
	for _, spot in ipairs(Jimothy.SIGHTINGS) do
		if spot.id == id then
			return true
		end
	end
	return false
end

function Jimothy.count(seen: any): number
	if type(seen) ~= "table" then
		return 0
	end
	local n = 0
	for _, spot in ipairs(Jimothy.SIGHTINGS) do
		if seen[spot.id] then
			n += 1
		end
	end
	return n
end

-- Moves legacy Regulars Index data onto Jimothy. Safe to call more than once.
function Jimothy.migrate(data: any): boolean
	if type(data) ~= "table" then
		return false
	end
	local changed = false
	if type(data.critters) == "table" and data.critters[Jimothy.LEGACY_ID] ~= nil then
		local legacy = data.critters[Jimothy.LEGACY_ID]
		local add = if type(legacy) == "number" then legacy else 0
		local cur = data.critters[Jimothy.ID]
		local base = if type(cur) == "number" then cur else 0
		data.critters[Jimothy.ID] = base + add
		data.critters[Jimothy.LEGACY_ID] = nil
		changed = true
	end
	if data.forceCritter == Jimothy.LEGACY_ID then
		data.forceCritter = Jimothy.ID
		changed = true
	end
	return changed
end

local function ensure(data: any): any
	if type(data.jimothy) ~= "table" then
		data.jimothy = { seen = {}, lastAt = 0, rewarded = false }
	end
	if type(data.jimothy.seen) ~= "table" then
		data.jimothy.seen = {}
	end
	if type(data.titles) ~= "table" then
		data.titles = {}
	end
	return data.jimothy
end

-- `now` is seconds (the server passes os.clock()). A repeat of the same id never
-- adds credit. A new id inside the cooldown is refused and not stored.
function Jimothy.record(data: any, id: string, now: number): Record
	local total = Jimothy.total()
	if type(data) ~= "table" or not Jimothy.isSpot(id) or type(now) ~= "number" then
		return { ok = false, duplicate = false, limited = false, count = 0, total = total, justCompleted = false }
	end
	local state = ensure(data)
	local count = Jimothy.count(state.seen)
	if state.seen[id] then
		return { ok = true, duplicate = true, limited = false, count = count, total = total, justCompleted = false }
	end
	-- lastAt stays 0 until the first credit, so a brand-new save isn't cooling down.
	local last = state.lastAt
	if type(last) == "number" and last > 0 and now - last < Jimothy.COOLDOWN then
		return { ok = false, duplicate = false, limited = true, count = count, total = total, justCompleted = false }
	end
	state.seen[id] = true
	state.lastAt = now
	count += 1
	local just = count >= total and state.rewarded ~= true
	if just then
		state.rewarded = true
		data.titles[Jimothy.TITLE] = true
	end
	return {
		ok = true,
		duplicate = false,
		limited = false,
		count = count,
		total = total,
		justCompleted = just,
		title = if just then Jimothy.TITLE else nil,
		cosmetic = if just then Jimothy.COSMETIC else nil,
	}
end

return Jimothy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Migrate</string>
            <string name="Source"><![CDATA[--!strict
-- One-time save step from schema 1 to schema 2. Safe to call again: a schema 2 save is left alone.
-- Founders keep their names. Their old speed, carry and quality become one level.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")
local Crew = if script ~= nil and script.Parent ~= nil then require(script.Parent.Crew) else require("./Crew")

local Migrate = {}

local function progress(data: any): boolean
	local rookie = data.rookie
	if type(rookie) == "table" and ((rookie.claimed or 0) > 0 or rookie.skipped == true or rookie.resumed == true) then
		return true
	end
	local guide = data.guide
	if type(guide) == "table" and (guide.done == true or guide.skipped == true or guide.introduced == true or (guide.step or 1) > 1) then
		return true
	end
	local tutorial = data.tutorial
	if type(tutorial) == "table" and (tutorial.done == true or tutorial.firstBrisket == true) then
		return true
	end
	return false
end

local function grantRookie(data: any)
	if type(data.onboard) ~= "table" then
		data.onboard = { done = false, rookieReward = false }
	end
	if data.onboard.rookieReward == true then
		return
	end
	local rookie = data.rookie
	if type(rookie) ~= "table" then
		return
	end
	local claimed = rookie.claimed or 0
	local total = #Config.RookieSteps
	if claimed <= 0 or claimed >= total then
		return
	end
	local reward = Config.RookieFinish
	if type(data.titles) == "table" and reward.title and data.titles[reward.title] then
		data.onboard.rookieReward = true
		return
	end
	if type(reward.coins) == "number" and reward.coins > 0 then
		data.coins = (data.coins or 0) + reward.coins
	end
	if reward.cosmetic then
		if type(data.owned) ~= "table" then
			data.owned = {}
		end
		data.owned[reward.cosmetic] = true
	end
	if reward.title then
		if type(data.titles) ~= "table" then
			data.titles = {}
		end
		data.titles[reward.title] = true
	end
	data.onboard.rookieReward = true
end

local function extraSlots(data: any): number
	local n = 0
	if type(data.smokerSlotsBought) == "number" and data.smokerSlotsBought > 0 then
		n += 1
	end
	if type(data.grillSlotsBought) == "number" and data.grillSlotsBought > 0 then
		n += 1
	end
	return n
end

-- Returns true when this call did the schema 2 step.
function Migrate.apply(data: any, now: number?): boolean
	if type(data) ~= "table" then
		return false
	end
	local schema = data.schema
	if type(schema) == "number" and schema >= 2 then
		return false
	end
	Crew.ensure(data)
	if type(data.index) ~= "table" then
		data.index = { traits = {} }
	elseif type(data.index.traits) ~= "table" then
		data.index.traits = {}
	end
	if type(data.codes) ~= "table" then
		data.codes = {}
	end
	if type(data.partners) ~= "table" then
		data.partners = {}
	end
	if type(data.events) ~= "table" then
		data.events = { smokeShowWeek = -1 }
	elseif type(data.events.smokeShowWeek) ~= "number" then
		data.events.smokeShowWeek = -1
	end
	if type(data.onboard) ~= "table" then
		data.onboard = { done = false, rookieReward = false }
	end
	local roster = {}
	if type(data.staff) == "table" and type(data.staff.roster) == "table" then
		roster = data.staff.roster
	end
	local owned = {}
	local uid = 1
	for _, entry in ipairs(roster) do
		if type(entry) == "table" and type(entry.id) == "string" then
			local founder = Config.Founders[entry.id]
			local species = founder and Crew.byId(founder.species) or nil
			if founder and species then
				table.insert(owned, {
					uid = uid,
					species = species.id,
					name = founder.name,
					level = Crew.founderLevel(entry.speed, entry.capacity, entry.quality),
					trait = "none",
					badge = "Founder",
					role = species.role,
				})
				uid += 1
			end
		end
	end
	data.crew.owned = owned
	data.crew.nextUid = uid
	local pit = data.pitLevel
	local tier = 1
	if type(pit) == "number" and pit == pit then
		tier = math.clamp(math.floor(pit), 1, #Config.RanchTiers)
	end
	data.ranch.tier = tier
	data.crew.extra = extraSlots(data)
	data.crew.slots = Crew.slotCount(tier, data.crew.extra, data.crew.bunkhouse == true)
	if progress(data) then
		data.onboard.done = true
	end
	grantRookie(data)
	local tick = if type(now) == "number" and now > 0 then now else 0
	data.offline.lastTick = tick
	data.schema = 2
	return true
end

return Migrate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">MusicPrefs</string>
            <string name="Source"><![CDATA[--!strict
-- Saved music preferences. Mute and volume are independent: muting does not
-- zero the volume, so unmuting comes back to the level the player picked.
local MusicPrefs = {}

MusicPrefs.DEFAULT_VOLUME = 0.22 -- quiet porch, not a blast

MusicPrefs.STEPS = {
	{ id = "quiet", label = "Quiet", volume = 0.22 },
	{ id = "easy", label = "Easy", volume = 0.4 },
	{ id = "full", label = "Full", volume = 0.7 },
}

function MusicPrefs.clamp(volume: any): number
	if type(volume) ~= "number" or volume ~= volume or volume == math.huge or volume == -math.huge then
		return MusicPrefs.DEFAULT_VOLUME
	end
	return math.clamp(volume, 0, 1)
end

function MusicPrefs.read(settings: any): (boolean, number)
	local on = true
	local volume = MusicPrefs.DEFAULT_VOLUME
	if type(settings) == "table" then
		if settings.music == false then
			on = false
		end
		if settings.musicVolume ~= nil then
			volume = MusicPrefs.clamp(settings.musicVolume)
		end
	end
	return on, volume
end

-- A Roblox audio id. 0 means the original file is in the repo and not uploaded yet,
-- so the client must stay silent instead of playing a placeholder.
function MusicPrefs.audible(trackId: any): boolean
	return type(trackId) == "number" and trackId > 0 and trackId == math.floor(trackId)
end

return MusicPrefs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Numbers</string>
            <string name="Source"><![CDATA[--!strict
-- Short coin labels: 999, 1.2K, 3.4M. Shared so the HUD and the tests use one rule.
local Numbers = {}

local SUFFIXES = {
	{ div = 1e12, suf = "T" },
	{ div = 1e9, suf = "B" },
	{ div = 1e6, suf = "M" },
	{ div = 1e3, suf = "K" },
}

local function trim(text: string): string
	return (text:gsub("%.0$", ""))
end

function Numbers.abbrev(n: number): string
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	local sign = if n < 0 then "-" else ""
	local value = math.abs(n)
	if value < 1000 then
		return sign .. tostring(math.floor(value + 1e-6))
	end
	for i, step in ipairs(SUFFIXES) do
		if value >= step.div then
			local scaled = value / step.div
			local text = string.format("%.1f", scaled)
			local rounded = tonumber(text) or scaled
			-- 999,950 formats as 1000.0K. Step up a suffix instead of printing 1000K.
			if rounded >= 1000 and i > 1 then
				local up = SUFFIXES[i - 1]
				return sign .. trim(string.format("%.1f", value / up.div)) .. up.suf
			end
			return sign .. trim(text) .. step.suf
		end
	end
	return sign .. tostring(math.floor(value + 1e-6))
end

return Numbers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Offers</string>
            <string name="Source"><![CDATA[--!strict
-- A quiet card next to the thing it helps. No countdown, no "only a few left."
local Offers = {}

export type Offer = { id: string, title: string, detail: string, kind: string, key: string }

export type Need = {
	playSeconds: number,
	skip: boolean,
	promptAt: number,
	slotsFull: boolean,
	bunkhouse: boolean,
	autoHire: boolean,
	hasCrew: boolean,
}

function Offers.pick(need: Need): Offer?
	if not need.skip and need.playSeconds < need.promptAt then
		return nil
	end
	if need.slotsFull and not need.bunkhouse then
		return {
			id = "bunkhouse",
			title = "Bunkhouse",
			detail = "Adds 4 crew slots, and crew keep earning for 8 hours while you're away.",
			kind = "pass",
			key = "Bunkhouse",
		}
	end
	if need.hasCrew and not need.autoHire then
		return {
			id = "autohire",
			title = "Auto-Hire",
			detail = "While you're here, the best critter you can afford is hired when the line restocks. You can turn it off.",
			kind = "pass",
			key = "AutoHire",
		}
	end
	return nil
end

return Offers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Offline</string>
            <string name="Source"><![CDATA[--!strict
-- Crew keep earning while you're away, up to a cap. The cap is a length of time, not a sale.
local Offline = {}

Offline.CAP = 4 * 3600
Offline.BUNKHOUSE_CAP = 8 * 3600

function Offline.cap(bunkhouse: boolean?): number
	if bunkhouse then
		return Offline.BUNKHOUSE_CAP
	end
	return Offline.CAP
end

-- Seconds of pay owed. lastTick of 0 (or a clock that went backwards) pays nothing.
function Offline.awaySeconds(lastTick: any, now: number, capSeconds: number): number
	if type(lastTick) ~= "number" or type(now) ~= "number" or type(capSeconds) ~= "number" then
		return 0
	end
	if lastTick <= 0 or capSeconds <= 0 or now ~= now or lastTick ~= lastTick then
		return 0
	end
	local dt = now - lastTick
	if dt ~= dt or dt <= 0 or dt == math.huge then
		return 0
	end
	return math.min(dt, capSeconds)
end

-- Whole coins for a stretch at a steady coins/s. The fraction stays in the stretch, not dropped per second.
function Offline.coins(ratePerSecond: number, seconds: number): number
	if type(ratePerSecond) ~= "number" or type(seconds) ~= "number" then
		return 0
	end
	if ratePerSecond <= 0 or seconds <= 0 or ratePerSecond ~= ratePerSecond or seconds ~= seconds then
		return 0
	end
	local total = ratePerSecond * seconds
	if total ~= total or total == math.huge then
		return 0
	end
	return math.floor(total + 1e-9)
end

export type Settle = { seconds: number, coins: number, lastTick: number }

function Offline.settle(lastTick: any, now: number, capSeconds: number, ratePerSecond: number): Settle
	local seconds = Offline.awaySeconds(lastTick, now, capSeconds)
	return {
		seconds = seconds,
		coins = Offline.coins(ratePerSecond, seconds),
		lastTick = if type(now) == "number" then now else 0,
	}
end

return Offline
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Onboard</string>
            <string name="Source"><![CDATA[--!strict
-- The first minute, as one tracker. Guide, the brisket prompt, and the Rookie List
-- stay quiet until this is done. Existing ranchers (guide or tutorial already finished) skip it.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")

local Onboard = {}

Onboard.STEPS = {
	"Spawned",
	"Claimed",
	"First crew",
	"First hire",
	"Tier 2",
	"First trait",
	"Shop seen",
}

function Onboard.skip(data: any): boolean
	local ob = if type(data.onboard) == "table" then data.onboard else {}
	if ob.done == true then
		return true
	end
	if ob.started == true then
		return false
	end
	local guide = data.guide
	if type(guide) == "table" and (guide.done == true or guide.skipped == true) then
		return true
	end
	local tutorial = data.tutorial
	if type(tutorial) == "table" and tutorial.done == true then
		return true
	end
	return false
end

function Onboard.allowPurchase(playSeconds: number, skip: boolean): boolean
	return skip or playSeconds >= Config.Onboarding.promptAt
end

function Onboard.buttonOn(id: string, playSeconds: number, skip: boolean): boolean
	if skip then
		return true
	end
	local at = Config.Onboarding.unlock[id]
	if type(at) ~= "number" then
		return false
	end
	return playSeconds >= at
end

function Onboard.visibleCount(playSeconds: number, skip: boolean): number
	local n = 0
	for id in pairs(Config.Onboarding.unlock) do
		if Onboard.buttonOn(id, playSeconds, skip) then
			n += 1
		end
	end
	return n
end

-- The first shed is priced for the opening minute. After that, the ranch price stands.
function Onboard.tierPrice(listed: number, tier: number, playSeconds: number, skip: boolean): number
	if tier ~= 1 or skip or playSeconds >= Config.Onboarding.shopAt then
		return listed
	end
	return Config.Onboarding.tier2Cost
end

export type Flags = {
	claimed: boolean,
	crew: number,
	tier: number,
	trait: boolean,
	playSeconds: number,
	shopSeen: boolean,
}

function Onboard.reached(flags: Flags): number
	local n = 1
	if flags.claimed then
		n = 2
	end
	if flags.crew >= 1 then
		n = 3
	end
	if flags.crew >= 2 then
		n = 4
	end
	if flags.tier >= 2 then
		n = 5
	end
	if flags.trait then
		n = 6
	end
	if flags.shopSeen or flags.playSeconds >= Config.Onboarding.shopAt then
		n = 7
	end
	return n
end

export type Card = { step: number, total: number, title: string, body: string, target: string }

function Onboard.card(step: number, playSeconds: number): Card?
	if step >= 7 or playSeconds >= Config.Onboarding.shopAt then
		return nil
	end
	if step < 3 then
		return { step = step, total = 7, title = "Pip is on the way", body = "First hire's on the house. He'll mop the pit, and coins start ticking.", target = "hire" }
	elseif step < 4 then
		return { step = step, total = 7, title = "Hire your 2nd critter", body = string.format("A %d coin critter is on the Hiring Line. Your coins already cover it.", Config.Onboarding.hireCost), target = "hire" }
	elseif step < 5 then
		return { step = step, total = 7, title = "Build Ranch Tier 2", body = "The fence and shed add 2 crew slots.", target = "ranchbuild" }
	end
	return { step = step, total = 7, title = "A little smoke", body = "Watch the crew. A trait can catch, and you'll see it happen.", target = "crew" }
end

export type Beat = { t: number, coins: number, note: string }

-- What a brand-new purse does if the player follows the tracker.
-- Pip earns from pipAt. The 25 coin hire happens at the first second they are asked and can pay.
-- The second critter earns secondDelay seconds after that. The first shed costs tier2Cost.
function Onboard.opening(pipRate: number, secondRate: number): { hireAt: number, tierAt: number, beats: { Beat } }
	local coins = Config.START_COINS
	local hired = false
	local hireAt = -1
	local secondAt = -1
	local tierAt = -1
	local beats = {}
	local function snap(t: number, note: string)
		table.insert(beats, { t = t, coins = coins, note = note })
	end
	snap(0, "Spawned on your ranch with " .. tostring(coins) .. " coins. Four buttons: Crew, Hire, Ranch, Settings.")
	for t = 1, 90 do
		local rate = 0
		if t >= Config.Onboarding.pipAt then
			rate += pipRate
		end
		if secondAt >= 0 and t >= secondAt then
			rate += secondRate
		end
		coins += rate
		if t == Config.Onboarding.pipAt then
			snap(t, "Pip is on the pit. +" .. tostring(pipRate) .. "/s.")
		end
		if not hired and t >= Config.Onboarding.askAt and coins >= Config.Onboarding.hireCost then
			coins -= Config.Onboarding.hireCost
			hired = true
			hireAt = t
			secondAt = t + Config.Onboarding.secondDelay
			snap(t, "Hired a " .. tostring(Config.Onboarding.hireCost) .. " coin critter. They start earning in " .. tostring(Config.Onboarding.secondDelay) .. " seconds.")
		end
		if tierAt < 0 and hired and coins >= Config.Onboarding.tier2Cost then
			coins -= Config.Onboarding.tier2Cost
			tierAt = t
			snap(t, "Ranch Tier 2. The shed and two more slots.")
			break
		end
	end
	return { hireAt = hireAt, tierAt = tierAt, beats = beats }
end

return Onboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Partners</string>
            <string name="Source"><![CDATA[--!strict
-- Ranch Partners. The +10% (up to 3) used to count any friend in the server.
-- It now counts partners who are here, and Cheer is a short boost on one critter.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")

local Partners = {}

function Partners.ensure(data: any): { string }
	if type(data.partners) ~= "table" then
		data.partners = {}
	end
	-- Saved as a list of user-id strings so the datastore stays simple.
	local list = {}
	local seen: { [string]: boolean } = {}
	for _, id in ipairs(data.partners) do
		local key = tostring(id)
		if key ~= "" and not seen[key] and #list < Config.Partners.max then
			seen[key] = true
			table.insert(list, key)
		end
	end
	data.partners = list
	if type(data.family) ~= "table" then
		data.family = { on = false, purse = 0 }
	end
	if type(data.family.purse) ~= "number" then
		data.family.purse = 0
	end
	return list
end

function Partners.bonusCount(partnerIds: { string }, online: { [string]: boolean }, familyOthers: number?): number
	local n = 0
	for _, id in ipairs(partnerIds) do
		if online[id] then
			n += 1
		end
	end
	if type(familyOthers) == "number" and familyOthers > n then
		n = familyOthers
	end
	return math.clamp(n, 0, Config.Partners.max)
end

function Partners.mult(count: number): number
	return 1 + Config.Partners.per * math.clamp(count, 0, Config.Partners.max)
end

-- Friends, or anyone when the server is private. Never yourself, never a 4th partner.
function Partners.canAdd(list: { string }, selfId: string, otherId: string, isFriend: boolean, privateServer: boolean): (boolean, string)
	if otherId == "" or otherId == selfId then
		return false, "Pick someone else in the server."
	end
	if not isFriend and not privateServer then
		return false, "Partners are friends, or anyone in a private server."
	end
	for _, id in ipairs(list) do
		if id == otherId then
			return false, "They're already a ranch partner."
		end
	end
	if #list >= Config.Partners.max then
		return false, "You can have 3 ranch partners."
	end
	return true, ""
end

function Partners.add(data: any, otherId: string)
	local list = Partners.ensure(data)
	table.insert(list, otherId)
	data.partners = list
end

function Partners.remove(data: any, otherId: string): boolean
	local list = Partners.ensure(data)
	local nextList = {}
	local found = false
	for _, id in ipairs(list) do
		if id == otherId then
			found = true
		else
			table.insert(nextList, id)
		end
	end
	data.partners = nextList
	return found
end

export type Cheer = { ok: boolean, reason: string, untilT: number? }

function Partners.tryCheer(now: number, cooldownUntil: number?, activeUntil: number?): Cheer
	if type(cooldownUntil) == "number" and now < cooldownUntil then
		return { ok = false, reason = "You can cheer again in a few minutes." }
	end
	if type(activeUntil) == "number" and now < activeUntil then
		return { ok = false, reason = "That critter is already cheered." }
	end
	return { ok = true, reason = "", untilT = now + Config.Partners.cheerSeconds }
end

function Partners.cheerCooldown(now: number): number
	return now + Config.Partners.cheerCooldown
end

function Partners.cheered(untilT: number?, now: number): boolean
	return type(untilT) == "number" and now < untilT
end

-- Family Ranch is the private-server host sharing one tier purse. Crew stays individual.
function Partners.canHostFamily(isPrivate: boolean, isHost: boolean): boolean
	return isPrivate == true and isHost == true
end

-- The +30% in a full family server is for a private server only. A public server never gets it.
function Partners.familyOthers(isPrivate: boolean, familyOn: boolean, others: number): number
	if isPrivate ~= true or familyOn ~= true then
		return 0
	end
	if type(others) ~= "number" or others ~= others or others <= 0 then
		return 0
	end
	return others
end

-- Cheer is for someone else's critter. The owner cheering their own crew is not the action.
function Partners.canCheer(selfId: string, ownerId: string, isPartner: boolean, family: boolean): (boolean, string)
	if ownerId == "" or selfId == ownerId then
		return false, "Cheer is for someone else's critter."
	end
	if family or isPartner then
		return true, ""
	end
	return false, "Cheer is for ranch partners."
end

function Partners.chip(coins: number, purse: number, amount: number): (number?, number?)
	if amount ~= amount or amount <= 0 or amount ~= math.floor(amount) then
		return nil, nil
	end
	if coins < amount then
		return nil, nil
	end
	return coins - amount, purse + amount
end

return Partners
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">PitmasterPath</string>
            <string name="Source"><![CDATA[--!strict
-- 28-day Pitmaster Path: step N unlocks on your Nth distinct play day and is completed by a lifetime stat.
local PitmasterPath = {}

export type State = { claimed: number, playDays: number, lastPlayDay: number }

function PitmasterPath.new(): State
	return { claimed = 0, playDays = 0, lastPlayDay = -1 }
end

-- Call on login and on day rollover. Returns true if a new play day was counted.
function PitmasterPath.registerPlayDay(s: State, today: number): boolean
	if s.lastPlayDay == today then
		return false
	end
	s.lastPlayDay = today
	s.playDays += 1
	return true
end

export type Status = { step: number, done: boolean, unlocked: boolean, progress: number, amount: number, complete: boolean, finished: boolean }

function PitmasterPath.status(s: State, steps: { any }, stats: { [string]: number }): Status
	local step = s.claimed + 1
	local def = steps[step]
	if not def then
		return { step = step, done = false, unlocked = false, progress = 0, amount = 0, complete = false, finished = true }
	end
	local unlocked = s.playDays >= step
	local progress = stats[def.stat] or 0
	return {
		step = step,
		done = false,
		unlocked = unlocked,
		progress = math.min(progress, def.amount),
		amount = def.amount,
		complete = unlocked and progress >= def.amount,
		finished = false,
	}
end

function PitmasterPath.claim(s: State, steps: { any }, stats: { [string]: number }): (boolean, any?)
	local st = PitmasterPath.status(s, steps, stats)
	if not st.complete then
		return false, nil
	end
	s.claimed += 1
	return true, steps[st.step].reward
end

return PitmasterPath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Purse</string>
            <string name="Source"><![CDATA[--!strict
-- Family purse chips. The contributor's coins are saved before the host is credited.
-- A nonce on the host means a retry cannot add the same coins twice.
local Purse = {}

export type Entry = { nonce: string, amount: number, hostId: string }

local function outbox(data: any): { Entry }
	if type(data.purseOut) ~= "table" then
		data.purseOut = {}
	end
	return data.purseOut
end

function Purse.propose(data: any, amount: number, hostId: string, now: number): (Entry?, string)
	if amount ~= amount or amount <= 0 or amount ~= math.floor(amount) then
		return nil, "That amount doesn't fit."
	end
	if type(data.coins) ~= "number" or data.coins < amount then
		return nil, "You don't have that many coins."
	end
	local box = outbox(data)
	local nonce = string.format("%s:%d:%d:%d", hostId, now, amount, #box + 1)
	return { nonce = nonce, amount = amount, hostId = hostId }, ""
end

function Purse.commit(data: any, entry: Entry)
	data.coins -= entry.amount
	table.insert(outbox(data), entry)
end

function Purse.rollback(data: any, nonce: string): boolean
	local box = outbox(data)
	for i, entry in ipairs(box) do
		if entry.nonce == nonce then
			data.coins += entry.amount
			table.remove(box, i)
			return true
		end
	end
	return false
end

function Purse.ack(data: any, nonce: string)
	local box = outbox(data)
	local nextBox = {}
	for _, entry in ipairs(box) do
		if entry.nonce ~= nonce then
			table.insert(nextBox, entry)
		end
	end
	data.purseOut = nextBox
end

function Purse.apply(host: any, entry: Entry): boolean
	if type(host.family) ~= "table" then
		host.family = { on = false, purse = 0, seen = {} }
	end
	if type(host.family.seen) ~= "table" then
		host.family.seen = {}
	end
	if host.family.seen[entry.nonce] == true then
		return false
	end
	host.family.seen[entry.nonce] = true
	host.family.purse = (host.family.purse or 0) + entry.amount
	return true
end

-- saveContributor and saveHost return true when that player's coins are durable.
-- If the contributor's save fails, their coins are put back and the host is not touched.
export type Transfer = { ok: boolean, message: string, credited: boolean }

function Purse.transfer(contributor: any, host: any, amount: number, hostId: string, now: number, saveContributor: () -> boolean, saveHost: () -> boolean): Transfer
	local entry, why = Purse.propose(contributor, amount, hostId, now)
	if not entry then
		return { ok = false, message = why, credited = false }
	end
	Purse.commit(contributor, entry)
	if not saveContributor() then
		Purse.rollback(contributor, entry.nonce)
		return { ok = false, message = "Couldn't save that. Your coins stayed with you.", credited = false }
	end
	local fresh = Purse.apply(host, entry)
	if not saveHost() then
		return { ok = true, message = "Added to the family purse. It will finish saving with the host.", credited = fresh }
	end
	Purse.ack(contributor, entry.nonce)
	saveContributor()
	return { ok = true, message = string.format("Added %d coins to the family purse.", amount), credited = fresh }
end

return Purse
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Rarity</string>
            <string name="Source"><![CDATA[--!strict
-- Weighted rarity rolls. `luck` scales every non-common weight. `u` is a uniform [0,1) number
-- supplied by the caller (server uses Random.new(); tests pass fixed values).
local Rarity = {}

export type RarityDef = { id: string, name: string, weight: number, mult: number, color: string, flex: boolean }

function Rarity.weights(rarities: { RarityDef }, luck: number, maxIndex: number?): { number }
	local out = {}
	local cap = maxIndex or #rarities
	for i, r in ipairs(rarities) do
		if i > cap then
			out[i] = 0
		elseif i == 1 then
			out[i] = r.weight
		else
			out[i] = r.weight * math.max(0, luck)
		end
	end
	return out
end

function Rarity.odds(rarities: { RarityDef }, luck: number, maxIndex: number?): { { id: string, name: string, pct: number } }
	local w = Rarity.weights(rarities, luck, maxIndex)
	local total = 0
	for _, x in ipairs(w) do
		total += x
	end
	local out = {}
	for i, r in ipairs(rarities) do
		table.insert(out, { id = r.id, name = r.name, pct = total > 0 and (w[i] / total * 100) or 0 })
	end
	return out
end

function Rarity.roll(rarities: { RarityDef }, luck: number, maxIndex: number?, u: number): string
	local w = Rarity.weights(rarities, luck, maxIndex)
	local total = 0
	for _, x in ipairs(w) do
		total += x
	end
	local pick = math.clamp(u, 0, 0.999999999) * total
	local acc = 0
	for i, r in ipairs(rarities) do
		acc += w[i]
		if pick < acc then
			return r.id
		end
	end
	return rarities[1].id
end

function Rarity.indexOf(rarities: { RarityDef }, id: string): number
	for i, r in ipairs(rarities) do
		if r.id == id then
			return i
		end
	end
	return 1
end

function Rarity.get(rarities: { RarityDef }, id: string): RarityDef
	return rarities[Rarity.indexOf(rarities, id)]
end

-- Generic weighted pick over { {id, weight} } lists (critters, bandanas).
function Rarity.pickWeighted(list: { any }, u: number): any
	local total = 0
	for _, e in ipairs(list) do
		total += e.weight
	end
	local pick = math.clamp(u, 0, 0.999999999) * total
	local acc = 0
	for _, e in ipairs(list) do
		acc += e.weight
		if pick < acc then
			return e
		end
	end
	return list[#list]
end

function Rarity.weightedOdds(list: { any }): { [string]: number }
	local total = 0
	for _, e in ipairs(list) do
		total += e.weight
	end
	local out = {}
	for _, e in ipairs(list) do
		out[e.id] = total > 0 and e.weight / total * 100 or 0
	end
	return out
end

return Rarity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Token bucket per key. `now` is passed in (server uses os.clock()) so it's testable.
local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Limiter = typeof(setmetatable({} :: { capacity: number, refill: number, buckets: { [any]: { tokens: number, t: number } } }, RateLimiter))

function RateLimiter.new(capacity: number, refillPerSecond: number): Limiter
	return setmetatable({ capacity = capacity, refill = refillPerSecond, buckets = {} }, RateLimiter)
end

function RateLimiter.allow(self: Limiter, key: any, now: number, cost: number?): boolean
	local c = cost or 1
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.capacity, t = now }
		self.buckets[key] = b
	end
	b.tokens = math.min(self.capacity, b.tokens + (now - b.t) * self.refill)
	b.t = now
	if b.tokens >= c then
		b.tokens -= c
		return true
	end
	return false
end

function RateLimiter.forget(self: Limiter, key: any)
	self.buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ReceiptLedger</string>
            <string name="Source"><![CDATA[--!strict
-- Remembers recent PurchaseIds inside the player's saved data so ProcessReceipt is idempotent:
-- if Roblox calls us again for the same purchase, we don't grant twice.
local ReceiptLedger = {}

function ReceiptLedger.has(list: { string }, purchaseId: string): boolean
	for _, id in ipairs(list) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

function ReceiptLedger.add(list: { string }, purchaseId: string, max: number)
	if ReceiptLedger.has(list, purchaseId) then
		return
	end
	table.insert(list, purchaseId)
	while #list > max do
		table.remove(list, 1)
	end
end

return ReceiptLedger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Reconcile</string>
            <string name="Source"><![CDATA[--!strict
-- Deep-fills missing keys from a template so old saves gain new fields after an update.
local Reconcile = {}

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in pairs(v) do
		out[k] = deepCopy(x)
	end
	return out
end
Reconcile.deepCopy = deepCopy

function Reconcile.fill(target: any, template: any): any
	if type(target) ~= "table" then
		return deepCopy(template)
	end
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil then
			Reconcile.fill(target[k], v)
		end
	end
	return target
end

return Reconcile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Restock</string>
            <string name="Source"><![CDATA[--!strict
-- Sauce shop restocks every RESTOCK_SECONDS. Stock is a deterministic function of the window,
-- so every server shows the same shelf and it survives server restarts.
local Restock = {}

local M = 2147483647

local function prng(seed: number)
	local x = (seed % (M - 1)) + 1
	return function(): number
		x = (x * 48271) % M
		return x / M
	end
end

function Restock.window(now: number, period: number): number
	return math.floor(now / period)
end

function Restock.nextIn(now: number, period: number): number
	return period - (now % period)
end

export type Shelf = { { id: string, qty: number } }

function Restock.shelf(window: number, sauces: { [string]: any }, order: { string }, slots: number): Shelf
	local rnd = prng(window * 7919 + 17)
	local pool = {}
	for _, id in ipairs(order) do
		local s = sauces[id]
		if s and s.weight > 0 then
			table.insert(pool, { id = id, weight = s.weight, maxStock = s.maxStock })
		end
	end
	local shelf = {}
	for _ = 1, math.min(slots, #pool) do
		local total = 0
		for _, e in ipairs(pool) do
			total += e.weight
		end
		local pick = rnd() * total
		local acc = 0
		for i, e in ipairs(pool) do
			acc += e.weight
			if pick < acc or i == #pool then
				table.insert(shelf, { id = e.id, qty = 1 + math.floor(rnd() * e.maxStock) % e.maxStock })
				table.remove(pool, i)
				break
			end
		end
	end
	return shelf
end

-- Chance a sauce shows up in a given restock (for the "restock odds" panel), measured over
-- `samples` real restock windows (the exact same function the shop uses).
function Restock.appearOdds(sauces: { [string]: any }, order: { string }, slots: number, samples: number?): { [string]: number }
	local n = samples or 2000
	local counts: { [string]: number } = {}
	for w = 1, n do
		for _, e in ipairs(Restock.shelf(w, sauces, order, slots)) do
			counts[e.id] = (counts[e.id] or 0) + 1
		end
	end
	local out = {}
	for _, id in ipairs(order) do
		out[id] = (counts[id] or 0) / n * 100
	end
	return out
end

return Restock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Rookie</string>
            <string name="Source"><![CDATA[--!strict
-- Unc Hank's Rookie List: five quick goals that walk a brand-new pitmaster through the first
-- five minutes (after the one-button first brisket). Each goal is a lifetime stat, so it can't be
-- lost, and the client shows an arrow to where the goal happens. Pure logic, no Roblox APIs.
local Rookie = {}

export type State = { claimed: number, skipped: boolean?, resumed: boolean? }

function Rookie.new(): State
	return { claimed = 0 }
end

export type Status = {
	step: number, -- 1-based index of the current goal (total + 1 when finished)
	total: number,
	finished: boolean,
	progress: number,
	amount: number,
	id: string?,
	label: string?,
	target: string?,
	reward: any?,
	skipped: boolean, -- tucked away (by the player, or quietly for veterans) and not done yet
	done: boolean, -- all goals claimed, finish reward earned
}

function Rookie.status(s: State, steps: { any }, stats: { [string]: number }): Status
	local step = s.claimed + 1
	local def = steps[step]
	local done = s.claimed >= #steps
	if s.skipped or not def then
		return { step = #steps + 1, total = #steps, finished = true, progress = 0, amount = 0, skipped = s.skipped == true and not done, done = done }
	end
	local progress = math.min(stats[def.stat] or 0, def.amount)
	return {
		step = step,
		total = #steps,
		finished = false,
		progress = progress,
		amount = def.amount,
		id = def.id,
		label = def.label,
		target = def.target,
		reward = def.reward,
		skipped = false,
		done = false,
	}
end

-- Claims every goal that is already met, in order. Returns the list of goals just claimed.
-- (Usually zero or one, but a fast player can finish two in one action.)
function Rookie.advance(s: State, steps: { any }, stats: { [string]: number }): { any }
	local claimed = {}
	if s.skipped then
		return claimed
	end
	while true do
		local def = steps[s.claimed + 1]
		if not def or (stats[def.stat] or 0) < def.amount then
			break
		end
		s.claimed += 1
		table.insert(claimed, def)
	end
	return claimed
end

-- Veterans from before the list existed skip it quietly (they already know the loop), unless
-- they brought it back themselves.
function Rookie.shouldSkip(s: State, tutorialDone: boolean, stats: { [string]: number }, veteranServes: number): boolean
	return s.claimed == 0 and not s.skipped and not s.resumed and tutorialDone and (stats.served or 0) >= veteranServes
end

-- The player taps Skip (after a confirm). A finished list can't be skipped.
function Rookie.skip(s: State, steps: { any }): boolean
	if s.skipped or s.claimed >= #steps then
		return false
	end
	s.skipped = true
	return true
end

-- Bring a skipped list back (Settings > Game). Progress is lifetime stats, so goals done in the
-- meantime are claimed on the next check, and the finish reward can still be earned.
function Rookie.resume(s: State, steps: { any }): boolean
	if not s.skipped or s.claimed >= #steps then
		return false
	end
	s.skipped = false
	s.resumed = true
	return true
end

-- Short form for the small card: "Rookie of the Ranch Bandana + title + 250 🪙".
function Rookie.rewardShort(r: any, cosmeticName: string?): string
	local parts = {}
	if r.cosmetic then
		table.insert(parts, cosmeticName or r.cosmetic)
	end
	if r.title then
		table.insert(parts, "title")
	end
	if r.coins and r.coins > 0 then
		table.insert(parts, r.coins .. " 🪙")
	end
	return table.concat(parts, " + ")
end

-- Plain words for the finish reward, used in the skip confirm and in Settings.
function Rookie.rewardText(r: any, cosmeticName: string?): string
	local parts = {}
	if r.cosmetic then
		table.insert(parts, cosmeticName or r.cosmetic)
	end
	if r.title then
		table.insert(parts, 'the "' .. r.title .. '" title')
	end
	if r.coins and r.coins > 0 then
		table.insert(parts, "+" .. r.coins .. " 🪙")
	end
	if #parts <= 1 then
		return parts[1] or ""
	end
	return table.concat(parts, ", ", 1, #parts - 1) .. " and " .. parts[#parts]
end

return Rookie
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">SeasonPass</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SeasonPass.luau — the Smokehouse Pass (pure logic, unit-tested with Lune).

	  * A season lasts cfg.lengthDays. Season n starts at cfg.epochDay + (n-1) * lengthDays.
	  * Season XP comes from stats you already earn (served, cooks, flips...) counted from the
	    moment the season started for you, plus dailyXP for each day you visit, plus bought or
	    member tier skips. Nothing extra to grind and nothing random.
	  * Free track: a reward every few tiers. Paid track: a reward every tier. Both are looks or
	    titles only. Buying the paid track hands over every paid reward you've already reached.
	  * Tiers you reach are yours forever; the save just remembers how far you've claimed.
]]
local SeasonPass = {}

export type State = {
	id: string,
	base: { [string]: number },
	days: number,
	lastDay: number,
	skips: number,
	paid: boolean,
	freeClaimed: number,
	paidClaimed: number,
}

function SeasonPass.new(): State
	return { id = "", base = {}, days = 0, lastDay = -1, skips = 0, paid = false, freeClaimed = 0, paidClaimed = 0 }
end

export type Info = { index: number, def: any?, startDay: number, endDay: number }

-- Which season is it on `day`? def is nil before the first season or after the last one we've made.
function SeasonPass.seasonAt(day: number, cfg: any): Info
	local index = math.floor((day - cfg.epochDay) / cfg.lengthDays) + 1
	local startDay = cfg.epochDay + (index - 1) * cfg.lengthDays
	local def = if index >= 1 then cfg.seasons[index] else nil
	return { index = index, def = def, startDay = startDay, endDay = startDay + cfg.lengthDays - 1 }
end

function SeasonPass.maxTier(def: any): number
	return #def.paid
end

-- Keep the save in step with the current season and count today's visit.
-- Returns true when a new season started for this player (state was reset).
function SeasonPass.sync(s: State, seasonId: string, stats: { [string]: number }, cfg: any, today: number): boolean
	local reset = false
	if s.id ~= seasonId then
		s.id = seasonId
		s.base = {}
		for stat in pairs(cfg.xp) do
			s.base[stat] = stats[stat] or 0
		end
		s.days = 0
		s.lastDay = -1
		s.skips = 0
		s.paid = false
		s.freeClaimed = 0
		s.paidClaimed = 0
		reset = true
	end
	if s.lastDay ~= today then
		s.lastDay = today
		s.days += 1
	end
	return reset
end

function SeasonPass.xp(s: State, stats: { [string]: number }, cfg: any): number
	local total = s.days * cfg.dailyXP + s.skips * cfg.tierXP
	for stat, w in pairs(cfg.xp) do
		total += math.max(0, (stats[stat] or 0) - (s.base[stat] or 0)) * w
	end
	return total
end

function SeasonPass.tier(xp: number, def: any, cfg: any): number
	return math.min(math.floor(xp / cfg.tierXP), SeasonPass.maxTier(def))
end

-- XP into the current tier and XP needed for the next one (0, 0 at the top).
function SeasonPass.progress(xp: number, def: any, cfg: any): (number, number)
	if SeasonPass.tier(xp, def, cfg) >= SeasonPass.maxTier(def) then
		return 0, 0
	end
	return xp % cfg.tierXP, cfg.tierXP
end

-- Can `n` tier skips be used without going past the top tier?
function SeasonPass.canSkip(s: State, stats: { [string]: number }, def: any, cfg: any, n: number): boolean
	local cur = SeasonPass.tier(SeasonPass.xp(s, stats, cfg), def, cfg)
	return cur + n <= SeasonPass.maxTier(def)
end

-- Adds a skip that lands on the start of the next tier (any partial progress is kept on top).
function SeasonPass.addSkips(s: State, n: number)
	s.skips += n
end

export type Reward = { track: string, tier: number, reward: any }

-- Hand out every reward reached but not yet claimed. Mutates the claimed counters.
function SeasonPass.claim(s: State, stats: { [string]: number }, def: any, cfg: any): { Reward }
	local out = {}
	local t = SeasonPass.tier(SeasonPass.xp(s, stats, cfg), def, cfg)
	for i = s.freeClaimed + 1, t do
		local r = def.free[i]
		if r then
			table.insert(out, { track = "free", tier = i, reward = r })
		end
	end
	s.freeClaimed = math.max(s.freeClaimed, t)
	if s.paid then
		for i = s.paidClaimed + 1, t do
			table.insert(out, { track = "paid", tier = i, reward = def.paid[i] })
		end
		s.paidClaimed = math.max(s.paidClaimed, t)
	end
	return out
end

return SeasonPass
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Session locking for DataStore records shaped { lock = {jobId, time}?, data = {...} }.
	A server may only write a record it holds the lock for. Locks are refreshed on every autosave;
	a lock older than `staleAfter` seconds is treated as abandoned (crashed server) and can be taken.
	These are the pure transform helpers used inside DataStore:UpdateAsync.
]]
local SessionLock = {}

export type Record = { lock: { jobId: string, time: number }?, data: any? }

-- A different server's lock is still live. Missing, non-numeric, NaN, or far-future
-- timestamps are not live: a previous build (or a crashed server) must not block joins forever.
-- `now - lock.time` used to throw when `time` wasn't a number, which aborted the DataStore
-- transform and left the player with no profile.
function SessionLock.heldByOther(lock: any, jobId: string, now: number, staleAfter: number): boolean
	if type(lock) ~= "table" then
		return false
	end
	local owner = lock.jobId
	if type(owner) ~= "string" or owner == jobId then
		return false
	end
	local t = lock.time
	if type(t) ~= "number" or t ~= t then
		return false
	end
	if t > now + 120 then
		return false
	end
	return (now - t) < staleAfter
end

-- Returns (newRecord or nil to cancel, status).
-- `force` takes a lock another server still holds. DataService does this after a short wait
-- so a dead server from the previous version can't keep the ranch closed.
function SessionLock.acquire(old: any, jobId: string, now: number, staleAfter: number, force: boolean?): (Record?, string)
	local rec: Record = if type(old) == "table" then old else { data = nil }
	local lock = rec.lock
	if not force and SessionLock.heldByOther(lock, jobId, now, staleAfter) then
		return nil, "locked"
	end
	local stolen = type(lock) == "table" and lock.jobId ~= jobId
	rec.lock = { jobId = jobId, time = now }
	return rec, if stolen then "stale-taken" else "acquired"
end

-- Only the server that holds the lock may write. A record with no lock was released (the
-- player left, or another server already loaded, played and released it), so a late write from
-- us would overwrite newer progress and leave a phantom lock behind: refuse it.
function SessionLock.canWrite(old: any, jobId: string): boolean
	if old == nil then
		return true
	end
	if type(old) ~= "table" then
		return false
	end
	local lock = old.lock
	return type(lock) == "table" and lock.jobId == jobId
end

-- Transform for saves. `release` clears the lock (player left / server closing).
function SessionLock.save(old: Record?, jobId: string, now: number, data: any, release: boolean): (Record?, string)
	if not SessionLock.canWrite(old, jobId) then
		return nil, "lost-lock"
	end
	local rec: Record = { data = data, lock = nil }
	if not release then
		rec.lock = { jobId = jobId, time = now }
	end
	return rec, "saved"
end

return SessionLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ShopCatalog</string>
            <string name="Source"><![CDATA[--!strict
-- What a shop stand shows, separate from whether Roblox will take the payment.
-- A missing or zero product id used to drop the card entirely, so a live server
-- with unpublished ids opened an empty Outfitters. The card always stays. The
-- button is the only thing that changes.
local ShopCatalog = {}

export type State = "owned" | "buy" | "studio" | "soon"

function ShopCatalog.saleState(id: any, studio: boolean, owned: boolean): (State, boolean)
	if owned then
		return "owned", false
	end
	if type(id) == "number" and id > 0 and id == math.floor(id) then
		return "buy", true
	end
	if studio then
		return "studio", true
	end
	return "soon", false
end

function ShopCatalog.robuxLabel(state: string, price: number): string
	if state == "owned" then
		return "Owned"
	elseif state == "buy" then
		return "Buy  R$ " .. tostring(price)
	elseif state == "studio" then
		return "Studio test (free)"
	end
	return "Coming soon"
end

-- Every pass and every developer product. An id of 0 does not remove the row.
function ShopCatalog.robuxKeys(monetization: any): { { key: string, kind: string } }
	local out = {}
	for key in pairs(monetization.Passes) do
		table.insert(out, { key = key, kind = "pass" })
	end
	for key in pairs(monetization.Products) do
		table.insert(out, { key = key, kind = "product" })
	end
	table.sort(out, function(a, b)
		if a.kind ~= b.kind then
			return a.kind < b.kind
		end
		return a.key < b.key
	end)
	return out
end

export type SauceRow = { id: string, qty: number }

-- The restock shelf when it has bottles. If the shelf is missing or empty,
-- list every sauce so the shack cannot open blank.
function ShopCatalog.sauceRows(shelf: { SauceRow }?, order: { string }): { SauceRow }
	if shelf and #shelf > 0 then
		return shelf
	end
	local rows = {}
	for _, id in ipairs(order) do
		table.insert(rows, { id = id, qty = 1 })
	end
	return rows
end

return ShopCatalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Staff</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Ranch crew. Coin-bought hands who cook, carry and serve.
	Jimothy the Waiter (the AutoServe pass) is not one of these slots. He still
	serves on his own timer. Owning the pass also shortens the crew's walk
	between jobs, so the pass stays a boost instead of a second copy of the crew.
	The first grill and the first smoker stay the player's. Crew uses the rest.
]]
local Economy = if script ~= nil and script.Parent ~= nil then require(script.Parent.Economy) else require("./Economy")
local FreeGift = if script ~= nil and script.Parent ~= nil then require(script.Parent.FreeGift) else require("./FreeGift")

local Staff = {}

Staff.MAX = 5

export type Hand = {
	id: string,
	name: string,
	species: string,
	role: string,
	title: string,
	blurb: string,
	lines: { string },
}

export type Employee = {
	id: string,
	name: string,
	species: string,
	role: string,
	speed: number,
	capacity: number,
	quality: number,
}

export type World = {
	coins: number,
	cooler: number,
	coolerMax: number,
	customers: number,
	openGrill: number,
	openSmoker: number,
	done: number,
	burgerCost: number,
	linkCost: number,
}

export type Decision = {
	kind: string,
	meat: string?,
	count: number,
}

Staff.HANDS = {
	{
		id = "pip",
		name = "Pip",
		species = "raccoon",
		role = "grill",
		title = "Grill hand",
		blurb = "Starts burgers on your extra grills, then carries plates and serves when the grill is busy.",
		lines = {
			"Patties are my whole personality.",
			"I can hear that grill from the creek.",
			"You flip. I'll mind the patties.",
		},
	},
	{
		id = "dottie",
		name = "Dottie",
		species = "armadillo",
		role = "pit",
		title = "Pit hand",
		blurb = "Keeps hot links moving on your extra smokers. Low and slow, on purpose.",
		lines = {
			"Low and slow. That's the whole job.",
			"Hot links are in. Don't rush a shell.",
			"The pit's hot. I'm not.",
		},
	},
	{
		id = "mango",
		name = "Mango",
		species = "clapcat",
		role = "floor",
		title = "Floor",
		blurb = "Serves the line and carries finished plates. Doesn't start cooks.",
		lines = {
			"Order up. I clapped for it.",
			"Table's hungry. I'm on it.",
			"I serve faster than I nap. That's new.",
		},
	},
	{
		id = "biscuit",
		name = "Biscuit",
		species = "bellyrubpup",
		role = "grill",
		title = "Grill hand",
		blurb = "Another burger station, plus a very serious tail.",
		lines = {
			"Belly rubs after the lunch rush.",
			"I brought the buns.",
			"Who's a good pitmaster? You are.",
		},
	},
	{
		id = "tumble",
		name = "Tumble",
		species = "hornedtoad",
		role = "pit",
		title = "Pit hand",
		blurb = "Fits under the barrel and keeps another smoker fed.",
		lines = {
			"Spikes out. Smoker loaded.",
			"I fit right under the barrel.",
			"Hot link express, coming through.",
		},
	},
} :: { Hand }

-- First hand is a short goal. Later hands cost more than a casual burger loop.
Staff.COSTS = { 250, 900, 2800, 8000, 22000 }

local UPGRADE_BASE: { [string]: number } = { speed = 180, capacity = 220, quality = 260 }

function Staff.hand(id: string): Hand?
	for _, h in ipairs(Staff.HANDS) do
		if h.id == id then
			return h
		end
	end
	return nil
end

function Staff.slots(pitLevel: number): number
	local level = math.clamp(math.floor(pitLevel), 1, #Staff.HANDS)
	return level
end

function Staff.preview(have: number): Hand?
	return Staff.HANDS[have + 1]
end

-- The next hand who is not already on the roster, in catalog order.
-- Indexing by roster length hired a duplicate when an earlier id had been dropped.
function Staff.nextHand(roster: { any }): Hand?
	local seen: { [string]: boolean } = {}
	for _, e in ipairs(roster) do
		if type(e) == "table" and type(e.id) == "string" then
			seen[e.id] = true
		end
	end
	for _, h in ipairs(Staff.HANDS) do
		if not seen[h.id] then
			return h
		end
	end
	return nil
end

local function finiteNumber(n: any): number?
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
		return nil
	end
	return n
end

-- Coins left after paying `cost`, or nil when the spend is not allowed.
-- NaN, infinity, a non-positive cost, and a balance that would go below zero all refuse.
function Staff.takeCoins(coins: any, cost: any): number?
	local have = finiteNumber(coins)
	local price = finiteNumber(cost)
	if not have or not price or price <= 0 or have < price then
		return nil
	end
	local left = have - price
	if left ~= left or left < 0 then
		return nil
	end
	return left
end

export type HireOutcome = {
	ok: boolean,
	reason: string,
	cost: number?,
	coins: number,
	employee: Employee?,
}

function Staff.hireMessage(reason: string, cost: number?): string
	if reason == "coins" and cost then
		return string.format("You need %d coins.", cost)
	elseif reason == "slots" then
		return "Upgrade your pit to hire another hand."
	elseif reason == "full" then
		return "The crew is full."
	end
	return "You can't hire right now."
end

-- Does not mutate `roster`. The caller inserts `employee` only after this returns ok.
function Staff.tryHire(roster: { any }, pitLevel: any, coins: any): HireOutcome
	local level = finiteNumber(pitLevel) or 1
	local slots = Staff.slots(level)
	if slots ~= slots then
		slots = 1
	end
	if #roster >= slots then
		return { ok = false, reason = "slots", coins = if finiteNumber(coins) then coins :: number else 0 }
	end
	local hand = Staff.nextHand(roster)
	local cost = Staff.hireCost(#roster)
	if not hand or not cost or Staff.find(roster :: { Employee }, hand.id) then
		return { ok = false, reason = "full", coins = if finiteNumber(coins) then coins :: number else 0 }
	end
	local left = Staff.takeCoins(coins, cost)
	if not left then
		return { ok = false, reason = "coins", cost = cost, coins = if finiteNumber(coins) then coins :: number else 0 }
	end
	return {
		ok = true,
		reason = "ok",
		cost = cost,
		coins = left,
		employee = {
			id = hand.id,
			name = hand.name,
			species = hand.species,
			role = hand.role,
			speed = 1,
			capacity = 1,
			quality = 1,
		},
	}
end

export type UpgradeOutcome = {
	ok: boolean,
	reason: string,
	cost: number?,
	coins: number,
	stat: string?,
	from: number?,
	level: number?,
}

function Staff.upgradeMessage(reason: string, cost: number?): string
	if reason == "coins" and cost then
		return string.format("You need %d coins.", cost)
	elseif reason == "max" then
		return "That's as high as it goes."
	elseif reason == "missing" then
		return "That hand isn't on the crew."
	end
	return "Bad request."
end

-- Does not mutate the employee. `from` is the level this price was quoted for,
-- so a second in-flight upgrade of the same level can be refused.
function Staff.tryUpgrade(roster: { any }, id: any, stat: any, coins: any): UpgradeOutcome
	local balance = if finiteNumber(coins) then coins :: number else 0
	if type(id) ~= "string" or #id > 32 or (stat ~= "speed" and stat ~= "capacity" and stat ~= "quality") then
		return { ok = false, reason = "bad", coins = balance }
	end
	local e = Staff.find(roster :: { Employee }, id)
	if not e then
		return { ok = false, reason = "missing", coins = balance }
	end
	local from = finiteNumber((e :: any)[stat])
	if not from then
		return { ok = false, reason = "max", coins = balance }
	end
	local cost = Staff.upgradeCost(stat, from)
	if not cost then
		return { ok = false, reason = "max", coins = balance }
	end
	local left = Staff.takeCoins(coins, cost)
	if not left then
		return { ok = false, reason = "coins", cost = cost, coins = balance }
	end
	return { ok = true, reason = "ok", cost = cost, coins = left, stat = stat, from = from, level = from + 1 }
end

function Staff.hireCost(have: number): number?
	return Staff.COSTS[have + 1]
end

function Staff.template(have: number): Employee?
	local h = Staff.preview(have)
	if not h then
		return nil
	end
	return {
		id = h.id,
		name = h.name,
		species = h.species,
		role = h.role,
		speed = 1,
		capacity = 1,
		quality = 1,
	}
end

function Staff.find(roster: { Employee }, id: string): Employee?
	for _, e in ipairs(roster) do
		if e.id == id then
			return e
		end
	end
	return nil
end

function Staff.upgradeCost(stat: string, level: number): number?
	local base = UPGRADE_BASE[stat]
	if not base or level >= Staff.MAX or level < 1 then
		return nil
	end
	return math.floor(base * (level ^ 1.4))
end

-- Seconds between jobs. The waiter pass shortens the walk. It does not cook for them.
function Staff.interval(speedLevel: number, waiterPass: boolean): number
	local level = math.clamp(math.floor(speedLevel), 1, Staff.MAX)
	local seconds = 16 * (0.84 ^ (level - 1))
	if waiterPass then
		seconds *= 0.72
	end
	return seconds
end

function Staff.carry(capacityLevel: number): number
	return math.clamp(math.floor(capacityLevel), 1, Staff.MAX)
end

function Staff.qualityLuck(qualityLevel: number): number
	local level = math.clamp(math.floor(qualityLevel), 1, Staff.MAX)
	return 1 + 0.06 * (level - 1)
end

-- Extra plate value when this hand is the one serving. Caps at +20%.
function Staff.qualityTip(qualityLevel: number): number
	local level = math.clamp(math.floor(qualityLevel), 1, Staff.MAX)
	return 1 + 0.05 * (level - 1)
end

function Staff.line(id: string, index: number): string
	local h = Staff.hand(id)
	local lines = if h then h.lines else { "On it!" }
	local i = ((math.floor(index) - 1) % #lines) + 1
	return lines[i]
end

-- What a hand starts on their own. Grill hands make burgers, pit hands make hot links.
-- Event cuts (turkey leg, holiday ham) stay the player's to smoke and carry to the potluck.
-- A hand never starts one, so they can't auto-share it or cash the daily reward.
function Staff.stationMeat(role: string): string?
	if role == "grill" then
		return "burger"
	elseif role == "pit" then
		return "hotlink"
	end
	return nil
end

-- Cooks fill open extra stations first. Floor serves first. Nobody spends coins they don't have.
function Staff.decide(e: Employee, w: World): Decision?
	local cap = Staff.carry(e.capacity)
	local function serve(): Decision?
		if w.customers > 0 and w.cooler > 0 then
			return { kind = "serve", count = math.min(cap, w.customers, w.cooler) }
		end
		return nil
	end
	local function collect(): Decision?
		if w.done > 0 and w.cooler < w.coolerMax then
			return { kind = "collect", count = math.min(cap, w.done, w.coolerMax - w.cooler) }
		end
		return nil
	end
	if e.role == "floor" then
		return serve() or collect()
	end
	local meat = Staff.stationMeat(e.role)
	if not meat then
		return collect() or serve()
	end
	local open = if meat == "burger" then w.openGrill else w.openSmoker
	local cost = if meat == "burger" then w.burgerCost else w.linkCost
	if open > 0 and cost > 0 and w.coins >= cost then
		local n = math.min(cap, open, math.floor(w.coins / cost))
		if n > 0 then
			return { kind = "cook", meat = meat, count = n }
		end
	end
	return collect() or serve()
end

-- Expected profit per second once a hand is in a steady cook loop.
-- Floor hands don't start cooks, so their cook contribution is 0.
-- The HUD's +/s number is the real trailing earn window, not this estimate.
function Staff.cookProfitPerSecond(e: Employee, meat: any, pitSpeed: number, rarityMult: number, rankMult: number, waiterPass: boolean): number
	if e.role == "floor" then
		return 0
	end
	local speed = math.max(0.05, pitSpeed)
	local cycle = Staff.interval(e.speed, waiterPass) + (meat.cookTime / speed)
	if cycle <= 0 then
		return 0
	end
	local unit = meat.price * rarityMult * rankMult * Staff.qualityTip(e.quality) - Economy.rawCost(meat, rankMult)
	if unit < 0 then
		unit = 0
	end
	return Staff.carry(e.capacity) * unit / cycle
end

function Staff.serveRate(e: Employee, waiterPass: boolean): number
	return Staff.carry(e.capacity) / Staff.interval(e.speed, waiterPass)
end

local function clampLevel(n: any): number
	local v = tonumber(n) or 1
	return math.clamp(math.floor(v), 1, Staff.MAX)
end

-- Drops unknown or duplicate ids and fills missing levels. Old saves load.
function Staff.normalize(data: any)
	if type(data.staff) ~= "table" then
		data.staff = { roster = {} }
	end
	if type(data.staff.roster) ~= "table" then
		data.staff.roster = {}
	end
	local clean: { Employee } = {}
	local seen: { [string]: boolean } = {}
	for _, e in ipairs(data.staff.roster) do
		if type(e) == "table" and type(e.id) == "string" and not seen[e.id] then
			local h = Staff.hand(e.id)
			if h then
				seen[e.id] = true
				table.insert(clean, {
					id = h.id,
					name = h.name,
					species = h.species,
					role = h.role,
					speed = clampLevel(e.speed),
					capacity = clampLevel(e.capacity),
					quality = clampLevel(e.quality),
				})
			end
		end
	end
	data.staff.roster = clean
	data.freeGift = FreeGift.normalize(data.freeGift, nil)
end

function Staff.signature(roster: { any }, slots: number): string
	local parts = {}
	for i, e in ipairs(roster) do
		if i <= slots and type(e) == "table" then
			table.insert(parts, tostring(e.id))
		end
	end
	return table.concat(parts, ",")
end

function Staff.appearance(entry: any, critters: { any }): any?
	for _, c in ipairs(critters) do
		if c.id == entry.species then
			local copy = table.clone(c)
			copy.staff = true
			copy.scale = (c.scale or 1) * 0.92
			return copy
		end
	end
	return nil
end

return Staff
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Storefront</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Storefront.luau — can this player buy this item right now? (pure logic, unit-tested)
	Every "no" comes with a calm, plain reason. No timers, no pressure.
]]
local Storefront = {}

export type Ctx = {
	owned: { [string]: boolean },
	featured: { [string]: boolean },
	events: { [string]: boolean }, -- which date-gated event shops are open ("turkeyday", "holiday")
	onceBought: { [string]: boolean },
	cooking: boolean,
	seasonActive: boolean,
	seasonPaid: boolean,
	canSkip: (n: number) -> boolean,
}

function Storefront.ownedCount(owned: { [string]: boolean }, grants: { string }?): number
	local n = 0
	for _, id in ipairs(grants or {}) do
		if owned[id] then
			n += 1
		end
	end
	return n
end

function Storefront.ownsAll(owned: { [string]: boolean }, grants: { string }?): boolean
	return grants ~= nil and #grants > 0 and Storefront.ownedCount(owned, grants) == #grants
end

-- Calm "not right now" lines for event looks bought outside their dates.
Storefront.EVENT_CLOSED = {
	turkeyday = "The Turkey Day looks are on sale during Thanksgiving week. They come back next year.",
	holiday = "The Holiday looks are on sale from Dec 19 to Jan 1. They come back next year.",
} :: { [string]: string }

-- nil if this product isn't event-gated or its event is on; otherwise the calm reason.
function Storefront.eventClosed(p: any, events: { [string]: boolean }): string?
	if p.event and not events[p.event] then
		return Storefront.EVENT_CLOSED[p.event] or "That one's only on sale during its event. It comes back next year."
	end
	return nil
end

function Storefront.canBuy(key: string, p: any, c: Ctx): (boolean, string?)
	if p.rotation and not c.featured[key] then
		return false, "That one's not in this week's rotation. It'll be back!"
	end
	local closed = Storefront.eventClosed(p, c.events)
	if closed then
		return false, closed
	end
	if p.once and c.onceBought[key] then
		return false, "You already picked up this one-time pack. Thanks!"
	end
	if (p.kind == "cosmetic" or p.kind == "bundle") and Storefront.ownsAll(c.owned, p.grants) then
		return false, "You already own everything in this."
	end
	if p.kind == "finish" and not c.cooking then
		return false, "Nothing is cooking right now."
	end
	if p.kind == "season" or p.kind == "tierskip" then
		if not c.seasonActive then
			return false, "The next Smokehouse Pass season is still being smoked up."
		end
		if p.kind == "season" and c.seasonPaid then
			return false, "You already have this season's Smokehouse Pass."
		end
		if p.kind == "tierskip" and not c.canSkip(p.count or 1) then
			return false, "That would go past the top tier."
		end
	end
	return true, nil
end

-- Pit Crew Club monthly look: a fixed cycle by calendar month, so everyone gets the same one.
function Storefront.clubLook(looks: { string }, year: number, month: number): string
	return looks[((year * 12 + month - 1) % #looks) + 1]
end

function Storefront.monthKey(year: number, month: number): number
	return year * 12 + month - 1
end

return Storefront
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Streak</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Forgiving daily streak.
	  * Claim once per (Texas) day.
	  * Miss exactly one day? Your one free miss for the week covers it automatically.
	  * Miss more? You drop back to the first day of your current 7-day week, never to zero.
]]
local Streak = {}

export type State = { lastDay: number, count: number, best: number, freeMissWeek: number }
export type Result = { ok: boolean, count: number, cycleDay: number, week: number, usedFreeMiss: boolean, softReset: boolean }

local function weekOf(day: number): number
	return math.floor((day + 3) / 7)
end

function Streak.new(): State
	return { lastDay = -1, count = 0, best = 0, freeMissWeek = -1 }
end

-- True only when a claim would actually pay. A clock that moved backwards used to
-- light the button, then refuse and rewrite lastDay.
function Streak.canClaim(s: State, today: number): boolean
	return Streak.forecast(s, today).ok
end

-- What claim would do, without changing `s`. The daily cards use this count so a
-- soft reset doesn't show next week's payout.
function Streak.forecast(s: State, today: number): Result
	local copy: State = {
		lastDay = s.lastDay,
		count = s.count,
		best = s.best,
		freeMissWeek = s.freeMissWeek,
	}
	return Streak.claim(copy, today)
end

-- If the saved day is in the future, park it on today without paying again.
-- Called with the server's day number (os.time), never a client clock.
function Streak.healClock(s: State, today: number): boolean
	if type(today) ~= "number" or today ~= today then
		return false
	end
	local day = math.floor(today)
	if type(s.lastDay) ~= "number" or s.lastDay ~= s.lastDay then
		s.lastDay = -1
		return true
	end
	if s.lastDay > day then
		s.lastDay = day
		return true
	end
	return false
end

function Streak.claim(s: State, today: number): Result
	-- A brand-new streak stores lastDay = -1. That is also a real day number, so
	-- "already claimed" is lastDay == today only after the streak has started.
	local neverClaimed = s.lastDay < 0 and s.count <= 0
	if not neverClaimed and s.lastDay == today then
		return { ok = false, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = false, softReset = false }
	end
	local usedFreeMiss, softReset = false, false
	local gap = today - s.lastDay
	if s.lastDay < 0 or s.count <= 0 then
		s.count = 1
	elseif gap == 1 then
		s.count += 1
	elseif gap == 2 and s.freeMissWeek ~= weekOf(today) then
		s.count += 1
		s.freeMissWeek = weekOf(today)
		usedFreeMiss = true
	elseif gap <= 0 then
		-- clock went backwards; treat as same streak, no reward abuse
		s.lastDay = today
		return { ok = false, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = false, softReset = false }
	else
		-- soft reset to the start of the current week of the streak
		s.count = s.count - ((s.count - 1) % 7)
		softReset = true
	end
	s.lastDay = today
	s.best = math.max(s.best, s.count)
	return { ok = true, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = usedFreeMiss, softReset = softReset }
end

-- Coins scale gently with how many weeks you've kept it going (caps at week 4).
function Streak.rewardScale(count: number): number
	local tier = math.clamp(math.ceil(math.max(1, count) / 7), 1, 4)
	return 1 + 0.5 * (tier - 1)
end

-- Matches GameService: streak scale is floored, then the rank multiplier is floored again.
function Streak.payout(base: number, count: number, rankMult: number): number
	local scaled = math.floor((base or 0) * Streak.rewardScale(count))
	return math.floor(scaled * rankMult)
end

return Streak
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">TimeUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Pure time helpers (no Roblox APIs). `now` is unix seconds (os.time()).
local TimeUtil = {}

function TimeUtil.dayNumber(now: number, offsetHours: number): number
	return math.floor((now + offsetHours * 3600) / 86400)
end

-- 1 = Sunday ... 7 = Saturday. Day 0 (1970-01-01) was a Thursday.
function TimeUtil.weekday(now: number, offsetHours: number): number
	local day = TimeUtil.dayNumber(now, offsetHours)
	return ((day + 4) % 7) + 1
end

-- Monday-start week index for a day number.
function TimeUtil.weekOfDay(day: number): number
	return math.floor((day + 3) / 7)
end

function TimeUtil.weekNumber(now: number, offsetHours: number): number
	return TimeUtil.weekOfDay(TimeUtil.dayNumber(now, offsetHours))
end

-- Month 1..12 in the given offset (civil-from-days, Howard Hinnant's algorithm).
function TimeUtil.month(now: number, offsetHours: number): number
	local z = TimeUtil.dayNumber(now, offsetHours) + 719468
	local era = math.floor(z / 146097)
	local doe = z - era * 146097
	local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
	local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
	local mp = math.floor((5 * doy + 2) / 153)
	local m = mp < 10 and mp + 3 or mp - 9
	return m
end

-- Clock time in the offset zone, e.g. "3:45 PM". A time of day, not a countdown.
function TimeUtil.clock(now: number, offsetHours: number): string
	local localSec = now + offsetHours * 3600
	local sod = localSec % 86400
	if sod < 0 then
		sod += 86400
	end
	local hour = math.floor(sod / 3600)
	local minute = math.floor((sod % 3600) / 60)
	local am = hour < 12
	local h12 = hour % 12
	if h12 == 0 then
		h12 = 12
	end
	return string.format("%d:%02d %s", h12, minute, if am then "AM" else "PM")
end

-- Year, month, day in a fixed offset. Month is 1..12.
function TimeUtil.civil(now: number, offsetHours: number): (number, number, number)
	local z = TimeUtil.dayNumber(now, offsetHours) + 719468
	local era = math.floor(z / 146097)
	local doe = z - era * 146097
	local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
	local y = yoe + era * 400
	local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
	local mp = math.floor((5 * doy + 2) / 153)
	local d = doy - math.floor((153 * mp + 2) / 5) + 1
	local m = if mp < 10 then mp + 3 else mp - 9
	if m <= 2 then
		y += 1
	end
	return y, m, d
end

-- Unix time for a UTC civil date. Hour is 0..23.
function TimeUtil.unix(year: number, month: number, day: number, hour: number, minute: number): number
	local y = year
	local m = month
	if m <= 2 then
		y -= 1
		m += 9
	else
		m -= 3
	end
	local era = math.floor(y / 400)
	local yoe = y - era * 400
	local doy = math.floor((153 * m + 2) / 5) + day - 1
	local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
	local days = era * 146097 + doe - 719468
	return days * 86400 + hour * 3600 + minute * 60
end

-- US Central. UTC-6 in winter, UTC-5 from the second Sunday in March 2:00 AM
-- through the first Sunday in November 2:00 AM. The clock change is the real one.
function TimeUtil.centralOffset(now: number): number
	local year = TimeUtil.civil(now, -6)
	local function nthSunday(month: number, n: number): number
		local w = TimeUtil.weekday(TimeUtil.unix(year, month, 1, 0, 0), 0)
		local first = 1 + ((1 - w) % 7)
		return first + (n - 1) * 7
	end
	-- 2:00 AM standard time is 08:00 UTC. 2:00 AM daylight time is 07:00 UTC.
	local startUtc = TimeUtil.unix(year, 3, nthSunday(3, 2), 8, 0)
	local endUtc = TimeUtil.unix(year, 11, nthSunday(11, 1), 7, 0)
	if now >= startUtc and now < endUtc then
		return -5
	end
	return -6
end

function TimeUtil.formatDuration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

return TimeUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--!strict
-- Smoke Storm. Free, server-wide, and the odds do not read passes, products, or purchases.
local Config = if script ~= nil and script.Parent ~= nil and script.Parent.Parent ~= nil then require(script.Parent.Parent.Config) else require("../Config")
local TimeUtil = if script ~= nil and script.Parent ~= nil then require(script.Parent.TimeUtil) else require("./TimeUtil")

local Weather = {}

local TRAIT_ORDER = { none = 0, smoky = 1, glazed = 2, golden = 3, meteorite = 4 }

function Weather.order(traitId: string?): number
	return TRAIT_ORDER[traitId or "none"] or 0
end

-- A better trait replaces a worse one. A miss, or a weaker roll, leaves the critter as it is.
function Weather.upgrade(current: string?, rolled: string?): string
	local have = if type(current) == "string" and current ~= "" then current else "none"
	local nextTrait = if type(rolled) == "string" and rolled ~= "" then rolled else "none"
	if Weather.order(nextTrait) > Weather.order(have) then
		return nextTrait
	end
	return have
end

function Weather.weight(id: string, triple: boolean): number
	for _, row in ipairs(Config.Storm.odds) do
		if row.id == id then
			if triple and id ~= "none" then
				return row.weight * Config.Storm.triple
			end
			return row.weight
		end
	end
	return 0
end

export type Odd = { id: string, name: string, pct: number }

-- Shown odds, including "No trait", always sum to 100. `triple` is the Saturday window only.
function Weather.shownOdds(triple: boolean?): { Odd }
	local rows = {}
	local total = 0
	for _, row in ipairs(Config.Storm.odds) do
		local w = Weather.weight(row.id, triple == true)
		total += w
		table.insert(rows, { id = row.id, name = row.name, weight = w })
	end
	local out = {}
	if total <= 0 then
		return out
	end
	for _, row in ipairs(rows) do
		table.insert(out, { id = row.id, name = row.name, pct = row.weight / total * 100 })
	end
	return out
end

-- `u` is 0..1. The same u and the same triple flag always return the same trait.
function Weather.roll(u: number, triple: boolean?): string
	local odds = Weather.shownOdds(triple == true)
	local x = math.clamp(u, 0, 0.999999) * 100
	local acc = 0
	for _, row in ipairs(odds) do
		acc += row.pct
		if x < acc then
			return row.id
		end
	end
	return "none"
end

local function gapFor(seed: number, index: number): number
	local x = (math.floor(seed) * 10007 + index * 9176) % 2147483647
	if x < 0 then
		x += 2147483646
	end
	local u = (x % 10000) / 10000
	return Config.Storm.gapMin + u * (Config.Storm.gapMax - Config.Storm.gapMin)
end

export type Storm = { active: boolean, start: number, finish: number, nextStart: number, index: number }

-- Where the timeline was last walked to, per seed: `t` is the start of gap `i`.
-- A server's clock only moves forward, so later calls start from here instead of from 1970.
local walked: { [number]: { i: number, t: number } } = {}

-- The storm timeline is fixed for a server seed, so every client can be told the same window.
function Weather.stormAt(seed: number, now: number): Storm
	local duration = Config.Storm.duration
	local t = 0
	local i = 0
	local avg = (Config.Storm.gapMin + Config.Storm.gapMax) / 2 + duration
	local memo = walked[seed]
	if memo and memo.t <= now then
		i, t = memo.i, memo.t
	elseif now > avg * 4 then
		i = math.max(0, math.floor(now / avg) - 4)
		for n = 0, i - 1 do
			t += gapFor(seed, n) + duration
		end
		while i > 0 and t > now do
			i -= 1
			t -= gapFor(seed, i) + duration
		end
	end
	while i < 100000000 do
		local start = t + gapFor(seed, i)
		local finish = start + duration
		if now < finish then
			walked[seed] = { i = i, t = t }
			if now < start then
				return { active = false, start = start, finish = finish, nextStart = start, index = i }
			end
			return { active = true, start = start, finish = finish, nextStart = finish + gapFor(seed, i + 1), index = i }
		end
		t = finish
		i += 1
	end
	return { active = false, start = now, finish = now, nextStart = now + Config.Storm.gapMin, index = i }
end

-- Saturday 2:00–2:30 PM Central. A real window, not a countdown.
function Weather.smokeShow(now: number, offsetHours: number): boolean
	if TimeUtil.weekday(now, offsetHours) ~= 7 then
		return false
	end
	local localSec = now + offsetHours * 3600
	local sod = localSec % 86400
	if sod < 0 then
		sod += 86400
	end
	local beginAt = Config.Storm.showHour * 3600
	return sod >= beginAt and sod < beginAt + Config.Storm.showLength
end

function Weather.banner(triple: boolean?): string
	local bits = {}
	for _, row in ipairs(Weather.shownOdds(triple == true)) do
		if row.id ~= "none" then
			table.insert(bits, string.format("%s %.2g%%", row.name, row.pct))
		end
	end
	local head = if triple then "SATURDAY SMOKE SHOW" else "SMOKE STORM"
	return head .. ": crew can catch traits. " .. table.concat(bits, " · ")
end

return Weather
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Monetization.luau — THE ONE PLACE FOR ROBUX IDS.

	FASTEST: `lune run scripts/create-shop <universeId> --apply` with an Open Cloud key creates every
	pass and product below (with its icon from marketing/shop-icons/) and fills in the IDs for you.

	HOW TO FILL THIS IN BY HAND (no coding needed, see PUBLISHING.md for screenshots-level steps):
	  1. Publish the game once (File > Publish to Roblox).
	  2. Go to https://create.roblox.com/dashboard/creations, click the game.
	  3. Monetization > Passes > "Create a Pass" for every entry in `Passes` below.
	     Use the name, description and price shown here. Copy its ID (the number in the
	     pass's URL or the "Copy Asset ID" menu) and paste it over the 0.
	  4. Monetization > Developer Products > "Create a Developer Product" for every entry
	     in `Products`. Same idea: paste each product ID over the 0.
	  5. Save this file, then File > Publish to Roblox again.

	Anything left at 0 is simply hidden from the shop in the live game (you can launch with
	just a few items). In Studio play-testing, 0-ID items show a "Studio test" button that
	grants the item for free so you can try it.

	Rules we follow (Roblox monetization + "promoting to younger audiences" guidance):
	  * No paid random items at all (no loot boxes); every purchase shows exactly what you get.
	  * Robux never buys coins, so free-play odds (rarities, restocks, bandanas) are never "paid random".
	  * Calm shop copy: "See item", "Buy for R$ X". No "LAST CHANCE", no countdowns on Robux items.
	  * Every advantage you can buy (speed, slots, premium cuts) can also be earned by playing.
	  * Paid perks never affect the Cook-Off leaderboard or plate snagging.
	  * Fair Play caps (Config.FairPlay): the tip pass is +50% (not x2), and buying a speed boost
	    gives everyone else in the server a free 5-minute Smoke Shower.
	  * The Smokehouse Pass, tier skips, the Pit Crew Club and Premium give looks and titles only.
	  * Event looks (the Turkey Day and Holiday sets) go on sale only during the event week and come back the next
	    year. The free event reward always stays free. Dates are shown plainly, never as a timer.
	  * Roblox PolicyService decides who sees the subscription (IsEligibleToPurchaseSubscription).
]]

export type Pass = { id: number, name: string, price: number, desc: string, icon: string }
export type Product = {
	id: number,
	name: string,
	price: number,
	desc: string,
	icon: string,
	kind: string, -- "boost" | "finish" | "cosmetic" | "bundle" | "cut" | "starter" | "season" | "tierskip"
	category: string, -- shop tab
	minutes: number?,
	mult: number?,
	grants: { string }?,
	cut: string?,
	count: number?,
	valueNote: string?,
	rotation: boolean?,
	event: string?, -- "turkeyday" | "holiday": only on sale during that event's window
	once: boolean?, -- one per account (the first-time Pit Pack)
}

export type Subscription = { id: string, name: string, price: number, priceText: string, icon: string, desc: string, perks: { string } }

local Monetization = {}

-- GAME PASSES (bought once, kept forever)
Monetization.Passes = {
	ExtraSmokers = { id = 2089577508, name = "Extra Smoker Slots", price = 249, icon = "🔥", desc = "+2 cooking pit slots on your ranch, forever." },
	AutoServe = { id = 2089955594, name = "Jimothy the Waiter", price = 299, icon = "🦝", desc = "Jimothy scurries your waiting customers their food while you're in the game." },
	DoubleTips = { id = 2088839581, name = "Big Tipper", price = 299, icon = "💰", desc = "Every plate you serve earns +50% coins, and your hired crew earns +50% coins per second. Capped for Fair Play; does not affect the Cook-Off or snagging." },
	PremiumCuts = { id = 2088479585, name = "Premium Cuts", price = 349, icon = "🥩", desc = "Cook Wagyu Brisket and Tomahawk Steaks any time. Each cook comes out Smoke Ring Gold. You still pay the meat cost. (Both can also be earned on the Pitmaster Path.)" },
	VIPPatio = { id = 2089979602, name = "VIP Patio", price = 149, icon = "✨", desc = "String lights over your ranch, a VIP sign and a gold name tag. Looks only." },
	-- id 0 until scripts/create-shop.luau is run for real. The game treats 0 as "not on sale yet."
	Bunkhouse = { id = 0, name = "Bunkhouse", price = 299, icon = "🛏️", desc = "+4 crew slots, and your crew keeps earning for 8 hours while you're away." },
	AutoHire = { id = 0, name = "Auto-Hire", price = 199, icon = "🐾", desc = "While you're in the game, hires the best critter you can afford each time the line restocks. Turn it off any time in Settings." },
} :: { [string]: Pass }

-- DEVELOPER PRODUCTS (can be bought more than once; cosmetics are saved forever once bought)
Monetization.Products = {
	-- Boosts (advantage)
	CrewIncome30 = { id = 0, name = "Crew Income x2 (30 min)", price = 59, icon = "🍳", kind = "crewboost", category = "Crew", minutes = 30, mult = 2, desc = "Your hired crew earns twice as much for 30 minutes. Trait odds stay the same." },
