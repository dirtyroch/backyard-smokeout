    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="40">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpPower">50</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="41">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Ambient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Ambient — purely cosmetic, client-side life for the map:
	  * fireflies (ParticleEmitters named "Fireflies") switch on at dusk and off at dawn
	  * a few decor critters in Map.Scenery.Critters wander around their home spot
	Nothing here replicates or touches gameplay. Critters far from the camera are skipped.
]]
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Ambient = {}

type Wanderer = {
	model: Model,
	home: Vector3,
	range: number,
	speed: number,
	pos: Vector3,
	target: Vector3,
	wait: number,
	y: number,
	t: number,
}

local rng = Random.new()

local function isNight(): boolean
	local h = Lighting.ClockTime
	return h >= 18.25 or h < 5.75
end

function Ambient.start()
	local map = workspace:WaitForChild("Map", 60)
	if not map then
		return
	end
	local scenery = map:WaitForChild("Scenery", 30)
	if not scenery then
		return
	end

	-- fireflies at dusk
	local emitters: { ParticleEmitter } = {}
	for _, d in ipairs(scenery:GetDescendants()) do
		if d:IsA("ParticleEmitter") and d.Name == "Fireflies" then
			table.insert(emitters, d)
		end
	end
	local lastNight: boolean? = nil
	local function updateNight()
		local n = isNight()
		if n ~= lastNight then
			lastNight = n
			for _, e in ipairs(emitters) do
				e.Enabled = n
			end
		end
	end
	updateNight()
	Lighting:GetPropertyChangedSignal("ClockTime"):Connect(updateNight)

	-- wandering critters
	local wanderers: { Wanderer } = {}
	local folder = scenery:FindFirstChild("Critters")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			if m:IsA("Model") then
				local pivot = m:GetPivot()
				table.insert(wanderers, {
					model = m,
					home = pivot.Position,
					range = (m:GetAttribute("Range") :: number?) or 14,
					speed = (m:GetAttribute("Speed") :: number?) or 4,
					pos = pivot.Position,
					target = pivot.Position,
					wait = rng:NextNumber(0, 3),
					y = pivot.Position.Y,
					t = 0,
				})
			end
		end
	end
	if #wanderers == 0 then
		return
	end
	RunService.Heartbeat:Connect(function(dt)
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		for _, w in ipairs(wanderers) do
			if (w.pos - camPos).Magnitude > 260 then
				continue
			end
			if w.wait > 0 then
				w.wait -= dt
				continue
			end
			local delta = w.target - w.pos
			local flat = Vector3.new(delta.X, 0, delta.Z)
			if flat.Magnitude < 0.5 then
				local a = rng:NextNumber(0, math.pi * 2)
				local r = rng:NextNumber(2, w.range)
				w.target = w.home + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
				w.wait = rng:NextNumber(1, 4)
				continue
			end
			local step = math.min(flat.Magnitude, w.speed * dt)
			w.pos += flat.Unit * step
			w.t += dt
			local hop = math.abs(math.sin(w.t * 9)) * 0.25
			local at = Vector3.new(w.pos.X, w.y + hop, w.pos.Z)
			w.model:PivotTo(CFrame.lookAt(at, at + flat.Unit))
		end
	end)
end

return Ambient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Feedback: toasts, announcements, rare-reveal cinematic, flip popups, floating coins.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UI = require(script.Parent.UI)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local T = UI.Theme

local Fx = {}
local gui: GuiObject = nil :: any
local toastHolder: Frame = nil :: any
local announceHolder: Frame = nil :: any

local KIND_COLOR = {
	good = T.green,
	bad = T.red,
	warn = Color3.fromHex("#E0A030"),
	ready = T.gold,
	info = Color3.fromHex("#5A4030"),
}

function Fx.mount(screen: GuiObject)
	gui = screen
	toastHolder = UI.frame({ Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.new(0, 460, 0, 300), Parent = screen, ZIndex = 50 })
	UI.list(toastHolder, nil, 6, Enum.HorizontalAlignment.Center)
	announceHolder = UI.frame({ Name = "Announce", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 64), Size = UDim2.new(0, 640, 0, 50), Parent = screen, ZIndex = 50 })
	UI.list(announceHolder, nil, 4, Enum.HorizontalAlignment.Center)
end

function Fx.toast(text: string, kind: string?)
	if not toastHolder then
		return
	end
	local color = KIND_COLOR[kind or "info"] or KIND_COLOR.info
	local f = UI.frame({ BackgroundColor3 = color, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 51, Parent = toastHolder })
	UI.corner(f, 10)
	UI.stroke(f)
	UI.pad(f, 8)
	UI.label(text, { TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), TextSize = 17, ZIndex = 52, Parent = f })
	local kids = 0
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			kids += 1
		end
	end
	if kids > 4 then
		for _, c in ipairs(toastHolder:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
	task.delay(4.5, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

function Fx.announce(text: string, color: string?)
	if not announceHolder then
		return
	end
	local f = UI.frame({ BackgroundColor3 = Color3.fromHex("#1A0F0A"), BackgroundTransparency = 0.25, Size = UDim2.new(1, 0, 0, 34), ZIndex = 51, Parent = announceHolder })
	UI.corner(f, 17)
	UI.label(text, { TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromHex(color or "#FFC83C"), TextSize = 18, Size = UDim2.new(1, 0, 1, 0), ZIndex = 52, Parent = f })
	for i, c in ipairs(announceHolder:GetChildren()) do
		if c:IsA("Frame") and i < #announceHolder:GetChildren() - 2 then
			c:Destroy()
		end
	end
	task.delay(6, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

-- Big Bertha's bell swings (client-side only) whenever someone rings it.
local function bertha(): Model?
	local m = workspace:FindFirstChild("BigBertha", true)
	return if m and m:IsA("Model") then m else nil
end

function Fx.ringBell()
	local m = bertha()
	local bell = m and m:FindFirstChild("DinnerBell")
	if not bell or not bell:IsA("Model") then
		return
	end
	local home = bell:GetPivot()
	task.spawn(function()
		for i = 1, 8 do
			bell:PivotTo(home * CFrame.Angles(0, 0, math.rad(22) * math.sin(i * 1.4) * (1 - i / 9)))
			task.wait(0.07)
		end
		bell:PivotTo(home)
	end)
end

-- Dinner Bell pile-on: the bell swings, Big Bertha's chimney blows a huge puff, confetti pops,
-- and a big banner shows. Built for clips, so the payoff lands inside 2 seconds.
function Fx.dinnerBell()
	Fx.pop(Content.Slang.dinnerBell, Color3.fromHex("#FFC83C"), 64)
	Fx.ringBell()
	local m = bertha()
	if not m then
		return
	end
	local chimney = m:FindFirstChild("Chimney", true)
	if chimney and chimney:IsA("BasePart") then
		local puff = Instance.new("Smoke")
		puff.Color = Color3.fromRGB(235, 235, 235)
		puff.Size = 14
		puff.Opacity = 0.6
		puff.RiseVelocity = 14
		puff.Parent = chimney
		task.delay(4, function()
			puff:Destroy()
		end)
	end
	local burst = Instance.new("Part")
	burst.Anchored, burst.CanCollide, burst.CanQuery, burst.CanTouch = true, false, false, false
	burst.Transparency = 1
	burst.Size = Vector3.new(1, 1, 1)
	burst.CFrame = m:GetPivot() * CFrame.new(0, 14, 0)
	burst.Parent = workspace
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHex("#FFC83C")), ColorSequenceKeypoint.new(0.5, Color3.fromHex("#FF7A3D")), ColorSequenceKeypoint.new(1, Color3.fromHex("#5AD2FF")) })
	pe.Speed = NumberRange.new(18, 30)
	pe.SpreadAngle = Vector2.new(70, 70)
	pe.Lifetime = NumberRange.new(1.5, 2.5)
	pe.Acceleration = Vector3.new(0, -25, 0)
	pe.Size = NumberSequence.new(0.6)
	pe.Rate = 0
	pe.Parent = burst
	pe:Emit(160)
	task.delay(3, function()
		burst:Destroy()
	end)
end

-- Big center-screen pop text.
function Fx.pop(text: string, color: Color3, size: number?)
	local l = UI.label(text, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.new(0, 700, 0, 80),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = color,
		TextSize = size or 46,
		TextStrokeTransparency = 0,
		ZIndex = 60,
		Parent = gui,
	})
	local tw = TweenService:Create(l, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.32), TextTransparency = 1, TextStrokeTransparency = 1 })
	tw:Play()
	task.delay(1.5, function()
		l:Destroy()
	end)
end

function Fx.coins(amount: number)
	Fx.pop("+" .. UI.fmt(amount) .. " 🪙", T.gold, 34)
end

local function shake(seconds: number, power: number)
	local cam = workspace.CurrentCamera
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = os.clock() - t0
		if a > seconds then
			conn:Disconnect()
			return
		end
		local p = power * (1 - a / seconds)
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * p, (math.random() - 0.5) * p, 0)
	end)
end
Fx.shake = shake

-- Rare reveal: a short orbit around your smoker, then a big title card.
function Fx.reveal(meatId: string, rarityId: string, aura: number, smokerPos: Vector3?)
	local meat = Config.Meats[meatId]
	local rar
	for _, r in ipairs(Config.Rarities) do
		if r.id == rarityId then
			rar = r
		end
	end
	if not meat or not rar then
		return
	end
	local color = Color3.fromHex(rar.color)
	local cam = workspace.CurrentCamera
	if smokerPos then
		local oldType = cam.CameraType
		cam.CameraType = Enum.CameraType.Scriptable
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local a = os.clock() - t0
			if a > 2.2 then
				conn:Disconnect()
				cam.CameraType = if oldType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else oldType
				return
			end
			local ang = a * 1.4
			local pos = smokerPos + Vector3.new(math.cos(ang) * 14, 7 - a, math.sin(ang) * 14)
			cam.CFrame = CFrame.lookAt(pos, smokerPos + Vector3.new(0, 4, 0))
		end)
	end
	local overlay = UI.frame({ BackgroundColor3 = color, BackgroundTransparency = 0.6, Size = UDim2.fromScale(1, 1), ZIndex = 55, Parent = gui })
	local card = UI.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 520, 0, 220), BackgroundColor3 = Color3.fromHex("#1A0F0A"), ZIndex = 56, Parent = overlay })
	UI.corner(card, 20)
	UI.stroke(card, color, 4)
	UI.label(string.upper(rar.name) .. "!", { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 60), TextSize = 50, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 57, Parent = card })
	UI.label(meat.icon .. " " .. meat.name, { Position = UDim2.new(0, 0, 0, 96), Size = UDim2.new(1, 0, 0, 36), TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 57, Parent = card })
	local sub = string.format("Worth x%s. Your smoke signal is up for the whole server!", tostring(rar.mult))
	if aura > 0 then
		sub = (string.gsub(Content.Slang.perfectFlip, "1000", tostring(aura))) .. "  •  " .. sub
	end
	UI.label(sub, { Position = UDim2.new(0, 20, 0, 146), Size = UDim2.new(1, -40, 0, 50), TextSize = 18, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 57, Parent = card })
	card.Size = UDim2.new(0, 0, 0, 0)
	TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 520, 0, 220) }):Play()
	if rarityId == "texas" then
		-- Texas-size: the cut is so big it crushes the picnic table (camera shake + crunch text)
		task.delay(0.4, function()
			shake(0.8, 1.2)
			Fx.pop("CRUNCH! It broke the table!", Color3.fromHex("#FF5A36"), 38)
		end)
	elseif rarityId == "meteorite" then
		task.delay(0.3, function()
			shake(1.2, 2)
		end)
	end
	task.delay(3.2, function()
		TweenService:Create(overlay, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		task.wait(0.4)
		overlay:Destroy()
	end)
end

function Fx.flip(result: string, combo: number, lockedIn: boolean?)
	if result == "perfect" then
		Fx.pop(Content.Slang.perfectFlip, T.gold)
		if lockedIn then
			task.delay(0.5, function()
				Fx.pop(Content.Slang.lockedIn .. "  x" .. combo, Color3.fromHex("#6CC24A"), 40)
			end)
		end
	elseif result == "good" then
		Fx.pop("Nice flip!", T.green, 36)
	else
		Fx.pop("Flipped too early/late", T.dim, 30)
	end
end

local _ = Players
return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- The always-on HUD: currencies, menu buttons, the station bar, Serve All / Collect All,
-- and the one-button first cook for brand-new players.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CookLogic = require(Shared.Logic.CookLogic)
local TimeUtil = require(Shared.Logic.TimeUtil)
local T = UI.Theme

local Hud = {}
local Panels: any = nil
local root: Frame = nil :: any
local refs: any = {}
local cards: { [string]: any } = {}
local cardLayoutKey = ""

-- Client-side estimate of a cook (the server is the source of truth; this is just for display).
function Hud.view(st: any, boost: any): (number, number, boolean, number?)
	local now = workspace:GetServerTimeNow()
	local c: any = {
		meat = st.meat,
		rarity = "",
		progress = st.progress,
		duration = st.duration,
		last = st.last,
		startedAt = st.last,
		rateMult = 1,
		peeks = 0,
		revealed = false,
		doneAt = st.doneAt,
	}
	CookLogic.advance(c, now, st.rate, boost.mult, boost.untilT)
	local remaining = CookLogic.remaining(c, now, st.rate, boost.mult, boost.untilT)
	return CookLogic.fraction(c), remaining, CookLogic.isDone(c), c.doneAt
end

local function topPill(parent: Instance, icon: string, order: number, color: Color3): TextLabel
	local f = UI.frame({ BackgroundColor3 = T.bg, BackgroundTransparency = 0.1, Size = UDim2.new(0, 150, 0, 40), LayoutOrder = order, Parent = parent })
	UI.corner(f, 20)
	UI.stroke(f, color, 2)
	UI.label(icon, { Size = UDim2.new(0, 34, 1, 0), Position = UDim2.new(0, 8, 0, 0), TextSize = 22, Parent = f })
	return UI.label("0", { Name = "Value", Size = UDim2.new(1, -48, 1, 0), Position = UDim2.new(0, 42, 0, 0), TextSize = 20, TextColor3 = color, Parent = f })
end

local function menuButton(parent: Instance, icon: string, text: string, order: number, panel: string): TextButton
	local b = UI.button("", T.bg, { Size = UDim2.new(0, 64, 0, 64), LayoutOrder = order, BackgroundTransparency = 0.1, Parent = parent }, function()
		Panels.toggle(panel)
	end)
	UI.label(icon, { Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 0, 4), TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
	UI.label(text, { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -22), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
	local dot = UI.frame({ Name = "Dot", BackgroundColor3 = T.red, Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -12, 0, -2), Visible = false, Parent = b })
	UI.corner(dot, 7)
	return b
end

function Hud.mount(screen: GuiObject, panels: any)
	Panels = panels
	root = UI.frame({ Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = screen })

	-- top: currencies
	local top = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(0, 860, 0, 44), Parent = root })
	UI.list(top, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	refs.coins = topPill(top, "🪙", 1, T.gold)
	refs.aura = topPill(top, "✨", 2, Color3.fromHex("#B48CFF"))
	refs.rank = topPill(top, "👴", 3, T.text)
	refs.rank.Parent.Size = UDim2.new(0, 190, 0, 40)
	refs.cooler = topPill(top, "🧊", 4, Color3.fromHex("#8FD3FF"))
	refs.boost = topPill(top, "⏩", 5, T.green)
	refs.boost.Parent.Visible = false

	-- left: menu
	local menu = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0.5, -270), Size = UDim2.new(0, 70, 0, 560), Parent = root })
	UI.list(menu, nil, 6)
	refs.btnShop = menuButton(menu, "🛒", "Pit Shop", 1, "shop")
	refs.btnSauce = menuButton(menu, "🥫", "Sauce", 2, "sauce")
	refs.btnIndex = menuButton(menu, "📖", "Index", 3, "index")
	refs.btnPath = menuButton(menu, "🗺️", "Path", 4, "path")
	refs.btnUp = menuButton(menu, "⬆️", "Upgrade", 5, "upgrades")
	refs.btnDaily = menuButton(menu, "🎁", "Daily", 6, "daily")
	refs.btnSettings = menuButton(menu, "⚙️", "Settings", 7, "settings")
	refs.btnInvite = menuButton(menu, "👋", "Invite", 8, "invite")

	-- right: big actions
	local right = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -170), Size = UDim2.new(0, 170, 0, 150), Parent = root })
	UI.list(right, nil, 8, Enum.HorizontalAlignment.Right)
	refs.serveAll = UI.button("🍽️ Serve All", T.green, { Size = UDim2.new(0, 170, 0, 50), TextSize = 20, LayoutOrder = 1, Parent = right }, function()
		Net.act("ServeAll")
	end)
	refs.collectAll = UI.button("📥 Collect All", T.blue, { Size = UDim2.new(0, 170, 0, 44), LayoutOrder = 2, Parent = right }, function()
		Net.act("CollectAll")
	end)
	refs.homeBtn = UI.button("🏠 Home", T.card, { Size = UDim2.new(0, 120, 0, 36), LayoutOrder = 3, TextSize = 16, Parent = right }, function()
		Panels.goHome()
	end)
	refs.customers = UI.label("", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -322), Size = UDim2.new(0, 260, 0, 22), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 16, TextStrokeTransparency = 0.4, Parent = root })
	refs.rush = UI.label("", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -370), Size = UDim2.new(0, 300, 0, 22), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 16, TextColor3 = Color3.fromHex("#FFC83C"), TextStrokeTransparency = 0.4, Parent = root })
	refs.combo = UI.label("", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -346), Size = UDim2.new(0, 260, 0, 22), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 18, TextColor3 = Color3.fromHex("#6CC24A"), TextStrokeTransparency = 0.4, Parent = root })

	-- bottom: station bar
	local bar = UI.new("ScrollingFrame", {
		Name = "Stations",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -220, 0, 150),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollBarThickness = 6,
		Parent = root,
	})
	local lay = UI.list(bar, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	lay.VerticalAlignment = Enum.VerticalAlignment.Bottom
	refs.bar = bar

	-- first-cook CTA
	refs.first = UI.button("🔥 Smoke your first brisket!", T.accent, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -176), Size = UDim2.new(0, 380, 0, 64), TextSize = 26, Visible = false, Parent = root }, function()
		if Net.act("FirstBrisket") then
			refs.first.Visible = false
		end
	end)
	task.spawn(function()
		while true do
			if refs.first.Visible then
				local tw = TweenService:Create(refs.first, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true), { Size = UDim2.new(0, 400, 0, 70) })
				tw:Play()
				tw.Completed:Wait()
			else
				task.wait(0.5)
			end
		end
	end)
	refs.hint = UI.label("", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -248), Size = UDim2.new(0, 520, 0, 28), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 20, TextColor3 = T.gold, TextStrokeTransparency = 0.2, Parent = root })
end

local function slotName(key: string): string
	local n = string.sub(key, 2)
	return (string.sub(key, 1, 1) == "s" and "Smoker " or "Grill ") .. n
end

local function makeCard(key: string, order: number): any
	local c: any = {}
	local f = UI.frame({ Name = key, BackgroundColor3 = T.bg, BackgroundTransparency = 0.05, Size = UDim2.new(0, 150, 0, 136), LayoutOrder = order, Parent = refs.bar })
	UI.corner(f, 12)
	c.stroke = UI.stroke(f, T.card, 2)
	UI.pad(f, 6)
	c.frame = f
	c.title = UI.label(slotName(key), { Size = UDim2.new(1, 0, 0, 16), TextSize = 13, TextColor3 = T.dim, Parent = f })
	c.name = UI.label("Empty", { Position = UDim2.new(0, 0, 0, 16), Size = UDim2.new(1, 0, 0, 34), TextSize = 15, TextWrapped = true, Parent = f })
	local back, fill = UI.bar(f, T.accent, { Position = UDim2.new(0, 0, 0, 52), Size = UDim2.new(1, 0, 0, 10) })
	c.barBack, c.fill = back, fill
	-- flip windows for burgers
	local F = Config.Flip
	c.good = UI.frame({ BackgroundColor3 = T.green, BackgroundTransparency = 0.6, Position = UDim2.fromScale(F.target - F.goodWindow, 0), Size = UDim2.fromScale(F.goodWindow * 2, 1), Visible = false, ZIndex = 2, Parent = back })
	c.perfect = UI.frame({ BackgroundColor3 = T.gold, BackgroundTransparency = 0.2, Position = UDim2.fromScale(F.target - F.perfectWindow, 0), Size = UDim2.fromScale(F.perfectWindow * 2, 1), Visible = false, ZIndex = 3, Parent = back })
	c.time = UI.label("", { Position = UDim2.new(0, 0, 0, 64), Size = UDim2.new(1, 0, 0, 18), TextSize = 14, TextColor3 = T.dim, Parent = f })
	c.btn = UI.button("Cook", T.accent, { Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(1, 0, 0, 38), TextSize = 18, Parent = f }, function()
		Hud.cardAction(key)
	end)
	c.peek = UI.button("👀", T.card, { Position = UDim2.new(1, -38, 0, 14), Size = UDim2.new(0, 36, 0, 30), TextSize = 16, Visible = false, Parent = f }, function()
		Net.act("Peek", key)
	end)
	return c
end

function Hud.cardAction(key: string)
	local s = Net.state
	if not s then
		return
	end
	local kind = string.sub(key, 1, 1) == "s" and "smoker" or "grill"
	local idx = tonumber(string.sub(key, 2)) or 1
	if idx > s.slots[kind] then
		Panels.open("upgrades")
		return
	end
	local st = s.stations[key]
	if not st then
		Panels.open("cook", key)
		return
	end
	local _, _, done = Hud.view(st, s.boost)
	if done then
		Net.act("Collect", key)
	elseif st.meat == "burger" and not st.flip then
		Net.act("Flip", key)
	end
end

local function layoutKey(s: any): string
	return s.slots.smoker .. ":" .. s.slots.grill
end

local function rebuildCards(s: any)
	UI.clear(refs.bar)
	cards = {}
	local order = 0
	for i = 1, Config.MAX_GRILLS do
		order += 1
		local key = "g" .. i
		cards[key] = makeCard(key, order)
		if i > s.slots.grill then
			cards[key].locked = true
		end
		if i > s.slots.grill then
			break -- show one locked slot as a teaser
		end
	end
	for i = 1, Config.MAX_SMOKERS do
		order += 1
		local key = "s" .. i
		cards[key] = makeCard(key, order)
		if i > s.slots.smoker then
			cards[key].locked = true
			break
		end
	end
	cardLayoutKey = layoutKey(s)
end

function Hud.update()
	local s = Net.state
	if not s or not root then
		return
	end
	if layoutKey(s) ~= cardLayoutKey then
		rebuildCards(s)
	end
	refs.coins.Text = UI.fmt(s.coins)
	refs.aura.Text = UI.fmt(s.aura)
	local rank = Config.Ranks[s.rank]
	refs.rank.Text = (s.title ~= "" and s.title or (rank and rank.name or ""))
	refs.cooler.Text = #s.cooler .. "/" .. Config.COOLER_MAX
	local now = workspace:GetServerTimeNow()
	local boostLeft = s.boost.untilT - now
	refs.boost.Parent.Visible = boostLeft > 0 and s.boost.mult > 1
	if boostLeft > 0 then
		refs.boost.Text = "x" .. s.boost.mult .. " " .. TimeUtil.formatDuration(boostLeft)
	end
	refs.btnDaily.Dot.Visible = s.canClaimDaily
	refs.btnPath.Dot.Visible = s.pathStatus.complete
	refs.serveAll.Text = "🍽️ Serve All" .. (#s.customers > 0 and (" (" .. #s.customers .. ")") or "")
	refs.customers.Text = #s.customers > 0 and (#s.customers .. " hungry critter" .. (#s.customers == 1 and "" or "s") .. " waiting") or ""
	if s.rush then
		local ends, n, done = s.rush.ends, s.rush.n, s.rush.done
		if now >= ends then -- a new window started since the last snapshot
			local P = Config.Rush.period
			ends, n, done = (math.floor(now / P) + 1) * P, 0, false
		end
		local left = math.max(0, math.floor(ends - now))
		local zoom = (s.dinnerUntil or 0) > now and "  🔔 Dinner Bell +25% tips" or ""
		refs.rush.Text = (done and "🍽️ Rush cleared! Next in " or string.format("🍽️ Lunch Rush %d/%d · ", n, s.rush.need)) .. TimeUtil.formatDuration(left) .. zoom
	end
	refs.combo.Text = s.combo >= Config.Flip.lockedInAt and ("LOCKED IN 🔒 x" .. s.combo) or (s.combo > 0 and ("Flip combo x" .. s.combo) or "")

	-- first cook / tutorial hints
	local firstCooking = false
	local anyDone = false
	for _, st in pairs(s.stations) do
		if st.meat == "firstbrisket" then
			firstCooking = true
		end
		local _, _, done = Hud.view(st, s.boost)
		anyDone = anyDone or done
	end
	refs.first.Visible = not s.tutorial.firstBrisket and not firstCooking and s.stations.s1 == nil
	if not s.tutorial.done then
		if firstCooking and not anyDone then
			refs.hint.Text = "Your brisket is smoking low and slow... grill a 🍔 burger while you wait!"
		elseif anyDone then
			refs.hint.Text = "⬇ It's ready! Tap Collect, then Serve a customer."
		elseif #s.cooler > 0 then
			refs.hint.Text = "➡ Tap Serve All (or walk up to a critter) to get paid!"
		else
			refs.hint.Text = ""
		end
	else
		refs.hint.Text = ""
	end

	for key, c in pairs(cards) do
		local kind = string.sub(key, 1, 1) == "s" and "smoker" or "grill"
		if c.locked then
			c.name.Text = "🔒 Locked"
			c.time.Text = "Unlock in Upgrades"
			c.fill.Size = UDim2.fromScale(0, 1)
			c.btn.Text = "Unlock"
			c.btn.BackgroundColor3 = T.card
			c.peek.Visible = false
			c.good.Visible = false
			c.perfect.Visible = false
		else
			local st = s.stations[key]
			if not st then
				c.name.Text = kind == "grill" and "Empty grill" or "Empty smoker"
				c.time.Text = kind == "grill" and "Burgers: 30s" or "Low & slow"
				c.fill.Size = UDim2.fromScale(0, 1)
				c.btn.Text = "Cook"
				c.btn.BackgroundColor3 = T.accent
				c.peek.Visible = false
				c.good.Visible = false
				c.perfect.Visible = false
				c.stroke.Color = T.card
			else
				local meat = Config.Meats[st.meat]
				local frac, remaining, done, doneAt = Hud.view(st, s.boost)
				local rarName = ""
				if st.rarity then
					for _, r in ipairs(Config.Rarities) do
						if r.id == st.rarity then
							rarName = r.name .. " "
							c.stroke.Color = Color3.fromHex(r.color)
						end
					end
				else
					c.stroke.Color = T.card
				end
				c.name.Text = meat.icon .. " " .. rarName .. meat.name
				c.fill.Size = UDim2.fromScale(frac, 1)
				c.fill.BackgroundColor3 = done and T.green or T.accent
				local isBurger = st.meat == "burger"
				c.good.Visible = isBurger and not st.flip and not done
				c.perfect.Visible = isBurger and not st.flip and not done
				c.peek.Visible = kind == "smoker" and not done and st.rarity == nil
				if st.burnt then
					c.name.Text = "🖤 Burnt " .. meat.name
					c.time.Text = "Skill issue 🤿"
					c.btn.Text = "Toss"
					c.btn.BackgroundColor3 = T.red
				elseif done then
					if isBurger and doneAt then
						local burnIn = Config.BURGER_BURN_GRACE - (workspace:GetServerTimeNow() - doneAt)
						c.time.Text = burnIn > 0 and string.format("Grab it! Burns in %ds", math.ceil(burnIn)) or "Burning!"
					else
						c.time.Text = kind == "smoker" and "Resting in the cooler, ready" or "Ready!"
					end
					c.btn.Text = "Collect"
					c.btn.BackgroundColor3 = T.green
				else
					c.time.Text = TimeUtil.formatDuration(remaining) .. " left"
					if isBurger and not st.flip then
						c.btn.Text = "FLIP!"
						local F = Config.Flip
						local near = math.abs(frac - F.target) <= F.perfectWindow
						c.btn.BackgroundColor3 = near and T.gold or T.blue
					else
						c.btn.Text = st.flip and ("Flipped: " .. st.flip) or "Smoking..."
						c.btn.BackgroundColor3 = T.card
					end
				end
			end
		end
		-- keep the meat name clear of the 👀 peek button in the card's top-right corner
		c.name.Size = UDim2.new(1, c.peek.Visible and -40 or 0, 0, 34)
	end
end

function Hud.smokerPosition(key: string): Vector3?
	local s = Net.state
	if not s or not s.plot then
		return nil
	end
	local map = workspace:FindFirstChild("Map")
	local plot = map and map:FindFirstChild("Plots") and map.Plots:FindFirstChild("Plot" .. s.plot)
	local sm = plot and plot.Smokers:FindFirstChild(key)
	local barrel = sm and sm:FindFirstChild("Barrel") :: BasePart?
	return barrel and barrel.Position or nil
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="46">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry: builds the whole UI in code and connects server pushes to it.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Hud = require(script.Parent.Hud)
local Panels = require(script.Parent.Panels)
local WorldClient = require(script.Parent.WorldClient)
local Ambient = require(script.Parent.Ambient)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screen = UI.new("ScreenGui", { Name = "BackyardSmokeout", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })
-- Scale everything down on small (phone) screens. The UIScale lives on a full-screen
-- container that is sized 1/scale, so after scaling it still covers the whole screen and
-- edge-anchored HUD pieces (menu, Serve All, station bar) stay on the screen edges.
local root = UI.new("Frame", { Name = "Root", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = screen })
local scale = UI.new("UIScale", { Parent = root })
local function rescale()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local s = math.clamp(math.min(v.X / 1280, v.Y / 760), 0.55, 1)
	scale.Scale = s
	root.Size = UDim2.fromScale(1 / s, 1 / s)
end
rescale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

Fx.mount(root)
Panels.mount(root)
Hud.mount(root, Panels)
Net.notify = Fx.toast
WorldClient.start(Panels)
task.spawn(Ambient.start)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

Net.on("toast", function(p)
	Fx.toast(p.text, p.kind)
end)
Net.on("announce", function(p)
	Fx.announce(p.text, p.color)
end)
Net.on("dialog", function(p)
	Panels.dialog(p)
end)
Net.on("welcome", function(p)
	task.wait(1)
	Panels.welcome(p)
end)
Net.on("fx", function(p)
	local d = p.data or {}
	if p.kind == "reveal" then
		Fx.reveal(d.meat, d.rarity, d.aura or 0, Hud.smokerPosition("s1"))
	elseif p.kind == "flip" then
		Fx.flip(d.result, d.combo or 0, d.lockedIn)
	elseif p.kind == "served" then
		Fx.coins(d.value or 0)
		if (d.aura or 0) > 0 then
			task.delay(0.4, function()
				Fx.pop("+" .. d.aura .. " AURA", Color3.fromHex("#B48CFF"), 30)
			end)
		end
	elseif p.kind == "snagged" then
		Fx.pop(Content.Slang.snagged .. " Tag " .. tostring(d.by) .. " back!", UI.Theme.red, 34)
	elseif p.kind == "bell" then
		Fx.pop("🔔 CLANG!", Color3.fromHex("#FFC83C"), 40)
		Fx.ringBell()
	elseif p.kind == "dinnerbell" then
		Fx.dinnerBell()
	elseif p.kind == "sixseven" then
		task.delay(0.5, function()
			Fx.pop(Content.Slang.sixSeven, Color3.fromHex("#FFC83C"), 54)
		end)
	elseif p.kind == "rush" then
		Fx.pop(Content.Slang.rush .. " +" .. tostring(d.bonus or 0), Color3.fromHex("#6CC24A"), 40)
	elseif p.kind == "swat" then
		Fx.pop(d.queen and "👑 QUEEN DOWN!" or "SWAT!", UI.Theme.gold, d.queen and 44 or 26)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.1)
		local ok, err = pcall(function(): any
			Hud.update()
			return nil
		end)
		if not ok then
			warn("[Hud] " .. tostring(err))
		end
	end
end)

-- Ask for a first snapshot (the server also pushes one when your data loads).
task.delay(2, function()
	if not Net.state then
		Net.act("Hello")
	end
end)

local _ = Config
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client networking: one RemoteFunction for requests, one RemoteEvent for server pushes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Action = Remotes:WaitForChild("Action") :: RemoteFunction
local Push = Remotes:WaitForChild("Push") :: RemoteEvent

local Net = {}
Net.state = nil :: any
Net.changed = Instance.new("BindableEvent")
Net.notify = function(_text: string, _kind: string?) end
local handlers: { [string]: { (any) -> () } } = {}

function Net.on(kind: string, fn: (any) -> ())
	handlers[kind] = handlers[kind] or {}
	table.insert(handlers[kind], fn)
end

-- Ask the server to do something. Shows the server's message as a toast.
function Net.act(action: string, a: any?, b: any?, c: any?): (boolean, string?)
	local ok, res = pcall(function()
		return Action:InvokeServer(action, a, b, c)
	end)
	if not ok or type(res) ~= "table" then
		Net.notify("Connection hiccup. Try again!", "bad")
		return false, nil
	end
	if res.msg then
		Net.notify(res.msg, res.ok and "good" or "info")
	end
	return res.ok == true, res.msg
end

Push.OnClientEvent:Connect(function(kind: string, payload: any)
	if kind == "state" then
		Net.state = payload
		Net.changed:Fire(payload)
	end
	local list = handlers[kind]
	if list then
		for _, fn in ipairs(list) do
			task.spawn(fn, payload)
		end
	end
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--!strict
-- All pop-up windows: Pit Shop, Sauce Shack, Index, Pitmaster Path, Upgrades, Daily, Settings,
-- the cook picker, NPC dialogs and the welcome card.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Monetization = require(Shared.Monetization)
local Rarity = require(Shared.Logic.Rarity)
local Restock = require(Shared.Logic.Restock)
local Economy = require(Shared.Logic.Economy)
local TimeUtil = require(Shared.Logic.TimeUtil)
local T = UI.Theme

local player = Players.LocalPlayer
local Panels = {}
local screen: GuiObject = nil :: any
local window: Frame = nil :: any
local titleLabel: TextLabel = nil :: any
local body: Frame = nil :: any
local current: string? = nil
local currentArg: any = nil
local tabState: { [string]: string } = {}
local lastRender = 0
local sauceOdds: { [string]: number }? = nil
local freshOpen = false

local EGGS = {
	{ id = "blessed", hint = "Sunday folks set a table by the hub. Look closely at what's on it." },
	{ id = "roof", hint = "The Sauce Shack roof has a sign-in sheet. Bounce your way up." },
	{ id = "creek", hint = "There's a gap in the hedge behind the ranches. Listen to the stones." },
	{ id = "apron", hint = "Somebody's Unc left an apron by the water." },
	{ id = "king", hint = "The King of the Pit has a gift for a pitmaster in a proper hat, after dark." },
	{ id = "temp", hint = "Temp gets nervous if you keep poking him." },
	{ id = "rex", hint = "Meet enough regulars and someone special visits. RAWR!" },
	{ id = "meteorite", hint = "Cook the rarest cut there is." },
	{ id = "cooked", hint = "Make Granny Pecan say you COOKED." },
	{ id = "sixseven", hint = "Some tips just hit different. Watch the last two digits." },
	{ id = "dinnerbell", hint = "Big Bertha's bell is loudest with a crowd. Bring two friends and ring it together." },
}

local function S(): any
	return Net.state
end

-- ===== window chrome =====
function Panels.mount(sg: GuiObject)
	screen = sg
	window = UI.frame({ Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 760, 0, 500), BackgroundColor3 = T.bg, Visible = false, ZIndex = 20, Parent = screen })
	UI.corner(window, 18)
	UI.stroke(window, T.accent, 3)
	titleLabel = UI.label("", { Position = UDim2.new(0, 20, 0, 10), Size = UDim2.new(1, -80, 0, 36), TextSize = 28, ZIndex = 21, Parent = window })
	UI.button("✕", T.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.new(0, 40, 0, 40), TextSize = 22, ZIndex = 22, Parent = window }, function()
		Panels.close()
	end)
	body = UI.frame({ Name = "Body", BackgroundTransparency = 1, Position = UDim2.new(0, 16, 0, 54), Size = UDim2.new(1, -32, 1, -68), ZIndex = 21, Parent = window })
	Net.changed.Event:Connect(function()
		if current and current ~= "dialog" and current ~= "welcome" and os.clock() - lastRender > 0.75 then
			Panels.render()
		end
	end)
end

function Panels.close()
	current = nil
	window.Visible = false
end

function Panels.open(name: string, arg: any?)
	if name == "invite" then
		Panels.invite()
		return
	end
	current = name
	currentArg = arg
	freshOpen = true
	window.Visible = true
	Panels.render()
end

function Panels.toggle(name: string)
	if current == name then
		Panels.close()
	else
		Panels.open(name)
	end
end

function Panels.goHome()
	local s = S()
	local char = player.Character
	local map = workspace:FindFirstChild("Map")
	if not s or not s.plot or not char or not map then
		return
	end
	local plot = map.Plots:FindFirstChild("Plot" .. s.plot)
	local pad = plot and plot:FindFirstChild("SpawnPad") :: BasePart?
	if pad then
		char:PivotTo(pad.CFrame + Vector3.new(0, 4, 0))
	end
end

function Panels.invite()
	local ok, can = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if ok and can then
		pcall(function()
			local opts = Instance.new("ExperienceInviteOptions")
			opts.PromptMessage = "Help me ring Big Bertha's dinner bell! 3 rings = bonus tips for the whole server 🔔"
			opts.LaunchData = "bertha"
			SocialService:PromptGameInvite(player, opts)
		end)
	else
		Net.notify("Invites aren't available here. Share the game link with your friends! (Friends in the same server give a crew bonus.)", "info")
	end
end

local function scroller(parent: Instance, grid: boolean?, cell: Vector2?): ScrollingFrame
	local sf = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 21,
		Parent = parent,
	})
	if grid then
		UI.new("UIGridLayout", { CellSize = UDim2.new(0, (cell or Vector2.new(170, 220)).X, 0, (cell or Vector2.new(170, 220)).Y), CellPadding = UDim2.new(0, 10, 0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sf })
	else
		UI.list(sf, nil, 8)
	end
	UI.pad(sf, 4)
	return sf
end

local function tabs(parent: Instance, key: string, names: { string }, default: string): (string, Frame)
	local sel = tabState[key] or default
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), ZIndex = 21, Parent = parent })
	UI.list(row, Enum.FillDirection.Horizontal, 6)
	for i, n in ipairs(names) do
		UI.button(n, n == sel and T.accent or T.card, { Size = UDim2.new(0, math.max(70, #n * 9 + 20), 0, 32), TextSize = 15, LayoutOrder = i, ZIndex = 22, Parent = row }, function()
			tabState[key] = n
			Panels.render()
		end)
	end
	local content = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 1, -44), ZIndex = 21, Parent = parent })
	return sel, content
end

local function card(parent: Instance, order: number, h: number?): Frame
	local f = UI.frame({ BackgroundColor3 = T.card, Size = UDim2.new(1, -8, 0, h or 70), LayoutOrder = order, ZIndex = 22, Parent = parent })
	UI.corner(f, 12)
	UI.pad(f, 10)
	return f
end

local function lbl(parent: Instance, text: string, props: any?): TextLabel
	local p = props or {}
	p.ZIndex = p.ZIndex or 23
	p.Parent = parent
	local l = UI.label(text, p)
	return l
end

local function btn(parent: Instance, text: string, color: Color3?, props: any?, fn: (() -> ())?): TextButton
	local p = props or {}
	p.ZIndex = p.ZIndex or 24
	p.Parent = parent
	return UI.button(text, color, p, fn)
end

-- ===== Pit Shop (Robux) =====
local function ownsAll(s: any, grants: { string }?): boolean
	if not grants then
		return false
	end
	for _, id in ipairs(grants) do
		if not s.owned[id] then
			return false
		end
	end
	return true
end

local function shopCard(parent: Instance, order: number, kind: string, key: string, item: any, s: any)
	local available = kind == "pass" and s.productIds.passes[key] or s.productIds.products[key]
	if not available then
		return false
	end
	local f = UI.frame({ BackgroundColor3 = T.card, LayoutOrder = order, ZIndex = 22, Parent = parent })
	UI.corner(f, 14)
	UI.pad(f, 8)
	lbl(f, item.icon, { Size = UDim2.new(1, 0, 0, 44), TextSize = 38, TextXAlignment = Enum.TextXAlignment.Center })
	lbl(f, item.name, { Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(1, 0, 0, 40), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center })
	lbl(f, item.desc, { Position = UDim2.new(0, 0, 0, 86), Size = UDim2.new(1, 0, 0, 64), TextSize = 12, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top })
	if item.valueNote then
		lbl(f, item.valueNote, { Position = UDim2.new(0, 0, 0, 150), Size = UDim2.new(1, 0, 0, 28), TextSize = 11, Font = T.body, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center })
	end
	local owned = false
	if kind == "pass" then
		owned = s.passes[key] == true
	elseif item.kind == "cosmetic" or item.kind == "bundle" then
		owned = ownsAll(s, item.grants)
	end
	local idIsZero = item.id == 0
	local text = owned and "Owned ✓" or (idIsZero and "Studio test (free)" or ("Buy for R$ " .. item.price))
	btn(f, text, owned and T.cardHi or T.green, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 36), TextSize = 15, AutoButtonColor = not owned }, function()
		if not owned then
			Net.act("Prompt", kind, key)
		end
	end)
	if not idIsZero and not owned then
		lbl(f, "R$ " .. item.price, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 60, 0, 18), TextSize = 13, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Right })
	end
	return true
end

local function renderShop(s: any)
	titleLabel.Text = "🛒 Pitmaster Outfitters"
	local sel, content = tabs(body, "shop", Monetization.ShopTabs, "This Week")
	local sf = scroller(content, true, Vector2.new(166, 236))
	local n = 0
	if sel == "Passes" then
		local keys = {}
		for k in pairs(Monetization.Passes) do
			table.insert(keys, k)
		end
		table.sort(keys, function(a, b)
			return Monetization.Passes[a].price < Monetization.Passes[b].price
		end)
		for i, k in ipairs(keys) do
			if shopCard(sf, i, "pass", k, Monetization.Passes[k], s) then
				n += 1
			end
		end
	else
		local keys = {}
		if sel == "This Week" then
			keys = table.clone(s.rotation)
		else
			for k, p in pairs(Monetization.Products) do
				if p.category == sel then
					table.insert(keys, k)
				end
			end
			table.sort(keys, function(a, b)
				return Monetization.Products[a].price < Monetization.Products[b].price
			end)
		end
		for i, k in ipairs(keys) do
			if shopCard(sf, i, "product", k, Monetization.Products[k], s) then
				n += 1
			end
		end
	end
	if n == 0 then
		lbl(sf, "Nothing here yet. Check back soon!", { Size = UDim2.new(0, 400, 0, 30) })
	end
	local foot = sel == "This Week" and "This week's looks rotate every Monday and come back in a later week. Looks only, no stats." or "Every purchase shows exactly what you get. No random items, ever. Robux never buys coins."
	lbl(body, foot, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 14), Size = UDim2.new(1, 0, 0, 18), TextSize = 12, Font = T.body, TextColor3 = T.dim })
end

-- ===== Sauce Shack (coins) =====
local EFFECT_TEXT = { luck = "luck (better rarity odds)", speed = "cook speed", tip = "tips" }

local function renderSauce(s: any)
	titleLabel.Text = "🥫 Roch & Roll Sauce Shack"
	local sf = scroller(body)
	local head = card(sf, 0, 40)
	head.BackgroundTransparency = 1
	lbl(head, string.format("New sauce in %s  •  restocks every 5 minutes  •  bought with coins only", TimeUtil.formatDuration(s.restock.nextIn)), { Size = UDim2.new(1, 0, 1, 0), TextSize = 16, TextColor3 = T.gold })
	local rm = Economy.rankMult(s.rank, Config.RANK_STEP)
	for i, e in ipairs(s.restock.shelf) do
		local def = Config.Sauces[e.id]
		local left = e.qty - (s.restock.bought[e.id] or 0)
		local price = math.floor(def.price * (1 + (rm - 1) * 0.5))
		local f = card(sf, i, 76)
		local sw = UI.frame({ BackgroundColor3 = Color3.fromHex(def.color), Size = UDim2.new(0, 40, 0, 56), ZIndex = 23, Parent = f })
		UI.corner(sw, 8)
		lbl(f, def.name, { Position = UDim2.new(0, 52, 0, 0), Size = UDim2.new(1, -220, 0, 26), TextSize = 20 })
		lbl(f, string.format("+%d%% %s for %d cooks  •  %d left in stock", math.floor(def.amount * 100), EFFECT_TEXT[def.effect], def.charges, math.max(0, left)), { Position = UDim2.new(0, 52, 0, 28), Size = UDim2.new(1, -220, 0, 24), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		btn(f, left > 0 and ("🪙 " .. UI.fmt(price)) or "Sold out", left > 0 and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 44) }, function()
			if left > 0 then
				Net.act("BuySauce", e.id)
			end
		end)
	end
	local mine = card(sf, 10, 60)
	local parts = {}
	for effect, v in pairs(s.sauces) do
		if v.charges > 0 then
			table.insert(parts, string.format("%s +%d%% (%d left)", EFFECT_TEXT[effect], math.floor(v.amount * 100), v.charges))
		end
	end
	lbl(mine, "Your sauces: " .. (#parts > 0 and table.concat(parts, "  •  ") or "none yet"), { Size = UDim2.new(1, 0, 1, 0), TextSize = 15 })
	if not sauceOdds then
		sauceOdds = Restock.appearOdds(Config.Sauces, Config.SauceOrder, Config.RESTOCK_SLOTS, 1500)
	end
	local odds = card(sf, 11, 90)
	local lines = {}
	for _, id in ipairs(Config.SauceOrder) do
		table.insert(lines, string.format("%s %.0f%%", Config.Sauces[id].name, (sauceOdds :: any)[id]))
	end
	lbl(odds, "Chance each sauce is on the shelf in a restock:\n" .. table.concat(lines, "  •  "), { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body, TextColor3 = T.dim })
end

-- ===== Cook picker =====
local function meatLocked(s: any, meat: any): string?
	if meat.hidden then
		return "hidden"
	end
	if meat.season and meat.season ~= s.season.id then
		return "Seasonal: back next " .. meat.season
	end
	if s.pitLevel < meat.unlockPit then
		return "Needs " .. Config.PitLevels[meat.unlockPit].name
	end
	if meat.premium then
		local has = s.passes.PremiumCuts or (s.cuts[meat.id] or 0) > 0 or (meat.id == "tomahawk" and s.unlocks.tomahawk)
		if not has then
			return "Premium cut (Path reward or Pit Shop)"
		end
	end
	return nil
end

local function renderCook(s: any)
	local key = currentArg :: string
	local kind = string.sub(key, 1, 1) == "s" and "smoker" or "grill"
	titleLabel.Text = (kind == "smoker" and "🔥 Smoker " or "🍔 Grill ") .. string.sub(key, 2) .. ": what are we cooking?"
	local sf = scroller(body)
	local rm = Economy.rankMult(s.rank, Config.RANK_STEP)
	local pit = Config.PitLevels[s.pitLevel]
	local luck = pit.luck * (1 + (s.sauces.luck.charges > 0 and s.sauces.luck.amount or 0))
	local order = 0
	for _, id in ipairs(Config.MeatOrder) do
		local meat = Config.Meats[id]
		if meat.station == kind and not (meat.season and meat.season ~= s.season.id) then
			order += 1
			local why = meatLocked(s, meat)
			local f = card(sf, order, 74)
			lbl(f, meat.icon, { Size = UDim2.new(0, 50, 1, 0), TextSize = 36 })
			local secs = meat.cookTime / pit.speed
			local tokens = meat.premium and not s.passes.PremiumCuts and (s.cuts[id] or 0) > 0 and string.format("  •  you have %d", s.cuts[id]) or ""
			lbl(f, meat.name, { Position = UDim2.new(0, 56, 0, 0), Size = UDim2.new(1, -230, 0, 26), TextSize = 20 })
			lbl(f, string.format("%s  •  sells ~%s 🪙%s", TimeUtil.formatDuration(secs), UI.fmt(meat.price * rm), tokens), { Position = UDim2.new(0, 56, 0, 28), Size = UDim2.new(1, -230, 0, 22), TextSize = 14, Font = T.body, TextColor3 = T.dim })
			local cost = Economy.rawCost(meat, rm)
			btn(f, why and "🔒" or (cost > 0 and ("Cook 🪙" .. UI.fmt(cost)) or "Cook (free)"), why and T.cardHi or T.accent, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 44) }, function()
				if why then
					Net.notify(why, "info")
					return
				end
				if Net.act("StartCook", key, id) then
					Panels.close()
				end
			end)
			if why then
				lbl(f, why, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -170, 1, 4), Size = UDim2.new(0, 260, 0, 18), TextSize = 12, Font = T.body, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Right })
			end
		end
	end
	local odds = Rarity.odds(Config.Rarities, luck, nil)
	local parts = {}
	for _, o in ipairs(odds) do
		table.insert(parts, string.format("%s %.1f%%", o.name, o.pct))
	end
	local f = card(sf, 99, 64)
	lbl(f, "Rarity odds right now (set when you start the cook):\n" .. table.concat(parts, "  •  ") .. (kind == "grill" and "\nBurgers top out at Smoke Ring Gold." or ""), { Size = UDim2.new(1, 0, 1, 0), TextSize = 13, Font = T.body, TextColor3 = T.dim })
end

-- ===== Index =====
local function renderIndex(s: any)
	titleLabel.Text = "📖 Index"
	local sel, content = tabs(body, "index", { "Regulars", "Cuts", "Secrets" }, "Regulars")
	if sel == "Regulars" then
		local sf = scroller(content, true, Vector2.new(166, 120))
		local odds = Rarity.weightedOdds(Config.Critters)
		for i, c in ipairs(Config.Critters) do
			local met = (s.critters[c.id] or 0) > 0
			local f = UI.frame({ BackgroundColor3 = met and T.card or T.panel, LayoutOrder = i, ZIndex = 22, Parent = sf })
			UI.corner(f, 12)
			UI.pad(f, 8)
			local sw = UI.frame({ BackgroundColor3 = met and Color3.fromHex(c.body) or Color3.fromHex("#222222"), Size = UDim2.new(0, 30, 0, 30), ZIndex = 23, Parent = f })
			UI.corner(sw, 15)
			lbl(f, met and c.name or "???", { Position = UDim2.new(0, 38, 0, 0), Size = UDim2.new(1, -38, 0, 34), TextSize = 15 })
			lbl(f, string.format("%s\nAppears %.1f%%  •  tips x%.1f", met and ("Served " .. s.critters[c.id] .. "x") or "Not met yet", odds[c.id] or 0, c.tip), { Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, 0, 0, 50), TextSize = 12, Font = T.body, TextColor3 = T.dim })
		end
	elseif sel == "Cuts" then
		local sf = scroller(content)
		local rarOdds = Rarity.odds(Config.Rarities, Config.PitLevels[s.pitLevel].luck, nil)
		for i, id in ipairs(Config.MeatOrder) do
			local meat = Config.Meats[id]
			local f = card(sf, i, 44)
			lbl(f, meat.icon .. " " .. meat.name, { Size = UDim2.new(0, 220, 1, 0), TextSize = 16 })
			local row = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 230, 0, 0), Size = UDim2.new(1, -230, 1, 0), ZIndex = 23, Parent = f })
			UI.list(row, Enum.FillDirection.Horizontal, 6)
			for ri, r in ipairs(Config.Rarities) do
				if ri <= meat.maxRarity then
					local got = s.cutsIndex[id .. ":" .. r.id]
					local chip = UI.label(got and r.name or "?", { Size = UDim2.new(0, 84, 1, 0), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = got and 0 or 0.7, BackgroundColor3 = Color3.fromHex(r.color), TextColor3 = got and Color3.fromHex("#1A0F0A") or T.dim, LayoutOrder = ri, ZIndex = 24, Parent = row })
					UI.corner(chip, 8)
				end
			end
		end
		local parts = {}
		for _, o in ipairs(rarOdds) do
			table.insert(parts, string.format("%s %.1f%%", o.name, o.pct))
		end
		local f = card(sf, 100, 50)
		lbl(f, "Odds at your pit level: " .. table.concat(parts, "  •  "), { Size = UDim2.new(1, 0, 1, 0), TextSize = 13, Font = T.body, TextColor3 = T.dim })
	else
		local sf = scroller(content)
		local n = 0
		for i, e in ipairs(EGGS) do
			local found = s.eggs[e.id] == true
			if found then
				n += 1
			end
			local f = card(sf, i + 1, 44)
			lbl(f, (found and "✅ " or "❔ ") .. (found and string.upper(e.id) .. ": found!" or e.hint), { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body })
		end
		local h = card(sf, 0, 36)
		h.BackgroundTransparency = 1
		lbl(h, string.format("Secrets found: %d / %d", n, #EGGS), { Size = UDim2.new(1, 0, 1, 0), TextSize = 18, TextColor3 = T.gold })
	end
end

-- ===== Pitmaster Path =====
local function rewardText(r: any): string
	local parts = {}
	if r.coins then
		table.insert(parts, UI.fmt(r.coins) .. " coins")
	end
	if r.sauce then
		table.insert(parts, Config.Sauces[r.sauce].name)
	end
	if r.cosmetic then
		table.insert(parts, Config.Cosmetics[r.cosmetic].name)
	end
	if r.boostMinutes then
		table.insert(parts, r.boostMinutes .. " min x2 speed")
	end
	if r.wagyu then
		table.insert(parts, r.wagyu .. " Wagyu Brisket")
	end
	if r.title then
		table.insert(parts, "Title: " .. r.title)
	end
	if r.rex then
		table.insert(parts, "a very special visitor 🦖")
	end
	if r.tomahawk then
		table.insert(parts, "Tomahawk Steaks forever")
	end
	return table.concat(parts, " + ")
end

local function renderPath(s: any)
	titleLabel.Text = "🗺️ Pitmaster Path (28 days)"
	local sf = scroller(body)
	local st = s.pathStatus
	local head = card(sf, 0, 44)
	head.BackgroundTransparency = 1
	lbl(head, string.format("Play days: %d  •  Steps claimed: %d / %d  •  a new step unlocks each day you play", s.path.playDays, s.path.claimed, #Config.PathSteps), { Size = UDim2.new(1, 0, 1, 0), TextSize = 15, TextColor3 = T.gold })
	for i, step in ipairs(Config.PathSteps) do
		local f = card(sf, i, 58)
		local claimed = i <= s.path.claimed
		local isCur = i == st.step
		f.BackgroundColor3 = claimed and T.cardHi or (isCur and T.card or T.panel)
		lbl(f, string.format("Day %d: %s", i, step.label), { Size = UDim2.new(1, -170, 0, 22), TextSize = 16 })
		lbl(f, "Reward: " .. rewardText(step.reward), { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, -170, 0, 18), TextSize = 12, Font = T.body, TextColor3 = T.dim })
		if claimed then
			lbl(f, "✅ Done", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 30), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.green })
		elseif isCur then
			if st.complete then
				btn(f, "Claim!", T.green, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 38) }, function()
					Net.act("ClaimPath")
				end)
			elseif not st.unlocked then
				lbl(f, "Unlocks on play day " .. i, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 30), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.dim })
			else
				lbl(f, string.format("%d / %d", st.progress, st.amount), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 30), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.gold })
			end
		else
			lbl(f, "🔒", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 60, 0, 30), TextXAlignment = Enum.TextXAlignment.Right })
		end
	end
	if freshOpen then
		task.defer(function()
			sf.CanvasPosition = Vector2.new(0, math.max(0, (st.step - 3) * 66))
		end)
	end
end

-- ===== Upgrades & Unc Status =====
local function renderUpgrades(s: any)
	titleLabel.Text = "⬆️ Upgrades & Unc Status"
	local sf = scroller(body)
	local pit = Config.PitLevels[s.pitLevel]
	local nextPit = Config.PitLevels[s.pitLevel + 1]
	local f1 = card(sf, 1, 80)
	lbl(f1, "Pit: " .. pit.name, { Size = UDim2.new(1, -180, 0, 26), TextSize = 20 })
	lbl(f1, nextPit and string.format("Next: %s  •  speed x%.2f -> x%.2f  •  luck x%.2f -> x%.2f  •  unlocks new meats", nextPit.name, pit.speed, nextPit.speed, pit.luck, nextPit.luck) or "Maxed out! Time for Unc Status.", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, -180, 0, 34), TextSize = 13, Font = T.body, TextColor3 = T.dim })
	if nextPit then
		btn(f1, "🪙 " .. UI.fmt(nextPit.cost), s.coins >= nextPit.cost and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 44) }, function()
			Net.act("UpgradePit")
		end)
	end
	for i, kind in ipairs({ "smoker", "grill" }) do
		local def = Config.Slots[kind]
		local cap = kind == "smoker" and Config.MAX_SMOKERS or Config.MAX_GRILLS
		local cost = Economy.nextSlotCost(def.costs, s.bought[kind])
		local f = card(sf, 1 + i, 64)
		lbl(f, string.format("%s slots: %d / %d", kind == "smoker" and "Smoker" or "Grill", s.slots[kind], cap), { Size = UDim2.new(1, -180, 0, 26), TextSize = 18 })
		lbl(f, kind == "smoker" and "More smokers = more meat smoking while you're away." or "More grill spots = more burgers at once.", { Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, -180, 0, 20), TextSize = 13, Font = T.body, TextColor3 = T.dim })
		if cost and s.slots[kind] < cap then
			btn(f, "🪙 " .. UI.fmt(cost), s.coins >= cost and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 40) }, function()
				Net.act("BuySlot", kind)
			end)
		end
	end
	local nextRank = Config.Ranks[s.rank + 1]
	local f4 = card(sf, 5, 120)
	f4.BackgroundColor3 = Color3.fromHex("#4A3A1A")
	lbl(f4, "👴 Unc Status: " .. Config.Ranks[s.rank].name, { Size = UDim2.new(1, -180, 0, 28), TextSize = 22, TextColor3 = T.gold })
	if nextRank then
		lbl(f4, string.format("Rebirth into %s: +%d%% coins forever. Resets coins, pit and slots. Keeps cosmetics, Index, sauces, titles, passes and your cooler. Unfinished cooks are refunded.", nextRank.name, math.floor(Config.RANK_STEP * 100)), { Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, -180, 0, 50), TextSize = 13, Font = T.body, TextColor3 = T.dim })
		local back, fill = UI.bar(f4, T.gold, { Position = UDim2.new(0, 0, 0, 86), Size = UDim2.new(1, -180, 0, 12), ZIndex = 23 })
		fill.ZIndex = 24
		fill.Size = UDim2.fromScale(math.clamp(s.runCoins / nextRank.need, 0, 1), 1)
		lbl(f4, UI.fmt(s.runCoins) .. " / " .. UI.fmt(nextRank.need) .. " earned this run", { Position = UDim2.new(0, 0, 0, 98), Size = UDim2.new(1, -180, 0, 16), TextSize = 12, Font = T.body })
		local _ = back
		btn(f4, "Rebirth", s.runCoins >= nextRank.need and T.gold or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 50), TextColor3 = Color3.fromHex("#1A0F0A") }, function()
			Net.act("Rebirth")
		end)
	else
		lbl(f4, "You're OG Pitmaster. Nothing left but respect.", { Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, -20, 0, 30), TextSize = 15 })
	end
end

-- ===== Daily =====
local function renderDaily(s: any)
	titleLabel.Text = "🎁 Daily Smoke"
	local wrap = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 21, Parent = body })
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 130), ZIndex = 21, Parent = wrap })
	UI.list(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	local count = s.streak.count
	local nextDay = s.canClaimDaily and ((count % 7) + 1) or (((count - 1) % 7) + 1)
	for i, r in ipairs(Config.DailyRewards) do
		local isNext = i == nextDay and s.canClaimDaily
		local done = (not s.canClaimDaily and i <= nextDay) or (s.canClaimDaily and i < nextDay)
		local f = UI.frame({ BackgroundColor3 = isNext and T.accent or (done and T.cardHi or T.card), Size = UDim2.new(0, 92, 0, 124), LayoutOrder = i, ZIndex = 22, Parent = row })
		UI.corner(f, 12)
		UI.pad(f, 6)
		lbl(f, "Day " .. i, { Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
		lbl(f, i == 7 and "🎁" or "🪙", { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 40), TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center })
		local txt = UI.fmt(r.coins)
		if r.sauce then
			txt ..= "\n+ " .. Config.Sauces[r.sauce].name
		end
		if r.boostMinutes then
			txt ..= "\n+ " .. r.boostMinutes .. "m x2"
		end
		lbl(f, txt, { Position = UDim2.new(0, 0, 0, 62), Size = UDim2.new(1, 0, 0, 50), TextSize = 11, Font = T.body, TextXAlignment = Enum.TextXAlignment.Center })
		if done then
			lbl(f, "✓", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 20, 0, 20), TextColor3 = T.green })
		end
	end
	lbl(wrap, string.format("🔥 Streak: %d days (best %d). Miss a day? Your free miss each week keeps it going. Miss more and you only go back to the start of this week, never zero.", count, s.streak.best), { Position = UDim2.new(0, 0, 0, 140), Size = UDim2.new(1, 0, 0, 44), TextSize = 14, Font = T.body, TextColor3 = T.dim, ZIndex = 22 })
	btn(wrap, s.canClaimDaily and "Claim today's reward!" or "Come back tomorrow (Texas time)", s.canClaimDaily and T.green or T.cardHi, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 196), Size = UDim2.new(0, 340, 0, 54), TextSize = 22 }, function()
		if s.canClaimDaily then
			Net.act("ClaimDaily")
		end
	end)
	btn(wrap, "👴 Hear Unc Hank's joke of the day", T.blue, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262), Size = UDim2.new(0, 340, 0, 44), TextSize = 17 }, function()
		Net.act("HearJoke")
	end)
	lbl(wrap, "Also today: 🧪 sauce restocks every 5 min  •  🏆 Saturday Cook-Off  •  🫧 Suds weekend pups  •  🦟 mosquitoes at dusk", { Position = UDim2.new(0, 0, 0, 320), Size = UDim2.new(1, 0, 0, 40), TextSize = 13, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 22 })
end

-- ===== Settings / Fits / Titles =====
local SLOT_LABEL = { hat = "Hat", apron = "Apron", tool = "Tool", neck = "Bandana", feet = "Feet", trail = "Trail", skin = "Smoker skin", smoke = "Smoke color", patio = "Patio" }

local function renderSettings(s: any)
	titleLabel.Text = "⚙️ Settings & Fits"
	local sel, content = tabs(body, "settings", { "Fits", "Titles", "Game" }, "Fits")
	local sf = scroller(content)
	if sel == "Fits" then
		local order = 0
		for _, slot in ipairs(Config.CosmeticSlots) do
			local owned = {}
			for id, def in pairs(Config.Cosmetics) do
				if def.slot == slot and s.owned[id] then
					table.insert(owned, id)
				end
			end
			table.sort(owned)
			order += 1
			local f = card(sf, order, 70)
			lbl(f, SLOT_LABEL[slot] or slot, { Size = UDim2.new(0, 120, 0, 24), TextSize = 16 })
			local row = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 120, 0, 0), Size = UDim2.new(1, -120, 1, 0), AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 4, ZIndex = 23, Parent = f })
			UI.list(row, Enum.FillDirection.Horizontal, 6)
			if #owned == 0 then
				lbl(row, "None yet. Earn them on the Path, at events, or in the Pit Shop.", { Size = UDim2.new(0, 420, 1, 0), TextSize = 13, Font = T.body, TextColor3 = T.dim })
			else
				btn(row, "None", s.equipped[slot] == nil and T.accent or T.cardHi, { Size = UDim2.new(0, 70, 0, 40), TextSize = 13, LayoutOrder = 0 }, function()
					Net.act("Equip", slot, "")
				end)
				for i, id in ipairs(owned) do
					local def = Config.Cosmetics[id]
					local b = btn(row, def.name, s.equipped[slot] == id and T.accent or T.cardHi, { Size = UDim2.new(0, 150, 0, 40), TextSize = 13, LayoutOrder = i }, function()
						Net.act("Equip", slot, id)
					end)
					local sw = UI.frame({ BackgroundColor3 = Color3.fromHex(def.color), Size = UDim2.new(0, 10, 1, -10), Position = UDim2.new(0, 4, 0, 5), ZIndex = 25, Parent = b })
					UI.corner(sw, 4)
				end
			end
		end
	elseif sel == "Titles" then
		local list = {}
		for t in pairs(s.titles) do
			table.insert(list, t)
		end
		table.sort(list)
		local f0 = card(sf, 0, 44)
		btn(f0, "Show rank (" .. Config.Ranks[s.rank].name .. ")", s.title == "" and T.accent or T.cardHi, { Size = UDim2.new(0, 300, 1, 0), TextSize = 15 }, function()
			Net.act("SetTitle", "")
		end)
		for i, t in ipairs(list) do
			local f = card(sf, i, 44)
			btn(f, t, s.title == t and T.accent or T.cardHi, { Size = UDim2.new(0, 300, 1, 0), TextSize = 15 }, function()
				Net.act("SetTitle", t)
			end)
		end
		if #list == 0 then
			local f = card(sf, 1, 40)
			lbl(f, "Earn titles from the Path, secrets and Unc Status.", { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body })
		end
	else
		local f = card(sf, 1, 90)
		lbl(f, "🕊️ Peace Mode: " .. (s.settings.peace and "ON" or "OFF"), { Size = UDim2.new(1, -180, 0, 26), TextSize = 20 })
		lbl(f, "When on, nobody can snag plates from your pass window, and you can't snag theirs. You can switch once a minute.", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, -180, 0, 40), TextSize = 13, Font = T.body, TextColor3 = T.dim })
		btn(f, s.settings.peace and "Turn off" or "Turn on", s.settings.peace and T.cardHi or T.green, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 44) }, function()
			Net.act("SetPeace", not s.settings.peace)
		end)
		local f2 = card(sf, 2, 70)
		lbl(f2, string.format("🤝 Crew bonus: +%d%% (%d friend%s here)", math.floor(s.crew * Config.Crew.perFriend * 100 + 0.5), s.crew, s.crew == 1 and "" or "s"), { Size = UDim2.new(1, -180, 0, 26), TextSize = 18 })
		lbl(f2, "Each friend in your server gives +10% coins (up to 3).", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, -180, 0, 20), TextSize = 13, Font = T.body, TextColor3 = T.dim })
		btn(f2, "👋 Invite friends", T.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 44) }, function()
			Panels.invite()
		end)
		local f3 = card(sf, 3, 60)
		lbl(f3, s.memoryOnly and "⚠️ Studio test mode: progress is NOT saved." or "💾 Your ranch saves automatically. Smokers keep cooking while you're away.", { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body })
	end
end

-- ===== Dialog (NPCs) =====
local dialogFrame: Frame? = nil

function Panels.dialog(payload: any)
	if dialogFrame then
		dialogFrame:Destroy()
	end
	local f = UI.frame({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -180), Size = UDim2.new(0, 620, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.bg, ZIndex = 30, Parent = screen })
	dialogFrame = f
	UI.corner(f, 16)
	UI.stroke(f, T.gold, 3)
	UI.pad(f, 14)
	UI.list(f, nil, 8)
	UI.label(payload.npc or "", { TextSize = 22, TextColor3 = T.gold, ZIndex = 31, LayoutOrder = 1, Parent = f })
	local text = UI.label(payload.text or "", { TextSize = 17, Font = T.body, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), ZIndex = 31, LayoutOrder = 2, Parent = f })
	local yap: TextLabel? = nil
	if payload.yap then
		yap = UI.label("", { TextSize = 14, Font = T.body, TextColor3 = T.dim, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), ZIndex = 31, LayoutOrder = 3, Parent = f })
	end
	if (payload.reward or 0) > 0 then
		UI.label("+" .. UI.fmt(payload.reward) .. " 🪙", { TextSize = 20, TextColor3 = T.gold, ZIndex = 31, LayoutOrder = 4, Parent = f })
	end
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), ZIndex = 31, LayoutOrder = 5, Parent = f })
	UI.list(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
	local skipped = false
	if yap then
		local yl = yap :: TextLabel
		local skip = UI.button(Content.Slang.skipYap .. " ⏭", T.cardHi, { Size = UDim2.new(0, 160, 0, 40), ZIndex = 32, LayoutOrder = 1, Parent = row })
		skip.Activated:Connect(function()
			skipped = true
			yl.Text = "(Yap skipped. Unc is a little hurt.)"
			skip:Destroy()
		end)
		task.spawn(function()
			local full = "Unc keeps going: " .. payload.yap
			for i = 1, #full do
				if skipped or not yl.Parent then
					return
				end
				yl.Text = string.sub(full, 1, i)
				task.wait(0.025)
			end
		end)
	end
	UI.button("OK", T.green, { Size = UDim2.new(0, 100, 0, 40), ZIndex = 32, LayoutOrder = 2, Parent = row }, function()
		f:Destroy()
		if dialogFrame == f then
			dialogFrame = nil
		end
	end)
	local _ = text
	task.delay(20, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

function Panels.welcome(payload: any)
	if payload.isNew then
		Panels.dialog({ npc = "Unc Hank", text = "Hi Hungry, I'm Unc! Welcome to Backyard Smokeout.\n\nHere's how it works: brisket and ribs smoke for real hours (even while you're offline), burgers take 30 seconds on the grill. Serve the critters, upgrade your pit, find the secrets.\n\nHit the big orange button to smoke your first brisket. It only takes a minute this time. 😉" })
	elseif payload.away and payload.ready and payload.ready > 0 then
		Panels.dialog({ npc = "Unc Hank", text = string.format("Welcome back! You were gone %s and %d meat%s finished smoking. They're resting in the smoker, ready to collect.", TimeUtil.formatDuration(payload.away), payload.ready, payload.ready == 1 and "" or "s") })
	end
end

function Panels.render()
	if not current or not window.Visible then
		return
	end
	local s = S()
	if not s then
		return
	end
	lastRender = os.clock()
	-- keep scroll position across live refreshes
	local oldScroll: Vector2? = nil
	for _, d in ipairs(body:GetDescendants()) do
		if d:IsA("ScrollingFrame") and d.ScrollingDirection == Enum.ScrollingDirection.Y then
			oldScroll = d.CanvasPosition
			break
		end
	end
	UI.clear(body)
	local ok, err = pcall(function()
		if current == "shop" then
			renderShop(s)
		elseif current == "sauce" then
			renderSauce(s)
		elseif current == "cook" then
			renderCook(s)
		elseif current == "index" then
			renderIndex(s)
		elseif current == "path" then
			if freshOpen then
				oldScroll = nil
			end
			renderPath(s)
		elseif current == "upgrades" then
			renderUpgrades(s)
		elseif current == "daily" then
			renderDaily(s)
		elseif current == "settings" then
			renderSettings(s)
		end
	end)
	if not ok then
		warn("[Panels] " .. tostring(err))
	end
	local wasFresh = freshOpen
	freshOpen = false
	if oldScroll and not wasFresh then
		for _, d in ipairs(body:GetDescendants()) do
			if d:IsA("ScrollingFrame") and d.ScrollingDirection == Enum.ScrollingDirection.Y then
				d.CanvasPosition = oldScroll
				break
			end
		end
	end
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny UI kit: everything is built in code, so no uploaded images are needed.
local UI = {}

UI.Theme = {
	-- "Smoked Sunset" palette (see the plan page's Color & Look section). Warm, saturated
	-- action colors on deep smoked-chocolate panels; every button color keeps >= 3:1 with its
	-- label (WCAG large-text / UI-component minimum) and body text stays above 7:1.
	bg = Color3.fromHex("#24150E"),
	panel = Color3.fromHex("#3A2418"),
	card = Color3.fromHex("#4D301F"),
	cardHi = Color3.fromHex("#643F28"),
	accent = Color3.fromHex("#E8590C"), -- ember orange (white label 3.6:1)
	gold = Color3.fromHex("#FFC83C"), -- Robux/premium (dark label 11.8:1)
	green = Color3.fromHex("#1E9E4A"), -- go / collect (white label 3.5:1)
	red = Color3.fromHex("#D93636"), -- danger (white label 4.6:1)
	blue = Color3.fromHex("#2F7BD8"), -- info / social (white label 4.3:1)
	text = Color3.fromHex("#FFF6E6"), -- 13.5:1 on panel
	dim = Color3.fromHex("#D9C4A8"), -- 8.6:1 on panel
	font = Enum.Font.FredokaOne,
	body = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
}
local T = UI.Theme

type Props = { [string]: any }

function UI.new(className: string, props: Props?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(parent: Instance, r: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 12), Parent = parent })
end

function UI.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return UI.new("UIStroke", { Color = color or Color3.fromHex("#1A0F0A"), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

function UI.pad(parent: Instance, px: number)
	return UI.new("UIPadding", { PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), Parent = parent })
end

function UI.list(parent: Instance, dir: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		Parent = parent,
	})
end

function UI.frame(props: Props): Frame
	local f = UI.new("Frame", {
		BackgroundColor3 = T.panel,
		BorderSizePixel = 0,
	})
	for k, v in pairs(props) do
		(f :: any)[k] = v
	end
	return f
end

function UI.label(text: string, props: Props?): TextLabel
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.text,
		Font = T.font,
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 24),
	})
	if props then
		for k, v in pairs(props) do
			(l :: any)[k] = v
		end
	end
	return l
end

function UI.button(text: string, color: Color3?, props: Props?, onClick: (() -> ())?): TextButton
	local b = UI.new("TextButton", {
		Text = text,
		BackgroundColor3 = color or T.accent,
		TextColor3 = Color3.new(1, 1, 1),
		Font = T.font,
		TextSize = 18,
		AutoButtonColor = true,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 140, 0, 40),
	})
	if props then
		for k, v in pairs(props) do
			(b :: any)[k] = v
		end
	end
	UI.corner(b, 10)
	UI.stroke(b, Color3.fromHex("#1A0F0A"), 2)
	UI.new("UITextSizeConstraint", { MaxTextSize = b.TextSize, Parent = b })
	if onClick then
		local busy = false
		b.Activated:Connect(function()
			if busy then
				return
			end
			busy = true
			task.spawn(function()
				local ok, err = pcall(function(): any
					(onClick :: any)()
					return nil
				end)
				if not ok then
					warn(err)
				end
				busy = false
			end)
		end)
	end
	return b
end

function UI.bar(parent: Instance, color: Color3, props: Props?): (Frame, Frame)
	local back = UI.frame({ BackgroundColor3 = Color3.fromHex("#1A0F0A"), Size = UDim2.new(1, 0, 0, 10), Parent = parent })
	if props then
		for k, v in pairs(props) do
			(back :: any)[k] = v
		end
	end
	UI.corner(back, 5)
	local fill = UI.frame({ BackgroundColor3 = color, Size = UDim2.new(0, 0, 1, 0), Parent = back })
	UI.corner(fill, 5)
	return back, fill
end

function UI.fmt(n: number): string
	n = math.floor(n)
	if n >= 1e9 then
		return string.format("%.2fB", n / 1e9)
	elseif n >= 1e6 then
		return string.format("%.2fM", n / 1e6)
	elseif n >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	end
	local s = tostring(n)
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function UI.clear(parent: Instance)
	for _, c in ipairs(parent:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") and not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">WorldClient</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side world bits: which prompts you see, prompts that open UI, the trampoline,
-- the "Unc is resting his eyes" AFK tag, and live countdowns on your own smokers.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CaptureService = game:GetService("CaptureService")

local Net = require(script.Parent.Net)
local Hud = require(script.Parent.Hud)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local TimeUtil = require(Shared.Logic.TimeUtil)

local player = Players.LocalPlayer
local WorldClient = {}

-- "Say Brisket!" photo spot: grab a screenshot and open the native share sheet (falls back
-- to a save prompt where sharing isn't allowed). Everything is pcall'd: older clients just
-- get a friendly toast.
function WorldClient.photo()
	Net.notify("📸 Say BRISKET!", "good")
	task.delay(0.6, function()
		local ok = pcall(function()
			(CaptureService :: any):TakeScreenshotCaptureAsync(function(_result: any, capture: any)
				if capture then
					pcall(function()
						(CaptureService :: any):PromptShareCapture(Content.fromObject(capture), "bertha", function() end, function() end)
					end)
				end
			end, {})
		end)
		if not ok then
			Net.notify("Photos aren't available on this device. Use the Roblox menu's screenshot button!", "info")
		end
	end)
end

-- Prompts that only the owner should see, and the snag prompt the owner should NOT see.
local OWNER_ONLY = { serve = true, bellyrub = true, wash = true, catch = true }

local function shouldHide(prompt: ProximityPrompt): boolean
	local kind = prompt:GetAttribute("Kind")
	local owner = prompt:GetAttribute("OwnerUserId")
	if typeof(kind) ~= "string" then
		return false
	end
	if OWNER_ONLY[kind] then
		return owner ~= player.UserId
	end
	if kind == "snag" then
		return owner == player.UserId or (Net.state and Net.state.settings.peace)
	end
	return false
end

local function watchPrompt(prompt: ProximityPrompt)
	local function apply()
		if shouldHide(prompt) and prompt.Enabled then
			prompt.Enabled = false
		end
	end
	apply()
	prompt:GetPropertyChangedSignal("Enabled"):Connect(apply)
	prompt:GetAttributeChangedSignal("OwnerUserId"):Connect(apply)
end

function WorldClient.start(Panels: any)
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			watchPrompt(d)
		end
	end
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			watchPrompt(d)
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local kind = prompt:GetAttribute("Kind")
		if kind == "ui:sauce" then
			Panels.open("sauce")
		elseif kind == "ui:pitshop" then
			Panels.open("shop")
		elseif kind == "npc:unc" then
			Net.act("HearJoke")
		elseif kind == "ui:photo" then
			WorldClient.photo()
		end
	end)

	-- Trampoline: big bounce (that's how you reach the Sauce Shack roof).
	local lastBounce = 0
	local function hookChar(char: Model)
		local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
		local hrp = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		if not hum or not hrp then
			return
		end
		hrp.Touched:Connect(function(hit)
			local power = hit:GetAttribute("Bounce")
			if typeof(power) == "number" and os.clock() - lastBounce > 0.4 then
				lastBounce = os.clock()
				local v = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
			end
		end)
	end
	if player.Character then
		task.spawn(hookChar, player.Character)
	end
	player.CharacterAdded:Connect(hookChar)

	-- AFK: "Unc is resting his eyes"
	local lastInput = os.clock()
	local resting = false
	UserInputService.InputBegan:Connect(function()
		lastInput = os.clock()
	end)
	UserInputService.TouchStarted:Connect(function()
		lastInput = os.clock()
	end)
	task.spawn(function()
		while true do
			task.wait(2)
			local idle = os.clock() - lastInput > Config.RESTING_IDLE_SECONDS
			if idle ~= resting then
				resting = idle
				Net.act("SetResting", resting)
			end
		end
	end)

	-- Live countdowns on your own smokers' billboards.
	task.spawn(function()
		while true do
			task.wait(0.5)
			local s = Net.state
			local map = workspace:FindFirstChild("Map")
			if s and s.plot and map then
				local plot = map.Plots:FindFirstChild("Plot" .. s.plot)
				if plot then
					for key, st in pairs(s.stations) do
						if string.sub(key, 1, 1) == "s" then
							local sm = plot.Smokers:FindFirstChild(key)
							local gui = sm and sm.Barrel:FindFirstChild("SlotGui")
							local label = gui and gui:FindFirstChild("Text") :: TextLabel?
							if label then
								local _, remaining, done = Hud.view(st, s.boost)
								local meat = Config.Meats[st.meat]
								label.Text = meat.icon .. " " .. meat.name .. (done and "\n✅ Ready!" or ("\n" .. TimeUtil.formatDuration(remaining)))
							end
						end
					end
				end
			end
		end
	end)
end

return WorldClient
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
