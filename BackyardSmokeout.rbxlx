local GameService = {}
local ctx: any = nil
local rng = Random.new()

type Runtime = {
	plot: number?,
	passes: { [string]: boolean },
	sessionStart: number,
	lastActive: number,
	nudged: boolean,
	dirty: boolean,
	today: number,
	crew: number,
	customers: { any },
	nextCustomerId: number,
	nextSpawn: number,
	lastAutoServe: number,
	snagLockUntil: number,
	snagCooldownUntil: number,
	peaceChangedAt: number,
	resting: boolean,
	cookoffReadyAt: number,
	announcedDone: { [string]: boolean },
	rush: any,
	earns: { any },
	staffNext: { [string]: number },
	staffJob: { [string]: string },
	eventNoteDue: boolean,
	crewBank: number,
	crewNext: { [string]: number },
	offlineCrew: number,
	offlineTipPaid: boolean,
	cheerUntil: { [number]: number },
	cheerCooldown: { [string]: number },
}

GameService.runtime = {} :: { [Player]: Runtime }

local globalLimiter = RateLimiter.new(25, 12) -- any action: burst 25, 12/sec sustained
local actionLimiter = RateLimiter.new(6, 3) -- per (player, action)
local acting: { [Player]: boolean } = {} -- blocks a second remote while the first is yielding

local function T(): number
	return workspace:GetServerTimeNow()
end

local function today(): number
	return TimeUtil.dayNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

local function weekday(): number
	return TimeUtil.weekday(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

GameService.weekday = weekday

function GameService.currentSeason(): any
	return CookOff.seasonFor(Config.Seasons, TimeUtil.month(os.time(), Config.TIMEZONE_OFFSET_HOURS))
end

function GameService.isSaturday(): boolean
	return CookOff.isSaturday(weekday())
end

function GameService.isSudsWeekend(): boolean
	return CookOff.isSudsWeekend(weekday())
end

function GameService.isSunday(): boolean
	return weekday() == 1
end

-- Turkey Day Smokeout window (Thanksgiving week, Texas time). In Studio, the workspace attribute
-- ForceTurkeyDay = true turns it on any day so it can be tested.
function GameService.turkeyWeek(): Holiday.Week
	local w = Holiday.turkeyWeek(today(), Config.TurkeyDay.daysBefore, Config.TurkeyDay.daysAfter)
	if not w.active and RunService:IsStudio() and workspace:GetAttribute("ForceTurkeyDay") == true then
		w.active = true
	end
	return w
end

-- Holiday Smokeout window (Dec 19 - Jan 1, Texas time). In Studio, the workspace attribute
-- ForceHolidaySmokeout = true turns it on any day so it can be tested.
function GameService.holidayWeek(): Holiday.Week
	local H = Config.HolidaySmokeout
	local w = Holiday.dateWindow(today(), H.start, H.finish, H.peak)
	if not w.active and RunService:IsStudio() and workspace:GetAttribute("ForceHolidaySmokeout") == true then
		w.active = true
	end
	return w
end

-- Which date-gated event shops are open right now (Storefront.events).
function GameService.activeEvents(): { [string]: boolean }
	return { [Config.TurkeyDay.id] = GameService.turkeyWeek().active, [Config.HolidaySmokeout.id] = GameService.holidayWeek().active }
end

-- The potluck event that's on right now (config, copy, window), or nil. The dates never overlap;
-- if both are forced on in Studio, Turkey Day wins.
function GameService.potluckEvent(): (any?, any?, Holiday.Week?)
	local tw = GameService.turkeyWeek()
	if tw.active then
		return Config.TurkeyDay, Content.TurkeyDay, tw
	end
	local hw = GameService.holidayWeek()
	if hw.active then
		return Config.HolidaySmokeout, Content.HolidaySmokeout, hw
	end
	return nil, nil, nil
end

-- The potluck event opening within the next `Config.EventTeaserDays` days (config, copy, window),
-- or nil. Nothing is on yet; this only drives a "coming up" sign and a one-line login note.
function GameService.upcomingPotluck(): (any?, any?, Holiday.Week?)
	if GameService.potluckEvent() then
		return nil, nil, nil
	end
	local d = today()
	local tw = GameService.turkeyWeek()
	if Holiday.soon(d, tw, Config.EventTeaserDays) then
		return Config.TurkeyDay, Content.TurkeyDay, tw
	end
	local hw = GameService.holidayWeek()
	if Holiday.soon(d, hw, Config.EventTeaserDays) then
		return Config.HolidaySmokeout, Content.HolidaySmokeout, hw
	end
	return nil, nil, nil
end

local function profileOf(player: Player): any?
	local p = ctx.Data.get(player)
	return p and p.data or nil
end
GameService.dataOf = profileOf

local function rt(player: Player): Runtime?
	return GameService.runtime[player]
end

function GameService.markDirty(player: Player)
	local r = rt(player)
	if r then
		r.dirty = true
	end
end

function GameService.toast(player: Player, text: string, kind: string?)
	ctx.Remotes.Push:FireClient(player, "toast", { text = text, kind = kind or "info" })
end

function GameService.fx(player: Player, kind: string, payload: any?)
	ctx.Remotes.Push:FireClient(player, "fx", { kind = kind, data = payload })
end

function GameService.announce(text: string, color: string?)
	ctx.Remotes.Push:FireAllClients("announce", { text = text, color = color or "#FFC83C" })
end

local function awardBadge(player: Player, key: string)
	local id = (Monetization.Badges :: any)[key]
	if type(id) == "number" and id ~= 0 then
		task.spawn(function()
			pcall(function()
				BadgeService:AwardBadge(player.UserId, id)
			end)
		end)
	end
end
GameService.awardBadge = awardBadge

-- Big Bertha's Dinner Bell: a free server-wide tip bonus (set by EggService).
-- The Turkey Day potluck table fills the same way (set by EggService). The two don't stack.
GameService.dinnerUntil = 0
GameService.potluckUntil = 0
GameService.potluckBonus = 0
GameService.potluckHud = ""
function GameService.dinnerBonus(): number
	local now = workspace:GetServerTimeNow()
	local bonus = 0
	if now < GameService.dinnerUntil then
		bonus = Config.DinnerBell.tipBonus
	end
	if now < GameService.potluckUntil then
		bonus = math.max(bonus, GameService.potluckBonus)
	end
	return bonus
end

function GameService.hasPass(player: Player, key: string): boolean
	local r = rt(player)
	return r ~= nil and r.passes[key] == true
end

local function rankMult(data: any): number
	return Economy.rankMult(data.rank, Config.RANK_STEP)
end

local function pit(data: any): any
	return Config.PitLevels[math.clamp(data.pitLevel, 1, #Config.PitLevels)]
end

function GameService.slotCount(player: Player, data: any, kind: string): number
	if kind == "smoker" then
		return Economy.totalSlots(Config.Slots.smoker.base, data.smokerSlotsBought, Config.Slots.smoker.passBonus, GameService.hasPass(player, "ExtraSmokers"), Config.MAX_SMOKERS)
	end
	return Economy.totalSlots(Config.Slots.grill.base, data.grillSlotsBought, Config.Slots.grill.passBonus, false, Config.MAX_GRILLS)
end

local function kindOfKey(key: string): string?
	local c = string.sub(key, 1, 1)
	if c == "s" then
		return "smoker"
	elseif c == "g" then
		return "grill"
	end
	return nil
end

local function validKey(player: Player, data: any, key: any): string?
	if type(key) ~= "string" or #key > 3 or not string.match(key, "^[sg]%d$") then
		return nil
	end
	local kind = kindOfKey(key)
	local idx = tonumber(string.sub(key, 2))
	if not kind or not idx or idx < 1 or idx > GameService.slotCount(player, data, kind) then
		return nil
	end
	return kind
end

function GameService.addCoins(player: Player, data: any, amount: number, earned: boolean, sku: string?)
	amount = math.floor(amount)
	data.coins += amount
	if ctx.Insights and amount ~= 0 then
		ctx.Insights.coins(player, amount, amount > 0 and "Gameplay" or "Shop", sku or (amount > 0 and "Earned" or "Spent"))
	end
	if earned and amount > 0 then
		data.runCoins += amount
		data.lifetimeCoins += amount
		local r = rt(player)
		if r then
			Income.record(r.earns, T(), amount, Income.WINDOW)
		end
	end
	GameService.markDirty(player)
end

local function useSauce(data: any, effect: string): number
	local s = data.sauces[effect]
	if s and s.charges > 0 then
		s.charges -= 1
		local amt = s.amount
		if s.charges <= 0 then
			s.amount = 0
			s.charges = 0
		end
		return amt
	end
	return 0
end

function GameService.addSauce(data: any, sauceId: string)
	local def = Config.Sauces[sauceId]
	if not def then
		return
	end
	local s = data.sauces[def.effect]
	s.amount = math.max(s.amount, def.amount)
	s.charges += def.charges
end

function GameService.grantCosmetic(player: Player, data: any, id: string): boolean
	if not Config.Cosmetics[id] then
		return false
	end
	local isNew = not data.owned[id]
	data.owned[id] = true
	if isNew then
		local def = Config.Cosmetics[id]
		if not data.equipped[def.slot] then
			data.equipped[def.slot] = id
			ctx.Cosmetics.apply(player)
		end
		GameService.markDirty(player)
	end
	return isNew
end

function GameService.addBoost(data: any, minutes: number, mult: number)
	local t = T()
	local b = data.boost
	if b.untilT > t then
		b.untilT += minutes * 60
		b.mult = math.max(b.mult, mult)
	else
		b.untilT = t + minutes * 60
		b.mult = mult
	end
end

-- Advance every cook to `t`. `online` enables burger burning (never happens offline).
local function advanceAll(player: Player, data: any, t: number, online: boolean)
	local speed = pit(data).speed
	local r = rt(player)
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" then
			local wasDone = CookLogic.isDone(cook)
			CookLogic.advance(cook, t, CookLogic.rate(cook, speed), data.boost.mult, data.boost.untilT)
			if online and r then
				if not wasDone and CookLogic.isDone(cook) and not r.announcedDone[key] then
					r.announcedDone[key] = true
					local meat = Config.Meats[cook.meat]
					GameService.toast(player, string.format("%s %s is ready! Collect it.", meat.icon, meat.name), "ready")
					GameService.markDirty(player)
				end
				if kindOfKey(key) == "grill" and cook.meat == "burger" and CookLogic.shouldBurn(cook, t, Config.BURGER_BURN_GRACE) then
					cook.burnt = true
					data.stats.burnt += 1
					data.combo = 0
					GameService.toast(player, Content.Slang.burnt, "bad")
					ctx.World.effect(player, "smell", key)
					GameService.markDirty(player)
				end
			end
		end
	end
end
GameService.advanceAll = advanceAll

local function plateValue(player: Player, data: any, plate: any, critter: any?, orderMatch: boolean, consumeTip: boolean, tipExtra: number?): number
	local meat = Config.Meats[plate.m]
	local rar = Rarity.get(Config.Rarities, plate.r)
	local flipMult = 1
	if meat.station == "grill" and meat.id == "burger" then
		local F = Config.Flip
		flipMult = Economy.flipFactor(plate.f, Config.Chores.flipRequired, F.perfectMult, F.goodMult, F.missMult, F.unflippedMult)
	end
	local r = rt(player)
	return Economy.plateValue(meat.price, {
		rarityMult = rar.mult,
		rankMult = rankMult(data),
		crewMult = Economy.crewMult(r and r.crew or 0, Config.Crew.perFriend, Config.Crew.maxFriends),
		tipMult = (critter and critter.tip or 1) * (tipExtra or 1),
		sauceTip = (consumeTip and useSauce(data, "tip") or 0) + GameService.dinnerBonus(),
		flipMult = flipMult,
		comboMult = Economy.comboMult(data.combo or 0, Config.Flip.comboStep, Config.Flip.comboMax),
		orderBonus = orderMatch and Config.MATCH_ORDER_BONUS or 1,
		doubleTips = GameService.hasPass(player, "DoubleTips"),
		passTipMult = Hype.passTip(true, Config.FairPlay.passTipMult, Config.FairPlay.passTipCap),
	})
end

local function addPlate(data: any, plate: any): boolean
	if #data.cooler >= Config.COOLER_MAX then
		return false
	end
	table.insert(data.cooler, plate)
	return true
end
GameService.addPlate = addPlate

-- ===== Actions =====
local Actions: { [string]: (Player, any, any, any) -> (boolean, string?) } = {}
GameService.Actions = Actions -- other services (Membership) add their actions here in init()

local function meatAvailable(player: Player, data: any, meat: any): (boolean, string?)
	if meat.hidden then
		return false, "Not on the menu."
	end
	if not Holiday.meatOpen(meat, GameService.currentSeason().id, { [Config.TurkeyDay.meat] = GameService.turkeyWeek().active, [Config.HolidaySmokeout.meat] = GameService.holidayWeek().active }) then
		return false, "That's a seasonal cut. It's back next season!"
	end
	if data.pitLevel < meat.unlockPit then
		return false, string.format("Upgrade to %s to smoke that.", Config.PitLevels[meat.unlockPit].name)
	end
	if meat.premium then
		local pass = GameService.hasPass(player, "PremiumCuts")
		local tokens = data.cuts[meat.id] or 0
		local unlocked = meat.id == "tomahawk" and data.unlocks.tomahawk
		if not (pass or tokens > 0 or unlocked) then
			return false, "Premium cut: get it on the Pitmaster Path or in the Pit Shop."
		end
	end
	return true, nil
end

-- opts.quiet: a ranch hand is cooking. Don't spend the player's sauce charges.
-- opts.luckMult: that hand's quality, applied on top of the pit's luck.
function GameService.beginCook(player: Player, data: any, key: any, meatId: any, opts: any?): (boolean, string?)
	opts = opts or {}
	local kind = validKey(player, data, key)
	if not kind or type(meatId) ~= "string" then
		return false, "Bad request."
	end
	local meat = Config.Meats[meatId]
	if not meat or meat.station ~= kind or meat.hidden then
		return false, "That doesn't go there."
	end
	if data.stations[key] then
		return false, "That spot's busy."
	end
	local ok, why = meatAvailable(player, data, meat)
	if not ok then
		return false, why
	end
	local access = {
		pass = meat.premium and GameService.hasPass(player, "PremiumCuts") or false,
		tokens = data.cuts[meat.id] or 0,
		unlocked = meat.id == "tomahawk" and data.unlocks.tomahawk == true or false,
	}
	local bill = Economy.cookBill(meat, data.rank, Config.RANK_STEP, access)
	if not bill.allowed then
		return false, "Premium cut: get it on the Pitmaster Path or in the Pit Shop."
	end
	if data.coins < bill.coins then
		return false, string.format("You need %d coins for that.", bill.coins)
	end
	if bill.coins > 0 then
		GameService.addCoins(player, data, -bill.coins, false, "Meat")
	end
	if bill.usesToken then
		data.cuts[meat.id] = (data.cuts[meat.id] or 0) - 1
	end
	-- Pass and token cooks are a shown purchase, so the rarity is fixed.
	-- Luck cannot change it, and a luck sauce stays in the bottle.
	local paidFixed = Economy.paidCut(meat, access, bill.usesToken)
	local luck = pit(data).luck * (opts.luckMult or 1)
	local speedBonus = 0
	if not opts.quiet then
		if not paidFixed then
			luck *= 1 + useSauce(data, "luck")
		end
		speedBonus = useSauce(data, "speed")
	end
	local rolled = if paidFixed then "smokering" else Rarity.roll(Config.Rarities, luck, meat.maxRarity, rng:NextNumber())
	local rarity = Economy.cookRarity(meat, access, bill.usesToken, rolled)
	local cook = CookLogic.new(meat.id, rarity, meat.cookTime, T(), 1 + speedBonus)
	cook.spentToken = bill.usesToken
	if type(opts.hand) == "string" then
		cook.hand = opts.hand
	elseif opts.quiet then
		cook.hand = "crew"
	end
	data.stations[key] = cook
	data.stats.cooks += 1
	if kind == "smoker" then
		data.stats.smokerStarts += 1
	end
	local r = rt(player)
	if r then
		r.announcedDone[key] = nil
	end
	if not opts.quiet then
		ctx.World.refreshStations(player)
	end
	return true, nil
end

Actions.StartCook = function(player, data, key, meatId)
	return GameService.beginCook(player, data, key, meatId, nil)
end

-- One-button first cook: a 75-second brisket that always comes out Smoke Ring Gold.
Actions.FirstBrisket = function(player, data)
	if data.tutorial.firstBrisket then
		return false, "You already smoked your first brisket!"
	end
	for _, cook in pairs(data.stations) do
		if type(cook) == "table" and cook.meat == "firstbrisket" then
			return false, "It's already smoking!"
		end
	end
	local key = "s1"
	if data.stations[key] then
		return false, "Smoker 1 is busy."
	end
	data.stations[key] = CookLogic.new("firstbrisket", "smokering", Config.Meats.firstbrisket.cookTime, T(), 1)
	data.stats.cooks += 1
	ctx.World.refreshStations(player)
	return true, nil
end

local function collect(player: Player, data: any, key: string): (boolean, string?)
	local cook = data.stations[key]
	if type(cook) ~= "table" then
		return false, "Nothing there."
	end
	if not CookLogic.isDone(cook) then
		return false, "Not ready yet. Low and slow!"
	end
	if cook.burnt then
		data.stations[key] = nil
		ctx.World.refreshStations(player)
		GameService.toast(player, "Tossed the burnt patty. 🤿", "bad")
		return true, nil
	end
	if #data.cooler >= Config.COOLER_MAX then
		return false, "Your cooler's full! Serve some plates first."
	end
	local meatId = cook.meat == "firstbrisket" and "brisket" or cook.meat
	local plate = { m = cook.meat, r = cook.rarity, f = cook.flip }
	if type(cook.hand) == "string" then
		plate.by = "crew"
	end
	addPlate(data, plate)
	data.stations[key] = nil
	local meat = Config.Meats[cook.meat]
	if meat.station == "smoker" then
		data.stats.smoked += 1
	end
	local ri = Rarity.indexOf(Config.Rarities, cook.rarity)
	data.cutsIndex[meatId .. ":" .. cook.rarity] = true
	local rar = Config.Rarities[ri]
	if ri >= 3 then
		data.stats.rares += 1
		awardBadge(player, "FirstRare")
	end
	if rar.flex then
		local label = string.format("%s smoked a %s %s!", player.DisplayName, rar.name, Config.Meats[meatId].name)
		ctx.World.smokeSignal(player, rar.name, rar.color)
		GameService.announce("💨 " .. label, rar.color)
		GameService.fx(player, "reveal", { meat = meatId, rarity = cook.rarity, aura = ri >= 4 and 1000 or 0 })
		if ri >= 4 then
			data.aura += 1000
		end
	end
	if cook.meat == "firstbrisket" then
		data.tutorial.firstBrisket = true
		GameService.toast(player, "Your first brisket came out SMOKE RING GOLD! Serve it to a customer.", "good")
	end
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.Collect = function(player, data, key)
	if not validKey(player, data, key) then
		return false, "Bad request."
	end
	return collect(player, data, key)
end

Actions.CollectAll = function(player, data)
	local any = false
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" and CookLogic.isDone(cook) then
			local ok = collect(player, data, key)
			any = any or ok
		end
	end
	return any, if any then nil else "Nothing's ready yet."
end

Actions.Flip = function(player, data, key)
	local kind = validKey(player, data, key)
	local cook = kind == "grill" and data.stations[key] or nil
	if type(cook) ~= "table" or cook.meat ~= "burger" then
		return false, "No burger there."
	end
	if cook.flip then
		return false, "Already flipped."
	end
	if CookLogic.isDone(cook) then
		return false, "Too late to flip!"
	end
	local F = Config.Flip
	local result = CookLogic.judgeFlip(CookLogic.fraction(cook), F.target, F.perfectWindow, F.goodWindow)
	cook.flip = result
	data.stats.flips += 1
	if result == "perfect" then
		data.combo = math.min((data.combo or 0) + 1, F.comboMax)
		data.stats.perfectFlips += 1
		data.aura += F.perfectAura
		GameService.fx(player, "flip", { result = result, combo = data.combo, lockedIn = data.combo >= F.lockedInAt })
	else
		data.combo = 0
		GameService.fx(player, "flip", { result = result, combo = 0 })
	end
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.Peek = function(player, data, key)
	local kind = validKey(player, data, key)
	local cook = data.stations[key]
	if kind ~= "smoker" or type(cook) ~= "table" or CookLogic.isDone(cook) then
		return false, "Nothing to peek at."
	end
	if cook.revealed then
		return false, "You already peeked."
	end
	local frac = if Config.Chores.peekPenalty then Config.PEEK_PENALTY_FRACTION else 0
	local minimum = if Config.Chores.peekPenalty then Config.PEEK_PENALTY_MIN else 0
	local penalty = CookLogic.peek(cook, frac, minimum)
	local rar = Rarity.get(Config.Rarities, cook.rarity)
	if not Config.Chores.peekPenalty then
		GameService.toast(player, string.format("It's looking %s.", rar.name), "info")
		return true, nil
	end
	GameService.toast(player, string.format("%s (+%s cook time) It's looking %s!", Content.PitmasterScold[rng:NextInteger(1, #Content.PitmasterScold)], TimeUtil.formatDuration(penalty), rar.name), "warn")
	return true, nil
end

-- The player-cooked event plate we leave in the cooler until they've shared today.
-- Crew and Jimothy sell around it. A hand-cooked plate is never the one we hold,
-- and it can't be shared (Holiday.pickPlate).
local function rarityIndex(id: string): number
	return Rarity.indexOf(Config.Rarities, id)
end

local function potluckHeld(data: any): any?
	local EV = GameService.potluckEvent()
	if not EV or type(data.daily) ~= "table" or type(data.cooler) ~= "table" then
		return nil
	end
	local i = Holiday.holdPlate(data.cooler, EV.meat, data.daily[EV.dailyKey] == today(), rarityIndex)
	return if i then data.cooler[i] else nil
end

-- Serving
local function bestPlateIndex(player: Player, data: any, order: string?, held: any?): (number?, boolean)
	local bestI = Holiday.autoPlate(data.cooler, held, function(plate)
		local isMatch = order ~= nil and order ~= "any" and (plate.m == order or (order == "brisket" and plate.m == "firstbrisket"))
		local v = plateValue(player, data, plate, nil, isMatch, false)
		-- prefer matching orders, then highest value
		return v + (if isMatch then 1e9 else 0)
	end)
	if not bestI then
		return nil, false
	end
	local plate = data.cooler[bestI]
	local matched = order ~= nil and order ~= "any" and (plate.m == order or (order == "brisket" and plate.m == "firstbrisket"))
	return bestI, matched
end

local function critterDef(id: string): any
	for _, c in ipairs(Config.Critters) do
		if c.id == id then
			return c
		end
	end
	return Config.Critters[1]
end
GameService.critterDef = critterDef

local function removeCustomer(player: Player, customer: any)
	local r = rt(player)
	if not r then
		return
	end
	for i, c in ipairs(r.customers) do
		if c.id == customer.id then
			table.remove(r.customers, i)
			break
		end
	end
	ctx.World.removeCustomer(player, customer)
	GameService.markDirty(player)
end

function GameService.serveCustomer(player: Player, customer: any, tipExtra: number?, auto: boolean?): (boolean, string?)
	local data = profileOf(player)
	if not data then
		return false, "Loading..."
	end
	-- Automatic servers (crew, Jimothy) leave today's potluck dish. The player's own Serve does not.
	local held = if auto then potluckHeld(data) else nil
	local i, matched = bestPlateIndex(player, data, customer.order, held)
	if not i then
		return false, "Your cooler's empty. Cook something first!"
	end
	local plate = table.remove(data.cooler, i)
	local critter = critterDef(customer.critter)
	local value = plateValue(player, data, plate, critter, matched, true, tipExtra)
	GameService.addCoins(player, data, value, true)
	data.stats.served += 1
	local isNew = (data.critters[critter.id] or 0) == 0
	data.critters[critter.id] = (data.critters[critter.id] or 0) + 1
	if isNew then
		local distinct = 0
		for _ in pairs(data.critters) do
			distinct += 1
		end
		data.stats.critters = distinct
		GameService.addCoins(player, data, Config.NEW_REGULAR_REWARD * rankMult(data), true)
		GameService.toast(player, string.format("New regular! %s joined your Regulars Index.", critter.name), "good")
	end
	if critter.rex then
		GameService.announce(string.format("🦖 Rex visited %s's ranch! RAWR means I love you ♥", player.DisplayName), "#6CC24A")
		ctx.World.smokeSignal(player, "RAWR!", "#6CC24A")
		awardBadge(player, "MetRex")
	end
	if critter.id == "clapcat" then
		ctx.World.effect(player, "clap", customer)
	end
	GameService.fx(player, "served", { value = value, matched = matched, critter = critter.id, aura = plate.f == "perfect" and Config.Flip.perfectAura or 0 })
	-- 6-7!
	if Hype.isSixSeven(value) then
		GameService.fx(player, "sixseven", { value = value })
		ctx.Egg.found(player, data, "sixseven")
	end
	-- Lunch Rush stays in the code for one release. The switch keeps the bonus off.
	local r = rt(player)
	if Config.Chores.lunchRush and r then
		local bonus
		r.rush, bonus = Hype.rushStep(r.rush, T(), Config.Rush.period, Config.Rush.need, Config.Rush.bonusFrac, value)
		if bonus > 0 then
			GameService.addCoins(player, data, bonus, true)
			GameService.fx(player, "rush", { bonus = bonus })
			GameService.toast(player, string.format("🍽️ Lunch Rush cleared! +%d coins", bonus), "good")
		end
	end
	if not data.tutorial.done then
		data.tutorial.done = true
		if Onboard.skip(data) and not data.rookie.skipped and data.rookie.claimed == 0 then
			ctx.Remotes.Push:FireClient(player, "dialog", { npc = "Unc Hank", text = Content.Rookie.start, reward = 0 })
		end
	end
	GameService.checkRookie(player, data)
	removeCustomer(player, customer)
	return true, nil
end

Actions.Serve = function(player, _data, customerId)
	local r = rt(player)
	if not r or type(customerId) ~= "number" then
		return false, "Bad request."
	end
	for _, c in ipairs(r.customers) do
		if c.id == customerId then
			return GameService.serveCustomer(player, c)
		end
	end
	return false, "They already left."
end

Actions.ServeAll = function(player, data)
	local r = rt(player)
	if not r then
		return false, nil
	end
	if #r.customers == 0 then
		return false, "No customers yet. They'll show up soon!"
	end
	local served = 0
	local list = table.clone(r.customers)
	for _, c in ipairs(list) do
		if #data.cooler == 0 then
			break
		end
		local ok = GameService.serveCustomer(player, c)
		if ok then
			served += 1
		end
	end
	if served == 0 then
		return false, "Your cooler's empty. Cook something first!"
	end
	return true, nil
end

function GameService.bellyRub(player: Player, customer: any)
	local data = profileOf(player)
	if not data or customer.rubbed then
		return
	end
	customer.rubbed = true
	local tip = math.floor(25 * data.pitLevel * rankMult(data))
	GameService.addCoins(player, data, tip, true)
	data.aura += 50
	GameService.toast(player, string.format("%s +%d tip.", Content.YardNotes.pup, tip), "good")
	ctx.World.effect(player, "bellyrub", customer)
end

function GameService.washPup(player: Player, customer: any)
	local data = profileOf(player)
	if not data or not customer.muddy then
		return
	end
	customer.muddy = false
	local pick = Rarity.pickWeighted(Config.Bandanas, rng:NextNumber())
	local isNew = GameService.grantCosmetic(player, data, pick.id)
	local name = Config.Cosmetics[pick.id].name
	GameService.toast(player, isNew and ("Squeaky clean! The pup gave you a " .. name .. "!") or ("Squeaky clean! (" .. name .. " again, +100 coins)"), "good")
	if not isNew then
		GameService.addCoins(player, data, 100, true)
	end
	ctx.World.effect(player, "wash", customer)
	GameService.markDirty(player)
end

Actions.BuySauce = function(player, data, sauceId)
	if type(sauceId) ~= "string" then
		return false, "Bad request."
	end
	local def = Config.Sauces[sauceId]
	if not def or def.hidden then
		return false, "Not for sale."
	end
	local window = Restock.window(os.time(), Config.RESTOCK_SECONDS)
	if data.restock.window ~= window then
		data.restock.window = window
		data.restock.bought = {}
	end
	local shelf = Restock.shelf(window, Config.Sauces, Config.SauceOrder, Config.RESTOCK_SLOTS)
	local qty = 0
	for _, e in ipairs(shelf) do
		if e.id == sauceId then
			qty = e.qty
		end
	end
	local bought = data.restock.bought[sauceId] or 0
	if bought >= qty then
		return false, "Sold out! New sauce in " .. TimeUtil.formatDuration(Restock.nextIn(os.time(), Config.RESTOCK_SECONDS)) .. "."
	end
	local price = math.floor(def.price * (1 + (rankMult(data) - 1) * 0.5))
	if data.coins < price then
		return false, string.format("You need %d coins.", price)
	end
	GameService.addCoins(player, data, -price, false, "Sauce")
	data.restock.bought[sauceId] = bought + 1
	GameService.addSauce(data, sauceId)
	data.stats.sauces += 1
	GameService.toast(player, string.format("Got %s! (%d charges)", def.name, def.charges), "good")
	return true, nil
end

Actions.UpgradePit = function(player, data)
	local cost = Economy.nextPitCost(Config.PitLevels, data.pitLevel)
	if not cost then
		return false, "Your pit is maxed out. Time for Unc Status?"
	end
	if data.coins < cost then
		return false, string.format("You need %d coins.", cost)
	end
	GameService.addCoins(player, data, -cost, false, "PitUpgrade")
	data.pitLevel += 1
	data.stats.upgrades += 1
	GameService.toast(player, "Pit upgraded to " .. pit(data).name .. "!", "good")
	GameService.fx(player, "levelup", { text = "Pit upgraded to " .. pit(data).name .. "!" })
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.BuySlot = function(player, data, kind)
	if kind ~= "smoker" and kind ~= "grill" then
		return false, "Bad request."
	end
	local def = Config.Slots[kind]
	local boughtKey = kind == "smoker" and "smokerSlotsBought" or "grillSlotsBought"
	local cap = kind == "smoker" and Config.MAX_SMOKERS or Config.MAX_GRILLS
	if GameService.slotCount(player, data, kind) >= cap then
		return false, "No more room!"
	end
	local cost = Economy.nextSlotCost(def.costs, data[boughtKey])
	if not cost then
		return false, "No more slots to buy."
	end
	if data.coins < cost then
		return false, string.format("You need %d coins.", cost)
	end
	GameService.addCoins(player, data, -cost, false, "Slot")
	data[boughtKey] += 1
	data.stats.upgrades += 1
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.Rebirth = function(player, data)
	local ok, need = Economy.canRebirth(Config.Ranks, data.rank, data.runCoins)
	if not ok then
		return false, need and string.format("Earn %d coins this run to rebirth.", need) or "You're already OG."
	end
	-- Finished food goes to the cooler; unfinished cooks are refunded. Nothing is lost.
	local refund = 0
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" then
			if CookLogic.isDone(cook) and not cook.burnt then
				addPlate(data, { m = cook.meat, r = cook.rarity, f = cook.flip })
			elseif not CookLogic.isDone(cook) then
				local m = Config.Meats[cook.meat]
				if m then
					-- Coin cost comes back for every cut, including premium. A token
					-- comes back only if this cook actually spent one.
					refund += Economy.rawCost(m, rankMult(data))
					if cook.spentToken and m.premium then
						data.cuts[m.id] = (data.cuts[m.id] or 0) + 1
					end
				end
			end
		end
		data.stations[key] = nil
	end
	data.rank += 1
	data.coins = Config.START_COINS + refund
	data.runCoins = 0
	data.pitLevel = 1
	data.smokerSlotsBought = 0
	data.grillSlotsBought = 0
	local rank = Config.Ranks[data.rank]
	data.titles[rank.name] = true
	data.title = rank.name
	if rank.unlock then
		GameService.grantCosmetic(player, data, rank.unlock)
		GameService.toast(player, Content.Slang.unclocked, "good")
	end
	GameService.announce(string.format("👴 %s reached Unc Status: %s!", player.DisplayName, rank.name), "#FFC83C")
	ctx.World.refreshStations(player)
	ctx.Cosmetics.apply(player)
	return true, nil
end

function GameService.applyReward(player: Player, data: any, reward: any)
	if reward.coins then
		GameService.addCoins(player, data, reward.coins * rankMult(data), true)
	end
	if reward.sauce then
		GameService.addSauce(data, reward.sauce)
	end
	if reward.cosmetic then
		GameService.grantCosmetic(player, data, reward.cosmetic)
	end
	if reward.boostMinutes then
		GameService.addBoost(data, reward.boostMinutes, 2)
	end
	if reward.wagyu then
		data.cuts.wagyu = (data.cuts.wagyu or 0) + reward.wagyu
	end
	if reward.title then
		data.titles[reward.title] = true
	end
	if reward.rex then
		data.forceCritter = "rex"
	end
	if reward.tomahawk then
		data.unlocks.tomahawk = true
	end
	GameService.markDirty(player)
end

Actions.ClaimDaily = function(player, data)
	local d = today()
	Streak.healClock(data.streak, d)
	if not Streak.canClaim(data.streak, d) then
		return false, "Already claimed today. See you tomorrow!"
	end
	local res = Streak.claim(data.streak, d)
	if not res.ok then
		return false, "Already claimed."
	end
	local reward = Config.DailyRewards[res.cycleDay]
	local scaled = table.clone(reward)
	scaled.coins = math.floor((reward.coins or 0) * Streak.rewardScale(res.count))
	local paid = Streak.payout(reward.coins or 0, res.count, rankMult(data))
	GameService.applyReward(player, data, scaled)
	local note = ""
	if res.usedFreeMiss then
		note = " (Your free miss for the week saved your streak!)"
	elseif res.softReset then
		note = " (Welcome back! You kept your week.)"
	end
	GameService.toast(player, string.format("Day %d streak! +%d coins%s", res.count, paid, note), "good")
	GameService.fx(player, "levelup", { text = string.format("Day %d! +%d", res.count, paid) })
	return true, nil
end

Actions.ClaimGift = function(player, data)
	Staff.normalize(data)
	local now = os.time()
	FreeGift.normalize(data.freeGift, now)
	if not FreeGift.claim(data.freeGift, now) then
		return false, "Your free gift isn't ready yet."
	end
	local amount = FreeGift.payout(rankMult(data))
	GameService.addCoins(player, data, amount, true, "FreeGift")
	GameService.toast(player, string.format("Free gift! +%d coins", amount), "good")
	GameService.fx(player, "freegift", { value = amount })
	return true, nil
end

Actions.HireStaff = function(player, data)
	if not Config.Chores.legacyStaff then
		return false, "Hire from the Hiring Line in the town square."
	end
	Staff.normalize(data)
	local outcome = Staff.tryHire(data.staff.roster, data.pitLevel, data.coins)
	if not outcome.ok or not outcome.employee or not outcome.cost then
		return false, Staff.hireMessage(outcome.reason, outcome.cost)
	end
	local hire = outcome.employee
	if Staff.find(data.staff.roster, hire.id) then
		return false, "They're already on the crew."
	end
	local before = data.coins
	GameService.addCoins(player, data, -outcome.cost, false, "Staff")
	if data.coins < 0 or data.coins ~= data.coins then
		data.coins = before
		return false, Staff.hireMessage("coins", outcome.cost)
	end
	table.insert(data.staff.roster, hire)
	local r = rt(player)
	if r then
		r.staffNext[hire.id] = T() + 2
		r.staffJob[hire.id] = "idle"
	end
	GameService.toast(player, hire.name .. " clocked in!", "good")
	local hand = Staff.hand(hire.id)
	GameService.fx(player, "hired", { name = hire.name, title = if hand then hand.title else "Crew" })
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.UpgradeStaff = function(player, data, id, stat)
	if not Config.Chores.legacyStaff then
		return false, "Level your crew from the Crew panel."
	end
	Staff.normalize(data)
	local outcome = Staff.tryUpgrade(data.staff.roster, id, stat, data.coins)
	if not outcome.ok or not outcome.stat or not outcome.cost or not outcome.level or outcome.from == nil then
		return false, Staff.upgradeMessage(outcome.reason, outcome.cost)
	end
	local e = Staff.find(data.staff.roster, id)
	if not e or e[outcome.stat] ~= outcome.from then
		return false, Staff.upgradeMessage("max", nil)
	end
	local before = data.coins
	GameService.addCoins(player, data, -outcome.cost, false, "Staff")
	if data.coins < 0 or data.coins ~= data.coins then
		data.coins = before
		return false, Staff.upgradeMessage("coins", outcome.cost)
	end
	e[outcome.stat] = outcome.level
	local label = if outcome.stat == "speed" then "Speed" elseif outcome.stat == "capacity" then "Carry" else "Quality"
	GameService.toast(player, string.format("%s's %s is now %d.", e.name, label, e[outcome.stat]), "good")
	GameService.fx(player, "levelup", { text = e.name .. " " .. label .. " " .. outcome.level })
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.GuideSkip = function(player, data)
	if type(data.guide) ~= "table" then
		data.guide = Guide.new()
	end
	if not Guide.skip(data.guide) then
		return false, "You're already all set."
	end
	GameService.toast(player, "Hints tucked away. Have fun at the ranch.", "info")
	return true, nil
end

Actions.ClaimPath = function(player, data)
	local ok, reward = PitmasterPath.claim(data.path, Config.PathSteps, data.stats)
	if not ok then
		return false, "Not done yet!"
	end
	GameService.applyReward(player, data, reward)
	GameService.toast(player, "Pitmaster Path step " .. data.path.claimed .. " complete!", "good")
	return true, nil
end

Actions.HearJoke = function(player, data)
	local d = today()
	local joke = Content.UncJokes[(d % #Content.UncJokes) + 1]
	local first = data.daily.jokeDay ~= d
	if first then
		data.daily.jokeDay = d
		GameService.addCoins(player, data, 50 * rankMult(data), true)
	end
	ctx.Remotes.Push:FireClient(player, "dialog", { npc = "Unc Hank", text = "Hi Hungry, I'm Unc! " .. joke, yap = Content.UncYap[rng:NextInteger(1, #Content.UncYap)], reward = first and math.floor(50 * rankMult(data)) or 0 })
	return true, nil
end

Actions.Equip = function(player, data, slot, cosmeticId)
	if type(slot) ~= "string" or not table.find(Config.CosmeticSlots, slot) then
		return false, "Bad request."
	end
	if cosmeticId == "" or cosmeticId == nil then
		data.equipped[slot] = nil
	else
		if type(cosmeticId) ~= "string" or not data.owned[cosmeticId] then
			return false, "You don't own that."
		end
		local def = Config.Cosmetics[cosmeticId]
		if not def or def.slot ~= slot then
			return false, "Wrong slot."
		end
		data.equipped[slot] = cosmeticId
	end
	ctx.Cosmetics.apply(player)
	ctx.World.refreshStations(player)
	return true, nil
end

Actions.SetTitle = function(player, data, title)
	if title == "" then
		data.title = ""
		ctx.Cosmetics.apply(player)
		return true, nil
	end
	if type(title) ~= "string" or not data.titles[title] then
		return false, "You haven't earned that title."
	end
	data.title = title
	ctx.Cosmetics.apply(player)
	return true, nil
end

-- Unc's Rookie List: skip it (the client asks first), or bring it back from Settings > Game.
Actions.RookieSkip = function(player, data)
	if not Rookie.skip(data.rookie, Config.RookieSteps) then
		return false, "Your Rookie List is already done or tucked away."
	end
	GameService.toast(player, Content.Rookie.skipped, "info")
	GameService.markDirty(player)
	return true, nil
end

Actions.RookieResume = function(player, data)
	if not Rookie.resume(data.rookie, Config.RookieSteps) then
		return false, "Your Rookie List is already showing (or done)."
	end
	GameService.toast(player, Content.Rookie.resumed, "good")
	GameService.checkRookie(player, data)
	GameService.markDirty(player)
	return true, nil
end

Actions.SetPeace = function(player, data, on)
	local r = rt(player)
	if type(on) ~= "boolean" or not r then
		return false, "Bad request."
	end
	local t = os.clock()
	if t - r.peaceChangedAt < 60 then
		return false, "You can switch Peace Mode once a minute."
	end
	if t < r.snagCooldownUntil - Config.Snag.cooldown + Config.Snag.catchWindow then
		return false, "Not while you're on the run!"
	end
	r.peaceChangedAt = t
	data.settings.peace = on
	GameService.toast(player, on and "Peace Mode on: nobody can snag your plates (and you can't snag theirs)." or "Peace Mode off. Watch your plates!", "info")
	return true, nil
end

Actions.SetSfx = function(_player, data, on)
	if type(on) ~= "boolean" then
		return false, "Bad request."
	end
	data.settings.sfx = on
	return true, nil
end

-- Music mute is saved on its own. It does not change the sound-effect switch.
Actions.SetMusic = function(_player, data, on)
	if type(on) ~= "boolean" then
		return false, "Bad request."
	end
	data.settings.music = on
	return true, nil
end

-- Volume is saved even while muted, so unmuting comes back to this level.
Actions.SetMusicVolume = function(_player, data, volume)
	if type(volume) ~= "number" then
		return false, "Bad request."
	end
	data.settings.musicVolume = MusicPrefs.clamp(volume)
	return true, nil
end

Actions.SetResting = function(player, _data, on)
	local r = rt(player)
	if type(on) ~= "boolean" or not r then
		return false, nil
	end
	r.resting = on
	ctx.Cosmetics.apply(player)
	return true, nil
end

Actions.Prompt = function(player, _data, kind, key)
	if (kind ~= "product" and kind ~= "pass") or type(key) ~= "string" then
		return false, "Bad request."
	end
	return ctx.Purchase.prompt(player, kind, key)
end

-- Analytics only: which shop tab was opened (nothing changes for the player).
Actions.ShopView = function(player, data, tab)
	if type(tab) ~= "string" or #tab > 24 then
		return false, nil
	end
	if type(data.onboard) == "table" then
		data.onboard.shopSeen = true
	end
	if tab == "" then
		ctx.Insights.shopOpened(player)
	else
		ctx.Insights.shopTab(player, tab)
	end
	return true, nil
end

Actions.Gift = function(player, _data, key, recipientUserId)
	if type(key) ~= "string" or type(recipientUserId) ~= "number" then
		return false, "Bad request."
	end
	return ctx.Purchase.promptGift(player, key, recipientUserId)
end

Actions.Hello = function(player, _data)
	GameService.markDirty(player)
	return true, nil
end

-- ===== Snapshot sent to the client =====
local function snapshot(player: Player, data: any): any
	local r = rt(player) :: Runtime
	local t = T()
	local stations = {}
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" then
			local done = CookLogic.isDone(cook)
			stations[key] = {
				meat = cook.meat,
				progress = cook.progress,
				duration = cook.duration,
				last = cook.last,
				rate = CookLogic.rate(cook, pit(data).speed),
				doneAt = cook.doneAt,
				flip = cook.flip,
				burnt = cook.burnt,
				rarity = (done or cook.revealed) and cook.rarity or nil,
			}
		end
	end
	local window = Restock.window(os.time(), Config.RESTOCK_SECONDS)
	local bought = data.restock.window == window and data.restock.bought or {}
	local customers = {}
	for _, c in ipairs(r.customers) do
		table.insert(customers, { id = c.id, critter = c.critter, order = c.order, muddy = c.muddy, leaveAt = c.leaveAt })
	end
	local week = TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
	return {
		t = t,
		coins = data.coins,
		runCoins = data.runCoins,
		aura = data.aura,
		rank = data.rank,
		pitLevel = data.pitLevel,
		slots = { smoker = GameService.slotCount(player, data, "smoker"), grill = GameService.slotCount(player, data, "grill") },
		bought = { smoker = data.smokerSlotsBought, grill = data.grillSlotsBought },
		stations = stations,
		cooler = data.cooler,
		sauces = data.sauces,
		boost = data.boost,
		cuts = data.cuts,
		unlocks = data.unlocks,
		owned = data.owned,
		equipped = data.equipped,
		titles = data.titles,
		title = data.title,
		critters = data.critters,
		cutsIndex = data.cutsIndex,
		eggs = data.eggs,
		jimothy = {
			n = Jimothy.count(type(data.jimothy) == "table" and data.jimothy.seen or nil),
			total = Jimothy.total(),
		},
		stats = data.stats,
		streak = data.streak,
		canClaimDaily = Streak.canClaim(data.streak, today()),
		path = data.path,
		pathStatus = PitmasterPath.status(data.path, Config.PathSteps, data.stats),
		restock = { window = window, shelf = Restock.shelf(window, Config.Sauces, Config.SauceOrder, Config.RESTOCK_SLOTS), bought = bought, nextIn = Restock.nextIn(os.time(), Config.RESTOCK_SECONDS) },
		cookoff = data.cookoff,
		settings = data.settings,
		tutorial = data.tutorial,
		rookie = Rookie.status(data.rookie, Config.RookieSteps, data.stats),
		passes = r.passes,
		customers = customers,
		combo = data.combo,
		income = Income.perSecond(r.earns, t, Income.WINDOW),
		earns = r.earns,
		today = today(),
		staff = {
			slots = Staff.slots(data.pitLevel),
			roster = data.staff.roster,
			waiter = r.passes.AutoServe == true,
		},
		freeGift = (function()
			local giftNow = os.time()
			FreeGift.normalize(data.freeGift, giftNow)
			return {
				ready = FreeGift.ready(data.freeGift.nextAt, giftNow),
				nextAt = data.freeGift.nextAt,
				coins = FreeGift.payout(rankMult(data)),
			}
		end)(),
		guide = if Onboard.skip(data) and type(data.guide) == "table" then Guide.view(data.guide) else { active = false },
		onboard = (function()
			if Onboard.skip(data) then
				return nil
			end
			local ownedN = if type(data.crew) == "table" and type(data.crew.owned) == "table" then #data.crew.owned else 0
			local taught = type(data.onboard) == "table" and data.onboard.taught == true
			local trait = taught
			if not trait and type(data.crew) == "table" and type(data.crew.owned) == "table" then
				for _, member in ipairs(data.crew.owned) do
					if type(member.trait) == "string" and member.trait ~= "none" and member.trait ~= "" then
						trait = true
						break
					end
				end
			end
			local step = Onboard.reached({
				claimed = r.plot ~= nil,
				crew = ownedN,
				tier = if type(data.ranch) == "table" then data.ranch.tier or 1 else 1,
				trait = trait,
				playSeconds = data.playSeconds or 0,
				shopSeen = type(data.onboard) == "table" and data.onboard.shopSeen == true,
			})
			return Onboard.card(step, data.playSeconds or 0)
		end)(),
		menuAll = Onboard.skip(data),
		offer = Offers.pick({
			playSeconds = data.playSeconds or 0,
			skip = Onboard.skip(data),
			promptAt = Config.Onboarding.promptAt,
			slotsFull = type(data.crew) == "table" and type(data.crew.owned) == "table" and #data.crew.owned >= (data.crew.slots or 0) and (data.crew.slots or 0) > 0,
			bunkhouse = type(data.crew) == "table" and data.crew.bunkhouse == true,
			autoHire = r.passes.AutoHire == true,
			hasCrew = type(data.crew) == "table" and type(data.crew.owned) == "table" and #data.crew.owned > 0,
		}),
		crew = r.crew,
		rush = (function()
			local w = Hype.rushWindow(T(), Config.Rush.period)
			local cur = (r.rush and r.rush.w == w) and r.rush or nil
			return { n = cur and cur.n or 0, need = Config.Rush.need, done = cur ~= nil and cur.done, ends = Hype.rushEnds(w, Config.Rush.period) }
		end)(),
		dinnerUntil = GameService.dinnerUntil,
		potluckUntil = GameService.potluckUntil,
		potluckHud = GameService.potluckHud,
		turkey = (function()
			local w = GameService.turkeyWeek()
			return { active = w.active, isDay = w.isDay, ends = Holiday.label(w.endDay), shared = data.daily.turkeyDay == today() }
		end)(),
		holiday = (function()
			local w = GameService.holidayWeek()
			return { active = w.active, isDay = w.isDay, ends = Holiday.label(w.endDay), shared = data.daily.holidayDay == today() }
		end)(),
		season = GameService.currentSeason(),
		saturday = GameService.isSaturday(),
		suds = GameService.isSudsWeekend(),
		rotation = CookOff.rotation(Config.RotationPool, Config.ROTATION_FEATURED, week),
		memoryOnly = RunService:IsStudio() and ctx.Data.isStudioMemoryMode(player),
		degraded = (not RunService:IsStudio()) and ctx.Data.isStudioMemoryMode(player),
		studio = RunService:IsStudio(),
		productIds = ctx.Purchase.availability(),
		giftsHeld = data.giftsHeld,
		onceBought = data.purchases.once,
		boughtAny = data.purchases.count > 0,
		hiring = (function()
			local line = if ctx.Crew and ctx.Crew.line then ctx.Crew.line() else nil
			local rows = {}
			if type(line) == "table" and type(line.applicants) == "table" then
				for _, applicant in ipairs(line.applicants) do
					table.insert(rows, {
						index = applicant.index,
						name = applicant.name,
						rarityName = applicant.rarityName,
						color = applicant.color,
						roleName = applicant.roleName,
						trait = applicant.trait,
						traitName = applicant.traitName,
						rate = applicant.rate,
						price = applicant.price,
						line = applicant.line,
						taken = line.taken[applicant.index] ~= nil,
					})
				end
			end
			return {
				clock = HiringLine.clockLabel(os.time(), Config.Hiring.period, Config.TIMEZONE_OFFSET_HOURS),
				applicants = rows,
			}
		end)(),
		ranchCrew = (function()
			local view = Crew.view(data, GameService.crewMults(player, data))
			local _, hostData = GameService.familyHost()
			if hostData and type(data.crew) == "table" then
				local slots = GameService.crewSlots(data)
				view.slots = slots
				view.used = math.min(#view.owned, slots)
				view.rate = Crew.totalRate(data.crew.owned, slots, GameService.crewMults(player, data))
				local tier = math.floor(hostData.ranch.tier or 1)
				local nxt = Crew.nextTier(tier)
				local tierRow = Config.RanchTiers[math.clamp(tier, 1, #Config.RanchTiers)]
				view.tier = tier
				view.tierName = "Family · " .. (if tierRow then tierRow.name else "Open yard")
				view.nextCost = if nxt then nxt.cost else nil
				view.nextName = if nxt then nxt.name else nil
				view.nextBlurb = if nxt then nxt.blurb else nil
			elseif view.tier == 1 and type(view.nextCost) == "number" then
				view.nextCost = Onboard.tierPrice(view.nextCost, 1, data.playSeconds or 0, Onboard.skip(data))
			end
			return view
		end)(),
		storm = if ctx.Weather and ctx.Weather.state then ctx.Weather.state() else { active = false, banner = "", odds = {} },
		partners = Partners.ensure(data),
		family = {
			on = type(data.family) == "table" and data.family.on == true,
			purse = if type(data.family) == "table" then data.family.purse or 0 else 0,
			host = player.UserId == game.PrivateServerOwnerId,
			privateServer = game.PrivateServerOwnerId ~= 0,
		},
		indexBonus = Index.incomeMult(data),
		indexTraits = if type(data.index) == "table" then data.index.traits or {} else {},
		serverMates = (function()
			local rows = {}
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					table.insert(rows, { id = other.UserId, name = other.DisplayName })
				end
			end
			return rows
		end)(),
		seasonPass = ctx.Season.snapshot(data),
		member = ctx.Membership.snapshot(player, data),
		plot = r.plot,
	}
end

function GameService.push(player: Player)
	local data = profileOf(player)
	local r = rt(player)
	if not data or not r then
		return
	end
	r.dirty = false
	ctx.Remotes.Push:FireClient(player, "state", snapshot(player, data))
end

-- ===== Customers =====
local function spawnCustomer(player: Player, data: any, r: Runtime)
	local critter
	if data.forceCritter ~= "" then
		critter = critterDef(data.forceCritter)
		data.forceCritter = ""
	else
		critter = Rarity.pickWeighted(Config.Critters, rng:NextNumber())
	end
	local order = "any"
	if rng:NextNumber() < 0.4 then
		local options = {}
		for _, id in ipairs(Config.MeatOrder) do
			local m = Config.Meats[id]
			if not m.premium and (meatAvailable(player, data, m)) and m.cookTime <= 1800 then
				table.insert(options, id)
			end
		end
		if #options > 0 then
			order = options[rng:NextInteger(1, #options)]
		end
	end
	r.nextCustomerId += 1
	local customer = {
		id = r.nextCustomerId,
		critter = critter.id,
		order = order,
		muddy = critter.bellyRub and GameService.isSudsWeekend() and rng:NextNumber() < Config.SUDS_PUP_CHANCE or false,
		leaveAt = T() + Config.CUSTOMER_PATIENCE,
		spot = 0,
	}
	local used = {}
	for _, c in ipairs(r.customers) do
		used[c.spot] = true
	end
	for s = 1, Config.CUSTOMER_SPOTS do
		if not used[s] then
			customer.spot = s
			break
		end
	end
	table.insert(r.customers, customer)
	ctx.World.spawnCustomer(player, customer, critter)
	GameService.markDirty(player)
end

-- ===== Lifecycle =====
local function guard(label: string, fn: () -> ())
	-- Return a value so xpcall's type has a success flag and an error to unpack.
	local ok, err = xpcall(function(): string?
		fn()
		return nil
	end, debug.traceback)
	if not ok then
		warn("[GameService] " .. label .. " failed:\n" .. tostring(err))
	end
end

local function serverNow(): number
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.clock()
end

local function onLoaded(player: Player, profile: any, isNew: boolean)
	-- Listeners run on their own threads. The player may already have left, and
	-- `profile` has to be the table DataService stored (a copied table must not pass).
	if not player.Parent or ctx.Data.get(player) ~= profile then
		return
	end
	local data = profile.data
	local lastSeen = data.lastSeen or 0
	local r: Runtime = {
		plot = nil,
		passes = {},
		sessionStart = os.clock(),
		lastActive = os.clock(),
		nudged = false,
		dirty = true,
		today = today(),
		crew = 0,
		customers = {},
		nextCustomerId = 0,
		nextSpawn = serverNow() + 3,
		lastAutoServe = 0,
		snagLockUntil = 0,
		snagCooldownUntil = 0,
		peaceChangedAt = -1e9,
		rush = nil,
		resting = false,
		cookoffReadyAt = 0,
		announcedDone = {},
		earns = {},
		staffNext = {},
		staffJob = {},
		eventNoteDue = false,
		crewBank = 0,
		crewNext = {},
		offlineCrew = 0,
		offlineTipPaid = false,
		cheerUntil = {},
		cheerCooldown = {},
	}
	-- Runtime goes in before any yielding call. Until it exists, every action
	-- returns "Still loading your ranch..." and prompts no-op.
	GameService.runtime[player] = r
	task.defer(function()
		if GameService.runtime[player] == r then
			GameService.settlePurse(player)
		end
	end)

	-- The plot and the first snapshot happen before pass checks, season sync, or
	-- cosmetics. Those call Marketplace / friends / the map and must not be able
	-- to leave a joined player with no plot and no push.
	local plotOk, plotIndex = pcall(function()
		return ctx.World.assignPlot(player)
	end)
	if plotOk and type(plotIndex) == "number" then
		r.plot = plotIndex
	elseif not plotOk then
		warn("[GameService] assignPlot failed:\n" .. tostring(plotIndex))
	end
	guard("guide", function()
		if type(data.guide) ~= "table" then
			data.guide = Guide.new()
		end
		local rosterN = if type(data.staff) == "table" and type(data.staff.roster) == "table" then #data.staff.roster else 0
		if type(data.onboard) ~= "table" then
			data.onboard = { done = false, rookieReward = false, started = false, taught = false }
		end
		if not Onboard.skip(data) then
			data.onboard.started = true
		end
		Guide.prepare(data.guide, {
			served = data.stats and data.stats.served or 0,
			firstBrisket = data.tutorial and data.tutorial.firstBrisket == true,
			tutorialDone = data.tutorial and data.tutorial.done == true,
			playSeconds = data.playSeconds or 0,
			crew = rosterN,
		})
		Guide.sync(data.guide, Guide.signals(data))
		Streak.healClock(data.streak, today())
		if type(data.freeGift) == "table" then
			FreeGift.normalize(data.freeGift, os.time())
		end
	end)
	guard("push", function()
		GameService.push(player)
	end)
	if not player.Parent or GameService.runtime[player] ~= r then
		if GameService.runtime[player] == r then
			GameService.runtime[player] = nil
		end
		return
	end

	-- Pass ownership yields (UserOwnsGamePassAsync has no engine timeout). It used
	-- to run before assignPlot, so a hung web call left the ranch on the loading screen.
	task.spawn(function()
		if not player.Parent or GameService.runtime[player] ~= r then
			return
		end
		local ok, passes = pcall(function()
			return ctx.Purchase.loadPasses(player)
		end)
		if not player.Parent or GameService.runtime[player] ~= r then
			return
		end
		if ok and type(passes) == "table" then
			r.passes = passes
			if passes.Bunkhouse == true and type(data.crew) == "table" and data.crew.bunkhouse ~= true then
				Crew.ensure(data)
				data.crew.bunkhouse = true
				data.crew.slots = Crew.slotCount(data.ranch.tier, data.crew.extra, true)
			end
			if passes.DoubleTips == true and not r.offlineTipPaid and r.offlineCrew > 0 then
				r.offlineTipPaid = true
				local extra = math.floor(r.offlineCrew * (Crew.tipMult(true) - 1) + 1e-9)
				if extra > 0 then
					GameService.addCoins(player, data, extra, true, "CrewOffline")
					GameService.toast(player, string.format("Big Tipper added %d coins from while you were away.", extra), "good")
				end
			end
		else
			warn("[GameService] loadPasses failed: " .. tostring(passes))
		end
		guard("passes-refresh", function()
			ctx.World.refreshStations(player)
			ctx.Cosmetics.apply(player)
		end)
		GameService.markDirty(player)
	end)

	guard("rookie", function()
		if Rookie.shouldSkip(data.rookie, data.tutorial.done, data.stats, Config.ROOKIE_VETERAN_SERVES) then
			data.rookie.skipped = true
		end
	end)

	-- Offline progress: one jump from the saved `last` of each cook to now.
	local readyBefore = 0
	local readyAfter = 0
	local awayCrew = { seconds = 0, coins = 0 }
	guard("offline", function()
		for _, cook in pairs(data.stations) do
			if type(cook) == "table" and CookLogic.isDone(cook) then
				readyBefore += 1
			end
		end
		advanceAll(player, data, serverNow(), false)
		Crew.ensure(data)
		local rate = Crew.totalRate(data.crew.owned, data.crew.slots, { rank = data.rank, friends = 0, tipPass = false })
		local settled = Offline.settle(data.offline.lastTick, os.time(), Offline.cap(type(data.crew) == "table" and data.crew.bunkhouse == true), rate)
		data.offline.lastTick = settled.lastTick
		r.offlineCrew = settled.coins
		awayCrew = settled
		if settled.coins > 0 then
			GameService.addCoins(player, data, settled.coins, true, "CrewOffline")
		end
		for key, cook in pairs(data.stations) do
			if type(cook) == "table" and CookLogic.isDone(cook) then
				readyAfter += 1
				r.announcedDone[key] = true
			end
		end
	end)

	guard("season", function()
		PitmasterPath.registerPlayDay(data.path, r.today)
		ctx.Season.sync(player, data)
	end)
	guard("membership", function()
		ctx.Membership.onLoaded(player, data)
	end)
	guard("rank", function()
		local rank = Config.Ranks[data.rank]
		if rank and rank.unlock then
			data.owned[rank.unlock] = true
		end
	end)
	guard("social", function()
		ctx.Social.onJoin(player)
	end)
	guard("cosmetics", function()
		ctx.Cosmetics.apply(player)
	end)
	guard("stations", function()
		ctx.World.refreshStations(player)
	end)
	guard("push", function()
		GameService.push(player)
	end)

	if not player.Parent then
		return
	end
	guard("welcome", function()
		-- A failed live load has empty data, so it looks brand new. Don't play the first-visit
		-- script over a ranch we simply couldn't read. Studio memory mode is a real test session.
		local degraded = profile.memoryOnly and not RunService:IsStudio()
		if isNew and not degraded then
			ctx.Remotes.Push:FireClient(player, "welcome", { isNew = true })
		elseif lastSeen > 0 and (readyAfter > readyBefore or awayCrew.coins > 0) then
			local away = os.time() - lastSeen
			ctx.Remotes.Push:FireClient(player, "welcome", { isNew = false, away = away, ready = readyAfter - readyBefore, crewCoins = awayCrew.coins, crewAway = awayCrew.seconds })
		elseif not degraded then
			ctx.Remotes.Push:FireClient(player, "welcome", { isNew = false })
		end
		if profile.memoryOnly and RunService:IsStudio() then
			GameService.toast(player, "Studio test mode: saving is off. Turn on 'Enable Studio Access to API Services' to test saving.", "warn")
		elseif profile.memoryOnly then
			GameService.toast(player, "Roblox save servers didn't answer, so this visit won't be saved. Your real ranch is untouched. Try rejoining in a minute.", "warn")
		end
	end)
	-- Free Pip for a brand-new ranch. He walks over and is on the crew in under 10 seconds.
	task.delay(Config.Hiring.starterDelay, function()
		if not player.Parent or GameService.runtime[player] ~= r then
			return
		end
		local live = profileOf(player)
		if not live or not Crew.needsStarter(live) then
			return
		end
		local walkFor = Config.Hiring.starterWalk
		if ctx.Crew and ctx.Crew.walkStarter then
			local seconds = ctx.Crew.walkStarter(player)
			if type(seconds) == "number" and seconds > 0 then
				walkFor = math.min(seconds, Config.Onboarding.pipAt)
			end
		end
		task.delay(walkFor, function()
			if not player.Parent or GameService.runtime[player] ~= r then
				return
			end
			local still = profileOf(player)
			if not still or not Crew.needsStarter(still) then
				if ctx.Crew and ctx.Crew.cancelStarter then
					ctx.Crew.cancelStarter(player)
				end
				return
			end
			local pip = Crew.grantStarter(still)
			if not pip then
				return
			end
			if ctx.Crew and ctx.Crew.cancelStarter then
				ctx.Crew.cancelStarter(player)
			end
			GameService.toast(player, "First hire's on the house! Pip is on the ranch.", "good")
			GameService.fx(player, "hired", { name = "Pip", title = "Pit hand" })
			if type(still.guide) == "table" then
				Guide.sync(still.guide, Guide.signals(still))
			end
			GameService.markDirty(player)
		end)
	end)
end

local function onRemoving(player: Player)
	local data = profileOf(player)
	if data then
		advanceAll(player, data, T(), false)
		if type(data.offline) == "table" then
			data.offline.lastTick = os.time()
		end
	end
	if ctx.Crew and ctx.Crew.onPlayerGone then
		ctx.Crew.onPlayerGone(player)
	end
	ctx.Social.onLeave(player)
	ctx.World.releasePlot(player)
	globalLimiter:forget(player)
	acting[player] = nil
	local uid = tostring(player.UserId)
	for name in pairs(Actions) do
		actionLimiter:forget(uid .. name)
	end
	GameService.runtime[player] = nil
	ctx.Data.release(player)
end

-- Unc Hank's Rookie List: claim any goal that's now met (rewards are free and flat).
function GameService.checkRookie(player: Player, data: any)
	if not data.tutorial.done or type(data.rookie) ~= "table" then
		return
	end
	local claimed = Rookie.advance(data.rookie, Config.RookieSteps, data.stats)
	for _, def in ipairs(claimed) do
		local rw = def.reward or {}
		local coins = rw.coins or 0
		if coins > 0 then
			GameService.addCoins(player, data, coins, false)
		end
		local last = data.rookie.claimed >= #Config.RookieSteps
		if last then
			-- the finish reward for all five goals (free; shown on the card from the start)
			local fin = Config.RookieFinish
			if fin.coins and fin.coins > 0 then
				GameService.addCoins(player, data, fin.coins, false)
			end
			if fin.cosmetic then
				GameService.grantCosmetic(player, data, fin.cosmetic)
			end
			if fin.title then
				data.titles[fin.title] = true
			end
			coins += fin.coins or 0
			ctx.Remotes.Push:FireClient(player, "dialog", { npc = "Unc Hank", text = string.format(Content.Rookie.done, coins), reward = 0 })
		else
			GameService.toast(player, string.format(Content.Rookie.stepDone, def.label, coins), "good")
		end
		GameService.fx(player, "rookie", { id = def.id, step = data.rookie.claimed, total = #Config.RookieSteps, coins = coins, last = last, cheer = Content.Rookie.cheers[(data.rookie.claimed - 1) % #Content.Rookie.cheers + 1] })
		GameService.markDirty(player)
	end
end

local function handle(player: Player, action: any, a: any, b: any, c: any): (boolean, string?)
	if type(action) ~= "string" or #action > 24 then
		return false, "Bad request."
	end
	local fn = Actions[action]
	if not fn then
		return false, "Unknown action."
	end
	local now = os.clock()
	if not globalLimiter:allow(player, now) or not actionLimiter:allow(tostring(player.UserId) .. action, now) then
		return false, "Slow down, partner!"
	end
	local data = profileOf(player)
	local r = rt(player)
	if not data or not r then
		return false, "Still loading your ranch..."
	end
	if acting[player] then
		return false, "Slow down, partner!"
	end
	r.lastActive = now
	advanceAll(player, data, T(), true)
	-- Set after advanceAll so an error there can never leave the player locked out.
	acting[player] = true
	local ok, res, msg = pcall(function()
		return (fn :: any)(player, data, a, b, c)
	end)
	acting[player] = nil
	if not ok then
		warn("[GameService] action " .. action .. " errored: " .. tostring(res))
		return false, "Something went wrong."
	end
	if res then
		GameService.checkRookie(player, data)
		if type(data.guide) == "table" then
			Guide.sync(data.guide, Guide.signals(data))
		end
	end
	GameService.markDirty(player)
	return res, msg
end

function GameService.act(player: Player, action: string, a: any, b: any, c: any): (boolean, string?)
	return handle(player, action, a, b, c)
end

function GameService.init(c: any)
	ctx = c
end

local function emptyTended(data: any, prefix: string, slots: number): string?
	for i = 2, slots do
		local key = prefix .. i
		if data.stations[key] == nil then
			return key
		end
	end
	return nil
end

local function doneKeys(data: any): { string }
	local keys = {}
	for key, cook in pairs(data.stations) do
		if type(cook) == "table" and CookLogic.isDone(cook) and not cook.burnt and cook.meat ~= "firstbrisket" then
			table.insert(keys, key)
		end
	end
	return keys
end

local function countOpen(data: any, prefix: string, slots: number): number
	local n = 0
	for i = 2, slots do
		if data.stations[prefix .. i] == nil then
			n += 1
		end
	end
	return n
end

-- Crew tick. The player's first grill and first smoker are never used here.
function GameService.crewMults(player: Player, data: any): Crew.Mults
	local r = rt(player)
	local cheers: { [number]: boolean } = {}
	if r and type(r.cheerUntil) == "table" then
		local now = os.time()
		for uid, untilT in pairs(r.cheerUntil) do
			if Partners.cheered(untilT, now) then
				cheers[uid] = true
			end
		end
	end
	return {
		rank = data.rank,
		friends = if r then r.crew else 0,
		tipPass = r ~= nil and r.passes.DoubleTips == true,
		index = Index.incomeMult(data),
		cheers = cheers,
		income = type(data.crew) == "table" and type(data.crew.boostUntil) == "number" and data.crew.boostUntil > os.time(),
	}
end

function GameService.hireApplicant(player: Player, index: any): (boolean, string?)
	local data = profileOf(player)
	local r = rt(player)
	if not data or not r then
		return false, "Still loading your ranch..."
	end
	if type(index) ~= "number" then
		local parsed = tonumber(index)
		if parsed == nil then
			return false, "Bad request."
		end
		index = parsed
	end
	local line = if ctx.Crew and ctx.Crew.line then ctx.Crew.line() else nil
	if type(line) ~= "table" or type(line.applicants) ~= "table" then
		return false, "The hiring line is still walking in."
	end
	if line.window ~= HiringLine.window(os.time(), Config.Hiring.period) then
		return false, "A new lineup just walked in."
	end
	local applicant = nil
	for _, row in ipairs(line.applicants) do
		if row.index == index then
			applicant = row
			break
		end
	end
	if not applicant then
		return false, "They're not on the line."
	end
	local outcome = Crew.tryHire(data, applicant)
	if not outcome.ok then
		return false, Crew.hireMessage(outcome.reason, outcome.cost)
	end
	if not HiringLine.tryTake(line.taken, index :: number, player.UserId) then
		return false, "Someone else hired them."
	end
	local member = Crew.applyHire(data, outcome)
	if not member then
		line.taken[index] = nil
		return false, "You can't hire right now."
	end
	local verb = if outcome.mergeUid then "picked up a new trick" else "is walking to your ranch"
	GameService.toast(player, member.name .. " " .. verb .. ".", "good")
	GameService.fx(player, "hired", { name = member.name, title = (Config.CrewRoles :: any)[member.role] and (Config.CrewRoles :: any)[member.role].name or "Crew" })
	if not outcome.mergeUid and ctx.Crew and ctx.Crew.walkHome then
		ctx.Crew.walkHome(player, index)
	end
	return true, nil
end

Actions.HireApplicant = function(player, _data, index)
	return GameService.hireApplicant(player, index)
end

Actions.AddPartner = function(player, data, userId)
	Partners.ensure(data)
	local otherId = tostring(userId)
	local other = nil
	for _, candidate in ipairs(Players:GetPlayers()) do
		if tostring(candidate.UserId) == otherId then
			other = candidate
			break
		end
	end
	if not other then
		return false, "They're not in this server."
	end
	local privateServer = game.PrivateServerOwnerId ~= 0
	local friend = false
	if ctx.Social and ctx.Social.areFriends then
		friend = ctx.Social.areFriends(player, other)
	end
	local ok, why = Partners.canAdd(data.partners, tostring(player.UserId), otherId, friend, privateServer)
	if not ok then
		return false, why
	end
	Partners.add(data, otherId)
	if ctx.Social and ctx.Social.refreshBonus then
		ctx.Social.refreshBonus()
	end
	GameService.toast(player, other.DisplayName .. " is a ranch partner.", "good")
	return true, nil
end

Actions.RemovePartner = function(_player, data, userId)
	if not Partners.remove(data, tostring(userId)) then
		return false, "They're not a partner."
	end
	if ctx.Social and ctx.Social.refreshBonus then
		ctx.Social.refreshBonus()
	end
	return true, nil
end

Actions.Cheer = function(player, data, ownerId, crewUid)
	local owner = nil
	for _, candidate in ipairs(Players:GetPlayers()) do
		if candidate.UserId == ownerId or tostring(candidate.UserId) == tostring(ownerId) then
			owner = candidate
			break
		end
	end
	if not owner then
		return false, "They're not in this server."
	end
	local ownerData = profileOf(owner)
	local ownerRun = rt(owner)
	local mine = rt(player)
	if not ownerData or not ownerRun or not mine then
		return false, "Still loading."
	end
	local partner = false
	for _, id in ipairs(Partners.ensure(ownerData)) do
		if id == tostring(player.UserId) then
			partner = true
		end
	end
	local family = type(ownerData.family) == "table" and ownerData.family.on == true and game.PrivateServerOwnerId ~= 0
	local allowed, why = Partners.canCheer(tostring(player.UserId), tostring(owner.UserId), partner, family)
	if not allowed then
		return false, why
	end
	local uid = tonumber(crewUid)
	if not uid or not Crew.findUid(ownerData.crew.owned, uid) then
		return false, "That critter isn't on the ranch."
	end
	local now = os.time()
	if type(data) ~= "table" then
		return false, "Still loading."
	end
	-- `data` here is the cheerer, because act() passes the acting player's profile.
	local savedNext = if type(data.social) == "table" then data.social.cheerNext else nil
	local result = Partners.tryCheer(now, savedNext, ownerRun.cheerUntil[uid])
	if not result.ok or not result.untilT then
		return false, result.reason
	end
	ownerRun.cheerUntil[uid] = result.untilT
	if type(data.social) ~= "table" then
		data.social = { cheerNext = 0 }
	end
	data.social.cheerNext = Partners.cheerCooldown(now)
	GameService.toast(owner, player.DisplayName .. " cheered a critter. x1.25 for a minute.", "good")
	GameService.markDirty(owner)
	return true, nil
end

Actions.FamilyRanch = function(player, data, on)
	if not Partners.canHostFamily(game.PrivateServerOwnerId ~= 0, player.UserId == game.PrivateServerOwnerId) then
		return false, "Family Ranch is for the host of a private server."
	end
	if type(data.family) ~= "table" then
		data.family = { on = false, purse = 0 }
	end
	data.family.on = on == true
	if ctx.Social and ctx.Social.refreshBonus then
		ctx.Social.refreshBonus()
	end
	GameService.toast(player, if data.family.on then "Family Ranch is on. Tiers come from the shared purse." else "Family Ranch is off.", "info")
	return true, nil
end

Actions.RedeemCode = function(_player, data, raw)
	local result = Codes.redeem(data, raw, os.time(), Config.CodesLikesLive)
	return result.ok, result.message
end

Actions.ChipPurse = function(player, data, amount)
	if game.PrivateServerOwnerId == 0 then
		return false, "The shared purse is for a private server."
	end
	local host, hostData = GameService.familyHost()
	if not host or not hostData then
		local here = false
		for _, candidate in ipairs(Players:GetPlayers()) do
			if candidate.UserId == game.PrivateServerOwnerId and GameService.runtime[candidate] then
				here = true
			end
		end
		return false, if here then "Family Ranch is off." else "The host isn't here."
	end
	local moved = Purse.transfer(data, hostData, math.floor(tonumber(amount) or 0), tostring(host.UserId), os.time(), function()
		local profile = ctx.Data.profiles[player]
		return profile ~= nil and ctx.Data.save(profile, false)
	end, function()
		local profile = ctx.Data.profiles[host]
		return profile ~= nil and ctx.Data.save(profile, false)
	end)
	if not moved.ok then
		return false, moved.message
	end
	GameService.markDirty(host)
	GameService.toast(player, moved.message, "good")
	return true, nil
end

Actions.LevelCrew = function(player, data, uid)
	local outcome = Crew.tryLevel(data, uid)
	if not Crew.applyLevel(data, outcome) then
		return false, Crew.levelMessage(outcome.reason, outcome.cost)
	end
	local member = Crew.findUid(data.crew.owned, outcome.uid :: number)
	local name = if member then member.name else "Your critter"
	GameService.toast(player, string.format("%s is now level %d.", name, outcome.level), "good")
	GameService.fx(player, "levelup", { text = name .. " " .. tostring(outcome.level) })
	return true, nil
end

Actions.BuyRanchTier = function(player, data)
	local hostData = data
	local family = false
	local _, saved = GameService.familyHost()
	if saved then
		hostData = saved
		family = true
	end
	if family and hostData ~= data then
		Partners.ensure(hostData)
	end
	if family then
		local nxt = Crew.nextTier(math.floor(hostData.ranch.tier or 1))
		if not nxt or not nxt.cost or nxt.cost <= 0 then
			return false, "The ranch is built out."
		end
		if (hostData.family.purse or 0) < nxt.cost then
			return false, "The family purse needs more coins."
		end
		hostData.family.purse -= nxt.cost
		hostData.ranch.tier = nxt.tier
		Crew.ensure(hostData)
		hostData.crew.slots = Crew.slotCount(nxt.tier, hostData.crew.extra or 0, hostData.crew.bunkhouse == true)
		GameService.toast(player, string.format("Family ranch tier %d: %s.", nxt.tier, nxt.name), "good")
		return true, nil
	end
	local nxt = Crew.nextTier(math.floor(data.ranch.tier or 1))
	local price = if nxt then Onboard.tierPrice(nxt.cost, data.ranch.tier or 1, data.playSeconds or 0, Onboard.skip(data)) else nil
	local outcome = Crew.tryTier(data, price)
	if not Crew.applyTier(data, outcome) then
		return false, Crew.tierMessage(outcome.reason, outcome.cost)
	end
	GameService.toast(player, string.format("Ranch tier %d: %s.", outcome.tier, outcome.name), "good")
	GameService.fx(player, "levelup", { text = outcome.name })
	return true, nil
end

-- The private-server host, only while Family Ranch is on. Crew stays on each plot.
function GameService.familyHost(): (Player?, any)
	if game.PrivateServerOwnerId == 0 then
		return nil, nil
	end
	for _, candidate in ipairs(Players:GetPlayers()) do
		-- runtime is cleared before the leave save, so a leaving host's record is never written after it.
		if candidate.UserId == game.PrivateServerOwnerId and GameService.runtime[candidate] then
			local hostData = profileOf(candidate)
			if hostData and type(hostData.family) == "table" and hostData.family.on == true then
				return candidate, hostData
			end
			return nil, nil
		end
	end
	return nil, nil
end

function GameService.crewSlots(data: any): number
	local slots = if type(data.crew) == "table" then data.crew.slots or 0 else 0
	local _, hostData = GameService.familyHost()
	if hostData then
		local extra = if type(data.crew) == "table" then data.crew.extra or 0 else 0
		local bunk = type(data.crew) == "table" and data.crew.bunkhouse == true
		slots = Crew.slotCount(hostData.ranch.tier or 1, extra, bunk)
	end
	return slots
end

local function payCrew(player: Player, data: any, r: Runtime)
	if type(data.crew) ~= "table" or type(data.crew.owned) ~= "table" then
		return
	end
	local slots = GameService.crewSlots(data)
	local rate = Crew.totalRate(data.crew.owned, slots, GameService.crewMults(player, data))
	local coins, bank = Crew.tickPay(rate, r.crewBank)
	r.crewBank = bank
	if type(data.offline) ~= "table" then
		data.offline = { lastTick = 0 }
	end
	data.offline.lastTick = os.time()
	if coins > 0 then
		GameService.addCoins(player, data, coins, true, "Crew")
	end
end

local function runCrewJobs(player: Player, data: any, r: Runtime, t: number)
	if type(data.crew) ~= "table" or type(data.crew.owned) ~= "table" then
		return
	end
	local slots = data.crew.slots or 0
	for i, member in ipairs(data.crew.owned) do
		if i > slots then
			break
		end
		local key = tostring(member.uid)
		if r.crewNext[key] == nil then
			r.crewNext[key] = t + i * 0.4
		end
		if t >= r.crewNext[key] then
			r.crewNext[key] = t + Config.Hiring.workSeconds
			local job = Crew.job(member.role)
			if job == "smoke" then
				local slot = emptyTended(data, "s", GameService.slotCount(player, data, "smoker"))
				if slot then
					GameService.beginCook(player, data, slot, "hotlink", { quiet = true, hand = "crew" })
				end
			elseif job == "grill" then
				local slot = emptyTended(data, "g", GameService.slotCount(player, data, "grill"))
				if slot then
					GameService.beginCook(player, data, slot, "burger", { quiet = true, hand = "crew" })
				end
			elseif job == "serve" and #r.customers > 0 then
				GameService.serveCustomer(player, r.customers[1], nil, true)
			end
		end
	end
end

local function runStaff(player: Player, data: any, r: any, t: number)
	if not Config.Chores.legacyStaff then
		return
	end
	if type(data.staff) ~= "table" then
		return
	end
	Staff.normalize(data)
	local slots = Staff.slots(data.pitLevel)
	local waiter = GameService.hasPass(player, "AutoServe")
	local grillSlots = GameService.slotCount(player, data, "grill")
	local smokerSlots = GameService.slotCount(player, data, "smoker")
	local rm = rankMult(data)
	for i, e in ipairs(data.staff.roster) do
		if i > slots then
			r.staffJob[e.id] = "wait"
			continue
		end
		if r.staffNext[e.id] == nil then
			r.staffNext[e.id] = t + 1.5 + i * 0.35
		end
		if t < r.staffNext[e.id] then
			continue
		end
		local finished = doneKeys(data)
		local held = potluckHeld(data)
		local world = {
			coins = data.coins,
			cooler = Holiday.servable(#data.cooler, held ~= nil),
			coolerMax = Config.COOLER_MAX,
			customers = #r.customers,
			openGrill = countOpen(data, "g", grillSlots),
			openSmoker = countOpen(data, "s", smokerSlots),
			done = #finished,
			burgerCost = Economy.rawCost(Config.Meats.burger, rm),
			linkCost = Economy.rawCost(Config.Meats.hotlink, rm),
		}
		local decision = Staff.decide(e, world)
		r.staffNext[e.id] = t + Staff.interval(e.speed, waiter)
		if not decision then
			r.staffJob[e.id] = "idle"
			continue
		end
		if decision.kind == "serve" then
			r.staffJob[e.id] = "serve"
			local tip = Staff.qualityTip(e.quality)
			for _ = 1, decision.count do
				if #r.customers == 0 or Holiday.servable(#data.cooler, potluckHeld(data) ~= nil) <= 0 then
					break
				end
				local served = GameService.serveCustomer(player, r.customers[1], tip, true)
				if not served then
					break
				end
			end
		elseif decision.kind == "collect" then
			r.staffJob[e.id] = "carry"
			local n = 0
			for _, key in ipairs(finished) do
				if n >= decision.count then
					break
				end
				if collect(player, data, key) then
					n += 1
				end
			end
		elseif decision.kind == "cook" and decision.meat then
			r.staffJob[e.id] = "cook"
			local prefix = if decision.meat == "burger" then "g" else "s"
			local slotN = if decision.meat == "burger" then grillSlots else smokerSlots
			for _ = 1, decision.count do
				local key = emptyTended(data, prefix, slotN)
				if not key then
					break
				end
				local cooked = GameService.beginCook(player, data, key, decision.meat, {
					quiet = true,
					luckMult = Staff.qualityLuck(e.quality),
					hand = e.id,
				})
				if not cooked then
					break
				end
			end
			ctx.World.refreshStations(player)
		end
	end
end

-- Finish chips whose contributor saved and the host had not. A nonce already on the host is not added again.
function GameService.settlePurse(player: Player)
	local host, hostData = GameService.familyHost()
	if not host or not hostData then
		return
	end
	if player == host then
		for other in pairs(GameService.runtime) do
			if other ~= host then
				GameService.settlePurse(other)
			end
		end
	end
	local data = profileOf(player)
	if type(data) ~= "table" or type(data.purseOut) ~= "table" or #data.purseOut == 0 then
		return
	end
	local mine = {}
	for _, entry in ipairs(data.purseOut) do
		if type(entry) == "table" and entry.hostId == tostring(host.UserId) then
			table.insert(mine, entry)
		end
	end
	if #mine == 0 then
		return
	end
	local fresh = false
	for _, entry in ipairs(mine) do
		if Purse.apply(hostData, entry) then
			fresh = true
		end
	end
	if fresh then
		local hostProfile = ctx.Data.profiles[host]
		if not (hostProfile and ctx.Data.save(hostProfile, false)) then
			return
		end
	end
	for _, entry in ipairs(mine) do
		Purse.ack(data, entry.nonce)
	end
	local profile = ctx.Data.profiles[player]
	if profile then
		ctx.Data.save(profile, false)
	end
	GameService.markDirty(host)
end

function GameService.tickOnboard(player: Player, data: any)
	if type(data.onboard) ~= "table" or Onboard.skip(data) then
		return
	end
	local r = rt(player)
	if not r then
		return
	end
	if (data.playSeconds or 0) >= Config.Onboarding.traitAt and data.onboard.taught ~= true and type(data.crew) == "table" then
		for _, member in ipairs(data.crew.owned or {}) do
			if member.trait == "none" or member.trait == nil or member.trait == "" then
				member.trait = "smoky"
				Index.note(data, member.species, "smoky")
				data.onboard.taught = true
				GameService.toast(player, member.name .. " caught Smoky. That's a trait, and it's free.", "good")
				break
			end
		end
	end
	local ownedN = if type(data.crew) == "table" and type(data.crew.owned) == "table" then #data.crew.owned else 0
	local step = Onboard.reached({
		claimed = r.plot ~= nil,
		crew = ownedN,
		tier = if type(data.ranch) == "table" then data.ranch.tier or 1 else 1,
		trait = data.onboard.taught == true,
		playSeconds = data.playSeconds or 0,
		shopSeen = data.onboard.shopSeen == true,
	})
	if step >= 7 then
		data.onboard.done = true
		if type(data.guide) == "table" then
			data.guide.done = true
		end
	end
	if ctx.Insights and ctx.Insights.minute then
		ctx.Insights.minute(player, data, step)
	end
	r.dirty = true
end

function GameService.autoHire(player: Player)
	local data = profileOf(player)
	local r = rt(player)
	if not data or not r or r.passes.AutoHire ~= true then
		return
	end
	if type(data.settings) == "table" and data.settings.autoHire == false then
		return
	end
	local line = if ctx.Crew and ctx.Crew.line then ctx.Crew.line() else nil
	if type(line) ~= "table" or type(line.applicants) ~= "table" then
		return
	end
	local bestIndex = nil
	local bestRate = -1
	for _, applicant in ipairs(line.applicants) do
		if line.taken[applicant.index] == nil and type(applicant.price) == "number" and data.coins >= applicant.price then
			local rate = applicant.rate or 0
			if rate > bestRate then
				bestRate = rate
				bestIndex = applicant.index
			end
		end
	end
	if bestIndex then
		GameService.hireApplicant(player, bestIndex)
	end
end

function GameService.start()
	ctx.Remotes.Action.OnServerInvoke = function(player: Player, action: any, a: any, b: any, c: any)
		local ok, msg = handle(player, action, a, b, c)
		return { ok = ok, msg = msg }
	end

	ctx.Data.onLoaded.Event:Connect(onLoaded)
	Players.PlayerAdded:Connect(function(player)
		ctx.Data.load(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(ctx.Data.load, player)
	end
	Players.PlayerRemoving:Connect(onRemoving)

	-- 1-second simulation tick
	task.spawn(function()
		while true do
			task.wait(1)
			local t = T()
			for player, r in pairs(GameService.runtime) do
				local data = profileOf(player)
				if data then
					advanceAll(player, data, t, true)
					data.playSeconds += 1
					GameService.tickOnboard(player, data)
					GameService.checkRookie(player, data) -- catches goals met through world prompts too
					ctx.Season.check(player, data)
					ctx.Insights.onboarding(player, data)
					-- day rollover while playing
					local d = today()
					if Streak.healClock(data.streak, d) then
						r.dirty = true
					end
					if type(data.freeGift) == "table" then
						local giftAt = data.freeGift.nextAt
						FreeGift.normalize(data.freeGift, os.time())
						if data.freeGift.nextAt ~= giftAt then
							r.dirty = true
						end
					end
					if type(data.guide) == "table" and Guide.sync(data.guide, Guide.signals(data)) then
						r.dirty = true
					end
					if d ~= r.today then
						r.today = d
						PitmasterPath.registerPlayDay(data.path, d)
						ctx.Season.sync(player, data)
						ctx.Membership.onNewDay(player, data)
						GameService.toast(player, "A new day at the ranch! Daily reward and a new Path step are ready.", "good")
						r.eventNoteDue = true -- an event (or its teaser week) may start today
						r.dirty = true
					end
					if r.eventNoteDue and ctx.Event and ctx.Event.eventNote and ctx.Event.eventNote(player) then
						r.eventNoteDue = false
					end
					-- customers
					for i = #r.customers, 1, -1 do
						local cst = r.customers[i]
						if t > cst.leaveAt then
							removeCustomer(player, cst)
						end
					end
					if #r.customers < Config.CUSTOMER_SPOTS and t >= r.nextSpawn then
						local greeters = 0
						if type(data.crew) == "table" and type(data.crew.owned) == "table" then
							greeters = Crew.greeterCount(data.crew.owned, data.crew.slots or 0)
						end
						r.nextSpawn = t + Config.CUSTOMER_SPAWN_SECONDS * (0.7 + rng:NextNumber() * 0.6) * Crew.greeterDelay(greeters)
						spawnCustomer(player, data, r)
					end
					payCrew(player, data, r)
					runCrewJobs(player, data, r, t)
					runStaff(player, data, r, t)
					-- Jimothy the Waiter stays his own pass: he serves plates you already cooked.
					-- The crew cooks and serves too. Owning the pass also shortens their interval.
					local servable = Holiday.servable(#data.cooler, potluckHeld(data) ~= nil)
					if GameService.hasPass(player, "AutoServe") and t - r.lastAutoServe >= 4 and #r.customers > 0 and servable > 0 then
						r.lastAutoServe = t
						GameService.serveCustomer(player, r.customers[1], nil, true)
					end
					-- healthy-play nudge after an hour
					if not r.nudged and (os.clock() - r.sessionStart) > Config.PLAYTIME_NUDGE_MINUTES * 60 then
						r.nudged = true
						GameService.toast(player, "You've been smokin' for an hour! Take a stretch break. Your smokers keep cooking while you're away. 🌤️", "info")
					end
				end
			end
		end
	end)

	-- push loop (coalesces many changes into at most 4 snapshots/sec per player)
	task.spawn(function()
		while true do
			task.wait(0.25)
			for player, r in pairs(GameService.runtime) do
				if r.dirty then
					local okPush, errPush = pcall(function(): nil
						GameService.push(player)
						return nil
					end)
					if not okPush then
						warn("[GameService] push failed: " .. tostring(errPush))
					end
				end
			end
		end
	end)

	-- refresh timers on clients every 5s even if nothing changed (restock countdown etc.)
	task.spawn(function()
		while true do
			task.wait(5)
			for player, _ in pairs(GameService.runtime) do
				GameService.markDirty(player)
			end
		end
	end)
end

return GameService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">InsightsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	InsightsService — Roblox Analytics (Creator Dashboard > Analytics).
	  * Onboarding funnel: each step once per account (saved in data.analytics.onboard).
	  * "PitShop" funnel: opened shop -> opened a tab -> tapped buy -> bought, per visit.
	  * Economy: coin sources and sinks, added up and sent once a minute per player.
	  * Smokehouse Pass progression: each tier reached.
	Every call is wrapped in pcall; analytics can never break the game. Nothing is shown to
	players and nothing here changes prices or offers per player.
]]
local AnalyticsService = game:GetService("AnalyticsService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Funnels = require(Shared.Logic.Funnels)
local Onboard = require(Shared.Logic.Onboard)

local InsightsService = {}
local ctx: any = nil
local STEPS = Funnels.onboardingSteps(Config.RookieSteps)

local shopSession: { [Player]: { id: string, step: number } } = {}
local coinBuckets: { [Player]: Funnels.Bucket } = {}

local function try(fn: () -> ())
	local ok, err = pcall(fn :: any)
	if not ok then
		warn("[Insights] " .. tostring(err))
	end
end

-- Log any onboarding steps this save has newly reached.
function InsightsService.minute(player: Player, data: any, step: number)
	if type(data.analytics) ~= "table" then
		data.analytics = { onboard = 0, minute = 0 }
	end
	local logged = data.analytics.minute or 0
	for i = logged + 1, math.min(step, #Onboard.STEPS) do
		local name = Onboard.STEPS[i]
		try(function()
			AnalyticsService:LogOnboardingFunnelStepEvent(player, i, name)
		end)
		data.analytics.minute = i
	end
end

function InsightsService.onboarding(player: Player, data: any)
	if type(data.analytics) ~= "table" or not Onboard.skip(data) then
		return
	end
	local reached = Funnels.onboardingReached(data, Config.RookieSteps)
	for _, i in ipairs(Funnels.newSteps(data.analytics.onboard or 0, reached)) do
		try(function()
			AnalyticsService:LogOnboardingFunnelStepEvent(player, i, STEPS[i])
		end)
		data.analytics.onboard = i
	end
end

local function shopStep(player: Player, step: number, extra: { [string]: any }?)
	local s = shopSession[player]
	if step == 1 or not s then
		s = { id = HttpService:GenerateGUID(false), step = 0 }
		shopSession[player] = s
	end
	if step <= s.step and step ~= 3 then
		return -- each step once per visit (taps can repeat)
	end
	s.step = math.max(s.step, step)
	local id = s.id
	try(function()
		AnalyticsService:LogFunnelStepEvent(player, "PitShop", id, step, Funnels.SHOP[step], extra)
	end)
end

function InsightsService.shopOpened(player: Player)
	shopStep(player, 1)
end
function InsightsService.shopTab(player: Player, tab: string)
	shopStep(player, 2, { [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = tab })
end
function InsightsService.shopPrompt(player: Player, sku: string)
	shopStep(player, 3, { [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = sku })
end
function InsightsService.shopBought(player: Player, sku: string)
	shopStep(player, 4, { [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = sku })
	try(function()
		AnalyticsService:LogCustomEvent(player, "RobuxPurchase:" .. sku, 1)
	end)
end

function InsightsService.coins(player: Player, amount: number, tx: string, sku: string)
	local b = coinBuckets[player]
	if not b then
		b = {}
		coinBuckets[player] = b
	end
	Funnels.addCoins(b, amount, tx, sku)
end

function InsightsService.seasonTier(player: Player, seasonId: string, tier: number)
	try(function()
		AnalyticsService:LogProgressionCompleteEvent(player, "SmokehousePass_" .. seasonId, tier, "Tier " .. tier)
	end)
end

local function flush(player: Player)
	local b = coinBuckets[player]
	local data = ctx.Game.dataOf(player)
	coinBuckets[player] = nil
	if not b or not data then
		return
	end
	for _, e in pairs(b) do
		try(function()
			local flow = e.flow == "Source" and Enum.AnalyticsEconomyFlowType.Source or Enum.AnalyticsEconomyFlowType.Sink
			AnalyticsService:LogEconomyEvent(player, flow, "Coins", e.amount, math.max(0, data.coins), e.tx, e.sku)
		end)
	end
end

function InsightsService.init(c: any)
	ctx = c
end

function InsightsService.start()
	task.spawn(function()
		while true do
			task.wait(60)
			for player in pairs(coinBuckets) do
				flush(player)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		flush(p)
		shopSession[p] = nil
	end)
end

return InsightsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">MembershipService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MembershipService — Pit Crew Club (Roblox subscription), Roblox Premium and private servers.
	  * Pit Crew Club: status comes from MarketplaceService:GetUserSubscriptionStatusAsync and
	    Players.UserSubscriptionStatusChanged. Shown only when the ID is set and PolicyService
	    says the player can subscribe. Perks: a monthly look kept forever, a name tag, a daily
	    server-wide Smoke Shower and one free Smokehouse Pass tier a month. Never coins.
	  * Premium: members get a free look (Config.Premium.look). Premium Payouts are automatic.
	  * Private servers: the owner gets a "Ranch Host" tag and a Smoke Shower every 10 minutes.
	In Studio, the Club can be test-toggled for free (saved as owned["sub:PitCrewClub"]).
]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Monetization = require(Shared.Monetization)
local Storefront = require(Shared.Logic.Storefront)
local Onboard = require(Shared.Logic.Onboard)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Holiday = require(Shared.Logic.Holiday)

local MembershipService = {}
local ctx: any = nil
local IS_STUDIO = RunService:IsStudio()
local CLUB = Monetization.Subscriptions.PitCrewClub

local members: { [Player]: boolean? } = {}
local hostShowerAt = -1e9

local function today(): number
	return TimeUtil.dayNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

function MembershipService.isMember(player: Player): boolean
	return members[player] == true
end

function MembershipService.isHost(player: Player): boolean
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId ~= 0 and game.PrivateServerOwnerId == player.UserId
end

function MembershipService.isPremium(player: Player): boolean
	return player.MembershipType == Enum.MembershipType.Premium
end

-- Can this player be offered the Club at all? (ID set or Studio, and Roblox policy allows it)
function MembershipService.offerable(player: Player): boolean
	if CLUB.id == "" and not IS_STUDIO then
		return false
	end
	if IS_STUDIO then
		return true
	end
	local policy = ctx.Purchase.policy(player)
	return policy ~= nil and policy.IsEligibleToPurchaseSubscription == true
end

-- Monthly perks: this month's look (kept forever) and one free Smokehouse Pass tier.
local function monthly(player: Player, data: any)
	if not members[player] then
		return
	end
	local y, m = Holiday.civilFromDays(today())
	local key = Storefront.monthKey(y, m)
	if data.club.month == key then
		return
	end
	data.club.month = key
	local look = Storefront.clubLook(Config.Club.looks, y, m)
	ctx.Game.grantCosmetic(player, data, look)
	ctx.Season.grantSkips(player, data, Config.Club.monthlyTierSkips)
	local def = Config.Cosmetics[look]
	ctx.Game.toast(player, string.format("🔧 Pit Crew Club: this month's look is %s. It's yours to keep!", def and def.name or look), "good")
	ctx.Game.markDirty(player)
end

local function refreshClub(player: Player)
	local data = ctx.Game.dataOf(player)
	if not data then
		return
	end
	local on = false
	if CLUB.id ~= "" then
		local ok, status = pcall(function()
			return MarketplaceService:GetUserSubscriptionStatusAsync(player, CLUB.id)
		end)
		on = ok and type(status) == "table" and status.IsSubscribed == true
	end
	if IS_STUDIO and data.owned["sub:PitCrewClub"] then
		on = true
	end
	local was = members[player] == true
	members[player] = on or nil
	if on then
		monthly(player, data)
	end
	if on ~= was then
		ctx.Cosmetics.apply(player)
		ctx.Game.markDirty(player)
	end
end

local function refreshPremium(player: Player)
	local data = ctx.Game.dataOf(player)
	if data and MembershipService.isPremium(player) and not data.owned[Config.Premium.look] then
		ctx.Game.grantCosmetic(player, data, Config.Premium.look)
		ctx.Game.toast(player, "⭐ Thanks for being a Roblox Premium member! The Premium Pitmaster Bandana is in your closet.", "good")
	end
end

function MembershipService.onLoaded(player: Player, data: any)
	if MembershipService.isHost(player) then
		data.titles[Config.PrivateServer.hostTitle] = true
	end
	task.spawn(refreshClub, player)
	refreshPremium(player)
end

function MembershipService.onNewDay(player: Player, data: any)
	monthly(player, data)
end

-- Share a free Smoke Shower with everyone else in the server.
local function shower(from: Player, label: string)
	local now = workspace:GetServerTimeNow()
	for other in pairs(ctx.Game.runtime) do
		local od = other ~= from and ctx.Game.dataOf(other) or nil
		if od and od.boost.untilT <= now then
			ctx.Game.addBoost(od, Config.Club.showerMinutes, Config.FairPlay.showerMult)
			ctx.Game.markDirty(other)
		end
	end
	ctx.Game.announce(string.format("💨 %s %s shared a Smoke Shower! Everyone else gets x%.2g cook speed for %d min.", label, from.DisplayName, Config.FairPlay.showerMult, Config.Club.showerMinutes), "#7CD1C1")
end

function MembershipService.snapshot(player: Player, data: any): any
	return {
		club = members[player] == true,
		clubOffer = MembershipService.offerable(player),
		clubShowerReady = members[player] == true and data.club.showerDay ~= today(),
		premium = MembershipService.isPremium(player),
		host = MembershipService.isHost(player),
		hostShowerReady = MembershipService.isHost(player) and os.clock() - hostShowerAt >= Config.PrivateServer.hostShowerCooldown,
	}
end

function MembershipService.init(c: any)
	ctx = c
	local A: any = c.Game.Actions
	A.Subscribe = function(player, data): (boolean, string?)
		if not Onboard.allowPurchase(data.playSeconds or 0, Onboard.skip(data)) then
			return false, "Have a look around first. The shop is here when you want it."
		end
		if members[player] then
			return false, "You're already in the Pit Crew Club. Thanks!"
		end
		if not MembershipService.offerable(player) then
			return false, "The Pit Crew Club isn't available here."
		end
		if CLUB.id == "" then
			data.owned["sub:PitCrewClub"] = true
			refreshClub(player)
			return true, "Studio test: Pit Crew Club on (only in Studio)."
		end
		ctx.Insights.shopPrompt(player, "PitCrewClub")
		MarketplaceService:PromptSubscriptionPurchase(player, CLUB.id)
		return true, nil
	end
	A.ClubShower = function(player, data): (boolean, string?)
		if not members[player] then
			return false, "That's a Pit Crew Club perk."
		end
		if data.club.showerDay == today() then
			return false, "You've shared today's Pit Crew Smoke Shower. Thanks! See you tomorrow."
		end
		data.club.showerDay = today()
		shower(player, "🔧 Pit Crew member")
		return true, nil
	end
	A.HostShower = function(player, _data): (boolean, string?)
		if not MembershipService.isHost(player) then
			return false, "Only the host of a private server can do that."
		end
		if os.clock() - hostShowerAt < Config.PrivateServer.hostShowerCooldown then
			return false, "The smoker's still warming up. Try again in a few minutes."
		end
		hostShowerAt = os.clock()
		shower(player, "🏠 Ranch Host")
		return true, nil
	end
	A.PremiumInfo = function(player, data): (boolean, string?)
		if not Onboard.allowPurchase(data.playSeconds or 0, Onboard.skip(data)) then
			return false, "Have a look around first. The shop is here when you want it."
		end
		if MembershipService.isPremium(player) then
			return false, "You're already a Premium member. Thanks!"
		end
		pcall(function()
			MarketplaceService:PromptPremiumPurchase(player)
		end)
		return true, nil
	end
end

function MembershipService.start()
	-- The subscription event is live-server only. Indexing it must not be fatal if an
	-- older engine build doesn't have it; the club id is empty until it's created anyway.
	local okSub, errSub = pcall(function()
		Players.UserSubscriptionStatusChanged:Connect(function(player: Player, subscriptionId: string)
			if subscriptionId == CLUB.id and CLUB.id ~= "" then
				refreshClub(player)
			end
		end)
	end)
	if not okSub then
		warn("[Membership] UserSubscriptionStatusChanged: " .. tostring(errSub))
	end
	Players.PlayerMembershipChanged:Connect(function(player: Player)
		refreshPremium(player)
		ctx.Game.markDirty(player)
	end)
	Players.PlayerRemoving:Connect(function(p)
		members[p] = nil
	end)
end

return MembershipService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PurchaseService — Game Passes and Developer Products.
	  * ProcessReceipt is idempotent: each PurchaseId is recorded in the player's save
	    (ReceiptLedger) and the save must succeed before we tell Roblox "PurchaseGranted".
	    If Roblox calls again for the same PurchaseId we just say "granted" without re-granting.
	  * IDs live in ReplicatedStorage.Shared.Monetization. Items with id 0 are hidden in the
	    live game; in Studio they get a free "Studio test" grant so you can try everything.
	  * Nothing sold here is random. Robux never buys coins.
	  * Every "can I buy this?" rule is in Shared.Logic.Storefront (unit-tested): weekly rotation,
	    Turkey Day and Holiday Smokeout looks only during their dates, one-per-account packs, nothing you already own, season limits.
	  * Roblox PolicyService info is fetched per player; MembershipService uses
	    IsEligibleToPurchaseSubscription to decide who sees the Pit Crew Club.
]]
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Monetization = require(Shared.Monetization)
local Onboard = require(Shared.Logic.Onboard)
local ReceiptLedger = require(Shared.Logic.ReceiptLedger)
local CookLogic = require(Shared.Logic.CookLogic)
local CookOff = require(Shared.Logic.CookOff)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Gifting = require(Shared.Logic.Gifting)
local Storefront = require(Shared.Logic.Storefront)

local PurchaseService = {}
local ctx: any = nil
local RECEIPT_MEMORY = 50
local IS_STUDIO = RunService:IsStudio()

local productById: { [number]: string } = {}
local passById: { [number]: string } = {}
local policies: { [Player]: any } = {}
local pendingGifts: { [Player]: { [string]: Gifting.Pending } } = {}
local deliverGift: (Player, any, Player, any, string) -> ()

for key, p in pairs(Monetization.Products) do
	if p.id ~= 0 then
		productById[p.id] = key
	end
end
for key, p in pairs(Monetization.Passes) do
	if p.id ~= 0 then
		passById[p.id] = key
	end
end

local function featuredNow(): { [string]: boolean }
	local week = TimeUtil.weekNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
	local set = {}
	for _, k in ipairs(CookOff.rotation(Config.RotationPool, Config.ROTATION_FEATURED, week)) do
		set[k] = true
	end
	return set
end

-- Which items can be bought here: real ID, or anything while play-testing in Studio.
function PurchaseService.availability(): any
	local out = { products = {}, passes = {}, studio = IS_STUDIO }
	for key, p in pairs(Monetization.Products) do
		out.products[key] = p.id ~= 0 or IS_STUDIO
	end
	for key, p in pairs(Monetization.Passes) do
		out.passes[key] = p.id ~= 0 or IS_STUDIO
	end
	return out
end

-- UserOwnsGamePassAsync has no engine timeout. One hung id used to stall the whole join
-- before a plot was assigned. Each check is capped; a miss just leaves that pass off for now.
local function within(seconds: number, fn: () -> any): (boolean, any)
	local done = false
	local ok = false
	local value: any = nil
	task.spawn(function()
		ok, value = pcall(fn)
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < seconds do
		task.wait(0.05)
	end
	if not done then
		return false, "timeout"
	end
	return ok, value
end

function PurchaseService.loadPasses(player: Player): { [string]: boolean }
	local owned = {}
	for key, p in pairs(Monetization.Passes) do
		if p.id ~= 0 and player.Parent then
			local ok, has = within(5, function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.id)
			end)
			if ok and has == true then
				owned[key] = true
			elseif not ok then
				warn(string.format("[PurchaseService] pass check %s failed: %s", key, tostring(has)))
			end
		end
	end
	-- Studio test grants persist in the save under owned["pass:<key>"] (Studio only).
	local data = ctx.Game.dataOf(player)
	if IS_STUDIO and data then
		for key in pairs(Monetization.Passes) do
			if data.owned["pass:" .. key] then
				owned[key] = true
			end
		end
	end
	if owned.VIPPatio and data then
		data.owned.vip_lights = true
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		policies[player] = ok and info or nil
	end)
	return owned
end

-- Roblox policy for this player (paid random items are never sold here regardless).
function PurchaseService.policy(player: Player): any?
	return policies[player]
end

local function storeCtx(_player: Player, data: any): Storefront.Ctx
	local cooking = false
	for _, cook in pairs(data.stations) do
		if type(cook) == "table" and not CookLogic.isDone(cook) then
			cooking = true
		end
	end
	local active, paid, canSkip = ctx.Season.storeState(data)
	return {
		owned = data.owned,
		featured = featuredNow(),
		events = ctx.Game.activeEvents(),
		onceBought = data.purchases.once,
		cooking = cooking,
		seasonActive = active,
		seasonPaid = paid,
		canSkip = canSkip,
	}
end

local function cosmeticsOwned(data: any, grants: { string }?): boolean
	if not grants or #grants == 0 then
		return false
	end
	for _, id in ipairs(grants) do
		if not data.owned[id] then
			return false
		end
	end
	return true
end

-- Apply a developer product to a player's data. Returns a toast message.
local function grantProduct(player: Player, data: any, key: string): string
	local p = Monetization.Products[key]
	if p.kind == "crewboost" then
		local untilT = if type(data.crew) == "table" and type(data.crew.boostUntil) == "number" then data.crew.boostUntil else 0
		local now = os.time()
		if untilT < now then
			untilT = now
		end
		if type(data.crew) ~= "table" then
			data.crew = { owned = {}, slots = 3, nextUid = 1, extra = 0 }
		end
		data.crew.boostUntil = untilT + (p.minutes or 30) * 60
	elseif p.kind == "boost" then
		ctx.Game.addBoost(data, p.minutes or 30, p.mult or 2)
		-- Fair Play: everyone else in the server gets a free Smoke Shower.
		local now = workspace:GetServerTimeNow()
		for other in pairs(ctx.Game.runtime) do
			local od = other ~= player and ctx.Game.dataOf(other) or nil
			if od and od.boost.untilT <= now then
				ctx.Game.addBoost(od, Config.FairPlay.showerMinutes, Config.FairPlay.showerMult)
				ctx.Game.markDirty(other)
				ctx.Game.toast(other, string.format("💨 Smoke Shower from %s! Everyone gets x%.2g speed for %d min.", player.DisplayName, Config.FairPlay.showerMult, Config.FairPlay.showerMinutes), "good")
			end
		end
	elseif p.kind == "finish" then
		local t = workspace:GetServerTimeNow()
		ctx.Game.advanceAll(player, data, t, false)
		for _, cook in pairs(data.stations) do
			if type(cook) == "table" and not CookLogic.isDone(cook) then
				CookLogic.finishNow(cook, t)
			end
		end
	elseif p.kind == "cut" and p.cut then
		data.cuts[p.cut] = (data.cuts[p.cut] or 0) + (p.count or 1)
	elseif p.kind == "cosmetic" or p.kind == "bundle" or p.kind == "starter" then
		for _, id in ipairs(p.grants or {}) do
			ctx.Game.grantCosmetic(player, data, id)
			local look = Config.Cosmetics[id]
			if look and look.slot == "crew" and type(data.crew) == "table" then
				data.crew.outfit = id
			end
		end
		if (p.kind == "bundle" or p.kind == "starter") and p.minutes then
			ctx.Game.addBoost(data, p.minutes, p.mult or 2)
		end
		if p.kind == "starter" and p.cut then
			data.cuts[p.cut] = (data.cuts[p.cut] or 0) + (p.count or 1)
		end
	elseif p.kind == "season" then
		ctx.Season.grantPaid(player, data)
	elseif p.kind == "tierskip" then
		ctx.Season.grantSkips(player, data, p.count or 1)
	end
	if p.once then
		data.purchases.once[key] = true
	end
	data.purchases.count += 1
	ctx.Insights.shopBought(player, key)
	ctx.Game.markDirty(player)
	return "Thanks! " .. p.icon .. " " .. p.name .. " is yours."
end

local function grantPass(player: Player, key: string)
	local r = ctx.Game.runtime[player]
	if not r then
		return
	end
	r.passes[key] = true
	local data = ctx.Game.dataOf(player)
	if key == "VIPPatio" and data then
		data.owned.vip_lights = true
		data.equipped.patio = "vip_lights"
	end
	if key == "Bunkhouse" and data and type(data.crew) == "table" and data.crew.bunkhouse ~= true then
		data.crew.bunkhouse = true
		local Crew = require(Shared.Logic.Crew)
		data.crew.slots = Crew.slotCount(data.ranch.tier, data.crew.extra, true)
	end
	ctx.Game.toast(player, "Thanks! " .. Monetization.Passes[key].icon .. " " .. Monetization.Passes[key].name .. " is active.", "good")
	ctx.World.refreshStations(player)
	ctx.Cosmetics.apply(player)
	ctx.Game.markDirty(player)
end

function PurchaseService.prompt(player: Player, kind: string, key: string): (boolean, string?)
	local data = ctx.Game.dataOf(player)
	if not data then
		return false, "Still loading..."
	end
	if not Onboard.allowPurchase(data.playSeconds or 0, Onboard.skip(data)) then
		return false, "Have a look around first. The shop is here when you want it."
	end
	if kind == "pass" then
		local p = Monetization.Passes[key]
		if not p then
			return false, "Not found."
		end
		if ctx.Game.hasPass(player, key) then
			return false, "You already have this."
		end
		if p.id == 0 then
			if IS_STUDIO then
				data.owned["pass:" .. key] = true
				grantPass(player, key)
				return true, "Studio test: pass granted for free (only in Studio)."
			end
			return false, "Not on sale yet."
		end
		MarketplaceService:PromptGamePassPurchase(player, p.id)
		return true, nil
	end
	local p = Monetization.Products[key]
	if not p then
		return false, "Not found."
	end
	local ok, why = Storefront.canBuy(key, p, storeCtx(player, data))
	if not ok then
		return false, why
	end
	ctx.Insights.shopPrompt(player, key)
	if p.id == 0 then
		if IS_STUDIO then
			local msg = grantProduct(player, data, key)
			ctx.World.refreshStations(player)
			return true, "Studio test (free): " .. msg
		end
		return false, "Not on sale yet."
	end
	if pendingGifts[player] then
		pendingGifts[player][key] = nil -- buying for yourself is never redirected to an old gift intent
	end
	MarketplaceService:PromptProductPurchase(player, p.id)
	return true, nil
end

-- Hand a looks-only product to another player and celebrate it.
deliverGift = function(giver: Player, giverData: any, recipient: Player, rdata: any, key: string)
	local p = Monetization.Products[key]
	for _, id in ipairs(p.grants or {}) do
		ctx.Game.grantCosmetic(recipient, rdata, id)
	end
	if p.kind == "bundle" and p.minutes then
		ctx.Game.addBoost(rdata, p.minutes, p.mult or 2)
	end
	rdata.stats.giftsGot = (rdata.stats.giftsGot or 0) + 1
	giverData.stats.giftsSent = (giverData.stats.giftsSent or 0) + 1
	local firstTitle = Config.Gifting.firstGiftTitle
	local newTitle = not giverData.titles[firstTitle]
	giverData.titles[firstTitle] = true
	ctx.Game.markDirty(recipient)
	ctx.Game.markDirty(giver)
	ctx.Game.toast(recipient, string.format("🎁 %s gifted you %s %s! It's in your closet.", giver.DisplayName, p.icon, p.name), "good")
	ctx.Game.toast(giver, string.format("🎁 Gift sent! %s now has %s %s.%s", recipient.DisplayName, p.icon, p.name, newTitle and ' You earned the "' .. firstTitle .. '" title.' or ""), "good")
	ctx.Game.fx(recipient, "gift", { from = giver.DisplayName, item = p.name, icon = p.icon })
	ctx.Game.announce(string.format("🎁 %s gifted %s to %s!", giver.DisplayName, p.name, recipient.DisplayName), "#FF8FAB")
	ctx.Cosmetics.apply(recipient)
	ctx.World.refreshStations(recipient)
end

-- Gift a looks-only product to another player in this server.
function PurchaseService.promptGift(player: Player, key: string, recipientUserId: number): (boolean, string?)
	local data = ctx.Game.dataOf(player)
	if not data then
		return false, "Still loading..."
	end
	local p = Monetization.Products[key]
	if not p then
		return false, "Not found."
	end
	if p.rotation and not featuredNow()[key] then
		return false, "That one's not in this week's rotation. It'll be back!"
	end
	local closed = Storefront.eventClosed(p, ctx.Game.activeEvents())
	if closed then
		return false, closed
	end
	local recipient = Players:GetPlayerByUserId(recipientUserId)
	local rdata = recipient and ctx.Game.dataOf(recipient) or nil
	local ok, why = Gifting.check(player.UserId, (recipient and rdata) and recipient.UserId or nil, p, rdata ~= nil and cosmeticsOwned(rdata, p.grants))
	if not ok then
		return false, why
	end
	-- A held gift (recipient left before an earlier gift landed) goes out free.
	if Gifting.takeHeld(data.giftsHeld, key) then
		deliverGift(player, data, recipient :: Player, rdata, key)
		return true, nil
	end
	if p.id == 0 then
		if IS_STUDIO then
			deliverGift(player, data, recipient :: Player, rdata, key)
			return true, "Studio test (free gift)."
		end
		return false, "Not on sale yet."
	end
	pendingGifts[player] = pendingGifts[player] or {}
	Gifting.remember(pendingGifts[player], key, recipientUserId, os.time())
	MarketplaceService:PromptProductPurchase(player, p.id)
	return true, nil
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = ctx.Data.waitFor(player, 10)
	if not profile or not ctx.Game.runtime[player] or profile.released or not player.Parent then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if profile.memoryOnly and not IS_STUDIO then
		-- Saving is down on this live server: nothing we grant would stick. Roblox retries later.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = profile.data
	local purchaseId = tostring(info.PurchaseId)
	if ReceiptLedger.has(data.receipts, purchaseId) then
		-- Already granted in this session. Only confirm once that grant is actually saved
		-- (an earlier save may have failed); never grant it a second time.
		if not ctx.Data.save(profile, false) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productById[info.ProductId]
	if not key then
		warn("[PurchaseService] unknown product id " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Was this purchase a gift for someone else in the server?
	local giftTo = pendingGifts[player] and Gifting.claim(pendingGifts[player], key, os.time(), Config.Gifting.ttlSeconds) or nil
	if giftTo then
		local recipient = Players:GetPlayerByUserId(giftTo)
		local rprofile = recipient and ctx.Data.get(recipient) or nil
		local gok, gerr = pcall(function()
			local present = recipient ~= nil and rprofile ~= nil and not rprofile.released and ctx.Game.runtime[recipient] ~= nil
			local landing = Gifting.landing(present, present and cosmeticsOwned(rprofile.data, Monetization.Products[key].grants))
			if landing == "deliver" then
				deliverGift(player, data, recipient :: Player, rprofile.data, key)
				ctx.Data.save(rprofile, false)
			elseif landing == "hold-owned" then
				Gifting.hold(data.giftsHeld, key)
				ctx.Game.toast(player, "They already got " .. Monetization.Products[key].name .. " while you were checking out, so your gift is saved for you. Open the shop and tap Gift on it to send it to anyone, free.", "info")
			else
				Gifting.hold(data.giftsHeld, key)
				ctx.Game.toast(player, "They left before the gift landed, so it's saved for you. Open the shop and tap Gift on " .. Monetization.Products[key].name .. " to send it to anyone, free.", "info")
			end
		end)
		if not gok then
			warn("[PurchaseService] gift failed: " .. tostring(gerr))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		ReceiptLedger.add(data.receipts, purchaseId, RECEIPT_MEMORY)
		data.purchases.count += 1
		ctx.Insights.shopBought(player, "Gift:" .. key)
		ctx.Game.markDirty(player)
		if not ctx.Data.save(profile, false) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local ok, msg = pcall(grantProduct, player, data, key)
	if not ok then
		warn("[PurchaseService] grant failed: " .. tostring(msg))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	ReceiptLedger.add(data.receipts, purchaseId, RECEIPT_MEMORY)
	-- Only confirm once the grant + receipt id are safely saved.
	if not ctx.Data.save(profile, false) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	ctx.Game.toast(player, msg, "good")
	ctx.World.refreshStations(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function PurchaseService.init(c: any)
	ctx = c
end

-- Studio-only launch check in the Output window: how many shop items still need a Roblox ID.
local function launchCheck()
	local missing, total = 0, 0
	for _, p in pairs(Monetization.Passes) do
		total += 1
		missing += if p.id == 0 then 1 else 0
	end
	for _, p in pairs(Monetization.Products) do
		total += 1
		missing += if p.id == 0 then 1 else 0
	end
	if missing > 0 then
		print(
			string.format(
				"[Launch check] %d of %d shop items still have id = 0, so the live game hides them. One command creates them all: scripts/create-shop.luau (PUBLISHING.md step 6).",
				missing,
				total
			)
		)
	else
		print(string.format("[Launch check] All %d shop items have Roblox IDs.", total))
	end
end

function PurchaseService.start()
	MarketplaceService.ProcessReceipt = processReceipt
	if IS_STUDIO then
		launchCheck()
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local key = passById[passId]
		if purchased and key then
			grantPass(player, key)
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, productId: number, purchased: boolean)
		-- A cancelled gift prompt shouldn't leave a stale intent that hijacks a later self-purchase.
		local key = productById[productId]
		local plr = Players:GetPlayerByUserId(userId)
		if not purchased and key and plr and pendingGifts[plr] then
			pendingGifts[plr][key] = nil
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		policies[p] = nil
		pendingGifts[p] = nil
	end)
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">SeasonService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SeasonService — the Smokehouse Pass on the server (rules live in Shared.Logic.SeasonPass).
	Rewards are looks and titles only. Claims happen automatically: reach a tier and it's yours.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local SeasonPass = require(Shared.Logic.SeasonPass)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Holiday = require(Shared.Logic.Holiday)

local SeasonService = {}
local ctx: any = nil
local CFG = Config.SeasonPass

local function today(): number
	return TimeUtil.dayNumber(os.time(), Config.TIMEZONE_OFFSET_HOURS)
end

function SeasonService.current(): SeasonPass.Info
	return SeasonPass.seasonAt(today(), CFG)
end

-- Bring the save up to date with the current season (call on join, each tick is cheap).
function SeasonService.sync(player: Player, data: any)
	local info = SeasonService.current()
	if not info.def then
		return
	end
	if SeasonPass.sync(data.seasonPass, info.def.id, data.stats, CFG, today()) then
		ctx.Game.markDirty(player)
	end
end

local function rewardName(r: any): string
	if r.cosmetic then
		local def = Config.Cosmetics[r.cosmetic]
		return def and def.name or r.cosmetic
	end
	return '"' .. tostring(r.title) .. '" title'
end

-- Hand out any tiers reached. Quiet and celebratory, never a nag.
function SeasonService.check(player: Player, data: any)
	local info = SeasonService.current()
	if not info.def or data.seasonPass.id ~= info.def.id then
		return
	end
	local before = SeasonPass.tier(SeasonPass.xp(data.seasonPass, data.stats, CFG), info.def, CFG)
	local got = SeasonPass.claim(data.seasonPass, data.stats, info.def, CFG)
	if #got == 0 then
		return
	end
	local names = {}
	for _, g in ipairs(got) do
		if g.reward.cosmetic then
			ctx.Game.grantCosmetic(player, data, g.reward.cosmetic)
		elseif g.reward.title then
			data.titles[g.reward.title] = true
		end
		table.insert(names, rewardName(g.reward))
	end
	ctx.Game.toast(player, string.format("%s Smokehouse Pass tier %d! You got: %s.", info.def.icon, before, table.concat(names, ", ")), "good")
	ctx.Game.fx(player, "season", { tier = before, icon = info.def.icon })
	if ctx.Insights then
		ctx.Insights.seasonTier(player, info.def.id, before)
	end
	ctx.Cosmetics.apply(player)
	ctx.Game.markDirty(player)
end

-- Can the paid track / n skips be bought right now?
function SeasonService.storeState(data: any): (boolean, boolean, (number) -> boolean)
	local info = SeasonService.current()
	local active = info.def ~= nil and data.seasonPass.id == info.def.id
	return active, active and data.seasonPass.paid, function(n: number): boolean
		return active and SeasonPass.canSkip(data.seasonPass, data.stats, info.def, CFG, n)
	end
end

function SeasonService.grantPaid(player: Player, data: any)
	SeasonService.sync(player, data)
	data.seasonPass.paid = true
	SeasonService.check(player, data)
end

function SeasonService.grantSkips(player: Player, data: any, n: number)
	SeasonService.sync(player, data)
	local info = SeasonService.current()
	if not info.def then
		return
	end
	-- never past the top: extra skips are simply not added (the shop blocks this anyway)
	local cur = SeasonPass.tier(SeasonPass.xp(data.seasonPass, data.stats, CFG), info.def, CFG)
	SeasonPass.addSkips(data.seasonPass, math.max(0, math.min(n, SeasonPass.maxTier(info.def) - cur)))
	SeasonService.check(player, data)
end

-- What the client needs to draw the Smokehouse Pass window.
function SeasonService.snapshot(data: any): any
	local info = SeasonService.current()
	if not info.def or data.seasonPass.id ~= info.def.id then
		local nextStart = info.startDay + (info.index < 1 and 0 or CFG.lengthDays)
		return { active = false, nextLabel = Holiday.label(info.index < 1 and CFG.epochDay or nextStart) }
	end
	local xp = SeasonPass.xp(data.seasonPass, data.stats, CFG)
	local into, need = SeasonPass.progress(xp, info.def, CFG)
	return {
		active = true,
		id = info.def.id,
		name = info.def.name,
		icon = info.def.icon,
		number = info.index,
		starts = Holiday.label(info.startDay),
		ends = Holiday.label(info.endDay),
		tier = SeasonPass.tier(xp, info.def, CFG),
		max = SeasonPass.maxTier(info.def),
		xp = xp,
		into = into,
		need = need,
		paid = data.seasonPass.paid,
	}
end

function SeasonService.init(c: any)
	ctx = c
end

return SeasonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">SocialService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SocialService — friendly multiplayer.
	  * Crew bonus: +10% coins for each ranch partner who is here (max 3).
	  * In a family ranch, the other players on the server count toward that same cap.
	  * Plate snagging ("you got taxed!"): grab ONE Common/Juicy plate from another player's
	    pass window. Rules that keep it fun instead of mean:
	      - only while the owner is online and in the game (never offline),
	      - never from someone in Peace Mode (and Peace Mode players can't snag),
	      - new arrivals are shielded for their first 5 minutes,
	      - after a snag the victim's window locks for 3 minutes,
	      - the victim instantly gets 25% of the plate's value back ("insurance"),
	      - the victim can tag the snagger within 15 seconds to get it back plus a bonus,
	      - paid perks never change any of this.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Rarity = require(Shared.Logic.Rarity)
local Economy = require(Shared.Logic.Economy)
local Partners = require(Shared.Logic.Partners)
local WorldBuilder = require(Shared.WorldBuilder)

local SocialService = {}
local ctx: any = nil
local S = Config.Snag

local friendCache: { [string]: boolean } = {}
local running: { [Player]: any } = {} -- snagger -> { victim, plate, untilT, prompt, gui }

local function pairKey(a: number, b: number): string
	if a < b then
		return a .. ":" .. b
	end
	return b .. ":" .. a
end

local function areFriends(a: Player, b: Player): boolean
	local k = pairKey(a.UserId, b.UserId)
	local cached = friendCache[k]
	if cached ~= nil then
		return cached
	end
	local ok, res = pcall(function()
		return a:IsFriendsWithAsync(b.UserId)
	end)
	if not ok then
		-- older engine builds only have the non-Async name
		ok, res = pcall(function()
			return (a :: any):IsFriendsWith(b.UserId)
		end)
	end
	local v = ok and res == true
	friendCache[k] = v
	return v
end

function SocialService.areFriends(a: Player, b: Player): boolean
	return areFriends(a, b)
end

local function recountCrew()
	local online: { [string]: boolean } = {}
	local headcount = 0
	for player in pairs(ctx.Game.runtime) do
		online[tostring(player.UserId)] = true
		headcount += 1
	end
	local familyOn = false
	for player in pairs(ctx.Game.runtime) do
		local data = ctx.Game.dataOf(player)
		if type(data) == "table" and type(data.family) == "table" and data.family.on == true and player.UserId == game.PrivateServerOwnerId then
			familyOn = true
			break
		end
	end
	for player, r in pairs(ctx.Game.runtime) do
		local data = ctx.Game.dataOf(player)
		local list = if type(data) == "table" then Partners.ensure(data) else {}
		local privateServer = game.PrivateServerOwnerId ~= 0
		local others = Partners.familyOthers(privateServer, familyOn, math.max(0, headcount - 1))
		local n = Partners.bonusCount(list, online, others)
		if n ~= r.crew then
			if n > r.crew then
				ctx.Game.toast(player, string.format("Ranch partner bonus: +%d%% with %d partner%s here.", math.floor(n * Config.Partners.per * 100 + 0.5), n, n == 1 and "" or "s"), "good")
			end
			r.crew = n
			ctx.Game.markDirty(player)
		end
	end
end

function SocialService.onJoin(_player: Player)
	task.spawn(recountCrew)
end

function SocialService.onLeave(player: Player)
	local run = running[player]
	if run then
		-- snagger left mid-run: plate goes home
		SocialService.finishRun(player, true)
	end
	for snagger, rr in pairs(running) do
		if rr.victim == player then
			SocialService.finishRun(snagger, false)
		end
	end
	task.defer(recountCrew)
end

function SocialService.refreshBonus()
	recountCrew()
end

local function baseValue(plate: any): number
	-- Paid perks don't count: just price x rarity.
	local meat = Config.Meats[plate.m]
	local rar = Rarity.get(Config.Rarities, plate.r)
	return math.floor(meat.price * rar.mult)
end

local function snaggableIndex(data: any): number?
	local best, bestV = nil, math.huge
	for i, plate in ipairs(data.cooler) do
		local ri = Rarity.indexOf(Config.Rarities, plate.r)
		if ri <= S.maxRarityIndex and plate.m ~= "firstbrisket" then
			local v = baseValue(plate)
			if v < bestV then
				best, bestV = i, v
			end
		end
	end
	return best
end

-- Why can't `victim` be snagged right now? nil = they can.
local function victimBlock(victim: Player): string?
	local data = ctx.Game.dataOf(victim)
	local r = ctx.Game.runtime[victim]
	if not data or not r then
		return "loading"
	end
	if data.settings.peace then
		return "peace"
	end
	if os.clock() - r.sessionStart < S.newPlayerShield then
		return "shield"
	end
	if os.clock() < r.snagLockUntil then
		return "locked"
	end
	if r.resting then
		return "resting"
	end
	if not snaggableIndex(data) then
		return "empty"
	end
	for _, rr in pairs(running) do
		if rr.victim == victim then
			return "locked"
		end
	end
	return nil
end

function SocialService.refreshPassWindow(victim: Player)
	local plot = ctx.World.plotModel(victim)
	if not plot then
		return
	end
	local counter = plot.PassWindow.Counter :: BasePart
	local prompt = counter:FindFirstChild("Prompt") :: ProximityPrompt
	local gui = counter:FindFirstChild("LockGui") :: BillboardGui
	local label = gui:FindFirstChild("Text") :: TextLabel
	local why = victimBlock(victim)
	prompt.Enabled = why == nil
	prompt:SetAttribute("OwnerUserId", victim.UserId) -- the owner's client hides this prompt for themselves
	local r = ctx.Game.runtime[victim]
	if why == "peace" then
		label.Text = "🕊️ Peace Mode"
	elseif why == "shield" and r then
		label.Text = "🛡️ New arrival shield"
	elseif why == "locked" and r then
		local left = math.max(0, math.ceil(r.snagLockUntil - os.clock()))
		label.Text = left > 0 and ("🔒 Locked " .. left .. "s") or "🔒 Locked"
	elseif why == "resting" then
		label.Text = "💤 Resting"
	else
		label.Text = ""
	end
end

local function carryVisual(snagger: Player, plate: any): (ProximityPrompt?, BillboardGui?)
	local char = snagger.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	if not hrp or not head then
		return nil, nil
	end
	local meat = Config.Meats[plate.m]
	local gui = WorldBuilder.billboard(head, "TaxedGui", "🍽️ " .. meat.icon .. " TAXED!", 3, 120, "#FFC83C", 200, 40)
	gui.AlwaysOnTop = true
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "CatchPrompt"
	prompt.ActionText = "Tag back!"
	prompt.ObjectText = snagger.DisplayName .. " has your plate"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = S.catchDistance
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Kind", "catch")
	prompt:SetAttribute("SnaggerUserId", snagger.UserId)
	prompt.Parent = hrp
	return prompt, gui
end

function SocialService.finishRun(snagger: Player, returned: boolean)
	local run = running[snagger]
	if not run then
		return
	end
	running[snagger] = nil
	if run.prompt then
		run.prompt:Destroy()
	end
	if run.gui then
		run.gui:Destroy()
	end
	local victim: Player = run.victim
	local vdata = ctx.Game.dataOf(victim)
	local sdata = ctx.Game.dataOf(snagger)
	if returned then
		if vdata and victim.Parent then
			ctx.Game.addPlate(vdata, run.plate)
			ctx.World.refreshStations(victim)
			ctx.Game.markDirty(victim)
		end
	else
		if sdata and snagger.Parent then
			if not ctx.Game.addPlate(sdata, run.plate) then
				ctx.Game.addCoins(snagger, sdata, baseValue(run.plate), true)
			end
			sdata.stats.snags += 1
			ctx.Game.toast(snagger, "Clean getaway! The plate's in your cooler. 😎", "good")
			ctx.World.refreshStations(snagger)
			ctx.Game.markDirty(snagger)
		end
	end
end

function SocialService.trySnag(snagger: Player, prompt: ProximityPrompt)
	local node: Instance? = prompt.Parent
	while node and not node:GetAttribute("PlotIndex") do
		node = node.Parent
	end
	if not node then
		return
	end
	local victim = ctx.World.ownerOfPlot(node:GetAttribute("PlotIndex") :: number)
	if not victim or victim == snagger then
		return
	end
	local sdata = ctx.Game.dataOf(snagger)
	local sr = ctx.Game.runtime[snagger]
	if not sdata or not sr then
		return
	end
	if sdata.settings.peace then
		ctx.Game.toast(snagger, "You're in Peace Mode, so no snagging. (Turn it off in Settings.)", "info")
		return
	end
	if running[snagger] then
		return
	end
	if os.clock() < sr.snagCooldownUntil then
		ctx.Game.toast(snagger, string.format("Catch your breath! You can snag again in %ds.", math.ceil(sr.snagCooldownUntil - os.clock())), "info")
		return
	end
	if #sdata.cooler >= Config.COOLER_MAX then
		ctx.Game.toast(snagger, "Your cooler's full!", "info")
		return
	end
	if victimBlock(victim) then
		return
	end
	local vdata = ctx.Game.dataOf(victim)
	local vr = ctx.Game.runtime[victim]
	local idx = snaggableIndex(vdata)
	if not idx then
		return
	end
	local plate = table.remove(vdata.cooler, idx)
	sr.snagCooldownUntil = os.clock() + S.cooldown
	vr.snagLockUntil = os.clock() + S.victimLock
	local insurance = math.floor(baseValue(plate) * S.insurance)
	ctx.Game.addCoins(victim, vdata, insurance, true)
	local meat = Config.Meats[plate.m]
	ctx.Game.toast(victim, string.format("%s %s snagged your %s! You got %d coins back. Tag them within %ds to get it back!", Content.Slang.snagged, snagger.DisplayName, meat.name, insurance, S.catchWindow), "warn")
	ctx.Game.toast(snagger, Content.Slang.snagger, "good")
	local cp, gui = carryVisual(snagger, plate)
	if cp then
		cp:SetAttribute("OwnerUserId", victim.UserId) -- only the victim's client shows this prompt
	end
	running[snagger] = { victim = victim, plate = plate, untilT = os.clock() + S.catchWindow, prompt = cp, gui = gui }
	ctx.Remotes.Push:FireClient(victim, "fx", { kind = "snagged", data = { by = snagger.DisplayName, window = S.catchWindow } })
	ctx.World.refreshStations(victim)
	ctx.Game.markDirty(victim)
	ctx.Game.markDirty(snagger)
	task.delay(S.catchWindow, function()
		if running[snagger] and running[snagger].plate == plate then
			SocialService.finishRun(snagger, false)
		end
	end)
end

function SocialService.tryCatch(victim: Player, prompt: ProximityPrompt)
	local snaggerId = prompt:GetAttribute("SnaggerUserId")
	local snagger = typeof(snaggerId) == "number" and Players:GetPlayerByUserId(snaggerId) or nil
	if not snagger then
		return
	end
	local run = running[snagger]
	if not run or run.victim ~= victim or os.clock() > run.untilT then
		return
	end
	-- distance double-check on the server
	local a = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local b = snagger.Character and snagger.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not a or not b or (a.Position - b.Position).Magnitude > S.catchDistance + 4 then
		return
	end
	SocialService.finishRun(snagger, true)
	local vdata = ctx.Game.dataOf(victim)
	if vdata then
		local bonus = math.floor(S.catchBonus * Economy.rankMult(vdata.rank, Config.RANK_STEP))
		ctx.Game.addCoins(victim, vdata, bonus, true)
		ctx.Game.toast(victim, string.format("Caught 'em! Plate's back, +%d bonus. 💪", bonus), "good")
	end
	ctx.Game.toast(snagger, "Caught! " .. Content.Slang.crine, "bad")
end

function SocialService.init(c: any)
	ctx = c
end

function SocialService.start()
	task.spawn(function()
		while true do
			task.wait(1)
			for player in pairs(ctx.Game.runtime) do
				SocialService.refreshPassWindow(player)
			end
		end
	end)
end

return SocialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">WeatherService</string>
            <string name="Source"><![CDATA[--!strict
-- Runs the Smoke Storm clock and rolls traits. Rolls are free. Nothing here reads a purchase.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weather = require(Shared.Logic.Weather)
local Index = require(Shared.Logic.Index)
local Crew = require(Shared.Logic.Crew)
local TimeUtil = require(Shared.Logic.TimeUtil)
local WorldBuilder = require(Shared.WorldBuilder)

local WeatherService = {}
local ctx: any = nil
local seed = 1
local rolled: { [string]: boolean } = {}
local stormIndex = -1

function WeatherService.state(): any
	local now = os.time()
	local show = Weather.smokeShow(now, TimeUtil.centralOffset(now))
	local storm = Weather.stormAt(seed, now)
	local active = storm.active or show
	return {
		active = active,
		show = show,
		banner = if active then Weather.banner(show) else "",
		odds = Weather.shownOdds(show),
		nextAt = TimeUtil.clock(if storm.active then storm.finish else storm.start, TimeUtil.centralOffset(now)),
	}
end

function WeatherService.init(c: any)
	ctx = c
end

local function shoutTrait(player: Player, member: any, traitId: string)
	if traitId ~= "golden" and traitId ~= "meteorite" then
		return
	end
	local trait = Crew.traitDef(traitId)
	ctx.Game.announce(string.format("%s's %s caught %s!", player.DisplayName, member.name, trait.name), "#FFC83C")
end

local function rollPlayer(player: Player, stormKey: string, show: boolean, week: number)
	local data = ctx.Game.dataOf(player)
	if type(data) ~= "table" or type(data.crew) ~= "table" or type(data.crew.owned) ~= "table" then
		return
	end
	local slots = data.crew.slots or 0
	local changed = false
	for i, member in ipairs(data.crew.owned) do
		if i > slots then
			break
		end
		local key = stormKey .. ":" .. tostring(player.UserId) .. ":" .. tostring(member.uid)
		-- `rolled` only lives in this server. The saved marks stop a server hop from re-rolling:
		-- one roll per Saturday show, and one per storm gap otherwise.
		local now = os.time()
		local fresh = if show
			then member.showWeek ~= week
			else type(member.stormAt) ~= "number" or now - member.stormAt >= Config.Storm.gapMin or now < member.stormAt
		if not rolled[key] and fresh then
			rolled[key] = true
			member.stormAt = now
			if show then
				member.showWeek = week
			end
			changed = true
			local rolledTrait = Weather.roll(Random.new():NextNumber(), show)
			local nextTrait = Weather.upgrade(member.trait, rolledTrait)
			if nextTrait ~= member.trait then
				member.trait = nextTrait
				changed = true
				local note = Index.note(data, member.species, nextTrait)
				shoutTrait(player, member, nextTrait)
				if note.rowDone then
					ctx.Game.toast(player, member.name .. " completed a Crew Index row. +2% crew income.", "good")
				end
				if note.title then
					ctx.Game.toast(player, "Title earned: " .. note.title, "good")
				end
			end
		end
	end
	if changed then
		ctx.Game.markDirty(player)
	end
end

local function grantShow(player: Player, week: number)
	local data = ctx.Game.dataOf(player)
	if type(data) ~= "table" then
		return
	end
	if type(data.events) ~= "table" then
		data.events = { smokeShowWeek = -1 }
	end
	if data.events.smokeShowWeek == week then
		return
	end
	data.events.smokeShowWeek = week
	local species = Crew.byId("hummingbird")
	if not species then
		return
	end
	Crew.ensure(data)
	local merge = Crew.findSpecies(data.crew.owned, species.id)
	if merge then
		merge.level = math.min(Config.Hiring.maxLevel, (merge.level or 1) + 1)
		ctx.Game.toast(player, "Saturday Smoke Show: " .. merge.name .. " learned a little more.", "good")
	elseif #data.crew.owned < (data.crew.slots or 0) then
		local member = {
			uid = data.crew.nextUid,
			species = species.id,
			name = species.name,
			level = 1,
			trait = "none",
			badge = nil,
			role = species.role,
		}
		table.insert(data.crew.owned, member)
		data.crew.nextUid = member.uid + 1
		ctx.Game.toast(player, "Saturday Smoke Show: " .. species.name .. " joined your ranch.", "good")
	else
		ctx.Game.toast(player, "Saturday Smoke Show is on, and the ranch is full, so Zip sat this one out.", "info")
	end
	ctx.Game.markDirty(player)
end

function WeatherService.start()
	seed = Random.new():NextInteger(1, 2000000000)
	task.spawn(function()
		while true do
			local now = os.time()
			local storm = Weather.stormAt(seed, now)
			local show = Weather.smokeShow(now, TimeUtil.centralOffset(now))
			if storm.index ~= stormIndex then
				stormIndex = storm.index
				table.clear(rolled)
			end
			pcall(function()
				WorldBuilder.lighting(game:GetService("Lighting"), storm.active or show)
			end)
			if storm.active or show then
				local week = TimeUtil.weekNumber(now, TimeUtil.centralOffset(now))
				local key = if show then "show:" .. tostring(week) else "storm:" .. tostring(storm.index)
				for _, player in ipairs(Players:GetPlayers()) do
					local ok, err = pcall(rollPlayer, player, key, show, week)
					if not ok then
						warn("[Weather] " .. tostring(err))
					end
				end
			end
			if show then
				local week = TimeUtil.weekNumber(now, TimeUtil.centralOffset(now))
				for _, player in ipairs(Players:GetPlayers()) do
					local ok, err = pcall(grantShow, player, week)
					if not ok then
						warn("[Weather] " .. tostring(err))
					end
				end
			end
			task.wait(1)
		end
	end)
end

return WeatherService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
-- WorldService — the physical ranch: plots, smokers, meat visuals, critter customers, smoke signals.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local WorldBuilder = require(Shared.WorldBuilder)
local CookLogic = require(Shared.Logic.CookLogic)
local Staff = require(Shared.Logic.Staff)
local Rarity = require(Shared.Logic.Rarity)

local WorldService = {}
local ctx: any = nil

local ENV = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}
WorldService.ENV = ENV

local plotOwner: { [number]: Player } = {}
local playerPlot: { [Player]: number } = {}
local customerModels: { [Player]: { [number]: Model } } = {}
local map: any = nil

type Waiter = {
	model: Model,
	points: { Vector3 },
	index: number,
	from: Vector3,
	to: Vector3,
	dist: number,
	walked: number,
}
local waiters: { [Player]: Waiter } = {}

type CrewMate = {
	model: Model,
	id: string,
	points: { Vector3 },
	index: number,
	from: Vector3,
	to: Vector3,
	dist: number,
	walked: number,
	line: number,
	nextLine: number,
}
local crews: { [Player]: { CrewMate } } = {}
local crewSig: { [Player]: string } = {}

local function waiterDef(): any
	for _, c in ipairs(Config.Critters) do
		if c.id == "jimothy" then
			local copy: any = table.clone(c)
			copy.waiter = true
			copy.scale = 1
			return copy
		end
	end
	return nil
end

local function clearWaiter(player: Player)
	local w = waiters[player]
	if w and w.model then
		w.model:Destroy()
	end
	waiters[player] = nil
end

local function syncWaiter(player: Player)
	local plot = WorldService.plotModel(player)
	local data = ctx.Game.dataOf(player)
	if not plot or not data then
		return
	end
	if not ctx.Game.hasPass(player, "AutoServe") then
		clearWaiter(player)
		local old = plot:FindFirstChild("JimothyWaiter")
		if old then
			old:Destroy()
		end
		return
	end
	local existing = waiters[player]
	if existing and existing.model.Parent then
		return
	end
	local def = waiterDef()
	local pad = plot:FindFirstChild("Pad") :: BasePart?
	local top = plot.Grill:FindFirstChild("Top") :: BasePart?
	if not def or not pad or not top then
		return
	end
	local groundY = pad.Position.Y + pad.Size.Y / 2
	local function standAt(pos: Vector3, side: Vector3): Vector3
		return Vector3.new(pos.X, groundY, pos.Z) + side
	end
	local points: { Vector3 } = {}
	local firstSeat = plot.Tables:FindFirstChild("t1")
	local seatPart = firstSeat and firstSeat:FindFirstChild("Seat") :: BasePart?
	local toward = if seatPart then seatPart.Position - top.Position else Vector3.new(0, 0, -1)
	local flat = Vector3.new(toward.X, 0, toward.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	local dir = flat.Unit
	local side = Vector3.new(dir.Z, 0, -dir.X)
	table.insert(points, standAt(top.Position, dir * 5))
	for i = 1, Config.CUSTOMER_SPOTS do
		local tbl = plot.Tables:FindFirstChild("t" .. i)
		local seat = tbl and tbl:FindFirstChild("Seat") :: BasePart?
		if seat then
			table.insert(points, standAt(seat.Position, side * 2.2))
		end
	end
	if #points < 2 then
		return
	end
	local m = WorldBuilder.critter(ENV, plot, def, CFrame.new())
	m.Name = "JimothyWaiter"
	for _, c in ipairs(m:GetDescendants()) do
		if c:IsA("BasePart") then
			c.CanCollide = false
			c.CanQuery = false
			c.CanTouch = false
		end
	end
	local lift = m:GetPivot().Position.Y
	for i, p in ipairs(points) do
		points[i] = p + Vector3.new(0, lift, 0)
	end
	m:PivotTo(CFrame.lookAt(points[1], points[2]))
	waiters[player] = {
		model = m,
		points = points,
		index = 2,
		from = points[1],
		to = points[2],
		dist = (points[2] - points[1]).Magnitude,
		walked = 0,
	}
end

local function clearCrew(player: Player, plot: Instance?)
	local list = crews[player]
	if list then
		for _, c in ipairs(list) do
			if c.model then
				c.model:Destroy()
			end
		end
	end
	crews[player] = nil
	crewSig[player] = nil
	if plot then
		local old = plot:FindFirstChild("Crew")
		if old then
			old:Destroy()
		end
	end
end

local function crewPoints(plot: Instance): { Vector3 }?
	local pad = plot:FindFirstChild("Pad") :: BasePart?
	local top = plot:FindFirstChild("Grill") and (plot :: any).Grill:FindFirstChild("Top") :: BasePart?
	if not pad or not top then
		return nil
	end
	local groundY = pad.Position.Y + pad.Size.Y / 2
	local points: { Vector3 } = {}
	local function standAt(pos: Vector3, side: Vector3)
		table.insert(points, Vector3.new(pos.X, groundY, pos.Z) + side)
	end
	local firstSeat = (plot :: any).Tables:FindFirstChild("t1")
	local seatPart = firstSeat and firstSeat:FindFirstChild("Seat") :: BasePart?
	local toward = if seatPart then seatPart.Position - top.Position else Vector3.new(0, 0, -1)
	local flat = Vector3.new(toward.X, 0, toward.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	local dir = flat.Unit
	local side = Vector3.new(-dir.Z, 0, dir.X)
	standAt(top.Position, side * 3.2)
	local smokers = (plot :: any).Smokers
	if smokers then
		for _, child in ipairs(smokers:GetChildren()) do
			local barrel = child:FindFirstChild("Barrel")
			if barrel and barrel:IsA("BasePart") then
				standAt(barrel.Position, side * 3.4)
			end
		end
	end
	local counter = (plot :: any).PassWindow and (plot :: any).PassWindow:FindFirstChild("Counter")
	if counter and counter:IsA("BasePart") then
		standAt(counter.Position, dir * 4)
	end
	local tables = (plot :: any).Tables
	if tables then
		for i = 1, Config.CUSTOMER_SPOTS do
			local tbl = tables:FindFirstChild("t" .. i)
			local seat = tbl and tbl:FindFirstChild("Seat") :: BasePart?
			if seat then
				standAt(seat.Position, side * -2.4)
			end
		end
	end
	if #points < 2 then
		return nil
	end
	return points
end

local function syncStaff(player: Player)
	local plot = WorldService.plotModel(player)
	local data = ctx.Game.dataOf(player)
	if not plot or not data or type(data.staff) ~= "table" then
		return
	end
	if not Config.Chores.legacyStaff then
		if crewSig[player] ~= "" then
			clearCrew(player, plot)
			crewSig[player] = ""
		end
		return
	end
	local slots = Staff.slots(data.pitLevel or 1)
	local sig = Staff.signature(data.staff.roster or {}, slots)
	local existing = crews[player]
	if crewSig[player] == sig and existing and existing[1] and existing[1].model.Parent then
		return
	end
	if sig == "" then
		clearCrew(player, plot)
		return
	end
	clearCrew(player, plot)
	local points = crewPoints(plot)
	if not points then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "Crew"
	folder.Parent = plot
	local list: { CrewMate } = {}
	local n = 0
	for i, entry in ipairs(data.staff.roster) do
		if i > slots then
			break
		end
		local def = Staff.appearance(entry, Config.Critters)
		if def then
			n += 1
			local m = WorldBuilder.critter(ENV, folder, def, CFrame.new())
			m.Name = "Staff_" .. entry.id
			m:SetAttribute("StaffId", entry.id)
			for _, c in ipairs(m:GetDescendants()) do
				if c:IsA("BasePart") then
					c.CanCollide = false
					c.CanQuery = false
					c.CanTouch = false
				end
			end
			local head = m:FindFirstChild("Head")
			if head and head:IsA("BasePart") then
				WorldBuilder.billboard(head, "NameTag", entry.name, 2.2, 70, "#FFF6E0", 160, 28, { 4, 0.7, 70, 14 })
				local bubble = WorldBuilder.billboard(head, "Chatter", Staff.line(entry.id, 1), 3.3, 36, "#1A2744", 220, 36, { 5, 0.9, 90, 16 })
				local label = bubble:FindFirstChild("Text")
				if label and label:IsA("TextLabel") then
					label.TextColor3 = Color3.fromHex("#1A2744")
					label.BackgroundColor3 = Color3.fromHex("#FFF8EE")
					label.BackgroundTransparency = 0.05
				end
			end
			local lift = m:GetPivot().Position.Y
			local lifted = table.clone(points)
			for pi, p in ipairs(lifted) do
				lifted[pi] = p + Vector3.new((n - 1) * 1.4, lift, 0)
			end
			local start = ((n - 1) % #lifted) + 1
			local nxt = start % #lifted + 1
			m:PivotTo(CFrame.lookAt(lifted[start], lifted[nxt]))
			table.insert(list, {
				model = m,
				id = entry.id,
				points = lifted,
				index = nxt,
				from = lifted[start],
				to = lifted[nxt],
				dist = (lifted[nxt] - lifted[start]).Magnitude,
				walked = 0,
				line = 1,
				nextLine = os.clock() + 3 + n,
			})
		end
	end
	crews[player] = list
	crewSig[player] = sig
end

function WorldService.map(): any
	return map
end

function WorldService.plotModel(player: Player): any
	local i = playerPlot[player]
	if not i then
		return nil
	end
	return map.Plots:FindFirstChild("Plot" .. i) :: Model?
end

function WorldService.ownerOfPlot(i: number): Player?
	return plotOwner[i]
end

function WorldService.plotIndexOf(player: Player): number?
	return playerPlot[player]
end

local function setOwnerSign(i: number, player: Player?)
	local plots = map and map:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. i)
	if not plot then
		return
	end
	local text = player and (player.DisplayName .. "'s Ranch") or "Open Ranch"
	local sign = plot:FindFirstChild("Sign")
	local board = sign and sign:FindFirstChild("Board")
	if board then
		for _, d in ipairs(board:GetDescendants()) do
			if d.Name == "OwnerText" and d:IsA("TextLabel") then
				d.Text = text
			end
		end
	end
	plot:SetAttribute("OwnerUserId", player and player.UserId or 0)
end

local function teleportHome(player: Player)
	local plot = WorldService.plotModel(player)
	local char = player.Character
	if not plot or not char then
		return
	end
	local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pad = plot:FindFirstChild("SpawnPad") :: BasePart?
	if hrp and pad then
		char:PivotTo(pad.CFrame + Vector3.new(0, 4, 0))
	end
end
WorldService.teleportHome = teleportHome

function WorldService.assignPlot(player: Player): number?
	for i = 1, Config.MAX_PLOTS do
		if not plotOwner[i] then
			plotOwner[i] = player
			playerPlot[player] = i
			customerModels[player] = {}
			setOwnerSign(i, player)
			player:SetAttribute("Plot", i)
			player.CharacterAdded:Connect(function()
				task.wait(0.2)
				teleportHome(player)
				ctx.Cosmetics.apply(player)
			end)
			if player.Character then
				task.defer(teleportHome, player)
			end
			return i
		end
	end
	return nil
end

function WorldService.releasePlot(player: Player)
	clearWaiter(player)
	local i = playerPlot[player]
	if not i then
		return
	end
	for _, m in pairs(customerModels[player] or {}) do
		m:Destroy()
	end
	customerModels[player] = nil
	plotOwner[i] = nil
	playerPlot[player] = nil
	setOwnerSign(i, nil)
	-- clear visuals
	local plot = map.Plots:FindFirstChild("Plot" .. i)
	if plot then
		for _, s in ipairs(plot.Smokers:GetChildren()) do
			local spot = s:FindFirstChild("MeatSpot")
			if spot then
				spot:ClearAllChildren()
			end
			s.Chimney.Smoke.Enabled = false
			s.Barrel.SlotGui.Text.Text = ""
		end
		for _, g in ipairs(plot.Grill:GetChildren()) do
			if g:GetAttribute("Slot") then
				for _, c in ipairs(g:GetChildren()) do
					if c.Name == "Meat" then
						c:Destroy()
					end
				end
				g.SlotGui.Text.Text = ""
			end
		end
		plot.PassWindow.Plates:ClearAllChildren()
		plot.PassWindow.Counter.Prompt.Enabled = false
		for _, b in ipairs(plot.VIPLights:GetChildren()) do
			if b:IsA("BasePart") then
				b.Transparency = 1
			end
		end
	end
end

local function colorOf(h: string): Color3
	return Color3.fromHex(h)
end
local LOCKED_COLOR = Color3.fromHex("#1C1A1F")

-- Repaint smokers & meat for one player's plot.
function WorldService.refreshStations(player: Player)
	local plot = WorldService.plotModel(player)
	local data = ctx.Game.dataOf(player)
	if not plot or not data then
		return
	end
	local t = workspace:GetServerTimeNow()
	local smokerCount = ctx.Game.slotCount(player, data, "smoker")
	local grillCount = ctx.Game.slotCount(player, data, "grill")
	local pitDef = Config.PitLevels[data.pitLevel]
	local skinId = data.equipped.skin
	local skin = skinId and Config.Cosmetics[skinId] or nil
	local smokeId = data.equipped.smoke
	local smokeDef = smokeId and Config.Cosmetics[smokeId] or nil
	local bodyColor = skin and colorOf(skin.color) or colorOf(pitDef.color)
	local material = (skin and skin.neon) and Enum.Material.Neon or ((skin and skin.gold) and Enum.Material.Foil or Enum.Material.Metal)

	for i = 1, #WorldBuilder.SMOKER_X do
		local key = "s" .. i
		local s = plot.Smokers:FindFirstChild(key) :: Model?
		if s then
			local unlocked = i <= smokerCount
			local barrel = s:FindFirstChild("Barrel") :: BasePart
			local spot = s:FindFirstChild("MeatSpot") :: BasePart
			local chimney = s:FindFirstChild("Chimney") :: BasePart
			local smoke = chimney:FindFirstChild("Smoke") :: Smoke
			local label = (barrel:FindFirstChild("SlotGui") :: BillboardGui):FindFirstChild("Text") :: TextLabel
			-- Locked smokers read as a dark silhouette with a padlock sign (no see-through ghosts).
			for _, p in ipairs(s:GetChildren()) do
				if p:IsA("BasePart") and p.Name ~= "MeatSpot" and p.Name ~= "LockSign" then
					p.Transparency = 0
					local base = p:GetAttribute("BaseColor")
					p.Color = unlocked and (typeof(base) == "string" and colorOf(base) or p.Color) or LOCKED_COLOR
				end
			end
			local lockSign = s:FindFirstChild("LockSign") :: BasePart?
			if lockSign then
				lockSign.Transparency = unlocked and 1 or 0
				for _, lg in ipairs(lockSign:GetChildren()) do
					if lg:IsA("SurfaceGui") then
						lg.Enabled = not unlocked
					end
				end
			end
			barrel.Color = unlocked and bodyColor or LOCKED_COLOR
			barrel.Material = unlocked and material or Enum.Material.SmoothPlastic
			spot:ClearAllChildren()
			local cook = data.stations[key]
			if unlocked and type(cook) == "table" then
				local meat = Config.Meats[cook.meat]
				local done = CookLogic.isDone(cook)
				local rar = done and Rarity.get(Config.Rarities, cook.rarity) or nil
				WorldBuilder.meat(ENV, spot, meat, rar, spot.CFrame, CookLogic.fraction(cook))
				smoke.Enabled = not done
				smoke.Color = smokeDef and colorOf(smokeDef.color) or Color3.fromRGB(221, 221, 221)
				label.Text = meat.icon .. " " .. meat.name .. (done and " ✅" or "")
			else
				smoke.Enabled = false
				label.Text = unlocked and "Empty smoker" or "🔒 Locked"
			end
			s:SetAttribute("Unlocked", unlocked)
		end
	end

	local grill = plot.Grill
	local anyGrill = false
	for i = 1, #WorldBuilder.GRILL_X do
		local key = "g" .. i
		local g = grill:FindFirstChild(key) :: BasePart?
		if g then
			local unlocked = i <= grillCount
			g.Transparency = 0
			g.Color = unlocked and colorOf("#333333") or LOCKED_COLOR
			for _, c in ipairs(g:GetChildren()) do
				if c.Name == "Meat" then
					c:Destroy()
				end
			end
			local cook = data.stations[key]
			local label = (g:FindFirstChild("SlotGui") :: BillboardGui):FindFirstChild("Text") :: TextLabel
			if unlocked and type(cook) == "table" then
				anyGrill = true
				local meat = Config.Meats[cook.meat]
				local mp = WorldBuilder.meat(ENV, g, meat, nil, g.CFrame * CFrame.new(0, 0.1, 0), CookLogic.fraction(cook), cook.burnt == true)
				if cook.burnt then
					-- the body itself goes black; the face is already the sad one
					mp.Color = Color3.fromRGB(20, 20, 20)
				end
				label.Text = meat.icon .. (cook.burnt and " burnt" or (CookLogic.isDone(cook) and " ✅" or ""))
			else
				label.Text = unlocked and "" or "🔒"
			end
		end
	end
	local gs = (grill:FindFirstChild("Top") :: BasePart):FindFirstChild("Smoke") :: Smoke
	gs.Enabled = anyGrill

	-- pass window plates (shows up to 4)
	local plates = plot.PassWindow.Plates
	plates:ClearAllChildren()
	local counter = plot.PassWindow.Counter :: BasePart
	for pi = 1, math.min(4, #data.cooler) do
		local plate = Instance.new("Part")
		plate.Name = "Plate"
		plate.Shape = Enum.PartType.Cylinder
		plate.Size = Vector3.new(0.2, 1.6, 1.6)
		plate.Anchored = true
		plate.CanCollide = false
		plate.Color = Color3.fromRGB(245, 245, 245)
		plate.CFrame = counter.CFrame * CFrame.new(-3 + (pi - 1) * 2, 1.95, 0) * CFrame.Angles(0, 0, math.pi / 2)
		plate.Parent = plates
		local meat = Config.Meats[data.cooler[pi].m]
		if meat then
			-- 0.45 is applied inside meat() so a cute face shrinks with the plate
			WorldBuilder.meat(ENV, plates, meat, nil, counter.CFrame * CFrame.new(-3 + (pi - 1) * 2, 2.05, 0), 1, false, 0.45)
		end
	end

	-- VIP Patio
	local vip = ctx.Game.hasPass(player, "VIPPatio") or data.equipped.patio == "vip_lights"
	for _, b in ipairs(plot.VIPLights:GetChildren()) do
		if b:IsA("BasePart") then
			b.Transparency = vip and 0 or 1
			local sg = b:FindFirstChild("SignGui")
			if sg then
				(sg :: any).Text.TextTransparency = vip and 0 or 1
			end
		end
	end
	ctx.Social.refreshPassWindow(player)
	syncWaiter(player)
	syncStaff(player)
	local _ = t
end

-- ===== critter customers =====
local function moveModel(m: Model, from: CFrame, to: CFrame, seconds: number)
	task.spawn(function()
		local t0 = os.clock()
		while m.Parent and os.clock() - t0 < seconds do
			local a = (os.clock() - t0) / seconds
			local cf = from:Lerp(to, a)
			m:PivotTo(cf * CFrame.new(0, math.abs(math.sin(a * math.pi * 6)) * 0.4, 0))
			RunService.Heartbeat:Wait()
		end
		if m.Parent then
			m:PivotTo(to)
		end
	end)
end

function WorldService.spawnCustomer(player: Player, customer: any, critter: any)
	local plot = WorldService.plotModel(player)
	if not plot then
		return
	end
	local tbl = plot.Tables:FindFirstChild("t" .. customer.spot)
	if not tbl then
		return
	end
	local seat = tbl.Seat :: BasePart
	local entrance = (plot.SpawnPad :: BasePart).CFrame * CFrame.new(0, -1, -14)
	local folder = plot:FindFirstChild("Customers") or Instance.new("Folder")
	folder.Name = "Customers"
	folder.Parent = plot
	local m, head, body = WorldBuilder.critter(ENV, folder, critter, CFrame.new())
	m.Name = "Customer" .. customer.id
	m:SetAttribute("CustomerId", customer.id)
	m:SetAttribute("OwnerUserId", player.UserId)
	local seatCf = CFrame.lookAt(seat.Position, seat.Position + (seat.CFrame.LookVector)) * CFrame.Angles(0, math.pi, 0)
	m:PivotTo(entrance)
	moveModel(m, entrance, seatCf, 2.2)

	local orderText
	if customer.order == "any" then
		orderText = critter.name .. ": Anything's fine!"
	else
		local meat = Config.Meats[customer.order]
		orderText = critter.name .. ": " .. meat.icon .. " " .. meat.name .. " please!"
	end
	WorldBuilder.billboard(head, "Order", orderText, 2.4, 70, "#FFFFFF", 260, 34, { 10, 1.5 })
	local serve = WorldBuilder.prompt(body, "serve", "Serve", critter.name, 0, 10)
	serve:SetAttribute("CustomerId", customer.id)
	serve:SetAttribute("OwnerUserId", player.UserId)
	if critter.bellyRub then
		local rub = WorldBuilder.prompt(head, "bellyrub", "Rub belly", "Belly Rub Pup", 0.6, 8)
		rub:SetAttribute("CustomerId", customer.id)
		rub:SetAttribute("OwnerUserId", player.UserId)
		rub.UIOffset = Vector2.new(0, 60)
	end
	if customer.muddy then
		for k = 1, 4 do
			local spotPart = Instance.new("Part")
			spotPart.Name = "Mud"
			spotPart.Anchored = true
			spotPart.CanCollide = false
			spotPart.Size = Vector3.new(0.6, 0.15, 0.6)
			spotPart.Color = Color3.fromRGB(92, 64, 40)
			spotPart.CFrame = body.CFrame * CFrame.new(-0.5 + (k % 2), 0.72, -0.8 + k * 0.4)
			spotPart.Parent = m
		end
		local wash = WorldBuilder.prompt(head, "wash", "Wash the pup", "Suds Saturday", 1, 8)
		wash:SetAttribute("CustomerId", customer.id)
		wash:SetAttribute("OwnerUserId", player.UserId)
		wash.UIOffset = Vector2.new(0, 120)
	end
	-- re-anchor parts after pivot (WorldBuilder parts are anchored already)
	customerModels[player][customer.id] = m
end

function WorldService.removeCustomer(player: Player, customer: any)
	local list = customerModels[player]
	local m = list and list[customer.id]
	if m then
		list[customer.id] = nil
		local plot = WorldService.plotModel(player)
		if plot then
			local from = m:GetPivot()
			local to = (plot.SpawnPad :: BasePart).CFrame * CFrame.new(0, -1, -16)
			moveModel(m, from, to, 1.6)
			task.delay(1.7, function()
				m:Destroy()
			end)
		else
			m:Destroy()
		end
	end
end

function WorldService.findCustomer(player: Player, id: number): any?
	local r = ctx.Game.runtime[player]
	if not r then
		return nil
	end
	for _, c in ipairs(r.customers) do
		if c.id == id then
			return c
		end
	end
	return nil
end

function WorldService.smokeSignal(player: Player, text: string, color: string)
	local plot = WorldService.plotModel(player)
	if not plot then
		return
	end
	local sig = plot.SmokeSignal :: BasePart
	local smoke = sig:FindFirstChild("Signal") :: Smoke
	local gui = sig:FindFirstChild("SignalGui") :: BillboardGui
	local data = ctx.Game.dataOf(player)
	local smokeDef = data and data.equipped.smoke and Config.Cosmetics[data.equipped.smoke]
	smoke.Color = smokeDef and colorOf(smokeDef.color) or colorOf(color)
	smoke.Enabled = true
	gui.Enabled = true
	local label = gui:FindFirstChild("Text") :: TextLabel
	-- Display names are already moderated by Roblox; everything else here is fixed game text.
	label.Text = "💨 " .. player.DisplayName .. ": " .. string.upper(text) .. "!"
	label.TextColor3 = colorOf(color)
	task.delay(10, function()
		if sig.Parent then
			smoke.Enabled = false
			gui.Enabled = false
		end
	end)
end

function WorldService.effect(player: Player, kind: string, payload: any)
	local plot = WorldService.plotModel(player)
	if not plot then
		return
	end
	if kind == "smell" then
		local top = plot.Grill.Top :: BasePart
		local puff = Instance.new("Smoke")
		puff.Color = Color3.fromRGB(40, 40, 40)
		puff.Size = 6
		puff.Opacity = 0.5
		puff.RiseVelocity = 6
		puff.Parent = top
		task.delay(4, function()
			puff:Destroy()
		end)
		-- every critter does the scuba wave
		for _, m in pairs(customerModels[player] or {}) do
			local head = m:FindFirstChild("Head")
			if head then
				local b = WorldBuilder.billboard(head, "Scuba", "🤿👋", 4.5, 60, "#FFFFFF", 80, 40)
				task.delay(3, function()
					b:Destroy()
				end)
			end
		end
	elseif kind == "bellyrub" or kind == "wash" or kind == "clap" then
		local m = customerModels[player] and customerModels[player][payload.id]
		if not m then
			return
		end
		local head = m:FindFirstChild("Head")
		if kind == "bellyrub" then
			local base = m:GetPivot()
			m:PivotTo(base * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.pi))
			task.delay(2, function()
				if m.Parent then
					m:PivotTo(base)
				end
			end)
		elseif kind == "wash" then
			for _, c in ipairs(m:GetChildren()) do
				if c.Name == "Mud" then
					c:Destroy()
				end
			end
			local body = m:FindFirstChild("Body")
			if body then
				local sp = Instance.new("Sparkles")
				sp.SparkleColor = Color3.fromRGB(180, 230, 255)
				sp.Parent = body
				task.delay(3, function()
					sp:Destroy()
				end)
			end
		end
		if head then
			local text = kind == "bellyrub" and "♥ ♥ ♥" or (kind == "wash" and "✨ squeaky clean ✨" or "👏👏👏")
			local b = WorldBuilder.billboard(head, "Fx", text, 5, 60, "#FF8FB1", 200, 40)
			task.delay(2.5, function()
				b:Destroy()
			end)
		end
	end
end

-- Slowly darken meat as it cooks (cheap: every 5 seconds).
local function doneLoop()
	while true do
		task.wait(5)
		for player in pairs(playerPlot) do
			WorldService.refreshStations(player)
		end
	end
end

function WorldService.init(c: any)
	ctx = c
	WorldBuilder.setEnv(ENV)
	local existing = workspace:FindFirstChild("Map")
	if existing then
		map = existing :: Model
		-- Places baked before the porch board still get it, without rebuilding the map.
		local hub = map:FindFirstChild("Hub")
		if hub then
			WorldBuilder.yardBoard(hub, Content)
		end
	else
		map = WorldBuilder.build(ENV, workspace, Config, Content)
	end
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
end

function WorldService.start()
	pcall(function()
		WorldBuilder.lighting(game:GetService("Lighting"), false)
	end)
	task.spawn(doneLoop)
	-- Jimothy the Waiter: a fast waddle between the grill and the tables while AutoServe is owned.
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(function()
			for _, w in pairs(waiters) do
				if not w.model.Parent then
					continue
				end
				local speed = 9
				w.walked += speed * dt
				local span = math.max(w.dist, 0.05)
				local a = math.clamp(w.walked / span, 0, 1)
				local pos = w.from:Lerp(w.to, a)
				local bob = math.abs(math.sin(os.clock() * 14)) * 0.32
				local flat = Vector3.new(w.to.X - w.from.X, 0, w.to.Z - w.from.Z)
				local face = if flat.Magnitude > 0.05 then flat.Unit else Vector3.new(0, 0, -1)
				local at = pos + Vector3.new(0, bob, 0)
				w.model:PivotTo(CFrame.lookAt(at, at + face) * CFrame.Angles(0, 0, math.sin(os.clock() * 14) * 0.22))
				if a >= 1 then
					w.index = w.index % #w.points + 1
					w.from = w.to
					w.to = w.points[w.index]
					w.dist = (w.to - w.from).Magnitude
					w.walked = 0
				end
			end
			for player, list in pairs(crews) do
				local data = ctx.Game.dataOf(player)
				local roster = data and data.staff and data.staff.roster or {}
				local byId: { [string]: any } = {}
				for _, e in ipairs(roster) do
					byId[e.id] = e
				end
				local jobs = ctx.Game.runtime[player] and ctx.Game.runtime[player].staffJob or {}
				for _, c in ipairs(list) do
					if not c.model.Parent then
						continue
					end
					local entry = byId[c.id]
					local speedLevel = entry and entry.speed or 1
					local job = jobs[c.id] or "idle"
					local speed = if job == "wait" then 2 else (5 + speedLevel * 1.5)
					c.walked += speed * dt
					local span = math.max(c.dist, 0.05)
					local along = math.clamp(c.walked / span, 0, 1)
					local pos = c.from:Lerp(c.to, along)
					local bob = math.abs(math.sin(os.clock() * (10 + speedLevel))) * (if job == "idle" then 0.18 else 0.28)
					local flat2 = Vector3.new(c.to.X - c.from.X, 0, c.to.Z - c.from.Z)
					local face2 = if flat2.Magnitude > 0.05 then flat2.Unit else Vector3.new(0, 0, -1)
					local sway = if job == "idle" then math.sin(os.clock() * 3) * 0.12 else math.sin(os.clock() * 12) * 0.16
					c.model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, bob, 0), pos + face2) * CFrame.Angles(0, 0, sway))
					if along >= 1 then
						c.index = c.index % #c.points + 1
						c.from = c.to
						c.to = c.points[c.index]
						c.dist = (c.to - c.from).Magnitude
						c.walked = 0
					end
					if os.clock() >= c.nextLine then
						c.line += 1
						c.nextLine = os.clock() + 5
						local head = c.model:FindFirstChild("Head")
						local bubble = head and head:FindFirstChild("Chatter")
						local label = bubble and bubble:FindFirstChild("Text")
						if label and label:IsA("TextLabel") then
							label.Text = Staff.line(c.id, c.line)
						end
					end
				end
			end
		end)
		if not ok then
			warn("[WorldService] waiter: " .. tostring(err))
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		customerModels[player] = customerModels[player]
	end)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="78">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="79">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="80">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpPower">50</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="81">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="82">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">Ambient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Ambient — purely cosmetic, client-side life for the map:
	  * fireflies (ParticleEmitters named "Fireflies") switch on at dusk and off at dawn
	  * a few decor critters in Map.Scenery.Critters wander around their home spot
	Nothing here replicates or touches gameplay. Critters far from the camera are skipped.
]]
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Jimothy = require(Shared.Logic.Jimothy)

local Ambient = {}

type Wanderer = {
	model: Model,
	home: Vector3,
	range: number,
	speed: number,
	pos: Vector3,
	target: Vector3,
	wait: number,
	y: number,
	t: number,
}

local rng = Random.new()

type Parade = {
	model: Model,
	points: { Vector3 },
	index: number,
	pos: Vector3,
	t: number,
	nextLine: number,
	showUntil: number,
	line: number,
	gui: BillboardGui?,
	label: TextLabel?,
}

local function isNight(): boolean
	local h = Lighting.ClockTime
	return h >= 18.25 or h < 5.75
end

function Ambient.start()
	local map = workspace:WaitForChild("Map", 60)
	if not map then
		return
	end
	local scenery = map:WaitForChild("Scenery", 30)
	if not scenery then
		return
	end

	-- fireflies at dusk
	local emitters: { ParticleEmitter } = {}
	for _, d in ipairs(scenery:GetDescendants()) do
		if d:IsA("ParticleEmitter") and d.Name == "Fireflies" then
			table.insert(emitters, d)
		end
	end
	local lastNight: boolean? = nil
	local function updateNight()
		local n = isNight()
		if n ~= lastNight then
			lastNight = n
			for _, e in ipairs(emitters) do
				e.Enabled = n
			end
		end
	end
	updateNight()
	Lighting:GetPropertyChangedSignal("ClockTime"):Connect(updateNight)

	-- wandering critters
	local wanderers: { Wanderer } = {}
	local folder = scenery:FindFirstChild("Critters")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			if m:IsA("Model") then
				local pivot = m:GetPivot()
				table.insert(wanderers, {
					model = m,
					home = pivot.Position,
					range = (m:GetAttribute("Range") :: number?) or 14,
					speed = (m:GetAttribute("Speed") :: number?) or 4,
					pos = pivot.Position,
					target = pivot.Position,
					wait = rng:NextNumber(0, 3),
					y = pivot.Position.Y,
					t = 0,
				})
			end
		end
	end
	-- Hub Jimothy: a fixed loop, a fast waddle, and a short speech bubble up close
	-- (or a brief one every few seconds when nobody's next to him).
	local parade: Parade? = nil
	local hub = map:FindFirstChild("Hub")
	local npc = hub and hub:FindFirstChild("JimothyWander")
	local path = hub and hub:FindFirstChild("JimothyPath")
	if npc and npc:IsA("Model") and path then
		local pts: { Vector3 } = {}
		local marks: { BasePart } = {}
		for _, p in ipairs(path:GetChildren()) do
			if p:IsA("BasePart") then
				table.insert(marks, p)
			end
		end
		table.sort(marks, function(a, b)
			return a.Name < b.Name
		end)
		for _, p in ipairs(marks) do
			table.insert(pts, p.Position)
		end
		if #pts >= 2 then
			local guiInst = npc:FindFirstChild("Speech", true)
			local gui = if guiInst and guiInst:IsA("BillboardGui") then guiInst else nil
			local textInst = gui and gui:FindFirstChild("Text")
			local label = if textInst and textInst:IsA("TextLabel") then textInst else nil
			parade = {
				model = npc,
				points = pts,
				index = 2,
				pos = pts[1],
				t = 0,
				nextLine = os.clock() + 2.4,
				showUntil = 0,
				line = 1,
				gui = gui,
				label = label,
			}
			npc:PivotTo(CFrame.lookAt(pts[1], pts[2]))
		end
	end

	if #wanderers == 0 and parade == nil then
		return
	end
	local player = Players.LocalPlayer
	RunService.Heartbeat:Connect(function(dt)
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		if parade then
			local w = parade
			local target = w.points[w.index]
			local delta = target - w.pos
			local flat = Vector3.new(delta.X, 0, delta.Z)
			w.t += dt
			if flat.Magnitude < 0.45 then
				w.index = w.index % #w.points + 1
				target = w.points[w.index]
				delta = target - w.pos
				flat = Vector3.new(delta.X, 0, delta.Z)
			end
			if flat.Magnitude > 0.05 then
				local step = math.min(flat.Magnitude, 11 * dt)
				w.pos += flat.Unit * step
				local hop = math.abs(math.sin(w.t * 16)) * 0.42
				local at = Vector3.new(w.pos.X, target.Y + hop, w.pos.Z)
				w.model:PivotTo(CFrame.lookAt(at, at + flat.Unit) * CFrame.Angles(0, 0, math.sin(w.t * 16) * 0.26))
			end
			local now = os.clock()
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local near = hrp ~= nil and (hrp.Position - w.pos).Magnitude < 18
			if w.label and now >= w.nextLine then
				w.line = w.line % #Jimothy.LINES + 1
				w.label.Text = Jimothy.LINES[w.line]
				w.nextLine = now + (if near then 2.6 else 8)
				if not near then
					w.showUntil = now + 2.2
				end
			end
			if w.gui then
				w.gui.Enabled = near or now < w.showUntil
			end
		end
		for _, w in ipairs(wanderers) do
			if (w.pos - camPos).Magnitude > 260 then
				continue
			end
			if w.wait > 0 then
				w.wait -= dt
				continue
			end
			local delta = w.target - w.pos
			local flat = Vector3.new(delta.X, 0, delta.Z)
			if flat.Magnitude < 0.5 then
				local a = rng:NextNumber(0, math.pi * 2)
				local r = rng:NextNumber(2, w.range)
				w.target = w.home + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
				w.wait = rng:NextNumber(1, 4)
				continue
			end
			local step = math.min(flat.Magnitude, w.speed * dt)
			w.pos += flat.Unit * step
			w.t += dt
			local hop = math.abs(math.sin(w.t * 9)) * 0.25
			local at = Vector3.new(w.pos.X, w.y + hop, w.pos.Z)
			w.model:PivotTo(CFrame.lookAt(at, at + flat.Unit))
		end
	end)
end

return Ambient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">CrewAnim</string>
            <string name="Source"><![CDATA[--!strict
-- Crew and Hiring Line critters are posed on each client. The server only stores
-- where they are going (CrewAnim attributes) and pays the coins.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CrewMotion = require(Shared.Logic.CrewMotion)

local CrewAnim = {}

type Mover = {
	model: Model,
	points: { Vector3 },
	length: number,
	raw: string,
	cheapAt: number,
	vecs: { { number } },
}

local movers: { Mover } = {}
local seen: { [Model]: boolean } = {}
local watching: { [Model]: RBXScriptConnection } = {}

local function decode(text: any): { Vector3 }
	local points = {}
	if type(text) ~= "string" then
		return points
	end
	for chunk in string.gmatch(text, "[^|]+") do
		local x, y, z = string.match(chunk, "([^,]+),([^,]+),([^,]+)")
		local nx, ny, nz = tonumber(x), tonumber(y), tonumber(z)
		if nx and ny and nz then
			table.insert(points, Vector3.new(nx, ny, nz))
		end
	end
	return points
end

local function lengthOf(points: { Vector3 }): number
	local total = 0
	for i = 1, #points - 1 do
		total += (points[i + 1] - points[i]).Magnitude
	end
	return total
end

local function toVecs(points: { Vector3 }): { { number } }
	local vecs = {}
	for _, p in ipairs(points) do
		table.insert(vecs, { p.X, p.Y, p.Z })
	end
	return vecs
end

local track: (Model) -> ()
track = function(model: Model)
	if seen[model] or not model:IsA("Model") then
		return
	end
	-- A streamed/replicated Model can arrive before its animation attributes. Watch
	-- for readiness rather than dropping it forever after DescendantAdded.
	if not watching[model] then
		watching[model] = model.AttributeChanged:Connect(function()
			track(model)
		end)
	end
	if model:GetAttribute("CrewAnim") == nil then
		return
	end
	local points = decode(model:GetAttribute("AnimPoints"))
	if #points < 2 then
		return
	end
	seen[model] = true
	if watching[model] then
		watching[model]:Disconnect()
		watching[model] = nil
	end
	table.insert(movers, { model = model, points = points, length = math.max(lengthOf(points), 0.05), raw = model:GetAttribute("AnimPoints") :: string, cheapAt = 0, vecs = toVecs(points) })
end

local function step(mover: Mover, now: number)
	local model = mover.model
	if not model.Parent then
		return
	end
	-- The server re-tags a model when its path changes (a hire walking home), so pick up new points.
	local raw = model:GetAttribute("AnimPoints")
	if type(raw) == "string" and raw ~= mover.raw then
		local points = decode(raw)
		if #points >= 2 then
			mover.points = points
			mover.length = math.max(lengthOf(points), 0.05)
			mover.vecs = toVecs(points)
		end
		mover.raw = raw
	end
	local speed = model:GetAttribute("AnimSpeed")
	local pace = if type(speed) == "number" and speed > 0 then speed else 4
	local phase = model:GetAttribute("AnimPhase")
	local shift = if type(phase) == "number" then phase else 0
	local kind = if model:GetAttribute("CrewAnim") == "once" then "once" else "loop"
	local startAttr = model:GetAttribute("AnimStart")
	local began = if type(startAttr) == "number" then startAttr else nil
	local x, y, z = CrewMotion.pose(mover.vecs, now, pace, shift, kind, began)
	-- Cull by where the critter should be, not where it was last drawn. A late joiner's copy
	-- still sits at the server's first point, which can be far from its real path.
	local cam = workspace.CurrentCamera
	if cam then
		local dist = (cam.CFrame.Position - Vector3.new(x, y, z)).Magnitude
		local detail = CrewMotion.detail(dist, Config.CrewLod.near, Config.CrewLod.far)
		if detail == "freeze" then
			return
		elseif detail == "cheap" and now - mover.cheapAt < Config.CrewLod.cheapStep then
			return
		end
		if detail == "cheap" then
			mover.cheapAt = now
		end
	end
	local x2, _, z2 = CrewMotion.pose(mover.vecs, now + 0.08, pace, shift, kind, began)
	local flat = Vector3.new(x2 - x, 0, z2 - z)
	local look = if flat.Magnitude > 0.05 then flat.Unit else Vector3.new(0, 0, -1)
	local at = Vector3.new(x, y, z)
	model:PivotTo(CFrame.lookAt(at, at + look))
end

function CrewAnim.start()
	local function scan(root: Instance)
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Model") then
				track(d)
			end
		end
	end
	scan(workspace)
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("Model") then
			track(d)
		end
	end)
	RunService.Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow()
		for model, connection in pairs(watching) do
			if not model:IsDescendantOf(workspace) then
				connection:Disconnect()
				watching[model] = nil
			end
		end
		local keep = {}
		for _, mover in ipairs(movers) do
			if mover.model.Parent then
				step(mover, now)
				table.insert(keep, mover)
			else
				seen[mover.model] = nil
			end
		end
		movers = keep
	end)
end

return CrewAnim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Feedback: toasts, announcements, rare-reveal cinematic, flip popups, floating coins.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UI = require(script.Parent.UI)
local Sfx = require(script.Parent.Sfx)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local HudLayout = require(Shared.Logic.HudLayout)
local T = UI.Theme

local Fx = {}
local gui: GuiObject = nil :: any
local toastHolder: Frame = nil :: any
local announceHolder: Frame = nil :: any

local KIND_COLOR = {
	good = T.green,
	bad = T.red,
	warn = Color3.fromHex("#E0A030"),
	ready = T.gold,
	info = Color3.fromHex("#2C4A6E"),
}

local function placeNotice(guiObject: GuiObject, b: HudLayout.Box)
	local w = math.max(1, UI.viewport.X)
	local h = math.max(1, UI.viewport.Y)
	guiObject.AnchorPoint = Vector2.new(0, 0)
	if b.w <= 0 or b.h <= 0 then
		guiObject.Visible = false
		return
	end
	guiObject.Visible = true
	guiObject.Position = UDim2.fromScale(b.x / w, b.y / h)
	guiObject.Size = UDim2.fromScale(b.w / w, b.h / h)
end

-- Follows the HUD. The Turkey Day note and the potluck call-out sit under the
-- guide and the goals bar instead of on top of them.
function Fx.applyLayout()
	if not toastHolder or not announceHolder then
		return
	end
	local Hud = require(script.Parent.Hud)
	local n = HudLayout.notices(UI.viewport.X, UI.viewport.Y, UI.insets, Hud.layoutOptions())
	placeNotice(announceHolder, n.announce)
	placeNotice(toastHolder, n.toast)
end

function Fx.mount(screen: GuiObject)
	gui = screen
	toastHolder = UI.frame({ Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(420, 72), Parent = screen, ZIndex = 50 })
	UI.list(toastHolder, nil, 6, Enum.HorizontalAlignment.Center)
	announceHolder = UI.frame({ Name = "Announce", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(520, 34), Parent = screen, ZIndex = 50 })
	UI.list(announceHolder, nil, 4, Enum.HorizontalAlignment.Center)
	UI.onLayout = Fx.applyLayout
	Fx.applyLayout()
end

function Fx.toast(text: string, kind: string?)
	if not toastHolder then
		return
	end
	local color = KIND_COLOR[kind or "info"] or KIND_COLOR.info
	local f = UI.frame({ BackgroundColor3 = color, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 51, Parent = toastHolder })
	UI.corner(f, 10)
	UI.stroke(f)
	UI.pad(f, 8)
	local inkOn = UI.contrast(T.text, color) < 4.5
	UI.label(text, { TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), TextSize = 18, TextColor3 = if inkOn then T.ink else T.text, ZIndex = 52, Parent = f })
	local kids = 0
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			kids += 1
		end
	end
	if kids > 4 then
		for _, c in ipairs(toastHolder:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
	task.delay(4.5, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

function Fx.announce(text: string, color: string?)
	if not announceHolder then
		return
	end
	local f = UI.frame({ BackgroundColor3 = Color3.fromHex("#12263F"), BackgroundTransparency = 0.12, Size = UDim2.new(1, 0, 0, 34), ZIndex = 51, Parent = announceHolder })
	UI.corner(f, 17)
	UI.label(text, { TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromHex(color or "#FFC83C"), TextSize = 18, Size = UDim2.new(1, 0, 1, 0), ZIndex = 52, Parent = f })
	for i, c in ipairs(announceHolder:GetChildren()) do
		if c:IsA("Frame") and i < #announceHolder:GetChildren() - 2 then
			c:Destroy()
		end
	end
	task.delay(6, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

-- Big Bertha's bell swings (client-side only) whenever someone rings it.
local function bertha(): Model?
	local m = workspace:FindFirstChild("BigBertha", true)
	return if m and m:IsA("Model") then m else nil
end

function Fx.ringBell()
	Sfx.play("bell", 0.95 + math.random() * 0.1, 0.4)
	local m = bertha()
	local bell = m and m:FindFirstChild("DinnerBell")
	if not bell or not bell:IsA("Model") then
		return
	end
	local home = bell:GetPivot()
	task.spawn(function()
		for i = 1, 8 do
			bell:PivotTo(home * CFrame.Angles(0, 0, math.rad(22) * math.sin(i * 1.4) * (1 - i / 9)))
			task.wait(0.07)
		end
		bell:PivotTo(home)
	end)
end

-- Dinner Bell pile-on: the bell swings, Big Bertha's chimney blows a huge puff, confetti pops,
-- and a big banner shows. Built for clips, so the payoff lands inside 2 seconds.
function Fx.dinnerBell()
	Fx.pop(Content.Slang.dinnerBell, Color3.fromHex("#FFC83C"), 64)
	Fx.ringBell()
	task.delay(0.35, function()
		Sfx.play("fanfare")
	end)
	local m = bertha()
	if not m then
		return
	end
	local chimney = m:FindFirstChild("Chimney", true)
	if chimney and chimney:IsA("BasePart") then
		local puff = Instance.new("Smoke")
		puff.Color = Color3.fromRGB(235, 235, 235)
		puff.Size = 14
		puff.Opacity = 0.6
		puff.RiseVelocity = 14
		puff.Parent = chimney
		task.delay(4, function()
			puff:Destroy()
		end)
	end
	local burst = Instance.new("Part")
	burst.Anchored, burst.CanCollide, burst.CanQuery, burst.CanTouch = true, false, false, false
	burst.Transparency = 1
	burst.Size = Vector3.new(1, 1, 1)
	burst.CFrame = m:GetPivot() * CFrame.new(0, 14, 0)
	burst.Parent = workspace
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHex("#FFC83C")), ColorSequenceKeypoint.new(0.5, Color3.fromHex("#FF7A3D")), ColorSequenceKeypoint.new(1, Color3.fromHex("#5AD2FF")) })
	pe.Speed = NumberRange.new(18, 30)
	pe.SpreadAngle = Vector2.new(70, 70)
	pe.Lifetime = NumberRange.new(1.5, 2.5)
	pe.Acceleration = Vector3.new(0, -25, 0)
	pe.Size = NumberSequence.new(0.6)
	pe.Rate = 0
	pe.Parent = burst
	pe:Emit(160)
	task.delay(3, function()
		burst:Destroy()
	end)
end

-- Big center-screen pop text.
function Fx.pop(text: string, color: Color3, size: number?)
	local l = UI.label(text, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.new(0, 700, 0, 80),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = color,
		TextSize = size or 46,
		TextStrokeTransparency = 0,
		ZIndex = 60,
		Parent = gui,
	})
	local tw = TweenService:Create(l, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.32), TextTransparency = 1, TextStrokeTransparency = 1 })
	tw:Play()
	task.delay(1.5, function()
		l:Destroy()
	end)
end

function Fx.coins(amount: number)
	Sfx.play("register", 0.95 + math.random() * 0.1, 0.12)
	if not gui then
		return
	end
	local start = UDim2.new(0.5, 0, 0, 78)
	local finish = UDim2.new(0.5, 0, 0, 28)
	local pill = gui:FindFirstChild("CoinPill", true)
	if pill and pill:IsA("GuiObject") then
		local abs = pill.AbsolutePosition
		local size = pill.AbsoluteSize
		local origin = gui.AbsolutePosition
		local x = abs.X - origin.X + size.X * 0.5
		local y = abs.Y - origin.Y + size.Y
		start = UDim2.fromOffset(x, y)
		finish = UDim2.fromOffset(x, y - 46)
	end
	local row = UI.frame({
		Name = "CoinPop",
		BackgroundColor3 = T.bg,
		BackgroundTransparency = 0.05,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = start,
		Size = UDim2.fromOffset(168, 40),
		ZIndex = 62,
		Parent = gui,
	})
	UI.corner(row, 20)
	UI.stroke(row, T.gold, 2)
	local list = UI.list(row, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	local coin = UI.coin(row, 24)
	coin.ZIndex = 63
	UI.label("+" .. UI.fmt(amount), {
		Size = UDim2.fromOffset(96, 28),
		TextSize = 22,
		TextColor3 = T.gold,
		Font = T.bold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 63,
		Parent = row,
	})
	local tw = TweenService:Create(row, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = finish,
		BackgroundTransparency = 1,
	})
	tw:Play()
	task.delay(0.95, function()
		if row.Parent then
			row:Destroy()
		end
	end)
end

local function shake(seconds: number, power: number)
	local cam = workspace.CurrentCamera
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = os.clock() - t0
		if a > seconds then
			conn:Disconnect()
			return
		end
		local p = power * (1 - a / seconds)
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * p, (math.random() - 0.5) * p, 0)
	end)
end
Fx.shake = shake

-- Rare reveal: a short orbit around your smoker, then a big title card.
function Fx.reveal(meatId: string, rarityId: string, aura: number, smokerPos: Vector3?)
	local meat = Config.Meats[meatId]
	local rar
	for _, r in ipairs(Config.Rarities) do
		if r.id == rarityId then
			rar = r
		end
	end
	if not meat or not rar then
		return
	end
	local color = Color3.fromHex(rar.color)
	Sfx.play("fanfare", rarityId == "meteorite" and 0.85 or 1)
	local cam = workspace.CurrentCamera
	if smokerPos then
		local oldType = cam.CameraType
		cam.CameraType = Enum.CameraType.Scriptable
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local a = os.clock() - t0
			if a > 2.2 then
				conn:Disconnect()
				cam.CameraType = if oldType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else oldType
				return
			end
			local ang = a * 1.4
			local pos = smokerPos + Vector3.new(math.cos(ang) * 14, 7 - a, math.sin(ang) * 14)
			cam.CFrame = CFrame.lookAt(pos, smokerPos + Vector3.new(0, 4, 0))
		end)
	end
	local overlay = UI.frame({ BackgroundColor3 = color, BackgroundTransparency = 0.6, Size = UDim2.fromScale(1, 1), ZIndex = 55, Parent = gui })
	local card = UI.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 520, 0, 220), BackgroundColor3 = Color3.fromHex("#12263F"), ZIndex = 56, Parent = overlay })
	UI.corner(card, 20)
	UI.stroke(card, color, 4)
	UI.label(string.upper(rar.name) .. "!", { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 60), TextSize = 50, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 57, Parent = card })
	UI.label(meat.icon .. " " .. meat.name, { Position = UDim2.new(0, 0, 0, 96), Size = UDim2.new(1, 0, 0, 36), TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 57, Parent = card })
	local sub = string.format("Worth x%s. Your smoke signal is up for the whole server!", tostring(rar.mult))
	if aura > 0 then
		sub = (string.gsub(Content.Slang.perfectFlip, "1000", tostring(aura))) .. "  •  " .. sub
	end
	UI.label(sub, { Position = UDim2.new(0, 20, 0, 146), Size = UDim2.new(1, -40, 0, 50), TextSize = 18, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 57, Parent = card })
	card.Size = UDim2.new(0, 0, 0, 0)
	TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 520, 0, 220) }):Play()
	if rarityId == "texas" then
		-- Texas-size: the cut is so big it crushes the picnic table (camera shake + crunch text)
		task.delay(0.4, function()
			shake(0.8, 1.2)
			Sfx.play("crunch")
			Fx.pop("CRUNCH! It broke the table!", Color3.fromHex("#FF5A36"), 38)
		end)
	elseif rarityId == "meteorite" then
		task.delay(0.3, function()
			shake(1.2, 2)
		end)
	end
	task.delay(3.2, function()
		TweenService:Create(overlay, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		task.wait(0.4)
		overlay:Destroy()
	end)
end

-- Spatula flip: the clank always plays; a perfect flip adds a big sear that climbs in pitch
-- with your combo, so a hot streak sounds hotter.
function Fx.flip(result: string, combo: number, lockedIn: boolean?)
	Sfx.play("spatula", result == "miss" and 0.85 or 1)
	if result == "perfect" then
		Sfx.play("sear", 1 + math.min(combo, 10) * 0.04)
		if lockedIn then
			task.delay(0.5, function()
				Sfx.play("ding", 1 + math.min(combo, 10) * 0.03)
			end)
		end
		Fx.pop(Content.Slang.perfectFlip, T.gold)
		if lockedIn then
			task.delay(0.5, function()
				Fx.pop(Content.Slang.lockedIn .. "  x" .. combo, Color3.fromHex("#6CC24A"), 40)
			end)
		end
	elseif result == "good" then
		Fx.pop("Nice flip!", T.green, 36)
	else
		Fx.pop("Flipped too early/late", T.dim, 30)
	end
end

-- Rookie List goal done: a ding, a coin jingle and Unc's cheer. The last goal gets the kazoo
-- fanfare and a confetti pop around you.
function Fx.rookie(d: any)
	if d.last then
		Sfx.play("fanfare")
		Fx.pop("🎉 ROOKIE OF THE RANCH!", T.gold, 52)
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local burst = Instance.new("Part")
			burst.Anchored, burst.CanCollide, burst.CanQuery, burst.CanTouch = true, false, false, false
			burst.Transparency = 1
			burst.Size = Vector3.new(1, 1, 1)
			burst.CFrame = hrp.CFrame * CFrame.new(0, 3, 0)
			burst.Parent = workspace
			local pe = Instance.new("ParticleEmitter")
			pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHex("#FFC83C")), ColorSequenceKeypoint.new(0.5, Color3.fromHex("#E8590C")), ColorSequenceKeypoint.new(1, Color3.fromHex("#5AD2FF")) })
			pe.Speed = NumberRange.new(10, 18)
			pe.SpreadAngle = Vector2.new(80, 80)
			pe.Lifetime = NumberRange.new(1, 1.8)
			pe.Acceleration = Vector3.new(0, -20, 0)
			pe.Size = NumberSequence.new(0.4)
			pe.Rate = 0
			pe.Parent = burst
			pe:Emit(90)
			task.delay(2.5, function()
				burst:Destroy()
			end)
		end
	else
		Sfx.play("ding", 1 + (d.step or 1) * 0.05)
		task.delay(0.15, function()
			Sfx.play("coins")
		end)
		Fx.pop(string.format("✅ Rookie List %d/%d", d.step or 1, d.total or 5), T.green, 40)
		if d.cheer then
			task.delay(0.6, function()
				Fx.announce(d.cheer, "#FFF6E6")
			end)
		end
	end
end

local function speechBubble(part: BasePart, text: string, color: Color3)
	local bb = Instance.new("BillboardGui")
	bb.Name = "HowdyBubble"
	bb.Size = UDim2.fromOffset(220, 64)
	bb.StudsOffset = Vector3.new(0, 3.2, 0)
	bb.AlwaysOnTop = true
	bb.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundColor3 = Color3.fromHex("#12263F")
	label.BackgroundTransparency = 0.1
	label.TextColor3 = color
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.Size = UDim2.fromScale(1, 1)
	label.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = label
	task.delay(4, function()
		if bb.Parent then
			bb:Destroy()
		end
	end)
end

-- A howdy is said out loud. The speaker waves, a bubble sits on their head,
-- and the yard answers even when nobody else is in the server.
function Fx.howdy(d: any)
	local speaker = Players:GetPlayerByUserId(d.userId or 0)
	local char = speaker and speaker.Character
	local head = char and (char:FindFirstChild("Head") :: BasePart?)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if head then
		speechBubble(head, "Howdy!", Color3.fromHex("#FFD15A"))
	end
	if hum then
		pcall(function()
			(hum :: any):PlayEmote("wave")
		end)
	end
	local map = workspace:FindFirstChild("Map")
	local hub = map and map:FindFirstChild("Hub")
	if hub then
		for _, name in ipairs({ "KingOfThePit", "UncHank", "Temp" }) do
			local npc = hub:FindFirstChild(name)
			local npcHead = npc and npc:FindFirstChild("Head", true)
			if npcHead and npcHead:IsA("BasePart") then
				speechBubble(npcHead, name == "KingOfThePit" and "Howdy, partner." or "Howdy!", Color3.fromHex("#FFF8F0"))
			end
		end
		local stage = hub:FindFirstChild("CookOff")
		if stage then
			for _, name in ipairs({ "Granny", "JudgeBob" }) do
				local npc = stage:FindFirstChild(name)
				local npcHead = npc and npc:FindFirstChild("Head", true)
				if npcHead and npcHead:IsA("BasePart") then
					speechBubble(npcHead, "Howdy!", Color3.fromHex("#FFF8F0"))
				end
			end
		end
	end
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local plots = map and map:FindFirstChild("Plots")
	if hrp and plots then
		for _, plot in ipairs(plots:GetChildren()) do
			local tables = plot:FindFirstChild("Tables")
			if tables then
				for _, guest in ipairs(tables:GetDescendants()) do
					if guest:IsA("BasePart") and guest.Name == "Head" and (guest.Position - hrp.Position).Magnitude < 40 then
						speechBubble(guest, "Howdy!", Color3.fromHex("#C8F0A8"))
					end
				end
			end
		end
	end
	if d.rewarded then
		Fx.pop("Howdy! The King tipped his hat.", T.gold, 32)
	end
end

local _ = Players
return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">GuideHint</string>
            <string name="Source"><![CDATA[--!strict
-- A short first-visit card and a gold arrow on the button the server asked us to try.
-- The server decides the step and when it is finished. Skip is saved on the profile.
local UI = require(script.Parent.UI)
local Hud = require(script.Parent.Hud)
local Net = require(script.Parent.Net)
local T = UI.Theme
local GOLD = Color3.fromHex("#FFD15A")

local GuideHint = {}
local refs: any = {}
local glowed: GuiObject? = nil

local function restoreGlow()
	local target = glowed
	glowed = nil
	if not target then
		return
	end
	local stroke = target:FindFirstChildOfClass("UIStroke")
	local r = target:GetAttribute("GuideR")
	if stroke and type(r) == "number" then
		stroke.Color = Color3.new(r, target:GetAttribute("GuideG") :: number, target:GetAttribute("GuideB") :: number)
		stroke.Thickness = target:GetAttribute("GuideThick") :: number
	end
	target:SetAttribute("GuideR", nil)
end

local function glow(target: GuiObject?)
	if glowed == target then
		return
	end
	restoreGlow()
	if not target then
		return
	end
	local stroke = target:FindFirstChildOfClass("UIStroke")
	if not stroke then
		return
	end
	target:SetAttribute("GuideR", stroke.Color.R)
	target:SetAttribute("GuideG", stroke.Color.G)
	target:SetAttribute("GuideB", stroke.Color.B)
	target:SetAttribute("GuideThick", stroke.Thickness)
	stroke.Color = GOLD
	stroke.Thickness = 3
	glowed = target
end

function GuideHint.mount(root: GuiObject)
	local card = UI.frame({
		Name = "GuideHint",
		BackgroundColor3 = T.bg,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 8,
		Parent = root,
	})
	UI.corner(card, 12)
	UI.stroke(card, GOLD, 2)
	UI.pad(card, 8)
	refs.card = card
	refs.root = root
	refs.title = UI.label("", { Size = UDim2.new(1, -100, 0, 22), TextSize = 18, TextColor3 = GOLD, ZIndex = 9, Parent = card })
	refs.body = UI.label("", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -100, 1, -28), TextSize = 15, Font = T.body, TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 9, Parent = card })
	refs.skip = UI.button("Skip", T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 88, 1, -8), TextSize = 16, ZIndex = 9, Parent = card }, function()
		task.spawn(Net.act, "GuideSkip")
	end)
	refs.arrow = UI.label("▼", {
		Name = "GuideArrow",
		BackgroundTransparency = 1,
		Active = false,
		Size = UDim2.fromOffset(36, 28),
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = GOLD,
		TextStrokeTransparency = 0.4,
		Visible = false,
		ZIndex = 12,
		Parent = root,
	})
	GuideHint.applyLayout()
end

function GuideHint.applyLayout()
	local card = refs.card
	local b = Hud.box("guide")
	if not card or not b or b.w <= 0 or b.h <= 0 then
		return
	end
	local w = math.max(1, UI.viewport.X)
	local h = math.max(1, UI.viewport.Y)
	card.AnchorPoint = Vector2.new(0, 0)
	card.Position = UDim2.fromScale(b.x / w, b.y / h)
	card.Size = UDim2.fromScale(b.w / w, b.h / h)
end

local function pointAt(target: GuiObject)
	local arrow = refs.arrow
	local root = refs.root
	if not arrow or not root then
		return
	end
	local tp = target.AbsolutePosition
	local ts = target.AbsoluteSize
	local rp = root.AbsolutePosition
	local x = tp.X - rp.X + ts.X * 0.5 - 18
	local above = tp.Y - rp.Y - 30
	if above < 4 then
		arrow.Text = "▲"
		arrow.Position = UDim2.fromOffset(x, tp.Y - rp.Y + ts.Y + 2)
	else
		arrow.Text = "▼"
		arrow.Position = UDim2.fromOffset(x, above)
	end
	arrow.Visible = target.Visible and ts.X > 0
end

function GuideHint.update(s: any)
	if not refs.card then
		return
	end
	local g = if s and type(s.onboard) == "table" and s.onboard.title then s.onboard else s and s.guide
	if type(g) == "table" and g.title and g.active ~= false and s and type(s.onboard) == "table" then
		g = s.onboard
		g.active = true
	end
	if not g or g.active ~= true then
		refs.card.Visible = false
		if refs.arrow then
			refs.arrow.Visible = false
		end
		restoreGlow()
		return
	end
	refs.card.Visible = true
	refs.title.Text = string.format("%d/%d  %s", g.step or 1, g.total or 4, g.title or "")
	refs.body.Text = g.body or ""
	GuideHint.applyLayout()
	local banner = Hud.box("guide")
	refs.body.Visible = banner ~= nil and banner.h >= 56
	local target = if type(g.target) == "string" then Hud.guideTarget(g.target) else nil
	if target then
		Hud.reveal(g.target)
		glow(target)
		pointAt(target)
	else
		restoreGlow()
		if refs.arrow then
			refs.arrow.Visible = false
		end
	end
end

return GuideHint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- The always-on HUD: currencies, menu buttons, the station bar, Serve All / Collect All,
-- and the one-button first cook for brand-new players.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)
local Sfx = require(script.Parent.Sfx)
local Net = require(script.Parent.Net)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CookLogic = require(Shared.Logic.CookLogic)
local HudMenu = require(Shared.Logic.HudMenu)
local Onboard = require(Shared.Logic.Onboard)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Income = require(Shared.Logic.Income)
local Economy = require(Shared.Logic.Economy)
local Goals = require(Shared.Logic.Goals)
local HudLayout = require(Shared.Logic.HudLayout)
local T = UI.Theme

local Hud = {}
local Panels: any = nil
local root: Frame = nil :: any
local refs: any = {}
local cards: { [string]: any } = {}
local cardLayoutKey = ""
local menuButtons: { Frame } = {}
local styleCard: (any) -> ()

function Hud.view(st: any, boost: any): (number, number, boolean, number?)
	local now = workspace:GetServerTimeNow()
	local c: any = {
		meat = st.meat,
		rarity = "",
		progress = st.progress,
		duration = st.duration,
		last = st.last,
		startedAt = st.last,
		rateMult = 1,
		peeks = 0,
		revealed = false,
		doneAt = st.doneAt,
	}
	CookLogic.advance(c, now, st.rate, boost.mult, boost.untilT)
	local remaining = CookLogic.remaining(c, now, st.rate, boost.mult, boost.untilT)
	return CookLogic.fraction(c), remaining, CookLogic.isDone(c), c.doneAt
end

local function topPill(parent: Instance, icon: string, order: number, color: Color3, wide: number?): TextLabel
	local f = UI.frame({ BackgroundColor3 = T.bg, BackgroundTransparency = 0.05, Size = UDim2.new(0, wide or 156, 0, 48), LayoutOrder = order, Parent = parent })
	UI.corner(f, 16)
	UI.stroke(f, color, 2)
	UI.label(icon, { Size = UDim2.new(0, 36, 1, 0), Position = UDim2.new(0, 8, 0, 0), TextSize = 24, Parent = f })
	local value = UI.label("0", { Name = "Value", Size = UDim2.new(1, -50, 1, 0), Position = UDim2.new(0, 44, 0, 0), TextSize = 22, TextColor3 = color, Parent = f })
	UI.fitText(value, 22, 15)
	return value
end

-- Art sits under a childless hit button. Labels used to cover the TextButton,
-- so the click landed on the icon or the caption and Activated never ran.
local function menuButton(parent: Instance, entry: HudMenu.Entry): Frame
	local holder = UI.frame({
		Name = entry.id,
		BackgroundColor3 = T.bg,
		BackgroundTransparency = 0.05,
		Size = UDim2.new(0, 96, 0, 72),
		LayoutOrder = entry.order,
		ZIndex = 2,
		Parent = parent,
	})
	UI.corner(holder, 12)
	UI.stroke(holder, T.stroke, 1.5)
	UI.label(entry.icon, { Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 0, 4), TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = holder })
	local caption = UI.label(entry.label, { Size = UDim2.new(1, -8, 0, 24), Position = UDim2.new(0, 4, 1, -28), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Font = T.bold, ZIndex = 3, Parent = holder })
	UI.fitText(caption, 16, 12)
	local dot = UI.frame({ Name = "Dot", BackgroundColor3 = T.red, Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -12, 0, -2), Visible = false, ZIndex = 4, Parent = holder })
	UI.corner(dot, 7)
	local hit = UI.button("", T.bg, {
		Name = "Hit",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		TextTransparency = 1,
		Text = "",
		ZIndex = HudMenu.HIT_Z,
		Parent = holder,
	}, function()
		Panels.toggle(entry.panel)
	end)
	local stroke = hit:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 1
	end
	HudMenu.releaseDecorations(holder)
	hit.MouseEnter:Connect(function()
		holder.BackgroundColor3 = T.cardHi
	end)
	hit.MouseLeave:Connect(function()
		holder.BackgroundColor3 = T.bg
	end)
	hit.MouseButton1Down:Connect(function()
		holder.BackgroundColor3 = T.accent
	end)
	hit.MouseButton1Up:Connect(function()
		holder.BackgroundColor3 = T.cardHi
	end)
	table.insert(menuButtons, holder)
	return holder
end

local function statusLine(parent: Instance, order: number, color: Color3): TextLabel
	local l = UI.label("", {
		BackgroundColor3 = T.bg,
		BackgroundTransparency = 0.12,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 18,
		TextColor3 = color,
		Font = T.bold,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = order,
		Visible = false,
		Parent = parent,
	})
	UI.corner(l, 8)
	UI.pad(l, 6)
	return l
end

function Hud.mount(screen: GuiObject, panels: any)
	Panels = panels
	root = UI.frame({ Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = screen })

	local top = UI.new("ScrollingFrame", {
		Name = "Currencies",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0, 900, 0, 52),
		Parent = root,
	})
	local topList = UI.list(top, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	topList.VerticalAlignment = Enum.VerticalAlignment.Center
	refs.top = top
	local coinPill = UI.frame({ Name = "CoinPill", BackgroundColor3 = T.bg, BackgroundTransparency = 0.05, Size = UDim2.new(0, 220, 0, 48), LayoutOrder = 1, Parent = top })
	UI.corner(coinPill, 16)
	UI.stroke(coinPill, T.gold, 2)
	local coinIcon = UI.coin(coinPill, 28)
	coinIcon.Position = UDim2.new(0, 8, 0.5, -14)
	refs.income = UI.label("+0/s", { Name = "Rate", Size = UDim2.new(1, -48, 0, 26), Position = UDim2.new(0, 42, 0, 1), TextSize = 22, TextColor3 = T.green, Font = T.bold, Parent = coinPill })
	refs.coins = UI.label("0", { Name = "Value", Size = UDim2.new(1, -48, 0, 16), Position = UDim2.new(0, 42, 0, 28), TextSize = 14, TextColor3 = T.gold, Font = T.bold, Parent = coinPill })
	refs.rateScale = UI.new("UIScale", { Name = "Pulse", Scale = 1, Parent = refs.income })
	UI.fitText(refs.income, 26, 16)
	UI.fitText(refs.coins, 16, 12)
	refs.coinPill = coinPill
	refs.shownCoins = 0
	refs.aura = topPill(top, "✨", 2, Color3.fromHex("#D4C2FF"))
	refs.rank = topPill(top, "👴", 3, T.text, 210)
	refs.cooler = topPill(top, "🧊", 4, Color3.fromHex("#B9E6FF"))
	refs.boost = topPill(top, "⏩", 5, Color3.fromHex("#B6F0C8"))
	refs.boost.Parent.Visible = false

	refs.gift = UI.button("Gift", T.green, { Name = "Gift", Size = UDim2.new(0, 120, 0, 44), LayoutOrder = 6, Visible = false, TextSize = 16, Parent = top }, function()
		Net.act("ClaimGift")
	end)

	local goals = UI.frame({
		Name = "Goals",
		BackgroundColor3 = T.bg,
		BackgroundTransparency = 0.04,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 64),
		Size = UDim2.new(0, 460, 0, 44),
		Visible = false,
		ZIndex = 3,
		Parent = root,
	})
	UI.corner(goals, 12)
	UI.stroke(goals, T.stroke, 1.5)
	refs.goals = goals
	refs.goalTitle = UI.label("Next", { Position = UDim2.new(0, 12, 0, 2), Size = UDim2.new(1, -130, 0, 20), TextSize = 16, Font = T.bold, ZIndex = 4, Parent = goals })
	refs.goalDetail = UI.label("", { Position = UDim2.new(0, 12, 0, 22), Size = UDim2.new(1, -130, 0, 16), TextSize = 13, TextColor3 = T.dim, Font = T.body, ZIndex = 4, Parent = goals })
	local gBack, gFill = UI.bar(goals, T.accent, { Position = UDim2.new(0, 12, 1, -8), Size = UDim2.new(1, -140, 0, 6), ZIndex = 4 })
	refs.goalBack, refs.goalFill = gBack, gFill
	refs.goalBtn = UI.button("Go", T.accent, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 88, 0, 36), TextSize = 16, ZIndex = 5, Parent = goals }, function()
		local action = refs.goalAction
		if action == "gift" then
			Net.act("ClaimGift")
		elseif refs.goalId == "hire" then
			Panels.open("hire")
		elseif action == "crew" or action == "upgrades" then
			Panels.open(action)
		end
	end)

	local menu = UI.new("ScrollingFrame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = true,
		ZIndex = HudMenu.SCROLL_Z,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 10, 0, 68),
		Size = UDim2.new(0, 108, 0, 560),
		Parent = root,
	})
	refs.menu = menu
	refs.menuList = UI.list(menu, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	local byId: { [string]: Frame } = {}
	for _, entry in ipairs(HudMenu.entries) do
		byId[entry.id] = menuButton(menu, entry)
	end
	refs.btnShop = byId.shop
	refs.btnSeason = byId.season
	refs.btnSauce = byId.sauce
	refs.btnIndex = byId.index
	refs.btnPath = byId.path
	refs.btnUp = byId.upgrades
	refs.btnCrew = byId.crew
	refs.btnHire = byId.hire
	refs.btnRanch = byId.ranch
	refs.menuById = byId
	refs.btnDaily = byId.daily
	refs.btnSettings = byId.settings
	refs.btnInvite = byId.invite

	local right = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -196), Size = UDim2.new(0, 188, 0, 164), Parent = root })
	local rightList = UI.list(right, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right)
	rightList.VerticalAlignment = Enum.VerticalAlignment.Bottom
	refs.right = right
	refs.rightList = rightList
	refs.serveAll = UI.button("🍽️ Serve All", T.green, { Size = UDim2.new(0, 188, 0, 52), TextSize = 20, LayoutOrder = 1, Parent = right }, function()
		Net.act("ServeAll")
	end)
	refs.collectAll = UI.button("📥 Collect All", T.blue, { Size = UDim2.new(0, 188, 0, 48), LayoutOrder = 2, Parent = right }, function()
		Net.act("CollectAll")
	end)
	refs.homeBtn = UI.button("🏠 Home", T.card, { Size = UDim2.new(0, 140, 0, 44), LayoutOrder = 3, TextSize = 18, Parent = right }, function()
		Panels.goHome()
	end)

	local status = UI.frame({ Name = "Status", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -210, 1, -196), Size = UDim2.new(0, 320, 0, 100), Parent = root })
	UI.list(status, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right)
	refs.status = status
	refs.rush = statusLine(status, 1, T.gold)
	refs.combo = statusLine(status, 2, Color3.fromHex("#C8F0A8"))
	refs.customers = statusLine(status, 3, T.text)

	local bar = UI.new("ScrollingFrame", {
		Name = "Stations",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 120, 1, -8),
		Size = UDim2.new(1, -330, 0, 176),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollBarThickness = 8,
		Parent = root,
	})
	local lay = UI.list(bar, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left)
	lay.VerticalAlignment = Enum.VerticalAlignment.Bottom
	refs.bar = bar

	refs.first = UI.button("🔥 Smoke your first brisket!", T.accent, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -196), Size = UDim2.new(0, 460, 0, 64), TextSize = 26, Visible = false, Parent = root }, function()
		if Net.act("FirstBrisket") then
			refs.first.Visible = false
		end
	end)
	local pulse = UI.new("UIScale", { Name = "Pulse", Scale = 1, Parent = refs.first })
	task.spawn(function()
		while true do
			if refs.first.Visible then
				local tw = TweenService:Create(pulse, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true), { Scale = 1.03 })
				tw:Play()
				tw.Completed:Wait()
			else
				pulse.Scale = 1
				task.wait(0.5)
			end
		end
	end)
	refs.hint = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -268),
		Size = UDim2.new(0, 560, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 20,
		Font = T.bold,
		TextColor3 = T.ink,
		BackgroundColor3 = T.gold,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = root,
	})
	UI.corner(refs.hint, 10)
	UI.pad(refs.hint, 6)

	Hud.applyLayout()
end

local function place(gui: GuiObject, b: { x: number, y: number, w: number, h: number })
	local w = math.max(1, UI.viewport.X)
	local h = math.max(1, UI.viewport.Y)
	gui.AnchorPoint = Vector2.new(0, 0)
	if b.w <= 0 or b.h <= 0 then
		gui.Position = UDim2.fromOffset(0, 0)
		gui.Size = UDim2.fromOffset(0, 0)
		return
	end
	gui.Position = UDim2.fromScale(b.x / w, b.y / h)
	gui.Size = UDim2.fromScale(b.w / w, b.h / h)
end

function Hud.layoutOptions(): HudLayout.Options
	local s = Net.state
	local guideOn = s ~= nil and s.guide ~= nil and s.guide.active == true
	return {
		guide = guideOn,
		rookie = s ~= nil and s.rookie ~= nil and s.rookie.finished ~= true and s.tutorial ~= nil and s.tutorial.done == true,
		goals = not guideOn,
		hint = true,
		first = true,
	}
end

function Hud.applyLayout()
	if not refs.top then
		return
	end
	local v = UI.viewport
	local lay = HudLayout.compute(v.X, v.Y, UI.insets, Hud.layoutOptions())
	refs.layout = lay
	local compact = lay.compact
	UI.stationReserve = lay.stations.h + lay.actions.h + 16
	UI.topChrome = (lay.guide.h > 0 and (lay.guide.y + lay.guide.h) or (lay.goals.y + lay.goals.h)) - lay.safe.y
	if UI.topChrome < lay.menu.y then
		UI.topChrome = lay.menu.y + lay.menu.h
	end

	place(refs.top, lay.currencies)
	place(refs.menu, lay.menu)
	place(refs.goals, lay.goals)
	place(refs.bar, lay.stations)
	place(refs.first, lay.first)
	place(refs.hint, lay.hint)
	local pillH = math.max(40, math.min(48, lay.currencies.h))
	refs.coinPill.Size = UDim2.fromOffset(if compact then 176 else 228, pillH)
	for _, child in ipairs(refs.top:GetChildren()) do
		if child:IsA("GuiObject") and child ~= refs.coinPill and not child:IsA("UIListLayout") then
			local wide = child.Size.X.Offset
			if wide < 40 then
				wide = 120
			end
			child.Size = UDim2.fromOffset(wide, pillH)
		end
	end

	if compact then
		refs.menu.AutomaticCanvasSize = Enum.AutomaticSize.X
		refs.menu.ScrollingDirection = Enum.ScrollingDirection.X
		refs.menuList.FillDirection = Enum.FillDirection.Horizontal
		local bw = math.max(UI.TOUCH, math.floor((lay.actions.w - 16) / 3))
		place(refs.right, lay.actions)
		refs.serveAll.Size = UDim2.fromOffset(bw, math.max(44, lay.actions.h - 4))
		refs.collectAll.Size = UDim2.fromOffset(bw, math.max(44, lay.actions.h - 4))
		refs.homeBtn.Size = UDim2.fromOffset(bw, math.max(44, lay.actions.h - 4))
		refs.rightList.FillDirection = Enum.FillDirection.Horizontal
		refs.rightList.HorizontalAlignment = Enum.HorizontalAlignment.Left
		refs.rightList.VerticalAlignment = Enum.VerticalAlignment.Center
		refs.rush.Parent = refs.top
		refs.combo.Parent = refs.top
		refs.customers.Parent = refs.top
		for index, line in ipairs({ refs.rush, refs.combo, refs.customers }) do
			line.LayoutOrder = 20 + index
			line.Size = UDim2.fromOffset(180, math.max(36, pillH - 4))
			line.AutomaticSize = Enum.AutomaticSize.X
		end
		refs.status.Visible = false
	else
		refs.menu.AutomaticCanvasSize = Enum.AutomaticSize.Y
		refs.menu.ScrollingDirection = Enum.ScrollingDirection.Y
		refs.menuList.FillDirection = Enum.FillDirection.Vertical
		place(refs.right, lay.right)
		refs.serveAll.Size = UDim2.fromOffset(math.max(44, lay.right.w), 52)
		refs.collectAll.Size = UDim2.fromOffset(math.max(44, lay.right.w), 48)
		refs.homeBtn.Size = UDim2.fromOffset(math.max(44, lay.right.w - 48), 44)
		refs.rightList.FillDirection = Enum.FillDirection.Vertical
		refs.rightList.HorizontalAlignment = Enum.HorizontalAlignment.Right
		refs.rightList.VerticalAlignment = Enum.VerticalAlignment.Bottom
		refs.status.Visible = lay.status.h > 0
		refs.rush.Parent = refs.status
		refs.combo.Parent = refs.status
		refs.customers.Parent = refs.status
		for index, line in ipairs({ refs.rush, refs.combo, refs.customers }) do
			line.LayoutOrder = index
			line.AutomaticSize = Enum.AutomaticSize.None
			line.Size = UDim2.new(1, 0, 0, 32)
		end
		place(refs.status, lay.status)
	end
	for _, b in ipairs(menuButtons) do
		b.Size = UDim2.fromOffset(lay.menuButton.w, lay.menuButton.h)
	end
	for _, c in pairs(cards) do
		styleCard(c)
	end
	if UI.onLayout then
		UI.onLayout()
	end
end

function Hud.box(name: string): any
	return refs.layout and refs.layout[name]
end

function Hud.guideTarget(id: string): GuiObject?
	if id == "ranch" then
		return refs.first
	elseif id == "serve" then
		return refs.serveAll
	elseif id == "crew" then
		return refs.btnCrew
	elseif id == "hire" then
		return refs.btnHire
	elseif id == "ranchbuild" then
		return refs.btnRanch
	elseif id == "gift" then
		if refs.gift and refs.gift.Visible then
			return refs.gift
		end
		return refs.btnDaily
	end
	return nil
end

function Hud.reveal(id: string)
	local target = Hud.guideTarget(id)
	if not target or not target.Parent then
		return
	end
	local parent = target.Parent
	if not parent:IsA("ScrollingFrame") then
		return
	end
	local scroller = parent :: ScrollingFrame
	local relX = target.AbsolutePosition.X - scroller.AbsolutePosition.X + scroller.CanvasPosition.X
	local relY = target.AbsolutePosition.Y - scroller.AbsolutePosition.Y + scroller.CanvasPosition.Y
	if scroller.ScrollingDirection == Enum.ScrollingDirection.X then
		scroller.CanvasPosition = Vector2.new(math.max(0, relX - 8), 0)
	else
		scroller.CanvasPosition = Vector2.new(0, math.max(0, relY - 8))
	end
end

local function slotName(key: string): string
	local n = string.sub(key, 2)
	return (string.sub(key, 1, 1) == "s" and "Smoker " or "Grill ") .. n
end

function styleCard(c)
	local compact = UI.compact
	local card = if refs.layout then refs.layout.stationCard else { w = if compact then 158 else 176, h = if compact then 120 else 168 }
	c.frame.Size = UDim2.fromOffset(card.w, card.h)
	if c.ratio then
		c.ratio.AspectRatio = card.w / math.max(1, card.h)
	end
	local nameH = if compact then 20 else 36
	c.title.Size = UDim2.new(1, 0, 0, if compact then 16 else 18)
	c.name.Position = UDim2.new(0, 0, 0, if compact then 16 else 22)
	c.name.Size = UDim2.new(1, c.peek.Visible and -48 or 0, 0, nameH)
	local barY = if compact then 36 else 62
	if c.barBack then
		c.barBack.Position = UDim2.fromOffset(0, barY)
		c.barBack.Size = UDim2.new(1, 0, 0, if compact then 8 else 12)
	end
	c.time.TextWrapped = not compact
	local timeY = barY + (if compact then 10 else 16)
	local btnTop = card.h - 44
	if timeY + 16 > btnTop then
		timeY = math.max(barY + 10, btnTop - 16)
	end
	c.time.Position = UDim2.fromOffset(0, timeY)
	c.time.Size = UDim2.new(1, 0, 0, 16)
	c.peek.Position = UDim2.new(1, -44, 0, if compact then 0 else 16)
	c.btn.Position = UDim2.new(0, 0, 1, -44)
	c.btn.Size = UDim2.new(1, 0, 0, 44)
end

local function makeCard(key: string, order: number): any
	local c: any = {}
	local f = UI.frame({ Name = key, BackgroundColor3 = T.bg, BackgroundTransparency = 0.04, Size = UDim2.new(0, 176, 0, 168), LayoutOrder = order, Parent = refs.bar })
	UI.corner(f, 12)
	c.stroke = UI.stroke(f, T.card, 2)
	UI.pad(f, 6)
	c.frame = f
	c.ratio = UI.new("UIAspectRatioConstraint", { Name = "CardRatio", AspectRatio = 176 / 168, DominantAxis = Enum.DominantAxis.Width, Parent = f })
	c.title = UI.label(slotName(key), { Size = UDim2.new(1, 0, 0, 18), TextSize = 16, TextColor3 = T.dim, Font = T.bold, Parent = f })
	c.name = UI.label("Empty", { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 40), TextSize = 18, TextWrapped = true, Parent = f })
	local back, fill = UI.bar(f, T.accent, { Position = UDim2.new(0, 0, 0, 66), Size = UDim2.new(1, 0, 0, 12) })
	c.barBack, c.fill = back, fill
	local F = Config.Flip
	c.good = UI.frame({ BackgroundColor3 = T.green, BackgroundTransparency = 0.45, Position = UDim2.fromScale(F.target - F.goodWindow, 0), Size = UDim2.fromScale(F.goodWindow * 2, 1), Visible = false, ZIndex = 2, Parent = back })
	c.perfect = UI.frame({ BackgroundColor3 = T.gold, BackgroundTransparency = 0.15, Position = UDim2.fromScale(F.target - F.perfectWindow, 0), Size = UDim2.fromScale(F.perfectWindow * 2, 1), Visible = false, ZIndex = 3, Parent = back })
	c.time = UI.label("", { Position = UDim2.new(0, 0, 0, 82), Size = UDim2.new(1, 0, 0, 28), TextSize = 16, TextColor3 = T.dim, Font = T.body, Parent = f })
	c.btn = UI.button("Cook", T.accent, { Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 44), TextSize = 18, Parent = f }, function()
		Hud.cardAction(key)
	end)
	c.peek = UI.button("👀", T.card, { Position = UDim2.new(1, -44, 0, 16), Size = UDim2.new(0, 44, 0, 44), TextSize = 18, Visible = false, Parent = f }, function()
		Net.act("Peek", key)
	end)
	styleCard(c)
	return c
end

function Hud.cardAction(key: string)
	local s = Net.state
	if not s then
		return
	end
	local kind = string.sub(key, 1, 1) == "s" and "smoker" or "grill"
	local idx = tonumber(string.sub(key, 2)) or 1
	if idx > s.slots[kind] then
		Panels.open("upgrades")
		return
	end
	local st = s.stations[key]
	if not st then
		Panels.open("cook", key)
		return
	end
	local _, _, done = Hud.view(st, s.boost)
	if done then
		if Net.act("Collect", key) then
			Sfx.play("popAiry", 0.95 + math.random() * 0.15)
		end
	elseif st.meat == "burger" and not st.flip then
		Net.act("Flip", key)
	end
end

local function layoutKey(s: any): string
	return s.slots.smoker .. ":" .. s.slots.grill
end

local function rebuildCards(s: any)
	UI.clear(refs.bar)
	cards = {}
	local order = 0
	for i = 1, Config.MAX_GRILLS do
		order += 1
		local key = "g" .. i
		cards[key] = makeCard(key, order)
		if i > s.slots.grill then
			cards[key].locked = true
		end
		if i > s.slots.grill then
			break
		end
	end
	for i = 1, Config.MAX_SMOKERS do
		order += 1
		local key = "s" .. i
		cards[key] = makeCard(key, order)
		if i > s.slots.smoker then
			cards[key].locked = true
			break
		end
	end
	cardLayoutKey = layoutKey(s)
end

local function showStatus(label: TextLabel, text: string)
	label.Text = text
	label.Visible = text ~= ""
end

function Hud.update()
	local s = Net.state
	if not s or not root then
		return
	end
	if layoutKey(s) ~= cardLayoutKey then
		rebuildCards(s)
	end
	local targetCoins = s.coins or 0
	if refs.shownCoins == nil then
		refs.shownCoins = targetCoins
	end
	local diff = targetCoins - refs.shownCoins
	if math.abs(diff) < 1 then
		refs.shownCoins = targetCoins
	else
		refs.shownCoins += diff * 0.35
	end
	local shownNow = math.floor(refs.shownCoins + 0.5)
	local coinPop = refs.lastCoin ~= nil and shownNow > refs.lastCoin
	refs.lastCoin = shownNow
	refs.coins.Text = UI.fmt(shownNow)
	local trailing = s.income or 0
	if type(s.earns) == "table" then
		trailing = Income.perSecond(s.earns, workspace:GetServerTimeNow(), Income.WINDOW)
	end
	local crewRate = s.ranchCrew and s.ranchCrew.rate or 0
	local rate = if crewRate > 0 then crewRate else trailing
	refs.income.TextSize = if refs.layout and refs.layout.compact then 20 else 32
	refs.income.Text = "+" .. Income.format(rate) .. "/s"
	if crewRate > 0 and not refs.pulsing and refs.rateScale then
		refs.pulsing = true
		refs.rateTween = TweenService:Create(refs.rateScale, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.22 })
		refs.rateTween:Play()
	elseif crewRate <= 0 and refs.pulsing and refs.rateScale then
		refs.pulsing = false
		if refs.rateTween then
			refs.rateTween:Cancel()
		end
		refs.rateScale.Scale = 1
	end
	if coinPop and refs.rateScale then
		refs.rateScale.Scale = 1.2
	end
	refs.aura.Text = UI.fmt(s.aura)
	local gift = s.freeGift
	refs.gift.Visible = gift ~= nil and gift.ready == true
	if gift and gift.ready then
		refs.gift.Text = "Gift " .. UI.fmt(gift.coins or 0)
	end
	local ranch = s.ranchCrew or {}
	local hireCost, hireName = nil, nil
	local hiring = s.hiring
	if hiring and type(hiring.applicants) == "table" and (ranch.used or 0) < (ranch.slots or 0) then
		for _, applicant in ipairs(hiring.applicants) do
			if not applicant.taken and applicant.price and (hireCost == nil or applicant.price < hireCost) then
				hireCost = applicant.price
				hireName = applicant.name
			end
		end
	end
	local pitCost = Economy.nextPitCost(Config.PitLevels, s.pitLevel)
	local nextPit = pitCost and Config.PitLevels[s.pitLevel + 1] or nil
	local rookieActive = s.rookie ~= nil and s.rookie.finished ~= true
	local guideOn = s.guide ~= nil and s.guide.active == true
	local goal = Goals.next({
		rookieActive = rookieActive,
		giftReady = gift ~= nil and gift.ready == true,
		coins = s.coins or 0,
		hireCost = hireCost,
		hireName = hireName,
		pitCost = pitCost,
		pitName = nextPit and nextPit.name or nil,
		crew = ranch.used or 0,
		crewSlots = ranch.slots or 3,
	})
	refs.goals.Visible = goal ~= nil and not guideOn
	local opts = Hud.layoutOptions()
	local layoutKey = (if opts.guide then "g" else "") .. (if opts.rookie then "r" else "") .. (if opts.goals then "o" else "")
	if refs.layoutKey ~= layoutKey then
		refs.layoutKey = layoutKey
		Hud.applyLayout()
	end
	if goal then
		refs.goalId = goal.id
		refs.goalAction = goal.action
		refs.goalTitle.Text = goal.title
		refs.goalDetail.Text = goal.detail
		refs.goalFill.Size = UDim2.fromScale(if goal.goal > 0 then math.clamp(goal.current / goal.goal, 0, 1) else 0, 1)
		refs.goalBtn.Text = if goal.action == "gift" then "Claim" elseif goal.id == "hire" then "Hire" elseif goal.action == "crew" then "Crew" else "Upgrade"
	end
	local rank = Config.Ranks[s.rank]
	refs.rank.Text = (s.title ~= "" and s.title or (rank and rank.name or ""))
	refs.cooler.Text = #s.cooler .. "/" .. Config.COOLER_MAX
	local now = workspace:GetServerTimeNow()
	local boostLeft = s.boost.untilT - now
	refs.boost.Parent.Visible = boostLeft > 0 and s.boost.mult > 1
	if boostLeft > 0 then
		refs.boost.Text = "x" .. s.boost.mult .. " " .. TimeUtil.formatDuration(boostLeft)
	end
	refs.btnDaily.Dot.Visible = s.canClaimDaily
	refs.btnPath.Dot.Visible = s.pathStatus.complete
	local rookieDone = s.rookie == nil or s.rookie.finished
	refs.btnShop.Dot.Visible = rookieDone and not s.boughtAny and s.onceBought ~= nil and not s.onceBought.StarterPitPack and s.productIds.products.StarterPitPack == true
	refs.serveAll.Text = "🍽️ Serve All" .. (#s.customers > 0 and (" (" .. #s.customers .. ")") or "")
	showStatus(refs.customers, #s.customers > 0 and (#s.customers .. " hungry critter" .. (#s.customers == 1 and "" or "s") .. " waiting") or "")
	if s.storm and s.storm.active and type(s.storm.banner) == "string" and s.storm.banner ~= "" then
		showStatus(refs.rush, s.storm.banner)
	elseif Config.Chores.lunchRush and s.rush then
		local ends, n, done = s.rush.ends, s.rush.n, s.rush.done
		if now >= ends then
			local P = Config.Rush.period
			ends, n, done = (math.floor(now / P) + 1) * P, 0, false
		end
		local left = math.max(0, math.floor(ends - now))
		local zoom = (s.dinnerUntil or 0) > now and "  🔔 Dinner Bell +25% tips" or ((s.potluckUntil or 0) > now and ("  " .. (s.potluckHud ~= nil and s.potluckHud ~= "" and s.potluckHud or "🦃 Potluck's full: +25% tips")) or "")
		showStatus(refs.rush, (done and "🍽️ Rush cleared! Next in " or string.format("🍽️ Lunch Rush %d/%d · ", n, s.rush.need)) .. TimeUtil.formatDuration(left) .. zoom)
	else
		local nowBell = workspace:GetServerTimeNow()
		local bell = (s.dinnerUntil or 0) > nowBell and "🔔 Dinner Bell +25% tips" or ((s.potluckUntil or 0) > nowBell and (s.potluckHud ~= nil and s.potluckHud ~= "" and s.potluckHud or "🦃 Potluck's full: +25% tips") or "")
		showStatus(refs.rush, bell)
	end
	showStatus(refs.combo, s.combo >= Config.Flip.lockedInAt and ("LOCKED IN 🔒 x" .. s.combo) or (s.combo > 0 and ("Flip combo x" .. s.combo) or ""))

	local firstCooking = false
	local anyDone = false
	for _, st in pairs(s.stations) do
		if st.meat == "firstbrisket" then
			firstCooking = true
		end
		local _, _, done = Hud.view(st, s.boost)
		anyDone = anyDone or done
	end
	refs.first.Visible = s.onboard == nil and not s.tutorial.firstBrisket and not firstCooking and s.stations.s1 == nil
	if refs.menuById then
		for id, button in pairs(refs.menuById) do
			button.Visible = Onboard.buttonOn(id, s.playSeconds or 0, s.menuAll == true)
		end
	end
	local hint = ""
	if not s.tutorial.done then
		if firstCooking and not anyDone then
			hint = "Your brisket is smoking low and slow. Grill a burger while you wait."
		elseif anyDone then
			hint = "It's ready. Tap Collect, then serve a critter."
		elseif #s.cooler > 0 then
			hint = "Tap Serve All, or walk up to a critter, to get paid."
		end
	end
	refs.hint.Text = hint
	refs.hint.Visible = hint ~= ""

	local grilling = false
	for key, st in pairs(s.stations) do
		if string.sub(key, 1, 1) == "g" and not st.burnt then
			local _, _, gdone = Hud.view(st, s.boost)
			grilling = grilling or not gdone
		end
	end
	local gtop: BasePart? = nil
	local map = workspace:FindFirstChild("Map")
	local plot = map and s.plot and map:FindFirstChild("Plots") and map.Plots:FindFirstChild("Plot" .. s.plot)
	local grill = plot and plot:FindFirstChild("Grill")
	local top = grill and grill:FindFirstChild("Top")
	if top and top:IsA("BasePart") then
		gtop = top
	end
	Sfx.setSizzle(grilling, gtop)

	for key, c in pairs(cards) do
		local kind = string.sub(key, 1, 1) == "s" and "smoker" or "grill"
		if c.locked then
			c.name.Text = "Locked"
			c.time.Text = "Unlock in Upgrades"
			c.fill.Size = UDim2.fromScale(0, 1)
			c.btn.Text = "Unlock"
			c.btn.BackgroundColor3 = T.card
			c.btn.TextColor3 = UI.labelOn(T.card)
			c.peek.Visible = false
			c.good.Visible = false
			c.perfect.Visible = false
		else
			local st = s.stations[key]
			if not st then
				c.name.Text = kind == "grill" and "Empty grill" or "Empty smoker"
				c.time.Text = kind == "grill" and "Burgers: 30s" or "Low and slow"
				c.fill.Size = UDim2.fromScale(0, 1)
				c.btn.Text = "Cook"
				c.btn.BackgroundColor3 = T.accent
				c.btn.TextColor3 = UI.labelOn(T.accent)
				c.peek.Visible = false
				c.good.Visible = false
				c.perfect.Visible = false
				c.stroke.Color = T.card
			else
				local meat = Config.Meats[st.meat]
				local frac, remaining, done, doneAt = Hud.view(st, s.boost)
				local rarName = ""
				if st.rarity then
					for _, r in ipairs(Config.Rarities) do
						if r.id == st.rarity then
							rarName = r.name .. " "
							c.stroke.Color = Color3.fromHex(r.color)
						end
					end
				else
					c.stroke.Color = T.card
				end
				c.name.Text = meat.icon .. " " .. rarName .. meat.name
				c.fill.Size = UDim2.fromScale(frac, 1)
				c.fill.BackgroundColor3 = done and T.green or T.accent
				local isBurger = st.meat == "burger"
				c.good.Visible = isBurger and not st.flip and not done
				c.perfect.Visible = isBurger and not st.flip and not done
				c.peek.Visible = Config.Chores.peekPenalty and kind == "smoker" and not done and st.rarity == nil
				if st.burnt then
					c.name.Text = "Burnt " .. meat.name
					c.time.Text = "Skill issue"
					c.btn.Text = "Toss"
					c.btn.BackgroundColor3 = T.red
					c.btn.TextColor3 = UI.labelOn(T.red)
				elseif done then
					if isBurger and doneAt then
						local burnIn = Config.BURGER_BURN_GRACE - (workspace:GetServerTimeNow() - doneAt)
						c.time.Text = burnIn > 0 and string.format("Grab it. Burns in %ds", math.ceil(burnIn)) or "Burning"
					else
						c.time.Text = "Ready to collect"
					end
					c.btn.Text = "Collect"
					c.btn.BackgroundColor3 = T.green
					c.btn.TextColor3 = UI.labelOn(T.green)
				else
					c.time.Text = TimeUtil.formatDuration(remaining) .. " left"
					if isBurger and not st.flip then
						c.btn.Text = "FLIP!"
						local F = Config.Flip
						local near = math.abs(frac - F.target) <= F.perfectWindow
						local fillColor = near and T.gold or T.blue
						c.btn.BackgroundColor3 = fillColor
						c.btn.TextColor3 = UI.labelOn(fillColor)
					else
						c.btn.Text = st.flip and ("Flipped: " .. st.flip) or "Smoking..."
						c.btn.BackgroundColor3 = T.card
						c.btn.TextColor3 = UI.labelOn(T.card)
					end
				end
			end
		end
		c.name.Size = UDim2.new(1, c.peek.Visible and -48 or 0, 0, 40)
	end
end

function Hud.smokerPosition(key: string): Vector3?
	local s = Net.state
	if not s or not s.plot then
		return nil
	end
	local map = workspace:FindFirstChild("Map")
	local plot = map and map:FindFirstChild("Plots") and map.Plots:FindFirstChild("Plot" .. s.plot)
	local sm = plot and plot.Smokers:FindFirstChild(key)
	local barrel = sm and sm:FindFirstChild("Barrel") :: BasePart?
	return barrel and barrel.Position or nil
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="88">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry: builds the whole UI in code and connects server pushes to it.
-- A module that throws must not skip the "ask again for my snapshot" loop, or the
-- panel stays on "Your ranch is still loading" after a missed first push.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function tryRequire(mod: ModuleScript, name: string): any
	-- pcall(require, mod) instead of require(mod): a thrown module must not kill the
	-- snapshot retry that was already spawned, and the path is not a literal require().
	local ok, result = pcall(require, mod)
	if not ok then
		warn("[Client] " .. name .. " failed to load:\n" .. tostring(result))
		return nil
	end
	return result
end

-- Net is required directly so a later module can throw without taking the retry with it.
local Net = require(script.Parent.Net)

-- Keep asking until a snapshot arrives. The server also pushes on load; this covers
-- a push that landed before this client was listening, and a load that finished late.
-- Spawned before the other requires: if one of those throws, this loop is already running.
task.spawn(function()
	local pause = 1.5
	while not Net.state do
		task.wait(pause)
		if Net.state then
			break
		end
		pcall(function(): nil
			Net.pull()
			return nil
		end)
		pause = math.min(pause * 1.4, 8)
	end
end)

local UI = tryRequire(script.Parent.UI, "UI")
local Fx = tryRequire(script.Parent.Fx, "Fx")
local Hud = tryRequire(script.Parent.Hud, "Hud")
local Panels = tryRequire(script.Parent.Panels, "Panels")
local WorldClient = tryRequire(script.Parent.WorldClient, "WorldClient")
local Ambient = tryRequire(script.Parent.Ambient, "Ambient")
local CrewAnim = tryRequire(script.Parent.CrewAnim, "CrewAnim")
local Sfx = tryRequire(script.Parent.Sfx, "Sfx")
local Music = tryRequire(script.Parent.Music, "Music")
local RookieGuide = tryRequire(script.Parent.RookieGuide, "RookieGuide")
local GuideHint = tryRequire(script.Parent.GuideHint, "GuideHint")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = tryRequire(Shared:WaitForChild("Config") :: ModuleScript, "Config")
local Content = tryRequire(Shared:WaitForChild("Content") :: ModuleScript, "Content")
if not (UI and Fx and Hud and Panels and Sfx and Music and RookieGuide and GuideHint and Config and Content) then
	warn("[Client] UI did not finish loading. The snapshot retry is still running.")
	return
end

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screen = UI.new("ScreenGui", { Name = "BackyardSmokeout", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })
do
	local applied = pcall(function()
		local insets = (Enum :: any).ScreenInsets
		if insets and insets.CoreUISafeInsets then
			(screen :: any).ScreenInsets = insets.CoreUISafeInsets
			local compat = (Enum :: any).SafeAreaCompatibility
			if compat and compat.None then
				(screen :: any).SafeAreaCompatibility = compat.None
			end
			screen.IgnoreGuiInset = true
			screen:SetAttribute("SafeInsets", true)
		end
	end)
	if not applied then
		screen:SetAttribute("SafeInsets", false)
	end
end
-- Text stays full size on phones. Layouts reflow (Hud.applyLayout, Panels.applyLayout)
-- instead of shrinking every letter with a UIScale. CoreUISafeInsets keeps the
-- notch and the home indicator outside this screen. If that enum is missing,
-- the leftover bottom and side insets are padded by hand.
local root = UI.new("Frame", { Name = "Root", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = screen })
local function safeInsets(): { left: number, top: number, right: number, bottom: number }
	if screen:GetAttribute("SafeInsets") == true then
		return { left = 0, top = 0, right = 0, bottom = 0 }
	end
	local topLeft = Vector2.zero
	local bottomRight = Vector2.zero
	pcall(function()
		local a, b = GuiService:GetGuiInset()
		if typeof(a) == "Vector2" then
			topLeft = a
		end
		if typeof(b) == "Vector2" then
			bottomRight = b
		end
	end)
	return {
		left = math.max(0, topLeft.X),
		top = 0,
		right = math.max(0, bottomRight.X),
		bottom = math.max(0, bottomRight.Y),
	}
end
local function rescale()
	local v = root.AbsoluteSize
	if v.X < 80 or v.Y < 80 then
		local cam = workspace.CurrentCamera
		v = cam and cam.ViewportSize or Vector2.new(1280, 720)
	end
	UI.setViewport(v)
	UI.setInsets(safeInsets())
	Hud.applyLayout()
	Panels.applyLayout()
	RookieGuide.applyLayout()
	GuideHint.applyLayout()
end

Sfx.mount()
Music.mount()
UI.onClick = function()
	Sfx.play("click", nil, 0.05)
end
Fx.mount(root)
Panels.mount(root)
Hud.mount(root, Panels)
RookieGuide.mount(root)
GuideHint.mount(root)
rescale()
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
end
Net.notify = Fx.toast
if WorldClient then
	local okWorld, errWorld = xpcall(function()
		WorldClient.start(Panels)
	end, debug.traceback)
	if not okWorld then
		warn("[Client] WorldClient.start failed:\n" .. tostring(errWorld))
	end
end
if Ambient then
	task.spawn(function()
		local okAmbient, errAmbient = xpcall(Ambient.start, debug.traceback)
		if not okAmbient then
			warn("[Client] Ambient.start failed:\n" .. tostring(errAmbient))
		end
	end)
end
if CrewAnim and CrewAnim.start then
	task.spawn(function()
		local okCrew, errCrew = xpcall(CrewAnim.start, debug.traceback)
		if not okCrew then
			warn("[Client] CrewAnim.start failed:\n" .. tostring(errCrew))
		end
	end)
end

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

Net.on("toast", function(p)
	Fx.toast(p.text, p.kind)
end)
Net.on("announce", function(p)
	Fx.announce(p.text, p.color)
end)
Net.on("dialog", function(p)
	Panels.dialog(p)
end)
Net.on("welcome", function(p)
	task.wait(1)
	Panels.welcome(p)
end)
Net.on("fx", function(p)
	local d = p.data or {}
	if p.kind == "reveal" then
		Fx.reveal(d.meat, d.rarity, d.aura or 0, Hud.smokerPosition("s1"))
	elseif p.kind == "flip" then
		Fx.flip(d.result, d.combo or 0, d.lockedIn)
	elseif p.kind == "served" then
		Fx.coins(d.value or 0)
		if (d.aura or 0) > 0 then
			task.delay(0.4, function()
				Fx.pop("+" .. d.aura .. " AURA", Color3.fromHex("#B48CFF"), 30)
			end)
		end
	elseif p.kind == "snagged" then
		Fx.pop(Content.Slang.snagged .. " Tag " .. tostring(d.by) .. " back!", UI.Theme.red, 34)
	elseif p.kind == "bell" then
		Fx.pop("🔔 CLANG!", Color3.fromHex("#FFC83C"), 40)
		Fx.ringBell()
	elseif p.kind == "dinnerbell" then
		Fx.dinnerBell()
	elseif p.kind == "sixseven" then
		task.delay(0.5, function()
			Fx.pop(Content.Slang.sixSeven, Color3.fromHex("#FFC83C"), 54)
		end)
	elseif p.kind == "rush" then
		Sfx.play("coins")
		Fx.pop(Content.Slang.rush .. " +" .. tostring(d.bonus or 0), Color3.fromHex("#6CC24A"), 40)
	elseif p.kind == "swat" then
		Sfx.play("swat", d.queen and 0.8 or 0.9 + math.random() * 0.2, 0.08)
		Fx.pop(d.queen and "👑 QUEEN DOWN!" or "SWAT!", UI.Theme.gold, d.queen and 44 or 26)
	elseif p.kind == "rookie" then
		Fx.rookie(d)
	elseif p.kind == "gift" then
		Sfx.play("fanfare")
		Fx.pop("🎁 A gift from " .. tostring(d.from) .. "!", Color3.fromHex("#FF8FAB"), 40)
	elseif p.kind == "champ" then
		Sfx.play("fanfare")
		Fx.pop(tostring(d.medal) .. " Cook-Off Champ!", UI.Theme.gold, 40)
	elseif p.kind == "howdy" then
		Fx.howdy(d)
	elseif p.kind == "freegift" then
		Sfx.play("coins")
		Sfx.play("ding", 1.15)
		Fx.coins(d.value or 0)
	elseif p.kind == "hired" then
		Sfx.play("fanfare", 1.05)
		Fx.pop((d.name or "Crew") .. " clocked in!", UI.Theme.gold, 36)
	elseif p.kind == "levelup" then
		Sfx.play("fanfare")
		Fx.pop(tostring(d.text or "Level up!"), UI.Theme.gold, 36)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.1)
		local ok, err = pcall(function(): any
			Hud.update()
			RookieGuide.update(Net.state)
			GuideHint.update(Net.state)
			if Net.state and Net.state.settings then
				local want = Net.state.settings.sfx ~= false
				if want ~= Sfx.isEnabled() then
					Sfx.setEnabled(want)
				end
				Music.apply(Net.state.settings)
			end
			return nil
		end)
		if not ok then
			warn("[Hud] " .. tostring(err))
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Music</string>
            <string name="Source"><![CDATA[--!strict
-- One looping music bed, separate from sound effects.
-- Mute and volume are saved on the ranch. The default is quiet.
-- If Music.id is 0, nothing is loaded and nothing plays.
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Track = require(Shared.Music)
local MusicPrefs = require(Shared.Logic.MusicPrefs)

local Music = {}
local group: SoundGroup? = nil
local bed: Sound? = nil
local playing = false

function Music.trackId(): number
	local id = (Track :: any).id
	return if type(id) == "number" then id else 0
end

function Music.available(): boolean
	return MusicPrefs.audible(Music.trackId())
end

function Music.mount()
	local g = Instance.new("SoundGroup")
	g.Name = "BackyardMusic"
	g.Volume = MusicPrefs.DEFAULT_VOLUME
	g.Parent = SoundService
	group = g
	local s = Instance.new("Sound")
	s.Name = "PorchLight"
	s.Looped = true
	s.Volume = 1
	s.SoundGroup = g
	s.Parent = g
	bed = s
	if Music.available() then
		s.SoundId = "rbxassetid://" .. tostring(Music.trackId())
	end
end

-- Apply saved prefs. Calling this every frame does not stack another copy.
function Music.apply(settings: any)
	local g = group
	local s = bed
	if not g or not s then
		return
	end
	local on, volume = MusicPrefs.read(settings)
	g.Volume = volume
	local shouldPlay = on and volume > 0 and Music.available()
	if not shouldPlay then
		if s.IsPlaying then
			s:Stop()
		end
		playing = false
		return
	end
	if playing and s.IsPlaying then
		return
	end
	if s.IsPlaying then
		return
	end
	s.SoundId = "rbxassetid://" .. tostring(Music.trackId())
	s.Looped = true
	s:Play()
	playing = true
end

return Music
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client networking: one RemoteFunction for requests, one RemoteEvent for server pushes.
-- Remotes are created by the server script. Waiting forever here used to freeze the client
-- before any UI existed if that script was still starting (or had died before creating them).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)

local Net = {}
Net.state = nil :: any
-- Not a BindableEvent: those copy the snapshot, so listeners would not see Net.state.
Net.changed = Signal.new()
Net.notify = function(_text: string, _kind: string?) end
local handlers: { [string]: { (any) -> () } } = {}
local action: RemoteFunction? = nil
local push: RemoteEvent? = nil
local listening = false

local function onPush(kind: string, payload: any)
	if kind == "state" then
		Net.state = payload
		Net.changed:Fire(payload)
	end
	local list = handlers[kind]
	if list then
		for _, fn in ipairs(list) do
			task.spawn(fn, payload)
		end
	end
end

local function ensure(): boolean
	if action and push then
		return true
	end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		return false
	end
	local a = folder:FindFirstChild("Action")
	local p = folder:FindFirstChild("Push")
	if not a or not a:IsA("RemoteFunction") or not p or not p:IsA("RemoteEvent") then
		return false
	end
	local remote = p :: RemoteEvent
	action = a :: RemoteFunction
	push = remote
	if not listening then
		listening = true
		remote.OnClientEvent:Connect(onPush)
	end
	return true
end

function Net.ready(): boolean
	return ensure()
end

function Net.on(kind: string, fn: (any) -> ())
	handlers[kind] = handlers[kind] or {}
	table.insert(handlers[kind], fn)
end

-- Ask the server to do something. Shows the server's message as a toast.
function Net.act(name: string, a: any?, b: any?, c: any?): (boolean, string?)
	if not ensure() or not action then
		Net.notify("Connection hiccup. Try again!", "bad")
		return false, nil
	end
	local fn = action :: RemoteFunction
	local ok, res = pcall(function()
		return fn:InvokeServer(name, a, b, c)
	end)
	if not ok or type(res) ~= "table" then
		Net.notify("Connection hiccup. Try again!", "bad")
		return false, nil
	end
	if res.msg then
		Net.notify(res.msg, res.ok and "good" or "info")
	end
	return res.ok == true, res.msg
end

-- Quiet "please send my snapshot" used when the first push was missed.
-- Does not toast. Returns true only when the server accepted it.
function Net.pull(): boolean
	if not ensure() or not action then
		return false
	end
	local fn = action :: RemoteFunction
	local ok, res = pcall(function()
		return fn:InvokeServer("Hello")
	end)
	return ok and type(res) == "table" and res.ok == true
end

ensure()
ReplicatedStorage.ChildAdded:Connect(function(child)
	if child.Name == "Remotes" then
		ensure()
	end
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--!strict
-- All pop-up windows: Pit Shop, Sauce Shack, Index, Pitmaster Path, Upgrades, Daily, Settings,
-- the cook picker, NPC dialogs and the welcome card.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Monetization = require(Shared.Monetization)
local MusicTrack = require(Shared.Music)
local MusicPrefs = require(Shared.Logic.MusicPrefs)
local Rarity = require(Shared.Logic.Rarity)
local Restock = require(Shared.Logic.Restock)
local Economy = require(Shared.Logic.Economy)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Holiday = require(Shared.Logic.Holiday)
local Gifting = require(Shared.Logic.Gifting)
local HudMenu = require(Shared.Logic.HudMenu)
local ShopCatalog = require(Shared.Logic.ShopCatalog)
local Storefront = require(Shared.Logic.Storefront)
local Rookie = require(Shared.Logic.Rookie)
local Income = require(Shared.Logic.Income)
local Streak = require(Shared.Logic.Streak)
local T = UI.Theme

local player = Players.LocalPlayer
local Panels = {}
local screen: GuiObject = nil :: any
local window: Frame = nil :: any
local titleLabel: TextLabel = nil :: any
local body: Frame = nil :: any
local current: string? = nil
local currentArg: any = nil
local tabState: { [string]: string } = {}
local lastRender = 0
local sauceOdds: { [string]: number }? = nil
local freshOpen = false
local loggedTab: string? = nil

local EGGS = {
	{ id = "blessed", hint = "Sunday folks set a table by the hub. Look closely at what's on it." },
	{ id = "roof", hint = "The Sauce Shack roof has a sign-in sheet. Bounce your way up." },
	{ id = "creek", hint = "There's a gap in the hedge behind the ranches. Listen to the stones." },
	{ id = "apron", hint = "Somebody's Unc left an apron by the water." },
	{ id = "king", hint = "The King of the Pit has a gift for a pitmaster in a proper hat, after dark." },
	{ id = "temp", hint = "Temp gets nervous if you keep poking him." },
	{ id = "rex", hint = "Meet enough regulars and someone special visits. RAWR!" },
	{ id = "meteorite", hint = "Cook the rarest cut there is." },
	{ id = "cooked", hint = "Make Granny Pecan say you COOKED." },
	{ id = "sixseven", hint = "Some tips just hit different. Watch the last two digits." },
	{ id = "dinnerbell", hint = "Big Bertha's bell is loudest with a crowd. Bring two friends and ring it together." },
}

local function S(): any
	return Net.state
end

-- ===== window chrome =====
function Panels.mount(sg: GuiObject)
	screen = sg
	window = UI.frame({ Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 840, 0, 560), BackgroundColor3 = T.bg, Visible = false, ZIndex = 40, Parent = screen })
	UI.corner(window, 18)
	UI.stroke(window, T.accent, 3)
	titleLabel = UI.label("", { Position = UDim2.new(0, 20, 0, 12), Size = UDim2.new(1, -84, 0, 40), TextSize = 30, ZIndex = 21, Parent = window })
	UI.button("✕", T.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.new(0, 48, 0, 48), TextSize = 24, ZIndex = 22, Parent = window }, function()
		Panels.close()
	end)
	body = UI.frame({ Name = "Body", BackgroundTransparency = 1, Position = UDim2.new(0, 16, 0, 68), Size = UDim2.new(1, -32, 1, -84), ZIndex = 21, Parent = window })
	Panels.applyLayout()
	Net.changed.Event:Connect(function()
		if current and current ~= "dialog" and current ~= "welcome" and os.clock() - lastRender > 0.75 then
			Panels.render()
		end
	end)
end

function Panels.applyLayout()
	if not window then
		return
	end
	local v = UI.viewport
	local margin = if UI.compact then 10 else 36
	local w = math.clamp(v.X - margin * 2, 320, 980)
	local h = math.clamp(v.Y - margin * 2, 300, 680)
	window.Size = UDim2.fromOffset(w, h)
	titleLabel.TextSize = if UI.compact then 22 else 30
end

function Panels.close()
	current = nil
	window.Visible = false
end

function Panels.open(name: string, arg: any?)
	if name == "invite" then
		Panels.invite()
		return
	end
	current = name
	currentArg = arg
	freshOpen = true
	window.Visible = true
	Panels.render()
end

function Panels.toggle(name: string)
	local nextName, invite = HudMenu.press(current, name)
	if invite then
		Panels.invite()
		return
	end
	if nextName == nil then
		Panels.close()
		return
	end
	Panels.open(nextName)
end

function Panels.goHome()
	local s = S()
	local char = player.Character
	local map = workspace:FindFirstChild("Map")
	if not s or not s.plot or not char or not map then
		return
	end
	local plot = map.Plots:FindFirstChild("Plot" .. s.plot)
	local pad = plot and plot:FindFirstChild("SpawnPad") :: BasePart?
	if pad then
		char:PivotTo(pad.CFrame + Vector3.new(0, 4, 0))
	end
end

function Panels.invite()
	local ok, can = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if ok and can then
		pcall(function()
			local opts = Instance.new("ExperienceInviteOptions")
			opts.PromptMessage = "Help me ring Big Bertha's dinner bell! 3 rings = bonus tips for the whole server 🔔"
			opts.LaunchData = "bertha"
			SocialService:PromptGameInvite(player, opts)
		end)
	else
		Net.notify("Invites aren't available here. Share the game link with your friends! (Friends in the same server give a crew bonus.)", "info")
	end
end

local function scroller(parent: Instance, grid: boolean?, cell: Vector2?): ScrollingFrame
	local sf = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 21,
		Parent = parent,
	})
	if grid then
		UI.new("UIGridLayout", { CellSize = UDim2.new(0, (cell or Vector2.new(170, 220)).X, 0, (cell or Vector2.new(170, 220)).Y), CellPadding = UDim2.new(0, 10, 0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sf })
	else
		UI.list(sf, nil, 8)
	end
	UI.pad(sf, 4)
	return sf
end

local function tabs(parent: Instance, key: string, names: { string }, default: string): (string, Frame)
	local sel = tabState[key] or default
	local row = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 52),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 6,
		ZIndex = 21,
		Parent = parent,
	})
	UI.list(row, Enum.FillDirection.Horizontal, 8)
	for i, n in ipairs(names) do
		UI.button(n, n == sel and T.accent or T.card, { Size = UDim2.new(0, math.max(96, #n * 12 + 36), 0, 44), TextSize = 18, LayoutOrder = i, ZIndex = 22, Parent = row }, function()
			tabState[key] = n
			Panels.render()
		end)
	end
	local content = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 60), Size = UDim2.new(1, 0, 1, -60), ZIndex = 21, Parent = parent })
	return sel, content
end

local function card(parent: Instance, order: number, h: number?): Frame
	local f = UI.frame({ BackgroundColor3 = T.card, Size = UDim2.new(1, -8, 0, h or 70), LayoutOrder = order, ZIndex = 22, Parent = parent })
	UI.corner(f, 12)
	UI.pad(f, 10)
	return f
end

local function lbl(parent: Instance, text: string, props: any?): TextLabel
	local p = props or {}
	p.ZIndex = p.ZIndex or 23
	p.Parent = parent
	local l = UI.label(text, p)
	return l
end

local function btn(parent: Instance, text: string, color: Color3?, props: any?, fn: (() -> ())?): TextButton
	local p = props or {}
	p.ZIndex = p.ZIndex or 24
	p.Parent = parent
	return UI.button(text, color, p, fn)
end

-- ===== Pit Shop (Robux) =====
local function ownsAll(s: any, grants: { string }?): boolean
	if not grants then
		return false
	end
	for _, id in ipairs(grants) do
		if not s.owned[id] then
			return false
		end
	end
	return true
end

local function shopCell(): Vector2
	local width = window.AbsoluteSize.X
	if width < 8 then
		width = window.Size.X.Offset
	end
	local inner = math.max(280, width - 48)
	if inner < 520 then
		return Vector2.new(inner - 16, 300)
	end
	return Vector2.new(220, 312)
end

local function shopCard(parent: Instance, order: number, kind: string, key: string, item: any, s: any)
	-- Listed even when the Roblox id is still 0. Hiding those cards is what left
	-- the Outfitters blank on a live server before the ids were published.
	local f = UI.frame({ BackgroundColor3 = T.card, LayoutOrder = order, ZIndex = 22, Parent = parent })
	UI.corner(f, 14)
	UI.pad(f, 10)
	local col = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 23, Parent = f })
	local lay = UI.list(col, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	lay.VerticalAlignment = Enum.VerticalAlignment.Top
	lbl(col, item.icon, { Size = UDim2.new(1, 0, 0, 40), TextSize = 34, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1 })
	lbl(col, item.name, { Size = UDim2.new(1, 0, 0, 48), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2 })
	lbl(col, item.desc, { Size = UDim2.new(1, 0, 0, 72), TextSize = 16, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 3 })
	if item.valueNote then
		lbl(col, item.valueNote, { Size = UDim2.new(1, 0, 0, 36), TextSize = 15, Font = T.body, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 4 })
	end
	local owned = false
	if kind == "pass" then
		owned = s.passes[key] == true
	elseif item.kind == "cosmetic" or item.kind == "bundle" then
		owned = ownsAll(s, item.grants)
		local have = Storefront.ownedCount(s.owned, item.grants)
		if item.kind == "bundle" and not owned and have > 0 then
			-- honest heads-up: the bundle price doesn't change if you already own some of it
			lbl(col, string.format("Own %d/%d", have, #(item.grants :: any)), { Size = UDim2.new(1, 0, 0, 22), TextSize = 15, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 5 })
		end
	elseif item.once then
		owned = s.onceBought ~= nil and s.onceBought[key] == true
	end
	local studio = s.productIds ~= nil and s.productIds.studio == true
	local state = ShopCatalog.saleState(item.id, studio, owned)
	local text = ShopCatalog.robuxLabel(state, item.price)
	local canBuy = state == "buy" or state == "studio"
	local canGift = canBuy and kind == "product" and Gifting.giftable(item)
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 8, ZIndex = 23, Parent = col })
	if canGift then
		-- Gift it to someone in the server (looks only). Shows held gifts that can go out free.
		local held = s.giftsHeld and s.giftsHeld[key] or 0
		btn(row, held > 0 and ("🎁 " .. held) or "🎁", T.gift, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 56, 0, 44), TextSize = 18 }, function()
			Panels.open("gift", key)
		end)
	end
	btn(row, text, (state == "owned" or state == "soon") and T.cardHi or T.green, { Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, canGift and -64 or 0, 0, 44), TextSize = 16, AutoButtonColor = canBuy }, function()
		if canBuy then
			Net.act("Prompt", kind, key)
		end
	end)
	return true
end

local function infoCard(parent: Instance, order: number, icon: string, name: string, desc: string, note: string?, label: string, color: Color3, fn: (() -> ())?)
	local f = UI.frame({ BackgroundColor3 = T.card, LayoutOrder = order, ZIndex = 22, Parent = parent })
	UI.corner(f, 14)
	UI.pad(f, 10)
	local col = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 23, Parent = f })
	UI.list(col, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	lbl(col, icon, { Size = UDim2.new(1, 0, 0, 40), TextSize = 34, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1 })
	lbl(col, name, { Size = UDim2.new(1, 0, 0, 48), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2 })
	lbl(col, desc, { Size = UDim2.new(1, 0, 0, 72), TextSize = 16, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 3 })
	if note then
		lbl(col, note, { Size = UDim2.new(1, 0, 0, 40), TextSize = 15, Font = T.body, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 4 })
	end
	btn(col, label, color, { Size = UDim2.new(1, 0, 0, 44), TextSize = 16, LayoutOrder = 8, AutoButtonColor = fn ~= nil }, fn)
	return f
end

local function byPrice(keys: { string })
	table.sort(keys, function(a, b)
		local pa, pb = Monetization.Products[a], Monetization.Products[b]
		if (pa.once == true) ~= (pb.once == true) then
			return pa.once == true -- the one-time pack goes first
		end
		return pa.price < pb.price
	end)
end

local function renderShop(s: any)
	titleLabel.Text = "🛒 Pitmaster Outfitters"
	local sel, content = tabs(body, "shop", Monetization.ShopTabs, "Passes")
	-- analytics only (Roblox funnel: opened shop -> opened a tab -> tapped buy -> bought)
	if freshOpen then
		loggedTab = nil
		task.spawn(Net.act, "ShopView", "")
	end
	if loggedTab ~= sel then
		loggedTab = sel
		task.spawn(Net.act, "ShopView", sel)
	end
	local sf = scroller(content, true, shopCell())
	local n = 0
	-- the event look set that's on sale right now (Turkey Day or Holiday), if any
	local event, eventEnds, eventName, eventFree = nil, "", "", ""
	if s.turkey and s.turkey.active then
		event, eventEnds, eventName, eventFree = "turkeyday", s.turkey.ends, "Turkey Day", "The potluck apron stays free."
	elseif s.holiday and s.holiday.active then
		event, eventEnds, eventName, eventFree = "holiday", s.holiday.ends, "Holiday", "The Merry & Smoky Apron stays free."
	end
	if sel == "Passes" then
		local keys = {}
		for k in pairs(Monetization.Passes) do
			table.insert(keys, k)
		end
		table.sort(keys, function(a, b)
			return Monetization.Passes[a].price < Monetization.Passes[b].price
		end)
		for i, k in ipairs(keys) do
			shopCard(sf, i, "pass", k, Monetization.Passes[k], s)
			n += 1
		end
		local m = s.member or {}
		local club = Monetization.Subscriptions.PitCrewClub
		local clubStudio = s.productIds ~= nil and s.productIds.studio == true
		local clubSoon = club.id == "" and not clubStudio and not m.club
		n += 1
		infoCard(sf, 100, club.icon, club.name, "A new look every month (yours to keep), a Pit Crew tag, a daily Smoke Shower for your server and 1 free Season tier a month. No coins.", clubSoon and "Coming soon" or (club.id == "" and "Studio test" or "$4.99 a month. Cancel any time."), m.club and "Member ✓" or (clubSoon and "Coming soon" or (club.id == "" and "Studio test (free)" or "Join the Club")), m.club and T.cardHi or (clubSoon and T.cardHi or T.green), (not m.club and not clubSoon) and function()
			Net.act("Subscribe")
		end or nil)
		n += 1
		local prem = Monetization.Premium
		infoCard(sf, 101, prem.icon, prem.name, prem.desc, nil, m.premium and "Premium ✓" or "Learn about Premium", m.premium and T.cardHi or T.blue, (not m.premium) and function()
			Net.act("PremiumInfo")
		end or nil)
		n += 1
		infoCard(sf, 102, "🏠", "Private Ranch Server", Monetization.PrivateServer.desc, m.host and "You're hosting this server!" or nil, m.host and "Host ✓" or "How to get one", m.host and T.cardHi or T.card, function()
			Net.notify("On the game's page, open Servers and tap Create Private Server. A grown-up can help with the purchase.", "info")
		end)
	else
		local keys = {}
		for k, p in pairs(Monetization.Products) do
			if Monetization.tabFor(p) == sel and not (p.once and s.onceBought and s.onceBought[k]) then
				table.insert(keys, k)
			end
		end
		byPrice(keys)
		if sel == "Looks" and s.seasonPass and s.seasonPass.active then
			local sp = s.seasonPass
			n += 1
			infoCard(sf, 0, sp.icon, "Smokehouse Pass", string.format("Season %d: %s. Free and pass tracks of looks and titles. You're on tier %d of %d.", sp.number, sp.name, sp.tier, sp.max), sp.starts .. " to " .. sp.ends, "See the season", T.accent, function()
				Panels.open("season")
			end)
		end
		for i, k in ipairs(keys) do
			shopCard(sf, i, "product", k, Monetization.Products[k], s)
			n += 1
		end
	end
	if n == 0 then
		lbl(sf, "Nothing here yet. Check back soon!", { Size = UDim2.new(0, 400, 0, 30) })
	end
	local foot = "Every purchase shows exactly what you get. No random items, ever. Tap 🎁 to gift a look to someone in your server."
	if sel == "Looks" then
		foot = event and (eventName .. " looks are here through " .. eventEnds .. " and return next year. " .. eventFree) or "Looks only. Nothing here changes coins, traits, or odds."
	elseif sel == "Crew" then
		foot = "Crew boosts and outfits. Double crew income lasts 30 minutes and does not change trait odds."
	elseif sel == "Passes" then
		foot = "Passes are yours forever. The Pit Crew Club and Premium are monthly and give looks and friendly perks, never coins."
	end
	content.Size = UDim2.new(1, 0, 1, -116)
	lbl(body, foot, { Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 44), TextSize = 16, Font = T.body, TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Center })
end

-- ===== Smokehouse Pass (season) =====
local SLOT_ICON = { hat = "🤠", apron = "🦺", tool = "🥄", neck = "🧣", buddy = "🦝", trail = "✨", skin = "🔥", smoke = "💨", feet = "🧦", patio = "💡" }

local function seasonCell(parent: Instance, y: number, reward: any?, reached: boolean, locked: boolean, paidRow: boolean)
	local f = UI.frame({ BackgroundColor3 = reward and (reached and (locked and T.panel or T.cardHi) or T.card) or T.panel, BackgroundTransparency = reward and 0 or 0.6, Position = UDim2.new(0, 0, 0, y), Size = UDim2.new(1, 0, 0, 96), ZIndex = 23, Parent = parent })
	UI.corner(f, 10)
	if paidRow and reward then
		UI.stroke(f, T.gold, reached and not locked and 2 or 1)
	end
	if not reward then
		return
	end
	local icon, name = "🏷️", ""
	if reward.cosmetic then
		local def = Config.Cosmetics[reward.cosmetic]
		icon = def and SLOT_ICON[def.slot] or "🎁"
		name = def and def.name or reward.cosmetic
	else
		name = '"' .. tostring(reward.title) .. '"'
	end
	lbl(f, icon, { Position = UDim2.new(0, 0, 0, 4), Size = UDim2.new(1, 0, 0, 34), TextSize = 28, ZIndex = 24, TextXAlignment = Enum.TextXAlignment.Center })
	lbl(f, name, { Position = UDim2.new(0, 4, 0, 40), Size = UDim2.new(1, -8, 0, 36), TextSize = 12, Font = T.body, ZIndex = 24, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top })
	local status = reached and (locked and "🔒 pass" or "✓ yours") or ""
	if status ~= "" then
		lbl(f, status, { Position = UDim2.new(0, 0, 1, -20), Size = UDim2.new(1, 0, 0, 16), TextSize = 11, ZIndex = 24, TextColor3 = locked and T.dim or T.green, TextXAlignment = Enum.TextXAlignment.Center })
	end
end

local function renderSeason(s: any)
	local sp = s.seasonPass
	titleLabel.Text = "🎟️ Smokehouse Pass"
	if not sp or not sp.active then
		lbl(body, "The next season starts " .. ((sp and sp.nextLabel) or "soon") .. ". The Pitmaster Path and the weekly looks keep going in the meantime.", { Size = UDim2.new(1, 0, 0, 60), TextSize = 18 })
		return
	end
	local def
	for _, d in ipairs(Config.SeasonPass.seasons) do
		if d.id == sp.id then
			def = d
		end
	end
	if not def then
		return
	end
	local side = if UI.compact then 0 else -248
	local headY = if UI.compact then 56 else 0
	lbl(body, string.format("%s Season %d: %s", sp.icon, sp.number, sp.name), { Position = UDim2.new(0, 0, 0, headY), Size = UDim2.new(1, side, 0, 32), TextSize = 22, TextColor3 = T.gold })
	local sub = sp.need > 0 and string.format("%s to %s  •  Tier %d of %d  •  %d / %d XP to the next tier", sp.starts, sp.ends, sp.tier, sp.max, sp.into, sp.need) or string.format("%s to %s  •  Top tier reached. Nice smokin'.", sp.starts, sp.ends)
	lbl(body, sub, { Position = UDim2.new(0, 0, 0, headY + 32), Size = UDim2.new(1, side, 0, 36), TextSize = 16, Font = T.body, TextColor3 = T.dim })
	local barY = headY + 72
	local _, fill = UI.bar(body, T.gold, { Position = UDim2.new(0, 0, 0, barY), Size = UDim2.new(1, side, 0, 12), ZIndex = 22 })
	fill.ZIndex = 23
	fill.Size = UDim2.fromScale(sp.need > 0 and math.clamp(sp.into / sp.need, 0, 1) or 1, 1)
	local pass = Monetization.Products.SeasonPass
	local studio = s.productIds ~= nil and s.productIds.studio == true
	local passState = ShopCatalog.saleState(pass.id, studio, sp.paid == true)
	local passSize = { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(if UI.compact then 1 else 0, if UI.compact then 0 else 240, 0, 48), TextSize = if passState == "buy" then 16 else 15 }
	if passState == "owned" then
		btn(body, "Pass owned", T.cardHi, passSize)
	else
		local passText = if passState == "buy" then "Get the pass  R$ " .. pass.price elseif passState == "studio" then "Get the pass (Studio test)" else "Coming soon"
		btn(body, passText, passState == "soon" and T.cardHi or T.green, passSize, function()
			if passState ~= "soon" then
				Net.act("Prompt", "product", "SeasonPass")
			end
		end)
	end
	-- the two tracks
	local trackTop = (if UI.compact then 56 else 0) + 96
	local rows = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, trackTop), Size = UDim2.new(0, 64, 1, -(trackTop + 116)), ZIndex = 22, Parent = body })
	lbl(rows, "FREE", { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 96), TextSize = 15, TextColor3 = T.text })
	lbl(rows, "PASS", { Position = UDim2.new(0, 0, 0, 126), Size = UDim2.new(1, 0, 0, 96), TextSize = 15, TextColor3 = T.gold })
	local track = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 68, 0, trackTop), Size = UDim2.new(1, -68, 1, -(trackTop + 116)), AutomaticCanvasSize = Enum.AutomaticSize.XY, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.XY, ScrollBarThickness = 8, ZIndex = 22, Parent = body })
	UI.list(track, Enum.FillDirection.Horizontal, 6)
	for i = 1, sp.max do
		local reached = i <= sp.tier
		local col = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(0, 104, 0, 224), LayoutOrder = i, ZIndex = 22, Parent = track })
		lbl(col, tostring(i), { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = reached and T.gold or T.dim, TextXAlignment = Enum.TextXAlignment.Center })
		seasonCell(col, 24, def.free[i], reached, false, false)
		seasonCell(col, 126, def.paid[i], reached, not sp.paid, true)
	end
	if freshOpen then
		task.defer(function()
			track.CanvasPosition = Vector2.new(math.max(0, (sp.tier - 2) * 110), 0)
		end)
	end
	-- tier skips (looks and titles only)
	local skipRow = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -56), Size = UDim2.new(1, 0, 0, 48), ZIndex = 22, Parent = body })
	UI.list(skipRow, Enum.FillDirection.Horizontal, 8)
	for i, key in ipairs({ "TierSkip1", "TierSkip5" }) do
		local p = Monetization.Products[key]
		local room = sp.tier + (p.count or 1) <= sp.max
		local skipState = ShopCatalog.saleState(p.id, studio, false)
		local text = if not room
			then p.icon .. " " .. p.name .. " (top tier)"
			elseif skipState == "buy" then string.format("%s %s  R$ %d", p.icon, p.name, p.price)
			elseif skipState == "studio" then p.icon .. " " .. p.name .. " (Studio test)"
			else p.icon .. " " .. p.name .. " (Coming soon)"
		btn(skipRow, text, (room and skipState ~= "soon") and T.blue or T.cardHi, { Size = UDim2.new(0, 250, 0, 40), TextSize = 15, LayoutOrder = i }, function()
			if room and skipState ~= "soon" then
				Net.act("Prompt", "product", key)
			end
		end)
	end
	local skip5 = Monetization.Products.TierSkip5
	if skip5.valueNote then
		lbl(skipRow, skip5.valueNote, { Size = UDim2.new(0, 200, 0, 40), TextSize = 12, Font = T.body, TextColor3 = T.gold, LayoutOrder = 3 })
	end
	lbl(body, "Looks and titles only. Season XP comes from things you already do: serving, cooking, perfect flips, Cook-Offs, the dinner bell and a daily visit. Tiers you reach are yours to keep.", { Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 44), TextSize = 16, Font = T.body, TextColor3 = T.dim, TextWrapped = true })
end

-- ===== Gift picker (looks only, to someone in this server) =====
local function renderGift(s: any)
	local key = currentArg
	local item = Monetization.Products[key]
	if not item then
		Panels.close()
		return
	end
	titleLabel.Text = "🎁 Gift " .. item.name
	local sf = scroller(body)
	local held = s.giftsHeld and s.giftsHeld[key] or 0
	local head = card(sf, 0, 44)
	head.BackgroundTransparency = 1
	lbl(head, held > 0 and string.format("You have %d of these saved to send. Gifting one is free.", held) or ("Pick who gets it. Looks only, no stats. R$ " .. item.price .. ", same as buying it for yourself."), { Size = UDim2.new(1, 0, 1, 0), TextSize = 16, TextColor3 = T.gold })
	local n = 0
	local others = Players:GetPlayers()
	table.sort(others, function(a, b)
		return a.DisplayName < b.DisplayName
	end)
	for _, other in ipairs(others) do
		if other ~= player then
			n += 1
			local f = card(sf, n, 64)
			lbl(f, other.DisplayName, { Size = UDim2.new(1, -200, 0, 26), TextSize = 20 })
			lbl(f, "@" .. other.Name, { Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, -200, 0, 20), TextSize = 13, Font = T.body, TextColor3 = T.dim })
			local giftState = ShopCatalog.saleState(item.id, s.productIds ~= nil and s.productIds.studio == true, false)
			local label = held > 0 and "Send free 🎁" or (giftState == "buy" and ("Gift for R$ " .. item.price) or (giftState == "studio" and "Studio gift (free)" or "Coming soon"))
			local giftOn = held > 0 or giftState == "buy" or giftState == "studio"
			btn(f, label, giftOn and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 180, 0, 44), TextSize = 16, AutoButtonColor = giftOn }, function()
				if not giftOn then
					return
				end
				local ok = Net.act("Gift", key, other.UserId)
				if ok then
					Panels.open("shop")
				end
			end)
		end
	end
	if n == 0 then
		local f = card(sf, 1, 64)
		lbl(f, "Nobody else is in this server yet.", { Size = UDim2.new(1, -200, 1, 0), TextSize = 18 })
		btn(f, "Invite a friend", T.accent, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 180, 0, 44), TextSize = 16 }, function()
			Panels.invite()
		end)
	end
	btn(body, "Back to shop", T.card, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(0, 180, 0, 44), TextSize = 18 }, function()
		Panels.open("shop")
	end)
end

-- ===== Sauce Shack (coins) =====
local EFFECT_TEXT = { luck = "luck (better rarity odds)", speed = "cook speed", tip = "tips" }

local function renderSauce(s: any)
	titleLabel.Text = "🥫 Roch & Roll Sauce Shack"
	local sf = scroller(body)
	local head = card(sf, 0, 40)
	head.BackgroundTransparency = 1
	local restock = s.restock or { nextIn = 0, shelf = {}, bought = {} }
	lbl(head, string.format("New sauce in %s  •  restocks every 5 minutes  •  bought with coins only", TimeUtil.formatDuration(restock.nextIn or 0)), { Size = UDim2.new(1, 0, 1, 0), TextSize = 16, TextColor3 = T.gold })
	local rm = Economy.rankMult(s.rank, Config.RANK_STEP)
	for i, e in ipairs(ShopCatalog.sauceRows(restock.shelf, Config.SauceOrder)) do
		local def = Config.Sauces[e.id]
		if def then
		local left = e.qty - ((restock.bought or {})[e.id] or 0)
		local price = math.floor(def.price * (1 + (rm - 1) * 0.5))
		local f = card(sf, i, 76)
		local sw = UI.frame({ BackgroundColor3 = Color3.fromHex(def.color), Size = UDim2.new(0, 40, 0, 56), ZIndex = 23, Parent = f })
		UI.corner(sw, 8)
		lbl(f, def.name, { Position = UDim2.new(0, 52, 0, 0), Size = UDim2.new(1, -220, 0, 26), TextSize = 20 })
		lbl(f, string.format("+%d%% %s for %d cooks  •  %d left in stock", math.floor(def.amount * 100), EFFECT_TEXT[def.effect], def.charges, math.max(0, left)), { Position = UDim2.new(0, 52, 0, 28), Size = UDim2.new(1, -220, 0, 24), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		local buy = btn(f, if left > 0 then "" else "Sold out", left > 0 and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 44) }, function()
			if left > 0 then
				Net.act("BuySauce", e.id)
			end
		end)
		if left > 0 then
			UI.fillPrice(buy, "", price)
		end
		end
	end
	local mine = card(sf, 10, 60)
	local parts = {}
	for effect, v in pairs(s.sauces) do
		if v.charges > 0 then
			table.insert(parts, string.format("%s +%d%% (%d left)", EFFECT_TEXT[effect], math.floor(v.amount * 100), v.charges))
		end
	end
	lbl(mine, "Your sauces: " .. (#parts > 0 and table.concat(parts, "  •  ") or "none yet"), { Size = UDim2.new(1, 0, 1, 0), TextSize = 15 })
	if not sauceOdds then
		sauceOdds = Restock.appearOdds(Config.Sauces, Config.SauceOrder, Config.RESTOCK_SLOTS, 1500)
	end
	local odds = card(sf, 11, 90)
	local lines = {}
	for _, id in ipairs(Config.SauceOrder) do
		table.insert(lines, string.format("%s %.0f%%", Config.Sauces[id].name, (sauceOdds :: any)[id]))
	end
	lbl(odds, "Chance each sauce is on the shelf in a restock:\n" .. table.concat(lines, "  •  "), { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body, TextColor3 = T.dim })
end

-- ===== Cook picker =====
-- Event cuts stay cookable for their whole event, even outside their season.
local function eventMeats(s: any): { [string]: boolean }
	return {
		[Config.TurkeyDay.meat] = s.turkey ~= nil and s.turkey.active,
		[Config.HolidaySmokeout.meat] = s.holiday ~= nil and s.holiday.active,
	}
end

local function meatLocked(s: any, meat: any): string?
	if meat.hidden then
		return "hidden"
	end
	if not Holiday.meatOpen(meat, s.season.id, eventMeats(s)) then
		return "Seasonal: back next " .. meat.season
	end
	if s.pitLevel < meat.unlockPit then
		return "Needs " .. Config.PitLevels[meat.unlockPit].name
	end
	if meat.premium then
		local has = s.passes.PremiumCuts or (s.cuts[meat.id] or 0) > 0 or (meat.id == "tomahawk" and s.unlocks.tomahawk)
		if not has then
			return "Premium cut (Path reward or Pit Shop)"
		end
	end
	return nil
end

local function renderCook(s: any)
	local key = currentArg :: string
	local kind = string.sub(key, 1, 1) == "s" and "smoker" or "grill"
	titleLabel.Text = (kind == "smoker" and "🔥 Smoker " or "🍔 Grill ") .. string.sub(key, 2) .. ": what are we cooking?"
	local sf = scroller(body)
	local rm = Economy.rankMult(s.rank, Config.RANK_STEP)
	local pit = Config.PitLevels[s.pitLevel]
	local luck = pit.luck * (1 + (s.sauces.luck.charges > 0 and s.sauces.luck.amount or 0))
	local order = 0
	for _, id in ipairs(Config.MeatOrder) do
		local meat = Config.Meats[id]
		if meat.station == kind and Holiday.meatOpen(meat, s.season.id, eventMeats(s)) then
			order += 1
			local why = meatLocked(s, meat)
			local f = card(sf, order, 74)
			lbl(f, meat.icon, { Size = UDim2.new(0, 50, 1, 0), TextSize = 36 })
			local secs = meat.cookTime / pit.speed
			local access = {
				pass = s.passes.PremiumCuts == true,
				tokens = s.cuts[id] or 0,
				unlocked = id == "tomahawk" and s.unlocks.tomahawk == true,
			}
			local bill = Economy.cookBill(meat, s.rank, Config.RANK_STEP, access)
			local tokenNote = if bill.usesToken then string.format("  •  uses 1 of %d", access.tokens) else ""
			local paidNote = if Economy.paidCut(meat, access, bill.usesToken) then "  •  Smoke Ring Gold" else ""
			lbl(f, meat.name, { Position = UDim2.new(0, 56, 0, 0), Size = UDim2.new(1, -230, 0, 26), TextSize = 20 })
			lbl(f, string.format("%s  •  sells ~%s%s%s", TimeUtil.formatDuration(secs), UI.fmt(meat.price * rm), tokenNote, paidNote), { Position = UDim2.new(0, 56, 0, 28), Size = UDim2.new(1, -230, 0, 22), TextSize = 14, Font = T.body, TextColor3 = T.dim })
			local cost = bill.coins
			local cookBtn = btn(f, why and "🔒" or "Cook", why and T.cardHi or T.accent, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 168, 0, 44) }, function()
				if why then
					Net.notify(why, "info")
					return
				end
				if Net.act("StartCook", key, id) then
					Panels.close()
				end
			end)
			if not why and (meat.premium or cost > 0) then
				UI.fillPrice(cookBtn, "Cook", cost)
			end
			if why then
				lbl(f, why, { Position = UDim2.new(0, 56, 0, 48), Size = UDim2.new(1, -230, 0, 22), TextSize = 15, Font = T.body, TextColor3 = T.gold })
			end
		end
	end
	local odds = Rarity.odds(Config.Rarities, luck, nil)
	local parts = {}
	for _, o in ipairs(odds) do
		table.insert(parts, string.format("%s %.1f%%", o.name, o.pct))
	end
	local f = card(sf, 99, 82)
	lbl(f, "Rarity odds right now (set when you start the cook):\n" .. table.concat(parts, "  •  ") .. (kind == "grill" and "\nBurgers top out at Smoke Ring Gold." or "") .. "\nA Premium Cuts pass or a token comes out Smoke Ring Gold.", { Size = UDim2.new(1, 0, 1, 0), TextSize = 13, Font = T.body, TextColor3 = T.dim })
end

-- ===== Index =====
local function renderIndex(s: any)
	titleLabel.Text = "📖 Index"
	local sel, content = tabs(body, "index", { "Crew", "Customers", "Cuts", "Secrets" }, "Crew")
	if sel == "Crew" then
		local sf = scroller(content)
		local bonus = math.floor(((s.indexBonus or 1) - 1) * 100 + 0.5)
		local intro = card(sf, 0, 64)
		lbl(intro, string.format("Crew Index  ·  +%d%% income from finished rows", bonus), { Size = UDim2.new(1, 0, 0, 24), TextSize = 18 })
		local odds = s.storm and s.storm.odds or {}
		local oddText = "Smoke Storm odds: "
		if #odds == 0 then
			oddText ..= "Smoky 20% · Glazed 6% · Golden 1.5% · Meteorite 0.25%"
		else
			local bits = {}
			for _, row in ipairs(odds) do
				if row.id ~= "none" then
					table.insert(bits, string.format("%s %.2g%%", row.name, row.pct))
				end
			end
			oddText ..= table.concat(bits, " · ")
		end
		lbl(intro, oddText .. "  Free for everyone.", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 32), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		local caught = s.indexTraits or {}
		for i, species in ipairs(Config.CrewSpecies) do
			if species.secret ~= true then
				local row = caught[species.id] or {}
				local done = row.smoky and row.glazed and row.golden and row.meteorite
				local f = card(sf, i, 52)
				lbl(f, species.name .. " · " .. species.rarity .. (done and "  ·  row complete" or ""), { Size = UDim2.new(1, 0, 0, 20), TextSize = 16 })
				local chips = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 24), ZIndex = 23, Parent = f })
				UI.list(chips, Enum.FillDirection.Horizontal, 6)
				for n, traitId in ipairs({ "smoky", "glazed", "golden", "meteorite" }) do
					local got = row[traitId] == true
					local chip = UI.label(got and traitId or "—", { Size = UDim2.new(0, 72, 1, 0), TextSize = 12, LayoutOrder = n, ZIndex = 24, TextColor3 = got and T.text or T.dim, BackgroundTransparency = got and 0.2 or 0.6, BackgroundColor3 = T.cardHi, Parent = chips })
					UI.corner(chip, 6)
				end
			end
		end
	elseif sel == "Customers" then
		local sf = scroller(content, true, Vector2.new(210, 156))
		local odds = Rarity.weightedOdds(Config.Critters)
		for i, c in ipairs(Config.Critters) do
			local met = (s.critters[c.id] or 0) > 0
			local f = UI.frame({ BackgroundColor3 = met and T.card or T.panel, LayoutOrder = i, ZIndex = 22, Parent = sf })
			UI.corner(f, 12)
			UI.pad(f, 8)
			local sw = UI.frame({ BackgroundColor3 = met and Color3.fromHex(c.body) or Color3.fromHex("#222222"), Size = UDim2.new(0, 30, 0, 30), ZIndex = 23, Parent = f })
			UI.corner(sw, 15)
			lbl(f, met and c.name or "???", { Position = UDim2.new(0, 40, 0, 0), Size = UDim2.new(1, -44, 0, 40), TextSize = 18 })
			lbl(f, string.format("%s\nAppears %.1f%%  •  tips x%.1f", met and ("Served " .. s.critters[c.id] .. "x") or "Not met yet", odds[c.id] or 0, c.tip), { Position = UDim2.new(0, 0, 0, 48), Size = UDim2.new(1, 0, 0, 64), TextSize = 16, Font = T.body, TextColor3 = T.dim })
		end
	elseif sel == "Cuts" then
		local sf = scroller(content)
		local rarOdds = Rarity.odds(Config.Rarities, Config.PitLevels[s.pitLevel].luck, nil)
		for i, id in ipairs(Config.MeatOrder) do
			local meat = Config.Meats[id]
			local f = card(sf, i, 44)
			lbl(f, meat.icon .. " " .. meat.name, { Size = UDim2.new(0, 220, 1, 0), TextSize = 16 })
			local row = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 230, 0, 0), Size = UDim2.new(1, -230, 1, 0), ZIndex = 23, Parent = f })
			UI.list(row, Enum.FillDirection.Horizontal, 6)
			for ri, r in ipairs(Config.Rarities) do
				if ri <= meat.maxRarity then
					local got = s.cutsIndex[id .. ":" .. r.id]
					local chip = UI.label(got and r.name or "?", { Size = UDim2.new(0, 84, 1, 0), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = got and 0 or 0.7, BackgroundColor3 = Color3.fromHex(r.color), TextColor3 = got and Color3.fromHex("#1A0F0A") or T.dim, LayoutOrder = ri, ZIndex = 24, Parent = row })
					UI.corner(chip, 8)
				end
			end
		end
		local parts = {}
		for _, o in ipairs(rarOdds) do
			table.insert(parts, string.format("%s %.1f%%", o.name, o.pct))
		end
		local f = card(sf, 100, 50)
		lbl(f, "Odds at your pit level: " .. table.concat(parts, "  •  "), { Size = UDim2.new(1, 0, 1, 0), TextSize = 13, Font = T.body, TextColor3 = T.dim })
	else
		local sf = scroller(content)
		local n = 0
		for i, e in ipairs(EGGS) do
			local found = s.eggs[e.id] == true
			if found then
				n += 1
			end
			local f = card(sf, i + 1, 44)
			lbl(f, (found and "✅ " or "❔ ") .. (found and string.upper(e.id) .. ": found!" or e.hint), { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body })
		end
		local h = card(sf, 0, 36)
		h.BackgroundTransparency = 1
		lbl(h, string.format("Secrets found: %d / %d", n, #EGGS), { Size = UDim2.new(1, 0, 1, 0), TextSize = 18, TextColor3 = T.gold })
		local j = s.jimothy
		local jn = if type(j) == "table" then (j.n or 0) else 0
		local jt = if type(j) == "table" and type(j.total) == "number" then j.total else 10
		local jf = card(sf, 80, 52)
		lbl(jf, string.format("🦝 Jimothy sightings: %d / %d\nHe's hiding around the ranch. Walk up and say hi.", jn, jt), { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body })
	end
end

-- ===== Pitmaster Path =====
local function rewardText(r: any): string
	local parts = {}
	if r.coins then
		table.insert(parts, UI.fmt(r.coins) .. " coins")
	end
	if r.sauce then
		table.insert(parts, Config.Sauces[r.sauce].name)
	end
	if r.cosmetic then
		table.insert(parts, Config.Cosmetics[r.cosmetic].name)
	end
	if r.boostMinutes then
		table.insert(parts, r.boostMinutes .. " min x2 speed")
	end
	if r.wagyu then
		table.insert(parts, r.wagyu .. " Wagyu token" .. (r.wagyu == 1 and "" or "s") .. " (meat cost to cook)")
	end
	if r.title then
		table.insert(parts, "Title: " .. r.title)
	end
	if r.rex then
		table.insert(parts, "a very special visitor 🦖")
	end
	if r.tomahawk then
		table.insert(parts, "Tomahawk access (meat cost still applies)")
	end
	return table.concat(parts, " + ")
end

local function renderPath(s: any)
	titleLabel.Text = "🗺️ Pitmaster Path (28 days)"
	local sf = scroller(body)
	local st = s.pathStatus
	local head = card(sf, 0, 44)
	head.BackgroundTransparency = 1
	lbl(head, string.format("Play days: %d  •  Steps claimed: %d / %d  •  a new step unlocks each day you play", s.path.playDays, s.path.claimed, #Config.PathSteps), { Size = UDim2.new(1, 0, 1, 0), TextSize = 15, TextColor3 = T.gold })
	for i, step in ipairs(Config.PathSteps) do
		local f = card(sf, i, 58)
		local claimed = i <= s.path.claimed
		local isCur = i == st.step
		f.BackgroundColor3 = claimed and T.cardHi or (isCur and T.card or T.panel)
		lbl(f, string.format("Day %d: %s", i, step.label), { Size = UDim2.new(1, -170, 0, 22), TextSize = 16 })
		if step.reward.coins then
			local coin = UI.coin(f, 16)
			coin.Position = UDim2.new(0, 0, 0, 24)
			coin.ZIndex = 24
		end
		lbl(f, "Reward: " .. rewardText(step.reward), { Position = UDim2.new(0, step.reward.coins and 20 or 0, 0, 22), Size = UDim2.new(1, -170, 0, 18), TextSize = 12, Font = T.body, TextColor3 = T.dim })
		if claimed then
			lbl(f, "✅ Done", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 30), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.green })
		elseif isCur then
			if st.complete then
				btn(f, "Claim!", T.green, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 38) }, function()
					Net.act("ClaimPath")
				end)
			elseif not st.unlocked then
				lbl(f, "Unlocks on play day " .. i, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 30), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.dim })
			else
				lbl(f, string.format("%d / %d", st.progress, st.amount), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 30), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.gold })
			end
		else
			lbl(f, "🔒", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 60, 0, 30), TextXAlignment = Enum.TextXAlignment.Right })
		end
	end
	if freshOpen then
		task.defer(function()
			sf.CanvasPosition = Vector2.new(0, math.max(0, (st.step - 3) * 66))
		end)
	end
end

-- ===== Upgrades & Unc Status =====
local function renderUpgrades(s: any)
	titleLabel.Text = "⬆️ Upgrades & Unc Status"
	local sf = scroller(body)
	local pit = Config.PitLevels[s.pitLevel]
	local nextPit = Config.PitLevels[s.pitLevel + 1]
	local f1 = card(sf, 1, 80)
	lbl(f1, "Pit: " .. pit.name, { Size = UDim2.new(1, -180, 0, 26), TextSize = 20 })
	lbl(f1, nextPit and string.format("Next: %s  •  speed x%.2f -> x%.2f  •  luck x%.2f -> x%.2f  •  unlocks new meats", nextPit.name, pit.speed, nextPit.speed, pit.luck, nextPit.luck) or "Maxed out! Time for Unc Status.", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, -180, 0, 34), TextSize = 13, Font = T.body, TextColor3 = T.dim })
	if nextPit then
		local pitBtn = btn(f1, "", s.coins >= nextPit.cost and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 44) }, function()
			Net.act("UpgradePit")
		end)
		UI.fillPrice(pitBtn, "", nextPit.cost)
	end
	for i, kind in ipairs({ "smoker", "grill" }) do
		local def = Config.Slots[kind]
		local cap = kind == "smoker" and Config.MAX_SMOKERS or Config.MAX_GRILLS
		local cost = Economy.nextSlotCost(def.costs, s.bought[kind])
		local f = card(sf, 1 + i, 64)
		lbl(f, string.format("%s slots: %d / %d", kind == "smoker" and "Smoker" or "Grill", s.slots[kind], cap), { Size = UDim2.new(1, -180, 0, 26), TextSize = 18 })
		lbl(f, kind == "smoker" and "More smokers = more meat smoking while you're away." or "More grill spots = more burgers at once.", { Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, -180, 0, 20), TextSize = 13, Font = T.body, TextColor3 = T.dim })
		if cost and s.slots[kind] < cap then
			local slotBtn = btn(f, "", s.coins >= cost and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 40) }, function()
				Net.act("BuySlot", kind)
			end)
			UI.fillPrice(slotBtn, "", cost)
		end
	end
	local nextRank = Config.Ranks[s.rank + 1]
	local f4 = card(sf, 5, 120)
	f4.BackgroundColor3 = T.card
	lbl(f4, "👴 Unc Status: " .. Config.Ranks[s.rank].name, { Size = UDim2.new(1, -180, 0, 28), TextSize = 22, TextColor3 = T.gold })
	if nextRank then
		lbl(f4, string.format("Rebirth into %s: +%d%% coins forever. Resets coins, pit and slots. Keeps cosmetics, Index, sauces, titles, passes, your cooler and your crew. Unfinished cooks are refunded in coins.", nextRank.name, math.floor(Config.RANK_STEP * 100)), { Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, -180, 0, 50), TextSize = 13, Font = T.body, TextColor3 = T.dim })
		local back, fill = UI.bar(f4, T.gold, { Position = UDim2.new(0, 0, 0, 86), Size = UDim2.new(1, -180, 0, 12), ZIndex = 23 })
		fill.ZIndex = 24
		fill.Size = UDim2.fromScale(math.clamp(s.runCoins / nextRank.need, 0, 1), 1)
		lbl(f4, UI.fmt(s.runCoins) .. " / " .. UI.fmt(nextRank.need) .. " earned this run", { Position = UDim2.new(0, 0, 0, 98), Size = UDim2.new(1, -180, 0, 16), TextSize = 12, Font = T.body })
		local _ = back
		btn(f4, "Rebirth", s.runCoins >= nextRank.need and T.gold or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 50), TextColor3 = T.ink }, function()
			Net.act("Rebirth")
		end)
	else
		lbl(f4, "You're OG Pitmaster. Nothing left but respect.", { Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, -20, 0, 30), TextSize = 15 })
	end
end

-- ===== Daily =====
local function renderDaily(s: any)
	titleLabel.Text = "🎁 Daily Smoke"
	local wrap = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 21, Parent = body })
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 130), ZIndex = 21, Parent = wrap })
	UI.list(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	local count = s.streak.count
	local nextDay = s.canClaimDaily and ((count % 7) + 1) or (((count - 1) % 7) + 1)
	local previewCount = if s.canClaimDaily then count + 1 else math.max(count, 1)
	if type(s.today) == "number" and s.streak then
		local look = Streak.forecast(s.streak, s.today)
		if look.ok then
			previewCount = look.count
			nextDay = look.cycleDay
		end
	end
	for i, r in ipairs(Config.DailyRewards) do
		local isNext = i == nextDay and s.canClaimDaily
		local done = (not s.canClaimDaily and i <= nextDay) or (s.canClaimDaily and i < nextDay)
		local f = UI.frame({ BackgroundColor3 = isNext and T.accent or (done and T.cardHi or T.card), Size = UDim2.new(0, 92, 0, 124), LayoutOrder = i, ZIndex = 22, Parent = row })
		UI.corner(f, 12)
		UI.pad(f, 6)
		lbl(f, "Day " .. i, { Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
		local mark = UI.coin(f, 26)
		mark.AnchorPoint = Vector2.new(0.5, 0)
		mark.Position = UDim2.new(0.5, 0, 0, 26)
		mark.ZIndex = 24
		local txt = UI.fmt(Streak.payout(r.coins, previewCount, Economy.rankMult(s.rank, Config.RANK_STEP)))
		if r.sauce then
			txt ..= "\n+ " .. Config.Sauces[r.sauce].name
		end
		if r.boostMinutes then
			txt ..= "\n+ " .. r.boostMinutes .. "m x2"
		end
		lbl(f, txt, { Position = UDim2.new(0, 0, 0, 62), Size = UDim2.new(1, 0, 0, 50), TextSize = 11, Font = T.body, TextXAlignment = Enum.TextXAlignment.Center })
		if done then
			lbl(f, "✓", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 20, 0, 20), TextColor3 = T.green })
		end
	end
	lbl(wrap, string.format("🔥 Streak: %d days (best %d). Amounts include your streak and rank. Miss a day? Your free miss each week keeps it going. Miss more and you only go back to the start of this week, never zero.", count, s.streak.best), { Position = UDim2.new(0, 0, 0, 140), Size = UDim2.new(1, 0, 0, 52), TextSize = 14, Font = T.body, TextColor3 = T.dim, ZIndex = 22 })
	btn(wrap, s.canClaimDaily and "Claim today's reward!" or "Come back tomorrow (Texas time)", s.canClaimDaily and T.green or T.cardHi, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 196), Size = UDim2.new(0, 340, 0, 54), TextSize = 22 }, function()
		if s.canClaimDaily then
			Net.act("ClaimDaily")
		end
	end)
	btn(wrap, "👴 Hear Unc Hank's joke of the day", T.blue, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262), Size = UDim2.new(0, 340, 0, 44), TextSize = 17 }, function()
		Net.act("HearJoke")
	end)
	local m = s.member or {}
	if m.club or m.host then
		local perks = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 366), Size = UDim2.new(1, 0, 0, 40), ZIndex = 22, Parent = wrap })
		UI.list(perks, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
		if m.club then
			btn(perks, m.clubShowerReady and "🔧 Share today's Pit Crew Smoke Shower" or "🔧 Smoke Shower shared today ✓", m.clubShowerReady and T.green or T.cardHi, { Size = UDim2.new(0, 330, 0, 40), TextSize = 15, LayoutOrder = 1 }, function()
				Net.act("ClubShower")
			end)
		end
		if m.host then
			btn(perks, m.hostShowerReady and "🏠 Host's Smoke Shower" or "🏠 Smoker warming up", m.hostShowerReady and T.green or T.cardHi, { Size = UDim2.new(0, 250, 0, 40), TextSize = 15, LayoutOrder = 2 }, function()
				Net.act("HostShower")
			end)
		end
	end
	lbl(wrap, "Also today: 🧪 sauce restocks every 5 min  •  🏆 Saturday Cook-Off  •  🫧 Suds weekend pups  •  🦟 mosquitoes at dusk", { Position = UDim2.new(0, 0, 0, 320), Size = UDim2.new(1, 0, 0, 40), TextSize = 13, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 22 })
end

-- ===== Settings / Fits / Titles =====
local SLOT_LABEL = { hat = "Hat", apron = "Apron", tool = "Tool", neck = "Bandana", feet = "Feet", buddy = "Back-buddy", trail = "Trail", skin = "Smoker skin", smoke = "Smoke color", patio = "Patio" }

local function renderSettings(s: any)
	titleLabel.Text = "⚙️ Settings & Fits"
	local sel, content = tabs(body, "settings", { "Fits", "Titles", "Game" }, "Fits")
	local sf = scroller(content)
	if sel == "Fits" then
		local order = 0
		for _, slot in ipairs(Config.CosmeticSlots) do
			local owned = {}
			for id, def in pairs(Config.Cosmetics) do
				if def.slot == slot and s.owned[id] then
					table.insert(owned, id)
				end
			end
			table.sort(owned)
			order += 1
			local f = card(sf, order, 70)
			lbl(f, SLOT_LABEL[slot] or slot, { Size = UDim2.new(0, 120, 0, 24), TextSize = 16 })
			local row = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 120, 0, 0), Size = UDim2.new(1, -120, 1, 0), AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 4, ZIndex = 23, Parent = f })
			UI.list(row, Enum.FillDirection.Horizontal, 6)
			if #owned == 0 then
				lbl(row, "None yet. Earn them on the Path, at events, or in the Pit Shop.", { Size = UDim2.new(0, 420, 1, 0), TextSize = 13, Font = T.body, TextColor3 = T.dim })
			else
				btn(row, "None", s.equipped[slot] == nil and T.accent or T.cardHi, { Size = UDim2.new(0, 70, 0, 40), TextSize = 13, LayoutOrder = 0 }, function()
					Net.act("Equip", slot, "")
				end)
				for i, id in ipairs(owned) do
					local def = Config.Cosmetics[id]
					local b = btn(row, def.name, s.equipped[slot] == id and T.accent or T.cardHi, { Size = UDim2.new(0, 150, 0, 40), TextSize = 13, LayoutOrder = i }, function()
						Net.act("Equip", slot, id)
					end)
					local sw = UI.frame({ BackgroundColor3 = Color3.fromHex(def.color), Size = UDim2.new(0, 10, 1, -10), Position = UDim2.new(0, 4, 0, 5), ZIndex = 25, Parent = b })
					UI.corner(sw, 4)
				end
			end
		end
	elseif sel == "Titles" then
		local list = {}
		for t in pairs(s.titles) do
			table.insert(list, t)
		end
		table.sort(list)
		local f0 = card(sf, 0, 64)
		btn(f0, "Show rank (" .. Config.Ranks[s.rank].name .. ")", s.title == "" and T.accent or T.cardHi, { Size = UDim2.new(1, 0, 0, 44), TextSize = 18 }, function()
			Net.act("SetTitle", "")
		end)
		for i, t in ipairs(list) do
			local f = card(sf, i, 64)
			btn(f, t, s.title == t and T.accent or T.cardHi, { Size = UDim2.new(1, 0, 0, 44), TextSize = 18 }, function()
				Net.act("SetTitle", t)
			end)
		end
		if #list == 0 then
			local f = card(sf, 1, 40)
			lbl(f, "Earn titles from the Path, secrets and Unc Status.", { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body })
		end
	else
		local function settingCard(order: number, height: number, title: string, detail: string, buttonText: string?, buttonColor: Color3?, onPress: (() -> ())?)
			local beside = buttonText ~= nil and not UI.compact
			local stacked = buttonText ~= nil and UI.compact
			local h = if stacked then height + 52 else height
			local f = card(sf, order, h)
			local inset = if beside then -176 else 0
			lbl(f, title, { Size = UDim2.new(1, inset, 0, 28), TextSize = 20 })
			lbl(f, detail, { Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, inset, 0, h - (if stacked then 96 else 48)), TextSize = 16, Font = T.body, TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top })
			if buttonText and onPress then
				if beside then
					btn(f, buttonText, buttonColor or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 44), TextSize = 18 }, onPress)
				else
					btn(f, buttonText, buttonColor or T.cardHi, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 44), TextSize = 18 }, onPress)
				end
			end
			return f
		end
		settingCard(1, 108, "Peace Mode: " .. (s.settings.peace and "ON" or "OFF"), "When on, nobody can snag plates from your pass window, and you can't snag theirs. You can switch once a minute.", s.settings.peace and "Turn off" or "Turn on", s.settings.peace and T.cardHi or T.green, function()
			Net.act("SetPeace", not s.settings.peace)
		end)
		local sfxOn = s.settings.sfx ~= false
		settingCard(3, 100, "Sound effects: " .. (sfxOn and "ON" or "OFF"), "Sizzles, spatula clanks, the cash register and Big Bertha's bell. Music has its own switch.", sfxOn and "Turn off" or "Turn on", sfxOn and T.cardHi or T.green, function()
			Net.act("SetSfx", not sfxOn)
		end)
		local musicOn, musicVolume = MusicPrefs.read(s.settings)
		local uploaded = MusicPrefs.audible(MusicTrack.id)
		local musicDetail = if uploaded
			then "Porch Light, a quiet original loop. Mute and volume are saved on their own, separate from sound effects."
			else "Porch Light is written and saved with the game, but it is not on Roblox yet, so the ranch stays quiet. Mute and volume still save for when the tune is uploaded."
		local musicCard = card(sf, 5, if UI.compact then 220 else 176)
		local textInset = if UI.compact then 0 else -176
		lbl(musicCard, "Music: " .. (musicOn and "ON" or "OFF") .. string.format("  ·  %d%%", math.floor(musicVolume * 100 + 0.5)), { Size = UDim2.new(1, textInset, 0, 28), TextSize = 20 })
		lbl(musicCard, musicDetail, { Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, textInset, 0, if UI.compact then 72 else 64), TextSize = 16, Font = T.body, TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top })
		if not UI.compact then
			btn(musicCard, musicOn and "Mute" or "Unmute", musicOn and T.cardHi or T.green, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 160, 0, 44), TextSize = 18 }, function()
				Net.act("SetMusic", not musicOn)
			end)
		end
		local volRow = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 44), ZIndex = 23, Parent = musicCard })
		UI.list(volRow, Enum.FillDirection.Horizontal, 8)
		local muteOrder = 0
		if UI.compact then
			btn(volRow, musicOn and "Mute" or "Unmute", musicOn and T.cardHi or T.green, { Size = UDim2.new(0.25, -6, 0, 44), TextSize = 16, LayoutOrder = muteOrder }, function()
				Net.act("SetMusic", not musicOn)
			end)
		end
		for i, step in ipairs(MusicPrefs.STEPS) do
			local picked = math.abs(musicVolume - step.volume) < 0.021
			local width = if UI.compact then UDim2.new(0.25, -6, 0, 44) else UDim2.new(0, 108, 0, 44)
			btn(volRow, step.label, picked and T.accent or T.cardHi, { Size = width, TextSize = 18, LayoutOrder = i }, function()
				Net.act("SetMusicVolume", step.volume)
				if not musicOn then
					Net.act("SetMusic", true)
				end
			end)
		end
		local codeCard = card(sf, 1, 88)
		lbl(codeCard, "Codes", { Size = UDim2.new(1, 0, 0, 22), TextSize = 18 })
		local codeBox = UI.new("TextBox", {
			PlaceholderText = "Type a code",
			Text = "",
			ClearTextOnFocus = false,
			Font = T.body,
			TextSize = 16,
			TextColor3 = T.text,
			PlaceholderColor3 = T.dim,
			BackgroundColor3 = T.cardHi,
			Position = UDim2.new(0, 0, 0, 30),
			Size = UDim2.new(1, -130, 0, 40),
			Parent = codeCard,
		})
		UI.corner(codeBox, 8)
		btn(codeCard, "Redeem", T.green, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.new(0, 120, 0, 40), TextSize = 16 }, function()
			Net.act("RedeemCode", codeBox.Text)
		end)
		settingCard(2, 100, string.format("Partner bonus: +%d%% (%d partner%s here)", math.floor((s.crew or 0) * Config.Partners.per * 100 + 0.5), s.crew or 0, (s.crew or 0) == 1 and "" or "s"), "Each ranch partner in this server gives +10% coins, up to 3.", "Invite friends", T.blue, function()
			Panels.invite()
		end)
		-- Unc's Rookie List: bring it back after a skip (and still earn the finish reward)
		local rk = s.rookie
		if rk and s.tutorial and s.tutorial.done then
			local fin = Config.RookieFinish
			local cdef = fin.cosmetic and Config.Cosmetics[fin.cosmetic]
			local finText = Rookie.rewardText(fin, cdef and cdef.name or nil)
			local head, desc, action
			if rk.done then
				head, desc = "Unc's Rookie List: done", "You earned " .. finText .. "."
			elseif rk.skipped then
				head, desc = "Unc's Rookie List: skipped", "Bring it back to finish it. Goals you already did count right away. Finish all 5 to earn " .. finText .. "."
				action = "Bring it back"
			else
				head, desc = "Unc's Rookie List: on", "It's on your screen. Finish all 5 to earn " .. finText .. "."
			end
			settingCard(0, 112, head, desc, action, T.green, action and function()
				Net.act("RookieResume")
			end or nil)
		end
		local f3 = card(sf, 4, 72)
		local saveLine = if s.memoryOnly
			then "Studio test mode: progress is NOT saved."
			elseif s.degraded then "Save servers didn't answer, so this visit won't be saved. Your real ranch is safe."
			else "Your ranch saves automatically. Smokers keep cooking while you're away."
		lbl(f3, saveLine, { Size = UDim2.new(1, 0, 1, 0), TextSize = 16, Font = T.body })
	end
end

-- ===== Dialog (NPCs) =====
local dialogFrame: Frame? = nil

function Panels.dialog(payload: any)
	if dialogFrame then
		dialogFrame:Destroy()
	end
	local dialogW = math.clamp(UI.viewport.X - 24, 280, 680)
	local f = UI.frame({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -(UI.stationReserve + 8)), Size = UDim2.new(0, dialogW, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.bg, ZIndex = 30, Parent = screen })
	dialogFrame = f
	UI.corner(f, 16)
	UI.stroke(f, T.gold, 3)
	UI.pad(f, 14)
	UI.list(f, nil, 8)
	UI.label(payload.npc or "", { TextSize = 24, TextColor3 = T.gold, ZIndex = 31, LayoutOrder = 1, Parent = f })
	local text = UI.label(payload.text or "", { TextSize = 18, Font = T.body, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), ZIndex = 31, LayoutOrder = 2, Parent = f })
	local yap: TextLabel? = nil
	if payload.yap then
		yap = UI.label("", { TextSize = 16, Font = T.body, TextColor3 = T.dim, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), ZIndex = 31, LayoutOrder = 3, Parent = f })
	end
	if (payload.reward or 0) > 0 then
		local rewardRow = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), ZIndex = 31, LayoutOrder = 4, Parent = f })
		local rewardList = UI.list(rewardRow, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left)
		rewardList.VerticalAlignment = Enum.VerticalAlignment.Center
		local rewardCoin = UI.coin(rewardRow, 22)
		rewardCoin.ZIndex = 32
		UI.label("+" .. UI.fmt(payload.reward), { Size = UDim2.fromOffset(160, 24), TextSize = 20, TextColor3 = T.gold, ZIndex = 32, Parent = rewardRow })
	end
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), ZIndex = 31, LayoutOrder = 5, Parent = f })
	UI.list(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
	local skipped = false
	if yap then
		local yl = yap :: TextLabel
		local skip = UI.button(Content.Slang.skipYap, T.cardHi, { Size = UDim2.new(0, 180, 0, 44), TextSize = 18, ZIndex = 32, LayoutOrder = 1, Parent = row })
		skip.Activated:Connect(function()
			skipped = true
			yl.Text = "(Yap skipped. Unc is a little hurt.)"
			skip:Destroy()
		end)
		task.spawn(function()
			local full = "Unc keeps going: " .. payload.yap
			for i = 1, #full do
				if skipped or not yl.Parent then
					return
				end
				yl.Text = string.sub(full, 1, i)
				task.wait(0.025)
			end
		end)
	end
	UI.button("OK", T.green, { Size = UDim2.new(0, 120, 0, 44), TextSize = 20, ZIndex = 32, LayoutOrder = 2, Parent = row }, function()
		f:Destroy()
		if dialogFrame == f then
			dialogFrame = nil
		end
	end)
	local _ = text
	task.delay(20, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

function Panels.welcome(payload: any)
	if payload.isNew then
		Panels.dialog({ npc = "Unc Hank", text = "Hi Hungry, I'm Unc! Welcome to Backyard Cookout.\n\nHere's how it works: brisket and ribs smoke for real hours (even while you're offline), burgers take 30 seconds on the grill. Serve the critters, upgrade your pit, find the secrets.\n\nHit the big orange button to smoke your first brisket. It only takes a minute this time. 😉" })
	elseif payload.away and ((payload.ready and payload.ready > 0) or (payload.crewCoins and payload.crewCoins > 0)) then
		local meat = ""
		if payload.ready and payload.ready > 0 then
			meat = string.format(" %d meat%s finished smoking.", payload.ready, payload.ready == 1 and "" or "s")
		end
		local crew = ""
		if payload.crewCoins and payload.crewCoins > 0 then
			crew = string.format(" Your crew earned %s coins while you were away (up to 4 hours).", UI.fmt(payload.crewCoins))
		end
		Panels.dialog({ npc = "Unc Hank", text = string.format("Welcome back! You were gone %s.%s%s", TimeUtil.formatDuration(payload.away), meat, crew) })
	end
end

local function renderCrew(s: any)
	titleLabel.Text = "🍳 Ranch crew"
	local sf = scroller(body)
	local ranch = s.ranchCrew or {}
	local owned = ranch.owned or {}
	local slots = ranch.slots or 3
	local waiter = s.staff and s.staff.waiter == true
	local intro = card(sf, 0, 72)
	intro.BackgroundTransparency = 1
	lbl(intro, string.format("%s · %d / %d working · %s", ranch.tierName or "Open yard", math.min(#owned, slots), slots, Income.format(ranch.rate or 0)), { Size = UDim2.new(1, 0, 0, 24), TextSize = 18 })
	lbl(intro, "Critters you hire walk home and work the ranch. Jimothy the Waiter is still his own pass. He serves plates. He isn't one of these slots.", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 40), TextSize = 14, Font = T.body, TextColor3 = T.dim })
	if type(s.offer) == "table" and s.offer.id == "bunkhouse" then
		local offer = card(sf, 2, 96)
		lbl(offer, s.offer.title, { Size = UDim2.new(1, -150, 0, 24), TextSize = 18 })
		lbl(offer, s.offer.detail, { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, -150, 0, 60), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		btn(offer, "See the pass", T.accent, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 40), TextSize = 15 }, function()
			Net.act("Prompt", s.offer.kind, s.offer.key)
		end)
	end
	if ranch.nextCost and ranch.nextName then
		local build = card(sf, 1, 88)
		lbl(build, "Build " .. ranch.nextName, { Size = UDim2.new(1, -170, 0, 24), TextSize = 20 })
		local blurb = ranch.nextBlurb or "Adds 2 crew slots."
		local afford = s.coins or 0
		if s.family and s.family.on then
			blurb ..= " Paid from the family purse."
			afford = s.family.purse or 0
		end
		lbl(build, blurb, { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, -170, 0, 44), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		local buildBtn = btn(build, "", afford >= ranch.nextCost and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 44) }, function()
			Net.act("BuyRanchTier")
		end)
		UI.fillPrice(buildBtn, "Build", ranch.nextCost)
	end
	if #owned == 0 then
		local empty = card(sf, 2, 48)
		lbl(empty, "Nobody's on the ranch yet. The Hiring Line is in the town square.", { Size = UDim2.new(1, 0, 1, 0), TextSize = 16 })
	end
	for i, e in ipairs(owned) do
		local working = i <= slots
		local trait = if e.trait and e.trait ~= "none" then (" · " .. e.traitName) else ""
		local badge = if e.badge then (" · " .. e.badge) else ""
		local f = card(sf, 10 + i, 108)
		f.BackgroundColor3 = working and T.card or T.panel
		lbl(f, (working and "" or "Waiting · ") .. e.name .. " · " .. (e.roleName or e.role), { Size = UDim2.new(1, -150, 0, 24), TextSize = 20, TextColor3 = working and T.text or T.dim })
		lbl(f, string.format("%s%s%s · level %d · %s", e.rarityName or "", trait, badge, e.level or 1, Income.format(e.earn or 0)), { Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		lbl(f, e.line or "", { Position = UDim2.new(0, 0, 0, 48), Size = UDim2.new(1, -160, 0, 36), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		local up = e.levelCost
		local b = btn(f, "", up and ((s.coins or 0) >= up and T.accent or T.cardHi) or T.cardHi, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.new(0, 150, 0, 44), TextSize = 14 }, function()
			if up then
				Net.act("LevelCrew", e.uid)
			end
		end)
		if up then
			UI.fillPrice(b, "Level " .. tostring((e.level or 1) + 1), up)
		else
			b.Text = "Level max"
		end
	end
	local mates = s.serverMates or {}
	if #mates > 0 then
		local box = card(sf, 70, 36 + #mates * 40)
		lbl(box, "Ranch partners", { Size = UDim2.new(1, 0, 0, 22), TextSize = 16 })
		local have: { [string]: boolean } = {}
		for _, id in ipairs(s.partners or {}) do
			have[tostring(id)] = true
		end
		for i, mate in ipairs(mates) do
			local y = 24 + (i - 1) * 36
			lbl(box, mate.name, { Position = UDim2.new(0, 0, 0, y), Size = UDim2.new(1, -120, 0, 32), TextSize = 15 })
			if have[tostring(mate.id)] then
				btn(box, "Remove", T.cardHi, { Position = UDim2.new(1, -110, 0, y), Size = UDim2.new(0, 110, 0, 32), TextSize = 14 }, function()
					Net.act("RemovePartner", mate.id)
				end)
			else
				btn(box, "Add partner", T.green, { Position = UDim2.new(1, -110, 0, y), Size = UDim2.new(0, 110, 0, 32), TextSize = 14 }, function()
					Net.act("AddPartner", mate.id)
				end)
			end
		end
	end
	if s.family and s.family.privateServer then
		local fam = card(sf, 71, 78)
		lbl(fam, s.family.on and "Family Ranch is on" or "Family Ranch", { Size = UDim2.new(1, -160, 0, 22), TextSize = 16 })
		lbl(fam, string.format("Shared tier purse: %d coins.", s.family.purse or 0), { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		if s.family.host then
			btn(fam, s.family.on and "Turn off" or "Turn on", T.accent, { Position = UDim2.new(1, -140, 0, 0), Size = UDim2.new(0, 140, 0, 36), TextSize = 14 }, function()
				Net.act("FamilyRanch", not s.family.on)
			end)
		end
		btn(fam, "Add 50", T.green, { Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(0, 100, 0, 28), TextSize = 14 }, function()
			Net.act("ChipPurse", 50)
		end)
	end
	if not waiter then
		local note = card(sf, 80, 48)
		note.BackgroundTransparency = 1
		lbl(note, "Jimothy the Waiter is in the Pit Shop if you want someone serving while you cook the long cuts yourself.", { Size = UDim2.new(1, 0, 1, 0), TextSize = 14, Font = T.body, TextColor3 = T.dim })
	end
end

local function renderHire(s: any)
	titleLabel.Text = "🐾 Hiring Line"
	local sf = scroller(body)
	local hiring = s.hiring or {}
	local intro = card(sf, 0, 64)
	intro.BackgroundTransparency = 1
	lbl(intro, "They're walking the boardwalk in the town square. You hire the one you see. Coins only.", { Size = UDim2.new(1, 0, 0, 36), TextSize = 15, Font = T.body, TextColor3 = T.dim })
	lbl(intro, hiring.clock or "Next lineup", { Position = UDim2.new(0, 0, 0, 38), Size = UDim2.new(1, 0, 0, 22), TextSize = 16 })
	if type(s.offer) == "table" and s.offer.id == "autohire" then
		local offer = card(sf, 1, 96)
		lbl(offer, s.offer.title, { Size = UDim2.new(1, -150, 0, 24), TextSize = 18 })
		lbl(offer, s.offer.detail, { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, -150, 0, 60), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		btn(offer, "See the pass", T.accent, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 40), TextSize = 15 }, function()
			Net.act("Prompt", s.offer.kind, s.offer.key)
		end)
	end
	local rows = hiring.applicants or {}
	if #rows == 0 then
		local empty = card(sf, 1, 48)
		lbl(empty, "The lineup is walking in.", { Size = UDim2.new(1, 0, 1, 0), TextSize = 16 })
	end
	for _, applicant in ipairs(rows) do
		local f = card(sf, applicant.index + 1, 96)
		local trait = if applicant.trait and applicant.trait ~= "none" then (" · " .. applicant.traitName) else ""
		lbl(f, applicant.name .. " · " .. (applicant.rarityName or ""), { Size = UDim2.new(1, -170, 0, 24), TextSize = 20, TextColor3 = Color3.fromHex(applicant.color or "#FFF6E0") })
		lbl(f, (applicant.roleName or "Crew") .. trait, { Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, -170, 0, 20), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		lbl(f, Income.format(applicant.rate or 0) .. " · " .. applicant.line, { Position = UDim2.new(0, 0, 0, 48), Size = UDim2.new(1, -170, 0, 36), TextSize = 14, Font = T.body, TextColor3 = T.dim })
		if applicant.taken then
			local taken = btn(f, "Hired", T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 44) })
			taken.AutoButtonColor = false
			taken.Active = false
		else
			local hireBtn = btn(f, "", (s.coins or 0) >= (applicant.price or 0) and T.green or T.cardHi, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 44) }, function()
				Net.act("HireApplicant", applicant.index)
			end)
			UI.fillPrice(hireBtn, "Hire", applicant.price or 0)
		end
	end
end

function Panels.render()
	if not current or not window.Visible then
		return
	end
	local s = S()
	if not s then
		titleLabel.Text = "Loading"
		UI.clear(body)
		lbl(body, "Your ranch is still loading. Try that again in a second.", { Size = UDim2.new(1, 0, 0, 48), TextSize = 18 })
		return
	end
	lastRender = os.clock()
	-- keep scroll position across live refreshes
	local oldScroll: Vector2? = nil
	for _, d in ipairs(body:GetDescendants()) do
		if d:IsA("ScrollingFrame") and d.ScrollingDirection == Enum.ScrollingDirection.Y then
			oldScroll = d.CanvasPosition
			break
		end
	end
	UI.clear(body)
	local ok, err = pcall(function()
		if current == "shop" then
			renderShop(s)
		elseif current == "gift" then
			renderGift(s)
		elseif current == "season" then
			renderSeason(s)
		elseif current == "sauce" then
			renderSauce(s)
		elseif current == "cook" then
			renderCook(s)
		elseif current == "index" then
			renderIndex(s)
		elseif current == "path" then
			if freshOpen then
				oldScroll = nil
			end
			renderPath(s)
		elseif current == "upgrades" then
			renderUpgrades(s)
		elseif current == "daily" then
			renderDaily(s)
		elseif current == "crew" then
			renderCrew(s)
		elseif current == "hire" then
			renderHire(s)
		elseif current == "settings" then
			renderSettings(s)
		end
	end)
	if not ok then
		warn("[Panels] " .. tostring(err))
	end
	local wasFresh = freshOpen
	freshOpen = false
	if oldScroll and not wasFresh then
		for _, d in ipairs(body:GetDescendants()) do
			if d:IsA("ScrollingFrame") and d.ScrollingDirection == Enum.ScrollingDirection.Y then
				d.CanvasPosition = oldScroll
				break
			end
		end
	end
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">RookieGuide</string>
            <string name="Source"><![CDATA[--!strict
-- Unc Hank's Rookie List on the client: a small goal card under the coin bar and a gold arrow
-- in the world that points at where the current goal happens (your grill, your picnic tables,
-- your smoker, the Sauce Shack, or Big Bertha's bell). The server decides when a goal is met.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Rookie = require(Shared.Logic.Rookie)
local Net = require(script.Parent.Net)
local Hud = require(script.Parent.Hud)
local T = UI.Theme

local RookieGuide = {}
local refs: any = {}
local marker: Part? = nil
local beam: Beam? = nil
local a0: Attachment? = nil
local lastStep = -1
local GOLD = Color3.fromHex("#FFC83C")

local NEAR = 14 -- studs: close enough that the floor line hides and only the bobbing arrow stays
local W, H = 360, 188 -- card size; applyLayout may shorten it on a phone

-- "Rookie of the Ranch Bandana, the "Rookie of the Ranch" title and +250 🪙"
function RookieGuide.finishText(): string
	local fin = Config.RookieFinish
	local c = fin.cosmetic and Config.Cosmetics[fin.cosmetic]
	return Rookie.rewardText(fin, c and c.name or nil)
end

local function finishShort(): string
	local fin = Config.RookieFinish
	local c = fin.cosmetic and Config.Cosmetics[fin.cosmetic]
	return Rookie.rewardShort(fin, c and c.name or nil)
end

local function setConfirm(on: boolean)
	if refs.confirm then
		refs.confirm.Visible = on
	end
end

function RookieGuide.mount(root: GuiObject)
	local card = UI.frame({ Name = "RookieList", BackgroundColor3 = T.bg, BackgroundTransparency = 0.04, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 68), Size = UDim2.new(0, W, 0, H), Visible = false, Parent = root })
	UI.corner(card, 14)
	UI.stroke(card, GOLD, 2)
	UI.pad(card, 10)
	refs.card = card
	refs.head = UI.label(Content.Rookie.title, { Size = UDim2.new(1, -168, 0, 28), TextSize = 20, TextColor3 = GOLD, Parent = card })
	refs.count = UI.label("1/5", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -100, 0, 2), Size = UDim2.new(0, 52, 0, 28), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.dim, Parent = card })
	-- Skip (asks first). Skipped lists come back from Settings > Game.
	local skip = UI.button("Skip", T.card, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 92, 0, 44), TextSize = 18, Parent = card }, function()
		setConfirm(true)
	end)
	refs.skip = skip
	UI.corner(skip, 8)
	refs.goal = UI.label("", { Position = UDim2.new(0, 0, 0, 50), Size = UDim2.new(1, -96, 0, 32), TextSize = 20, Parent = card })
	refs.rewardCoin = UI.coin(card, 16)
	refs.rewardCoin.AnchorPoint = Vector2.new(1, 0)
	refs.rewardCoin.Visible = false
	refs.rewardCoin.ZIndex = 4
	refs.reward = UI.label("", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 50), Size = UDim2.new(0, 72, 0, 32), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = GOLD, Parent = card })
	local back, fill = UI.bar(card, T.green, { Position = UDim2.new(0, 0, 0, 88), Size = UDim2.new(1, -52, 0, 12) })
	refs.fill = fill
	refs.prog = UI.label("", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 84), Size = UDim2.new(0, 48, 0, 22), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.dim, Parent = card })
	refs.tip = UI.label("", { Position = UDim2.new(0, 0, 0, 106), Size = UDim2.new(1, 0, 0, 32), TextYAlignment = Enum.TextYAlignment.Top, TextSize = 16, Font = T.body, TextColor3 = T.dim, Parent = card })
	-- the finish reward, stated plainly from the start
	refs.finish = UI.label(string.format(Content.Rookie.finishLine, finishShort()), { Position = UDim2.new(0, 0, 0, 140), Size = UDim2.new(1, 0, 0, 36), TextYAlignment = Enum.TextYAlignment.Top, TextSize = 16, Font = T.body, TextColor3 = GOLD, Parent = card })
	local _ = back

	-- quick, friendly confirm that covers the card
	local confirm = UI.frame({ Name = "SkipConfirm", BackgroundColor3 = T.bg, Size = UDim2.new(1, 20, 1, 20), Position = UDim2.new(0, -10, 0, -10), ZIndex = 5, Visible = false, Parent = card })
	UI.corner(confirm, 14)
	UI.pad(confirm, 10)
	refs.confirm = confirm
	UI.label(string.format(Content.Rookie.skipAsk, RookieGuide.finishText()), { Size = UDim2.new(1, 0, 1, -52), TextYAlignment = Enum.TextYAlignment.Top, TextSize = 16, Font = T.body, ZIndex = 6, Parent = confirm })
	local keep = UI.button(Content.Rookie.skipKeep, T.green, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(0.5, -6, 0, 44), TextSize = 16, ZIndex = 6, Parent = confirm }, function()
		setConfirm(false)
	end)
	UI.corner(keep, 8)
	local yes = UI.button(Content.Rookie.skipYes, T.cardHi, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.new(0.5, -6, 0, 44), TextSize = 16, ZIndex = 6, Parent = confirm }, function()
		setConfirm(false)
		task.spawn(Net.act, "RookieSkip")
	end)
	UI.corner(yes, 8)
	RookieGuide.applyLayout()
end

function RookieGuide.applyLayout()
	local card = refs.card
	if not card then
		return
	end
	local b = Hud.box("rookie")
	local placed = b ~= nil and b.w > 0 and b.h > 0
	local short = UI.compact or (placed and b.h < 150)
	if placed then
		local w = math.max(1, UI.viewport.X)
		local h = math.max(1, UI.viewport.Y)
		card.AnchorPoint = Vector2.new(0, 0)
		card.Position = UDim2.fromScale(b.x / w, b.y / h)
		card.Size = UDim2.fromScale(b.w / w, b.h / h)
	elseif short then
		local top = UI.topChrome
		local height = math.max(92, UI.viewport.Y - top - UI.stationReserve)
		card.AnchorPoint = Vector2.new(0, 0)
		card.Position = UDim2.new(0, 8, 0, top)
		card.Size = UDim2.new(1, -16, 0, height)
	else
		card.AnchorPoint = Vector2.new(1, 0)
		card.Position = UDim2.new(1, -16, 0, 68)
		card.Size = UDim2.new(0, W, 0, H)
	end
	if short then
		refs.head.Size = UDim2.new(1, -150, 0, 22)
		refs.count.Position = UDim2.new(1, -100, 0, 0)
		refs.goal.Position = UDim2.new(0, 0, 0, 22)
		refs.goal.Size = UDim2.new(1, -150, 0, 22)
		refs.reward.Position = UDim2.new(1, -100, 0, 22)
		refs.reward.Size = UDim2.new(0, 78, 0, 20)
		refs.rewardCoin.Position = UDim2.new(1, -180, 0, 24)
		refs.tip.Visible = false
		refs.finish.Position = UDim2.new(0, 0, 0, 48)
		refs.finish.Size = UDim2.new(1, 0, 0, 28)
		local bar = refs.fill and refs.fill.Parent
		if bar and bar:IsA("Frame") then
			bar.Position = UDim2.new(0, 0, 0, 44)
			bar.Size = UDim2.new(1, -52, 0, 8)
		end
		refs.prog.Position = UDim2.new(1, 0, 0, 40)
		if refs.skip then
			refs.skip.Size = UDim2.fromOffset(88, 44)
		end
	else
		refs.head.Size = UDim2.new(1, -168, 0, 28)
		refs.count.Position = UDim2.new(1, -100, 0, 2)
		refs.goal.Position = UDim2.new(0, 0, 0, 50)
		refs.goal.Size = UDim2.new(1, -96, 0, 32)
		refs.reward.Position = UDim2.new(1, 0, 0, 50)
		refs.reward.Size = UDim2.new(0, 72, 0, 32)
		refs.rewardCoin.Position = UDim2.new(1, -74, 0, 58)
		refs.tip.Visible = true
		refs.finish.Position = UDim2.new(0, 0, 0, 140)
		refs.finish.Size = UDim2.new(1, 0, 0, 36)
		local bar = refs.fill and refs.fill.Parent
		if bar and bar:IsA("Frame") then
			bar.Position = UDim2.new(0, 0, 0, 88)
			bar.Size = UDim2.new(1, -52, 0, 12)
		end
		refs.prog.Position = UDim2.new(1, 0, 0, 84)
		if refs.skip then
			refs.skip.Size = UDim2.fromOffset(92, 44)
		end
	end
end

local function plotModel(s: any): Model?
	local map = workspace:FindFirstChild("Map")
	local plots = map and map:FindFirstChild("Plots")
	local m = plots and s.plot and plots:FindFirstChild("Plot" .. s.plot)
	return if m and m:IsA("Model") then m else nil
end

local function firstPart(inst: Instance?): BasePart?
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst
	end
	if inst:IsA("Model") then
		local p = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
		return p
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

-- Where the arrow goes for a goal.
local function targetPart(s: any, target: string): BasePart?
	local plot = plotModel(s)
	if target == "grill" then
		return plot and firstPart(plot:FindFirstChild("Grill") and (plot :: any).Grill:FindFirstChild("g1"))
	elseif target == "tables" then
		-- the picnic table closest to you (critters sit at all of them)
		local tables = plot and plot:FindFirstChild("Tables")
		if not tables then
			return nil
		end
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local best: BasePart? = nil
		local bestD = math.huge
		for _, t in ipairs(tables:GetChildren()) do
			local tp = firstPart(t)
			if tp then
				local d = if hrp then (tp.Position - hrp.Position).Magnitude else 0
				if d < bestD then
					best, bestD = tp, d
				end
			end
		end
		return best
	elseif target == "smoker" then
		local smokers = plot and plot:FindFirstChild("Smokers")
		if not smokers then
			return nil
		end
		for i = 1, s.slots.smoker do
			local key = "s" .. i
			if s.stations[key] == nil then
				local sm = smokers:FindFirstChild(key)
				return firstPart(sm and sm:FindFirstChild("Barrel"))
			end
		end
		return firstPart(smokers:FindFirstChild("s1") and (smokers :: any).s1:FindFirstChild("Barrel"))
	elseif target == "sauce" then
		local shack = workspace:FindFirstChild("SauceShack", true)
		return firstPart(shack and shack:FindFirstChild("Counter"))
	elseif target == "bell" then
		local bertha = workspace:FindFirstChild("BigBertha", true)
		local bell = bertha and bertha:FindFirstChild("DinnerBell")
		return firstPart(bell and bell:FindFirstChild("Bell"))
	end
	return nil
end

local function ensureMarker(): Part
	if marker and marker.Parent then
		return marker
	end
	local p = Instance.new("Part")
	p.Name = "RookieArrow"
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Transparency = 1
	p.Size = Vector3.new(0.5, 0.5, 0.5)
	p.Parent = workspace
	local bb = Instance.new("BillboardGui")
	bb.Name = "Arrow"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.new(0, 120, 0, 96)
	bb.StudsOffset = Vector3.new(0, 2.4, 0) -- tag on top, arrow tip just above the target
	bb.LightInfluence = 0
	bb.Parent = p
	local arrow = UI.label("▼", { Name = "Glyph", Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, 0, 0, 64), TextSize = 64, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = GOLD, TextStrokeTransparency = 0, Parent = bb })
	UI.label("", { Name = "Tag", Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, 30), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0, Parent = bb })
	-- bob the arrow up and down
	TweenService:Create(arrow, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.new(0, 0, 0, 20) }):Play()
	local a1 = Instance.new("Attachment")
	a1.Name = "To"
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = p
	local b = Instance.new("Beam")
	b.Name = "Trail"
	b.Color = ColorSequence.new(GOLD)
	b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 0.2) })
	b.Width0, b.Width1 = 0.35, 0.9
	b.FaceCamera = true
	b.LightEmission = 0.6
	b.Segments = 12
	b.Attachment1 = a1
	b.Parent = p
	marker = p
	beam = b
	return p
end

local function hide()
	if marker then
		marker.Parent = nil
	end
	if refs.card then
		refs.card.Visible = false
	end
	setConfirm(false)
end

local TAGS = { grill = "Flip here!", tables = "Hungry critters!", smoker = "Smoke here!", sauce = "Sauce Shack", bell = "Ring me!" }

function RookieGuide.update(s: any)
	if not refs.card then
		return
	end
	local b = Hud.box("rookie")
	local key = if b then string.format("%d,%d,%d,%d", b.x, b.y, b.w, b.h) else ""
	if key ~= refs.boxKey then
		refs.boxKey = key
		RookieGuide.applyLayout()
	end
	local st = s and s.rookie
	if not st or st.finished or not s.tutorial or not s.tutorial.done then
		hide()
		return
	end
	local def = Config.RookieSteps[st.step]
	refs.card.Visible = true
	refs.count.Text = string.format("%d/%d", st.step, st.total)
	refs.goal.Text = (def and def.icon or "") .. " " .. (st.label or "")
	local rw = st.reward or {}
	refs.reward.Text = (rw.coins and ("+" .. rw.coins) or "") .. (rw.cosmetic and " 🎁" or "")
	refs.rewardCoin.Visible = rw.coins ~= nil
	refs.fill.Size = UDim2.fromScale(st.amount > 0 and st.progress / st.amount or 0, 1)
	refs.prog.Text = string.format("%d/%d", st.progress, st.amount)
	refs.tip.Text = def and def.tip or ""
	if st.step ~= lastStep then
		lastStep = st.step
		local goal = refs.card.Size
		refs.card.Size = UDim2.new(goal.X.Scale, goal.X.Offset + 12, goal.Y.Scale, goal.Y.Offset + 6)
		TweenService:Create(refs.card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = goal }):Play()
	end

	local part = st.target and targetPart(s, st.target)
	if not part then
		if marker then
			marker.Parent = nil
		end
		return
	end
	local m = ensureMarker()
	if m.Parent ~= workspace then
		m.Parent = workspace
	end
	m.CFrame = CFrame.new(part.Position + Vector3.new(0, part.Size.Y / 2 + 1.5, 0))
	local tag = (m :: any).Arrow.Tag :: TextLabel
	tag.Text = TAGS[st.target] or ""
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and beam then
		if not a0 or a0.Parent ~= hrp then
			local att = Instance.new("Attachment")
			att.Name = "RookieFrom"
			att.Position = Vector3.new(0, -2.6, 0)
			att.Parent = hrp
			a0 = att
		end
		beam.Attachment0 = a0
		beam.Enabled = ((hrp :: BasePart).Position - part.Position).Magnitude > NEAR
	elseif beam then
		beam.Enabled = false
	end
end

return RookieGuide
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!strict
-- Sound effects: one SoundGroup, short one-shots and the grill's sizzle loop.
-- Players can turn sound effects off in Settings > Game (saved with their ranch).
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SfxIds = require(Shared.SfxIds) :: { [string]: any }

local Sfx = {}
local group: SoundGroup = nil :: any
local base: { [string]: Sound } = {}
local sizzle: Sound? = nil
local enabled = true
local lastPlayed: { [string]: number } = {}

function Sfx.mount()
	group = Instance.new("SoundGroup")
	group.Name = "BackyardSfx"
	group.Volume = 0.8
	group.Parent = SoundService
	local list = {}
	for name, def in pairs(SfxIds) do
		local s = Instance.new("Sound")
		s.Name = name
		s.SoundId = "rbxassetid://" .. tostring(def.id)
		s.Volume = def.volume or 0.5
		s.Looped = def.loop == true
		s.SoundGroup = group
		s.Parent = group
		base[name] = s
		table.insert(list, s)
	end
	sizzle = base.sizzleLoop
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(list)
		end)
	end)
end

function Sfx.setEnabled(on: boolean)
	enabled = on
	if group then
		group.Volume = on and 0.8 or 0
	end
	if not on and sizzle then
		sizzle:Stop()
	end
end

function Sfx.isEnabled(): boolean
	return enabled
end

-- Play a one-shot. `pitch` lets combos climb; `minGap` stops spam from rapid repeats.
function Sfx.play(name: string, pitch: number?, minGap: number?)
	local s = base[name]
	if not enabled or not s then
		return
	end
	local now = os.clock()
	if minGap and lastPlayed[name] and now - lastPlayed[name] < minGap then
		return
	end
	lastPlayed[name] = now
	local c = s:Clone()
	c.Looped = false
	c.PlaybackSpeed = pitch or 1
	c.Parent = group
	c:Play()
	local def = SfxIds[name]
	local life = (def and def.stop) or 6
	task.delay(life, function()
		if def and def.stop and c.IsPlaying then
			c:Stop()
		end
		c:Destroy()
	end)
end

-- The grill sizzles softly while any burger or steak is on it. The sound sits on your grill,
-- so it fades out as you walk away to the hub.
function Sfx.setSizzle(on: boolean, at: BasePart?)
	local s = sizzle
	if not s then
		return
	end
	local parent: Instance = at or group
	if s.Parent ~= parent then
		s.Parent = parent
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 12
		s.RollOffMaxDistance = 70
	end
	if on and enabled then
		if not s.IsPlaying then
			s:Play()
		end
	elseif s.IsPlaying then
		s:Stop()
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny UI kit: everything is built in code, so no uploaded images are needed.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudMenu = require(Shared:WaitForChild("Logic"):WaitForChild("HudMenu"))
local HudLayout = require(Shared:WaitForChild("Logic"):WaitForChild("HudLayout"))
local Numbers = require(Shared:WaitForChild("Logic"):WaitForChild("Numbers"))

local UI = {}

UI.Theme = {
	-- "Night Market" palette. Deep navy panels, cream type, BBQ-orange actions.
	-- No wood-brown surfaces. Gold stays a light fill so ink is used on it.
	bg = Color3.fromHex("#12263F"),
	panel = Color3.fromHex("#1A3354"),
	card = Color3.fromHex("#234268"),
	cardHi = Color3.fromHex("#2C5282"),
	accent = Color3.fromHex("#F26B1D"),
	gold = Color3.fromHex("#FFD15A"),
	green = Color3.fromHex("#1F9D57"),
	red = Color3.fromHex("#E23B4A"),
	blue = Color3.fromHex("#3D8BFF"),
	gift = Color3.fromHex("#E23B6A"),
	text = Color3.fromHex("#F5F9FF"),
	dim = Color3.fromHex("#D3E2F5"),
	ink = Color3.fromHex("#102033"),
	paper = Color3.fromHex("#F4F7FB"),
	stroke = Color3.fromHex("#8FB4D8"),
	font = Enum.Font.FredokaOne,
	body = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
}
local T = UI.Theme

-- Touch targets stay at least 44px. Compact is a short or narrow viewport (phones).
UI.TOUCH = 44
UI.viewport = Vector2.new(1280, 720)
UI.compact = false
UI.stationReserve = 188
UI.topChrome = 68

UI.onClick = nil :: (() -> ())?
-- Hud.applyLayout calls this after the boxes move, so toasts can follow the guide.
UI.onLayout = nil :: (() -> ())?

type Props = { [string]: any }

local function channel(u: number): number
	return if u <= 0.04045 then u / 12.92 else ((u + 0.055) / 1.055) ^ 2.4
end

function UI.luminance(c: Color3): number
	return 0.2126 * channel(c.R) + 0.7152 * channel(c.G) + 0.0722 * channel(c.B)
end

function UI.contrast(a: Color3, b: Color3): number
	local l1 = UI.luminance(a)
	local l2 = UI.luminance(b)
	local hi, lo = math.max(l1, l2), math.min(l1, l2)
	return (hi + 0.05) / (lo + 0.05)
end

-- Cream on dark fills, ink on light fills (gold, paper).
function UI.labelOn(bg: Color3): Color3
	local cream = UI.contrast(T.text, bg)
	local ink = UI.contrast(T.ink, bg)
	return if cream >= ink then T.text else T.ink
end

function UI.setViewport(v: Vector2)
	UI.viewport = v
	UI.compact = HudLayout.compact(v.X, v.Y)
end

UI.insets = { left = 0, top = 0, right = 0, bottom = 0 }

function UI.setInsets(insets: { left: number, top: number, right: number, bottom: number })
	UI.insets = insets
end

function UI.new(className: string, props: Props?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(parent: Instance, r: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 12), Parent = parent })
end

function UI.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return UI.new("UIStroke", { Color = color or T.stroke, Thickness = thickness or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

function UI.pad(parent: Instance, px: number)
	return UI.new("UIPadding", { PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), Parent = parent })
end

function UI.list(parent: Instance, dir: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		Parent = parent,
	})
end

function UI.frame(props: Props): Frame
	local f = UI.new("Frame", {
		BackgroundColor3 = T.panel,
		BorderSizePixel = 0,
	})
	for k, v in pairs(props) do
		(f :: any)[k] = v
	end
	return f
end

function UI.fitText(label: TextLabel | TextButton, maxSize: number, minSize: number?)
	local g = label :: any
	g.TextScaled = true
	g.TextWrapped = true
	UI.new("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = minSize or 14, Parent = label })
end

function UI.label(text: string, props: Props?): TextLabel
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.text,
		Font = T.font,
		TextScaled = false,
		TextSize = 20,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 28),
	})
	if props then
		for k, v in pairs(props) do
			(l :: any)[k] = v
		end
	end
	if l.TextSize < 15 and not l.TextScaled then
		l.TextSize = 15
	end
	return l
end

function UI.button(text: string, color: Color3?, props: Props?, onClick: (() -> ())?): TextButton
	local fill = color or T.accent
	local b = UI.new("TextButton", {
		Text = text,
		BackgroundColor3 = fill,
		TextColor3 = UI.labelOn(fill),
		Font = T.font,
		TextSize = 20,
		TextWrapped = true,
		AutoButtonColor = true,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 160, 0, UI.TOUCH),
	})
	local explicitColor = props ~= nil and props.TextColor3 ~= nil
	if props then
		for k, v in pairs(props) do
			(b :: any)[k] = v
		end
	end
	if not explicitColor then
		b.TextColor3 = UI.labelOn(b.BackgroundColor3)
	end
	if b.Size.Y.Scale == 0 and b.Size.Y.Offset > 0 and b.Size.Y.Offset < UI.TOUCH then
		b.Size = UDim2.new(b.Size.X.Scale, b.Size.X.Offset, 0, UI.TOUCH)
	end
	if b.Size.X.Scale == 0 and b.Size.X.Offset > 0 and b.Size.X.Offset < UI.TOUCH then
		b.Size = UDim2.new(0, UI.TOUCH, b.Size.Y.Scale, b.Size.Y.Offset)
	end
	UI.corner(b, 12)
	UI.stroke(b, T.stroke, 1.5)
	UI.fitText(b, math.max(b.TextSize, 16), 14)
	if onClick then
		-- One press must run the handler once. A ScrollingFrame can fire
		-- Activated twice for that press. Deferring the handler used to
		-- finish it and clear the guard before the second event, so a toggle
		-- opened a panel and closed it again in the same click.
		local gate = HudMenu.guard()
		b.Activated:Connect(function()
			if not gate:allow() then
				return
			end
			if UI.onClick then
				pcall(function()
					(UI.onClick :: any)()
				end)
			end
			local ok, err = pcall(function(): any
				(onClick :: any)()
				return nil
			end)
			if not ok then
				warn(err)
			end
			task.defer(function()
				gate:release()
			end)
		end)
	end
	return b
end

function UI.bar(parent: Instance, color: Color3, props: Props?): (Frame, Frame)
	local back = UI.frame({ BackgroundColor3 = Color3.fromHex("#0C1A2E"), Size = UDim2.new(1, 0, 0, 12), Parent = parent })
	if props then
		for k, v in pairs(props) do
			(back :: any)[k] = v
		end
	end
	UI.corner(back, 6)
	local fill = UI.frame({ BackgroundColor3 = color, Size = UDim2.new(0, 0, 1, 0), Parent = back })
	UI.corner(fill, 6)
	return back, fill
end

function UI.fmt(n: number): string
	return Numbers.abbrev(n)
end

-- A gold coin built from frames. No uploaded image.
function UI.coin(parent: Instance, px: number?): Frame
	local s = px or 22
	local f = UI.new("Frame", {
		Name = "Coin",
		BackgroundColor3 = Color3.fromHex("#F5C518"),
		Size = UDim2.fromOffset(s, s),
		BorderSizePixel = 0,
		Active = false,
		Parent = parent,
	})
	UI.corner(f, s)
	UI.new("UIStroke", { Color = Color3.fromHex("#B8860B"), Thickness = math.max(1.5, s / 9), ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f })
	local shine = UI.new("Frame", {
		Name = "Shine",
		BackgroundColor3 = Color3.fromHex("#FFF6C8"),
		Size = UDim2.fromScale(0.42, 0.26),
		Position = UDim2.fromScale(0.18, 0.14),
		BorderSizePixel = 0,
		Active = false,
		Parent = f,
	})
	UI.corner(shine, s)
	UI.new("TextLabel", {
		Name = "Glyph",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "$",
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.fromHex("#8A5A00"),
		TextScaled = true,
		Active = false,
		Parent = f,
	})
	return f
end

-- Puts a coin and an abbreviated amount inside a button. Clicks still hit the button.
function UI.fillPrice(button: TextButton, prefix: string, amount: number)
	local old = button:FindFirstChild("PriceRow")
	if old then
		old:Destroy()
	end
	button.Text = ""
	local row = UI.new("Frame", {
		Name = "PriceRow",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = button.ZIndex + 1,
		Active = false,
		Parent = button,
	})
	local list = UI.list(row, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	local function quiet(gui: GuiObject)
		gui.Active = false
		gui.Interactable = false
	end
	if prefix ~= "" then
		local word = UI.label(prefix, {
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = button.TextColor3,
			Font = T.bold,
			ZIndex = button.ZIndex + 2,
			Parent = row,
		})
		quiet(word)
	end
	local coin = UI.coin(row, 18)
	coin.LayoutOrder = 2
	coin.ZIndex = button.ZIndex + 2
	quiet(coin)
	local amt = UI.label(Numbers.abbrev(amount), {
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = button.TextColor3,
		Font = T.bold,
		LayoutOrder = 3,
		ZIndex = button.ZIndex + 2,
		Parent = row,
	})
	quiet(amt)
	quiet(row)
end

function UI.clear(parent: Instance)
	for _, c in ipairs(parent:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") and not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">WorldClient</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side world bits: which prompts you see, prompts that open UI, the trampoline,
-- the "Unc is resting his eyes" AFK tag, and live countdowns on your own smokers.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CaptureService = game:GetService("CaptureService")

local Net = require(script.Parent.Net)
local Hud = require(script.Parent.Hud)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local TimeUtil = require(Shared.Logic.TimeUtil)

local player = Players.LocalPlayer
local WorldClient = {}

-- "Say Brisket!" photo spot: grab a screenshot and open the native share sheet (falls back
-- to a save prompt where sharing isn't allowed). Everything is pcall'd: older clients just
-- get a friendly toast.
function WorldClient.photo()
	Net.notify("📸 Say BRISKET!", "good")
	task.delay(0.6, function()
		local ok = pcall(function()
			(CaptureService :: any):TakeScreenshotCaptureAsync(function(_result: any, capture: any)
				if capture then
					pcall(function()
						(CaptureService :: any):PromptShareCapture(Content.fromObject(capture), "bertha", function() end, function() end)
					end)
				end
			end, {})
		end)
		if not ok then
			Net.notify("Photos aren't available on this device. Use the Roblox menu's screenshot button!", "info")
		end
	end)
end

-- Prompts that only the owner should see, and the snag prompt the owner should NOT see.
local OWNER_ONLY = { serve = true, bellyrub = true, wash = true, catch = true }

local function shouldHide(prompt: ProximityPrompt): boolean
	local kind = prompt:GetAttribute("Kind")
	local owner = prompt:GetAttribute("OwnerUserId")
	if typeof(kind) ~= "string" then
		return false
	end
	if OWNER_ONLY[kind] then
		return owner ~= player.UserId
	end
	if kind == "snag" then
		return owner == player.UserId or (Net.state and Net.state.settings.peace)
	end
	return false
end

local function watchPrompt(prompt: ProximityPrompt)
	local function apply()
		if shouldHide(prompt) and prompt.Enabled then
			prompt.Enabled = false
		end
	end
	apply()
	prompt:GetPropertyChangedSignal("Enabled"):Connect(apply)
	prompt:GetAttributeChangedSignal("OwnerUserId"):Connect(apply)
end

function WorldClient.start(Panels: any)
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			watchPrompt(d)
		end
	end
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			watchPrompt(d)
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local kind = prompt:GetAttribute("Kind")
		if kind == "ui:sauce" then
			Panels.open("sauce")
		elseif kind == "ui:pitshop" then
			Panels.open("shop")
		elseif kind == "npc:unc" then
			Net.act("HearJoke")
		elseif kind == "ui:photo" then
			WorldClient.photo()
		elseif kind == "ui:hire" then
			Panels.open("hire")
		end
	end)

	-- Trampoline: big bounce (that's how you reach the Sauce Shack roof).
	local lastBounce = 0
	local function hookChar(char: Model)
		local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
		local hrp = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		if not hum or not hrp then
			return
		end
		hrp.Touched:Connect(function(hit)
			local power = hit:GetAttribute("Bounce")
			if typeof(power) == "number" and os.clock() - lastBounce > 0.4 then
				lastBounce = os.clock()
				local v = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
			end
		end)
	end
	if player.Character then
		task.spawn(hookChar, player.Character)
	end
	player.CharacterAdded:Connect(hookChar)

	-- AFK: "Unc is resting his eyes"
	local lastInput = os.clock()
	local resting = false
	UserInputService.InputBegan:Connect(function()
		lastInput = os.clock()
	end)
	UserInputService.TouchStarted:Connect(function()
		lastInput = os.clock()
	end)
	task.spawn(function()
		while true do
			task.wait(2)
			local idle = os.clock() - lastInput > Config.RESTING_IDLE_SECONDS
			if idle ~= resting then
				resting = idle
				Net.act("SetResting", resting)
			end
		end
	end)

	-- Live countdowns on your own smokers' billboards.
	task.spawn(function()
		while true do
			task.wait(0.5)
			local s = Net.state
			local map = workspace:FindFirstChild("Map")
			if s and s.plot and map then
				local plot = map.Plots:FindFirstChild("Plot" .. s.plot)
				if plot then
					for key, st in pairs(s.stations) do
						if string.sub(key, 1, 1) == "s" then
							local sm = plot.Smokers:FindFirstChild(key)
							local gui = sm and sm.Barrel:FindFirstChild("SlotGui")
							local label = gui and gui:FindFirstChild("Text") :: TextLabel?
							if label then
								local _, remaining, done = Hud.view(st, s.boost)
								local meat = Config.Meats[st.meat]
								label.Text = meat.icon .. " " .. meat.name .. (done and "\n✅ Ready!" or ("\n" .. TimeUtil.formatDuration(remaining)))
							end
						end
					end
				end
			end
		end
	end)
end

return WorldClient
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
