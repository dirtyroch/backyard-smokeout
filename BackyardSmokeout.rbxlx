      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
-- Same-side signal that keeps the caller's arguments.
-- A BindableEvent is the wrong tool for this: Roblox deep-copies tables, drops
-- metatables and functions, and the copy is not the value the sender fired.
-- Listeners run on their own threads so one error cannot cancel the others.
local Signal = {}
Signal.__index = Signal

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

type Handler = (...any) -> ()

export type Signal = typeof(setmetatable(
	{} :: {
		Event: any,
		_next: number,
		_order: { number },
		_handlers: { [number]: Handler },
	},
	Signal
))

function Signal.new(): Signal
	local self = setmetatable({
		Event = nil :: any,
		_next = 0,
		_order = {},
		_handlers = {},
	}, Signal)
	-- BindableEvent callers use `.Event:Connect`. Event is this signal.
	self.Event = self
	return self
end

function Signal.Connect(self: Signal, fn: Handler): Connection
	self._next += 1
	local id = self._next
	self._handlers[id] = fn
	table.insert(self._order, id)
	local conn: Connection = {
		Connected = true,
		Disconnect = function(connSelf: Connection)
			if not connSelf.Connected then
				return
			end
			connSelf.Connected = false
			self._handlers[id] = nil
			local order = self._order
			for i, got in ipairs(order) do
				if got == id then
					table.remove(order, i)
					break
				end
			end
		end,
	}
	return conn
end

function Signal.Fire(self: Signal, ...: any)
	local packed = table.pack(...)
	-- Snapshot first so a listener can disconnect or connect during the fire.
	local fns: { Handler } = {}
	for _, id in ipairs(self._order) do
		local fn = self._handlers[id]
		if fn then
			table.insert(fns, fn)
		end
	end
	for _, fn in ipairs(fns) do
		local handler = fn
		task.spawn(function()
			handler(table.unpack(packed, 1, packed.n))
		end)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	WorldBuilder — builds the whole map out of plain Parts (no uploaded assets needed).
	It only uses Instance.new + datatypes passed in through `env`, so it runs both:
	  * in Roblox (server builds the map at startup if Workspace.Map is missing), and
	  * in Lune (scripts/bake-map.luau bakes the map into BackyardSmokeout.rbxlx so it
	    shows up in Studio's edit mode and in your thumbnails).
	Every interactive thing is a ProximityPrompt with a "Kind" attribute that the server or
	client dispatches on.
]]
local WorldBuilder = {}

WorldBuilder.PLOT_RADIUS = 150
WorldBuilder.PLOT_SIZE = 64
WorldBuilder.SMOKER_X = { -24, -16, -8, 0, 8, 16, 24 }
WorldBuilder.GRILL_X = { -27, -22, -17, -12 }

-- Midpoint, in degrees, of the gap after ranch `index` (1 sits between plot 1 and plot 2).
function WorldBuilder.gapDegrees(plots: number, index: number): number
	return (index - 0.5) / plots * 360
end

-- The neighborhood scenes were laid out on the 8-ranch gaps. Snap an old angle onto the
-- nearest gap so two extra ranches don't land on a tailgate, an oak, or a pasture.
function WorldBuilder.nearestGap(plots: number, degrees: number): number
	local best, bestD = degrees, 1e9
	for i = 1, plots do
		local g = WorldBuilder.gapDegrees(plots, i)
		local d = math.abs((degrees - g + 180) % 360 - 180)
		if d < bestD then
			best, bestD = g, d
		end
	end
	return best
end

local E -- env (Roblox globals: Instance, Vector3, CFrame, Color3, Enum, UDim2)

function WorldBuilder.setEnv(env)
	E = env
end

local function hex(h)
	return E.Color3.fromHex(h)
end

local function part(parent, name, size, cf, color, material, props)
	local p = E.Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = hex(color)
	p.Material = material or E.Enum.Material.SmoothPlastic
	p.TopSurface = E.Enum.SurfaceType.Smooth
	p.BottomSurface = E.Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end
WorldBuilder.part = part

local function model(parent, name)
	local m = E.Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function folder(parent, name)
	local f = E.Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Attribute plus CollectionService tag when the engine has it. Lune bakes the attribute either way.
local function streamTag(inst, tag)
	inst:SetAttribute("StreamTag", tag)
	pcall(function()
		inst:AddTag(tag)
	end)
end

local function V(x, y, z)
	return E.Vector3.new(x, y, z)
end

local function lookAt(a, b)
	if E.CFrame.lookAt then
		return E.CFrame.lookAt(a, b)
	end
	return E.CFrame.new(a, b)
end

-- Thin edge of a WedgePart points along local -Z. Point that at the beak tip or the feather tip.
local function wedge(parent, name, size, cf, color, material, props)
	local p = E.Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = hex(color)
	p.Material = material or E.Enum.Material.SmoothPlastic
	p.TopSurface = E.Enum.SurfaceType.Smooth
	p.BottomSurface = E.Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function cyl(parent, name, length, diameter, cf, color, material, props)
	-- Roblox cylinders run along X. `cf` is the center.
	local p = part(parent, name, V(length, diameter, diameter), cf, color, material, props)
	p.Shape = E.Enum.PartType.Cylinder
	return p
end

local function ball(parent, name, d, cf, color, material, props)
	local p = part(parent, name, V(d, d, d), cf, color, material, props)
	p.Shape = E.Enum.PartType.Ball
	return p
end

local function prompt(parent, kind, action, object, hold, dist, extra)
	local pp = E.Instance.new("ProximityPrompt")
	pp.Name = "Prompt"
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = dist or 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Kind", kind)
	if extra then
		for k, v in pairs(extra) do
			pp[k] = v
		end
	end
	pp.Parent = parent
	return pp
end
WorldBuilder.prompt = prompt

local function surfaceText(p, face, text, textColor, bg, font)
	local sg = E.Instance.new("SurfaceGui")
	sg.Name = "SignGui"
	sg.Face = face or E.Enum.NormalId.Front
	sg.SizingMode = E.Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 52
	sg.Parent = p
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = E.UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = bg and 0 or 1
	if bg then
		tl.BackgroundColor3 = hex(bg)
	end
	tl.TextColor3 = hex(textColor or "#FFFFFF")
	tl.Font = font or E.Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.TextStrokeTransparency = 0.45
	tl.TextStrokeColor3 = hex("#2A1A12")
	tl.Text = text
	tl.Parent = sg
	return tl
end
WorldBuilder.surfaceText = surfaceText

-- A small cream board by Unc's grill. Original yard notes, big enough to read from the path.
function WorldBuilder.yardBoard(parent, content)
	if parent:FindFirstChild("YardBoard") then
		return
	end
	local notes = content and content.YardNotes
	local text = (notes and notes.board) or "TODAY'S BOARD"
	local cf = E.CFrame.new(-12.5, 3.6, 18.5) * E.CFrame.Angles(0, math.rad(28), 0)
	local group = model(parent, "YardBoard")
	part(group, "Post", V(0.4, 3.4, 0.4), cf * E.CFrame.new(0, -2.4, 0), "#6B4226", E.Enum.Material.Wood)
	part(group, "Board", V(8.4, 4.6, 0.35), cf, "#6B4226", E.Enum.Material.Wood)
	local face = part(group, "Face", V(7.6, 3.9, 0.12), cf * E.CFrame.new(0, 0, -0.22), "#F6E2C4", E.Enum.Material.SmoothPlastic)
	local sg = E.Instance.new("SurfaceGui")
	sg.Name = "SignGui"
	sg.Face = E.Enum.NormalId.Front
	sg.SizingMode = E.Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 42
	sg.Parent = face
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Position = E.UDim2.new(0.06, 0, 0.08, 0)
	tl.Size = E.UDim2.new(0.88, 0, 0.84, 0)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = hex("#2A140C")
	tl.Font = E.Enum.Font.GothamBold
	tl.TextScaled = true
	tl.TextWrapped = true
	tl.Text = text
	tl.Parent = sg
end

-- `studs` (optional {w, h} or {w, h, minPxW, minPxH}) sizes the label in world studs instead of
-- pixels, so labels on closely spaced things (smoker row, grill spots, customer tables, the hub
-- NPCs) shrink with distance instead of piling on top of each other. The optional pixel part keeps
-- a readable floor far away (Roblox adds it on top of the stud size).
local function billboard(adornee, name, text, offsetY, maxDist, color, w, h, studs: { number }?)
	local b = E.Instance.new("BillboardGui")
	b.Name = name
	if studs then
		b.Size = E.UDim2.new(studs[1], studs[3] or 0, studs[2], studs[4] or 0)
	else
		b.Size = E.UDim2.new(0, w or 160, 0, h or 40)
	end
	b.StudsOffset = V(0, offsetY or 3, 0)
	b.AlwaysOnTop = false
	b.MaxDistance = maxDist or 80
	b.LightInfluence = 0
	b.Parent = adornee
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = E.UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = hex(color or "#FFFFFF")
	tl.TextStrokeTransparency = 0.3
	tl.Font = E.Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = text
	tl.Parent = b
	return b
end
WorldBuilder.billboard = billboard

-- Decorative parts: no collision, query or touch (shadow is opt-in).
local function deco(parent, name, size, cf, color, material, shadow)
	return part(parent, name, size, cf, color, material, { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = shadow == true })
end
local function dball(parent, name, d, cf, color, material, shadow)
	local p = deco(parent, name, V(d, d, d), cf, color, material, shadow)
	p.Shape = E.Enum.PartType.Ball
	return p
end
local function dcyl(parent, name, length, diameter, cf, color, material, shadow)
	local p = deco(parent, name, V(length, diameter, diameter), cf, color, material, shadow)
	p.Shape = E.Enum.PartType.Cylinder
	return p
end

local function upright()
	return E.CFrame.Angles(0, 0, math.pi / 2) -- turns an X-axis cylinder upright
end

-- Ellipsoid part (a Part with a Sphere SpecialMesh) for soft, round shapes.
local function sph(parent, name, size, cf, color, material, props)
	local p = part(parent, name, size, cf, color, material, props)
	local mesh = E.Instance.new("SpecialMesh")
	mesh.MeshType = E.Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- A round, chibi-proportioned NPC: a big head, a soft pear-shaped body, mitten hands, and
-- shiny eyes with rosy cheeks. Feet at `cf`, facing -Z. Part names Head and Torso are what
-- the game looks up (prompts and name tags hang off them).
-- Options: skin, shirt, pants, shoes, hair, hat ("cowboy" | "cap" | "bun"), hatColor, apron,
-- apronText, glasses, mustache, beard, belly, brows, label, labelColor, scale.
function WorldBuilder.npc(parent, name, cf, o)
	o = o or {}
	local m = model(parent, name)
	local skin = o.skin or "#E0AC69"
	local shirt = o.shirt or "#4A6FA5"
	local pants = o.pants or "#3B3B3B"
	local shoes = o.shoes or "#3A2A1E"
	local dark = "#2A1E1A"
	local s = o.scale or 1
	local function at(x, y, z, rx, ry, rz)
		return cf * E.CFrame.new(x * s, y * s, z * s) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	local function e(n, sx, sy, sz, c, x, y, z, rx, ry, rz, mat)
		return sph(m, n, V(sx * s, sy * s, sz * s), at(x, y, z, rx, ry, rz), c, mat)
	end
	-- legs and shoes
	local legL = cyl(m, "LeftLeg", 1.3 * s, 0.8 * s, at(-0.45, 1.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), pants)
	local legR = cyl(m, "RightLeg", 1.3 * s, 0.8 * s, at(0.45, 1.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), pants)
	if o.sandals then
		-- socks with sandals: white socks on a brown sole with a strap
		for _, side in { -1, 1 } do
			e("Sock", 0.85, 0.75, 1.2, "#F7F7F2", side * 0.47, 0.42, -0.12)
			e("Sole", 1.0, 0.22, 1.45, "#7A4A2A", side * 0.47, 0.1, -0.15)
			deco(m, "Strap", V(0.9 * s, 0.16 * s, 0.25 * s), at(side * 0.47, 0.55, -0.55), "#7A4A2A", E.Enum.Material.SmoothPlastic, false)
		end
	else
		e("ShoeL", 0.95, 0.6, 1.35, shoes, -0.47, 0.3, -0.15)
		e("ShoeR", 0.95, 0.6, 1.35, shoes, 0.47, 0.3, -0.15)
	end
	-- body: hips + a soft torso (rounder for a belly)
	e("Hips", 2.0, 1.1, 1.6, pants, 0, 1.75, 0)
	if o.buckle then
		e("Belt", 2.05, 0.3, 1.65, "#3A2414", 0, 2.05, 0)
		e("Buckle", 0.6, 0.42, 0.2, o.buckle, 0, 2.05, -0.82, 0, 0, 0, E.Enum.Material.Foil)
	end
	local bw, bd = o.belly and 2.6 or 2.2, o.belly and 2.3 or 1.75
	local torso = sph(m, "Torso", V(bw * s, 2.5 * s, bd * s), at(0, 2.75, 0), shirt)
	if o.apron then
		-- a soft bib that hugs the front of the torso, with a flat name patch on it
		e("ApronBib", bw * 0.78, 2.3, bd * 1.0, o.apron, 0, 2.6, -bd * 0.12, 0, 0, 0)
		local ap = part(m, "Apron", V(1.25 * s, 0.6 * s, 0.05 * s), at(0, 2.55, -bd * 0.62 - 0.01), o.apron, E.Enum.Material.Fabric)
		ap.CanCollide = false
		if o.apronText then
			surfaceText(ap, E.Enum.NormalId.Front, o.apronText, "#FFFFFF", nil)
		end
	end
	-- arms: sleeves angled out a little, mitten hands
	for _, side in { -1, 1 } do
		local ax = side * (bw / 2 + 0.2)
		e(side < 0 and "LeftArm" or "RightArm", 0.75, 1.7, 0.75, shirt, ax, 2.85, 0, 0, 0, side * 16)
		e(side < 0 and "HandL" or "HandR", 0.7, 0.7, 0.7, skin, ax + side * 0.25, 1.95, -0.05)
	end
	-- head: a big round face
	local head = sph(m, "Head", V(2.5 * s, 2.4 * s, 2.35 * s), at(0, 4.85, 0), skin)
	e("EarL", 0.38, 0.6, 0.35, skin, -1.24, 4.85, 0.05)
	e("EarR", 0.38, 0.6, 0.35, skin, 1.24, 4.85, 0.05)
	for _, side in { -1, 1 } do
		e(side < 0 and "EyeL" or "EyeR", 0.34, 0.5, 0.2, dark, side * 0.45, 5.0, -1.08)
		e(side < 0 and "ShineL" or "ShineR", 0.13, 0.13, 0.08, "#FFFFFF", side * 0.45 - 0.07, 5.12, -1.18, 0, 0, 0, E.Enum.Material.Neon)
		e(side < 0 and "CheekL" or "CheekR", 0.5, 0.3, 0.12, "#F28B82", side * 0.78, 4.6, -0.98)
		if o.brows ~= false then
			deco(m, "Brow", V(0.5 * s, 0.12 * s, 0.1 * s), at(side * 0.45, 5.42, -1.06, 0, 0, side * -8), o.hair or dark, E.Enum.Material.SmoothPlastic, false)
		end
	end
	e("Nose", 0.4, 0.34, 0.3, skin, 0, 4.68, -1.18)
	if o.mustache then
		e("Mustache", 1.25, 0.36, 0.4, o.mustache, 0, 4.42, -1.12)
		e("Smile", 0.5, 0.16, 0.12, "#7A2E2E", 0, 4.18, -1.13)
	else
		e("Smile", 0.66, 0.2, 0.12, "#7A2E2E", 0, 4.32, -1.14)
	end
	if o.beard then
		e("Beard", 1.7, 0.9, 1.0, o.beard, 0, 3.9, -0.75)
	end
	if o.glasses then
		for _, side in { -1, 1 } do
			local lens = cyl(m, "Glasses", 0.08 * s, 0.75 * s, at(side * 0.45, 5.0, -1.2) * E.CFrame.Angles(0, math.pi / 2, 0), "#BFE3FF", E.Enum.Material.Glass, { Transparency = 0.55 })
			lens.CanCollide = false
			deco(m, "GlassesRim", V(0.8 * s, 0.08 * s, 0.06 * s), at(side * 0.45, 5.38, -1.2), "#3A2A1E", E.Enum.Material.SmoothPlastic, false)
		end
		deco(m, "GlassesBridge", V(0.2 * s, 0.07 * s, 0.06 * s), at(0, 5.1, -1.22), "#3A2A1E", E.Enum.Material.SmoothPlastic, false)
	end
	-- hair and hats
	if o.hair and o.hat ~= "cowboy" then
		e("Hair", 2.6, 1.35, 2.5, o.hair, 0, 5.55, 0.12)
	end
	if o.hat == "cowboy" then
		local hc = o.hatColor or "#3B2A1A"
		cyl(m, "HatBrim", 0.18 * s, 4.3 * s, at(0, 5.75, 0) * E.CFrame.Angles(0, 0, math.pi / 2), hc)
		e("HatBrimCurlL", 0.9, 0.5, 3.6, hc, -1.85, 5.95, 0)
		e("HatBrimCurlR", 0.9, 0.5, 3.6, hc, 1.85, 5.95, 0)
		e("HatCrown", 2.3, 1.6, 2.1, hc, 0, 6.4, 0)
		cyl(m, "HatBand", 0.3 * s, 2.32 * s, at(0, 6.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), o.hatBand or "#8B5A2B")
	elseif o.hat == "cap" then
		local hc = o.hatColor or "#B22222"
		e("Cap", 2.6, 1.5, 2.5, hc, 0, 5.6, 0.05)
		e("Bill", 1.8, 0.2, 1.3, hc, 0, 5.4, -1.2)
		e("CapButton", 0.3, 0.2, 0.3, "#FFFFFF", 0, 6.33, 0.05)
	elseif o.hat == "bun" then
		e("Hair", 2.6, 1.35, 2.5, o.hatColor or "#DDDDDD", 0, 5.55, 0.12)
		e("Bun", 1.15, 1.05, 1.15, o.hatColor or "#DDDDDD", 0, 6.25, 0.45)
		if o.pearls then
			for k = -2, 2 do
				dball(m, "Pearl", 0.22 * s, at(k * 0.32, 3.95 - math.abs(k) * 0.05, -0.82 + math.abs(k) * 0.08), "#FFF8E7", E.Enum.Material.SmoothPlastic, false)
			end
		end
	end
	for _, c in ipairs(m:GetDescendants()) do
		if c:IsA("BasePart") then
			c.CanCollide = c == torso or c == legL or c == legR
			-- Prompts hang off the torso and the name tag off the head. Those two
			-- have to stay queryable or "Say howdy" never appears.
			c.CanQuery = true
		end
	end
	m.PrimaryPart = torso
	if o.label then
		billboard(head, "NameTag", o.label, 2.8, 60, o.labelColor or "#FFE9A8", 200, 36, { 4, 0.8, 80, 16 })
	end
	return m, head, torso
end

-- A critter customer, built from parts so the silhouette reads across the yard.
-- Feet sit on `cf`, facing -Z. The game looks up Body and Head (prompts, order bubbles, mud).
-- Parts stay anchored: customers, Jimothy and the crew all move with PivotTo.
local function lighten(c, t)
	return "#" .. hex(c):Lerp(E.Color3.new(1, 1, 1), t):ToHex()
end

function WorldBuilder.critter(env, parent, def, cf)
	E = env
	local m = model(parent, def.id)
	local s = def.scale or 1
	local id = def.id
	local function at(x, y, z, rx, ry, rz)
		return cf * E.CFrame.new(x * s, y * s, z * s) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	local function e(n, sx, sy, sz, c, x, y, z, rx, ry, rz, mat)
		return sph(m, n, V(sx * s, sy * s, sz * s), at(x, y, z, rx, ry, rz), c, mat)
	end
	local BC, HC = def.body, def.head
	local DARK = "#1A120E"
	local body, head
	local eyeY, eyeZ, eyeX, eyeSize = 2.2, -1.7, 0.36, 1
	local iris, pupil = "#FFFFFF", DARK
	local skipEyes = false

	local function paw(x, z, tall, color, wide)
		local col = color or BC
		cyl(m, "Leg", tall * s, (wide or 0.22) * s, at(x, tall * 0.5, z) * E.CFrame.Angles(0, 0, math.pi / 2), col)
		part(m, "Paw", V((wide or 0.22) * 1.7 * s, 0.1 * s, (wide or 0.22) * 1.9 * s), at(x, 0.06, z - 0.1), col)
	end
	local function eyesAt(y, z, x, scale)
		for _, side in ipairs({ -1, 1 }) do
			local ex = side * x
			local d = 0.46 * scale * s
			ball(m, side < 0 and "EyeL" or "EyeR", d, at(ex, y, z), iris)
			ball(m, "Pupil", d * 0.48, at(ex + side * 0.02, y - 0.01, z - 0.04 * scale), pupil)
			ball(m, side < 0 and "ShineL" or "ShineR", d * 0.28, at(ex - 0.06, y + 0.06 * scale, z - 0.07 * scale), "#FFFFFF", E.Enum.Material.Neon)
		end
	end

	if def.rex then
		body = e("Body", 2.2, 2.5, 2.15, BC, 0, 2.15, 0.15)
		e("Belly", 1.55, 1.9, 1.15, "#E7F6C4", 0, 1.9, -0.55)
		head = e("Head", 2.05, 1.75, 2.15, HC, 0, 4.15, -0.85)
		e("Snout", 1.35, 0.85, 1.25, lighten(HC, 0.15), 0, 3.85, -1.7)
		e("Brow", 1.5, 0.28, 0.4, lighten(BC, 0.05), 0, 4.55, -1.35)
		for k = -2, 2 do
			part(m, "Tooth", V(0.16 * s, 0.28 * s, 0.12 * s), at(k * 0.28, 3.42, -2.15), "#FFFFFF")
		end
		e("NostrilL", 0.16, 0.1, 0.1, DARK, -0.28, 4.15, -2.25)
		e("NostrilR", 0.16, 0.1, 0.1, DARK, 0.28, 4.15, -2.25)
		e("ArmL", 0.38, 0.85, 0.38, BC, -1.15, 2.7, -0.7, 50, 0, 18)
		e("ArmR", 0.38, 0.85, 0.38, BC, 1.15, 2.7, -0.7, 50, 0, -18)
		e("HandL", 0.32, 0.28, 0.32, HC, -1.35, 2.25, -1.05)
		e("HandR", 0.32, 0.28, 0.32, HC, 1.35, 2.25, -1.05)
		e("Tail", 0.85, 0.85, 2.4, BC, 0, 1.7, 2.15, -18, 0, 0)
		e("TailTip", 0.55, 0.5, 0.7, lighten(BC, 0.2), 0, 1.35, 3.2)
		paw(-0.7, 0.15, 1.15, BC, 0.38)
		paw(0.7, 0.15, 1.15, BC, 0.38)
		for k = 0, 4 do
			e("Spike", 0.28, 0.62, 0.4, "#3E8E32", 0, 3.35 - k * 0.42, -0.2 + k * 0.55)
		end
		part(m, "Ribbon", V(1.7 * s, 0.28 * s, 0.2 * s), at(0, 3.35, -1.15), "#FF5C8A")
		e("BowL", 0.55, 0.4, 0.22, "#FF5C8A", -0.42, 3.4, -1.28, 0, 0, 22)
		e("BowR", 0.55, 0.4, 0.22, "#FF5C8A", 0.42, 3.4, -1.28, 0, 0, -22)
		billboard(head, "Ribbon", def.ribbon or "RAWR means I love you ♥", 2.6, 70, "#FF8FB1", 260, 34)
		eyeY, eyeZ, eyeX, eyeSize = 4.55, -1.7, 0.48, 1.35
		iris, pupil = "#F4FFF0", DARK
	elseif id == "roadrunner" or id == "hummingbird" then
		local hb = id == "hummingbird"
		skipEyes = true
		local yaw = E.CFrame.Angles(0, math.pi / 2, 0)
		body = cyl(m, "Body", (hb and 1.35 or 2.15) * s, (hb and 0.55 or 0.78) * s, at(0, hb and 1.35 or 1.7, 0.1) * yaw, BC)
		cyl(m, "Chest", (hb and 0.5 or 0.62) * s, (hb and 0.48 or 0.62) * s, at(0, hb and 1.42 or 1.78, -0.45) * yaw, lighten(BC, 0.45))
		head = sph(m, "Head", V((hb and 0.72 or 0.92) * s, (hb and 0.62 or 0.8) * s, (hb and 0.7 or 0.88) * s), at(0, hb and 1.85 or 2.45, hb and -0.85 or -1.05), HC)
		local beakLen = hb and 1.05 or 0.85
		wedge(m, "Beak", V((hb and 0.14 or 0.26) * s, (hb and 0.12 or 0.2) * s, beakLen * s), at(0, hb and 1.78 or 2.28, hb and -1.55 or -1.75), hb and "#1A1A1A" or "#E6C07A")
		if hb then
			e("Gorget", 0.28, 0.22, 0.16, "#FF4F8B", 0, 1.62, -1.05)
		else
			wedge(m, "Crest", V(0.1 * s, 0.72 * s, 0.42 * s), at(0, 2.95, -0.85, -28, 0, 0), "#1E3A5F")
			part(m, "CheekPatch", V(0.62 * s, 0.14 * s, 0.06 * s), at(0, 2.22, -1.32), "#E2572E")
		end
		local feather = hb and "#7DFFB2" or lighten(BC, 0.3)
		for _, side in ipairs({ -1, 1 }) do
			local feathers = hb and 3 or 2
			for i = 1, feathers do
				local z = (i - 2) * (hb and 0.22 or 0.32)
				wedge(m, "Feather", V((hb and 0.07 or 0.1) * s, (hb and 0.85 or 0.95) * s, (hb and 0.42 or 0.5) * s), at(side * (hb and 0.48 or 0.62), hb and 1.5 or 1.85, z, 0, side * (hb and 58 or 42), side * 16), feather)
			end
			wedge(m, "Tail", V((hb and 0.08 or 0.12) * s, (hb and 0.28 or 0.36) * s, (hb and 0.85 or 1.25) * s), at(side * 0.1, hb and 1.2 or 1.45, hb and 0.95 or 1.45, -20, side * 14, 0), hb and "#147A45" or BC)
			cyl(m, "Leg", (hb and 0.48 or 1.15) * s, (hb and 0.07 or 0.1) * s, at(side * 0.18, hb and 0.4 or 0.62, 0.05) * E.CFrame.Angles(0, 0, math.pi / 2), "#E6C07A")
			for t = -1, 1 do
				part(m, "Toe", V((hb and 0.2 or 0.34) * s, 0.05 * s, 0.07 * s), at(side * 0.18 + t * 0.07, 0.05, hb and -0.06 or -0.12), "#E6C07A")
			end
			local ex = side * (hb and 0.16 or 0.2)
			local ey = hb and 1.95 or 2.58
			local ez = hb and -1.12 or -1.4
			ball(m, "EyeWhite", (hb and 0.16 or 0.2) * s, at(ex, ey, ez), "#FFFFFF")
			ball(m, "Pupil", (hb and 0.08 or 0.1) * s, at(ex, ey, ez - 0.03), DARK)
			ball(m, "Shine", (hb and 0.045 or 0.06) * s, at(ex - 0.03, ey + 0.03, ez - 0.05), "#FFFFFF", E.Enum.Material.Neon)
		end
	elseif id == "jimothy" then
		-- Round, no neck: the head sits down inside the ball. Bandit is the long raccoon.
		local BELLY, MASK, MUZZLE, NOSE = "#E4D5C4", "#1A120E", "#F4EDE4", "#2A1C16"
		body = e("Body", 2.5, 2.4, 2.5, BC, 0, 1.32, 0.08)
		e("Belly", 1.45, 1.1, 1.1, BELLY, 0, 1.05, -0.82)
		head = e("Head", 1.68, 1.36, 1.5, HC, 0, 2.36, -0.26)
		e("Mask", 1.55, 0.44, 0.3, MASK, 0, 2.48, -0.92)
		e("Muzzle", 0.8, 0.48, 0.55, MUZZLE, 0, 2.16, -1.02)
		e("Nose", 0.26, 0.2, 0.18, NOSE, 0, 2.22, -1.28)
		e("CheekL", 0.26, 0.15, 0.1, "#F7A1A9", -0.46, 2.1, -1.02)
