	looks = { "club_apron", "club_hat", "club_trail", "club_smoke", "club_skin", "club_bandana" },
	title = "Pit Crew",
	monthlyTierSkips = 1, -- one free Smokehouse Pass tier each month you're a member
	showerMinutes = 5, -- the once-a-day Pit Crew Smoke Shower for everyone in the server
}

-- Roblox Premium: a free look for members. No coins, no stats.
Config.Premium = { look = "premium_bandana" }

-- Private servers (price is set on the Creator Dashboard, see PUBLISHING.md). The owner gets a
-- "Host" tag and can share a Smoke Shower with everyone in their server every 10 minutes.
-- Cook speed only; the Cook-Off and snagging aren't touched.
Config.PrivateServer = { hostShowerCooldown = 600, hostTitle = "Ranch Host" }
Config.FairPlay = { passTipMult = 1.5, passTipCap = 1.5, showerMinutes = 5, showerMult = 1.25 }

-- Big Bertha's Dinner Bell: 3 different players ring the bell within 20 s, and the whole server
-- gets +25% tips for 5 minutes (free, with a 10 minute cooldown).
Config.DinnerBell = { window = 20, need = 3, cooldown = 600, minutes = 5, tipBonus = 0.25, ringCooldown = 30 } -- ringCooldown: a player's ring counts once per 30 s (anti-mash)

-- Lunch Rush: every 150 s window, serve 4 plates for +50% of what those plates earned.
-- Kept for one release. Config.Chores.lunchRush turns the payout and the HUD line off.
Config.Rush = { period = 150, need = 4, bonusFrac = 0.5 }

-- Crew core loop. Coin prices are fixed per species (and per visible trait). Nothing here is a Robux roll.
-- Tier 2 is priced so one 1 coin/s hire reaches it in about two minutes from the starting purse.
-- Tier 8 is a long ranch goal: a few hours once the lineup has gotten rarer.
Config.Hiring = {
	period = 300, -- shared lineup, same 5-minute cadence as the sauce shack
	count = 6,
	rexChance = 0.002, -- about 0.2% of lineups include the secret Rex
	levelBonus = 0.15, -- +15% of base coins/s per level above 1
	maxLevel = 10,
	startSlots = 3,
	slotsPerTier = 2, -- tier 1 is 3 slots, each tier after adds 2, tier 8 is 17
	maxSlots = 23, -- tier 8, plus 2 legacy slots, plus the Bunkhouse's 4
	bunkhouseSlots = 4,
	workSeconds = 8,
	cheapPrice = 50, -- every lineup keeps at least two applicants at or under the starting purse
	cheapCount = 2,
	starterDelay = 2, -- seconds before Pip starts walking over
	starterWalk = 6, -- fallback if the path length is not ready yet
	walkSpeed = 12, -- studs per second, a stroll rather than a scoot
}
Config.CrewRarities = {
	{ id = "common", name = "Common", color = "#E7E2DA", order = 1 },
	{ id = "uncommon", name = "Uncommon", color = "#5AD2FF", order = 2 },
	{ id = "rare", name = "Rare", color = "#7DCE6A", order = 3 },
	{ id = "epic", name = "Epic", color = "#C58BFF", order = 4 },
	{ id = "legendary", name = "Legendary", color = "#FFC83C", order = 5 },
	{ id = "mythic", name = "Mythic", color = "#FF6B6B", order = 6 },
	{ id = "secret", name = "Secret", color = "#6CC24A", order = 7 },
}
-- A critter holds one trait. A better trait replaces a worse one. None of these odds are for sale.
Config.CrewTraits = {
	{ id = "none", name = "None", mult = 1, order = 0, weight = 82 },
	{ id = "smoky", name = "Smoky", mult = 1.5, order = 1, weight = 12 },
	{ id = "glazed", name = "Glazed", mult = 2, order = 2, weight = 4 },
	{ id = "golden", name = "Golden", mult = 3, order = 3, weight = 1.5 },
	{ id = "meteorite", name = "Meteorite", mult = 6, order = 4, weight = 0.5 },
}
Config.CrewRoles = {
	pit = { name = "Pit hand", prop = "mop" },
	grill = { name = "Grill hand", prop = "tongs" },
	server = { name = "Server", prop = "tray" },
	greeter = { name = "Greeter", prop = "flag" },
}
-- The five named hands from the old crew tab. Level becomes the rounded average of speed, carry and quality.
Config.Founders = {
	pip = { species = "armadillo", name = "Pip" },
	biscuit = { species = "pup", name = "Biscuit" },
	dottie = { species = "hummingbird", name = "Dottie" },
	tumble = { species = "roadrunner", name = "Tumble" },
	mango = { species = "longhorn", name = "Mango" },
}
-- About 30 species across 6 rarities, plus the secret Rex. `model` is the critter builder id.
-- `price` is the coin cost of the plain (no trait) applicant. A visible trait multiplies price and coins/s together.
Config.CrewSpecies = {
	{ id = "armadillo", name = "Shellie", rarity = "common", role = "pit", baseRate = 1, price = 25, model = "armadillo", body = "#9C8A7A", head = "#8A7868", scale = 0.92, line = "I mop the brisket. The brisket mops back." },
	{ id = "prairiedog", name = "Poppy", rarity = "common", role = "greeter", baseRate = 1, price = 30, model = "prairiedog", style = "prairie", body = "#C4A574", head = "#E8C99A", scale = 0.85, line = "Howdy! Table for everyone." },
	{ id = "turtle", name = "Pebble", rarity = "common", role = "server", baseRate = 2, price = 50, model = "turtle", style = "turtle", body = "#3E8F6E", head = "#F0E2B6", scale = 0.9, line = "Plates are ready. I am also ready. Slowly." },
	{ id = "hornedtoad", name = "Spud", rarity = "common", role = "pit", baseRate = 2, price = 55, model = "hornedtoad", body = "#C2A36B", head = "#B08F55", scale = 0.7, line = "Spikes out. Sauce on." },
	{ id = "jackrabbit", name = "Hopper", rarity = "common", role = "greeter", baseRate = 2, price = 60, model = "jackrabbit", style = "rabbit", body = "#C9B59A", head = "#E7D7C3", scale = 0.9, line = "I can seat a whole family before the beans cool." },
	{ id = "pup", name = "Noodle", rarity = "uncommon", role = "grill", baseRate = 4, price = 180, model = "bellyrubpup", body = "#E8D3B9", head = "#E8D3B9", scale = 0.9, line = "Burgers first. Belly rubs are a benefit." },
	{ id = "possum", name = "Pippin", rarity = "uncommon", role = "server", baseRate = 5, price = 230, model = "possum", style = "possum", body = "#C9C1B6", head = "#F4EFE8", scale = 0.88, line = "Playing possum is not on the menu." },
	{ id = "clapcat", name = "Cleo", rarity = "uncommon", role = "server", baseRate = 5, price = 250, model = "clapcat", body = "#151515", head = "#1E1E1E", scale = 0.85, line = "Order up. I clapped for it." },
	{ id = "bee", name = "Bonnie", rarity = "uncommon", role = "greeter", baseRate = 6, price = 280, model = "bee", style = "bee", body = "#F6C445", head = "#2A241C", scale = 0.75, line = "Bluebonnets in my pockets. Guests at the gate." },
	{ id = "catfish", name = "Bub", rarity = "uncommon", role = "grill", baseRate = 7, price = 320, model = "catfish", style = "fish", body = "#6FA8C4", head = "#8EC4DC", scale = 0.9, line = "I brought my own bucket. The grill is yours." },
	{ id = "hummingbird", name = "Zip", rarity = "rare", role = "server", baseRate = 12, price = 780, model = "hummingbird", body = "#2E8B57", head = "#C2185B", scale = 0.6, line = "Plates delivered. I was already back." },
	{ id = "roadrunner", name = "Dash", rarity = "rare", role = "grill", baseRate = 14, price = 910, model = "roadrunner", body = "#6B5B4B", head = "#3A6EA5", scale = 0.9, line = "Burgers. Fast. Still juicy." },
	{ id = "raccoon", name = "Rascal", rarity = "rare", role = "pit", baseRate = 15, price = 980, model = "raccoon", body = "#7D7D7D", head = "#505050", scale = 0.92, line = "The pit is tidy. My pockets are not." },
	{ id = "skunk", name = "Petunia", rarity = "rare", role = "pit", baseRate = 16, price = 1100, model = "skunk", style = "skunk", body = "#2B2B2B", head = "#F7F4EF", scale = 0.9, line = "Smoke only. I left the other stuff at home." },
	{ id = "coyote", name = "Yip", rarity = "rare", role = "grill", baseRate = 18, price = 1200, model = "coyote", style = "coyote", body = "#C49A6C", head = "#E6C8A0", scale = 0.88, line = "I mind the patties. I do not mind the compliments." },
	{ id = "longhorn", name = "Moony", rarity = "epic", role = "pit", baseRate = 32, price = 3200, model = "longhorn", body = "#C46A2F", head = "#E0B080", scale = 1.05, line = "Low and slow. My horns do the waving." },
	{ id = "owl", name = "Hoot", rarity = "epic", role = "greeter", baseRate = 38, price = 4000, model = "owl", style = "owl", body = "#8D6E4A", head = "#F3E6C8", scale = 0.9, line = "I can see the whole line from here." },
	{ id = "bison", name = "Bean", rarity = "epic", role = "pit", baseRate = 44, price = 4800, model = "bison", style = "bison", body = "#6B4A32", head = "#3E2A1E", scale = 1.05, line = "Small calf. Big smoke." },
	{ id = "squirrel", name = "Nib", rarity = "epic", role = "server", baseRate = 50, price = 5600, model = "squirrel", style = "squirrel", body = "#A86B3C", head = "#E8C9A0", scale = 0.8, line = "Pecans are for later. Plates are for now." },
	{ id = "firefly", name = "Flicker", rarity = "epic", role = "greeter", baseRate = 58, price = 6400, model = "firefly", style = "firefly", body = "#2F3B2C", head = "#3E4A38", scale = 0.7, line = "Follow my light to an open table." },
	{ id = "otter", name = "Otto", rarity = "legendary", role = "server", baseRate = 90, price = 14000, model = "otter", style = "otter", body = "#8A5A3A", head = "#E7C7A8", scale = 0.9, line = "Creek-fresh plates, coming through." },
	{ id = "heron", name = "Wader", rarity = "legendary", role = "greeter", baseRate = 110, price = 18000, model = "heron", style = "heron", body = "#6E8CA0", head = "#F7F1E4", scale = 1.0, line = "I saved you a spot by the pond." },
	{ id = "bobcat", name = "Socks", rarity = "legendary", role = "grill", baseRate = 140, price = 23000, model = "bobcat", style = "bobcat", body = "#C4A06A", head = "#E8D2A8", scale = 0.95, line = "Tongs up. Tail in." },
	{ id = "pony", name = "Pinto", rarity = "legendary", role = "greeter", baseRate = 170, price = 28000, model = "pony", style = "pony", body = "#F4F1EA", head = "#E7D8C4", scale = 1.05, line = "I walk guests in. I do not walk off with the buns." },
	{ id = "gator", name = "Gummy", rarity = "legendary", role = "pit", baseRate = 210, price = 36000, model = "gator", style = "gator", body = "#3E8F4A", head = "#DCE8C0", scale = 1.0, line = "Smile on. Lid closed. That's the job." },
	{ id = "thunderbird", name = "Sunny", rarity = "mythic", role = "greeter", baseRate = 320, price = 80000, model = "thunderbird", style = "thunderbird", body = "#F2C14E", head = "#FFF6D8", scale = 0.95, line = "The gate's open and the sky showed up." },
	{ id = "sunfish", name = "Goldie", rarity = "mythic", role = "server", baseRate = 400, price = 110000, model = "sunfish", style = "sunfish", body = "#F0A020", head = "#FFE08A", scale = 0.85, line = "Round plate, round me, happy table." },
	{ id = "comet", name = "Comet", rarity = "mythic", role = "grill", baseRate = 500, price = 140000, model = "comet", style = "comet", body = "#3A2A6A", head = "#6A5AC8", scale = 0.9, line = "Burgers with a little sky on them." },
	{ id = "dragon", name = "Ember", rarity = "mythic", role = "pit", baseRate = 640, price = 190000, model = "dragon", style = "dragon", body = "#E07A3D", head = "#F6C7A1", scale = 0.95, line = "I breathe on the coals. Gently." },
	{ id = "sprite", name = "Blu", rarity = "mythic", role = "server", baseRate = 800, price = 240000, model = "sprite", style = "sprite", body = "#7EB6FF", head = "#EAF3FF", scale = 0.72, line = "Bluebonnets on the tray. Seconds on the house." },
	{ id = "rex", name = "Rex", rarity = "secret", role = "pit", baseRate = 2400, price = 1200000, model = "rex", body = "#6CC24A", head = "#7BD35A", scale = 1.05, secret = true, line = "RAWR means I got the job." },
}
Config.RanchTiers = {
	{ tier = 1, name = "Open yard", piece = "yard", cost = 0, blurb = "Grass, a pit, and room for 3 critters." },
	{ tier = 2, name = "Fence and shed", piece = "shed", cost = 150, blurb = "A little shed beside the pit, and 2 more crew slots." },
	{ tier = 3, name = "String-light patio", piece = "lights", cost = 900, blurb = "String lights over the patio, and 2 more crew slots." },
	{ tier = 4, name = "Creek pond", piece = "pond", cost = 4500, blurb = "A pond for the turtles, and 2 more crew slots." },
	{ tier = 5, name = "Barn kitchen", piece = "barn", cost = 18000, blurb = "A barn kitchen, and 2 more crew slots." },
	{ tier = 6, name = "BBQ trailer", piece = "trailer", cost = 70000, blurb = "A BBQ trailer on the grass, and 2 more crew slots." },
	{ tier = 7, name = "Cookout stage", piece = "stage", cost = 260000, blurb = "A little stage, and 2 more crew slots." },
	{ tier = 8, name = "Roch's Pit", piece = "sign", cost = 1000000, blurb = "A neon ROCH'S PIT sign, and 2 more crew slots." },
}

-- Turkey Day Smokeout: Thanksgiving week (Mon-Sun around the 4th Thursday of November, Texas time).
-- Smoke a Harvest Turkey Leg and share it at the potluck table: once a day you get coins, and the first
-- share ever earns the free Thankful & Full Apron. When `need` different pitmasters share within
-- `window` seconds the table is full and the whole server gets +25% tips (free, like the Dinner Bell).
-- Nothing here is paid. In Studio, set the workspace attribute ForceTurkeyDay = true to test it any day.
Config.TurkeyDay = {
	id = "turkeyday",
	dailyKey = "turkeyDay", -- data.daily field for the once-a-day share
	daysBefore = 3,
	daysAfter = 3,
	meat = "turkeyleg",
	reward = "apron_thankful",
	title = "Thankful",
	shareMult = 2, -- coins = turkey leg price x2 x rank bonus, once per day
	need = 3,
	window = 600,
	cooldown = 900,
	minutes = 5,
	tipBonus = 0.25,
}

-- Holiday Smokeout: Christmas through New Year's Day (Dec 19 - Jan 1, Texas time). Same potluck
-- table as Turkey Day, dressed for Christmas: smoke a Holiday Glazed Ham (a winter cut, Dec-Jan) and
-- share it once a day for coins; the first share ever earns the free Merry & Smoky Apron. When `need`
-- pitmasters share within `window` seconds, everyone gets +25% tips. Nothing here is paid; the
-- Holiday look set is sold separately and only during these dates (Monetization, event = "holiday").
-- In Studio, set the workspace attribute ForceHolidaySmokeout = true to test it any day.
Config.HolidaySmokeout = {
	id = "holiday",
	dailyKey = "holidayDay",
	start = { 12, 19 }, -- month, day
	finish = { 1, 1 }, -- runs into the next year
	peak = { 12, 25 },
	meat = "holidayham",
	reward = "apron_merry",
	title = "Merry & Smoky",
	shareMult = 2,
	need = 3,
	window = 600,
	cooldown = 900,
	minutes = 5,
	tipBonus = 0.25,
}

-- The week before a potluck event, the table's sign and a login note say when it opens (a date,
-- never a countdown timer).
Config.EventTeaserDays = 7

-- Season themes: the Cook-Off template reskins by month.
Config.Seasons = {
	{ months = { 10 }, id = "spooky", name = "Spooky Smoke-Off", color = "#FF7518" },
	{ months = { 11 }, id = "harvest", name = "Harvest Smoke-Off", color = "#C46A2F" },
	{ months = { 12, 1 }, id = "holiday", name = "Holiday Ham Jam", color = "#C0392B" },
	{ months = { 2, 3, 4, 5 }, id = "bluebonnet", name = "Bluebonnet Bash", color = "#3B6FD8" },
	{ months = { 6, 7, 8, 9 }, id = "summer", name = "Summer Sizzle", color = "#F4D03F" },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Content</string>
          <string name="Source"><![CDATA[--!strict
-- Content.luau — all jokes, NPC lines and swappable slang in one place.
-- Slang ages fast: swap words here without touching game code. All text is original.
local Content = {}

-- "Hi Hungry, I'm Unc" — one dad joke per day (index = day number % count).
Content.UncJokes = {
	"Why did the brisket go to school? To get a little more well-done.",
	"I told my smoker a joke. It didn't laugh, but it did get a little warmer.",
	"What do you call a sleeping cow? A bulldozer. Now go flip that burger.",
	"I'm reading a book about anti-gravity. Can't put it down. Kinda like this rib.",
	"Why don't eggs tell jokes at cookouts? They'd crack each other up.",
	"What did the hot sauce say to the burger? 'You're lookin' sharp, bun.'",
	"I used to hate facial hair. Then it grew on me. Like this smoke smell.",
	"What's a pitmaster's favorite music? Anything with a good brisket beat.",
	"How do you make a tissue dance? Put a little boogie in it. Not in the sauce.",
	"Why did the pickle go to the doctor? It was feeling kinda dill.",
	"What kind of shoes do hot dogs wear? Buns-lippers. ...I'll see myself out.",
	"I asked the smoker how it was doing. It said 'low and slow, unc.'",
	"Why was the corn so popular? Everyone was all ears.",
	"What do you call cheese that isn't yours? Nacho cheese. What do you call brisket that isn't yours? Getting taxed.",
	"Why did the cowboy adopt a dachshund? He wanted to get a long little doggie.",
	"What did the grill say to the steak? 'You're so hot right now.'",
	"Why don't skeletons fight at barbecues? They don't have the guts.",
	"How does a BBQ say goodbye? 'Brisket later!'",
	"I'm on a seafood diet. I see food, and I smoke it.",
	"What do you call a fake noodle? An impasta. Not on my pit.",
	"Why did the sauce bottle blush? It saw the salad dressing.",
	"Did you hear about the restaurant on the moon? Great food, no atmosphere.",
	"What did the ribs say after the joke? 'That's a rib-tickler.'",
	"Why did the burger join the gym? To work on its buns.",
	"What's brown and sticky? A stick. ...and also my sauce.",
	"Why did the scarecrow win an award? He was outstanding in his field. Like your pit.",
	"I only know 25 letters of the alphabet. I don't know Y. But I know BBQ.",
	"What do you call a pig that does karate? A pork chop.",
	"Why are spiders great at cookouts? They know their way around the web of sauce.",
	"Back in my day we didn't have smoke signals. We had... well, actually we had smoke signals.",
	-- Yard jokes for early November 2026. Original sentences. See Content.YardNotes for sources.
	"Granny held up a perfect slice and called it a W chew. The burnt end was L nibbles. I nodded like I had invented both words.",
	"Half this brisket could sit on a postcard. The other half is what happens when Unc starts a story and forgets the fire. Same cook. Two drawings of one horse.",
	"The yard pup flopped over for a belly wash. He is not a famous internet dog. He is our dog, and the belly is still the whole bit.",
}

Content.UncYap = {
	"Now let me tell you about the summer of '98, the year the grill caught...",
	"Back in my day, a brisket took TWELVE hours and we liked it...",
	"You know what your problem is? You don't wait for the bark. The bark is everything...",
}

-- The King of the Pit hums ORIGINAL tunes (no real songs, lyrics, or likenesses).
Content.KingLines = {
	"♪ Hmm-hmm, low and slow, let that hickory go... ♪",
	"♪ Got a cooler full of brisket and a sky full of smoke... ♪",
	"♪ Dum-da-dum, the pit don't lie, the pit don't lie... ♪",
	"♪ Mesquite moon over the backyard tonight... ♪",
	"♪ Porch light, low fire, hum it again from the top... ♪",
	"Howdy, partner. A pit's like a promise: you keep it lit.",
}

-- Temp the talking thermometer. A little too helpful. Creepier at night (still kid-friendly).
Content.TempDay = {
	"Hi! I'm Temp! I measure things! Your brisket is doing GREAT!",
	"Fun fact: I'm always watching the internal temperature. Always.",
	"Need help? I love helping! Helping is my favorite thing!",
}
Content.TempNight = {
	"I see your brisket... I always see your brisket.",
	"It's dark out. I'm still measuring. Don't worry about what.",
	"Why are you awake? ...Me? I don't sleep. I'm a thermometer.",
	"The mosquitoes told me things. Terrible things. About ketchup.",
}

-- Granny Pecan, head Cook-Off judge.
Content.GrannyLines = {
	L = { "Bless your heart, sugar.", "Well... you tried, and that's what counts. Bless your heart." },
	Mid = { "It's mid, baby. Fine, but mid.", "I've had worse. At a gas station." },
	W = { "Now THAT is a W plate!", "Mm-hmm! Granny approves!" },
	Cooked = { "Child, you COOKED. Somebody call the newspaper!", "You cooked so hard the cat's clapping!" },
}

Content.PitmasterScold = {
	"If you're lookin', you ain't cookin'!",
	"Close that lid! Every peek costs you time!",
	"The smoke ring can't form if you keep peekin'!",
}

-- Swappable slang (edit freely as memes age).
Content.Slang = {
	perfectFlip = "+1000 AURA",
	lockedIn = "LOCKED IN 🔒",
	burnt = "Skill issue... 🤿 (everybody's doing the scuba wave)",
	crine = "😭 crine",
	snagged = "You got taxed!",
	snagger = "TAXED! Run before they tag you!",
	resting = "💤 Unc is resting his eyes",
	unclocked = "Unc Status unlocked. Socks and sandals are now legal.",
	quietCreek = "Shhh... quiet on the creek.",
	skipYap = "Skip the yap",
	sixSeven = "6-7! 🤷 (that tip ended in 67)",
	rush = "🍽️ LUNCH RUSH CLEARED!",
	dinnerBell = "🔔 DINNER'S ON! 🔔",
}

-- Turkey Day Smokeout (Thanksgiving week). Family-friendly, original lines only.
Content.TurkeyDay = {
	dialog = "Turkey Day Potluck",
	host = "Granny Pecan",
	hud = "🦃 Potluck's full: +25% tips",
	login = "🦃 It's Turkey Day Cookout week! Smoke a Harvest Turkey Leg and share it at the potluck table for a free Thankful & Full Apron.",
	needDish = "Everybody brings a dish! Smoke a Harvest Turkey Leg (any smoker, 15 min), then set it on the table here.",
	already = "You already brought a dish today. Thank you, sugar! Come back tomorrow, and bring your crew: when 3 pitmasters share, the table's full for everybody.",
	firstShare = "You set your %s on the table. Granny Pecan gives you a hug and a brand-new apron.\n\n+%d coins, the Thankful & Full Apron, and a new title: Thankful.",
	share = "You set your %s on the table. \"Now THAT's a potluck!\"\n\n+%d coins. Come back tomorrow with another dish.",
	progress = "🥧 %s set a dish on the Turkey Day potluck table: %d/%d. %d more pitmasters sharing in the next few minutes fills it, and everybody gets bonus tips!",
	bannerTop = "TURKEY DAY COOKOUT",
	bannerIdle = "Bring a dish!",
	full = "🦃 THE POTLUCK'S FULL! %d pitmasters shared a dish. Everyone gets +%d%% tips for %d min!",
	over = "The Turkey Day potluck is packed up for the year. See y'all next Thanksgiving!",
	soon = "🦃 Coming up: the Turkey Day Cookout opens %s. Granny Pecan's potluck table runs all week, and your first dish earns a free Thankful & Full Apron.",
	thanks = {
		"Granny Pecan: \"I'm thankful for good smoke and better company.\"",
		"Unc Hank: \"I'm thankful for elastic waistbands. That's it. That's the joke.\"",
		"The King of the Pit: \"Thankful for low fire, slow days, and folks to feed.\"",
		"Temp: \"I am thankful for... 165 degrees. Always 165.\"",
	},
}

-- Holiday Smokeout (Dec 19 - Jan 1). Christmas at the ranch: family-friendly, original lines only.
Content.HolidaySmokeout = {
	dialog = "Holiday Cookout Potluck",
	host = "Granny Pecan",
	hud = "🎄 Christmas potluck's full: +25% tips",
	login = "🎄 Merry Christmas from the ranch! The Holiday Cookout runs through New Year's Day. Smoke a Holiday Glazed Ham and share it at the potluck table for a free Merry & Smoky Apron.",
	needDish = "Christmas potluck! Everybody brings a dish. Smoke a Holiday Glazed Ham (any smoker, 20 min), then set it on the table here.",
	already = "You already brought a dish today, sugar. Merry Christmas! Come back tomorrow, and bring your crew: when 3 pitmasters share, the table's full for everybody.",
	firstShare = "You set your %s on the table. Granny Pecan tucks a wrapped box under your arm: it's an apron!\n\n+%d coins, the Merry & Smoky Apron, and a new title: Merry & Smoky.",
	share = "You set your %s on the table. \"Now THAT's a Christmas spread!\"\n\n+%d coins. Come back tomorrow with another dish.",
	progress = "🎄 %s set a dish on the Christmas potluck table: %d/%d. %d more pitmasters sharing in the next few minutes fills it, and everybody gets bonus tips!",
	bannerTop = "HOLIDAY COOKOUT",
	bannerIdle = "Merry Christmas, y'all!",
	full = "🎄 THE CHRISTMAS POTLUCK'S FULL! %d pitmasters shared a dish. Everyone gets +%d%% tips for %d min!",
	over = "The Christmas potluck is packed up till next December. Happy New Year, y'all!",
	soon = "🎄 Coming up: the Holiday Cookout opens %s and runs through New Year's Day. Your first Holiday Glazed Ham at the potluck table earns a free Merry & Smoky Apron.",
	thanks = {
		"Granny Pecan: \"Merry Christmas, sugar. Grab a tamale before Unc finds 'em.\"",
		"Unc Hank: \"I asked for a new grill brush. Got socks again. Unc things.\"",
		"The King of the Pit: \"Best gift there is: a full table and a slow fire.\"",
		"Temp: \"Ham's done at 140. I checked it twice. Like a list.\"",
		"Unc Hank: \"Ugly sweater? Sir, this is my good sweater.\"",
	},
}

-- Unc Hank's Rookie List (Config.RookieSteps). Unc's voice: warm, a little corny, never pushy.
Content.Rookie = {
	title = "📋 Unc's Rookie List",
	start = "Look at you, feedin' critters already! I wrote you a little list (top right). Five quick things and you're a real pitmaster. Follow the gold arrow!",
	cheers = {
		"Unc Hank: \"That's what I'm talkin' about!\"",
		"Unc Hank: \"Okay, okay, I see you!\"",
		"Unc Hank: \"Clean work. Your grandmama would be proud.\"",
		"Unc Hank: \"You're cookin' now. Literally.\"",
	},
	done = "Rookie List: done! You're officially Rookie of the Ranch. Wear that bandana with pride.\n\nFinish reward: +%d coins, the Rookie of the Ranch Bandana, and a new title: Rookie of the Ranch.",
	-- %s = the finish reward, e.g. "Rookie of the Ranch Bandana + title + 250 🪙"
	finishLine = "🏁 Finish all 5 to earn: %s",
	skipAsk = "Skip the Rookie List? You'll miss the finish reward for now: %s. You can bring the list back any time in Settings > Game and still earn it.",
	skipKeep = "Keep going",
	skipYes = "Skip for now",
	skipped = "Rookie List tucked away. Bring it back any time in Settings > Game.",
	resumed = "Unc's Rookie List is back (top right)! Goals you already did count right away.",
	stepDone = "✅ %s  +%d coins",
}

-- Yard flavor for the week of November 7, 2026. A few lines, not a meme wall.
-- Dated sources, checked while writing this:
-- * Know Your Meme, "The Weekly Meme Roundup", published November 6, 2026:
--   "W chews" (good food) and "L nibbles" (bad food) had spread from a late-October post
--   and were still circulating that week. We use the words in original BBQ sentences.
--   We do not use the person from those clips, the clips themselves, or anyone's audio.
-- * SocialBee, "Trending Instagram memes this week", November 5, 2026: a split
--   horse-drawing format (polished on one side, rough on the other). We do not use the
--   drawing. One brisket line borrows the shape of the joke only.
-- * RoTerminal, "Trends on Roblox", snapshot November 7, 2026, 8:59am New York time:
--   new games named tycoon were up about 73% and simulator about 61% versus the prior
--   30 days. The porch board says low and slow beats a rush. It does not name other games.
-- Left out on purpose from that same November 6 roundup: election jokes, thirst trends,
-- and a brand-mascot pile-on. Those do not belong at a backyard cookout.
-- "6-7" is already in the game from earlier. It is not labeled as a November 2026 trend.
-- Unc is already the host (Know Your Meme's unc entry was last updated February 14, 2025;
-- "Unc Still Got It" was updated April 9, 2026). He stays a small voice, not a new theme.
-- Pibble is a March 2025 pet-audio meme that fandom pages were still describing in August
-- 2026. One belly-rub line nods at it because Mike likes that joke. We do not play the audio,
-- and we do not call it the current trend.
Content.YardNotes = {
	board = "TODAY'S BOARD\nGood smoke is a W chew.\nBurnt ends are L nibbles.\nLow and slow beats a rush.",
	pup = "The pup flops over for a belly wash. He is our dog, not a famous one.",
}

-- Second line of the potluck banner while an event is on, so the whole server can see how full
-- the table is (a count, never a timer). Also used when nothing's on and the prompt is stale.
Content.PotluckTable = {
	count = "Dishes on the table: %d/%d",
	full = "Table's full! +%d%% tips for all",
	closed = "The potluck table is packed up for now. Granny Pecan sets it out again for Turkey Day week and at Christmas.",
}

Content.Signs = {
	hub = "ROCHIN' RANCH RD.",
	shop = "ROCH & ROLL SAUCE SHACK",
	cookoff = "SATURDAY COOK-OFF",
	potluck = "SUNDAY POTLUCK",
	turkeyPotluck = "TURKEY DAY POTLUCK",
	turkeyBanner = "TURKEY DAY COOKOUT\nBring a dish!",
	holidayPotluck = "CHRISTMAS POTLUCK",
	turkeySoon = "TURKEY DAY POTLUCK: %s",
	holidaySoon = "CHRISTMAS POTLUCK: %s",
	holidayBanner = "HOLIDAY COOKOUT\nMerry Christmas, y'all!",
	creek = "(nothing to see here)",
	welcome = "BACKYARD COOKOUT",
	bertha = "BIG BERTHA\nThe King of the Pit's 1,000-gallon smoker · Ring the bell when supper's on",
}

-- The hub's Cook-Off leaderboard. Saturday: today's standings. Sunday: yesterday's results.
-- Monday-Friday: last Saturday's champs and the next date. Top 3 (ties included) earn the free
-- Cook-Off Champ title. Dates only, never a countdown.
Content.CookOffBoard = {
	liveHead = "TODAY! 3x prizes",
	resultsHead = "Yesterday's champs",
	lastHead = "Last Saturday's champs",
	liveEmpty = "No plates judged yet.\nBe the first!",
	finalEmpty = "No champs yet.\nTop 3 earn the\nCook-Off Champ title!",
	next = "Next Cook-Off:\n%s",
	practice = "Practice any day!",
	liveRows = 8,
	finalRows = 5,
	nameMax = 12,
	title = "Cook-Off Champ",
	champNote = "🏆 You placed %s at Saturday's Cook-Off! You earned the Cook-Off Champ title (Settings > Titles).",
	champAgain = "🏆 You placed %s at Saturday's Cook-Off again! Your name's on the board by the stage.",
}

return Content
]]></string>
        </Properties>
