          <string name="Source"><![CDATA[--!strict
-- The shape of a saved player. Add new fields here; old saves get them automatically (Reconcile).
local Config = if script ~= nil and script.Parent ~= nil then require(script.Parent.Config) else require("./Config")

return {
	schema = 2,
	coins = Config.START_COINS,
	runCoins = 0,
	lifetimeCoins = 0,
	aura = 0,
	rank = 1,
	pitLevel = 1,
	smokerSlotsBought = 0,
	grillSlotsBought = 0,
	stations = {}, -- "s1".."s7", "g1".."g4" -> Cook
	cooler = {}, -- { m = meatId, r = rarityId, f = flip? }
	sauces = {
		luck = { amount = 0, charges = 0 },
		speed = { amount = 0, charges = 0 },
		tip = { amount = 0, charges = 0 },
	},
	boost = { mult = 1, untilT = 0 },
	cuts = { wagyu = 0, tomahawk = 0 },
	unlocks = { tomahawk = false },
	owned = {},
	equipped = {},
	titles = {},
	title = "",
	critters = {},
	cutsIndex = {},
	eggs = {},
	stats = {
		served = 0,
		smoked = 0,
		cooks = 0,
		rares = 0,
		perfectFlips = 0,
		critters = 0,
		cookoffs = 0,
		upgrades = 0,
		mosquitoes = 0,
		sauces = 0,
		burnt = 0,
		snags = 0,
		flips = 0,
		smokerStarts = 0,
		bells = 0,
		giftsSent = 0,
		giftsGot = 0,
	},
	streak = { lastDay = -1, count = 0, best = 0, freeMissWeek = -1 },
	path = { claimed = 0, playDays = 0, lastPlayDay = -1 },
	daily = { jokeDay = -1, creekDay = -1, kingDone = false, bellDay = -1, turkeyDay = -1, holidayDay = -1 },
	restock = { window = -1, bought = {} },
	cookoff = { week = -1, best = 0, champWeek = -1 }, -- champWeek: last week whose podium was announced to this player
	settings = { peace = true, sfx = true, music = true, musicVolume = 0.22, autoHire = true }, -- snagging is opt-in; music is its own quiet loop
	tutorial = { firstBrisket = false, done = false },
	rookie = { claimed = 0, skipped = false, resumed = false }, -- Unc Hank's Rookie List (Logic/Rookie)
	guide = { step = 1, done = false, skipped = false, introduced = false }, -- first-visit hints (Logic/Guide)
	forceCritter = "",
	jimothy = { seen = {}, lastAt = 0, rewarded = false }, -- sighting hunt (Logic/Jimothy)
	staff = { roster = {} }, -- old named hands. Logic/Migrate copies hired founders into crew.owned.
	crew = { owned = {}, slots = 3, nextUid = 1, extra = 0, bunkhouse = false, boostUntil = 0, outfit = "" }, -- critters on the ranch (Logic/Crew)
	ranch = { tier = 1 },
	index = { traits = {} }, -- species traits discovered; filled in by a later update
	codes = {},
	offline = { lastTick = 0 }, -- 0 means "never ticked", so the first join pays nothing
	partners = {},
	family = { on = false, purse = 0, seen = {} },
	purseOut = {},
	social = { cheerNext = 0 },
	events = { smokeShowWeek = -1 },
	onboard = { done = false, rookieReward = false, started = false, taught = false },
	freeGift = { nextAt = 0 }, -- timed free gift (Logic/FreeGift). 0 means one is ready.
	combo = 0,
	receipts = {},
	seasonPass = { id = "", base = {}, days = 0, lastDay = -1, skips = 0, paid = false, freeClaimed = 0, paidClaimed = 0 }, -- Logic/SeasonPass
	club = { month = -1, showerDay = -1 }, -- Pit Crew Club monthly look + daily shower
	purchases = { once = {}, count = 0 }, -- one-per-account packs; count of Robux purchases
	analytics = { onboard = 0 }, -- last onboarding funnel step logged (InsightsService)
	giftsHeld = {}, -- paid gifts whose recipient left before the receipt; send later for free (Logic/Gifting)
	lastSeen = 0,
	playSeconds = 0,
}
]]></string>
