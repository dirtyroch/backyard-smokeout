	Rot_SkinSnowy = { id = 3732457283, name = "Snowy Smoker", price = 99, icon = "❄️", kind = "cosmetic", category = "This Week", grants = { "skin_snowy" }, rotation = true, desc = "Frosty white BBQ pits." },
